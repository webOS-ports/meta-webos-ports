[Unit]
Description=meta-webos - "%n"
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=dbus
BusName=org.bluez.obex
# -s makes obexd use the system bus. LuneOS runs obexd as a system service
# owning org.bluez.obex (see BusName above) and does not have a D-Bus session
# bus, so without this obexd fails with "obex_server_init failed". Up to bluez
# 5.72 we carried a patch replacing DBUS_BUS_SESSION with DBUS_BUS_SYSTEM; 5.86
# provides the --system-bus/-s option and ships its own obex.conf D-Bus policy,
# so the patch is no longer needed.
ExecStart=/usr/libexec/bluetooth/obexd -r /media/internal -s
Restart=on-failure

[Install]
Alias=dbus-org.bluez.obex.service

+				"Tethering.IP", NULL);
+
 done:
 	g_free(identifier);
 
@@ -232,7 +243,9 @@ int connman_technology_tethering_notify(struct connman_technology *technology,
 		return -EALREADY;
 
 	if (enabled) {
-		err = __connman_tethering_set_enabled();
+		const char *ip = technology->tethering_ipaddress;
+
+		err = __connman_tethering_set_enabled(ip && *ip ? ip : NULL);
 		if (err < 0)
 			return err;
 	} else
@@ -491,6 +504,9 @@ static void technology_load(struct connman_technology *technology)
 	technology->tethering_freq = g_key_file_get_integer(keyfile,
 				identifier, "Tethering.Freq", NULL);
 

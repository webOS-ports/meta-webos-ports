+/*
+ * Technology wide WPS. Unlike the agent driven per-network WPS there is no
+ * target network yet: wpa_supplicant is asked to associate with whatever
+ * access point is in WPS mode, and once it reports which SSID it ended up
+ * with we hand over to the normal connect path.
+ */
+static void clear_wps_state(struct wifi_data *wifi)
+{
+	if (wifi->wps_timeout > 0) {
+		g_source_remove(wifi->wps_timeout);
+		wifi->wps_timeout = 0;
+	}
+
+	wifi->wps_active = false;
+	wifi->wps_start_deferred = false;
+
+	g_free(wifi->wps_pin);
+	wifi->wps_pin = NULL;
+}
+
+static void wps_failed(struct wifi_data *wifi)
+{
+	clear_wps_state(wifi);
+
+	connman_technology_wps_failed_notify(wifi_technology);
+}
+
+static int cancel_wps(struct wifi_data *wifi);
+
+static gboolean wps_timeout_cb(gpointer user_data)
+{
+	struct wifi_data *wifi = user_data;
+
+	DBG("wifi %p", wifi);
+
+	wifi->wps_timeout = 0;
+
+	cancel_wps(wifi);
+	wps_failed(wifi);
+
+	return FALSE;
+}
+
+static void wps_start_callback(int result, GSupplicantInterface *interface,
+							void *user_data)
+{
+	struct wifi_data *wifi = user_data;
+
+	DBG("result %d", result);
+
+	if (result == 0)
+		return;
+
+	wps_failed(wifi);
+}
+
+static int start_wps(struct wifi_data *wifi)
+{
+	GSupplicantSSID *ssid;
+	int ret;
+
+	ssid = g_try_malloc0(sizeof(GSupplicantSSID));
+	if (!ssid)
+		return -ENOMEM;
+
+	ssid->use_wps = TRUE;
+	if (wifi->wps_pin)
+		ssid->pin_wps = g_strdup(wifi->wps_pin);
+
+	connman_info("Starting WPS association");
+
+	wifi->wps_timeout = g_timeout_add_seconds(WPS_CONNECT_TIMEOUT,
+						wps_timeout_cb, wifi);
+
+	/* gsupplicant owns ssid from here on and releases it itself */
+	ret = g_supplicant_interface_connect(wifi->interface, ssid,
+						wps_start_callback, wifi);
+	if (ret == -EALREADY || ret == -EINPROGRESS)
+		ret = 0;
+
+	return ret;
+}
+
+static void cancel_wps_callback(int result, GSupplicantInterface *interface,
+							void *user_data)
+{
+	struct wifi_data *wifi = user_data;
+
+	DBG("result %d", result);
+
+	/* The interface may have gone away while the call was in flight. */
+	if (!g_supplicant_interface_get_data(interface))
+		return;
+
+	if (wifi->network) {
+		connman_network_set_bool(wifi->network, "WiFi.UseWPS", false);
+		connman_network_set_connected(wifi->network, false);
+		wifi->network = NULL;
+	}
+
+	clear_wps_state(wifi);
+}
+
+static int cancel_wps(struct wifi_data *wifi)
+{
+	int ret;
+
+	DBG("wifi %p", wifi);
+
+	ret = g_supplicant_interface_wps_cancel(wifi->interface,
+						cancel_wps_callback, wifi);
+	if (ret == -EALREADY || ret == -EINPROGRESS)
+		ret = 0;
+
+	return ret;
+}
+
+static void deferred_wps_start(struct wifi_data *wifi)
+{
+	if (!wifi->wps_active || !wifi->wps_start_deferred)
+		return;
+
+	DBG("wifi %p", wifi);
+
+	wifi->wps_start_deferred = false;
+	wifi->network = NULL;
+
+	if (start_wps(wifi) < 0)
+		wps_failed(wifi);
+}
+
+/*
+ * wpa_supplicant reports the outcome of the WPS handshake here. On success
+ * it also tells us which SSID it provisioned, so look up the matching
+ * network and let the regular association path take it from there.
+ */
+static void wps_state(GSupplicantInterface *interface)
+{
+	struct wifi_data *wifi = g_supplicant_interface_get_data(interface);
+	GSupplicantWpsState state;
+	const void *wps_ssid;
+	unsigned int wps_ssid_len;
+	GSList *list;
+
+	if (!wifi || !wifi->wps_active)
+		return;
+
+	state = g_supplicant_interface_get_wps_state(interface);
+
+	DBG("wifi %p wps state %d", wifi, state);
+
+	if (state == G_SUPPLICANT_WPS_STATE_UNKNOWN)
+		return;
+
+	if (state == G_SUPPLICANT_WPS_STATE_FAIL) {
+		wps_failed(wifi);
+		return;
+	}
+
+	wps_ssid = g_supplicant_interface_get_wps_ssid(interface,
+							&wps_ssid_len);
+	if (!wps_ssid) {
+		wps_failed(wifi);
+		return;
+	}
+
+	for (list = wifi->networks; list; list = list->next) {
+		struct connman_network *network = list->data;
+		const void *ssid;
+		unsigned int ssid_len;
+
+		ssid = connman_network_get_blob(network, "WiFi.SSID",
+							&ssid_len);
+		if (!ssid || ssid_len != wps_ssid_len ||
+				memcmp(ssid, wps_ssid, ssid_len) != 0)
+			continue;
+
+		DBG("WPS provisioned a known network");
+
+		connman_network_set_bool(network, "WiFi.UseWPS", true);
+		wifi->network = network;
+
+		clear_wps_state(wifi);
+
+		return;
+	}
+
+	DBG("WPS provisioned an unknown network, disconnecting");
+
+	g_supplicant_interface_wps_cancel(wifi->interface,
+						cancel_wps_callback, wifi);
+	wps_failed(wifi);
+}
+
+static int wifi_start_wps(struct connman_device *device, const char *pin)
+{
+	struct wifi_data *wifi = connman_device_get_data(device);
+
+	DBG("device %p", device);
+
+	if (!wifi || !wifi->interface)
+		return -EINVAL;
+
+	if (wifi->wps_active)
+		return -EINPROGRESS;
+
+	wifi->wps_active = true;
+	if (pin && *pin != '\0')
+		wifi->wps_pin = g_strdup(pin);
+
+	/*
+	 * Issuing the WPS command tears down any current association, so if a
+	 * disconnect is already in flight wait for it to land first.
+	 */
+	if (wifi->disconnecting) {
+		DBG("deferring WPS until the disconnect completes");
+		wifi->wps_start_deferred = true;
+		return 0;
+	}
+
+	if (wifi->network) {
+		connman_network_set_connected(wifi->network, false);
+		connman_network_set_associating(wifi->network, false);
+		wifi->network = NULL;
+	}
+
+	return start_wps(wifi);
+}
+
+static int wifi_cancel_wps(struct connman_device *device)
+{
+	struct wifi_data *wifi = connman_device_get_data(device);
+
+	DBG("device %p", device);
+
+	if (!wifi)
+		return -EINVAL;
+
+	if (!wifi->wps_active)
+		return 0;
+
+	return cancel_wps(wifi);
+}
+
 static int wifi_set_regdom(struct connman_device *device, const char *alpha2)
 {
 	struct wifi_data *wifi = connman_device_get_data(device);
@@ -2085,6 +2340,8 @@ static struct connman_device_driver wifi_ng_driver = {
 	.scan		= wifi_scan,
 	.stop_scan	= wifi_stop_scan,
 	.set_regdom	= wifi_set_regdom,
+	.start_wps	= wifi_start_wps,
+	.cancel_wps	= wifi_cancel_wps,
 };
 
 static void system_ready(void)
@@ -2297,6 +2554,11 @@ static void disconnect_callback(int result, GSupplicantInterface *interface,
 
 	wifi->disconnecting = false;
 
+	if (wifi->wps_start_deferred) {
+		deferred_wps_start(wifi);
+		return;
+	}
+
 	if (network != wifi->network) {
 		if (network == wifi->pending_network)
 			wifi->pending_network = NULL;
@@ -3343,6 +3605,7 @@ static const GSupplicantCallbacks callbacks = {
 	.interface_added	= interface_added,
 	.interface_state	= interface_state,
 	.interface_removed	= interface_removed,
+	.wps_state		= wps_state,
 	.p2p_support		= p2p_support,
 	.scan_started		= scan_started,
 	.scan_finished		= scan_finished,

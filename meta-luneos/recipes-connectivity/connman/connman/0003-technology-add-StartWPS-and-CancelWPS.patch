@@ -1179,6 +1179,90 @@ int __connman_device_request_hidden_scan(struct connman_device *device,
 	return device->driver->scan(device, &params);
 }
 
+/*
+ * Technology wide WPS, i.e. "the user pressed the button on the router,
+ * find whatever network answers".  This is distinct from the per-network
+ * WPS that is driven through the agent and the WiFi.UseWPS network
+ * property; there is no target service yet when this is called.
+ */
+int __connman_device_request_start_wps(enum connman_service_type type,
+							const char *pin)
+{
+	bool success = false;
+	int last_err = -ENOSYS;
+	GSList *list;
+	int err;
+
+	if (type != CONNMAN_SERVICE_TYPE_WIFI)
+		return -EOPNOTSUPP;
+
+	for (list = device_list; list; list = list->next) {
+		struct connman_device *device = list->data;
+
+		if (!device_has_service_type(device, type))
+			continue;
+
+		if (!device->driver || !device->driver->start_wps) {
+			last_err = -EOPNOTSUPP;
+			continue;
+		}
+
+		if (!device->powered) {
+			last_err = -ENOLINK;
+			continue;
+		}
+
+		err = device->driver->start_wps(device, pin);
+		if (err == 0 || err == -EALREADY || err == -EINPROGRESS) {
+			success = true;
+		} else {
+			last_err = err;
+			DBG("device %p err %d", device, err);
+		}
+	}
+
+	if (success)
+		return 0;
+
+	return last_err;
+}
+
+int __connman_device_request_cancel_wps(enum connman_service_type type)
+{
+	bool success = false;
+	int last_err = -ENOSYS;
+	GSList *list;
+	int err;
+
+	if (type != CONNMAN_SERVICE_TYPE_WIFI)
+		return -EOPNOTSUPP;
+
+	for (list = device_list; list; list = list->next) {
+		struct connman_device *device = list->data;
+
+		if (!device_has_service_type(device, type))
+			continue;
+
+		if (!device->driver || !device->driver->cancel_wps) {
+			last_err = -EOPNOTSUPP;
+			continue;
+		}
+
+		err = device->driver->cancel_wps(device);
+		if (err == 0 || err == -EALREADY || err == -EINPROGRESS) {
+			success = true;
+		} else {
+			last_err = err;
+			DBG("device %p err %d", device, err);
+		}
+	}
+
+	if (success)
+		return 0;
+
+	return last_err;
+}
+
 void __connman_device_stop_scan(enum connman_service_type type)
 {
 	GSList *list;
diff --git a/src/technology.c b/src/technology.c
index 299100b..dfcd7f7 100644
--- a/src/technology.c
+++ b/src/technology.c
@@ -1333,6 +1333,72 @@ static DBusMessage *scan(DBusConnection *conn, DBusMessage *msg, void *data)
 	return NULL;
 }
 
+void connman_technology_wps_failed_notify(struct connman_technology *technology)
+{
+	if (!technology || !technology->path)
+		return;
+
+	g_dbus_emit_signal(connection, technology->path,
+			CONNMAN_TECHNOLOGY_INTERFACE, "WPSFailed",
+			DBUS_TYPE_INVALID);
+}
+
+/*
+ * Technology wide WPS, as used by com.webos.service.wifi/startwps. Unlike
+ * the agent driven per-network WPS there is no target service yet: the
+ * supplicant is asked to associate with whatever access point answers.
+ */
+static DBusMessage *start_wps(DBusConnection *conn, DBusMessage *msg,
+								void *data)
+{
+	struct connman_technology *technology = data;
+	const char *pin = NULL;
+	DBusMessageIter iter;
+	int err;
+
+	DBG("technology %p request from %s", technology,
+			dbus_message_get_sender(msg));
+
+	if (technology->type != CONNMAN_SERVICE_TYPE_WIFI)
+		return __connman_error_not_supported(msg);
+
+	if (!technology->enabled)
+		return __connman_error_permission_denied(msg);
+
+	if (!dbus_message_iter_init(msg, &iter))
+		return __connman_error_invalid_arguments(msg);
+
+	if (dbus_message_iter_get_arg_type(&iter) != DBUS_TYPE_STRING)
+		return __connman_error_invalid_arguments(msg);
+
+	dbus_message_iter_get_basic(&iter, &pin);
+
+	err = __connman_device_request_start_wps(technology->type, pin);
+	if (err < 0)
+		return __connman_error_failed(msg, -err);
+
+	return g_dbus_create_reply(msg, DBUS_TYPE_INVALID);
+}
+
+static DBusMessage *cancel_wps(DBusConnection *conn, DBusMessage *msg,
+								void *data)
+{
+	struct connman_technology *technology = data;
+	int err;
+
+	DBG("technology %p request from %s", technology,
+			dbus_message_get_sender(msg));
+
+	if (technology->type != CONNMAN_SERVICE_TYPE_WIFI)
+		return __connman_error_not_supported(msg);
+
+	err = __connman_device_request_cancel_wps(technology->type);
+	if (err < 0)
+		return __connman_error_failed(msg, -err);
+
+	return g_dbus_create_reply(msg, DBUS_TYPE_INVALID);
+}
+

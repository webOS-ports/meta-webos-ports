diff --git a/gsupplicant/supplicant.c b/gsupplicant/supplicant.c
index e6a65cf..8f52c82 100644
--- a/gsupplicant/supplicant.c
+++ b/gsupplicant/supplicant.c
@@ -1285,6 +1285,66 @@ dbus_uint16_t g_supplicant_network_get_frequency(GSupplicantNetwork *network)
 	return network->frequency;
 }
 
+/*
+ * The access point behind the network, as opposed to the network itself.
+ * best_bss is whichever BSS the network is currently represented by, and it
+ * is NULL while a network is being torn down, so every one of these has to
+ * cope with that rather than assume a BSS is present.
+ */
+const unsigned char *g_supplicant_network_get_bssid(
+						GSupplicantNetwork *network)
+{
+	if (!network || !network->best_bss)
+		return NULL;
+
+	return network->best_bss->bssid;
+}
+
+dbus_uint32_t g_supplicant_network_get_maxrate(GSupplicantNetwork *network)
+{
+	if (!network || !network->best_bss)
+		return 0;
+
+	return network->best_bss->maxrate;
+}
+
+/*
+ * The pairwise cipher actually in use, named the way the WiFi plugin already
+ * names ciphers elsewhere. RSN is preferred over WPA when the BSS advertises
+ * both, which is what the supplicant will have selected.
+ */
+const char *g_supplicant_network_get_enc_mode(GSupplicantNetwork *network)
+{
+	unsigned int pairwise;
+
+	if (!network || !network->best_bss)
+		return NULL;
+
+	if (network->best_bss->rsn_selected)
+		pairwise = network->best_bss->rsn_pairwise;
+	else
+		pairwise = network->best_bss->wpa_pairwise;
+
+	if ((pairwise & G_SUPPLICANT_PAIRWISE_CCMP) &&
+			(pairwise & G_SUPPLICANT_PAIRWISE_TKIP))
+		return "mixed";
+
+	if (pairwise & G_SUPPLICANT_PAIRWISE_CCMP)
+		return "aes";
+
+	if (pairwise & G_SUPPLICANT_PAIRWISE_TKIP)
+		return "tkip";
+
+	/*
+	 * No pairwise cipher advertised: either the BSS is open, or it is WEP,
+	 * which has no pairwise suite to report.
+	 */
+	if (network->best_bss->privacy)
+		return "wep";
+
+	return "none";
+}
+
 dbus_bool_t g_supplicant_network_get_wps(GSupplicantNetwork *network)
 {
 	if (!network)
@@ -2223,6 +2283,16 @@ static void interface_current_bss(GSupplicantInterface *interface,
 
 		network->best_bss = bss;
 
+		/*
+		 * Everything the access point itself reports - BSSID,
+		 * frequency, rate, cipher - belongs to the BSS, so it has all
+		 * just changed. Signalling this separately matters because the
+		 * signal notification below is conditional: a roam to an AP
+		 * that happens to read the same strength would otherwise go
+		 * unannounced, leaving the old BSSID published.
+		 */
+		callback_network_changed(network, "BSS");
+
 		if (network->signal != bss->signal) {
 			SUPPLICANT_DBG("New network signal %d dBm",
 						bss->signal);

+/*
+ * What the access point behind this network reports about itself. All of it
+ * comes from the BSS the supplicant currently considers best, so it changes
+ * on a roam and is refreshed again from network_changed().
+ */
+static void update_network_ap_info(struct connman_network *network,
+				GSupplicantNetwork *supplicant_network)
+{
+	const unsigned char *bssid;
+	const char *enc_mode;
+
+	bssid = g_supplicant_network_get_bssid(supplicant_network);
+	if (bssid) {
+		char bssid_str[18];
+
+		snprintf(bssid_str, sizeof(bssid_str),
+				"%02x:%02x:%02x:%02x:%02x:%02x",
+				bssid[0], bssid[1], bssid[2],
+				bssid[3], bssid[4], bssid[5]);
+		connman_network_set_string(network, "WiFi.BSSID", bssid_str);
+	}
+
+	connman_network_set_frequency(network,
+			g_supplicant_network_get_frequency(supplicant_network));
+	connman_network_set_maxrate(network,
+			g_supplicant_network_get_maxrate(supplicant_network));
+
+	enc_mode = g_supplicant_network_get_enc_mode(supplicant_network);
+	if (enc_mode)
+		connman_network_set_string(network, "WiFi.EncryptionMode",
+								enc_mode);
+}
+
 static void network_added(GSupplicantNetwork *supplicant_network)
 {
 	struct connman_network *network;
@@ -3200,8 +3233,7 @@ static void network_added(GSupplicantNetwork *supplicant_network)
 			connman_network_set_bool(network, "WiFi.UseWPS", true);
 	}
 
-	connman_network_set_frequency(network,
-			g_supplicant_network_get_frequency(supplicant_network));
+	update_network_ap_info(network, supplicant_network);
 
 	connman_network_set_available(network, true);
 	connman_network_set_string(network, "WiFi.Mode", mode);
@@ -3300,6 +3332,9 @@ static void network_changed(GSupplicantNetwork *network, const char *property)
 							"WiFi.UseWPS", true);
 		}
 
+		update_needed = true;
+	} else if (g_str_equal(property, "BSS")) {
+		update_network_ap_info(connman_network, network);
 		update_needed = true;
 	} else if (g_str_equal(property, "Signal")) {
 		connman_network_set_strength(connman_network,

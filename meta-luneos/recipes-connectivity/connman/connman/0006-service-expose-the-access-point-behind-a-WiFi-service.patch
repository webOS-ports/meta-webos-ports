@@ -10574,6 +10605,70 @@ static void update_wps_values(struct connman_service *service,
 	}
 }
 
+/*
+ * Mirror the access point details the WiFi plugin put on the network onto the
+ * service, where they can be published. Each is announced on its own so a
+ * client that cached GetProperties sees a roam, rather than keeping whatever
+ * the AP looked like when it first asked.
+ */
+static void update_ap_values(struct connman_service *service,
+				struct connman_network *network)
+{
+	const char *bssid = connman_network_get_string(network, "WiFi.BSSID");
+	const char *enc_mode = connman_network_get_string(network,
+							"WiFi.EncryptionMode");
+	uint16_t frequency = connman_network_get_frequency(network);
+	uint32_t maxrate = connman_network_get_maxrate(network);
+	/*
+	 * This also runs while the service is still being created from its
+	 * network, before it has been registered and given a path. Nothing can
+	 * be announced yet - and allow_property_changed() cannot even be asked,
+	 * because it hashes service->path, which is still NULL at that point.
+	 * The values are still recorded, so the first GetProperties carries
+	 * them; only the signal is skipped.
+	 */
+	bool notify = service->path && allow_property_changed(service);
+
+	if (g_strcmp0(service->bssid, bssid) != 0) {
+		g_free(service->bssid);
+		service->bssid = g_strdup(bssid);
+
+		if (service->bssid && notify)
+			connman_dbus_property_changed_basic(service->path,
+					CONNMAN_SERVICE_INTERFACE, "BSSID",
+					DBUS_TYPE_STRING, &service->bssid);
+	}
+
+	if (g_strcmp0(service->enc_mode, enc_mode) != 0) {
+		g_free(service->enc_mode);
+		service->enc_mode = g_strdup(enc_mode);
+
+		if (service->enc_mode && notify)
+			connman_dbus_property_changed_basic(service->path,
+					CONNMAN_SERVICE_INTERFACE,
+					"EncryptionMode",
+					DBUS_TYPE_STRING, &service->enc_mode);
+	}
+
+	if (service->frequency != frequency) {
+		service->frequency = frequency;
+
+		if (notify)
+			connman_dbus_property_changed_basic(service->path,
+					CONNMAN_SERVICE_INTERFACE, "Frequency",
+					DBUS_TYPE_UINT16, &service->frequency);
+	}
+
+	if (service->maxrate != maxrate) {
+		service->maxrate = maxrate;
+
+		if (notify)
+			connman_dbus_property_changed_basic(service->path,
+					CONNMAN_SERVICE_INTERFACE, "MaxRate",
+					DBUS_TYPE_UINT32, &service->maxrate);
+	}
+}
+
 static void update_from_network(struct connman_service *service,
 					struct connman_network *network)
 {
@@ -10613,8 +10708,10 @@ static void update_from_network(struct connman_service *service,
 	str = connman_network_get_string(network, "WiFi.Security");
 	service->security = convert_wifi_security(str);
 
-	if (service->type == CONNMAN_SERVICE_TYPE_WIFI)
+	if (service->type == CONNMAN_SERVICE_TYPE_WIFI) {
 		update_wps_values(service, network);
+		update_ap_values(service, network);
+	}
 
 	if (service->strength > strength && service->network) {
 		connman_network_unref(service->network);
@@ -10802,8 +10899,10 @@ void __connman_service_update_from_network(struct connman_network *network)
 					DBUS_TYPE_STRING, &service->name);
 	}
 
-	if (service->type == CONNMAN_SERVICE_TYPE_WIFI)
+	if (service->type == CONNMAN_SERVICE_TYPE_WIFI) {
 		update_wps_values(service, network);
+		update_ap_values(service, network);
+	}
 
 	strength = connman_network_get_strength(service->network);
 	if (strength == service->strength)

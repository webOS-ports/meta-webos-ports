diff --git a/gsupplicant/gsupplicant.h b/gsupplicant/gsupplicant.h
index ff765df..a99c628 100644
--- a/gsupplicant/gsupplicant.h
+++ b/gsupplicant/gsupplicant.h
@@ -164,8 +164,19 @@ struct _GSupplicantSSID {
 	const char *bgscan;
 	unsigned int keymgmt;
 	GSupplicantMfpOptions ieee80211w;
+	/*
+	 * When mac_addr_set, sent as wpa_supplicant's per-network mac_addr
+	 * policy: G_SUPPLICANT_MAC_ADDR_PERMANENT for the hardware address,
+	 * G_SUPPLICANT_MAC_ADDR_DEDICATED for mac_value.
+	 */
+	dbus_bool_t mac_addr_set;
+	unsigned int mac_addr;
+	unsigned char mac_value[6];
 };
 
+#define G_SUPPLICANT_MAC_ADDR_PERMANENT	0
+#define G_SUPPLICANT_MAC_ADDR_DEDICATED	3
+
 typedef struct _GSupplicantSSID GSupplicantSSID;
 
 struct scan_ssid {
@@ -280,6 +291,17 @@ int g_supplicant_interface_disconnect(GSupplicantInterface *interface,
 					GSupplicantInterfaceCallback callback,
 							void *user_data);
 
+typedef void (*GSupplicantMacRandCallback) (int result, const char *ifname);
+
+/*
+ * Have wpa_supplicant send scans and probe requests from random addresses
+ * (MACAddressRandomizationMask) for every scan type the driver supports.
+ * callback, if given, gets 0 or a negative errno once it is known.
+ */
+int g_supplicant_interface_set_scan_mac_randomization(
+					GSupplicantInterface *interface,
+					GSupplicantMacRandCallback callback);
+
 int g_supplicant_interface_set_bss_expiration_age(GSupplicantInterface *interface,
 					unsigned int bss_expiration_age);
 
diff --git a/gsupplicant/supplicant.c b/gsupplicant/supplicant.c
index 8f52c82..9d9c99e 100644
--- a/gsupplicant/supplicant.c
+++ b/gsupplicant/supplicant.c
@@ -1018,6 +1018,131 @@ static void set_bss_expiration_age(DBusMessageIter *iter, void *user_data)
 				&bss_expiration_age);
 }
 
+/*
+ * wpa_supplicant turns randomisation on for the scan types it is given and
+ * off for the rest, and refuses the whole set if the driver lacks one of
+ * them, so try the widest set first and narrow it down.
+ */
+static const char *const scan_mac_rand_types[][4] = {
+	{ "scan", "sched_scan", "pno", NULL },
+	{ "scan", "sched_scan", NULL },
+	{ "scan", NULL },
+};
+
+struct scan_mac_rand_data {
+	char *path;
+	char *ifname;
+	unsigned int attempt;
+	GSupplicantMacRandCallback callback;
+};
+
+static void scan_mac_rand_data_free(struct scan_mac_rand_data *data)
+{
+	g_free(data->path);
+	g_free(data->ifname);
+	g_free(data);
+}
+
+static void set_scan_mac_rand_params(DBusMessageIter *iter, void *user_data)
+{
+	struct scan_mac_rand_data *data = user_data;
+	const char *const *type = scan_mac_rand_types[data->attempt];
+	/*
+	 * wpa_supplicant combines the mask with the permanent address: bits
+	 * set are kept. Only keep the multicast bit, which the kernel
+	 * requires, so the other 47 bits are new for every scan.
+	 */
+	static const unsigned char mask[6] = { 0x01, 0, 0, 0, 0, 0 };
+	const unsigned char *mask_ptr = mask;
+	DBusMessageIter dict, entry, array;
+
+	dbus_message_iter_open_container(iter, DBUS_TYPE_ARRAY,
+			DBUS_DICT_ENTRY_BEGIN_CHAR_AS_STRING
+			DBUS_TYPE_STRING_AS_STRING
+			DBUS_TYPE_ARRAY_AS_STRING DBUS_TYPE_BYTE_AS_STRING
+			DBUS_DICT_ENTRY_END_CHAR_AS_STRING, &dict);
+
+	for (; *type; type++) {
+		dbus_message_iter_open_container(&dict, DBUS_TYPE_DICT_ENTRY,
+							NULL, &entry);
+		dbus_message_iter_append_basic(&entry, DBUS_TYPE_STRING, type);
+		dbus_message_iter_open_container(&entry, DBUS_TYPE_ARRAY,
+					DBUS_TYPE_BYTE_AS_STRING, &array);
+		dbus_message_iter_append_fixed_array(&array, DBUS_TYPE_BYTE,
+						&mask_ptr, sizeof(mask));
+		dbus_message_iter_close_container(&entry, &array);
+		dbus_message_iter_close_container(&dict, &entry);
+	}
+
+	dbus_message_iter_close_container(iter, &dict);
+}
+
+static int scan_mac_rand_send(struct scan_mac_rand_data *data);
+
+static void set_scan_mac_rand_result(const char *error,
+				DBusMessageIter *iter, void *user_data)
+{
+	struct scan_mac_rand_data *data = user_data;
+	int err = 0;
+
+	if (error) {
+		SUPPLICANT_DBG("%s: scan MAC randomisation set %u refused: %s",
+					data->ifname, data->attempt, error);
+		data->attempt++;
+		if (data->attempt < G_N_ELEMENTS(scan_mac_rand_types)) {
+			err = scan_mac_rand_send(data);
+			if (err == 0)
+				return;
+		} else {
+			err = -EOPNOTSUPP;
+		}
+	}
+
+	if (data->callback)
+		data->callback(err, data->ifname);
+
+	scan_mac_rand_data_free(data);
+}
+
+static int scan_mac_rand_send(struct scan_mac_rand_data *data)
+{
+	/*
+	 * No caller: the reply is always delivered, so data is always
+	 * freed, and only the copied path and name are used, never the
+	 * interface, which may be gone by then.
+	 */
+	return supplicant_dbus_property_set(data->path,
+				SUPPLICANT_INTERFACE ".Interface",
+				"MACAddressRandomizationMask", "a{say}",
+				set_scan_mac_rand_params,
+				set_scan_mac_rand_result, data, NULL);
+}
+
+int g_supplicant_interface_set_scan_mac_randomization(
+					GSupplicantInterface *interface,
+					GSupplicantMacRandCallback callback)
+{
+	struct scan_mac_rand_data *data;
+	int err;
+
+	if (!interface || !interface->path)
+		return -EINVAL;
+
+	data = g_try_new0(struct scan_mac_rand_data, 1);
+	if (!data)
+		return -ENOMEM;
+
+	data->path = g_strdup(interface->path);
+	data->ifname = g_strdup(interface->ifname);
+	data->callback = callback;
+
+	err = scan_mac_rand_send(data);
+	if (err < 0)
+		scan_mac_rand_data_free(data);
+
+	return err;
+}
+
 int g_supplicant_interface_set_bss_expiration_age(GSupplicantInterface *interface,
 					unsigned int bss_expiration_age)
 {
@@ -5068,6 +5193,28 @@ static void add_network_mode(DBusMessageIter *dict, GSupplicantSSID *ssid)
 				DBUS_TYPE_UINT32, &mode);
 }
 
+static void add_network_mac_addr(DBusMessageIter *dict, GSupplicantSSID *ssid)
+{
+	char value[18];
+	const char *str = value;
+	const unsigned char *a = ssid->mac_value;
+
+	if (!ssid->mac_addr_set)
+		return;
+
+	supplicant_dbus_dict_append_basic(dict, "mac_addr",
+					DBUS_TYPE_UINT32, &ssid->mac_addr);
+
+	if (ssid->mac_addr != G_SUPPLICANT_MAC_ADDR_DEDICATED)
+		return;
+
+	/* wpa_supplicant takes mac_value unquoted, colon separated. */
+	snprintf(value, sizeof(value), "%02x:%02x:%02x:%02x:%02x:%02x",
+					a[0], a[1], a[2], a[3], a[4], a[5]);
+	supplicant_dbus_dict_append_basic(dict, "mac_value",
+					DBUS_TYPE_STRING, &str);
+}
+
 static void interface_add_network_params(DBusMessageIter *iter, void *user_data)
 {
 	DBusMessageIter dict;
@@ -5090,6 +5237,8 @@ static void interface_add_network_params(DBusMessageIter *iter, void *user_data)
 
 	add_network_mode(&dict, ssid);
 
+	add_network_mac_addr(&dict, ssid);
+
 	add_network_security(&dict, ssid);
 
 	supplicant_dbus_dict_append_fixed_array(&dict, "ssid",
diff --git a/plugins/wifi.c b/plugins/wifi.c
index b57d792..cc329b9 100644
--- a/plugins/wifi.c
+++ b/plugins/wifi.c
@@ -60,6 +60,7 @@
 #include <gsupplicant/gsupplicant.h>
 
 #include "src/shared/util.h"
+#include "src/wifi-mac.h"
 
 #define CLEANUP_TIMEOUT   8	/* in seconds */
 #define INACTIVE_TIMEOUT  12	/* in seconds */
@@ -172,6 +173,8 @@ struct wifi_data {
 	bool wps_start_deferred;
 	char *wps_pin;
 	guint wps_timeout;
+	/* The driver lets wpa_supplicant set a per-network address. */
+	bool mac_rand;
 };
 
 static void clear_wps_state(struct wifi_data *wifi);
@@ -1553,6 +1556,172 @@ static void finalize_interface_creation(struct wifi_data *wifi)
 	start_autoscan(wifi->device);
 }
 
+#define CONF_WIFI_MAC_RANDOMIZATION "WiFiMACRandomization"
+
+static unsigned char mac_secret[WIFI_MAC_SECRET_LEN];
+static bool mac_secret_loaded;
+
+static void mac_secret_clear(void)
+{
+	volatile unsigned char *p = mac_secret;
+	size_t i;
+
+	for (i = 0; i < sizeof(mac_secret); i++)
+		p[i] = 0;
+	mac_secret_loaded = false;
+}
+
+/*
+ * Find out, once per interface and boot, whether its address can be
+ * changed. Done before wpa_supplicant takes the interface, because the
+ * check takes it down for a moment; afterwards the answer stored under
+ * STATEDIR is used, also after connmand restarts.
+ */
+static void wifi_mac_prepare(struct wifi_data *wifi, const char *ifname)
+{
+	unsigned char hwaddr[WIFI_MAC_ADDR_LEN];
+	bool changeable;
+	int err;
+
+	wifi->mac_rand = false;
+
+	if (!connman_setting_get_bool(CONF_WIFI_MAC_RANDOMIZATION) || !ifname)
+		return;
+
+	if (__connman_wifi_mac_hwaddr_load(STATEDIR, ifname, hwaddr,
+						&changeable) == 0) {
+		wifi->mac_rand = changeable;
+		return;
+	}
+
+	err = __connman_wifi_mac_get_hwaddr(ifname, hwaddr);
+	if (err < 0) {
+		connman_warn("%s: cannot read the MAC address (%s), "
+				"using the hardware address", ifname,
+				strerror(-err));
+		return;
+	}
+
+	err = __connman_wifi_mac_probe(ifname);
+	changeable = err == 0;
+	if (!changeable)
+		connman_warn("%s: the driver does not let the MAC address be "
+				"changed (%s), connecting with the hardware "
+				"address", ifname, strerror(-err));
+
+	err = __connman_wifi_mac_hwaddr_save(STATEDIR, ifname, hwaddr,
+							changeable);
+	if (err < 0)
+		connman_warn("%s: cannot store the hardware address: %s",
+						ifname, strerror(-err));
+
+	wifi->mac_rand = changeable;
+}
+
+static void scan_mac_rand_result(int result, const char *ifname)
+{
+	if (result < 0)
+		connman_warn("%s: the driver cannot scan from random "
+				"addresses (%s), scanning with the "
+				"hardware address", ifname ? ifname : "wifi",
+				strerror(-result));
+	else
+		DBG("%s: scanning from random addresses", ifname);
+}
+
+static void wifi_mac_scan_randomization(GSupplicantInterface *interface)
+{
+	int err;
+
+	if (!connman_setting_get_bool(CONF_WIFI_MAC_RANDOMIZATION))
+		return;
+
+	err = g_supplicant_interface_set_scan_mac_randomization(interface,
+							scan_mac_rand_result);
+	if (err < 0)
+		connman_warn("Cannot ask for random scan addresses: %s",
+							strerror(-err));
+}
+
+static const char *mac_security_name(GSupplicantSecurity security)
+{
+	switch (security) {
+	case G_SUPPLICANT_SECURITY_NONE:
+		return "none";
+	case G_SUPPLICANT_SECURITY_WEP:
+		return "wep";
+	case G_SUPPLICANT_SECURITY_PSK:
+		return "psk";
+	case G_SUPPLICANT_SECURITY_IEEE8021X:
+		return "ieee8021x";
+	case G_SUPPLICANT_SECURITY_UNKNOWN:
+		break;
+	}
+
+	return NULL;
+}
+
+/*
+ * Pick the address wpa_supplicant associates with: the network's own one,
+ * or the hardware one if the network opted out. Whenever randomisation
+ * cannot be done, nothing is sent and wpa_supplicant keeps the address it
+ * has, so a connection never fails because of it.
+ */
+static void ssid_init_mac_addr(struct wifi_data *wifi, GSupplicantSSID *ssid,
+					struct connman_network *network)
+{
+	const char *driver, *security;
+	int err;
+
+	ssid->mac_addr_set = FALSE;
+
+	if (!connman_setting_get_bool(CONF_WIFI_MAC_RANDOMIZATION))
+		return;
+
+	if (connman_network_get_bool(network, "WiFi.UseDeviceMAC")) {
+		ssid->mac_addr_set = TRUE;
+		ssid->mac_addr = G_SUPPLICANT_MAC_ADDR_PERMANENT;
+		return;
+	}
+
+	if (!wifi->mac_rand)
+		return;
+
+	/* Only wpa_supplicant's nl80211 driver can change the address. */
+	driver = g_supplicant_interface_get_driver(wifi->interface);
+	if (driver && g_strcmp0(driver, "nl80211") != 0) {
+		connman_warn_once("wpa_supplicant driver %s cannot change "
+				"the MAC address, using the hardware address",
+				driver);
+		return;
+	}
+
+	security = mac_security_name(ssid->security);
+	if (!security || !ssid->ssid || ssid->ssid_len == 0)
+		return;
+
+	if (!mac_secret_loaded) {
+		err = __connman_wifi_mac_secret_get(STORAGEDIR, mac_secret,
+							sizeof(mac_secret));
+		if (err < 0) {
+			connman_warn_once("Cannot read or create %s/%s (%s), "
+					"using the hardware MAC address",
+					STORAGEDIR, WIFI_MAC_SECRET_FILE,
+					strerror(-err));
+			return;
+		}
+		mac_secret_loaded = true;
+	}
+
+	if (__connman_wifi_mac_derive(mac_secret, sizeof(mac_secret),
+					ssid->ssid, ssid->ssid_len, security,
+					ssid->mac_value) < 0)
+		return;
+
+	ssid->mac_addr_set = TRUE;
+	ssid->mac_addr = G_SUPPLICANT_MAC_ADDR_DEDICATED;
+}
+
 static void interface_create_callback(int result,
 					GSupplicantInterface *interface,
 							void *user_data)
@@ -1571,6 +1740,8 @@ static void interface_create_callback(int result,
 	wifi->interface = interface;
 	g_supplicant_interface_set_data(interface, wifi);
 
+	wifi_mac_scan_randomization(interface);
+
 	if (g_supplicant_interface_get_ready(interface)) {
 		wifi->interface_ready = true;
 		finalize_interface_creation(wifi);
@@ -1613,6 +1784,7 @@ static int wifi_enable(struct connman_device *device)
 		return -EINPROGRESS;
 
 	interface = connman_inet_ifname(index);
+	wifi_mac_prepare(wifi, interface);
 	ret = g_supplicant_interface_create(interface, driver, NULL,
 						interface_create_callback,
 							wifi);
@@ -2520,6 +2692,7 @@ static int network_connect(struct connman_network *network)
 		g_free(ssid);
 	} else {
 		ssid_init(ssid, network);
+		ssid_init_mac_addr(wifi, ssid, network);
 
 		wifi->network = connman_network_ref(network);
 		wifi->retries = 0;
@@ -3998,6 +4171,8 @@ static void wifi_exit(void)
 	g_supplicant_unregister(&callbacks);
 
 	connman_network_driver_unregister(&network_driver);
+
+	mac_secret_clear();
 }
 
 CONNMAN_PLUGIN_DEFINE(wifi, "WiFi interface plugin", VERSION,

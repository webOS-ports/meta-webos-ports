+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/ioctl.h>
+#include <sys/random.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <net/if.h>
+#include <net/if_arp.h>
+
+#include <glib.h>
+
+#include <connman/log.h>
+
+#include "wifi-mac.h"
+
+/* Domain separation, so the secret cannot be reused for another purpose. */
+static const char derive_label[] = "connman-wifi-mac-v1";
+
+#define HWADDR_FILE_MAX	64
+
+static void secure_zero(void *p, size_t len)
+{
+	volatile unsigned char *v = p;
+
+	while (len--)
+		*v++ = 0;
+}
+
+void __connman_wifi_mac_set_local_unicast(unsigned char *addr)
+{
+	addr[0] = (unsigned char) ((addr[0] | 0x02) & ~0x01);
+}
+
+bool __connman_wifi_mac_is_local_unicast(const unsigned char *addr)
+{
+	return (addr[0] & 0x03) == 0x02;
+}
+
+int __connman_wifi_mac_derive(const unsigned char *secret, size_t secret_len,
+				const unsigned char *ssid, size_t ssid_len,
+				const char *security, unsigned char *addr)
+{
+	unsigned char digest[32];
+	gsize digest_len = sizeof(digest);
+	unsigned char len_byte;
+	GHmac *hmac;
+
+	if (!secret || secret_len == 0 || !ssid || ssid_len == 0 ||
+			ssid_len > 32 || !security || !addr)
+		return -EINVAL;
+
+	hmac = g_hmac_new(G_CHECKSUM_SHA256, secret, secret_len);
+	if (!hmac)
+		return -ENOMEM;
+
+	/*
+	 * label NUL | ssid length | ssid | security: the length byte keeps
+	 * an SSID that ends in a security name from colliding with another.
+	 */
+	g_hmac_update(hmac, (const guchar *) derive_label,
+						sizeof(derive_label));
+	len_byte = (unsigned char) ssid_len;
+	g_hmac_update(hmac, &len_byte, 1);
+	g_hmac_update(hmac, ssid, (gssize) ssid_len);
+	g_hmac_update(hmac, (const guchar *) security,
+						(gssize) strlen(security));
+	g_hmac_get_digest(hmac, digest, &digest_len);
+	g_hmac_unref(hmac);
+
+	memcpy(addr, digest, WIFI_MAC_ADDR_LEN);
+	secure_zero(digest, sizeof(digest));
+
+	__connman_wifi_mac_set_local_unicast(addr);
+
+	return 0;
+}
+
+static int read_full(int fd, unsigned char *buf, size_t len)
+{
+	size_t done = 0;
+
+	while (done < len) {
+		ssize_t n = read(fd, buf + done, len - done);
+
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		if (n == 0)
+			return -EINVAL;
+		done += (size_t) n;
+	}
+
+	return 0;
+}
+
+static int write_full(int fd, const unsigned char *buf, size_t len)
+{
+	size_t done = 0;
+
+	while (done < len) {
+		ssize_t n = write(fd, buf + done, len - done);
+
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -errno;
+		}
+		done += (size_t) n;
+	}
+
+	return 0;
+}
+
+/* 0, -ENOENT, or -EINVAL for a file that must not be trusted. */
+static int secret_read(int dfd, unsigned char *secret, size_t len)
+{
+	struct stat st;
+	unsigned char extra;
+	int fd, err;
+
+	fd = openat(dfd, WIFI_MAC_SECRET_FILE,
+			O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		if (errno == ENOENT)
+			return -ENOENT;
+		/* ELOOP for a symlink, anything else is no better. */
+		return -EINVAL;
+	}
+
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) ||
+			st.st_uid != geteuid() || st.st_nlink != 1 ||
+			(st.st_mode & 0077) != 0 ||
+			st.st_size != (off_t) len) {
+		close(fd);
+		return -EINVAL;
+	}
+
+	err = read_full(fd, secret, len);
+	/* Must be exactly len bytes, even if it grew after the fstat. */
+	if (err == 0 && read(fd, &extra, 1) != 0)
+		err = -EINVAL;
+	close(fd);
+
+	if (err < 0) {
+		secure_zero(secret, len);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int secret_create(int dfd, unsigned char *secret, size_t len)
+{
+	static const char tmp_name[] = WIFI_MAC_SECRET_FILE ".tmp";
+	size_t done = 0;
+	int fd, err;
+
+	while (done < len) {
+		ssize_t n = getrandom(secret + done, len - done, 0);
+
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			err = -errno;
+			goto fail;
+		}
+		done += (size_t) n;
+	}
+
+	fd = openat(dfd, tmp_name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW |
+						O_CLOEXEC, S_IRUSR | S_IWUSR);
+	if (fd < 0 && errno == EEXIST) {
+		/* Left over from an interrupted attempt. */
+		if (unlinkat(dfd, tmp_name, 0) < 0 && errno != ENOENT) {
+			err = -errno;
+			goto fail;
+		}
+		fd = openat(dfd, tmp_name, O_WRONLY | O_CREAT | O_EXCL |
+				O_NOFOLLOW | O_CLOEXEC, S_IRUSR | S_IWUSR);
+	}
+	if (fd < 0) {
+		err = -errno;
+		goto fail;
+	}
+
+	err = write_full(fd, secret, len);
+	if (err == 0 && fsync(fd) < 0)
+		err = -errno;
+	if (close(fd) < 0 && err == 0)
+		err = -errno;
+	if (err < 0) {
+		unlinkat(dfd, tmp_name, 0);
+		goto fail;
+	}
+
+	/* Replaces a bad file or a symlink itself, never a symlink target. */
+	if (renameat(dfd, tmp_name, dfd, WIFI_MAC_SECRET_FILE) < 0) {
+		err = -errno;
+		unlinkat(dfd, tmp_name, 0);
+		goto fail;
+	}
+
+	if (fsync(dfd) < 0)
+		connman_warn("Cannot sync the directory of %s: %s",
+				WIFI_MAC_SECRET_FILE, g_strerror(errno));
+
+	return 0;
+
+fail:
+	secure_zero(secret, len);
+	return err;
+}
+
+int __connman_wifi_mac_secret_get(const char *dir, unsigned char *secret,
+							size_t secret_len)
+{
+	int dfd, err;
+
+	if (!dir || !secret || secret_len == 0)
+		return -EINVAL;
+
+	dfd = open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dfd < 0) {
+		err = -errno;
+		secure_zero(secret, secret_len);
+		return err;
+	}
+
+	err = secret_read(dfd, secret, secret_len);
+	if (err == -EINVAL)
+		connman_warn("%s/%s is not a private %zu byte file, "
+				"making a new one", dir, WIFI_MAC_SECRET_FILE,
+				secret_len);
+	if (err < 0)
+		err = secret_create(dfd, secret, secret_len);
+
+	close(dfd);
+
+	return err;
+}
+
+static int iface_ioctl(int sk, unsigned long req, struct ifreq *ifr)
+{
+	if (ioctl(sk, req, ifr) < 0)
+		return -errno;
+	return 0;
+}
+
+static int ifreq_init(struct ifreq *ifr, const char *ifname)
+{
+	size_t len;
+
+	if (!ifname)
+		return -EINVAL;
+
+	len = strlen(ifname);
+	if (len == 0 || len >= sizeof(ifr->ifr_name))
+		return -EINVAL;
+
+	memset(ifr, 0, sizeof(*ifr));
+	memcpy(ifr->ifr_name, ifname, len);
+
+	return 0;
+}
+
+static int get_hwaddr(int sk, const char *ifname, unsigned char *addr)
+{
+	struct ifreq ifr;
+	int err;
+
+	err = ifreq_init(&ifr, ifname);
+	if (err < 0)
+		return err;
+
+	err = iface_ioctl(sk, SIOCGIFHWADDR, &ifr);
+	if (err < 0)
+		return err;
+
+	if (ifr.ifr_hwaddr.sa_family != ARPHRD_ETHER)
+		return -EOPNOTSUPP;
+
+	memcpy(addr, ifr.ifr_hwaddr.sa_data, WIFI_MAC_ADDR_LEN);
+
+	return 0;
+}
+
+static int set_hwaddr(int sk, const char *ifname, const unsigned char *addr)
+{
+	struct ifreq ifr;
+	int err;
+
+	err = ifreq_init(&ifr, ifname);
+	if (err < 0)
+		return err;
+
+	ifr.ifr_hwaddr.sa_family = ARPHRD_ETHER;
+	memcpy(ifr.ifr_hwaddr.sa_data, addr, WIFI_MAC_ADDR_LEN);
+
+	return iface_ioctl(sk, SIOCSIFHWADDR, &ifr);
+}
+
+static int get_flags(int sk, const char *ifname, short *flags)
+{
+	struct ifreq ifr;
+	int err;
+
+	err = ifreq_init(&ifr, ifname);
+	if (err < 0)
+		return err;
+
+	err = iface_ioctl(sk, SIOCGIFFLAGS, &ifr);
+	if (err < 0)
+		return err;
+
+	*flags = ifr.ifr_flags;
+
+	return 0;
+}
+
+static int set_flags(int sk, const char *ifname, short flags)
+{
+	struct ifreq ifr;
+	int err;
+
+	err = ifreq_init(&ifr, ifname);
+	if (err < 0)
+		return err;
+
+	ifr.ifr_flags = flags;
+
+	return iface_ioctl(sk, SIOCSIFFLAGS, &ifr);
+}
+
+static int open_ioctl_socket(void)
+{
+	int sk = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+
+	if (sk < 0)
+		return -errno;
+	return sk;
+}
+
+int __connman_wifi_mac_get_hwaddr(const char *ifname, unsigned char *addr)
+{
+	int sk, err;
+
+	sk = open_ioctl_socket();
+	if (sk < 0)
+		return sk;
+
+	err = get_hwaddr(sk, ifname, addr);
+	close(sk);
+
+	return err;
+}
+
+/* Down, set, back up if it was: what wpa_supplicant's nl80211 driver does. */
+static int change_hwaddr(int sk, const char *ifname,
+					const unsigned char *addr)
+{
+	short flags;
+	int err, up_err = 0;
+
+	err = get_flags(sk, ifname, &flags);
+	if (err < 0)
+		return err;
+
+	if (flags & IFF_UP) {
+		err = set_flags(sk, ifname, (short) (flags & ~IFF_UP));
+		if (err < 0)
+			return err;
+	}
+
+	err = set_hwaddr(sk, ifname, addr);
+
+	if (flags & IFF_UP)
+		up_err = set_flags(sk, ifname, flags);
+
+	return err < 0 ? err : up_err;
+}
+
+int __connman_wifi_mac_set_hwaddr(const char *ifname,
+					const unsigned char *addr)
+{
+	int sk, err;
+
+	sk = open_ioctl_socket();
+	if (sk < 0)
+		return sk;
+
+	err = change_hwaddr(sk, ifname, addr);
+	close(sk);
+
+	return err;
+}
+
+int __connman_wifi_mac_probe(const char *ifname)
+{
+	unsigned char orig[WIFI_MAC_ADDR_LEN], test[WIFI_MAC_ADDR_LEN];
+	short flags;
+	int sk, err, restore_err, up_err = 0;
+
+	sk = open_ioctl_socket();
+	if (sk < 0)
+		return sk;
+
+	err = get_hwaddr(sk, ifname, orig);
+	if (err < 0)
+		goto out;
+
+	if (getrandom(test, sizeof(test), 0) != (ssize_t) sizeof(test)) {
+		err = -EIO;
+		goto out;
+	}
+	__connman_wifi_mac_set_local_unicast(test);
+	if (memcmp(test, orig, sizeof(test)) == 0)
+		test[5] ^= 0x01;
+
+	err = get_flags(sk, ifname, &flags);
+	if (err < 0)
+		goto out;
+
+	if (flags & IFF_UP) {
+		err = set_flags(sk, ifname, (short) (flags & ~IFF_UP));
+		if (err < 0)
+			goto out;
+	}
+
+	err = set_hwaddr(sk, ifname, test);
+	if (err == 0) {
+		restore_err = set_hwaddr(sk, ifname, orig);
+		if (restore_err < 0) {
+			connman_error("Cannot put the address of %s back: %s",
+					ifname, g_strerror(-restore_err));
+			err = restore_err;
+		}
+	}
+
+	if (flags & IFF_UP)
+		up_err = set_flags(sk, ifname, flags);
+	if (up_err < 0)
+		connman_warn("Cannot bring %s back up: %s", ifname,
+						g_strerror(-up_err));
+
+out:
+	close(sk);
+	return err;
+}
+
+static bool valid_ifname(const char *ifname)
+{
+	size_t len;
+
+	if (!ifname)
+		return false;
+
+	len = strlen(ifname);
+	if (len == 0 || len >= IFNAMSIZ)
+		return false;
+
+	if (strchr(ifname, '/') || g_str_equal(ifname, ".") ||
+			g_str_equal(ifname, ".."))
+		return false;
+
+	return true;
+}
+
+int __connman_wifi_mac_hwaddr_save(const char *dir, const char *ifname,
+				const unsigned char *hwaddr, bool changeable)
+{
+	char name[sizeof(WIFI_MAC_HWADDR_PREFIX) + IFNAMSIZ];
+	char tmp[sizeof(name) + 4];
+	char line[HWADDR_FILE_MAX];
+	int dfd, fd, len, err;
+
+	if (!dir || !valid_ifname(ifname) || !hwaddr)
+		return -EINVAL;
+
+	/* Cannot truncate: ifname is shorter than IFNAMSIZ. */
+	if (snprintf(name, sizeof(name), "%s%s", WIFI_MAC_HWADDR_PREFIX,
+					ifname) >= (int) sizeof(name) ||
+			snprintf(tmp, sizeof(tmp), "%s.tmp", name) >=
+							(int) sizeof(tmp))
+		return -EINVAL;
+
+	len = snprintf(line, sizeof(line),
+			"%02x:%02x:%02x:%02x:%02x:%02x %d\n",
+			hwaddr[0], hwaddr[1], hwaddr[2],
+			hwaddr[3], hwaddr[4], hwaddr[5], changeable ? 1 : 0);
+	if (len < 0 || (size_t) len >= sizeof(line))
+		return -EINVAL;
+
+	dfd = open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dfd < 0 && errno == ENOENT && mkdir(dir, S_IRWXU |
+				S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH) == 0)
+		dfd = open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW |
+								O_CLOEXEC);
+	if (dfd < 0)
+		return -errno;
+
+	unlinkat(dfd, tmp, 0);
+	fd = openat(dfd, tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW |
+				O_CLOEXEC, S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH);
+	if (fd < 0) {
+		err = -errno;
+		goto out;
+	}
+
+	err = write_full(fd, (const unsigned char *) line, (size_t) len);
+	if (close(fd) < 0 && err == 0)
+		err = -errno;
+
+	if (err == 0 && renameat(dfd, tmp, dfd, name) < 0)
+		err = -errno;
+	if (err < 0)
+		unlinkat(dfd, tmp, 0);
+
+out:
+	close(dfd);
+	return err;
+}
+
+static int parse_hwaddr_line(const char *line, unsigned char *hwaddr,
+							bool *changeable)
+{
+	unsigned int b[WIFI_MAC_ADDR_LEN], flag;
+	char end;
+	int i;
+
+	if (sscanf(line, "%2x:%2x:%2x:%2x:%2x:%2x %1u%c",
+			&b[0], &b[1], &b[2], &b[3], &b[4], &b[5],
+			&flag, &end) != 8 || end != '\n' || flag > 1)
+		return -EINVAL;
+
+	for (i = 0; i < WIFI_MAC_ADDR_LEN; i++)
+		hwaddr[i] = (unsigned char) b[i];
+	*changeable = flag == 1;
+
+	return 0;
+}
+
+static int hwaddr_load_at(int dfd, const char *name, unsigned char *hwaddr,
+							bool *changeable)
+{
+	char line[HWADDR_FILE_MAX];
+	struct stat st;
+	ssize_t n;
+	int fd;
+
+	fd = openat(dfd, name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0)
+		return errno == ENOENT ? -ENOENT : -EINVAL;
+
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) ||
+			st.st_uid != geteuid() || (st.st_mode & 0022) != 0) {
+		close(fd);
+		return -EINVAL;
+	}
+
+	n = read(fd, line, sizeof(line) - 1);
+	close(fd);
+	if (n <= 0)
+		return -EINVAL;
+	line[n] = '\0';
+
+	return parse_hwaddr_line(line, hwaddr, changeable);
+}
+
+int __connman_wifi_mac_hwaddr_load(const char *dir, const char *ifname,
+				unsigned char *hwaddr, bool *changeable)
+{
+	char name[sizeof(WIFI_MAC_HWADDR_PREFIX) + IFNAMSIZ];
+	int dfd, err;
+
+	if (!dir || !valid_ifname(ifname) || !hwaddr || !changeable)
+		return -EINVAL;
+
+	if (snprintf(name, sizeof(name), "%s%s", WIFI_MAC_HWADDR_PREFIX,
+					ifname) >= (int) sizeof(name))
+		return -EINVAL;
+
+	dfd = open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dfd < 0)
+		return errno == ENOENT ? -ENOENT : -errno;
+
+	err = hwaddr_load_at(dfd, name, hwaddr, changeable);
+	close(dfd);
+
+	return err;
+}
+
+int __connman_wifi_mac_restore_all(const char *dir)
+{
+	const size_t prefix_len = strlen(WIFI_MAC_HWADDR_PREFIX);
+	struct dirent *d;
+	DIR *dirp;
+	int dfd, restored = 0;
+
+	if (!dir)
+		return 0;
+
+	dfd = open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (dfd < 0)
+		return 0;
+
+	dirp = fdopendir(dfd);
+	if (!dirp) {
+		close(dfd);
+		return 0;
+	}
+	/* Owned by dirp from here on. */
+	dfd = dirfd(dirp);
+	if (dfd < 0) {
+		closedir(dirp);
+		return 0;
+	}
+
+	while ((d = readdir(dirp))) {
+		unsigned char hwaddr[WIFI_MAC_ADDR_LEN], cur[WIFI_MAC_ADDR_LEN];
+		const char *ifname;
+		bool changeable;
+		int err;
+
+		if (strncmp(d->d_name, WIFI_MAC_HWADDR_PREFIX, prefix_len) != 0)
+			continue;
+
+		ifname = d->d_name + prefix_len;
+		if (!valid_ifname(ifname) || g_str_has_suffix(ifname, ".tmp"))
+			continue;
+
+		if (hwaddr_load_at(dfd, d->d_name, hwaddr,
+							&changeable) < 0)
+			continue;
+
+		/* Gone, or not ours to touch. */
+		if (__connman_wifi_mac_get_hwaddr(ifname, cur) < 0)
+			continue;
+
+		/*
+		 * Only an address of the kind we set is put back: anything
+		 * else changed it after we looked, and knows better.
+		 */
+		if (!changeable || memcmp(cur, hwaddr, sizeof(cur)) == 0 ||
+				!__connman_wifi_mac_is_local_unicast(cur))
+			continue;
+
+		err = __connman_wifi_mac_set_hwaddr(ifname, hwaddr);
+		if (err < 0) {
+			connman_warn("Cannot restore the address of %s: %s",
+						ifname, g_strerror(-err));
+			continue;
+		}
+
+		connman_info("Restored the hardware address of %s", ifname);
+		restored++;
+	}
+
+	closedir(dirp);
+
+	return restored;
+}

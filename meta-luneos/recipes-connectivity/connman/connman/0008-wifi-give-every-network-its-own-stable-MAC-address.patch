+
+#ifndef __CONNMAN_WIFI_MAC_H
+#define __CONNMAN_WIFI_MAC_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Per-network Wi-Fi MAC addresses.
+ *
+ * Every network gets its own locally administered unicast address,
+ * HMAC-SHA256(device secret, network) truncated to six bytes. The secret
+ * is 32 random bytes made on first use and kept in the storage directory,
+ * so a network sees the same address on every connection and after every
+ * reboot, while two networks cannot link the device by its address.
+ */
+
+#define WIFI_MAC_ADDR_LEN	6
+#define WIFI_MAC_SECRET_LEN	32
+#define WIFI_MAC_SECRET_FILE	"wifi-mac.secret"
+#define WIFI_MAC_HWADDR_PREFIX	"wifi-hwaddr-"
+
+/* Make addr a locally administered (0x02 set) unicast (0x01 clear) one. */
+void __connman_wifi_mac_set_local_unicast(unsigned char *addr);
+bool __connman_wifi_mac_is_local_unicast(const unsigned char *addr);
+
+/*
+ * Derive the address for one network. security is the canonical
+ * connman name ("none", "wep", "psk", "ieee8021x"), so WPA and WPA2/WPA3
+ * variants of the same network keep one address.
+ * Returns 0, or -EINVAL on bad arguments.
+ */
+int __connman_wifi_mac_derive(const unsigned char *secret, size_t secret_len,
+				const unsigned char *ssid, size_t ssid_len,
+				const char *security, unsigned char *addr);
+
+/*
+ * Load the device secret from dir/WIFI_MAC_SECRET_FILE, creating it when
+ * it is missing. A file that is not a regular 0600 file of the right size
+ * owned by us (or is a symlink) is replaced, never followed or trusted.
+ * Returns 0, or a negative errno; on failure secret is zeroed.
+ */
+int __connman_wifi_mac_secret_get(const char *dir, unsigned char *secret,
+							size_t secret_len);
+
+/*
+ * Check whether the driver lets us change the address of ifname, the
+ * way wpa_supplicant does it (interface down, SIOCSIFHWADDR, up), by
+ * setting a throw-away address and putting the old one back.
+ * Returns 0 when it can, a negative errno otherwise.
+ */
+int __connman_wifi_mac_probe(const char *ifname);
+
+/*
+ * Remember the address ifname has now, before any randomisation, and
+ * whether it can be changed. Kept under dir (a tmpfs, so per boot).
+ *
+ * The record is also read outside connmand (the device information
+ * services show it as the device's WiFi address), so its format is an
+ * interface and must not change:
+ *
+ *   path    STATEDIR "/" WIFI_MAC_HWADDR_PREFIX ifname
+ *           (/run/connman/wifi-hwaddr-wlan0 on a usual build)
+ *   owner   root (connmand's euid), mode at most 0644 (never group- or
+ *           world-writable), a regular file,
+ *           replaced atomically by rename()
+ *   content exactly 20 bytes: the address as six lower-case
+ *           two-digit hex octets separated by ':', one space, '1' if
+ *           the driver lets the address be changed or '0' if not,
+ *           and '\n'; for example "02:11:22:33:44:55 1\n"
+ *
+ * It is written once per boot when WiFiMACRandomization is on and the
+ * interface is enabled, before any per-network address is applied, so
+ * it always holds the hardware address. With the option off it is not
+ * written and the interface keeps its hardware address anyway.
+ */
+int __connman_wifi_mac_hwaddr_save(const char *dir, const char *ifname,
+				const unsigned char *hwaddr, bool changeable);
+
+/*
+ * Read back what __connman_wifi_mac_hwaddr_save() stored for ifname.
+ * Returns 0, -ENOENT when nothing is stored, or another negative errno.
+ */
+int __connman_wifi_mac_hwaddr_load(const char *dir, const char *ifname,
+				unsigned char *hwaddr, bool *changeable);
+
+/*
+ * Put the remembered hardware address back on every interface that still
+ * carries a randomised one, which only happens when connmand restarts
+ * while wpa_supplicant keeps the interface. Call it before rtnl starts,
+ * so that the device and its services keep their hardware identity.
+ * Returns the number of interfaces restored.
+ */
+int __connman_wifi_mac_restore_all(const char *dir);
+
+/* Read and set the current address of ifname. */
+int __connman_wifi_mac_get_hwaddr(const char *ifname, unsigned char *addr);
+int __connman_wifi_mac_set_hwaddr(const char *ifname,
+					const unsigned char *addr);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __CONNMAN_WIFI_MAC_H */

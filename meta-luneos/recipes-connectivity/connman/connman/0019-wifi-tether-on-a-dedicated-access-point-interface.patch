 	CONF_PERSISTENT_TETHERING_MODE,
 	CONF_ENABLE_6TO4,
 	CONF_VENDOR_CLASS_ID,
@@ -629,6 +633,14 @@ static void parse_config(GKeyFile *config, const char *file)
 
 	g_clear_error(&error);
 
+	str_list = __connman_config_get_string_list(config, GENERAL_GROUP,
+			CONF_WIFI_TETHERING_INTERFACES, &len, &error);
+
+	if (!error)
+		connman_settings.wifi_tethering_interfaces = str_list;
+
+	g_clear_error(&error);
+
 	boolean = __connman_config_get_bool(config, GENERAL_GROUP,
 					CONF_PERSISTENT_TETHERING_MODE,
 					&error);
@@ -1161,6 +1173,9 @@ char **connman_setting_get_string_list(const char *key)
 	if (g_str_equal(key, CONF_TETHERING_TECHNOLOGIES))
 		return connman_settings.tethering_technologies;
 
+	if (g_str_equal(key, CONF_WIFI_TETHERING_INTERFACES))
+		return connman_settings.wifi_tethering_interfaces;
+
 	return NULL;
 }
 
@@ -1377,6 +1392,7 @@ int main(int argc, char *argv[])
 	g_strfreev(connman_settings.fallback_nameservers);
 	g_strfreev(connman_settings.blacklisted_interfaces);
 	g_strfreev(connman_settings.tethering_technologies);
+	g_strfreev(connman_settings.wifi_tethering_interfaces);
 	g_free(connman_settings.vendor_class_id);

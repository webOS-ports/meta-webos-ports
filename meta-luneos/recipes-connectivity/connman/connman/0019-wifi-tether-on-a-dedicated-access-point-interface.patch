 	char *vendor_class_id;
@@ -156,6 +157,7 @@ static struct {
 	.allow_domainname_updates = true,
 	.single_tech = false,
 	.tethering_technologies = NULL,
+	.wifi_tethering_interfaces = NULL,
 	.persistent_tethering_mode = false,
 	.enable_6to4 = false,
 	.vendor_class_id = NULL,
@@ -196,6 +198,7 @@ static struct {
 #define CONF_ALLOW_DOMAINNAME_UPDATES   "AllowDomainnameUpdates"
 #define CONF_SINGLE_TECH                "SingleConnectedTechnology"
 #define CONF_TETHERING_TECHNOLOGIES      "TetheringTechnologies"
+#define CONF_WIFI_TETHERING_INTERFACES  "WiFiTetheringInterfaces"
 #define CONF_PERSISTENT_TETHERING_MODE  "PersistentTetheringMode"

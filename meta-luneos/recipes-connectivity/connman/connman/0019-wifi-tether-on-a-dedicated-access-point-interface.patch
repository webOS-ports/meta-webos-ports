 	g_free(connman_settings.online_check_ipv4_url);
diff --git a/src/main.conf b/src/main.conf
index 72bba4e..6ff10d5 100644
--- a/src/main.conf
+++ b/src/main.conf
@@ -126,6 +126,12 @@
 # really know what you are doing.
 # TetheringTechnologies = wifi,bluetooth,gadget
 
+# Wi-Fi interfaces that only ever act as a tethering access point, such as
+# MediaTek's ap0. When one exists, the hotspot runs on it and the station
+# interface stays connected. List them in NetworkInterfaceBlacklist too.
+# Not set by default.
+# WiFiTetheringInterfaces = ap0
+
 # Restore earlier tethering status when returning from offline mode,
 # re-enabling a technology, and after restarts and reboots.
 # Default value is false.

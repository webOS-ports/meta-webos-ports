+ *  along with this program; if not, write to the Free Software
+ *  Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
+ *
+ */
+
+/*
+ * Where the DHCP server sends its OFFER and ACK.
+ *
+ * The server runs on the loopback interface, which every build host has
+ * and which has an address. Its three socket helpers are replaced with
+ * the linker's --wrap (see Makefile.am): dhcp_l3_socket() hands out one
+ * end of a socketpair, a byte written to the other end makes the server
+ * read the packet the test queued through dhcp_recv_l3_packet(), and
+ * dhcp_send_raw_packet() records where the reply would have gone.
+ * Everything else, the option parsing included, is the real gdhcp code.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <net/if.h>
+#include <net/ethernet.h>
+#include <arpa/inet.h>
+
+#include <glib.h>
+
+#include "gdhcp/gdhcp.h"
+#include "gdhcp/common.h"
+
+static const uint8_t client_mac[ETH_ALEN] = {
+	0x02, 0x11, 0x22, 0x33, 0x44, 0x55
+};
+
+static int test_fds[2] = { -1, -1 };
+static struct dhcp_packet queued;
+static int queued_len;
+
+static struct {
+	int count;
+	uint8_t type;
+	uint32_t dest_ip;
+	uint8_t dest_arp[ETH_ALEN];
+	uint32_t yiaddr;
+	bool bcast;
+} sent;
+
+int __wrap_dhcp_l3_socket(int port, const char *interface, int family);
+int __wrap_dhcp_recv_l3_packet(struct dhcp_packet *packet, int fd);
+int __wrap_dhcp_send_raw_packet(struct dhcp_packet *dhcp_pkt,
+			uint32_t source_ip, int source_port,
+			uint32_t dest_ip, int dest_port,
+			const uint8_t *dest_arp, int ifindex, bool bcast);
+
+int __wrap_dhcp_l3_socket(int port, const char *interface, int family)
+{
+	g_assert_cmpint(socketpair(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0,
+							test_fds), ==, 0);
+
+	return test_fds[0];
+}
+
+int __wrap_dhcp_recv_l3_packet(struct dhcp_packet *packet, int fd)
+{
+	char byte;
+
+	g_assert_cmpint(read(fd, &byte, 1), ==, 1);
+
+	memcpy(packet, &queued, sizeof(*packet));
+
+	return queued_len;
+}
+
+int __wrap_dhcp_send_raw_packet(struct dhcp_packet *dhcp_pkt,
+			uint32_t source_ip, int source_port,
+			uint32_t dest_ip, int dest_port,
+			const uint8_t *dest_arp, int ifindex, bool bcast)
+{
+	const uint8_t *type;
+
+	type = dhcp_get_option(dhcp_pkt, sizeof(*dhcp_pkt),
+						DHCP_MESSAGE_TYPE);
+	/* not g_assert(), which G_DISABLE_ASSERT would drop */
+	g_assert_nonnull(type);
+
+	sent.count++;
+	sent.type = *type;
+	sent.dest_ip = dest_ip;
+	memcpy(sent.dest_arp, dest_arp, ETH_ALEN);
+	sent.yiaddr = dhcp_pkt->yiaddr;
+	sent.bcast = bcast;
+
+	g_assert_cmpint(source_port, ==, SERVER_PORT);
+	g_assert_cmpint(dest_port, ==, CLIENT_PORT);
+
+	return 0;
+}
+
+static GDHCPServer *server_new(void)
+{
+	GDHCPServerError error = G_DHCP_SERVER_ERROR_NONE;
+	GDHCPServer *server;
+	int index;
+
+	index = if_nametoindex("lo");
+	g_assert_cmpint(index, >, 0);
+
+	server = g_dhcp_server_new(G_DHCP_IPV4, index, &error);
+	g_assert_cmpint(error, ==, G_DHCP_SERVER_ERROR_NONE);
+	g_assert_true(server);
+
+	g_assert_cmpint(g_dhcp_server_set_ip_range(server,
+				"192.168.0.2", "192.168.0.100"), ==, 0);
+	g_assert_cmpint(g_dhcp_server_start(server), ==, 0);
+
+	return server;
+}
+
+static void server_free(GDHCPServer *server)
+{
+	g_dhcp_server_unref(server);
+	close(test_fds[1]);
+	test_fds[0] = test_fds[1] = -1;
+}
+
+/* Hand the server one client packet and let it answer. */
+static void client_send(uint8_t type, uint16_t flags, uint32_t ciaddr,
+						uint32_t requested_nip)
+{
+	int count = sent.count;
+
+	dhcp_init_header(&queued, type);
+	queued.xid = 0x12345678;
+	queued.flags = htons(flags);
+	queued.ciaddr = ciaddr;
+	memcpy(queued.chaddr, client_mac, ETH_ALEN);
+	if (requested_nip)
+		dhcp_add_option_uint32(&queued, DHCP_REQUESTED_IP,
+							requested_nip);
+	queued_len = sizeof(queued);
+
+	g_assert_cmpint(write(test_fds[1], "", 1), ==, 1);
+
+	while (sent.count == count)
+		g_main_context_iteration(NULL, TRUE);
+}
+
+static void assert_broadcast(void)
+{
+	static const uint8_t bcast[ETH_ALEN] = {
+		0xff, 0xff, 0xff, 0xff, 0xff, 0xff
+	};
+
+	g_assert_cmphex(sent.dest_ip, ==, INADDR_BROADCAST);
+	g_assert_true(memcmp(sent.dest_arp, bcast, ETH_ALEN) == 0);
+}
+
+static void assert_unicast(uint32_t nip)
+{
+	g_assert_cmphex(sent.dest_ip, ==, nip);
+	g_assert_true(memcmp(sent.dest_arp, client_mac, ETH_ALEN) == 0);
+}
+
+/* No broadcast bit, no address yet: OFFER and ACK go to yiaddr. */
+static void test_unicast_to_yiaddr(void)
+{
+	GDHCPServer *server = server_new();
+	uint32_t offered;
+
+	client_send(DHCPDISCOVER, 0, 0, 0);
+	g_assert_cmpint(sent.type, ==, DHCPOFFER);
+	g_assert_cmphex(sent.yiaddr, !=, 0);
+	assert_unicast(sent.yiaddr);
+
+	offered = ntohl(sent.yiaddr);
+	client_send(DHCPREQUEST, 0, 0, offered);
+	g_assert_cmpint(sent.type, ==, DHCPACK);
+	g_assert_cmphex(sent.yiaddr, ==, htonl(offered));
+	assert_unicast(sent.yiaddr);
+
+	server_free(server);
+}
+
+/* The broadcast bit is honoured. */
+static void test_broadcast_bit(void)
+{
+	GDHCPServer *server = server_new();
+	uint32_t offered;
+
+	client_send(DHCPDISCOVER, BROADCAST_FLAG, 0, 0);
+	g_assert_cmpint(sent.type, ==, DHCPOFFER);
+	assert_broadcast();
+
+	offered = ntohl(sent.yiaddr);
+	client_send(DHCPREQUEST, BROADCAST_FLAG, 0, offered);
+	g_assert_cmpint(sent.type, ==, DHCPACK);
+	assert_broadcast();
+
+	server_free(server);
+}
+
+/* A renewing client, which has an address, gets the ACK there. */
+static void test_unicast_to_ciaddr(void)
+{
+	GDHCPServer *server = server_new();
+	uint32_t offered;
+
+	client_send(DHCPDISCOVER, 0, 0, 0);
+	offered = ntohl(sent.yiaddr);
+	client_send(DHCPREQUEST, 0, 0, offered);
+	g_assert_cmpint(sent.type, ==, DHCPACK);
+
+	client_send(DHCPREQUEST, 0, htonl(offered), 0);
+	g_assert_cmpint(sent.type, ==, DHCPACK);
+	assert_unicast(htonl(offered));
+
+	server_free(server);
+}
+
+int main(int argc, char *argv[])
+{
+	g_test_init(&argc, &argv, NULL);
+
+	g_test_add_func("/dhcp-server/unicast-to-yiaddr",
+					test_unicast_to_yiaddr);
+	g_test_add_func("/dhcp-server/broadcast-bit", test_broadcast_bit);
+	g_test_add_func("/dhcp-server/unicast-to-ciaddr",
+					test_unicast_to_ciaddr);
+
+	return g_test_run();
+}

# valgrind suppressions for host-check.sh. Each entry says why it is not a
# connman defect.

# GLib's g_free() macro (gmem.h, GLib >= 2.78 with free_sized()) passes
# __builtin_object_size(mem, 0) as the size. In iptables_init() the
# pointer is g_strdup("ip_tables") on one branch and g_strdup("ip6_tables")
# on the other, and type 0 is the larger of the two, so free_sized() is
# told 11 for a 10-byte block. glibc's free_sized() ignores the size, so
# nothing goes wrong; the mismatch is in the GLib header, not in connman.
{
   glib-g_free-macro-object-size-iptables_init
   Memcheck:SizeMismatch
   fun:free_sized
   fun:iptables_init
}

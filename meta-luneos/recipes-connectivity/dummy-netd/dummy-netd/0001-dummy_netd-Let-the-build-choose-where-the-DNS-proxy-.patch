From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] dummy_netd: Let the build choose where the DNS proxy listens

DNS_PROXY_PATH is only defined when the build has not set it, so tests
can serve the proxy from a socket in their own directory. A path too
long for sun_path is refused rather than bound under a shortened name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 dns_proxy.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/dns_proxy.c b/dns_proxy.c
index e6264de..75f86cb 100644
--- a/dns_proxy.c
+++ b/dns_proxy.c
@@ -19,7 +19,10 @@
 #include <sys/un.h>
 #include <unistd.h>
 
+/* A build can serve the proxy elsewhere, e.g. the tests in a work directory */
+#ifndef DNS_PROXY_PATH
 #define DNS_PROXY_PATH "/dev/socket/dnsproxyd"
+#endif
 #define DNS_COMMAND_MAX 1024
 
 /* SocketClient::sendCode is four bytes: three digits and a space. */
@@ -322,6 +325,11 @@ open_listener(void)
     struct sockaddr_un addr;
     int fd;
 
+    if (strlen(DNS_PROXY_PATH) >= sizeof(addr.sun_path)) {
+        GERR("%s: path too long for a socket", DNS_PROXY_PATH);
+        return -1;
+    }
+
     fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
     if (fd < 0) {
         GERR("dns proxy socket: %s", strerror(errno));

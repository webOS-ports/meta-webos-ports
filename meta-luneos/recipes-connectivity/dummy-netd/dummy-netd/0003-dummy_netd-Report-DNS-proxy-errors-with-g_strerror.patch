From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] dummy_netd: Report DNS proxy errors with g_strerror

strerror() may hand back a shared buffer; g_strerror() is safe to call
while the client workers run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 dns_proxy.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dns_proxy.c b/dns_proxy.c
index 08859b0..dc66f32 100644
--- a/dns_proxy.c
+++ b/dns_proxy.c
@@ -346,7 +346,7 @@ open_listener(void)
 
     fd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
     if (fd < 0) {
-        GERR("dns proxy socket: %s", strerror(errno));
+        GERR("dns proxy socket: %s", g_strerror(errno));
         return -1;
     }
 
@@ -357,7 +357,7 @@ open_listener(void)
     if (bind(fd, (struct sockaddr*) &addr, sizeof(addr)) != 0 ||
         chmod(DNS_PROXY_PATH, 0660) != 0 ||
         listen(fd, 8) != 0) {
-        GERR("%s: %s", DNS_PROXY_PATH, strerror(errno));
+        GERR("%s: %s", DNS_PROXY_PATH, g_strerror(errno));
         close(fd);
         unlink(DNS_PROXY_PATH);
         return -1;

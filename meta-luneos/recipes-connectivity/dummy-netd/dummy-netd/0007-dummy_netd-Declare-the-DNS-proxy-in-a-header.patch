From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] dummy_netd: Declare the DNS proxy in a header

dummy_netd.c declared dns_proxy_start() and dns_proxy_stop() itself,
so nothing checked the declarations against the definitions
(-Wmissing-prototypes). Both files now include dns_proxy.h.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 dns_proxy.c  |  2 ++
 dns_proxy.h  | 13 +++++++++++++
 dummy_netd.c |  3 +--
 3 files changed, 16 insertions(+), 2 deletions(-)
 create mode 100644 dns_proxy.h

diff --git a/dns_proxy.c b/dns_proxy.c
index d733775..5589607 100644
--- a/dns_proxy.c
+++ b/dns_proxy.c
@@ -20,6 +20,8 @@
 #include <sys/un.h>
 #include <unistd.h>
 
+#include "dns_proxy.h"
+
 /* A build can serve the proxy elsewhere, e.g. the tests in a work directory */
 #ifndef DNS_PROXY_PATH
 #define DNS_PROXY_PATH "/dev/socket/dnsproxyd"
diff --git a/dns_proxy.h b/dns_proxy.h
new file mode 100644
index 0000000..1adc342
--- /dev/null
+++ b/dns_proxy.h
@@ -0,0 +1,13 @@
+/*
+ * The DNS proxy that answers bionic on /dev/socket/dnsproxyd, dns_proxy.c.
+ */
+
+#ifndef DUMMY_NETD_DNS_PROXY_H
+#define DUMMY_NETD_DNS_PROXY_H
+
+#include <glib.h>
+
+gboolean dns_proxy_start(void);
+void dns_proxy_stop(void);
+
+#endif /* DUMMY_NETD_DNS_PROXY_H */
diff --git a/dummy_netd.c b/dummy_netd.c
index 5b0dcbe..1aa15e2 100644
--- a/dummy_netd.c
+++ b/dummy_netd.c
@@ -50,8 +50,7 @@
 #define RET_CMDLINE 1
 #define RET_ERR     2
 
-gboolean dns_proxy_start(void);
-void dns_proxy_stop(void);
+#include "dns_proxy.h"
 
 static
 gboolean

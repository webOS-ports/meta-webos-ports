From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Thu, 26 Nov 2026 20:38:05 +0100
Subject: [PATCH] [libqofono] Say whether a call is carried over IMS

oFono's VoiceCall has an IMS property (on LuneOS, from the MediaTek
IMS extension): true for a call over VoLTE, VoNR or VoWiFi, false for
a circuit-switched one. QOfonoVoiceCall reads it as ims, and
imsChanged follows a handover between the two.

The test serves a fake org.ofono call on a private bus instead of
phonesim, which has no IMS.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 plugin/plugins.qmltypes                    |   5 +
 src/qofonovoicecall.cpp                    |  12 ++
 src/qofonovoicecall.h                      |   3 +
 test/auto/tests/CMakeLists.txt             |   1 +
 test/auto/tests/tst_qofonovoicecallims.cpp | 146 +++++++++++++++++++++
 5 files changed, 167 insertions(+)
 create mode 100644 test/auto/tests/tst_qofonovoicecallims.cpp

diff --git a/plugin/plugins.qmltypes b/plugin/plugins.qmltypes
index 8e05597..319ee67 100644
--- a/plugin/plugins.qmltypes
+++ b/plugin/plugins.qmltypes
@@ -1476,6 +1476,7 @@ Module {
         Property { name: "information"; type: "string"; isReadonly: true }
         Property { name: "multiparty"; type: "bool"; isReadonly: true }
         Property { name: "emergency"; type: "bool"; isReadonly: true }
+        Property { name: "ims"; type: "bool"; isReadonly: true }
         Property { name: "remoteHeld"; type: "bool"; isReadonly: true }
         Property { name: "icon"; type: "uchar"; isReadonly: true }
         Signal {
@@ -1518,6 +1519,10 @@ Module {
             name: "emergencyChanged"
             Parameter { name: "emergency"; type: "bool" }
         }
+        Signal {
+            name: "imsChanged"
+            Parameter { name: "ims"; type: "bool" }
+        }
         Signal {
             name: "remoteHeldChanged"
             Parameter { name: "remoteHeld"; type: "bool" }
diff --git a/src/qofonovoicecall.cpp b/src/qofonovoicecall.cpp
index 70dc87c..b9511db 100644
--- a/src/qofonovoicecall.cpp
+++ b/src/qofonovoicecall.cpp
@@ -89,6 +89,8 @@ void QOfonoVoiceCall::propertyChanged(const QString &property, const QVariant &v
         Q_EMIT iconChanged(value.value<quint8>());
     } else if (property == QLatin1String("Emergency")) {
         Q_EMIT emergencyChanged(value.toBool());
+    } else if (property == QLatin1String("IMS")) {
+        Q_EMIT imsChanged(value.toBool());
     } else if (property == QLatin1String("RemoteHeld")) {
         Q_EMIT remoteHeldChanged(value.toBool());
     } else if (property == QLatin1String("RemoteMultiparty")) {
@@ -136,6 +138,16 @@ bool QOfonoVoiceCall::emergency() const
     return getBool("Emergency");
 }
 
+/*!
+    True if oFono reports the call as carried over IMS (VoLTE, VoNR or
+    VoWiFi). False for a circuit-switched call, and with an oFono or a
+    modem driver that does not report it.
+*/
+bool QOfonoVoiceCall::ims() const
+{
+    return getBool("IMS");
+}
+
 quint8 QOfonoVoiceCall::icon() const
 {
     return getProperty("Icon").value<quint8>();

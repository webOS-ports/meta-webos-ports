+/*
+ * The IMS property of a call, against a fake org.ofono call on a private
+ * bus instead of phonesim:
+ *
+ *     dbus-run-session -- sh -c \
+ *         'DBUS_SYSTEM_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS ./tst_qofonovoicecallims'
+ */
+
+#include <QtTest/QtTest>
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusMessage>
+#include <QDBusVariant>
+#include <QDBusVirtualObject>
+
+#include "qofonovoicecall.h"
+
+static const char CallPath[] = "/ril_0/voicecall01";
+static const char CallInterface[] = "org.ofono.VoiceCall";
+
+class FakeOfonoCall : public QDBusVirtualObject
+{
+    Q_OBJECT
+
+public:
+    explicit FakeOfonoCall(const QDBusConnection &bus) : m_bus(bus) {}
+
+    QVariantMap properties;
+
+    void change(const QString &name, const QVariant &value)
+    {
+        properties.insert(name, value);
+        QDBusMessage signal = QDBusMessage::createSignal(QLatin1String(CallPath),
+                                                         QLatin1String(CallInterface),
+                                                         QStringLiteral("PropertyChanged"));
+        signal << name << QVariant::fromValue(QDBusVariant(value));
+        m_bus.send(signal);
+    }
+
+    QString introspect(const QString &) const override
+    {
+        return QStringLiteral(
+            "<interface name=\"org.ofono.VoiceCall\">"
+            "<method name=\"GetProperties\"><arg type=\"a{sv}\" direction=\"out\"/></method>"
+            "<signal name=\"PropertyChanged\"><arg type=\"s\"/><arg type=\"v\"/></signal>"
+            "</interface>");
+    }
+
+    bool handleMessage(const QDBusMessage &message, const QDBusConnection &connection) override
+    {
+        if (message.interface() != QLatin1String(CallInterface)
+                || message.member() != QLatin1String("GetProperties"))
+            return false;
+        connection.send(message.createReply(QVariant::fromValue(properties)));
+        return true;
+    }
+
+private:
+    QDBusConnection m_bus;
+};
+
+class TestQOfonoVoiceCallIms : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase()
+    {
+        if (qgetenv("DBUS_SYSTEM_BUS_ADDRESS").isEmpty()
+                || qgetenv("DBUS_SYSTEM_BUS_ADDRESS") != qgetenv("DBUS_SESSION_BUS_ADDRESS"))
+            QSKIP("Needs a private bus as the system bus, see the top of this file");
+        // A connection of its own, so the replies and signals come from the
+        // owner of org.ofono, as they would from oFono.
+        m_bus = QDBusConnection::connectToBus(QDBusConnection::SessionBus,
+                                              QStringLiteral("fake_ofono"));
+        QVERIFY(m_bus.isConnected());
+        QVERIFY(m_bus.registerService(QStringLiteral("org.ofono")));
+        m_call = new FakeOfonoCall(m_bus);
+        m_call->properties.insert(QStringLiteral("State"), QStringLiteral("active"));
+        m_call->properties.insert(QStringLiteral("IMS"), true);
+        QVERIFY(m_bus.registerVirtualObject(QLatin1String(CallPath), m_call));
+    }
+
+    void cleanupTestCase()
+    {
+        if (m_bus.isConnected()) {
+            m_bus.unregisterObject(QLatin1String(CallPath));
+            m_bus.unregisterService(QStringLiteral("org.ofono"));
+        }
+        delete m_call;
+        m_call = 0;
+    }
+
+    void imsFollowsOfono()
+    {
+        QOfonoVoiceCall call;
+        QSignalSpy changed(&call, SIGNAL(imsChanged(bool)));
+        call.setVoiceCallPath(QLatin1String(CallPath));
+        QTRY_VERIFY(call.isValid());
+        QVERIFY(call.ims());
+        QCOMPARE(call.property("ims").toBool(), true);
+        // Bindings learn the first value from the signal too
+        QCOMPARE(changed.count(), 1);
+        QCOMPARE(changed.at(0).at(0).toBool(), true);
+
+        // A handover to the circuit-switched network (SRVCC)
+        m_call->change(QStringLiteral("IMS"), false);
+        QTRY_COMPARE(changed.count(), 2);
+        QCOMPARE(changed.at(1).at(0).toBool(), false);
+        QVERIFY(!call.ims());
+    }
+
+    void imsFalseWhenNotReported()
+    {
+        m_call->properties.remove(QStringLiteral("IMS"));
+        QOfonoVoiceCall call;
+        call.setVoiceCallPath(QLatin1String(CallPath));
+        QTRY_VERIFY(call.isValid());
+        QVERIFY(!call.ims());
+    }
+
+private:
+    QDBusConnection m_bus = QDBusConnection(QString());
+    FakeOfonoCall *m_call = 0;
+};
+
+QTEST_MAIN(TestQOfonoVoiceCallIms)
+#include "tst_qofonovoicecallims.moc"

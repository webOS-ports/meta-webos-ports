+#endif
+
 #ifdef LPAC_WITH_APDU_MBIM
 #    include "driver/apdu/mbim.h"
 #endif
@@ -41,6 +45,9 @@ static const struct euicc_driver *drivers[] = {
 #ifdef LPAC_WITH_APDU_GBINDER

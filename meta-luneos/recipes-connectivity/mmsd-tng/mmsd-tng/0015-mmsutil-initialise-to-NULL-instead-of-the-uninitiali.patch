From 24b15ca2d0060315346039b7682fa6dd2dd4353b Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 13:49:37 +0100
Subject: [PATCH] mmsutil: initialise to NULL instead of the
 uninitialized_var() hack

uninitialized_var(x) expanded to 'x = x', which only hides
-Wmaybe-uninitialized and needed a pragma around every use to silence
-Wuninitialized. Initialise the four pointers to NULL and drop the
macro and the pragmas.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/mmsutil.c | 19 ++++---------------
 1 file changed, 4 insertions(+), 15 deletions(-)

diff --git a/src/mmsutil.c b/src/mmsutil.c
index eaa24dd..9ec40ed 100644
--- a/src/mmsutil.c
+++ b/src/mmsutil.c
@@ -44,8 +44,6 @@
 #define TFR
 #endif
 
-#define uninitialized_var(x) x = x
-
 enum header_flag {
   HEADER_FLAG_MANDATORY =                 1,
   HEADER_FLAG_ALLOW_MULTI =               2,
@@ -342,10 +340,7 @@ extract_encoded_text (struct wsp_header_iter *iter,
   char **out = user;
   const unsigned char *p;
   unsigned int l;
-#pragma GCC diagnostic push
-#pragma GCC diagnostic ignored "-Wuninitialized"
-  char *uninitialized_var (dec_text);
-#pragma GCC diagnostic pop
+  char *dec_text = NULL;
 
   p = wsp_header_iter_get_val (iter);
   l = wsp_header_iter_get_val_len (iter);
@@ -1715,11 +1710,8 @@ encode_content_type (struct file_buffer *fb,
   unsigned int type_len;
   unsigned int start_len;
   const char *ct_str;
-#pragma GCC diagnostic push
-#pragma GCC diagnostic ignored "-Wuninitialized"
-  const char *uninitialized_var (type);
-  const char *uninitialized_var (start);
-#pragma GCC diagnostic pop
+  const char *type = NULL;
+  const char *start = NULL;
   struct wsp_text_header_iter iter;
 
   if (wsp_text_header_iter_init (&iter, *hdr) == FALSE)
@@ -1887,10 +1879,7 @@ mms_encode_send_req_part_header (struct mms_attachment *part,
   unsigned int ct_len;
   unsigned int cs_len;
   const char *ct_str;
-#pragma GCC diagnostic push
-#pragma GCC diagnostic ignored "-Wuninitialized"
-  const char *uninitialized_var (cs_str);
-#pragma GCC diagnostic pop
+  const char *cs_str = NULL;
   unsigned int ctp_len;
   unsigned int cid_len;
   unsigned char ctp_val[MAX_ENC_VALUE_BYTES];
-- 
2.53.0


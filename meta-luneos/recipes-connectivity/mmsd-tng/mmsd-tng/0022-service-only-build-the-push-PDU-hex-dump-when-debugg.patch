From deade9a4fe097f5fe829d4c50021c559bef99fd3 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 14:11:47 +0100
Subject: [PATCH] service: only build the push PDU hex dump when debugging

mms_push_notify() formatted every push PDU as hex, two octets at a
time with g_string_append_printf(), only to pass it to DBG(), which
drops it unless debugging is on. Skip it when the debug message would
be dropped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/service.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/src/service.c b/src/service.c
index 7378974..6900c9b 100644
--- a/src/service.c
+++ b/src/service.c
@@ -4284,16 +4284,19 @@ mms_push_notify (const unsigned char *pdu,
   unsigned int i;
   GString *hex;
 
-  DBG ("pdu %p len %d", pdu, len);
+  DBG ("pdu %p len %u", pdu, len);
 
-  hex = g_string_sized_new (len * 2);
+  if (!g_log_writer_default_would_drop (G_LOG_LEVEL_DEBUG, G_LOG_DOMAIN))
+    {
+      hex = g_string_sized_new ((gsize) len * 2);
 
-  for (i = 0; i < len; i++)
-    g_string_append_printf (hex, "%02X", pdu[i]);
+      for (i = 0; i < len; i++)
+        g_string_append_printf (hex, "%02X", pdu[i]);
 
-  DBG ("%s", hex->str);
+      DBG ("%s", hex->str);
 
-  g_string_free (hex, TRUE);
+      g_string_free (hex, TRUE);
+    }
 
   /* TID and PDU Type */
   if (len < 2)
-- 

From bf44b31d19c7efedf2ce50d76eb3dc539e5ed8b0 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 14:21:26 +0100
Subject: [PATCH] main: add an option to run on the system bus

mmsd-tng owns its name on the session bus. Systems that run it as a
system service, under a user of its own, need it on the system bus.
Add -s/--system for that, and describe in the README what a D-Bus
policy for it has to allow and restrict.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 README     | 11 +++++++++++
 src/main.c |  5 ++++-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/README b/README
index a1be757..9220713 100644
--- a/README
+++ b/README
@@ -67,6 +67,17 @@ can be invoked directly.
   Run with debugging
     # ./_build/mmsdtng -d
 
+Running on the system bus
+=========================
+By default mmsd-tng runs as a session service and owns its name on the
+session bus. With -s (--system) it uses the system bus instead, for a system
+that runs it as a system service with its own user.
+
+On the system bus a D-Bus policy must allow the user mmsd-tng runs as to own
+org.ofono.mms, and must limit which users may call it: SendMessage takes the
+paths of the files to attach, and mmsd-tng reads them with its own rights.
+mmsd-tng keeps its settings and messages under that user's $HOME/.mms.
+
 General Configuration
 ===========================
 On first run, mmsd-tng will write a settings file at
diff --git a/src/main.c b/src/main.c
index 74f1d83..59c08d2 100644
--- a/src/main.c
+++ b/src/main.c
@@ -54,10 +54,13 @@ sig_term (int sig)
 
 static gboolean option_version = FALSE;
 static gboolean global_debug = FALSE;
+static gboolean option_system = FALSE;
 
 static GOptionEntry options[] = {
   { "debug", 'd', 0, G_OPTION_ARG_NONE, &global_debug,
     "Enable debugging output" },
+  { "system", 's', 0, G_OPTION_ARG_NONE, &option_system,
+    "Run on the system bus instead of the session bus" },
   { "version", 'v', 0, G_OPTION_ARG_NONE, &option_version,
     "Show version information and exit" },
   { NULL },
@@ -144,7 +147,7 @@ main (int   argc,
 
   __mms_dbus_set_introspection_data ();
 
-  owner_id = g_bus_own_name (G_BUS_TYPE_SESSION,
+  owner_id = g_bus_own_name (option_system ? G_BUS_TYPE_SYSTEM : G_BUS_TYPE_SESSION,
                              MMS_SERVICE,
                              G_BUS_NAME_OWNER_FLAGS_NONE,
                              on_bus_acquired,

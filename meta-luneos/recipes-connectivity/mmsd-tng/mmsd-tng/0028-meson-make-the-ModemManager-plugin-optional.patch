From a7a904ad48b625ee3b725b8fed3cc7cce8509a53 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 14:22:10 +0100
Subject: [PATCH] meson: make the ModemManager plugin optional

Only the ModemManager plugin needs mm-glib, but it was a dependency of
the whole build, and of the unit tests, which do not use it. Add a
'modemmanager' feature option, enabled by default, and build the plugin,
and link mm-glib, only when it is on, so that another modem plugin can
be built without ModemManager. Refuse to configure without any modem
plugin.

The unit tests got GIO through mm-glib; test-service-providers reads
the provider database with it, so they now name gio-2.0 themselves.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 meson.build         | 17 ++++++++++++++++-
 meson_options.txt   |  2 ++
 plugins/meson.build |  4 ----
 src/meson.build     |  4 ----
 unit/meson.build    |  2 +-
 5 files changed, 19 insertions(+), 10 deletions(-)

diff --git a/meson.build b/meson.build
index 97a0475..0e2d95d 100644
--- a/meson.build
+++ b/meson.build
@@ -115,7 +115,6 @@ includes = [
 
 dependencies = [
   dependency('glib-2.0', version : '>=2.16'),
-  dependency('mm-glib', version : '>=1.14'),
   dependency('libsoup-3.0'),
   dependency('libcares', version : '>=1.18.1'),
   cc.find_library('dl'),
@@ -125,6 +124,22 @@ dependencies = [
   dependency('protobuf', required: false),
 ]
 
+# The modem plugins, built in
+builtin_plugins = []
+plugins_sources = []
+
+mm_glib = dependency('mm-glib', version : '>=1.14',
+                     required : get_option('modemmanager'))
+if mm_glib.found()
+  dependencies += mm_glib
+  builtin_plugins += 'modemmanager'
+  plugins_sources += 'modemmanager.c'
+endif
+
+if builtin_plugins.length() == 0
+  error('No modem plugin is enabled')
+endif
+
 subdir('src')
 subdir('plugins')
 
diff --git a/meson_options.txt b/meson_options.txt
index 123fb21..14e5338 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1 +1,3 @@
 option('build-mmsctl', type : 'boolean', value : false)
+option('modemmanager', type : 'feature', value : 'enabled',
+       description : 'Build the ModemManager plugin')
diff --git a/plugins/meson.build b/plugins/meson.build
index 317a1e0..c092b2d 100644
--- a/plugins/meson.build
+++ b/plugins/meson.build
@@ -1,7 +1,3 @@
-plugins_sources = [
-  'modemmanager.c',
-]
-
 plugins_lib = static_library('plugins',
   plugins_sources,
   include_directories : includes,
diff --git a/src/meson.build b/src/meson.build
index ca399f8..dea24d1 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -10,10 +10,6 @@ mms_sources = [
   'phone-utils.cpp'
 ]
 
-builtin_plugins = [
-  'modemmanager'
-]
-
 genbuiltin = find_program('genbuiltin')
 if genbuiltin.found()
   builtin = custom_target('generate builtin.h',
diff --git a/unit/meson.build b/unit/meson.build
index b6eadc3..0e8f747 100644
--- a/unit/meson.build
+++ b/unit/meson.build
@@ -1,6 +1,6 @@
 test_dependencies = [
   dependency('glib-2.0', version : '>=2.16'),
-  dependency('mm-glib', version : '>=1.14'),
+  dependency('gio-2.0'),
   dependency('libcares', version : '>1.17'),
   cc.find_library('dl'),
   cc.find_library('phonenumber', required: true),
-- 

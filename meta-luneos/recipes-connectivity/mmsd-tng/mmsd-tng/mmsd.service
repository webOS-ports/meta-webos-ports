[Unit]
Description=MMS management service
Requires=dbus.service
After=dbus.service

[Service]
Type=dbus
BusName=org.ofono.mms
# mmsd parses WAP push and MMS PDUs that arrive unsolicited from the cellular
# network, so it runs as its own user in a sandbox rather than as root.
# Its store is ~/.mms, so HOME (from the mmsd user) is /var/lib/mmsd.
User=mmsd
Group=mmsd
StateDirectory=mmsd
StateDirectoryMode=0700
# mmsd-tng keeps the messages it is sending or fetching in
# $XDG_CACHE_HOME/mmstng. LuneOS sets XDG_CACHE_HOME=/var/cache/xdg for
# every service, which ProtectSystem= makes read-only, so it gets its own.
CacheDirectory=mmsd
CacheDirectoryMode=0700
Environment=XDG_CACHE_HOME=/var/cache/mmsd
# The store used to be /root/.mms (or /home/root/.mms) while mmsd ran as root,
# with one directory per SIM named after its IMSI; mmsd-tng's oFono plugin
# keeps its messages in .mms/ofono. Move the store before the daemon starts;
# "+" runs this one step as root without the sandbox below. It never fails
# the start and is a no-op once the old store is gone.
ExecStartPre=+/usr/libexec/mmsd-migrate-store
# -s: own org.ofono.mms on the system bus, where oFono is.
ExecStart=/usr/bin/mmsdtng -s
Restart=always
RestartSec=3

# The MMSC is fetched over the MMS context's interface: mmsd-tng binds each
# HTTP socket with SO_BINDTODEVICE, which needs CAP_NET_RAW before Linux 5.7.
# Without it the bind fails and the transfer goes out on the default route,
# which is not the MMS bearer when MMS has its own APN. Nothing else is needed.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RemoveIPC=yes
# D-Bus, HTTP and DNS (c-ares) to the MMSC, and netlink for the interfaces.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target

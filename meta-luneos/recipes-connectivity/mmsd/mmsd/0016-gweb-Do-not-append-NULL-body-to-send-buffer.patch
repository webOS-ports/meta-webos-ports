From a5b53be91835a25fd01a7c2bc09013670fded773 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 30 Oct 2026 08:25:39 +0100
Subject: [PATCH] gweb: Do not append NULL body to send buffer

start_request() declared body and length without initialising them. A
POST without an input function (g_web_request_post() with input ==
NULL) and without a file (fd == -1) took length from the session but
never set body, and then appended length bytes from that uninitialised
pointer to the request. mmsd itself always posts from a file, so the
path is latent here, but any other caller of the gweb copy would leak
stack-derived memory to the server or crash.

Backported from ConnMan commit 5362f09a8ee0 ("gweb: Do not append NULL
body to send buffer") by Jussi Laakkonen <jussi.laakkonen@jolla.com>.
Upstream message:

  Fix Clang analyzer warning about writing uninitialized content to the
  buffer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Backport [https://git.kernel.org/pub/scm/network/connman/connman.git/commit/?id=5362f09a8ee0dcfaab1a6d2074c5f20f45ef28fd]
---
 gweb/gweb.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/gweb/gweb.c b/gweb/gweb.c
index 5597089..4293b57 100644
--- a/gweb/gweb.c
+++ b/gweb/gweb.c
@@ -552,8 +552,8 @@ static void start_request(struct web_session *session)
 {
 	GString *buf = session->send_buffer;
 	const char *version;
-	const guint8 *body;
-	gsize length;
+	const guint8 *body = NULL;
+	gsize length = 0;
 
 	debug(session->web, "request %s from %s",
 					session->request, session->host);
@@ -613,7 +613,7 @@ static void start_request(struct web_session *session)
 			g_string_append_printf(buf, "%zx\r\n", length);
 			g_string_append_len(buf, (char *) body, length);
 			g_string_append(buf, "\r\n");
-		} else if (session->fd == -1)
+		} else if (session->fd == -1 && body)
 			g_string_append_len(buf, (char *) body, length);
 	}
 }

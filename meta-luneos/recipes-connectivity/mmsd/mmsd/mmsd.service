[Unit]
Description=MMS management service
Requires=dbus.service
After=dbus.service

[Service]
Type=dbus
BusName=org.ofono.mms
# mmsd parses WAP push and MMS PDUs that arrive unsolicited from the cellular
# network, so it runs as its own user in a sandbox rather than as root.
# Its store is ~/.mms, so HOME (from the mmsd user) is /var/lib/mmsd.
User=mmsd
Group=mmsd
StateDirectory=mmsd
StateDirectoryMode=0700
# The store used to be /root/.mms (or /home/root/.mms) while mmsd ran as root.
# Move it here before the daemon starts; "+" runs this one step as root
# without the sandbox below. It never fails the start and is a no-op once
# the old store is gone.
ExecStartPre=+/usr/libexec/mmsd-migrate-store
ExecStart=/usr/libexec/mmsd -n
StandardError=null
Restart=always
RestartSec=3

# The MMSC is fetched over the MMS context's interface: gweb binds the socket
# with SO_BINDTODEVICE, which needs CAP_NET_RAW before Linux 5.7, and falls
# back to binding the interface address without it. Nothing else is needed.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RemoveIPC=yes
# D-Bus, HTTP to the MMSC, and getifaddrs() (netlink) to find the interface.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target

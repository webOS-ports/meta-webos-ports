+}
+
+static
+void
+test_run_idle(
+    void)
+{
+    while (g_main_context_iteration(NULL, FALSE));
+}
+
+static
+int
+test_pending_count(
+    TEST_REQ_KIND kind)
+{
+    guint i;
+    int n = 0;
+
+    for (i = 0; i < test.pending->len; i++) {
+        const RadioRequest* req = test.pending->pdata[i];
+
+        if (req->kind == kind) {
+            n++;
+        }
+    }
+    return n;
+}
+
+/* Completes all pending requests of this kind */
+static
+void
+test_complete(
+    TEST_REQ_KIND kind,
+    RADIO_TX_STATUS status)
+{
+    GPtrArray* reqs = g_ptr_array_new();
+    guint i;
+
+    /* Completion may submit new requests, take these out first */
+    for (i = 0; i < test.pending->len;) {
+        RadioRequest* req = test.pending->pdata[i];
+
+        if (req->kind == kind) {
+            g_ptr_array_add(reqs, req);
+            g_ptr_array_remove_index(test.pending, i);
+        } else {
+            i++;
+        }
+    }
+
+    for (i = 0; i < reqs->len; i++) {
+        RadioRequest* req = reqs->pdata[i];
+
+        if (req->complete) {
+            req->complete(req, status, 0, RADIO_ERROR_NONE, NULL,
+                req->user_data);
+        }
+        radio_request_unref(req);
+    }
+    g_ptr_array_free(reqs, TRUE);
+}
+
+static
+void
+test_slot_init(
+    TestSlot* slot,
+    BinderRadioCapsManager* mgr,
+    guint index,
+    RADIO_ACCESS_FAMILY raf)
+{
+    char* path = g_strdup_printf("/ril_%u", index);
+    char* uuid = g_strdup_printf("%u", index);
+
+    memset(slot, 0, sizeof(*slot));
+    slot->radio.state = RADIO_STATE_ON;
+    slot->radio.online = TRUE;
+    slot->status.card_state = RADIO_CARD_STATE_PRESENT;
+    slot->sim.status = &slot->status;
+    slot->settings.imsi = "001010123456789";
+    slot->settings.techs = slot->settings.pref = OFONO_RADIO_ACCESS_MODE_ALL;
+    slot->config.slot = index;
+    slot->cap.raf = raf;
+    slot->cap.logicalModemUuid.data.str = uuid;
+    slot->cap.logicalModemUuid.len = strlen(uuid);
+    slot->watch = ofono_watch_new(path);
+    /* Any non-NULL modem makes the slot enabled */
+    slot->watch->modem = (struct ofono_modem*) slot;
+    slot->caps = binder_radio_caps_new(mgr, NULL, &slot->client,
+        slot->watch, &slot->data, &slot->radio, &slot->sim,
+        &slot->settings, &slot->config, &slot->cap);
+    test.allocs = g_slist_prepend(test.allocs, uuid);
+    g_free(path);
+}
+
+static
+void
+test_slot_deinit(
+    TestSlot* slot)
+{
+    slot->watch->modem = NULL;
+    binder_radio_caps_drop(slot->caps);
+    ofono_watch_unref(slot->watch);
+}
+
+typedef struct test_setup {
+    BinderDataManager dm;
+    BinderRadioCapsManager* mgr;
+    TestSlot slot[2];
+    BinderRadioCapsRequest* req;
+    gulong id[2];
+} TestSetup;
+
+/*
+ * Slot 0 has GSM only, slot 1 has LTE. Asking for LTE on slot 0 makes
+ * the manager start a transaction which swaps the two.
+ */
+static
+void
+test_setup_init(
+    TestSetup* setup,
+    gboolean data_call)
+{
+    memset(&test, 0, sizeof(test));
+    test.pending = g_ptr_array_new();
+    memset(setup, 0, sizeof(*setup));
+    setup->mgr = binder_radio_caps_manager_new(&setup->dm);
+    setup->id[0] = binder_radio_caps_manager_add_tx_aborted_handler
+        (setup->mgr, test_aborted_cb, NULL);
+    setup->id[1] = binder_radio_caps_manager_add_tx_done_handler
+        (setup->mgr, test_done_cb, NULL);
+    test_slot_init(setup->slot + 0, setup->mgr, 0, RAF_GSM);
+    test_slot_init(setup->slot + 1, setup->mgr, 1, RAF_LTE | RAF_GSM);
+    if (data_call) {
+        TestSlot* slot = setup->slot + 0;
+
+        slot->call.cid = 1;
+        slot->call.status = RADIO_DATA_CALL_FAIL_NONE;
+        slot->data.calls = g_slist_append(NULL, &slot->call);
+    }
+    test_run_idle();
+}
+
+static
+void
+test_setup_start(
+    TestSetup* setup)
+{
+    setup->req = binder_radio_caps_request_new(setup->slot[0].caps,
+        OFONO_RADIO_ACCESS_MODE_LTE, OFONO_SLOT_DATA_INTERNET);
+    test_run_idle();
+}
+
+static
+void
+test_setup_deinit(
+    TestSetup* setup)
+{
+    guint i;
+
+    binder_radio_caps_request_free(setup->req);
+    for (i = 0; i < test.pending->len; i++) {
+        radio_request_unref(test.pending->pdata[i]);
+    }
+    g_ptr_array_free(test.pending, TRUE);
+    test_slot_deinit(setup->slot + 0);
+    test_slot_deinit(setup->slot + 1);
+    g_slist_free(setup->slot[0].data.calls);
+    binder_radio_caps_manager_remove_all_handlers(setup->mgr, setup->id);
+    binder_radio_caps_manager_unref(setup->mgr);
+    g_slist_free_full(test.allocs, g_free);
+    test.allocs = NULL;
+}
+
+static
+void
+test_assert_unblocked(
+    TestSetup* setup)
+{
+    BinderRadioCapsManager* mgr = setup->mgr;
+    guint i;
+
+    g_assert(!binder_radio_caps_manager_tx_pending(mgr));
+    for (i = 0; i < G_N_ELEMENTS(setup->slot); i++) {
+        BinderRadioCapsObject* caps =
+            binder_radio_caps_cast(setup->slot[i].caps);
+
+        g_assert_cmpint(radio_request_group_block_status(caps->g), ==,
+            RADIO_BLOCK_NONE);
+    }
+}
+
+/*==========================================================================*
+ * start
+ *
+ * Nothing fails: setDataAllowed(false) goes to both modems, then
+ * the START, APPLY and FINISH phases of setRadioCapability.
+ *==========================================================================*/
+
+static
+void
+test_start(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_init(&setup, FALSE);
+    test_setup_start(&setup);
+    g_assert_cmpint(test_pending_count(TEST_REQ_DATA_ALLOWED), ==, 2);
+    g_assert_cmpint(test_pending_count(TEST_REQ_SET_CAPS), ==, 0);
+
+    test_complete(TEST_REQ_DATA_ALLOWED, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test_pending_count(TEST_REQ_SET_CAPS), ==, 2);
+    g_assert(binder_radio_caps_manager_tx_pending(setup.mgr));
+
+    /* START, APPLY and FINISH */
+    test_complete(TEST_REQ_SET_CAPS, RADIO_TX_STATUS_OK);
+    test_complete(TEST_REQ_SET_CAPS, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test.done, ==, 0);
+    test_complete(TEST_REQ_SET_CAPS, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test.pending->len, ==, 0);
+    g_assert_cmpint(test.submitted[TEST_REQ_SET_CAPS], ==, 6);
+    g_assert_cmpint(test.done, ==, 1);
+    g_assert_cmpint(test.aborted, ==, 0);
+    g_assert_cmpint(test.data_on, ==, 1);
+    test_assert_unblocked(&setup);
+    test_setup_deinit(&setup);
+}
+
+/*==========================================================================*
+ * data_off_failed
+ *
+ * setDataAllowed(false) can't be submitted to one of the modems
+ * (or to either of them).
+ *==========================================================================*/
+
+static
+void
+test_data_off_failed(
+    gconstpointer data)
+{
+    const int fail = GPOINTER_TO_INT(data);
+    TestSetup setup;
+
+    test_setup_init(&setup, FALSE);
+    test.fail[TEST_REQ_DATA_ALLOWED] = fail;
+    test_setup_start(&setup);
+    g_assert_cmpint(test_pending_count(TEST_REQ_DATA_ALLOWED), ==, 2 - fail);
+
+    test_complete(TEST_REQ_DATA_ALLOWED, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test_pending_count(TEST_REQ_SET_CAPS), ==, 0);
+    g_assert_cmpint(test.aborted, ==, 1);
+    g_assert_cmpint(test.data_on, ==, 1);
+    test_assert_unblocked(&setup);
+    test_setup_deinit(&setup);
+}
+
+/*==========================================================================*
+ * deactivate_failed
+ *
+ * deactivateDataCall for the active data call can't be submitted.
+ *==========================================================================*/
+
+static
+void
+test_deactivate_failed(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_init(&setup, TRUE);
+    test.fail[TEST_REQ_DEACTIVATE] = 1;
+    test_setup_start(&setup);
+    g_assert_cmpint(test.pending->len, ==, 0);
+    g_assert_cmpint(test.submitted[TEST_REQ_DATA_ALLOWED], ==, 0);
+    test_assert_unblocked(&setup);
+    test_setup_deinit(&setup);
+}
+
+/*==========================================================================*
+ * phase_failed
+ *
+ * The START phase of setRadioCapability can't be submitted to either
+ * modem. The transaction must be aborted with FINISH/FAIL.
+ *==========================================================================*/
+
+static
+void
+test_phase_failed(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_init(&setup, FALSE);
+    test_setup_start(&setup);
+    test.fail[TEST_REQ_SET_CAPS] = 2;
+    test_complete(TEST_REQ_DATA_ALLOWED, RADIO_TX_STATUS_OK);
+
+    /* The abort (FINISH with status FAIL) went to both */
+    g_assert_cmpint(test.aborted, ==, 1);
+    g_assert_cmpint(test_pending_count(TEST_REQ_SET_CAPS), ==, 2);
+    g_assert_cmpint(test.data_on, ==, 0);
+
+    test_complete(TEST_REQ_SET_CAPS, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test.data_on, ==, 1);
+    g_assert_cmpint(test.done, ==, 0);
+    test_assert_unblocked(&setup);
+    test_setup_deinit(&setup);
+}
+
+/*==========================================================================*
+ * phase_partly_failed
+ *
+ * The START phase can be submitted to one modem only. That one is
+ * waited for, then the transaction is aborted.
+ *==========================================================================*/
+
+static
+void
+test_phase_partly_failed(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_init(&setup, FALSE);
+    test_setup_start(&setup);
+    test.fail[TEST_REQ_SET_CAPS] = 1;
+    test_complete(TEST_REQ_DATA_ALLOWED, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test_pending_count(TEST_REQ_SET_CAPS), ==, 1);
+    g_assert_cmpint(test.aborted, ==, 0);
+
+    /* The other modem's success doesn't save this transaction */
+    test_complete(TEST_REQ_SET_CAPS, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test.aborted, ==, 1);
+    g_assert_cmpint(test_pending_count(TEST_REQ_SET_CAPS), ==, 2);
+
+    test_complete(TEST_REQ_SET_CAPS, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test.data_on, ==, 1);
+    test_assert_unblocked(&setup);
+    test_setup_deinit(&setup);
+}
+
+/*==========================================================================*
+ * abort_failed
+ *
+ * Neither START nor the FINISH/FAIL of the abort can be submitted.
+ *==========================================================================*/
+
+static
+void
+test_abort_failed(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_init(&setup, FALSE);
+    test_setup_start(&setup);
+    test.fail[TEST_REQ_SET_CAPS] = 4;
+    test_complete(TEST_REQ_DATA_ALLOWED, RADIO_TX_STATUS_OK);
+    g_assert_cmpint(test.pending->len, ==, 0);
+    g_assert_cmpint(test.aborted, ==, 1);
+    g_assert_cmpint(test.data_on, ==, 1);
+    test_assert_unblocked(&setup);
+    test_setup_deinit(&setup);
+}
+
+int main(int argc, char* argv[])
+{
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+    gutil_log_timestamp = FALSE;
+
+    g_test_add_func(TEST_("start"), test_start);
+    g_test_add_data_func(TEST_("data_off_failed/one"),
+        GINT_TO_POINTER(1), test_data_off_failed);
+    g_test_add_data_func(TEST_("data_off_failed/all"),
+        GINT_TO_POINTER(2), test_data_off_failed);
+    g_test_add_func(TEST_("deactivate_failed"), test_deactivate_failed);
+    g_test_add_func(TEST_("phase_failed"), test_phase_failed);
+    g_test_add_func(TEST_("phase_partly_failed"), test_phase_partly_failed);
+    g_test_add_func(TEST_("abort_failed"), test_abort_failed);
+    return g_test_run();
+}

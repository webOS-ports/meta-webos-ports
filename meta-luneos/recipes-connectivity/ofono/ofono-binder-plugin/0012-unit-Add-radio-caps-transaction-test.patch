+/*
+ * Runs the radio capability switch transaction of binder_radio_caps.c
+ * against a fake radio, with requests that can be made to fail to submit.
+ * libgbinder-radio never completes a request that it failed to submit,
+ * so every such failure must be accounted for by the caller, or the
+ * transaction never ends and the request groups stay blocked.
+ */
+
+#include "test_watch.h"
+
+#include "binder_radio_caps.c"
+
+#include <gutil_log.h>
+
+GLOG_MODULE_DEFINE("unit_radio_caps");
+
+#define TEST_PREFIX "/radio_caps/"
+#define TEST_(t) TEST_PREFIX t
+
+typedef enum test_req_kind {
+    TEST_REQ_OTHER,
+    TEST_REQ_SET_CAPS,
+    TEST_REQ_DATA_ALLOWED,
+    TEST_REQ_DEACTIVATE,
+    TEST_REQ_KIND_COUNT
+} TEST_REQ_KIND;
+
+struct radio_request {
+    int refcount;
+    TEST_REQ_KIND kind;
+    RadioRequestCompleteFunc complete;
+    GDestroyNotify destroy;
+    gpointer user_data;
+};
+
+typedef struct test_request_group {
+    RadioRequestGroup pub;
+    RADIO_BLOCK block;
+} TestRequestGroup;
+
+#define TEST_GROUP(g) G_CAST(g, TestRequestGroup, pub)
+
+struct radio_client {
+    int dummy;
+};
+
+struct binder_data_manager {
+    int dummy;
+};
+
+static struct test_state {
+    int fail[TEST_REQ_KIND_COUNT]; /* Number of submits to fail */
+    int submitted[TEST_REQ_KIND_COUNT];
+    GPtrArray* pending; /* Submitted, not yet completed */
+    GSList* allocs;
+    int aborted;
+    int done;
+    int data_on;
+} test;
+
+typedef struct test_slot {
+    RadioClient client;
+    BinderRadio radio;
+    BinderSimCard sim;
+    BinderSimCardStatus status;
+    BinderSimSettings settings;
+    BinderData data;
+    BinderDataCall call;
+    BinderSlotConfig config;
+    RadioCapability cap;
+    OfonoWatch* watch;
+    BinderRadioCaps* caps;
+} TestSlot;

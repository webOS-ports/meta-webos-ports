+static
+void
+test_aborted_cb(
+    BinderRadioCapsManager* mgr,
+    void* user_data)
+{
+    test.aborted++;
+}
+
+static
+void
+test_done_cb(
+    BinderRadioCapsManager* mgr,
+    void* user_data)
+{

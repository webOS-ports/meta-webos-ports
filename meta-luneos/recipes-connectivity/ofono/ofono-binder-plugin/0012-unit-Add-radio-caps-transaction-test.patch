+static
+RadioRequest*
+test_request_new(
+    TEST_REQ_KIND kind,
+    RadioRequestCompleteFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    RadioRequest* req = g_new0(RadioRequest, 1);
+
+    req->refcount = 1;
+    req->kind = kind;
+    req->complete = complete;
+    req->destroy = destroy;
+    req->user_data = user_data;
+    return req;
+}
+
+RadioRequest*
+radio_request_new2(
+    RadioRequestGroup* group,
+    RADIO_REQ code,
+    GBinderWriter* args,
+    RadioRequestCompleteFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    if (args) {
+        memset(args, 0, sizeof(*args));
+    }
+    return test_request_new((code == RADIO_REQ_SET_RADIO_CAPABILITY ||
+        code == (RADIO_REQ) RADIO_MODEM_REQ_SET_RADIO_CAPABILITY) ?
+        TEST_REQ_SET_CAPS : TEST_REQ_OTHER, complete, destroy, user_data);
+}
+
+RadioRequest*
+radio_request_new(
+    RadioClient* client,
+    RADIO_REQ code,
+    GBinderWriter* args,
+    RadioRequestCompleteFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    return radio_request_new2(NULL, code, args, complete, destroy, user_data);
+}
+
+RadioRequest*
+radio_request_ref(
+    RadioRequest* req)
+{
+    if (req) {
+        req->refcount++;
+    }
+    return req;
+}
+
+void
+radio_request_unref(
+    RadioRequest* req)
+{
+    if (req && !--req->refcount) {
+        /* Like the real thing, destroy is called whether or not submitted */
+        if (req->destroy) {
+            req->destroy(req->user_data);
+        }
+        g_free(req);
+    }
+}
+
+gboolean
+radio_request_submit(
+    RadioRequest* req)
+{
+    if (!req) {
+        return FALSE;
+    } else if (test.fail[req->kind] > 0) {
+        /* Not queued and never completed, like libgbinder-radio does */
+        test.fail[req->kind]--;
+        return FALSE;
+    } else {
+        test.submitted[req->kind]++;
+        g_ptr_array_add(test.pending, radio_request_ref(req));
+        return TRUE;
+    }
+}
+
+RadioRequest*
+radio_request_try_submit(
+    RadioRequest* req)
+{
+    if (radio_request_submit(req)) {
+        return req;
+    } else {
+        radio_request_unref(req);
+        return NULL;
+    }
+}

+    RadioRequestGroup* group,
     int cid,
     RadioRequestCompleteFunc complete,
     GDestroyNotify destroy,
     void* user_data)
 {
-    return test_request_new(TEST_REQ_DEACTIVATE, complete, destroy,
-        user_data);

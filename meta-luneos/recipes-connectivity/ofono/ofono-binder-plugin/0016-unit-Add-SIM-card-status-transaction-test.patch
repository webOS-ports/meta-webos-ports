+++ b/unit/Makefile
@@ -12,6 +12,7 @@ all:
 	@$(MAKE) -C unit_ext_slot $*
 	@$(MAKE) -C unit_oplist $*
 	@$(MAKE) -C unit_radio_caps $*
+	@$(MAKE) -C unit_sim_card $*
 	@$(MAKE) -C unit_sim_settings $*
 	@$(MAKE) -C unit_util $*
 	@$(MAKE) -C unit_voicecall $*
diff --git a/unit/unit_sim_card/Makefile b/unit/unit_sim_card/Makefile
new file mode 100644

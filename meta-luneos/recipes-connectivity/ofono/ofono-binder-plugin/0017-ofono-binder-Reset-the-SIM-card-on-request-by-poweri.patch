index 2698b2a..78e7478 100644
--- a/src/binder_sim_card.h
+++ b/src/binder_sim_card.h
@@ -55,6 +55,13 @@ void
     BinderSimCard* card,
     void* user_data);
 
+typedef
+void
+(*BinderSimCardPowerCycleFunc)(
+    BinderSimCard* card,
+    gboolean ok,
+    void* user_data);
+
 BinderSimCard*
 binder_sim_card_new(
     RadioClient* client,
@@ -81,6 +88,18 @@ binder_sim_card_request_status(
     BinderSimCard* card)
     BINDER_INTERNAL;
 
+gboolean
+binder_sim_card_power_cycle(
+    BinderSimCard* card,
+    BinderSimCardPowerCycleFunc fn,
+    void* user_data)
+    BINDER_INTERNAL;
+
+void
+binder_sim_card_power_cycle_cancel(
+    BinderSimCard* card)
+    BINDER_INTERNAL;
+
 void
 binder_sim_card_sim_io_started(
     BinderSimCard* card,

+
+#include "binder_ims.c"
+
+#include "binder_ext_ims_impl.h"
+
+#include <gutil_log.h>
+
+GLOG_MODULE_DEFINE("unit_ims");
+
+#define TEST_CALL_ID 42
+
+/*==========================================================================*
+ * Stubs
+ *==========================================================================*/
+
+static void* test_ims_data;
+static void* test_modem_data;
+static int test_ofono_registered;
+static gpointer test_ext_iface;
+
+void ofono_debug(const char* format, ...)
+    { }
+void ofono_error(const char* format, ...)
+    { }
+void ofono_warn(const char* format, ...)
+    { }
+
+void* ofono_modem_get_data(struct ofono_modem* modem)
+    { return test_modem_data; }
+void* ofono_ims_get_data(const struct ofono_ims* ims)
+    { return test_ims_data; }
+void ofono_ims_set_data(struct ofono_ims* ims, void* data)
+    { test_ims_data = data; }
+void ofono_ims_register(struct ofono_ims* ims)
+    { test_ofono_registered++; }
+void ofono_ims_status_notify(struct ofono_ims* ims, int reg_info, int ext_info)
+    { }
+int ofono_ims_driver_register(const struct ofono_ims_driver* driver)
+    { return 0; }
+void ofono_ims_driver_unregister(const struct ofono_ims_driver* driver)
+    { }
+
+BinderImsReg* binder_ims_reg_ref(BinderImsReg* ims)
+    { return ims; }
+void binder_ims_reg_unref(BinderImsReg* ims)
+    { }
+gulong binder_ims_reg_add_property_handler(BinderImsReg* ims,
+    BINDER_IMS_REG_PROPERTY property, BinderImsRegPropertyFunc callback,
+    void* user_data)
+    { return 1; }
+void binder_ims_reg_remove_handler(BinderImsReg* ims, gulong id)
+    { }
+
+gpointer binder_ext_slot_get_interface(BinderExtSlot* slot, GType type)
+    { return test_ext_iface; }
+
+/*==========================================================================*
+ * Test BinderExtImsInterface implementation
+ *==========================================================================*/
+
+typedef GObjectClass TestExtImsClass;
+typedef struct test_ext_ims {
+    GObject parent;
+    int requests;
+    BINDER_EXT_IMS_REGISTRATION last;
+    BinderExtImsResultFunc complete;
+    GDestroyNotify destroy;
+    void* user_data;
+    guint cancelled;
+} TestExtIms;
+
+static void test_ext_ims_iface_init(BinderExtImsInterface* iface);
+G_DEFINE_TYPE_WITH_CODE(TestExtIms, test_ext_ims, G_TYPE_OBJECT,
+G_IMPLEMENT_INTERFACE(BINDER_EXT_TYPE_IMS, test_ext_ims_iface_init))
+
+#define TEST_TYPE_EXT_IMS test_ext_ims_get_type()
+#define TEST_EXT_IMS(obj) G_TYPE_CHECK_INSTANCE_CAST(obj, TEST_TYPE_EXT_IMS, \
+    TestExtIms)
+
+static
+guint
+test_ext_ims_set_registration(
+    BinderExtIms* ext,
+    BINDER_EXT_IMS_REGISTRATION registration,
+    BinderExtImsResultFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    TestExtIms* self = TEST_EXT_IMS(ext);
+
+    self->requests++;
+    self->last = registration;
+    self->complete = complete;
+    self->destroy = destroy;
+    self->user_data = user_data;
+    return TEST_CALL_ID;
+}
+
+static
+void
+test_ext_ims_cancel(
+    BinderExtIms* ext,
+    guint id)
+{
+    TestExtIms* self = TEST_EXT_IMS(ext);
+
+    if (id) {
+        GDestroyNotify destroy = self->destroy;
+
+        self->cancelled = id;
+        self->destroy = NULL;
+        if (destroy) {
+            destroy(self->user_data);
+        }
+    }
+}
+
+static
+void
+test_ext_ims_iface_init(
+    BinderExtImsInterface* iface)
+{
+    iface->version = BINDER_EXT_IMS_INTERFACE_VERSION;
+    iface->set_registration = test_ext_ims_set_registration;
+    iface->cancel = test_ext_ims_cancel;
+}
+
+static
+void
+test_ext_ims_init(
+    TestExtIms* self)
+{
+}
+
+static
+void
+test_ext_ims_class_init(
+    TestExtImsClass* klass)
+{
+}
+
+/*==========================================================================*
+ * Common
+ *==========================================================================*/
+
+static struct ofono_ims* const test_handle = (struct ofono_ims*)&test_handle;
+static BinderImsReg test_reg;
+static BinderModem test_modem;
+
+static
+void
+test_probe(
+    TestExtIms* ext)
+{
+    test_ofono_registered = 0;
+    test_ext_iface = ext;
+    memset(&test_modem, 0, sizeof(test_modem));
+    test_modem.log_prefix = "";
+    test_modem.ims = &test_reg;
+    test_modem_data = &test_modem;
+    g_assert_cmpint(binder_ims_driver.probe(test_handle, 0, NULL), == ,0);
+}
+
+static
+void
+test_run_idle(
+    void)
+{
+    while (g_main_context_iteration(NULL, FALSE));
+}
+
+static
+void
+test_ims_noop_cb(
+    const struct ofono_error* error,
+    void* data)
+{
+}
+
+/*==========================================================================*
+ * Tests
+ *==========================================================================*/
+
+static
+void
+test_requests_registration_on_start(
+    void)
+{
+    TestExtIms* ext = g_object_new(TEST_TYPE_EXT_IMS, NULL);
+    BinderIms* self;
+
+    test_probe(ext);
+    self = test_ims_data;
+
+    /* Not before the atom has been registered */
+    g_assert_cmpint(ext->requests, == ,0);
+    test_run_idle();
+    g_assert_cmpint(test_ofono_registered, == ,1);
+    g_assert_cmpint(ext->requests, == ,1);
+    g_assert_cmpint(ext->last, == ,BINDER_EXT_IMS_REGISTRATION_ON);
+    g_assert_cmpuint(self->ext_req_id, == ,TEST_CALL_ID);
+
+    /* A finished request has nothing left to cancel */
+    ext->complete(BINDER_EXT_IMS(ext), BINDER_EXT_IMS_RESULT_OK,
+        ext->user_data);
+    g_assert_cmpuint(self->ext_req_id, == ,0);
+    binder_ims_driver.remove(test_handle);
+    g_assert_cmpuint(ext->cancelled, == ,0);
+    g_object_unref(ext);
+}
+
+static
+void
+test_failure_is_not_fatal(
+    void)
+{
+    TestExtIms* ext = g_object_new(TEST_TYPE_EXT_IMS, NULL);
+    BinderIms* self;
+
+    test_probe(ext);
+    self = test_ims_data;
+    test_run_idle();
+    ext->complete(BINDER_EXT_IMS(ext), BINDER_EXT_IMS_RESULT_ERROR,
+        ext->user_data);
+    g_assert_cmpuint(self->ext_req_id, == ,0);
+    binder_ims_driver.remove(test_handle);
+    g_assert_cmpuint(ext->cancelled, == ,0);
+    g_object_unref(ext);
+}
+
+static
+void
+test_remove_cancels_pending(
+    void)
+{
+    TestExtIms* ext = g_object_new(TEST_TYPE_EXT_IMS, NULL);
+
+    test_probe(ext);
+    test_run_idle();
+    binder_ims_driver.remove(test_handle);
+    g_assert_cmpuint(ext->cancelled, == ,TEST_CALL_ID);
+    g_object_unref(ext);
+}
+
+static
+void
+test_remove_before_start(
+    void)
+{
+    TestExtIms* ext = g_object_new(TEST_TYPE_EXT_IMS, NULL);
+
+    test_probe(ext);
+    binder_ims_driver.remove(test_handle);
+    test_run_idle();
+    g_assert_cmpint(ext->requests, == ,0);
+    g_assert_cmpint(test_ofono_registered, == ,0);
+    g_object_unref(ext);
+}
+
+static
+void
+test_client_request_replaces_it(
+    void)
+{
+    TestExtIms* ext = g_object_new(TEST_TYPE_EXT_IMS, NULL);
+
+    test_probe(ext);
+    test_run_idle();
+    binder_ims_driver.ims_unregister(test_handle, test_ims_noop_cb, NULL);
+    g_assert_cmpuint(ext->cancelled, == ,TEST_CALL_ID);
+    g_assert_cmpint(ext->requests, == ,2);
+    g_assert_cmpint(ext->last, == ,BINDER_EXT_IMS_REGISTRATION_OFF);
+    binder_ims_driver.remove(test_handle);
+    g_object_unref(ext);
+}
+
+static
+void
+test_no_extension(
+    void)
+{
+    test_probe(NULL);
+    test_run_idle();
+    g_assert_cmpint(test_ofono_registered, == ,1);
+    binder_ims_driver.remove(test_handle);
+}
+
+#define TEST_(t) "/ims/" t
+
+int main(int argc, char* argv[])
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func(TEST_("requests_registration_on_start"),
+        test_requests_registration_on_start);
+    g_test_add_func(TEST_("failure_is_not_fatal"), test_failure_is_not_fatal);
+    g_test_add_func(TEST_("remove_cancels_pending"),
+        test_remove_cancels_pending);
+    g_test_add_func(TEST_("remove_before_start"), test_remove_before_start);
+    g_test_add_func(TEST_("client_request_replaces_it"),
+        test_client_request_replaces_it);
+    g_test_add_func(TEST_("no_extension"), test_no_extension);
+
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+    gutil_log_timestamp = FALSE;
+
+    return g_test_run();
+}
+

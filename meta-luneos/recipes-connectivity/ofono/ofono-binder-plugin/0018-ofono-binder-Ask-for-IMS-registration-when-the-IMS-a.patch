From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] [ofono-binder] Ask for IMS registration when the IMS atom
 comes up

Sailfish's oFono registers IMS by itself. Upstream oFono only does so
when a client calls Register on org.ofono.IpMultimediaSystem, and no
client on a system with upstream oFono does. The modem remembers the
last request across reboots, so IMS stayed in whatever state it was
left: never registered on a device that had not been told to.

Ask the IMS extension to register once the atom is up. A client that
wants something else can still say so, which replaces the request.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/binder_ims.c         |  24 +++
 unit/Makefile            |   1 +
 unit/unit_ims/Makefile   |   6 +
 unit/unit_ims/unit_ims.c | 330 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 361 insertions(+)
 create mode 100644 unit/unit_ims/Makefile
 create mode 100644 unit/unit_ims/unit_ims.c

diff --git a/src/binder_ims.c b/src/binder_ims.c
index f88571c..5242b43 100644
--- a/src/binder_ims.c
+++ b/src/binder_ims.c
@@ -178,6 +178,19 @@ binder_ims_registration_status(
         ims->registered ? ims->caps : 0, data);
 }
 
+static
+void
+binder_ims_auto_register_complete(
+    BinderExtIms* ext,
+    BINDER_EXT_IMS_RESULT result,
+    void* user_data)
+{
+    BinderIms* self = user_data;
+
+    DBG_(self, "%s", result == BINDER_EXT_IMS_RESULT_OK ? "ok" : "failed");
+    self->ext_req_id = 0;
+}
+
 static
 gboolean
 binder_ims_start(
@@ -195,6 +208,17 @@ binder_ims_start(
         self);
 
     ofono_ims_register(self->handle);
+
+    /*
+     * Upstream oFono only registers when a client calls Register, and
+     * nothing here does. The modem remembers the last request across
+     * reboots, so without this IMS stays in whatever state it was left.
+     */
+    if (self->ext) {
+        self->ext_req_id = binder_ext_ims_set_registration(self->ext,
+            BINDER_EXT_IMS_REGISTRATION_ON,
+            binder_ims_auto_register_complete, NULL, self);
+    }
     return G_SOURCE_REMOVE;
 }
 
diff --git a/unit/Makefile b/unit/Makefile
index 267adec..79e0b7a 100644
--- a/unit/Makefile
+++ b/unit/Makefile
@@ -10,6 +10,7 @@ all:
 	@$(MAKE) -C unit_ext_ims $*
 	@$(MAKE) -C unit_ext_plugin $*
 	@$(MAKE) -C unit_ext_slot $*
+	@$(MAKE) -C unit_ims $*
 	@$(MAKE) -C unit_oplist $*
 	@$(MAKE) -C unit_radio_caps $*
 	@$(MAKE) -C unit_sim $*
diff --git a/unit/unit_ims/Makefile b/unit/unit_ims/Makefile
new file mode 100644
index 0000000..6f8a96e
--- /dev/null
+++ b/unit/unit_ims/Makefile
@@ -0,0 +1,6 @@
+# -*- Mode: makefile-gmake -*-
+
+EXE = unit_ims
+PKGS += ofono
+
+include ../common/Makefile
diff --git a/unit/unit_ims/unit_ims.c b/unit/unit_ims/unit_ims.c
new file mode 100644
index 0000000..ff2b672
--- /dev/null
+++ b/unit/unit_ims/unit_ims.c
@@ -0,0 +1,330 @@
+/*
+ *  oFono - Open Source Telephony - binder based adaptation
+ *
+ *  Copyright (C) 2026 Herman van Hazendonk <github.com@herrie.org>
+ *

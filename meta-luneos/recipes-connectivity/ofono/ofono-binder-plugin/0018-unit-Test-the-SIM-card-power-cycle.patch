From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] [unit] Test the SIM card power cycle

Runs binder_sim_card_power_cycle() against the fake radio of
unit_sim_card: the card is powered down and then up through the card's
own request group, also while the status query that follows the power
down blocks that group, and the caller hears once, at the end. Also:
only one cycle at a time, a failed power down or power up, cancelling
halfway (the card is still powered up, nobody is called back), the card
going away mid-cycle, and the request that each radio flavour gets
(AIDL, IRadio 1.0, IRadio 1.1 and later).

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 unit/unit_sim_card/unit_sim_card.c | 348 ++++++++++++++++++++++++++++-
 1 file changed, 339 insertions(+), 9 deletions(-)

diff --git a/unit/unit_sim_card/unit_sim_card.c b/unit/unit_sim_card/unit_sim_card.c
index 2f9c9a7..e8d899d 100644
--- a/unit/unit_sim_card/unit_sim_card.c
+++ b/unit/unit_sim_card/unit_sim_card.c
@@ -18,6 +18,9 @@
  * radio. Reading the card status blocks the slot's request group, and
  * every other SIM request of that slot (SIM I/O, logical channels) waits
  * until the transaction is finished. These tests check when it is.
+ *
+ * The power cycle that makes the modem read an eUICC again after a
+ * profile change is run here as well.
  */
 
 #include "binder_sim_card.c"
@@ -31,6 +34,7 @@ GLOG_MODULE_DEFINE("unit_sim_card");
 
 struct radio_request {
     int refcount;
+    RadioRequestGroup* group;
     RADIO_REQ code;
     RadioRequestCompleteFunc complete;
     GDestroyNotify destroy;
@@ -52,6 +56,11 @@ struct radio_client {
 static struct test_state {
     GPtrArray* pending; /* Submitted, not yet completed */
     BinderSimCardStatus* next_status; /* Returned by the next status read */
+    RADIO_AIDL_INTERFACE aidl;
+    RADIO_INTERFACE hidl;
+    GString* power; /* 'd' and 'u' for each setSimCardPower written */
+    guint power_cycle_done;
+    gboolean power_cycle_ok;
 } test;
 
 /*==========================================================================*
@@ -72,6 +81,13 @@ ofono_warn(
 {
 }
 
+void
+ofono_error(
+    const char* format,
+    ...)
+{
+}
+
 void
 ofono_encode_hex(
     const void* in,
@@ -107,6 +123,7 @@ radio_request_new2(
         memset(args, 0, sizeof(*args));
     }
     req->refcount = 1;
+    req->group = group;
     req->code = code;
     req->complete = complete;
     req->destroy = destroy;
@@ -163,9 +180,13 @@ radio_request_drop(
     RadioRequest* req)
 {
     if (req) {
-        /* Cancel it if it's still pending, then drop the caller's ref */
+        /*
+         * Cancel it if it's still pending. The caller's ref is still
+         * held then, so dropping the pending one doesn't free it.
+         */
         if (g_ptr_array_remove(test.pending, req)) {
-            radio_request_unref(req);
+            g_assert_cmpint(req->refcount, >, 1);
+            req->refcount--;
         }
         radio_request_unref(req);
     }
@@ -242,7 +263,14 @@ RADIO_AIDL_INTERFACE
 radio_client_aidl_interface(
     RadioClient* client)
 {
-    return RADIO_AIDL_INTERFACE_NONE;
+    return test.aidl;
+}
+
+RADIO_INTERFACE
+radio_client_interface(
+    RadioClient* client)
+{
+    return test.hidl;
 }
 
 gulong
@@ -288,7 +316,19 @@ test_write_set_uicc_subscription_args(
 {
 }
 
-/* The HIDL codes with a status parser that hands out test.next_status */
+static
+void
+test_write_set_sim_card_power_args(
+    GBinderWriter* writer,
+    gboolean up)
+{
+    g_string_append_c(test.power, up ? 'u' : 'd');
+}
+
+/*
+ * The HIDL codes with a status parser that hands out test.next_status,
+ * and a power writer that notes down what was asked for
+ */
 static const BinderSimCardApi test_api = {
     "test",
     RADIO_IND_SIM_STATUS_CHANGED,
@@ -296,7 +336,9 @@ static const BinderSimCardApi test_api = {
     RADIO_REQ_GET_ICC_CARD_STATUS,
     test_read_icc_card_status,
     RADIO_REQ_SET_UICC_SUBSCRIPTION,
-    test_write_set_uicc_subscription_args
+    test_write_set_uicc_subscription_args,
+    RADIO_REQ_SET_SIM_CARD_POWER_1_1,
+    test_write_set_sim_card_power_args
 };
 
 /*
@@ -343,6 +385,8 @@ test_setup_init(
 {
     memset(&test, 0, sizeof(test));
     test.pending = g_ptr_array_new();
+    test.power = g_string_new(NULL);
+    test.hidl = RADIO_INTERFACE_1_4;
     memset(setup, 0, sizeof(*setup));
     setup->card = binder_sim_card_new(&setup->client, 1);
     setup->self = THIS(setup->card);
@@ -357,6 +401,7 @@ test_setup_deinit(
     binder_sim_card_unref(setup->card);
     g_assert_cmpuint(test.pending->len, ==, 0);
     g_ptr_array_free(test.pending, TRUE);
+    g_string_free(test.power, TRUE);
     g_free(test.next_status);
 }
 
@@ -377,11 +422,12 @@ test_pending_count(
     return n;
 }
 
-/* Complete the pending request with this code, successfully */
+/* Complete the pending request with this code */
 static
 void
-test_complete(
-    RADIO_REQ code)
+test_complete_error(
+    RADIO_REQ code,
+    RADIO_ERROR error)
 {
     guint i;
 
@@ -394,7 +440,7 @@ test_complete(
             memset(&reader, 0, sizeof(reader));
             g_ptr_array_remove_index(test.pending, i);
             req->complete(req, RADIO_TX_STATUS_OK, RADIO_RESP_NONE,
-                RADIO_ERROR_NONE, &reader, req->user_data);
+                error, &reader, req->user_data);
             radio_request_unref(req);
             return;
         }
@@ -402,6 +448,15 @@ test_complete(
     g_assert_not_reached();
 }
 
+/* Complete the pending request with this code, successfully */
+static
+void
+test_complete(
+    RADIO_REQ code)
+{
+    test_complete_error(code, RADIO_ERROR_NONE);
+}
+
 /* Answer the pending status query */
 static
 void
@@ -436,6 +491,53 @@ test_block(
     return radio_request_group_block_status(setup->self->g);
 }
 
+#define TEST_POWER_REQ RADIO_REQ_SET_SIM_CARD_POWER_1_1
+
+static
+void
+test_power_cycle_done(
+    BinderSimCard* card,
+    gboolean ok,
+    void* user_data)
+{
+    TestSetup* setup = user_data;
+
+    g_assert(card == setup->card);
+    test.power_cycle_done++;
+    test.power_cycle_ok = ok;
+}
+
+/* The pending setSimCardPower, which goes through the card's own group */
+static
+void
+test_assert_power_pending(
+    TestSetup* setup)
+{
+    guint i, n = 0;
+
+    for (i = 0; i < test.pending->len; i++) {
+        const RadioRequest* req = g_ptr_array_index(test.pending, i);
+
+        if (req->code == TEST_POWER_REQ) {
+            g_assert(req->group == setup->self->g);
+            n++;
+        }
+    }
+    g_assert_cmpuint(n, ==, 1);
+}
+
+/* A card with its USIM up, nothing pending */
+static
+void
+test_setup_usim(
+    TestSetup* setup)
+{
+    test_setup_init(setup);
+    test_answer_status(test_status_new(RADIO_CARD_STATE_PRESENT, 0, 1,
+        RADIO_APP_TYPE_USIM));
+    g_assert_cmpuint(test.pending->len, ==, 0);
+}
+
 /*==========================================================================*
  * Tests
  *==========================================================================*/
@@ -565,6 +667,226 @@ test_no_apps_then_usim(
     test_setup_deinit(&setup);
 }
 
+/* Down, then up, then the caller hears about it, once */
+static
+void
+test_power_cycle(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_assert_power_pending(&setup);
+    g_assert_cmpstr(test.power->str, ==, "d");
+    g_assert_cmpuint(test.power_cycle_done, ==, 0);
+
+    test_complete(TEST_POWER_REQ);
+    test_assert_power_pending(&setup);
+    g_assert_cmpstr(test.power->str, ==, "du");
+    g_assert_cmpuint(test.power_cycle_done, ==, 0);
+
+    test_complete(TEST_POWER_REQ);
+    g_assert_cmpuint(test.pending->len, ==, 0);
+    g_assert_cmpuint(test.power_cycle_done, ==, 1);
+    g_assert(test.power_cycle_ok);
+    test_setup_deinit(&setup);
+}
+
+/*
+ * The modem reports the card gone after it's powered down, and the
+ * status query that follows blocks the group. Powering up must still
+ * be sent, and the new card picked up afterwards.
+ */
+static
+void
+test_power_cycle_status(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_complete(TEST_POWER_REQ);
+
+    /* simStatusChanged */
+    binder_sim_card_get_status(setup.self);
+    g_assert_cmpint(test_block(&setup), ==, RADIO_BLOCK_ACQUIRED);
+    test_assert_power_pending(&setup);
+    g_assert_cmpstr(test.power->str, ==, "du");
+
+    test_answer_status(test_status_new(RADIO_CARD_STATE_ABSENT, -1, 0,
+        RADIO_APP_TYPE_UNKNOWN));
+    g_assert(!setup.card->app);
+    test_complete(TEST_POWER_REQ);
+    g_assert_cmpuint(test.power_cycle_done, ==, 1);
+    g_assert(test.power_cycle_ok);
+
+    /* The eUICC with its newly enabled profile */
+    binder_sim_card_get_status(setup.self);
+    test_answer_status(test_status_new(RADIO_CARD_STATE_PRESENT, 0, 1,
+        RADIO_APP_TYPE_USIM));
+    g_assert(setup.card->app);
+    g_assert_cmpint(test_block(&setup), ==, RADIO_BLOCK_NONE);
+    test_setup_deinit(&setup);
+}
+
+/* One power cycle at a time; the one going on isn't disturbed */
+static
+void
+test_power_cycle_busy(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    g_assert(!binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    g_assert_cmpstr(test.power->str, ==, "d");
+
+    test_complete(TEST_POWER_REQ);
+    g_assert(!binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_complete(TEST_POWER_REQ);
+    g_assert_cmpstr(test.power->str, ==, "du");
+    g_assert_cmpuint(test.power_cycle_done, ==, 1);
+    g_assert(test.power_cycle_ok);
+
+    /* Done, so the next one may start */
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_complete(TEST_POWER_REQ);
+    test_complete(TEST_POWER_REQ);
+    g_assert_cmpstr(test.power->str, ==, "dudu");
+    g_assert_cmpuint(test.power_cycle_done, ==, 2);
+    test_setup_deinit(&setup);
+}
+
+/* The modem won't power the card down: don't try to power it up */
+static
+void
+test_power_down_fails(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_complete_error(TEST_POWER_REQ, RADIO_ERROR_REQUEST_NOT_SUPPORTED);
+    g_assert_cmpstr(test.power->str, ==, "d");
+    g_assert_cmpuint(test.pending->len, ==, 0);
+    g_assert_cmpuint(test.power_cycle_done, ==, 1);
+    g_assert(!test.power_cycle_ok);
+    test_setup_deinit(&setup);
+}
+
+static
+void
+test_power_up_fails(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_complete(TEST_POWER_REQ);
+    test_complete_error(TEST_POWER_REQ, RADIO_ERROR_GENERIC_FAILURE);
+    g_assert_cmpstr(test.power->str, ==, "du");
+    g_assert_cmpuint(test.pending->len, ==, 0);
+    g_assert_cmpuint(test.power_cycle_done, ==, 1);
+    g_assert(!test.power_cycle_ok);
+    test_setup_deinit(&setup);
+}
+
+/* Cancelled halfway: no callback, but the card is powered up again */
+static
+void
+test_power_cycle_cancel(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    binder_sim_card_power_cycle_cancel(setup.card);
+    test_complete(TEST_POWER_REQ);
+    test_assert_power_pending(&setup);
+    g_assert_cmpstr(test.power->str, ==, "du");
+    test_complete(TEST_POWER_REQ);
+    g_assert_cmpuint(test.power_cycle_done, ==, 0);
+    test_setup_deinit(&setup);
+}
+
+/* The card goes away with a power cycle going on */
+static
+void
+test_power_cycle_unref(
+    void)
+{
+    TestSetup setup;
+
+    test_setup_usim(&setup);
+    g_assert(binder_sim_card_power_cycle(setup.card,
+        test_power_cycle_done, &setup));
+    test_complete(TEST_POWER_REQ);
+    test_assert_power_pending(&setup);
+
+    /* test_setup_deinit() checks that nothing is left pending */
+    test_setup_deinit(&setup);
+    g_assert_cmpuint(test.power_cycle_done, ==, 0);
+}
+
+/* The power request that each kind of radio takes */
+static
+void
+test_power_api(
+    void)
+{
+    static const struct test_power_api {
+        RADIO_AIDL_INTERFACE aidl;
+        RADIO_INTERFACE hidl;
+        const BinderSimCardApi* api;
+        RADIO_REQ req;
+    } tests[] = {
+        { RADIO_SIM_INTERFACE, RADIO_INTERFACE_NONE,
+          &binder_sim_card_api_aidl,
+          (RADIO_REQ) RADIO_SIM_REQ_SET_SIM_CARD_POWER },
+        { RADIO_AIDL_INTERFACE_NONE, RADIO_INTERFACE_1_0,
+          &binder_sim_card_api_hidl_1_0, RADIO_REQ_SET_SIM_CARD_POWER },
+        { RADIO_AIDL_INTERFACE_NONE, RADIO_INTERFACE_1_1,
+          &binder_sim_card_api_hidl, RADIO_REQ_SET_SIM_CARD_POWER_1_1 },
+        { RADIO_AIDL_INTERFACE_NONE, RADIO_INTERFACE_1_4,
+          &binder_sim_card_api_hidl, RADIO_REQ_SET_SIM_CARD_POWER_1_1 }
+    };
+    guint i;
+
+    for (i = 0; i < G_N_ELEMENTS(tests); i++) {
+        const struct test_power_api* t = tests + i;
+        RadioClient client;
+        BinderSimCard* card;
+        BinderSimCardObject* self;
+
+        memset(&test, 0, sizeof(test));
+        test.pending = g_ptr_array_new();
+        test.aidl = t->aidl;
+        test.hidl = t->hidl;
+        card = binder_sim_card_new(&client, 0);
+        self = THIS(card);
+        g_assert(self->api == t->api);
+        g_assert_cmpint(self->api->set_sim_card_power_req, ==, t->req);
+        binder_sim_card_unref(card);
+        g_assert_cmpuint(test.pending->len, ==, 0);
+        g_ptr_array_free(test.pending, TRUE);
+    }
+}
+
 int main(int argc, char* argv[])
 {
     g_test_init(&argc, &argv, NULL);
@@ -577,6 +899,14 @@ int main(int argc, char* argv[])
     g_test_add_func(TEST_("subscribe"), test_subscribe);
     g_test_add_func(TEST_("no_apps"), test_no_apps);
     g_test_add_func(TEST_("no_apps_then_usim"), test_no_apps_then_usim);
+    g_test_add_func(TEST_("power_cycle"), test_power_cycle);
+    g_test_add_func(TEST_("power_cycle_status"), test_power_cycle_status);
+    g_test_add_func(TEST_("power_cycle_busy"), test_power_cycle_busy);
+    g_test_add_func(TEST_("power_down_fails"), test_power_down_fails);
+    g_test_add_func(TEST_("power_up_fails"), test_power_up_fails);
+    g_test_add_func(TEST_("power_cycle_cancel"), test_power_cycle_cancel);
+    g_test_add_func(TEST_("power_cycle_unref"), test_power_cycle_unref);
+    g_test_add_func(TEST_("power_api"), test_power_api);
     return g_test_run();
 }
 

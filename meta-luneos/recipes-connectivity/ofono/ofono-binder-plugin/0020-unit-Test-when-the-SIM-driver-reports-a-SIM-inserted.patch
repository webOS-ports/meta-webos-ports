+++ b/unit/Makefile
@@ -12,6 +12,7 @@ all:
 	@$(MAKE) -C unit_ext_slot $*
 	@$(MAKE) -C unit_oplist $*
 	@$(MAKE) -C unit_radio_caps $*
+	@$(MAKE) -C unit_sim $*
 	@$(MAKE) -C unit_sim_card $*
 	@$(MAKE) -C unit_sim_settings $*
 	@$(MAKE) -C unit_util $*
diff --git a/unit/unit_sim/Makefile b/unit/unit_sim/Makefile
new file mode 100644

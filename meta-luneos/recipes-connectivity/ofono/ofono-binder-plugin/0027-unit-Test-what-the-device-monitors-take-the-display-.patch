+/*
+ * The device monitors put the modem into its screen-off mode (fewer
+ * indications, low data expected) while the display is off. What they
+ * know about the display comes from MCE. Without MCE the display state
+ * never becomes valid, and that must count as on: a modem left in
+ * screen-off mode for good may stop reporting the signal strength.
+ */
+
+#include "binder_devmon_if.c"
+#include "binder_connman.h"
+
+#include <gutil_log.h>
+
+GLOG_MODULE_DEFINE("unit_devmon");
+
+#define TEST_(t) "/devmon/" t
+
+/*==========================================================================*
+ * Stubs for what the monitors link against but the tests don't run
+ *==========================================================================*/
+
+void
+ofono_debug(
+    const char* format,
+    ...)
+{
+}
+
+void
+ofono_warn(
+    const char* format,
+    ...)
+{
+}
+
+void
+ofono_error(
+    const char* format,
+    ...)
+{
+}
+
+void
+ofono_encode_hex(
+    const void* in,
+    unsigned int n,
+    char out[])
+{
+    out[0] = 0;
+}
+
+enum ofono_radio_access_mode
+ofono_radio_access_max_mode(
+    enum ofono_radio_access_mode mask)
+{
+    return mask;
+}
+
+struct ofono_slot*
+ofono_slot_ref(
+    struct ofono_slot* s)
+{
+    return s;
+}
+
+void
+ofono_slot_unref(
+    struct ofono_slot* s)
+{
+}
+
+void
+ofono_slot_set_cell_info_update_interval(
+    struct ofono_slot* s,
+    void* tag,
+    int interval_ms)
+{
+}
+
+void
+ofono_slot_drop_cell_info_requests(
+    struct ofono_slot* s,
+    void* tag)
+{
+}
+
+BinderConnman*
+binder_connman_new(
+    void)
+{
+    return NULL;
+}
+
+BinderConnman*
+binder_connman_ref(
+    BinderConnman* connman)
+{
+    return connman;
+}
+
+void
+binder_connman_unref(
+    BinderConnman* connman)
+{
+}
+
+gulong
+binder_connman_add_property_changed_handler(
+    BinderConnman* connman,
+    BINDER_CONNMAN_PROPERTY property,
+    BinderConnmanPropertyFunc fn,
+    void* user_data)
+{
+    return 0;
+}
+
+void
+binder_connman_remove_handlers(
+    BinderConnman* connman,
+    gulong* ids,
+    int n)
+{
+}
+
+gboolean test_devmon_ds_display_on(MceDisplay* display);
+
+static
+void
+test_display(
+    MceDisplay* display,
+    gboolean valid,
+    MCE_DISPLAY_STATE state)
+{
+    memset(display, 0, sizeof(*display));
+    display->valid = valid;
+    display->state = state;
+}
+
+static
+void
+test_display_on(
+    gboolean (*display_on)(MceDisplay*))
+{
+    MceDisplay display;
+
+    /* No MCE */
+    test_display(&display, FALSE, MCE_DISPLAY_STATE_OFF);
+    g_assert(display_on(&display));
+    /* MCE says the display is off */
+    test_display(&display, TRUE, MCE_DISPLAY_STATE_OFF);
+    g_assert(!display_on(&display));
+    /* On, or dimmed */
+    test_display(&display, TRUE, MCE_DISPLAY_STATE_ON);
+    g_assert(display_on(&display));
+    test_display(&display, TRUE, MCE_DISPLAY_STATE_DIM);
+    g_assert(display_on(&display));
+}
+
+static
+gboolean
+test_devmon_if_display_on(
+    MceDisplay* display)
+{
+    return binder_devmon_if_display_on(display);
+}
+
+static
+void
+test_if(
+    void)
+{
+    test_display_on(test_devmon_if_display_on);
+}
+
+static
+void
+test_ds(
+    void)
+{
+    test_display_on(test_devmon_ds_display_on);
+}
+
+int main(int argc, char* argv[])
+{
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+    gutil_log_timestamp = FALSE;
+    g_test_add_func(TEST_("if"), test_if);
+    g_test_add_func(TEST_("ds"), test_ds);
+    return g_test_run();
+}
+

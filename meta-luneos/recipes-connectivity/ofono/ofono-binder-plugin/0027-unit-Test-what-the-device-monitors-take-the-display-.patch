From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] [unit] Test what the device monitors take the display state
 to be

Checks both device monitors: without MCE the display counts as on,
otherwise it is off only when MCE says it is off.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 unit/Makefile                     |   1 +
 unit/unit_devmon/Makefile         |   8 ++
 unit/unit_devmon/unit_devmon.c    | 215 ++++++++++++++++++++++++++++++
 unit/unit_devmon/unit_devmon_ds.c |  38 ++++++
 4 files changed, 262 insertions(+)
 create mode 100644 unit/unit_devmon/Makefile
 create mode 100644 unit/unit_devmon/unit_devmon.c
 create mode 100644 unit/unit_devmon/unit_devmon_ds.c

diff --git a/unit/Makefile b/unit/Makefile
index 79e0b7a..ce1c2cb 100644
--- a/unit/Makefile
+++ b/unit/Makefile
@@ -6,6 +6,7 @@ all:
 %:
 	@$(MAKE) -C unit_base $*
 	@$(MAKE) -C unit_call_settings $*
+	@$(MAKE) -C unit_devmon $*
 	@$(MAKE) -C unit_ext_call $*
 	@$(MAKE) -C unit_ext_ims $*
 	@$(MAKE) -C unit_ext_plugin $*

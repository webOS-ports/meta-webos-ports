+/*
+ * Checks how the data driver writes its setupDataCall arguments. The
+ * GBinderWriter calls are recorded instead of building a parcel, so the
+ * test sees which argument went over as what: a plain value or a buffer
+ * object of its own, which is how HIDL sends any struct or safe_union.
+ */
+
+#include "binder_data.c"
+
+#include <ofono/watch.h>
+
+#include <gutil_log.h>
+
+GLOG_MODULE_DEFINE("unit_data");
+
+#define TEST_(t) "/data/" t
+
+static struct test_writer_log {
+    GString* calls;        /* What was appended, in order */
+    GSList* allocs;        /* gbinder_writer_malloc() memory */
+    GSList* buffers;       /* Contents of each buffer object, in order */
+} test;
+
+/*==========================================================================*
+ * Recording GBinderWriter
+ *==========================================================================*/
+
+static
+void
+test_call(
+    const char* format,
+    ...) G_GNUC_PRINTF(1,2);
+
+static
+void
+test_call(
+    const char* format,
+    ...)
+{
+    va_list va;
+
+    if (test.calls->len) {
+        g_string_append_c(test.calls, ' ');
+    }
+    va_start(va, format);
+    g_string_append_vprintf(test.calls, format, va);
+    va_end(va);
+}
+
+void*
+gbinder_writer_malloc(
+    GBinderWriter* writer,
+    gsize size)
+{
+    void* ptr = g_malloc(size);
+
+    test.allocs = g_slist_prepend(test.allocs, ptr);
+    return ptr;
+}
+
+void*
+gbinder_writer_malloc0(
+    GBinderWriter* writer,
+    gsize size)
+{
+    void* ptr = g_malloc0(size);
+
+    test.allocs = g_slist_prepend(test.allocs, ptr);
+    return ptr;
+}
+
+void
+gbinder_writer_append_int32(
+    GBinderWriter* writer,
+    guint32 value)
+{
+    test_call("i32");
+}
+
+void
+gbinder_writer_append_int8(
+    GBinderWriter* writer,
+    guint8 value)
+{
+    test_call("i8");
+}
+
+void
+gbinder_writer_append_bool(
+    GBinderWriter* writer,
+    gboolean value)
+{
+    test_call("bool");
+}
+
+void
+gbinder_writer_append_hidl_string_vec(
+    GBinderWriter* writer,
+    const char* data[],
+    gssize count)
+{
+    test_call("strvec");
+}
+
+void
+gbinder_writer_append_struct(
+    GBinderWriter* writer,
+    const void* ptr,
+    const GBinderWriterType* type,
+    const GBinderParent* parent)
+{
+    test_call("struct(%u)", (guint) type->size);
+}
+
+guint
+gbinder_writer_append_buffer_object(
+    GBinderWriter* writer,
+    const void* buf,
+    gsize len)
+{
+    test_call("buf(%u)", (guint) len);
+    test.buffers = g_slist_append(test.buffers, g_bytes_new(buf, len));
+    return 0;
+}
+
+/*==========================================================================*
+ * Stubs for what binder_data.c links against but the tests don't run
+ *==========================================================================*/
+
+void ofono_debug(const char* format, ...) {}
+void ofono_warn(const char* format, ...) {}
+void ofono_error(const char* format, ...) {}
+
+void
+ofono_encode_hex(
+    const void* in,
+    unsigned int n,
+    char out[])
+{
+    out[0] = 0;
+}
+
+enum ofono_radio_access_mode
+ofono_radio_access_max_mode(
+    enum ofono_radio_access_mode mask)
+{
+    return mask;
+}
+
+const char*
+ofono_radio_access_mode_to_string(
+    enum ofono_radio_access_mode m)
+{
+    return "";
+}
+
+const char*
+ofono_access_technology_to_string(
+    enum ofono_access_technology t)
+{
+    return "";
+}
+
+const char*
+ofono_netreg_status_to_string(
+    enum ofono_netreg_status status)
+{
+    return "";
+}
+
+const struct ofono_gprs_primary_context*
+ofono_gprs_context_settings_by_type(
+    struct ofono_gprs* gprs,
+    enum ofono_gprs_context_type type)
+{
+    return NULL;
+}
+
+struct ofono_watch*
+ofono_watch_new(
+    const char* path)
+{
+    return NULL;
+}
+
+struct ofono_watch*
+ofono_watch_ref(
+    struct ofono_watch* w)
+{
+    return w;
+}
+
+void
+ofono_watch_unref(
+    struct ofono_watch* w)
+{
+}

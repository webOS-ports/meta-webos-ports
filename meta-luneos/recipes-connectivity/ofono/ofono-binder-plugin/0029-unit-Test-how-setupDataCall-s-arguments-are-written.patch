+unsigned long
+ofono_watch_add_modem_changed_handler(
+    struct ofono_watch* w,
+    ofono_watch_cb_t cb,
+    void* user_data)
+{
+    return 0;
+}
+
+unsigned long
+ofono_watch_add_imsi_changed_handler(
+    struct ofono_watch* w,

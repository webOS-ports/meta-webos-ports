+/*==========================================================================*
+ * Tests
+ *==========================================================================*/
+
+static
+void
+test_start(
+    void)
+{
+    memset(&test, 0, sizeof(test));
+    test.calls = g_string_new(NULL);
+}
+
+static
+void
+test_finish(
+    void)
+{
+    g_string_free(test.calls, TRUE);
+    g_slist_free_full(test.allocs, g_free);
+    g_slist_free_full(test.buffers, (GDestroyNotify) g_bytes_unref);
+}
+
+static
+void
+test_setup_init(
+    BinderDataRequestSetup* setup,
+    BinderDataProfileConfig* config)
+{
+    memset(setup, 0, sizeof(*setup));
+    memset(config, 0, sizeof(*config));
+    setup->apn = "internet";
+    setup->proto = OFONO_GPRS_PROTO_IPV4V6;
+    setup->auth_method = OFONO_GPRS_AUTH_METHOD_NONE;
+}
+
+static
+gboolean
+test_all_zero(
+    GBytes* bytes)
+{
+    gsize i, size;
+    const guint8* data = g_bytes_get_data(bytes, &size);
+
+    for (i = 0; i < size; i++) {
+        if (data[i]) {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+/* The arguments setupDataCall_1_5 has, written the 1.5 way */
+static
+void
+test_setup_data_call_1_5(
+    void)
+{
+    BinderDataRequestSetup setup;
+    BinderDataProfileConfig config;
+    GBinderWriter writer;
+
+    test_start();
+    test_setup_init(&setup, &config);
+    memset(&writer, 0, sizeof(writer));
+    binder_data_api_write_setup_data_call_args_hidl_1_5(&writer, &setup,
+        &config, RADIO_TECH_LTE);
+    g_assert_cmpstr(test.calls->str, == ,
+        "i32 struct(112) bool i32 strvec strvec");
+    test_finish();
+}
+
+/*
+ * setupDataCall_1_6 adds pduSessionId, the OptionalSliceInfo and
+ * OptionalTrafficDescriptor safe_unions, and matchAllRuleAllowed. Each
+ * safe_union is a buffer object of its own, sent as noinit: all zero.
+ */
+static
+void
+test_setup_data_call_1_6(
+    void)
+{
+    BinderDataRequestSetup setup;
+    BinderDataProfileConfig config;
+    GBinderWriter writer;
+
+    test_start();
+    test_setup_init(&setup, &config);
+    memset(&writer, 0, sizeof(writer));
+    binder_data_api_write_setup_data_call_args_hidl_1_6(&writer, &setup,
+        &config, RADIO_TECH_LTE);
+    g_assert_cmpstr(test.calls->str, == ,
+        "i32 struct(112) bool i32 strvec strvec i32 buf(24) buf(56) bool");
+    g_assert_cmpuint(g_slist_length(test.buffers), == , 2);
+    g_assert(test_all_zero(test.buffers->data));
+    g_assert(test_all_zero(test.buffers->next->data));
+    test_finish();
+}
+
+int main(int argc, char* argv[])
+{
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+    gutil_log_timestamp = FALSE;
+    g_test_add_func(TEST_("setup_data_call_1_5"), test_setup_data_call_1_5);
+    g_test_add_func(TEST_("setup_data_call_1_6"), test_setup_data_call_1_6);
+    return g_test_run();
+}
+

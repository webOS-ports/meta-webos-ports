+/* The display state from MCE (com.nokia.mce), through libmce-glib */
+
+#include "binder_display_p.h"
+
+#include <mce_display.h>
+
+enum binder_display_mce_event {
+    MCE_EVENT_VALID,
+    MCE_EVENT_STATE,
+    MCE_EVENT_COUNT
+};
+
+struct binder_display_backend {
+    MceDisplay* display;
+    gulong event_id[MCE_EVENT_COUNT];
+    BinderDisplayBackendFunc callback;
+    void* user_data;
+};
+
+static
+void
+binder_display_mce_changed(
+    MceDisplay* display,
+    void* user_data)
+{
+    BinderDisplayBackend* self = user_data;
+
+    self->callback(display->valid, display->state != MCE_DISPLAY_STATE_OFF,
+        self->user_data);
+}
+
+BinderDisplayBackend*
+binder_display_backend_new(
+    BinderDisplayBackendFunc callback,
+    void* user_data)
+{
+    BinderDisplayBackend* self = g_new0(BinderDisplayBackend, 1);
+
+    self->callback = callback;
+    self->user_data = user_data;
+    self->display = mce_display_new();
+    self->event_id[MCE_EVENT_VALID] =
+        mce_display_add_valid_changed_handler(self->display,
+            binder_display_mce_changed, self);
+    self->event_id[MCE_EVENT_STATE] =
+        mce_display_add_state_changed_handler(self->display,
+            binder_display_mce_changed, self);
+    binder_display_mce_changed(self->display, self);
+    return self;
+}
+
+void
+binder_display_backend_free(
+    BinderDisplayBackend* self)
+{
+    if (self) {
+        mce_display_remove_all_handlers(self->display, self->event_id);
+        mce_display_unref(self->display);
+        g_free(self);
+    }
+}

+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ *  GNU General Public License for more details.
+ */
+
+#include "binder_display_p.h"
+#include "binder_base.h"
+#include "binder_log.h"
+
+#include <gutil_misc.h>
+
+typedef struct binder_display_object {
+    BinderBase base;
+    BinderDisplay pub;
+    BinderDisplayBackend* backend;
+} BinderDisplayObject;
+
+typedef BinderBaseClass BinderDisplayObjectClass;
+GType binder_display_object_get_type(void) BINDER_INTERNAL;
+G_DEFINE_TYPE(BinderDisplayObject, binder_display_object, BINDER_TYPE_BASE)
+#define PARENT_CLASS binder_display_object_parent_class
+#define THIS_TYPE binder_display_object_get_type()
+#define THIS(obj) G_TYPE_CHECK_INSTANCE_CAST(obj,THIS_TYPE,BinderDisplayObject)
+
+BINDER_BASE_ASSERT_COUNT(BINDER_DISPLAY_PROPERTY_COUNT);
+
+/* All slots share one display */
+static BinderDisplayObject* binder_display_instance = NULL;
+
+/* There is only one, no need to cast */
+static inline BinderDisplayObject* binder_display_cast(BinderDisplay* d)
+    { return (d && binder_display_instance &&
+        d == &binder_display_instance->pub) ? binder_display_instance : NULL; }
+
+static
+void
+binder_display_backend_cb(
+    gboolean valid,
+    gboolean on,
+    void* user_data)
+{
+    BinderDisplayObject* self = THIS(user_data);
+
+    /*
+     * A display state that isn't known is taken as on. Taking it as
+     * off would put the modem into its screen-off mode until the state
+     * becomes known, which without a source (no MCE on LuneOS) is for
+     * good, and a RIL that honours that stops measuring the signal.
+     */
+    const gboolean display_on = !valid || on;
+
+    if (self->pub.on != display_on) {
+        self->pub.on = display_on;
+        DBG("Display %s%s", display_on ? "on" : "off",
+            valid ? "" : " (state unknown)");
+        binder_base_emit_property_change(&self->base,
+            BINDER_DISPLAY_PROPERTY_ON);
+    }
+}
+
+/*==========================================================================*
+ * API
+ *==========================================================================*/
+
+BinderDisplay*
+binder_display_new(
+    void)
+{
+    if (binder_display_instance) {
+        g_object_ref(binder_display_instance);
+    } else {
+        BinderDisplayObject* self = g_object_new(THIS_TYPE, NULL);
+
+        binder_display_instance = self;
+        g_object_add_weak_pointer(G_OBJECT(self),
+            (gpointer*)(&binder_display_instance));
+        self->backend = binder_display_backend_new(binder_display_backend_cb,
+            self);
+    }
+    return &binder_display_instance->pub;
+}
+
+BinderDisplay*
+binder_display_ref(
+    BinderDisplay* display)
+{
+    BinderDisplayObject* self = binder_display_cast(display);
+
+    if (G_LIKELY(self)) {
+        g_object_ref(self);
+        return display;
+    } else {
+        return NULL;
+    }
+}
+
+void
+binder_display_unref(
+    BinderDisplay* display)
+{
+    gutil_object_unref(binder_display_cast(display));
+}
+
+gulong
+binder_display_add_property_handler(
+    BinderDisplay* display,
+    BINDER_DISPLAY_PROPERTY property,
+    BinderDisplayPropertyFunc callback,
+    void* user_data)
+{
+    BinderDisplayObject* self = binder_display_cast(display);
+
+    return G_LIKELY(self) ? binder_base_add_property_handler(&self->base,
+        property, G_CALLBACK(callback), user_data) : 0;
+}
+
+void
+binder_display_remove_handlers(
+    BinderDisplay* display,
+    gulong* ids,
+    int count)
+{
+    gutil_disconnect_handlers(binder_display_cast(display), ids, count);
+}
+
+/*==========================================================================*
+ * Internals
+ *==========================================================================*/
+
+static
+void
+binder_display_object_init(
+    BinderDisplayObject* self)
+{
+    self->pub.on = TRUE;
+}
+
+static
+void
+binder_display_object_finalize(
+    GObject* object)
+{
+    BinderDisplayObject* self = THIS(object);
+
+    binder_display_backend_free(self->backend);
+    G_OBJECT_CLASS(PARENT_CLASS)->finalize(object);
+}
+
+static
+void
+binder_display_object_class_init(
+    BinderDisplayObjectClass* klass)
+{
+    G_OBJECT_CLASS(klass)->finalize = binder_display_object_finalize;
+    BINDER_BASE_CLASS(klass)->public_offset =
+        G_STRUCT_OFFSET(BinderDisplayObject, pub);
+}
+
+/*
+ * Local Variables:
+ * mode: C
+ * c-basic-offset: 4
+ * indent-tabs-mode: nil
+ * End:
+ */

@@ -0,0 +1,8 @@
+# -*- Mode: makefile-gmake -*-
+
+# libmce-glib is faked, only its headers are needed
+PKGS += libmce-glib
+
+EXE = unit_display
+
+include ../common/Makefile
diff --git a/unit/unit_display/unit_display.c b/unit/unit_display/unit_display.c
new file mode 100644
index 0000000..62eefdd
--- /dev/null
+++ b/unit/unit_display/unit_display.c
@@ -0,0 +1,295 @@
+/*
+ *  oFono - Open Source Telephony - binder based adaptation
+ *
+ *  Copyright (C) 2026 Herman van Hazendonk <github.com@herrie.org>
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ *  This program is distributed in the hope that it will be useful,
+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ *  GNU General Public License for more details.
+ */
+
+/*
+ * The display state the device monitors go by, from MCE. libmce-glib
+ * is faked: the test sets the MceDisplay's valid and state fields and
+ * calls the handlers the backend has added, as libmce-glib does.
+ */
+
+#include "binder_display.c"
+#include "binder_display_mce.c"
+
+#include <gutil_log.h>
+
+GLOG_MODULE_DEFINE("unit_display");
+
+#define TEST_(t) "/display/" t
+
+static struct test_mce {
+    MceDisplay display;
+    int refs;
+    MceDisplayFunc valid_fn;
+    void* valid_arg;
+    MceDisplayFunc state_fn;
+    void* state_arg;
+} test_mce;
+
+void ofono_debug(const char* format, ...) {}
+
+/*==========================================================================*
+ * Fake libmce-glib
+ *==========================================================================*/
+
+MceDisplay*
+mce_display_new(
+    void)
+{
+    test_mce.refs++;
+    return &test_mce.display;
+}
+
+void
+mce_display_unref(
+    MceDisplay* display)
+{
+    g_assert(display == &test_mce.display);
+    g_assert_cmpint(test_mce.refs, > ,0);
+    test_mce.refs--;
+}
+
+gulong
+mce_display_add_valid_changed_handler(
+    MceDisplay* display,
+    MceDisplayFunc fn,
+    void* arg)
+{
+    g_assert(!test_mce.valid_fn);
+    test_mce.valid_fn = fn;
+    test_mce.valid_arg = arg;
+    return 1;
+}
+
+gulong
+mce_display_add_state_changed_handler(
+    MceDisplay* display,
+    MceDisplayFunc fn,
+    void* arg)
+{
+    g_assert(!test_mce.state_fn);
+    test_mce.state_fn = fn;
+    test_mce.state_arg = arg;
+    return 2;
+}
+
+void
+mce_display_remove_handlers(
+    MceDisplay* display,
+    gulong* ids,
+    guint count)
+{
+    guint i;
+
+    for (i = 0; i < count; i++) {
+        if (ids[i] == 1) {
+            test_mce.valid_fn = NULL;
+        } else if (ids[i] == 2) {
+            test_mce.state_fn = NULL;
+        }
+        ids[i] = 0;
+    }
+}
+
+/*==========================================================================*
+ * Common
+ *==========================================================================*/
+
+static
+void
+test_mce_reset(
+    gboolean valid,
+    MCE_DISPLAY_STATE state)
+{
+    memset(&test_mce, 0, sizeof(test_mce));
+    test_mce.display.valid = valid;
+    test_mce.display.state = state;
+}
+
+static
+void
+test_mce_valid(
+    gboolean valid)
+{
+    test_mce.display.valid = valid;
+    g_assert(test_mce.valid_fn);
+    test_mce.valid_fn(&test_mce.display, test_mce.valid_arg);
+}
+
+static
+void
+test_mce_state(
+    MCE_DISPLAY_STATE state)
+{
+    test_mce.display.state = state;
+    g_assert(test_mce.state_fn);
+    test_mce.state_fn(&test_mce.display, test_mce.state_arg);
+}
+
+static
+void
+test_count_cb(
+    BinderDisplay* display,
+    BINDER_DISPLAY_PROPERTY property,
+    void* user_data)
+{
+    g_assert_cmpint(property, == ,BINDER_DISPLAY_PROPERTY_ON);
+    (*(int*)user_data)++;
+}
+
+static
+void
+test_done(
+    BinderDisplay* display)
+{
+    binder_display_unref(display);
+    g_assert(!binder_display_instance);
+    g_assert_cmpint(test_mce.refs, == ,0);
+    g_assert(!test_mce.valid_fn);
+    g_assert(!test_mce.state_fn);
+}
+
+/*==========================================================================*
+ * Tests
+ *==========================================================================*/
+
+/* Without MCE the state never becomes valid: that is on, not off */
+static
+void
+test_unknown(
+    void)
+{
+    BinderDisplay* display;
+
+    test_mce_reset(FALSE, MCE_DISPLAY_STATE_OFF);
+    display = binder_display_new();
+    g_assert(display->on);
+    test_done(display);
+}
+
+/* The state MCE has when the display is made counts right away */
+static
+void
+test_initial(
+    void)
+{
+    BinderDisplay* display;
+
+    test_mce_reset(TRUE, MCE_DISPLAY_STATE_OFF);
+    display = binder_display_new();
+    g_assert(!display->on);
+    test_done(display);
+}
+
+static
+void
+test_states(
+    void)
+{
+    BinderDisplay* display;
+    gulong id[1];
+    int n = 0;
+
+    test_mce_reset(FALSE, MCE_DISPLAY_STATE_OFF);
+    display = binder_display_new();
+    id[0] = binder_display_add_property_handler(display,
+        BINDER_DISPLAY_PROPERTY_ON, test_count_cb, &n);
+    g_assert(id[0]);
+
+    /* MCE answers: off */
+    test_mce_valid(TRUE);
+    g_assert(!display->on);
+    g_assert_cmpint(n, == ,1);
+
+    /* Dimmed is on */
+    test_mce_state(MCE_DISPLAY_STATE_DIM);
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,2);
+
+    /* No signal when nothing changes */
+    test_mce_state(MCE_DISPLAY_STATE_ON);
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,2);
+
+    test_mce_state(MCE_DISPLAY_STATE_OFF);
+    g_assert(!display->on);
+    g_assert_cmpint(n, == ,3);
+
+    /* MCE is gone: the state isn't known, so on again */
+    test_mce_valid(FALSE);
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,4);
+
+    binder_display_remove_all_handlers(display, id);
+    g_assert(!id[0]);
+    test_mce_valid(TRUE);
+    g_assert_cmpint(n, == ,4);
+    test_done(display);
+}
+
+/* All slots share one display, and so one MCE display */
+static
+void
+test_shared(
+    void)
+{
+    BinderDisplay* d1;
+    BinderDisplay* d2;
+
+    test_mce_reset(TRUE, MCE_DISPLAY_STATE_ON);
+    d1 = binder_display_new();
+    d2 = binder_display_new();
+    g_assert(d1 == d2);
+    g_assert_cmpint(test_mce.refs, == ,1);
+    g_assert(binder_display_ref(d1) == d1);
+    binder_display_unref(d1);
+    binder_display_unref(d1);
+    g_assert(binder_display_instance);
+    test_done(d2);
+}
+
+static
+void
+test_null(
+    void)
+{
+    g_assert(!binder_display_ref(NULL));
+    binder_display_unref(NULL);
+    g_assert(!binder_display_add_property_handler(NULL,
+        BINDER_DISPLAY_PROPERTY_ON, test_count_cb, NULL));
+    binder_display_remove_handlers(NULL, NULL, 0);
+    binder_display_backend_free(NULL);
+}
+
+int main(int argc, char* argv[])
+{
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+    gutil_log_timestamp = FALSE;
+    g_test_add_func(TEST_("unknown"), test_unknown);
+    g_test_add_func(TEST_("initial"), test_initial);
+    g_test_add_func(TEST_("states"), test_states);
+    g_test_add_func(TEST_("shared"), test_shared);
+    g_test_add_func(TEST_("null"), test_null);
+    return g_test_run();
+}
+

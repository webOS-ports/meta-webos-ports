+#ifndef BINDER_DISPLAY_H
+#define BINDER_DISPLAY_H
+
+#include "binder_types.h"
+
+/*
+ * Whether the display is on, as far as the modem needs to know. A
+ * dimmed display counts as on. The state comes from MCE. Until MCE
+ * has given one, the display is taken as on.
+ */
+
+typedef enum binder_display_property {
+    BINDER_DISPLAY_PROPERTY_ANY,
+    BINDER_DISPLAY_PROPERTY_ON,
+    BINDER_DISPLAY_PROPERTY_COUNT
+} BINDER_DISPLAY_PROPERTY;
+
+struct binder_display {
+    gboolean on;
+};
+
+typedef
+void
+(*BinderDisplayPropertyFunc)(
+    BinderDisplay* display,
+    BINDER_DISPLAY_PROPERTY property,
+    void* user_data);
+
+BinderDisplay*
+binder_display_new(
+    void)
+    BINDER_INTERNAL;
+
+BinderDisplay*
+binder_display_ref(
+    BinderDisplay* display)
+    BINDER_INTERNAL;
+
+void
+binder_display_unref(
+    BinderDisplay* display)
+    BINDER_INTERNAL;
+
+gulong
+binder_display_add_property_handler(
+    BinderDisplay* display,
+    BINDER_DISPLAY_PROPERTY property,
+    BinderDisplayPropertyFunc callback,
+    void* user_data)
+    BINDER_INTERNAL;
+
+void
+binder_display_remove_handlers(
+    BinderDisplay* display,
+    gulong* ids,
+    int count)
+    BINDER_INTERNAL;
+
+#define binder_display_remove_all_handlers(display, ids) \
+    binder_display_remove_handlers(display, ids, G_N_ELEMENTS(ids))
+
+#endif /* BINDER_DISPLAY_H */
+

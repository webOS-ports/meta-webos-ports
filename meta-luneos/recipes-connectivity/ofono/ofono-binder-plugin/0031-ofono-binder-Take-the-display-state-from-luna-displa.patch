diff --git a/Makefile b/Makefile
index 6d9151f..9008ba2 100644
--- a/Makefile
+++ b/Makefile
@@ -17,6 +17,19 @@
 # library are not in scope unless this object names it itself.
 LDPKGS = ofono-ext libgbinder-radio libgbinder libmce-glib libglibutil gobject-2.0 glib-2.0
 
+#
+# LUNEOS=1 takes the display state from luna-displaymanager instead of
+# MCE, which LuneOS doesn't have. Battery and charger still come from
+# MCE.
+#
+
+ifeq ($(LUNEOS),1)
+LDPKGS += luna-service2 json-c
+DISPLAY_SRC = binder_display_luna.c
+else
+DISPLAY_SRC = binder_display_mce.c
+endif
+
 PKGS = ofono $(LDPKGS)
 
 #
@@ -55,7 +68,7 @@ SRC = \
   binder_devmon_ds.c \
   binder_devmon_if.c \
   binder_display.c \
-  binder_display_mce.c \
+  $(DISPLAY_SRC) \
   binder_gprs.c \
   binder_gprs_context.c \
   binder_ims.c \
@@ -239,8 +252,28 @@ ABS_PLUGINDIR := $(shell echo /$(PLUGINDIR) | sed -r 's|/+|/|g')
 INSTALL = install
 INSTALL_PLUGIN_DIR = $(DESTDIR)$(ABS_PLUGINDIR)
 
+#
+# With LUNEOS=1 ofonod joins the luna bus to read the display state. The
+# hub lets it on only under a name its role file allows for ofonod, lets
+# it subscribe only with display.query, and reads those two files only
+# when a manifest lists them.
+#
+
+LS2_NAME = org.webosports.ofono.binder
+LS2_FILES = LuneOS/sysbus
+LS2_DIR = $(DESTDIR)/usr/share/luna-service2
+
 install: $(INSTALL_PLUGIN_DIR)
 	$(INSTALL) -m 755 $(RELEASE_SO) $(INSTALL_PLUGIN_DIR)
+ifeq ($(LUNEOS),1)
+	$(INSTALL) -d $(LS2_DIR)/roles.d $(LS2_DIR)/client-permissions.d \
+	    $(LS2_DIR)/manifests.d
+	$(INSTALL) -m 644 $(LS2_FILES)/$(LS2_NAME).role.json $(LS2_DIR)/roles.d
+	$(INSTALL) -m 644 $(LS2_FILES)/$(LS2_NAME).perm.json \
+	    $(LS2_DIR)/client-permissions.d
+	$(INSTALL) -m 644 $(LS2_FILES)/$(LS2_NAME).manifest.json \
+	    $(LS2_DIR)/manifests.d
+endif
 
 $(INSTALL_PLUGIN_DIR):
 	$(INSTALL) -d $@

+++ b/src/binder_display_p.h
@@ -19,10 +19,10 @@
 #include "binder_display.h"
 
 /*
- * Where the display state comes from: binder_display_mce.c. A backend
- * calls its callback each time it learns something; valid is FALSE
- * while it has no state, for example before its source has answered or
- * after the source is gone.
+ * Where the display state comes from: binder_display_mce.c or, with
+ * LUNEOS=1, binder_display_luna.c. A backend calls its callback each
+ * time it learns something; valid is FALSE while it has no state, for
+ * example before its source has answered or after the source is gone.
  * The callback may be called from binder_display_backend_new().
  */
 

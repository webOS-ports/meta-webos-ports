+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ *  GNU General Public License for more details.
+ */
+
+/*
+ * The display state from luna-displaymanager, for LuneOS, which has no
+ * MCE. Subscribes to luna://com.palm.display/status while that service
+ * is up: the first reply has "state" ("on", "dimmed" or "off"), later
+ * ones an "event" ("displayOn", "displayDimmed" or "displayOff").
+ *
+ * The luna-service2 hub only lets a client in under a name that its
+ * role file allows for the executable, and only lets it call a method
+ * that its client permissions grant. LuneOS/sysbus has both for
+ * /usr/sbin/ofonod and BINDER_DISPLAY_LUNA_NAME (display.query), and
+ * the manifest that lists them; make install puts them in place.
+ */
+
+#include "binder_display_p.h"
+#include "binder_log.h"
+
+#include <luna-service2/lunaservice.h>
+#include <json-c/json.h>
+
+#include <string.h>
+
+#define BINDER_DISPLAY_LUNA_NAME "org.webosports.ofono.binder"
+#define BINDER_DISPLAY_LUNA_SERVICE "com.palm.display"
+#define BINDER_DISPLAY_LUNA_STATUS "luna://com.palm.display/status"
+#define BINDER_DISPLAY_LUNA_SUBSCRIBE "{\"subscribe\":true}"
+
+/* How long to wait before trying the hub again; the test changes it */
+static guint binder_display_luna_retry_ms = 2000;
+
+typedef enum binder_display_luna_state {
+    LUNA_DISPLAY_IGNORE,    /* Says nothing about on or off */
+    LUNA_DISPLAY_INVALID,   /* An error, the state is no longer known */
+    LUNA_DISPLAY_ON,
+    LUNA_DISPLAY_OFF
+} BINDER_DISPLAY_LUNA_STATE;
+
+struct binder_display_backend {
+    BinderDisplayBackendFunc callback;
+    void* user_data;
+    LSHandle* handle;
+    void* server_status;
+    LSMessageToken call;
+    guint retry_id;
+    gboolean register_failed;
+};
+
+static
+void
+binder_display_luna_error(
+    const char* what,
+    LSError* error)
+{
+    ofono_error("%s failed: %s", what, error->message ? error->message : "?");
+    LSErrorFree(error);
+}
+
+static
+void
+binder_display_luna_cancel_call(
+    BinderDisplayBackend* self)
+{
+    if (self->call != LSMESSAGE_TOKEN_INVALID) {
+        LSError error;
+
+        LSErrorInit(&error);
+        if (!LSCallCancel(self->handle, self->call, &error)) {
+            LSErrorFree(&error);
+        }
+        self->call = LSMESSAGE_TOKEN_INVALID;
+    }
+}
+
+static
+BINDER_DISPLAY_LUNA_STATE
+binder_display_luna_parse(
+    const char* payload)
+{
+    BINDER_DISPLAY_LUNA_STATE state = LUNA_DISPLAY_IGNORE;
+    json_object* root = payload ? json_tokener_parse(payload) : NULL;
+
+    if (root && json_object_is_type(root, json_type_object)) {
+        json_object* value;
+
+        if (json_object_object_get_ex(root, "returnValue", &value) &&
+            !json_object_get_boolean(value)) {
+            DBG("%s", payload);
+            state = LUNA_DISPLAY_INVALID;
+        } else if (json_object_object_get_ex(root, "state", &value) &&
+            json_object_is_type(value, json_type_string)) {
+            const char* s = json_object_get_string(value);
+
+            if (!strcmp(s, "off")) {
+                state = LUNA_DISPLAY_OFF;
+            } else if (!strcmp(s, "on") || !strcmp(s, "dimmed")) {
+                state = LUNA_DISPLAY_ON;
+            }
+        } else if (json_object_object_get_ex(root, "event", &value) &&
+            json_object_is_type(value, json_type_string)) {
+            const char* e = json_object_get_string(value);
+
+            if (!strcmp(e, "displayOff")) {
+                state = LUNA_DISPLAY_OFF;
+            } else if (!strcmp(e, "displayOn") ||
+                !strcmp(e, "displayDimmed")) {
+                state = LUNA_DISPLAY_ON;
+            }
+        }
+    }
+    if (root) {
+        json_object_put(root);
+    }
+    return state;
+}
+
+static
+bool
+binder_display_luna_status_cb(
+    LSHandle* handle,
+    LSMessage* message,
+    void* user_data)
+{
+    BinderDisplayBackend* self = user_data;
+
+    switch (binder_display_luna_parse(LSMessageGetPayload(message))) {
+    case LUNA_DISPLAY_ON:
+        self->callback(TRUE, TRUE, self->user_data);
+        break;
+    case LUNA_DISPLAY_OFF:
+        self->callback(TRUE, FALSE, self->user_data);
+        break;
+    case LUNA_DISPLAY_INVALID:
+        self->callback(FALSE, FALSE, self->user_data);
+        break;
+    case LUNA_DISPLAY_IGNORE:
+        break;
+    }
+    return true;
+}
+
+static
+bool
+binder_display_luna_server_status_cb(
+    LSHandle* handle,
+    const char* service,
+    bool connected,
+    void* user_data)
+{
+    BinderDisplayBackend* self = user_data;
+
+    DBG("%s %s", service, connected ? "is up" : "is gone");
+    binder_display_luna_cancel_call(self);
+    if (connected) {
+        LSError error;
+
+        LSErrorInit(&error);
+        if (!LSCall(handle, BINDER_DISPLAY_LUNA_STATUS,
+            BINDER_DISPLAY_LUNA_SUBSCRIBE, binder_display_luna_status_cb,
+            self, &self->call, &error)) {
+            self->call = LSMESSAGE_TOKEN_INVALID;
+            binder_display_luna_error("LSCall", &error);
+        }
+    } else {
+        self->callback(FALSE, FALSE, self->user_data);
+    }
+    return true;
+}
+
+static
+gboolean
+binder_display_luna_register(
+    BinderDisplayBackend* self)
+{
+    LSError error;
+    LSHandle* handle = NULL;
+
+    LSErrorInit(&error);
+    if (!LSRegister(BINDER_DISPLAY_LUNA_NAME, &handle, &error)) {
+        /* Most likely the hub isn't up yet, complain only once */
+        if (!self->register_failed) {
+            self->register_failed = TRUE;
+            binder_display_luna_error("LSRegister", &error);
+        } else {
+            LSErrorFree(&error);
+        }
+        return FALSE;
+    }
+    self->handle = handle;
+    if (!LSGmainContextAttach(handle, g_main_context_default(), &error)) {
+        binder_display_luna_error("LSGmainContextAttach", &error);
+    } else if (!LSRegisterServerStatusEx(handle, BINDER_DISPLAY_LUNA_SERVICE,
+        binder_display_luna_server_status_cb, self, &self->server_status,
+        &error)) {
+        self->server_status = NULL;
+        binder_display_luna_error("LSRegisterServerStatusEx", &error);
+    } else {
+        DBG("Watching %s", BINDER_DISPLAY_LUNA_SERVICE);
+    }
+    return TRUE;
+}
+
+static
+gboolean
+binder_display_luna_retry(
+    gpointer user_data)
+{
+    BinderDisplayBackend* self = user_data;
+
+    if (binder_display_luna_register(self)) {
+        self->retry_id = 0;
+        return G_SOURCE_REMOVE;
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+BinderDisplayBackend*
+binder_display_backend_new(
+    BinderDisplayBackendFunc callback,
+    void* user_data)
+{
+    BinderDisplayBackend* self = g_new0(BinderDisplayBackend, 1);
+
+    self->callback = callback;
+    self->user_data = user_data;
+    self->call = LSMESSAGE_TOKEN_INVALID;
+    if (!binder_display_luna_register(self)) {
+        self->retry_id = g_timeout_add(binder_display_luna_retry_ms,
+            binder_display_luna_retry, self);
+    }
+    return self;
+}
+
+void
+binder_display_backend_free(
+    BinderDisplayBackend* self)
+{
+    if (self) {
+        if (self->retry_id) {
+            g_source_remove(self->retry_id);
+        }
+        if (self->handle) {
+            LSError error;
+
+            binder_display_luna_cancel_call(self);
+            LSErrorInit(&error);
+            if (self->server_status &&
+                !LSCancelServerStatus(self->handle, self->server_status,
+                &error)) {
+                LSErrorFree(&error);
+                LSErrorInit(&error);
+            }
+            if (!LSUnregister(self->handle, &error)) {
+                LSErrorFree(&error);
+            }
+        }
+        g_free(self);
+    }
+}
+
+/*
+ * Local Variables:
+ * mode: C
+ * c-basic-offset: 4
+ * indent-tabs-mode: nil
+ * End:
+ */

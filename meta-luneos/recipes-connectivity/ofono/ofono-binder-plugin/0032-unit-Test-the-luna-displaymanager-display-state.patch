From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] [unit] Test the luna-displaymanager display state

Fakes luna-service2 and feeds the display object what
luna-displaymanager posts, with the real json-c parsing it. Built with
LUNEOS=1 only, as it needs the luna-service2 headers.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 unit/Makefile                              |   3 +
 unit/unit_display_luna/Makefile            |   9 +
 unit/unit_display_luna/unit_display_luna.c | 559 +++++++++++++++++++++
 3 files changed, 571 insertions(+)
 create mode 100644 unit/unit_display_luna/Makefile
 create mode 100644 unit/unit_display_luna/unit_display_luna.c

diff --git a/unit/Makefile b/unit/Makefile
index 32788ec..f9e0a80 100644
--- a/unit/Makefile
+++ b/unit/Makefile
@@ -8,6 +8,9 @@ all:
 	@$(MAKE) -C unit_call_settings $*
 	@$(MAKE) -C unit_data $*
 	@$(MAKE) -C unit_display $*
+ifeq ($(LUNEOS),1)
+	@$(MAKE) -C unit_display_luna $*
+endif
 	@$(MAKE) -C unit_ext_call $*
 	@$(MAKE) -C unit_ext_ims $*
 	@$(MAKE) -C unit_ext_plugin $*
diff --git a/unit/unit_display_luna/Makefile b/unit/unit_display_luna/Makefile
new file mode 100644
index 0000000..71fb920
--- /dev/null
+++ b/unit/unit_display_luna/Makefile
@@ -0,0 +1,9 @@
+# -*- Mode: makefile-gmake -*-
+
+# luna-service2 is faked, only its headers are needed
+PKGS += luna-service2
+LINK_PKGS += json-c
+
+EXE = unit_display_luna
+
+include ../common/Makefile
diff --git a/unit/unit_display_luna/unit_display_luna.c b/unit/unit_display_luna/unit_display_luna.c
new file mode 100644
index 0000000..224dcae
--- /dev/null
+++ b/unit/unit_display_luna/unit_display_luna.c
@@ -0,0 +1,559 @@
+/*
+ *  oFono - Open Source Telephony - binder based adaptation
+ *
+ *  Copyright (C) 2026 Herman van Hazendonk <github.com@herrie.org>
+ *
+ *  This program is free software; you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License version 2 as
+ *  published by the Free Software Foundation.
+ *
+ *  This program is distributed in the hope that it will be useful,
+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ *  GNU General Public License for more details.
+ */
+
+/*
+ * The display state from luna-displaymanager (LUNEOS=1). luna-service2
+ * is faked; json-c is the real one, so the payloads are parsed as they
+ * would be on the phone. A fake LSMessage is its payload string.
+ */
+
+#include "binder_display.c"
+#include "binder_display_luna.c"
+
+#include <gutil_log.h>
+
+GLOG_MODULE_DEFINE("unit_display_luna");
+
+#define TEST_(t) "/display_luna/" t
+
+static struct test_luna {
+    int register_fail;      /* How many LSRegister calls fail */
+    gboolean attach_fail;
+    gboolean call_fail;
+    int registered;
+    int unregistered;
+    gboolean attached_default;
+    char* status_service;
+    LSServerStatusFunc status_fn;
+    void* status_ctx;
+    int status_cancelled;
+    char* call_uri;
+    char* call_payload;
+    LSFilterFunc call_fn;
+    void* call_ctx;
+    int calls;
+    LSMessageToken last_token;
+    LSMessageToken cancelled_token;
+    int errors_init;
+    int errors_freed;
+} test;
+
+static int test_cookie;
+
+#define TEST_HANDLE ((LSHandle*)&test)
+
+/*==========================================================================*
+ * Stubs and fake luna-service2
+ *==========================================================================*/
+
+void ofono_debug(const char* format, ...) {}
+void ofono_error(const char* format, ...) {}
+
+static
+bool
+test_fail(
+    LSError* error,
+    const char* message)
+{
+    error->message = g_strdup(message);
+    return false;
+}
+
+bool
+LSErrorInit(
+    LSError* error)
+{
+    memset(error, 0, sizeof(*error));
+    test.errors_init++;
+    return true;
+}
+
+void
+LSErrorFree(
+    LSError* error)
+{
+    g_assert(error->message);
+    g_free(error->message);
+    error->message = NULL;
+    test.errors_freed++;
+}
+
+bool
+LSRegister(
+    const char* name,
+    LSHandle** sh,
+    LSError* error)
+{
+    g_assert_cmpstr(name, == ,BINDER_DISPLAY_LUNA_NAME);
+    if (test.register_fail > 0) {
+        test.register_fail--;
+        return test_fail(error, "No hub");
+    }
+    test.registered++;
+    *sh = TEST_HANDLE;
+    return true;
+}
+
+bool
+LSGmainContextAttach(
+    LSHandle* sh,
+    GMainContext* context,
+    LSError* error)
+{
+    g_assert(sh == TEST_HANDLE);
+    test.attached_default = (context == g_main_context_default());
+    return test.attach_fail ? test_fail(error, "Attach failed") : true;
+}
+
+bool
+LSRegisterServerStatusEx(
+    LSHandle* sh,
+    const char* service,
+    LSServerStatusFunc fn,
+    void* ctx,
+    void** cookie,
+    LSError* error)
+{
+    g_assert(sh == TEST_HANDLE);
+    g_free(test.status_service);
+    test.status_service = g_strdup(service);
+    test.status_fn = fn;
+    test.status_ctx = ctx;
+    *cookie = &test_cookie;
+    return true;
+}
+
+bool
+LSCancelServerStatus(
+    LSHandle* sh,
+    void* cookie,
+    LSError* error)
+{
+    g_assert(sh == TEST_HANDLE);
+    g_assert(cookie == &test_cookie);
+    test.status_cancelled++;
+    return true;
+}
+
+bool
+LSCall(
+    LSHandle* sh,
+    const char* uri,
+    const char* payload,
+    LSFilterFunc fn,
+    void* ctx,
+    LSMessageToken* token,
+    LSError* error)
+{
+    g_assert(sh == TEST_HANDLE);
+    test.calls++;
+    if (test.call_fail) {
+        return test_fail(error, "Call failed");
+    }
+    g_free(test.call_uri);
+    g_free(test.call_payload);
+    test.call_uri = g_strdup(uri);
+    test.call_payload = g_strdup(payload);
+    test.call_fn = fn;
+    test.call_ctx = ctx;
+    *token = ++test.last_token;
+    return true;
+}
+
+bool
+LSCallCancel(
+    LSHandle* sh,
+    LSMessageToken token,
+    LSError* error)
+{
+    g_assert(sh == TEST_HANDLE);
+    g_assert(token != LSMESSAGE_TOKEN_INVALID);
+    test.cancelled_token = token;
+    return true;
+}
+
+bool
+LSUnregister(
+    LSHandle* sh,
+    LSError* error)
+{
+    g_assert(sh == TEST_HANDLE);
+    test.unregistered++;
+    return true;
+}
+
+const char*
+LSMessageGetPayload(
+    LSMessage* message)
+{
+    return (const char*)message;
+}
+
+/*==========================================================================*
+ * Common
+ *==========================================================================*/
+
+static
+void
+test_start(
+    void)
+{
+    memset(&test, 0, sizeof(test));
+}
+
+static
+void
+test_finish(
+    void)
+{
+    g_free(test.status_service);
+    g_free(test.call_uri);
+    g_free(test.call_payload);
+    g_assert(!binder_display_instance);
+}
+
+static
+void
+test_server(
+    gboolean up)
+{
+    g_assert(test.status_fn);
+    g_assert(test.status_fn(TEST_HANDLE, BINDER_DISPLAY_LUNA_SERVICE, up,
+        test.status_ctx));
+}
+
+static
+void
+test_reply(
+    const char* payload)
+{
+    g_assert(test.call_fn);
+    g_assert(test.call_fn(TEST_HANDLE, (LSMessage*)payload, test.call_ctx));
+}
+
+static
+void
+test_count_cb(
+    BinderDisplay* display,
+    BINDER_DISPLAY_PROPERTY property,
+    void* user_data)
+{
+    (*(int*)user_data)++;
+}
+
+static
+BinderDisplay*
+test_display_off(
+    void)
+{
+    BinderDisplay* display = binder_display_new();
+
+    test_server(TRUE);
+    test_reply("{\"returnValue\":true,\"event\":\"request\",\"state\":\"off\","
+        "\"subscribed\":true}");
+    g_assert(!display->on);
+    return display;
+}
+
+/*==========================================================================*
+ * Tests
+ *==========================================================================*/
+
+static
+void
+test_register(
+    void)
+{
+    BinderDisplay* display;
+
+    test_start();
+    display = binder_display_new();
+    g_assert_cmpint(test.registered, == ,1);
+    g_assert(test.attached_default);
+    g_assert_cmpstr(test.status_service, == ,"com.palm.display");
+    g_assert_cmpint(test.calls, == ,0);
+    /* Not known yet: on */
+    g_assert(display->on);
+
+    test_server(TRUE);
+    g_assert_cmpint(test.calls, == ,1);
+    g_assert_cmpstr(test.call_uri, == ,"luna://com.palm.display/status");
+    g_assert_cmpstr(test.call_payload, == ,"{\"subscribe\":true}");
+
+    binder_display_unref(display);
+    g_assert_cmpint(test.cancelled_token, == ,test.last_token);
+    g_assert_cmpint(test.status_cancelled, == ,1);
+    g_assert_cmpint(test.unregistered, == ,1);
+    test_finish();
+}
+
+/* What luna-displaymanager posts on luna://com.palm.display/status */
+static
+void
+test_events(
+    void)
+{
+    BinderDisplay* display;
+    gulong id[1];
+    int n = 0;
+
+    test_start();
+    display = binder_display_new();
+    id[0] = binder_display_add_property_handler(display,
+        BINDER_DISPLAY_PROPERTY_ON, test_count_cb, &n);
+    test_server(TRUE);
+
+    test_reply("{\"returnValue\":true,\"event\":\"request\",\"state\":\"off\","
+        "\"subscribed\":true}");
+    g_assert(!display->on);
+    g_assert_cmpint(n, == ,1);
+    /* Dimmed is on */
+    test_reply("{\"returnValue\":true,\"event\":\"displayDimmed\"}");
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,2);
+    test_reply("{\"returnValue\":true,\"event\":\"displayOn\"}");
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,2);
+    test_reply("{\"returnValue\":true,\"event\":\"displayOff\"}");
+    g_assert(!display->on);
+    g_assert_cmpint(n, == ,3);
+    test_reply("{\"returnValue\":true,\"event\":\"displayOn\","
+        "\"dockMode\":true}");
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,4);
+    test_reply("{\"returnValue\":true,\"event\":\"displayOff\"}");
+    g_assert(!display->on);
+    g_assert_cmpint(n, == ,5);
+    test_reply("{\"returnValue\":true,\"event\":\"request\","
+        "\"state\":\"dimmed\"}");
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,6);
+    test_reply("{\"returnValue\":true,\"event\":\"request\","
+        "\"state\":\"on\"}");
+    g_assert(display->on);
+    g_assert_cmpint(n, == ,6);
+
+    binder_display_remove_all_handlers(display, id);
+    binder_display_unref(display);
+    test_finish();
+}
+
+/* Replies that say nothing about on or off change nothing */
+static
+void
+test_ignore(
+    void)
+{
+    static const char* payloads[] = {
+        "{\"returnValue\":true,\"event\":\"changedTimeout\",\"timeout\":30}",
+        "{\"returnValue\":true,\"event\":\"blockedDisplay\"}",
+        "{\"returnValue\":true,\"event\":\"unblockedDisplay\"}",
+        "{\"returnValue\":true,\"event\":\"displayActive\"}",
+        "{\"returnValue\":true,\"event\":\"displayInactive\"}",
+        "{\"returnValue\":true,\"state\":\"unknown\"}",
+        "{\"returnValue\":true,\"state\":1}",
+        "{\"returnValue\":true,\"event\":7}",
+        "{\"returnValue\":true}",
+        "{}",
+        "[]",
+        "\"displayOn\"",
+        "{",
+        "",
+        NULL
+    };
+    BinderDisplay* display;
+    gulong id[1];
+    guint i;
+    int n = 0;
+
+    test_start();
+    display = test_display_off();
+    id[0] = binder_display_add_property_handler(display,
+        BINDER_DISPLAY_PROPERTY_ON, test_count_cb, &n);
+    for (i = 0; i < G_N_ELEMENTS(payloads); i++) {
+        test_reply(payloads[i]);
+        g_assert(!display->on);
+    }
+    g_assert_cmpint(n, == ,0);
+    binder_display_remove_all_handlers(display, id);
+    binder_display_unref(display);
+    test_finish();
+}
+
+/* An error reply, say the permission is missing: the state isn't known */
+static
+void
+test_error(
+    void)
+{
+    BinderDisplay* display;
+
+    test_start();
+    display = test_display_off();
+    test_reply("{\"returnValue\":false,\"errorCode\":-1,"
+        "\"errorText\":\"Not permitted\"}");
+    g_assert(display->on);
+    binder_display_unref(display);
+    test_finish();
+}
+
+/* luna-displaymanager goes away and comes back */
+static
+void
+test_restart(
+    void)
+{
+    BinderDisplay* display;
+    LSMessageToken token;
+
+    test_start();
+    display = test_display_off();
+    token = test.last_token;
+    test_server(FALSE);
+    g_assert(display->on);
+    g_assert_cmpint(test.cancelled_token, == ,token);
+
+    test_server(TRUE);
+    g_assert_cmpint(test.calls, == ,2);
+    g_assert_cmpint(test.last_token, != ,token);
+    test_reply("{\"returnValue\":true,\"event\":\"request\","
+        "\"state\":\"off\"}");
+    g_assert(!display->on);
+    binder_display_unref(display);
+    g_assert_cmpint(test.cancelled_token, == ,test.last_token);
+    test_finish();
+}
+
+static
+gboolean
+test_timeout(
+    gpointer data)
+{
+    g_assert_not_reached();
+    return G_SOURCE_REMOVE;
+}
+
+/* The hub isn't up yet when ofonod starts */
+static
+void
+test_retry(
+    void)
+{
+    BinderDisplay* display;
+    guint timeout;
+
+    test_start();
+    binder_display_luna_retry_ms = 10;
+    test.register_fail = 2;
+    display = binder_display_new();
+    g_assert_cmpint(test.registered, == ,0);
+    g_assert(display->on);
+
+    timeout = g_timeout_add_seconds(5, test_timeout, NULL);
+    while (!test.registered) {
+        g_main_context_iteration(NULL, TRUE);
+    }
+    g_source_remove(timeout);
+    g_assert_cmpint(test.register_fail, == ,0);
+    g_assert_cmpstr(test.status_service, == ,"com.palm.display");
+    binder_display_unref(display);
+    g_assert_cmpint(test.unregistered, == ,1);
+    g_assert_cmpint(test.errors_freed, == ,2);
+    test_finish();
+}
+
+/* Freed while still waiting for the hub */
+static
+void
+test_free_waiting(
+    void)
+{
+    BinderDisplay* display;
+
+    test_start();
+    binder_display_luna_retry_ms = 10;
+    test.register_fail = 1000;
+    display = binder_display_new();
+    binder_display_unref(display);
+    /* The retry timer is gone with it: nothing to run once it's due */
+    g_usleep(30000);
+    g_assert(!g_main_context_iteration(NULL, FALSE));
+    g_assert_cmpint(test.unregistered, == ,0);
+    test_finish();
+}
+
+static
+void
+test_attach_fail(
+    void)
+{
+    BinderDisplay* display;
+
+    test_start();
+    test.attach_fail = TRUE;
+    display = binder_display_new();
+    g_assert(!test.status_fn);
+    g_assert(display->on);
+    binder_display_unref(display);
+    g_assert_cmpint(test.status_cancelled, == ,0);
+    g_assert_cmpint(test.unregistered, == ,1);
+    g_assert_cmpint(test.errors_freed, == ,1);
+    test_finish();
+}
+
+static
+void
+test_call_fail(
+    void)
+{
+    BinderDisplay* display;
+
+    test_start();
+    test.call_fail = TRUE;
+    display = binder_display_new();
+    test_server(TRUE);
+    g_assert(display->on);
+    binder_display_unref(display);
+    g_assert_cmpint(test.cancelled_token, == ,LSMESSAGE_TOKEN_INVALID);
+    g_assert_cmpint(test.unregistered, == ,1);
+    g_assert_cmpint(test.errors_freed, == ,1);
+    test_finish();
+}
+
+int main(int argc, char* argv[])
+{
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+    gutil_log_timestamp = FALSE;
+    g_test_add_func(TEST_("register"), test_register);
+    g_test_add_func(TEST_("events"), test_events);
+    g_test_add_func(TEST_("ignore"), test_ignore);
+    g_test_add_func(TEST_("error"), test_error);
+    g_test_add_func(TEST_("restart"), test_restart);
+    g_test_add_func(TEST_("retry"), test_retry);
+    g_test_add_func(TEST_("free_waiting"), test_free_waiting);
+    g_test_add_func(TEST_("attach_fail"), test_attach_fail);
+    g_test_add_func(TEST_("call_fail"), test_call_fail);
+    return g_test_run();
+}
+
+/*
+ * Local Variables:

From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] [unit] Test the APN types of the XCAP data profile

The XCAP data profile goes to the modem as an XCAP access point only,
while any other OEM profile id is still taken as the default one.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 unit/unit_util/unit_util.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/unit/unit_util/unit_util.c b/unit/unit_util/unit_util.c
index 8fa74d6..f0c3884 100644
--- a/unit/unit_util/unit_util.c
+++ b/unit/unit_util/unit_util.c
@@ -272,6 +272,36 @@ test_strv_from_hidl_link_address_vec(
  *==========================================================================*/
 
 #define TEST_PREFIX "/util/"
+/*==========================================================================*
+ * apn_types_for_profile
+ *==========================================================================*/
+
+static
+void
+test_apn_types_for_profile(
+    void)
+{
+    BinderDataProfileConfig dpc;
+
+    memset(&dpc, 0, sizeof(dpc));
+    dpc.default_profile_id = RADIO_DATA_PROFILE_DEFAULT;
+    dpc.mms_profile_id = RADIO_DATA_PROFILE_DEFAULT;
+
+    /* The XCAP access point goes to the modem as an XCAP one only */
+    g_assert_cmpint(binder_radio_apn_types_for_profile(
+        BINDER_DATA_PROFILE_XCAP, &dpc), ==, RADIO_APN_TYPE_XCAP);
+
+    /* Other OEM profiles are still taken as the default access point */
+    g_assert_cmpint(binder_radio_apn_types_for_profile(
+        RADIO_DATA_PROFILE_OEM_BASE + 1, &dpc), ==,
+        RADIO_APN_TYPE_DEFAULT | RADIO_APN_TYPE_SUPL | RADIO_APN_TYPE_IA);
+    g_assert_cmpint(binder_radio_apn_types_for_profile(
+        RADIO_DATA_PROFILE_IMS, &dpc), ==, RADIO_APN_TYPE_IMS);
+    g_assert_cmpint(binder_radio_apn_types_for_profile(
+        RADIO_DATA_PROFILE_DEFAULT, &dpc), ==, RADIO_APN_TYPE_DEFAULT |
+        RADIO_APN_TYPE_SUPL | RADIO_APN_TYPE_IA | RADIO_APN_TYPE_MMS);
+}
+
 #define TEST_(t) TEST_PREFIX t
 
 /*==========================================================================*
@@ -298,6 +328,8 @@ int main(int argc, char* argv[])
 {
     g_test_init(&argc, &argv, NULL);
     g_test_add_func(TEST_("default_ims_context"), test_default_ims_context);
+    g_test_add_func(TEST_("apn_types_for_profile"),
+        test_apn_types_for_profile);
     g_test_add_func(TEST_("array_count"), test_array_count);
     g_test_add_func(TEST_("copy_hidl_string"), test_copy_hidl_string);
     g_test_add_func(TEST_("strv_from_hidl_link_address_vec"),

From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] [ofono-binder] Keep the IMS atom while the modem is offline

The IMS atom was made in post_online, so airplane mode removed it with
the radio. A MediaTek modem keeps IMS registered over Wi-Fi then, and
oFono could no longer tell, nor call or text over it.

Make it in post_sim, next to SMS, so it stays while offline. It still
goes with the SIM, and asks for registration once it is made, as before.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/binder_modem.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/binder_modem.c b/src/binder_modem.c
index 169a254..694dd7c 100644
--- a/src/binder_modem.c
+++ b/src/binder_modem.c
@@ -318,6 +318,10 @@ binder_modem_post_sim(
     if (features & BINDER_FEATURE_SMS) {
         ofono_sms_create(ofono, 0, BINDER_DRIVER, ofono);
     }
+    /* Not post_online: IMS may stay up over Wi-Fi with the radio off */
+    if (features & BINDER_FEATURE_IMS) {
+        ofono_ims_create(ofono, 0, BINDER_DRIVER, ofono);
+    }
     if (features & BINDER_FEATURE_DATA) {
         gprs = ofono_gprs_create(ofono, 0, BINDER_DRIVER, ofono);
         if (gprs) {
@@ -380,9 +384,6 @@ binder_modem_post_online(
     if (features & BINDER_FEATURE_USSD) {
         ofono_ussd_create(ofono, 0, BINDER_DRIVER, ofono);
     }
-    if (features & BINDER_FEATURE_IMS) {
-        ofono_ims_create(ofono, 0, BINDER_DRIVER, ofono);
-    }
     ofono_netmon_create(ofono, 0, "cellinfo", ofono);
 }
 

+/*==========================================================================*
+ * Timers. Only the ones that binder_voicecall.c starts.
+ *==========================================================================*/
+
+guint
+test_timeout_add(
+    guint interval,
+    GSourceFunc func,
+    gpointer data)
+{
+    TestTimer* timer = g_new0(TestTimer, 1);
+
+    timer->id = ++test.last_timer_id;
+    timer->interval = interval;
+    timer->func = func;
+    timer->data = data;
+    test.timers = g_slist_append(test.timers, timer);
+    return timer->id;
+}
+
+gboolean
+test_source_remove(
+    guint id)
+{
+    GSList* l;
+
+    for (l = test.timers; l; l = l->next) {
+        TestTimer* timer = l->data;
+
+        if (timer->id == id) {
+            g_free(timer);
+            test.timers = g_slist_delete_link(test.timers, l);
+            return TRUE;
+        }
+    }
+    /* Zero is fine, anything else would be a timer that's gone already */
+    g_assert_cmpuint(id, == , 0);
+    return FALSE;
+}
+
+static
+void
+test_fire_timer(
+    void)
+{
+    TestTimer* timer;
+    GSourceFunc func;
+    gpointer data;
+
+    g_assert_cmpuint(g_slist_length(test.timers), == , 1);
+    timer = test.timers->data;
+    func = timer->func;
+    data = timer->data;
+    g_free(timer);
+    test.timers = g_slist_delete_link(test.timers, test.timers);
+    g_assert(func(data) == G_SOURCE_REMOVE);
+}
+
+/*==========================================================================*
+ * Common test steps
+ *==========================================================================*/
+
+static
+void
+test_cb(
+    const struct ofono_error* error,
+    void* data)
+{
+    if (error->type == OFONO_ERROR_TYPE_NO_ERROR) {
+        test.cb_ok++;
+    } else {
+        test.cb_failed++;
+    }
+}
+
+static
+void
+test_respond(
+    RadioRequest* req,
+    RADIO_TX_STATUS status,
+    RADIO_RESP resp,
+    RADIO_ERROR error)
+{
+    RadioRequestCompleteFunc complete = req->complete;
+
+    g_assert(g_slist_find(test.pending, req));
+    test.pending = g_slist_remove(test.pending, req);
+    if (complete) {
+        complete(req, status, resp, error, NULL, req->user_data);
+    }
+    test_request_unref(req);
+}
+
+/* The response to a request which is known to be pending */
+static
+void
+test_respond_ok(
+    guint32 code)
+{
+    RadioRequest* req = test_find_pending(code);
+    RADIO_RESP resp = RADIO_RESP_NONE; /* The driver only looks at these: */
+
+    g_assert(req);
+    switch (code) {
+    case RADIO_REQ_GET_CURRENT_CALLS:
+        resp = RADIO_RESP_GET_CURRENT_CALLS;
+        break;
+    case RADIO_REQ_DIAL:
+        resp = RADIO_RESP_DIAL;
+        break;
+    case RADIO_REQ_SEND_DTMF:
+        resp = RADIO_RESP_SEND_DTMF;
+        break;
+    default:
+        break;
+    }
+    test_respond(req, RADIO_TX_STATUS_OK, resp, RADIO_ERROR_NONE);
+}
+
+static
+void
+test_answer_poll(
+    void)
+{
+    test_respond_ok(RADIO_REQ_GET_CURRENT_CALLS);
+}
+
+/* Failing the cause lookup is the shortest way to finish a disconnect */
+static
+void
+test_fail_last_cause(
+    void)
+{
+    RadioRequest* req = test_find_pending(RADIO_REQ_GET_LAST_CALL_FAIL_CAUSE);
+
+    if (req) {
+        test_respond(req, RADIO_TX_STATUS_FAILED, RADIO_RESP_NONE,
+            RADIO_ERROR_NONE);
+    }
+}
+
+static
+void
+test_state_changed(
+    void)
+{
+    test.state_changed(&test.client, RADIO_IND_CALL_STATE_CHANGED, NULL,
+        test.state_changed_data);
+}
+
+static
+void
+test_start(
+    void)
+{
+    memset(&test, 0, sizeof(test));
+    test.vc = (struct ofono_voicecall*) &test;
+    test.ofono = (struct ofono_modem*) &test;
+    test.modem.instance = &test.instance;
+    test.modem.voice_client = &test.client;
+    test.modem.network_client = &test.client;
+    test.modem.log_prefix = "";
+    binder_voicecall_init();
+    g_assert(test.driver);
+    g_assert_cmpint(test.driver->probe(test.vc, 0, test.ofono), == , 0);
+    while (g_main_context_iteration(NULL, FALSE));
+    g_assert(test.state_changed);
+
+    /* The driver asks for the call list when it starts */
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    test.polls = 0;
+}
+
+static
+void
+test_finish(
+    void)
+{
+    test.driver->remove(test.vc);
+
+    /* Whatever the test was doing, nothing is left behind */
+    g_assert(!test.pending);
+    g_assert(!test.timers);
+    g_assert(!test.vc_data);
+    g_assert_cmpuint(test.hangup_all, == , 0);
+    binder_voicecall_cleanup();
+    g_slist_free_full(test.allocs, g_free);
+}
+
+/* Call 1 is active, call 2 is held, and oFono knows it */
+static
+void
+test_start_two_calls(
+    void)
+{
+    test_start();
+    test_set_call(0, 1, RADIO_CALL_ACTIVE);
+    test_set_call(1, 2, RADIO_CALL_HOLDING);
+    test_state_changed();
+    test_answer_poll();
+    g_assert_cmpuint(test.notified, == , 2);
+    test.polls = test.notified = 0;
+    g_assert(!test.pending);
+    g_assert(!test.timers);
+}
+
+/*
+ * The swap as it happened at 15:06:54 on 2026-10-31. Call 1 is put on hold
+ * first, the RIL says that the calls have changed, and it takes a moment
+ * for the other call to come out of hold.
+ */
+static
+void
+test_swap_half_way(
+    void)
+{
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+    g_assert(test_find_pending(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE));
+    test_set_state(0, RADIO_CALL_HOLDING);
+    test_state_changed();
+}
+
+static
+void
+test_swap_done(
+    void)
+{
+    test_set_state(1, RADIO_CALL_ACTIVE);
+}
+
+/*==========================================================================*
+ * swap: the poll waits for the response
+ *==========================================================================*/
+
+static
+void
+test_swap(
+    void)
+{
+    test_start_two_calls();
+    test_swap_half_way();
+
+    /* Asking now would get both calls killed. Not asking does no harm. */
+    g_assert_cmpuint(test.polls_in_op, == , 0);
+    g_assert_cmpuint(test.hangup_all, == , 0);
+    g_assert_cmpuint(test.polls, == , 0);
+    g_assert(test.timers);
+
+    /* The second call comes back, and another notification comes with it */
+    test_swap_done();
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 0);
+
+    /* Then one poll and only one, and before the core hears about it */
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert(!test.timers);
+
+    test_answer_poll();
+    g_assert_cmpuint(test.hangup_all, == , 0);
+    g_assert_cmpuint(test.notified, == , 2);
+    g_assert_cmpuint(test.polls, == , 1);
+    test_finish();
+}
+
+/*==========================================================================*
+ * swap_failed: a RIL error ends the wait just the same
+ *==========================================================================*/
+
+static
+void
+test_swap_failed(
+    void)
+{
+    RadioRequest* req;
+
+    test_start_two_calls();
+    test_swap_half_way();
+    req = test_find_pending(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert(req);
+
+    /* It didn't work, the first call goes back to where it was */
+    test_set_state(0, RADIO_CALL_ACTIVE);
+    test_respond(req, RADIO_TX_STATUS_OK, RADIO_RESP_NONE,
+        RADIO_ERROR_GENERIC_FAILURE);
+    g_assert_cmpuint(test.cb_failed, == , 1);
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert(!test.timers);
+
+    test_answer_poll();
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 2);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * swap_tx_failed: so does a failed transaction or the radio's own timeout
+ *==========================================================================*/
+
+static
+void
+test_swap_tx_status(
+    gconstpointer data)
+{
+    RadioRequest* req;
+
+    test_start_two_calls();
+    test_swap_half_way();
+    test_swap_done();
+    req = test_find_pending(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert(req);
+
+    /* A dead radio fails the requests that it still has this way */
+    test_respond(req, GPOINTER_TO_INT(data), RADIO_RESP_NONE, RADIO_ERROR_NONE);
+    g_assert_cmpuint(test.cb_failed, == , 1);
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert(!test.timers);
+
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * swap_no_answer: polling can't stall
+ *==========================================================================*/
+
+static
+void
+test_swap_no_answer(
+    void)
+{
+    test_start_two_calls();
+    test_swap_done();                  /* The modem isn't half way here */
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 0);
+
+    /* A ring shouldn't wait forever, and much less than the radio's 30s */
+    g_assert_cmpuint(g_slist_length(test.timers), == , 1);
+    g_assert_cmpuint(((TestTimer*)test.timers->data)->interval, <= , 5000);
+    test_fire_timer();
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+
+    /* From now on notifications work as usual */
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 2);
+    test_answer_poll();
+
+    /* The late response is still welcome */
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert_cmpuint(test.polls, == , 3);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * swap_no_answer_quiet: nobody wanted a poll, so none goes out on timeout
+ *==========================================================================*/
+
+static
+void
+test_swap_no_answer_quiet(
+    void)
+{
+    test_start_two_calls();
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+
+    /* Could be a slow network and the modem may be half way by now */
+    test_fire_timer();
+    g_assert_cmpuint(test.polls, == , 0);
+
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * late_response: one that timed out doesn't cut the next one short
+ *==========================================================================*/
+
+static
+void
+test_late_response(
+    void)
+{
+    RadioRequest* first;
+
+    test_start_two_calls();
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+    first = test_find_pending(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    test_fire_timer();
+
+    /* The next swap is under way when the first one finally gets through */
+    test_swap_half_way();
+    test_respond(first, RADIO_TX_STATUS_OK, RADIO_RESP_NONE, RADIO_ERROR_NONE);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 0);
+    g_assert_cmpuint(test.hangup_all, == , 0);
+
+    test_swap_done();
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.cb_ok, == , 2);
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * mpty: the RIL treats a held conference and a held call the same way
+ *==========================================================================*/
+
+static
+void
+test_mpty(
+    void)
+{
+    test_start();
+    test_set_call(0, 1, RADIO_CALL_HOLDING);
+    test.calls[0].isMpty = TRUE;
+    test_set_call(1, 2, RADIO_CALL_HOLDING);
+    test.calls[1].isMpty = TRUE;
+    test_set_call(2, 3, RADIO_CALL_ACTIVE);
+    test_state_changed();
+    test_answer_poll();
+    test.polls = 0;
+
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+    test_set_state(2, RADIO_CALL_HOLDING);
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 0);
+    test_set_state(0, RADIO_CALL_ACTIVE);
+    test_set_state(1, RADIO_CALL_ACTIVE);
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * poll_in_flight: a poll sent just before the operation is replaced
+ *==========================================================================*/
+
+static
+void
+test_poll_in_flight(
+    void)
+{
+    test_start_two_calls();
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert(test_find_pending(RADIO_REQ_GET_CURRENT_CALLS));
+
+    /* It may be waiting to retry, and that could happen at any time */
+    test_swap_half_way();
+    g_assert(!test_find_pending(RADIO_REQ_GET_CURRENT_CALLS));
+
+    test_swap_done();
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.polls, == , 2);
+    test_answer_poll();
+    g_assert_cmpuint(test.notified, == , 2);
+    test_finish();
+}
+
+/*==========================================================================*
+ * submit_failed: nothing to wait for
+ *==========================================================================*/
+
+static
+void
+test_submit_failed(
+    void)
+{
+    test_start_two_calls();
+    test.submit_fails = TRUE;
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+    test.submit_fails = FALSE;
+    g_assert(!test.timers);
+
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * hangup_all: several requests for one operation
+ *==========================================================================*/
+
+static
+void
+test_hangup_all(
+    void)
+{
+    RadioRequest* first;
+    RadioRequest* second;
+
+    test_start_two_calls();
+    test.driver->hangup_all(test.vc, test_cb, NULL);
+    first = test_find_pending(RADIO_REQ_HANGUP);
+    g_assert(first);
+    second = g_slist_last(test.pending)->data;
+    g_assert(first != second);
+    g_assert_cmpuint(second->code, == , RADIO_REQ_HANGUP);
+
+    test_state_changed();
+    test_respond(first, RADIO_TX_STATUS_OK, RADIO_RESP_NONE, RADIO_ERROR_NONE);
+    g_assert_cmpuint(test.polls, == , 0);
+    g_assert(test.timers);
+    g_assert_cmpuint(test.cb_ok, == , 0);
+
+    test.call_count = 0;
+    test_respond(second, RADIO_TX_STATUS_OK, RADIO_RESP_NONE, RADIO_ERROR_NONE);
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert(!test.timers);
+
+    test_answer_poll();
+    g_assert_cmpuint(test.disconnected, == , 2);
+    g_assert(!test_find_pending(RADIO_REQ_GET_LAST_CALL_FAIL_CAUSE));
+    test_finish();
+}
+
+/*==========================================================================*
+ * hangup_all_slow: each new request gets the whole timeout
+ *==========================================================================*/
+
+static
+void
+test_hangup_all_slow(
+    void)
+{
+    guint first_id;
+
+    test_start_two_calls();
+    test.driver->hangup_all(test.vc, test_cb, NULL);
+
+    /* Two hangups, one timer, the one started by the last of them */
+    g_assert_cmpuint(g_slist_length(test.timers), == , 1);
+    first_id = ((TestTimer*)test.timers->data)->id;
+    g_assert_cmpuint(first_id, == , test.last_timer_id);
+    g_assert_cmpuint(first_id, > , 1);
+
+    test_respond_ok(RADIO_REQ_HANGUP);
+    test.call_count = 0;
+    test_respond_ok(RADIO_REQ_HANGUP);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * Each of the other operations holds the polls until its response
+ *==========================================================================*/
+
+typedef struct test_op {
+    const char* name;
+    void (*start)(void);
+    guint32 code;
+} TestOp;
+
+static void test_op_answer(void)
+    { test.driver->answer(test.vc, test_cb, NULL); }
+static void test_op_hangup_active(void)
+    { test.driver->hangup_active(test.vc, test_cb, NULL); }
+static void test_op_hold(void)
+    { test.driver->hold_all_active(test.vc, test_cb, NULL); }
+static void test_op_release_held(void)
+    { test.driver->release_all_held(test.vc, test_cb, NULL); }
+static void test_op_udub(void)
+    { test.driver->set_udub(test.vc, test_cb, NULL); }
+static void test_op_release_active(void)
+    { test.driver->release_all_active(test.vc, test_cb, NULL); }
+static void test_op_release_specific(void)
+    { test.driver->release_specific(test.vc, 1, test_cb, NULL); }
+static void test_op_private_chat(void)
+    { test.driver->private_chat(test.vc, 1, test_cb, NULL); }
+static void test_op_conference(void)
+    { test.driver->create_multiparty(test.vc, test_cb, NULL); }
+static void test_op_transfer(void)
+    { test.driver->transfer(test.vc, test_cb, NULL); }
+
+static const TestOp test_ops[] = {
+    { "answer", test_op_answer, RADIO_REQ_ACCEPT_CALL },
+    { "hangup_active", test_op_hangup_active, RADIO_REQ_HANGUP },
+    { "hold", test_op_hold, RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE },
+    { "release_held", test_op_release_held,
+        RADIO_REQ_HANGUP_WAITING_OR_BACKGROUND },
+    { "udub", test_op_udub, RADIO_REQ_REJECT_CALL },
+    { "release_active", test_op_release_active,
+        RADIO_REQ_HANGUP_FOREGROUND_RESUME_BACKGROUND },
+    { "release_specific", test_op_release_specific, RADIO_REQ_HANGUP },
+    { "private_chat", test_op_private_chat, RADIO_REQ_SEPARATE_CONNECTION },
+    { "conference", test_op_conference, RADIO_REQ_CONFERENCE },
+    { "transfer", test_op_transfer, RADIO_REQ_EXPLICIT_CALL_TRANSFER }
+};
+
+static
+void
+test_op(
+    gconstpointer data)
+{
+    const TestOp* op = data;
+
+    test_start_two_calls();
+    op->start();
+    g_assert(test_find_pending(op->code));
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 0);
+    test_respond_ok(op->code);
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert(!test.timers);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * incoming: rings as soon as the RIL says so
+ *==========================================================================*/
+
+static
+void
+test_incoming(
+    void)
+{
+    test_start();
+    test_set_call(0, 1, RADIO_CALL_INCOMING);
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 1);
+    g_assert(!test.timers);
+    test_answer_poll();
+    g_assert_cmpuint(test.notified, == , 1);
+    g_assert_cmpuint(test.last_status, == , OFONO_CALL_STATUS_INCOMING);
+    test_finish();
+}
+
+/*==========================================================================*
+ * incoming_during_swap: waits for the swap, no longer
+ *==========================================================================*/
+
+static
+void
+test_incoming_during_swap(
+    void)
+{
+    test_start_two_calls();
+    test_swap_half_way();
+    test_set_call(2, 3, RADIO_CALL_WAITING);
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 0);
+
+    test_swap_done();
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    g_assert_cmpuint(test.last_id, == , 3);
+    g_assert_cmpuint(test.last_status, == , OFONO_CALL_STATUS_WAITING);
+    test_finish();
+}
+
+/*==========================================================================*
+ * incoming_no_answer: and if the swap never ends, for as long as the timeout
+ *==========================================================================*/
+
+static
+void
+test_incoming_no_answer(
+    void)
+{
+    test_start_two_calls();
+    test.driver->swap_without_accept(test.vc, test_cb, NULL);
+    test_set_call(2, 3, RADIO_CALL_WAITING);
+    test_state_changed();
+    test_fire_timer();
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    g_assert_cmpuint(test.last_id, == , 3);
+
+    /* The request is still pending and the driver just goes away */
+    test_finish();
+    g_assert_cmpuint(test.cb_ok + test.cb_failed, == , 0);
+}
+
+/*==========================================================================*
+ * dial: not an operation that polls have to wait for
+ *==========================================================================*/
+
+static
+void
+test_dial(
+    void)
+{
+    struct ofono_phone_number ph;
+
+    memset(&ph, 0, sizeof(ph));
+    test_start();
+    test.driver->dial(test.vc, &ph, OFONO_CLIR_OPTION_DEFAULT, test_cb, NULL);
+    g_assert(test_find_pending(RADIO_REQ_DIAL));
+    g_assert(!test.timers);
+
+    /* The call shows up before the response, the same as without this */
+    test_set_call(0, 1, RADIO_CALL_DIALING);
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert_cmpuint(test.last_status, == , OFONO_CALL_STATUS_DIALING);
+
+    test_respond_ok(RADIO_REQ_DIAL);
+    test_finish();
+}
+
+/*==========================================================================*
+ * dial_response_first: the response is what finds the call
+ *==========================================================================*/
+
+static
+void
+test_dial_response_first(
+    void)
+{
+    struct ofono_phone_number ph;
+
+    memset(&ph, 0, sizeof(ph));
+    test_start();
+    test.driver->dial(test.vc, &ph, OFONO_CLIR_OPTION_DEFAULT, test_cb, NULL);
+    test_set_call(0, 1, RADIO_CALL_DIALING);
+    test_respond_ok(RADIO_REQ_DIAL);
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    test_finish();
+}
+
+/*==========================================================================*
+ * dtmf: doesn't hold anything back, and isn't held back itself
+ *==========================================================================*/
+
+static
+void
+test_dtmf(
+    void)
+{
+    test_start_two_calls();
+    test.driver->send_tones(test.vc, "12", test_cb, NULL);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert(test_find_pending(RADIO_REQ_SEND_DTMF));
+    g_assert(!test.timers);
+
+    test_state_changed();
+    g_assert_cmpuint(test.polls, == , 1);
+    test_answer_poll();
+
+    /* A swap doesn't get in the way of the next tone */
+    test_swap_half_way();
+    test_respond_ok(RADIO_REQ_SEND_DTMF);
+    g_assert(test_find_pending(RADIO_REQ_SEND_DTMF));
+    test_respond_ok(RADIO_REQ_SEND_DTMF);
+    test_swap_done();
+    test_respond_ok(RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE);
+    test_answer_poll();
+    test_finish();
+}
+
+/*==========================================================================*
+ * remove_pending: the driver goes away with everything still going on
+ *==========================================================================*/
+
+static
+void
+test_remove_pending(
+    void)
+{
+    test_start_two_calls();
+    test_swap_half_way();
+    g_assert(test.timers);
+    test_set_state(0, RADIO_CALL_ACTIVE);
+    test_finish();
+}
+
+/*==========================================================================*
+ * Remote hangup: the disconnect still gets its cause
+ *==========================================================================*/
+
+static
+void
+test_remote_hangup(
+    void)
+{
+    test_start_two_calls();
+    test.call_count = 1;
+    test_state_changed();
+    test_answer_poll();
+    g_assert(test_find_pending(RADIO_REQ_GET_LAST_CALL_FAIL_CAUSE));
+    test_fail_last_cause();
+    g_assert_cmpuint(test.disconnected, == , 1);
+    test_finish();
+}
+
+/*==========================================================================*
+ * Common
+ *==========================================================================*/
+
+#define TEST_(name) "/voicecall/" name
+
+int main(int argc, char* argv[])
+{
+    char** paths = g_new0(char*, G_N_ELEMENTS(test_ops) + 1);
+    gsize i;
+    int ret;
+
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+
+    g_test_add_func(TEST_("swap"), test_swap);
+    g_test_add_func(TEST_("swap_failed"), test_swap_failed);
+    g_test_add_data_func(TEST_("swap_tx_failed"),

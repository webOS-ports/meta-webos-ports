+
+gboolean
+radio_request_submit(
+    RadioRequest* req)
+{
+    if (test.submit_fails) {
+        /*
+         * The real thing calls destroy for such a request too, which is one
+         * unref too many for BinderVoiceCallCbData. That's a separate problem
+         * from what's being tested here, so don't trip over it.
+         */
+        req->destroy = NULL;
+        return FALSE;
+    }
+    if (req->code == RADIO_REQ_GET_CURRENT_CALLS) {
+        test.polls++;
+        if (test_call_control_pending()) {
+            test.polls_in_op++;
+        }
+        test_rtc_check_calls();
+    }
+    if (req->complete) {
+        req->refcount++;
+        test.pending = g_slist_append(test.pending, req);
+    }
+    return TRUE;
+}
+
+void
+radio_request_unref(
+    RadioRequest* req)
+{
+    if (req) {
+        test_request_unref(req);
+    }
+}
+
+void
+radio_request_drop(
+    RadioRequest* req)
+{
+    if (req) {
+        GSList* l = g_slist_find(test.pending, req);
+
+        req->complete = NULL;
+        if (l) {
+            test.pending = g_slist_delete_link(test.pending, l);
+            test_request_unref(req);
+        }
+        test_request_unref(req);
+    }
+}

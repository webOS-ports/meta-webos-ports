+    const struct ofono_voicecall_driver* driver;
+    struct ofono_voicecall* vc;
+    gpointer vc_data;
+    struct ofono_modem* ofono;
+    BinderModem modem;
+    RadioClient client;
+    RadioInstance instance;
+    RadioRequestGroup group;
+    RadioClientIndicationFunc state_changed;
+    gpointer state_changed_data;
+    GSList* pending;     /* RadioRequest*, oldest first */
+    GSList* timers;      /* TestTimer* */
+    GSList* allocs;
+    guint last_timer_id;
+    gboolean submit_fails;
+
+    /* What the modem thinks */
+    RadioCall calls[TEST_MAX_CALLS];
+    guint call_count;
+
+    /* What happened */
+    guint polls;         /* getCurrentCalls requests that reached the radio */
+    guint polls_in_op;   /* Those sent during a call control request */
+    guint hangup_all;    /* Times the RIL killed all calls */
+    guint notified;      /* ofono_voicecall_notify calls */
+    guint disconnected;  /* ofono_voicecall_disconnected calls */
+    guint cb_ok;
+    guint cb_failed;
+    guint last_id;       /* In ofono_voicecall_notify */
+    int last_status;
+} TestContext;
+
+static TestContext test;
+
+static
+gboolean
+test_is_call_control(
+    guint32 code)
+{
+    switch (code) {
+    case RADIO_REQ_SWITCH_WAITING_OR_HOLDING_AND_ACTIVE:
+    case RADIO_REQ_HANGUP:
+    case RADIO_REQ_HANGUP_WAITING_OR_BACKGROUND:
+    case RADIO_REQ_HANGUP_FOREGROUND_RESUME_BACKGROUND:
+    case RADIO_REQ_ACCEPT_CALL:
+    case RADIO_REQ_CONFERENCE:
+    case RADIO_REQ_SEPARATE_CONNECTION:
+    case RADIO_REQ_EXPLICIT_CALL_TRANSFER:
+    case RADIO_REQ_REJECT_CALL:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+static
+RadioRequest*
+test_find_pending(
+    guint32 code)
+{
+    GSList* l;
+
+    for (l = test.pending; l; l = l->next) {
+        RadioRequest* req = l->data;
+
+        if (req->code == code) {
+            return req;
+        }
+    }
+    return NULL;
+}
+
+static
+guint
+test_call_control_pending(
+    void)
+{
+    guint n = 0;
+    GSList* l;
+
+    for (l = test.pending; l; l = l->next) {
+        n += test_is_call_control(((RadioRequest*)l->data)->code);
+    }
+    return n;
+}
+
+/*
+ * What libmtk-ril.so does in RtcCallController::parsePreciseCallState() to
+ * each getCurrentCalls response, whatever else is going on at the time:
+ *
+ *   if (nonMpty >= 2 || (nonMpty == 1 && mpty >= 2)) "Hangup all calls"
+ */
+static
+void
+test_rtc_check_calls(
+    void)
+{
+    guint non_mpty = 0, mpty = 0, i;
+
+    for (i = 0; i < test.call_count; i++) {
+        if (test.calls[i].state == RADIO_CALL_HOLDING) {
+            if (test.calls[i].isMpty) {
+                mpty++;
+            } else {
+                non_mpty++;
+            }
+        }
+    }
+    if (non_mpty >= 2 || (non_mpty == 1 && mpty >= 2)) {
+        test.hangup_all++;
+    }
+}
+
+static
+void
+test_set_call(
+    guint i,
+    guint id,
+    RADIO_CALL_STATE state)
+{
+    RadioCall* call = test.calls + i;
+
+    memset(call, 0, sizeof(*call));
+    call->index = id;
+    call->state = state;
+    call->isVoice = TRUE;
+    if (test.call_count <= i) {
+        test.call_count = i + 1;
+    }
+}
+
+static
+void
+test_set_state(
+    guint i,
+    RADIO_CALL_STATE state)
+{
+    test.calls[i].state = state;
+}
+
+static
+void
+test_request_unref(
+    RadioRequest* req)
+{
+    if (!--req->refcount) {
+        if (req->destroy) {
+            req->destroy(req->user_data);
+        }
+        g_free(req);
+    }
+}
+
+RadioRequest*
+radio_request_new2(
+    RadioRequestGroup* group,
+    RADIO_REQ code,
+    GBinderWriter* args,
+    RadioRequestCompleteFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    RadioRequest* req = g_new0(RadioRequest, 1);

+    test_respond(RADIO_TX_STATUS_OK, RADIO_RESP_SET_FACILITY_LOCK_FOR_APP,
+        RADIO_ERROR_NONE, 1, -1, 0);
+    test_barring_assert_asked();
+    test_finish();
+}
+
+/* A set is always sent, but one that fails changes nothing */
+static
+void
+test_cb_set_failed(
+    void)
+{
+    test_start_hidl();
+    test_barring_make_not_supported();
+    test.cb_driver->set(TEST_B, "AO", 1, "0000", BEARER_CLASS_VOICE,
+        test_set_cb, &test);
+    g_assert(test.pending);
+    test_respond(RADIO_TX_STATUS_OK, RADIO_RESP_SET_FACILITY_LOCK_FOR_APP,
+        RADIO_ERROR_REQUEST_NOT_SUPPORTED, 1, -1, 0);
+    test_barring_assert_not_asked();
+    test_finish();
+}

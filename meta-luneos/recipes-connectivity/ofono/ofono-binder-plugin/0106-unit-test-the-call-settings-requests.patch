+/* A set that worked is read back, and that must reach the modem */
+static
+void
+test_cb_set_done(
+    void)
+{
+    test_start_hidl();
+    test_barring_make_not_supported();
+    test.cb_driver->set(TEST_B, "AO", 1, "0000", BEARER_CLASS_VOICE,

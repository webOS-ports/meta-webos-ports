+/*==========================================================================*
+ * Common test steps
+ *==========================================================================*/
+
+#define TEST_S ((struct ofono_call_settings*) &test)
+#define TEST_F ((struct ofono_call_forwarding*) &test)
+#define TEST_B ((struct ofono_call_barring*) &test)
+
+static
+void
+test_start(
+    RADIO_AIDL_INTERFACE voice_aidl,
+    RADIO_AIDL_INTERFACE sim_aidl)
+{
+    memset(&test, 0, sizeof(test));
+    test.ofono = (struct ofono_modem*) &test;
+    test.voice.aidl = voice_aidl;
+    test.sim.aidl = sim_aidl;
+    test.modem.voice_client = &test.voice;
+    test.modem.sim_client = &test.sim;
+    test.modem.network_client = &test.network;
+    test.modem.sim_card = &test.card;
+    test.modem.radio = &test.radio;
+    test.modem.log_prefix = "";
+    binder_call_settings_init();
+    binder_call_forwarding_init();
+    binder_call_barring_init();
+    g_assert_cmpint(test.cs_driver->probe(TEST_S, 0, test.ofono), == , 0);
+    g_assert_cmpint(test.cf_driver->probe(TEST_F, 0, test.ofono), == , 0);
+    g_assert_cmpint(test.cb_driver->probe(TEST_B, 0, test.ofono), == , 0);
+    while (g_main_context_iteration(NULL, FALSE));
+}
+
+static
+void
+test_start_hidl(
+    void)
+{
+    test_start(RADIO_AIDL_INTERFACE_NONE, RADIO_AIDL_INTERFACE_NONE);
+}
+
+static
+void
+test_finish(
+    void)
+{
+    test.cb_driver->remove(TEST_B);
+    test.cf_driver->remove(TEST_F);
+    test.cs_driver->remove(TEST_S);
+
+    /* Whatever the test was doing, nothing is left behind */
+    g_assert(!test.pending);
+    g_assert(!test.cs_data);
+    g_assert(!test.cf_data);
+    g_assert(!test.cb_data);
+    g_assert(!test.card_app_changed);
+    g_assert(!test.radio_state_changed);
+    g_assert_cmpint(test.network.refcount, == , 0);
+    binder_call_barring_cleanup();
+    binder_call_forwarding_cleanup();
+    binder_call_settings_cleanup();
+    g_slist_free_full(test.allocs, g_free);
+}
+
+static
+void
+test_status_cb(
+    const struct ofono_error* error,
+    int status,
+    void* data)
+{
+    test.cb_value = status;
+    if (error->type == OFONO_ERROR_TYPE_NO_ERROR) {
+        test.cb_ok++;
+    } else {
+        test.cb_failed++;
+    }
+}
+
+static
+void
+test_clir_cb(
+    const struct ofono_error* error,
+    int local,
+    int remote,
+    void* data)
+{
+    test_status_cb(error, local, data);
+}
+
+static
+void
+test_set_cb(
+    const struct ofono_error* error,
+    void* data)
+{
+    test_status_cb(error, 0, data);
+}
+
+static
+void
+test_cf_query_cb(
+    const struct ofono_error* error,
+    int total,
+    const struct ofono_call_forwarding_condition* list,
+    void* data)
+{
+    test_status_cb(error, total, data);
+}
+
+/* Completes the oldest pending request */
+static
+void
+test_respond(
+    RADIO_TX_STATUS status,
+    guint32 resp,
+    RADIO_ERROR error,
+    guint count,
+    gint32 v1,
+    gint32 v2)
+{
+    RadioRequest* req;
+
+    g_assert(test.pending);
+    req = test.pending->data;
+    test.pending = g_slist_remove(test.pending, req);
+    test.reply[0] = v1;
+    test.reply[1] = v2;
+    test.reply_count = count;
+    req->complete(req, status, (RADIO_RESP) resp, error, NULL, req->user_data);
+    test_request_unref(req);
+}
+
+/*
+ * What get_query_lock_callback() in oFono's call-barring.c does: a query that
+ * failed is forgotten about and the next lock is queried, from the callback.
+ */
+static
+void
+test_barring_next_lock(
+    void);
+
+static
+void
+test_barring_lock_cb(
+    const struct ofono_error* error,
+    int status,
+    void* data)
+{
+    test_status_cb(error, status, data);
+    if (test.lock + 1 < G_N_ELEMENTS(test_locks)) {
+        test.lock++;
+        test_barring_next_lock();
+    }
+}
+
+static
+void
+test_barring_next_lock(
+    void)
+{
+    test.cb_driver->query(TEST_B, test_locks[test.lock], BEARER_CLASS_DEFAULT,
+        test_barring_lock_cb, &test);
+}
+
+/* The GetProperties method call, as far as the driver can tell */
+static
+void
+test_barring_get_properties(
+    void)
+{
+    test.lock = 0;
+    test.cb_ok = test.cb_failed = 0;
+    test.requests = 0;
+    test_barring_next_lock();
+}
+
+static
+void
+test_barring_answer(
+    RADIO_TX_STATUS status,
+    guint32 resp,
+    RADIO_ERROR error)
+{
+    test_respond(status, resp, error, 1, 0, 0);
+}
+
+static
+void
+test_barring_refused(
+    void)
+{
+    test_barring_answer(RADIO_TX_STATUS_OK,
+        RADIO_RESP_GET_FACILITY_LOCK_FOR_APP,
+        RADIO_ERROR_REQUEST_NOT_SUPPORTED);
+}
+
+/* The modem refuses everything: one request, and all five locks fail */
+static
+void
+test_barring_make_not_supported(
+    void)
+{
+    test_barring_get_properties();
+    g_assert_cmpuint(test.requests, == , 1);
+    test_barring_refused();
+    g_assert_cmpuint(test.requests, == , 1);
+    g_assert_cmpuint(test.cb_failed, == , G_N_ELEMENTS(test_locks));
+    g_assert(!test.pending);
+}
+
+/* A pass in which the radio isn't asked */
+static
+void
+test_barring_assert_not_asked(
+    void)
+{
+    test_barring_get_properties();
+    g_assert_cmpuint(test.requests, == , 0);
+    g_assert_cmpuint(test.cb_failed, == , G_N_ELEMENTS(test_locks));
+    g_assert_cmpuint(test.cb_ok, == , 0);
+    g_assert_cmpint(test.lock, == , G_N_ELEMENTS(test_locks) - 1);
+}
+
+/* The radio is asked again, the modem answers, all the way through */
+static
+void
+test_barring_assert_asked(
+    void)
+{
+    guint i;
+
+    test_barring_get_properties();
+    for (i = 0; i < G_N_ELEMENTS(test_locks); i++) {
+        g_assert_cmpuint(test.requests, == , i + 1);
+        test_barring_answer(RADIO_TX_STATUS_OK,
+            RADIO_RESP_GET_FACILITY_LOCK_FOR_APP, RADIO_ERROR_NONE);
+    }
+    g_assert_cmpuint(test.cb_ok, == , G_N_ELEMENTS(test_locks));
+    g_assert_cmpuint(test.cb_failed, == , 0);
+}

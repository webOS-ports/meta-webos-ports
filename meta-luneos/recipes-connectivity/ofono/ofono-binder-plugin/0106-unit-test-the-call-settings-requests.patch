+struct radio_request {
+    int refcount;
+    guint32 code;
+    RadioRequestGroup* group;
+    RadioRequestCompleteFunc complete;
+    GDestroyNotify destroy;
+    gpointer user_data;
+    guint timeout_ms;
+    gboolean blocking;
+};
+
+struct radio_client {
+    int refcount;
+    RADIO_AIDL_INTERFACE aidl;
+    RadioRequestGroup group;
+};
+
+typedef struct test_context {
+    const struct ofono_call_settings_driver* cs_driver;
+    const struct ofono_call_forwarding_driver* cf_driver;
+    const struct ofono_call_barring_driver* cb_driver;
+    gpointer cs_data;
+    gpointer cf_data;
+    gpointer cb_data;
+    struct ofono_modem* ofono;
+    BinderModem modem;
+    RadioClient voice;
+    RadioClient sim;
+    RadioClient network;
+    BinderSimCard card;
+    BinderRadio radio;
+    BinderSimCardFunc card_app_changed;
+    gpointer card_app_changed_data;
+    BinderRadioPropertyFunc radio_state_changed;
+    gpointer radio_state_changed_data;
+    gulong radio_handlers_added;
+    gulong card_handlers_added;
+    GSList* pending;     /* RadioRequest*, oldest first */
+    GSList* allocs;
+
+    /* What the last request was given */
+    gint32 written[TEST_MAX_WRITTEN];
+    guint written_count;
+
+    /* What the response carries */
+    gint32 reply[2];
+    guint reply_count;
+    guint reply_read;
+
+    /* What happened */
+    guint requests;      /* Requests that reached the radio */
+    guint timeout_ms;    /* Of the last request */
+    gboolean blocking;   /* Of the last request */
+    guint cb_ok;
+    guint cb_failed;
+    int cb_value;
+    guint errors_logged;
+
+    /* The GetProperties in progress, if any */
+    guint lock;
+} TestContext;
+
+static TestContext test;
+
+static
+void
+test_request_unref(
+    RadioRequest* req)
+{
+    if (!--req->refcount) {
+        if (req->destroy) {
+            req->destroy(req->user_data);
+        }
+        g_free(req);
+    }
+}
+
+RadioRequest*
+radio_request_new2(
+    RadioRequestGroup* group,
+    RADIO_REQ code,
+    GBinderWriter* args,
+    RadioRequestCompleteFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    RadioRequest* req = g_new0(RadioRequest, 1);
+
+    req->refcount = 1;
+    req->code = code;
+    req->group = group;
+    req->complete = complete;
+    req->destroy = destroy;
+    req->user_data = user_data;
+    test.written_count = 0;
+    return req;
+}
+
+gboolean
+radio_request_submit(
+    RadioRequest* req)
+{
+    test.requests++;
+    test.timeout_ms = req->timeout_ms;
+    test.blocking = req->blocking;
+    req->refcount++;
+    test.pending = g_slist_append(test.pending, req);
+    return TRUE;
+}
+
+void
+radio_request_unref(
+    RadioRequest* req)
+{
+    if (req) {
+        test_request_unref(req);
+    }
+}
+
+void
+radio_request_set_blocking(
+    RadioRequest* req,
+    gboolean blocking)
+{
+    req->blocking = blocking;
+}
+
+void
+radio_request_set_timeout(
+    RadioRequest* req,
+    guint ms)
+{
+    req->timeout_ms = ms;
+}
+
+RadioRequestGroup*
+radio_request_group_new(
+    RadioClient* client)
+{
+    client->group.client = client;
+    return &client->group;
+}
+
+void
+radio_request_group_unref(
+    RadioRequestGroup* group)
+{
+}
+
+void
+radio_request_group_cancel(
+    RadioRequestGroup* group)
+{
+    GSList* l = test.pending;
+
+    while (l) {
+        GSList* next = l->next;
+        RadioRequest* req = l->data;
+
+        if (req->group == group) {
+            test.pending = g_slist_delete_link(test.pending, l);
+            test_request_unref(req);
+        }
+        l = next;
+    }
+}
+
+RadioClient*
+radio_client_ref(
+    RadioClient* client)
+{
+    client->refcount++;
+    return client;
+}
+
+void
+radio_client_unref(
+    RadioClient* client)
+{
+    client->refcount--;
+}
+

+};
+
+/*
+ * These sit in the SS queue of the RIL, which both SIMs share. 52.8 s has
+ * been seen. Blocking would hold back call control, which uses voice_client.
+ * Whatever is left pending goes away with the atoms in test_finish().
+ */
+static
+void
+test_timeout(
+    gconstpointer data)
+{
+    const struct test_op* t = data;
+
+    test_start_hidl();
+    t->op();
+    g_assert_cmpuint(test.requests, == , 1);
+    g_assert_cmpuint(test.timeout_ms, == , 5*60*1000);
+    g_assert_cmpuint(test.timeout_ms, > , TEST_RIL_DEFAULT_TIMEOUT_MS);
+    g_assert(!test.blocking);
+    test_finish();
+}

+/*==========================================================================*
+ * Call waiting
+ *==========================================================================*/
+
+typedef struct test_cw_case {
+    const char* name;
+    RADIO_RESP resp;
+    RADIO_ERROR error;
+    guint count;
+    gint32 enable;
+    gint32 cls;
+    int expect_failed;
+    int expect_value;
+} TestCwCase;
+
+static const TestCwCase test_cw_cases[] = {
+    /* The MTK RIL, in the two forms seen on the Mindphone */
+    { "mtk_enabled", RADIO_RESP_GET_CLIR, RADIO_ERROR_NONE, 2, 1, 1, 0, 1 },
+    { "mtk_disabled", RADIO_RESP_GET_CLIR, RADIO_ERROR_NONE, 2, 0, -1, 0, 0 },
+
+    /* As the interface says */
+    { "enabled", RADIO_RESP_GET_CALL_WAITING, RADIO_ERROR_NONE, 2, 1, 1, 0, 1 },
+    { "disabled", RADIO_RESP_GET_CALL_WAITING, RADIO_ERROR_NONE, 2, 0, -1,
+      0, 0 },
+
+    /* Errors stay errors, whatever method they come through */
+    { "mtk_error", RADIO_RESP_GET_CLIR, RADIO_ERROR_GENERIC_FAILURE, 2, 1, 1,
+      1, -1 },
+    { "error", RADIO_RESP_GET_CALL_WAITING, RADIO_ERROR_GENERIC_FAILURE, 2,
+      1, 1, 1, -1 },
+    { "mtk_short", RADIO_RESP_GET_CLIR, RADIO_ERROR_NONE, 1, 1, 0, 1, -1 },
+
+    /* Nothing else is taken for an answer */
+    { "other_resp", RADIO_RESP_GET_CLIP, RADIO_ERROR_NONE, 2, 1, 1, 1, -1 }
+};
+
+static
+void
+test_cw(
+    gconstpointer data)
+{
+    const TestCwCase* c = data;
+
+    test_start_hidl();
+    test.cs_driver->cw_query(TEST_S, BEARER_CLASS_VOICE, test_status_cb, &test);
+    g_assert_cmpuint(test.requests, == , 1);
+    test_respond(RADIO_TX_STATUS_OK, c->resp, c->error, c->count,
+        c->enable, c->cls);
+    g_assert_cmpuint(test.cb_failed, == , c->expect_failed);
+    g_assert_cmpuint(test.cb_ok, == , !c->expect_failed);
+    g_assert_cmpint(test.cb_value, == , c->expect_value);
+    test_finish();
+}
+
+static
+void
+test_cw_tx(
+    gconstpointer data)
+{
+    test_start_hidl();
+    test.cs_driver->cw_query(TEST_S, BEARER_CLASS_VOICE, test_status_cb, &test);
+    test_respond(GPOINTER_TO_INT(data), RADIO_RESP_GET_CLIR, RADIO_ERROR_NONE,
+        2, 1, 1);
+    g_assert_cmpuint(test.cb_failed, == , 1);
+    g_assert_cmpint(test.cb_value, == , -1);
+    test_finish();
+}
+
+static
+void
+test_cw_aidl(
+    void)
+{
+    test_start(RADIO_VOICE_INTERFACE, RADIO_AIDL_INTERFACE_NONE);
+    test.cs_driver->cw_query(TEST_S, BEARER_CLASS_VOICE, test_status_cb, &test);
+    test_respond(RADIO_TX_STATUS_OK, RADIO_VOICE_RESP_GET_CALL_WAITING,
+        RADIO_ERROR_NONE, 2, 1, 1);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert_cmpint(test.cb_value, == , 1);
+
+    /* The workaround is for the HIDL response code */
+    test.cs_driver->cw_query(TEST_S, BEARER_CLASS_VOICE, test_status_cb, &test);
+    test_respond(RADIO_TX_STATUS_OK, RADIO_RESP_GET_CLIR, RADIO_ERROR_NONE,
+        2, 1, 1);
+    g_assert_cmpuint(test.cb_failed, == , 1);
+    test_finish();
+}
+
+/* The getClir check isn't relaxed along with the getCallWaiting one */
+static
+void
+test_clir_resp(
+    void)
+{
+    test_start_hidl();
+    test.cs_driver->clir_query(TEST_S, test_clir_cb, &test);
+    test_respond(RADIO_TX_STATUS_OK, RADIO_RESP_GET_CLIR, RADIO_ERROR_NONE,
+        2, 1, 2);
+    g_assert_cmpuint(test.cb_ok, == , 1);
+    g_assert_cmpint(test.cb_value, == , 1);
+    test.cs_driver->clir_query(TEST_S, test_clir_cb, &test);
+    test_respond(RADIO_TX_STATUS_OK, RADIO_RESP_GET_CALL_WAITING,
+        RADIO_ERROR_NONE, 2, 1, 2);
+    g_assert_cmpuint(test.cb_failed, == , 1);
+    test_finish();
+}

+/* Setting the password goes to another client, nothing outlives the atom */
+static
+void
+test_cb_remove_pending(
+    void)
+{
+    test_start_hidl();
+    test_op_cb_set_passwd();
+    test_op_cb_query();
+    g_assert_cmpuint(g_slist_length(test.pending), == , 2);
+    test_finish();
+    g_assert_cmpuint(test.cb_ok + test.cb_failed, == , 0);
+}

+    { "cw_set", test_op_cw_set },
+    { "cf_query", test_op_cf_query },
+    { "cf_activate", test_op_cf_activate },
+    { "cf_deactivate", test_op_cf_deactivate },
+    { "cf_erase", test_op_cf_erase },

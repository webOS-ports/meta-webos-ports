+/*==========================================================================*
+ * Common
+ *==========================================================================*/
+
+#define TEST_(name) "/call_settings/" name
+
+int main(int argc, char* argv[])
+{
+    const gsize n = G_N_ELEMENTS(test_cw_cases) + G_N_ELEMENTS(test_ops);
+    char** paths = g_new0(char*, n + 1);
+    gsize i, k = 0;
+    int ret;
+
+    g_test_init(&argc, &argv, NULL);
+    gutil_log_default.level = g_test_verbose() ?
+        GLOG_LEVEL_VERBOSE : GLOG_LEVEL_NONE;
+
+    for (i = 0; i < G_N_ELEMENTS(test_cw_cases); i++) {
+        paths[k] = g_strconcat(TEST_("cw/"), test_cw_cases[i].name, NULL);
+        g_test_add_data_func(paths[k++], test_cw_cases + i, test_cw);
+    }
+    g_test_add_data_func(TEST_("cw/tx_failed"),
+        GINT_TO_POINTER(RADIO_TX_STATUS_FAILED), test_cw_tx);
+    g_test_add_data_func(TEST_("cw/tx_timeout"),
+        GINT_TO_POINTER(RADIO_TX_STATUS_TIMEOUT), test_cw_tx);
+    g_test_add_func(TEST_("cw/aidl"), test_cw_aidl);
+    g_test_add_func(TEST_("clir_resp"), test_clir_resp);
+    for (i = 0; i < G_N_ELEMENTS(test_ops); i++) {
+        paths[k] = g_strconcat(TEST_("timeout/"), test_ops[i].name, NULL);
+        g_test_add_data_func(paths[k++], test_ops + i, test_timeout);
+    }
+    g_test_add_func(TEST_("barring/not_supported"), test_cb_not_supported);
+    g_test_add_data_func(TEST_("barring/timeout"), test_cb_timeout,
+        test_cb_not_remembered);
+    g_test_add_data_func(TEST_("barring/tx_failed"), test_cb_tx_failed,
+        test_cb_not_remembered);
+    g_test_add_data_func(TEST_("barring/error"), test_cb_error,
+        test_cb_not_remembered);
+    g_test_add_data_func(TEST_("barring/wrong_resp"), test_cb_wrong_resp,
+        test_cb_not_remembered);
+    g_test_add_func(TEST_("barring/answered_first"), test_cb_answered_first);
+    g_test_add_func(TEST_("barring/sim_changed"), test_cb_sim_changed);
+    g_test_add_func(TEST_("barring/radio_state"), test_cb_radio_state_changed);
+    g_test_add_func(TEST_("barring/set_done"), test_cb_set_done);
+    g_test_add_func(TEST_("barring/set_failed"), test_cb_set_failed);
+    g_test_add_func(TEST_("barring/class"), test_cb_class);
+    g_test_add_func(TEST_("barring/class_aidl"), test_cb_class_aidl);
+    g_test_add_func(TEST_("barring/remove_pending"), test_cb_remove_pending);
+    ret = g_test_run();
+    g_strfreev(paths);
+    return ret;
+}

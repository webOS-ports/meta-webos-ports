+/*==========================================================================*
+ * Call barring
+ *==========================================================================*/
+
+static
+void
+test_cb_not_supported(
+    void)
+{
+    guint pass;
+
+    test_start_hidl();
+    test_barring_make_not_supported();
+    for (pass = 0; pass < 3; pass++) {
+        test_barring_assert_not_asked();
+    }
+
+    /* The journal gets one line, not a line per query */
+    g_assert_cmpuint(test.errors_logged, == , 1);
+    test_finish();
+}
+
+/* Any of these says nothing about what the modem supports */
+static
+void
+test_cb_not_remembered(
+    gconstpointer data)
+{
+    const RADIO_TX_STATUS tx = ((const gint*)data)[0];
+    const RADIO_RESP resp = ((const gint*)data)[1];
+    const RADIO_ERROR err = ((const gint*)data)[2];
+    guint i;
+
+    test_start_hidl();
+    test_barring_get_properties();
+    for (i = 0; i < G_N_ELEMENTS(test_locks); i++) {
+        g_assert_cmpuint(test.requests, == , i + 1);
+        test_barring_answer(tx, resp, err);
+    }
+    g_assert_cmpuint(test.cb_failed, == , G_N_ELEMENTS(test_locks));
+    test_barring_assert_asked();
+    test_finish();
+}
+
+static const gint test_cb_timeout[] = {
+    RADIO_TX_STATUS_TIMEOUT, RADIO_RESP_GET_FACILITY_LOCK_FOR_APP,
+    RADIO_ERROR_REQUEST_NOT_SUPPORTED
+};
+static const gint test_cb_tx_failed[] = {
+    RADIO_TX_STATUS_FAILED, RADIO_RESP_GET_FACILITY_LOCK_FOR_APP,
+    RADIO_ERROR_REQUEST_NOT_SUPPORTED
+};
+static const gint test_cb_error[] = {
+    RADIO_TX_STATUS_OK, RADIO_RESP_GET_FACILITY_LOCK_FOR_APP,
+    RADIO_ERROR_GENERIC_FAILURE
+};
+static const gint test_cb_wrong_resp[] = {
+    RADIO_TX_STATUS_OK, RADIO_RESP_GET_CLIR, RADIO_ERROR_REQUEST_NOT_SUPPORTED
+};
+
+/* Some facilities work and some don't, so the service isn't "not supported" */
+static
+void
+test_cb_answered_first(
+    void)
+{
+    guint i;
+
+    test_start_hidl();
+    test_barring_get_properties();
+    test_barring_answer(RADIO_TX_STATUS_OK,
+        RADIO_RESP_GET_FACILITY_LOCK_FOR_APP, RADIO_ERROR_NONE);
+    for (i = 1; i < G_N_ELEMENTS(test_locks); i++) {
+        test_barring_refused();
+    }
+    g_assert_cmpuint(test.requests, == , G_N_ELEMENTS(test_locks));
+    test_barring_assert_asked();
+    test_finish();
+}

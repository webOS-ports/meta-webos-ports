diff --git a/src/sim.c b/src/sim.c
index 8741ea9..8c0dd3f 100644
--- a/src/sim.c
+++ b/src/sim.c
@@ -11,6 +11,7 @@
 
 #include <string.h>
 #include <stdio.h>
+#include <stddef.h>
 #include <stdint.h>
 #include <stdbool.h>
 
@@ -4068,3 +4069,47 @@ void ofono_sim_set_active_card_slot(struct ofono_sim *sim, unsigned int val)
 	if (sim)
 		sim->active_card_slot = val;
 }
+
+/*
+ * Sailfish-compatible versioned registration. A plugin built against an
+ * older header may pass a driver struct that is shorter than the one this
+ * daemon knows about, so only the portion the caller actually filled in is
+ * copied and the remainder is left zeroed.
+ *
+ * Upstream 2.19 has no open_channel2 member, which is what distinguished
+ * version 0 from version 1, so both are treated as "everything up to
+ * set_active_card_slot".
+ */
+#undef ofono_sim_driver_register
+
+/*
+ * Retained so that a plugin binary built before the register macro existed
+ * still links. Newly compiled callers get the macro, which passes the
+ * current API version.
+ */
+int ofono_sim_driver_register(const struct ofono_sim_driver *d)
+{
+	return ofono_sim_driver_register_version(d, 1);
+}
+
+int ofono_sim_driver_register_version(const struct ofono_sim_driver *d,
+					int version)
+{
+	size_t copy;
+
+	if (!d || !d->name)
+		return -EINVAL;
+
+	if (version >= OFONO_SIM_DRIVER_API_VERSION)
+		copy = sizeof(*d);
+	else
+		copy = offsetof(struct ofono_sim_driver, set_active_card_slot);
+
+	return __ofono_driver_register_padded("sim", d->name, d,
+						sizeof(*d), copy);
+}
+
+void ofono_sim_driver_unregister(const struct ofono_sim_driver *d)
+{
+	__ofono_driver_unregister("sim", d);
+}

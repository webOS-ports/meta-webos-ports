@@ -3421,3 +3425,91 @@ void *ofono_gprs_get_data(struct ofono_gprs *gprs)
 OFONO_DEFINE_ATOM_DRIVER_REGISTER(gprs)
 
 OFONO_DEFINE_ATOM_DRIVER_REGISTER(gprs_context)
+
+ofono_bool_t ofono_gprs_get_roaming_allowed(struct ofono_gprs *gprs)
+{
+	return gprs ? gprs->roaming_allowed : FALSE;
+}
+
+const struct ofono_gprs_primary_context *ofono_gprs_context_settings_by_type(
+					struct ofono_gprs *gprs,
+					enum ofono_gprs_context_type type)
+{
+	GSList *l;
+
+	if (!gprs)
+		return NULL;
+
+	for (l = gprs->contexts; l; l = l->next) {
+		struct pri_context *ctx = l->data;
+
+		if (type == OFONO_GPRS_CONTEXT_TYPE_ANY || type == ctx->type)
+			return &ctx->context;
+	}
+
+	return NULL;
+}
+
+enum ofono_gprs_context_type ofono_gprs_context_get_assigned_type(
+					struct ofono_gprs_context *gc)
+{
+	if (gc) {
+		struct ofono_gprs *gprs = gc->gprs;
+		GSList *l;
+
+		for (l = gprs->contexts; l; l = l->next) {
+			struct pri_context *pri = l->data;
+
+			if (pri->context_driver == gc)
+				return pri->type;
+		}
+	}
+
+	return OFONO_GPRS_CONTEXT_TYPE_ANY;
+}
+
+void ofono_gprs_context_signal_change(struct ofono_gprs_context *gc,
+					unsigned int cid)
+{
+	GSList *l;
+
+	if (gc->gprs == NULL)
+		return;
+
+	for (l = gc->gprs->contexts; l; l = l->next) {
+		struct pri_context *ctx = l->data;
+
+		if (ctx->context.cid != cid)
+			continue;
+
+		if (ctx->active == FALSE)
+			break;
+
+		pri_context_signal_settings(ctx, gc->settings->ipv4 != NULL,
+						gc->settings->ipv6 != NULL);
+	}
+}
+
+void ofono_gprs_context_set_ipv4_proxy_cscf(struct ofono_gprs_context *gc,
+					const char **pcscf)
+{
+	struct context_settings *settings = gc->settings;
+
+	if (settings->ipv4 == NULL)
+		return;
+
+	l_strv_free(settings->ipv4->pcscf);
+	settings->ipv4->pcscf = l_strv_copy((char **) pcscf);
+}
+
+void ofono_gprs_context_set_ipv6_proxy_cscf(struct ofono_gprs_context *gc,
+					const char **pcscf)
+{
+	struct context_settings *settings = gc->settings;
+
+	if (settings->ipv6 == NULL)
+		return;
+
+	l_strv_free(settings->ipv6->pcscf);
+	settings->ipv6->pcscf = l_strv_copy((char **) pcscf);
+}

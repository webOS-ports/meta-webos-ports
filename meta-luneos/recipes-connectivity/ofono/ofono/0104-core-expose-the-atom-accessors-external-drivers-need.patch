diff --git a/src/radio-settings.c b/src/radio-settings.c
index 8e44f1a..df66e60 100644
--- a/src/radio-settings.c
+++ b/src/radio-settings.c
@@ -897,3 +897,62 @@ struct ofono_modem *ofono_radio_settings_get_modem(
 }
 
 OFONO_DEFINE_ATOM_DRIVER_REGISTER(radio_settings)
+
+/*
+ * These are the public counterparts of the static helpers above. They are
+ * deliberately not the same function: the static radio_access_mode_to_string()
+ * renders combination masks such as "lte,umts", whereas the public API reduces
+ * a mask to its highest single mode, which is what external drivers expect.
+ */
+enum ofono_radio_access_mode ofono_radio_access_max_mode(
+					enum ofono_radio_access_mode mask)
+{
+	return	(mask & OFONO_RADIO_ACCESS_MODE_NR) ?
+					OFONO_RADIO_ACCESS_MODE_NR :
+		(mask & OFONO_RADIO_ACCESS_MODE_LTE) ?
+					OFONO_RADIO_ACCESS_MODE_LTE :
+		(mask & OFONO_RADIO_ACCESS_MODE_UMTS) ?
+					OFONO_RADIO_ACCESS_MODE_UMTS :
+		(mask & OFONO_RADIO_ACCESS_MODE_GSM) ?
+					OFONO_RADIO_ACCESS_MODE_GSM :
+					OFONO_RADIO_ACCESS_MODE_ANY;
+}
+
+const char *ofono_radio_access_mode_to_string(enum ofono_radio_access_mode m)
+{
+	switch (ofono_radio_access_max_mode(m)) {
+	case OFONO_RADIO_ACCESS_MODE_ANY:
+		return "any";
+	case OFONO_RADIO_ACCESS_MODE_GSM:
+		return "gsm";
+	case OFONO_RADIO_ACCESS_MODE_UMTS:
+		return "umts";
+	case OFONO_RADIO_ACCESS_MODE_LTE:
+		return "lte";
+	case OFONO_RADIO_ACCESS_MODE_NR:
+		return "nr";
+	}
+
+	return NULL;
+}
+
+ofono_bool_t ofono_radio_access_mode_from_string(const char *str,
+					enum ofono_radio_access_mode *mode)
+{
+	if (!str)
+		return FALSE;
+	else if (g_str_equal(str, "any"))
+		*mode = OFONO_RADIO_ACCESS_MODE_ANY;
+	else if (g_str_equal(str, "gsm"))
+		*mode = OFONO_RADIO_ACCESS_MODE_GSM;
+	else if (g_str_equal(str, "umts"))
+		*mode = OFONO_RADIO_ACCESS_MODE_UMTS;
+	else if (g_str_equal(str, "lte"))
+		*mode = OFONO_RADIO_ACCESS_MODE_LTE;
+	else if (g_str_equal(str, "nr"))
+		*mode = OFONO_RADIO_ACCESS_MODE_NR;
+	else
+		return FALSE;
+
+	return TRUE;
+}

 include/gprs-provision.h | 53 ++++++++++++++++++++++
 src/gprs-provision.c     | 95 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 150 insertions(+), 2 deletions(-)
 create mode 100644 include/gprs-provision.h

From 8635149028780bb626dd2259564ec5e98d0d84e1 Mon Sep 17 00:00:00 2001
From: LuneOS <claude.ai@herrie.org>
Date: Thu, 3 Sep 2026 19:25:33 +0200
Subject: [PATCH 107/114] core: let plugins use oFono's storage directory

The slot manager persists which SIM is the default for data and calls,
plus a running error count, in oFono's storage directory. It does that
through storage_open(), storage_sync() and storage_close().

Those three are not exported, and should not be: their names are too
generic to sit in the daemon's dynamic symbol table. Add namespaced
wrappers instead, so an out-of-tree plugin gets identical behaviour,
including the file layout, without the daemon exporting 'storage_open'.

(cherry picked from commit 7af07ded81f347f1eb8669573f8701c01c24711f)
Upstream-Status: Pending
---
 include/storage.h |  9 +++++++++
 src/storage.c     | 22 ++++++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/include/storage.h b/include/storage.h
index 4d6f0fd..ddba88d 100644
--- a/include/storage.h
+++ b/include/storage.h
@@ -15,6 +15,15 @@ extern "C" {
 const char *ofono_config_dir(void);
 const char *ofono_storage_dir(void);
 
+#include <glib.h>
+#include <ofono/types.h>
+
+GKeyFile *ofono_storage_open(const char *imsi, const char *store);
+void ofono_storage_sync(const char *imsi, const char *store,
+				GKeyFile *keyfile);
+void ofono_storage_close(const char *imsi, const char *store,
+				GKeyFile *keyfile, ofono_bool_t save);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/storage.c b/src/storage.c
index e08730c..b7fe522 100644
--- a/src/storage.c
+++ b/src/storage.c
@@ -181,3 +181,25 @@ void storage_close(const char *imsi, const char *store, GKeyFile *keyfile,
 
 	g_key_file_free(keyfile);
 }
+
+/*
+ * Namespaced wrappers so an out-of-tree plugin can persist its own state
+ * in oFono's storage directory. The helpers above are not exported: their
+ * names are too generic to put in the daemon's dynamic symbol table.
+ */
+GKeyFile *ofono_storage_open(const char *imsi, const char *store)
+{
+	return storage_open(imsi, store);
+}
+
+void ofono_storage_sync(const char *imsi, const char *store,
+				GKeyFile *keyfile)
+{
+	storage_sync(imsi, store, keyfile);
+}
+
+void ofono_storage_close(const char *imsi, const char *store,
+				GKeyFile *keyfile, ofono_bool_t save)
+{
+	storage_close(imsi, store, keyfile, save);
+}

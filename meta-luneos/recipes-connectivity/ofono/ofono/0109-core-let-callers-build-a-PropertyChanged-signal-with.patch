From d0fc84cf1e06d93583c97642c1e5285ae4ce0038 Mon Sep 17 00:00:00 2001
From: LuneOS <claude.ai@herrie.org>
Date: Thu, 3 Sep 2026 19:34:38 +0200
Subject: [PATCH 109/114] core: let callers build a PropertyChanged signal
 without sending it

ofono_dbus_signal_property_changed() broadcasts. The extension layer keeps
a list of interested D-Bus clients and sends the same signal to each, so it
needs the message without the send.

Split that out as ofono_dbus_signal_new_property_changed(). It lives in
src/dbus.c because it needs append_variant(), which is static there.

(cherry picked from commit af31864dfcafbfec9d1093bd34452798ec00676b)
Upstream-Status: Pending
---
 include/dbus.h |  9 +++++++++
 src/dbus.c     | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/include/dbus.h b/include/dbus.h
index 1120c08..c33484f 100644
--- a/include/dbus.h
+++ b/include/dbus.h
@@ -72,6 +72,15 @@ void ofono_dbus_dict_append_array(DBusMessageIter *dict, const char *key,
 void ofono_dbus_dict_append_dict(DBusMessageIter *dict, const char *key,
 					int type, const void *val);
 
+/*
+ * Builds a PropertyChanged signal without sending it, so a caller can
+ * decide who receives it. ofono_dbus_signal_property_changed() broadcasts.
+ */
+DBusMessage *ofono_dbus_signal_new_property_changed(const char *path,
+					const char *interface,
+					const char *name,
+					int type, const void *value);
+
 int ofono_dbus_signal_property_changed(DBusConnection *conn, const char *path,
 					const char *interface, const char *name,
 					int type, const void *value);
diff --git a/src/dbus.c b/src/dbus.c
index 4ad54e2..fcfacd5 100644
--- a/src/dbus.c
+++ b/src/dbus.c
@@ -195,6 +195,25 @@ void ofono_dbus_dict_append_dict(DBusMessageIter *dict, const char *key,
 	dbus_message_iter_close_container(dict, &entry);
 }
 
+DBusMessage *ofono_dbus_signal_new_property_changed(const char *path,
+					const char *interface,
+					const char *name,
+					int type, const void *value)
+{
+	DBusMessage *signal;
+	DBusMessageIter iter;
+
+	signal = dbus_message_new_signal(path, interface, "PropertyChanged");
+	if (signal == NULL)
+		return NULL;
+
+	dbus_message_iter_init_append(signal, &iter);
+	dbus_message_iter_append_basic(&iter, DBUS_TYPE_STRING, &name);
+	append_variant(&iter, type, value);
+
+	return signal;
+}
+
 int ofono_dbus_signal_property_changed(DBusConnection *conn,
 					const char *path,
 					const char *interface,

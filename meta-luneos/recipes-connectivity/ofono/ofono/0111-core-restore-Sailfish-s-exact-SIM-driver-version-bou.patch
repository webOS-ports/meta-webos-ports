From dd4e68e59c8b69a7e0903a271997d721ab9d13da Mon Sep 17 00:00:00 2001
From: LuneOS <claude.ai@herrie.org>
Date: Thu, 3 Sep 2026 21:07:35 +0200
Subject: [PATCH 111/114] core: restore Sailfish's exact SIM driver version
 boundaries

With open_channel2 present, version 0 has a meaningful cut again. Match
Sailfish exactly: version 0 predates open_channel2, version 1 predates
set_active_card_slot, anything newer is copied whole.

Caught by the equivalence harness, which started failing the moment
open_channel2 shifted the struct layout.

(cherry picked from commit d5ef5bb94984a7f8f53a27617321b204c156f236)
Upstream-Status: Pending
---
 src/sim.c | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/sim.c b/src/sim.c
index 02251df..4e2b332 100644
--- a/src/sim.c
+++ b/src/sim.c
@@ -4191,9 +4191,9 @@ void ofono_sim_set_active_card_slot(struct ofono_sim *sim, unsigned int val)
  * daemon knows about, so only the portion the caller actually filled in is
  * copied and the remainder is left zeroed.
  *
- * Upstream 2.19 has no open_channel2 member, which is what distinguished
- * version 0 from version 1, so both are treated as "everything up to
- * set_active_card_slot".
+ * The version boundaries match Sailfish's: version 0 predates
+ * open_channel2, version 1 predates set_active_card_slot, and anything
+ * newer is copied whole.
  */
 #undef ofono_sim_driver_register
 
@@ -4215,10 +4215,19 @@ int ofono_sim_driver_register_version(const struct ofono_sim_driver *d,
 	if (!d || !d->name)
 		return -EINVAL;
 
-	if (version >= OFONO_SIM_DRIVER_API_VERSION)
-		copy = sizeof(*d);
-	else
+	switch (version) {
+	case 0:
+		/* Predates open_channel2 */
+		copy = offsetof(struct ofono_sim_driver, open_channel2);
+		break;
+	case 1:
+		/* Has open_channel2, predates set_active_card_slot */
 		copy = offsetof(struct ofono_sim_driver, set_active_card_slot);
+		break;
+	default:
+		copy = sizeof(*d);
+		break;
+	}
 
 	return __ofono_driver_register_padded("sim", d->name, d,
 						sizeof(*d), copy);

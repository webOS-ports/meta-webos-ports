From f2bd298e207b50349f85ff5a166f57834bf7fae1 Mon Sep 17 00:00:00 2001
From: LuneOS <claude.ai@herrie.org>
Date: Fri, 4 Sep 2026 02:29:13 +0200
Subject: [PATCH 113/114] build: make the installed headers usable from out of
 tree

Two things an external plugin needs that oFono does not currently ship.

gdbus.h is not installed, so a plugin that exports a D-Bus interface has
no way to declare the g_dbus_* helpers, even though the version script
already exports them. Install it under ofono/, which is where Sailfish
puts it and where ofono-binder-plugin expects it. The existing symlink
rule only covers include/%.h, so gdbus.h needs its own.

Every public header refuses to compile unless OFONO_API_SUBJECT_TO_CHANGE
is defined, but ofono.pc does not say so. Anything building against
'pkg-config --cflags ofono' therefore fails on the first include. Add the
define to Cflags so consumers get it automatically.

(cherry picked from commit 5c96f326684d2b503c7210d8f76dc2284b8466af)
Upstream-Status: Pending
---
 Makefile.am | 6 ++++++
 ofono.pc.in | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/Makefile.am b/Makefile.am
index 921bbec..a115b0a 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -183,6 +183,8 @@ pkginclude_HEADERS = include/log.h include/plugin.h include/history.h \
 
 nodist_pkginclude_HEADERS = include/version.h
 
+pkginclude_HEADERS += gdbus/gdbus.h
+
 local_headers = $(foreach file,$(pkginclude_HEADERS) \
 				$(nodist_pkginclude_HEADERS), \
 					include/ofono/$(notdir $(file)))
@@ -1059,6 +1061,10 @@ include/ofono/%.h: $(abs_top_srcdir)/include/%.h
 	$(AM_V_at)$(MKDIR_P) include/ofono
 	$(AM_V_GEN)$(LN_S) $< $@
 
+include/ofono/gdbus.h: $(abs_top_srcdir)/gdbus/gdbus.h
+	$(AM_V_at)$(MKDIR_P) include/ofono
+	$(AM_V_GEN)$(LN_S) $< $@
+
 ell/shared: Makefile
 	$(AM_V_at)$(MKDIR_P) ell
 	$(AM_V_GEN)for f in $(ell_shared) ; do \
diff --git a/ofono.pc.in b/ofono.pc.in
index b4d0a77..a28e699 100644
--- a/ofono.pc.in
+++ b/ofono.pc.in
@@ -9,5 +9,5 @@ Name: @PACKAGE@
 Description: oFono - Open Source Telephony
 Version: @VERSION@
 Requires: glib-2.0 dbus-1
-Cflags: -I${includedir}
+Cflags: -I${includedir} -DOFONO_API_SUBJECT_TO_CHANGE
 Libs: -module -avoid-version -export-symbols-regex '@PACKAGE@_plugin_desc'

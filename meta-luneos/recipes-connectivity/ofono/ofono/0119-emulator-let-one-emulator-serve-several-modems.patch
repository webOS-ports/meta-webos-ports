 void ofono_emulator_register(struct ofono_emulator *em, int fd);
 
diff --git a/plugins/dun_gw_bluez5.c b/plugins/dun_gw_bluez5.c
index 396528b..794de70 100644
--- a/plugins/dun_gw_bluez5.c
+++ b/plugins/dun_gw_bluez5.c
@@ -78,7 +78,7 @@ static DBusMessage *profile_new_connection(DBusConnection *conn,
 	modem = modems->data;
 	DBG("Picked modem %p for emulator", modem);
 
-	em = ofono_emulator_create(modem, OFONO_EMULATOR_TYPE_DUN);
+	em = ofono_emulator_create(OFONO_EMULATOR_TYPE_DUN);
 	if (em == NULL) {
 		close(fd);
 		return g_dbus_create_error(msg, BLUEZ_ERROR_INTERFACE
@@ -86,6 +86,8 @@ static DBusMessage *profile_new_connection(DBusConnection *conn,
 						"Not enough resources");
 	}
 
+	/* DUN stays on one modem: PPP runs over a single data connection */
+	ofono_emulator_add_modem(em, modem);
 	ofono_emulator_register(em, fd);
 
 	return dbus_message_new_method_return(msg);
diff --git a/plugins/hfp_ag_bluez5.c b/plugins/hfp_ag_bluez5.c

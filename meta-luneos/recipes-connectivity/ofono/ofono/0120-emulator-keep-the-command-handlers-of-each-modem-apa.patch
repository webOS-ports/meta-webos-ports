index 1d60181..3b0b559 100644
--- a/src/sim.c
+++ b/src/sim.c
@@ -3356,9 +3356,7 @@ void __ofono_sim_recheck_pin(struct ofono_sim *sim)
 
 static void emulator_remove_handler(struct ofono_atom *atom, void *data)
 {

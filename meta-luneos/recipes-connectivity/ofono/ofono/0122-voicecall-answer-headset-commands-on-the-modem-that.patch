+/*
+ * An emulator can serve several modems, and the handlers it calls belong to
+ * the first of them. Commands about a call go to the modem that has it.
+ */
+struct emulator_vc_search {
+	gboolean (*match)(struct ofono_voicecall *vc);
+	struct ofono_voicecall *found;
+};
+
+static void emulator_vc_search_cb(struct ofono_modem *modem, void *data)
+{
+	struct emulator_vc_search *s = data;
+	struct ofono_voicecall *vc;
+
+	if (s->found)
+		return;
+
+	vc = __ofono_atom_find(OFONO_ATOM_TYPE_VOICECALL, modem);
+	if (vc && s->match(vc))
+		s->found = vc;
+}
+
+static struct ofono_voicecall *emulator_target_vc(struct ofono_emulator *em,
+				struct ofono_voicecall *fallback,
+				gboolean (*match)(struct ofono_voicecall *vc))
+{
+	struct emulator_vc_search s = { .match = match, .found = NULL };
+
+	__ofono_emulator_foreach_modem(em, emulator_vc_search_cb, &s);
+
+	return s.found ? s.found : fallback;
+}
+
+static gboolean voicecalls_have_any(struct ofono_voicecall *vc)
+{
+	return vc->call_list != NULL || vc->dial_req != NULL;
+}

+void __ofono_emulator_foreach_modem(struct ofono_emulator *em,
+					ofono_modem_foreach_func cb,
+					void *data)
+{
+	GSList *l;
+
+	for (l = em->modems; l; l = l->next) {
+		struct emulator_modem *m = l->data;
+
+		if (__ofono_atom_get_registered(m->atom))
+			cb(__ofono_atom_get_modem(m->atom), data);
+	}
+}

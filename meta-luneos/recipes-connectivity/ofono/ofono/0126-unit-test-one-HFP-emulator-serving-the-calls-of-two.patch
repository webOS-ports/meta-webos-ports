+/* ---- a scripted voicecall driver ----------------------------------------- */
+
+struct ofono_driver_desc __start___voicecall[1];
+struct ofono_driver_desc __stop___voicecall[1];
+
+struct fake_vc {
+	struct ofono_voicecall *vc;
+	unsigned int answered;
+	unsigned int hung_up;
+	unsigned int dialled;
+	char dialled_number[OFONO_MAX_PHONE_NUMBER_LENGTH + 1];
+};
+
+static void reply_ok(ofono_voicecall_cb_t cb, void *data)
+{
+	struct ofono_error e = { .type = OFONO_ERROR_TYPE_NO_ERROR };
+
+	cb(&e, data);
+}
+
+static int fake_probe(struct ofono_voicecall *vc, unsigned int vendor,
+			void *data)
+{
+	ofono_voicecall_set_data(vc, data);
+	return 0;
+}
+
+static void fake_remove(struct ofono_voicecall *vc)
+{
+}
+
+static void fake_dial(struct ofono_voicecall *vc,
+			const struct ofono_phone_number *ph,
+			enum ofono_clir_option clir, ofono_voicecall_cb_t cb,
+			void *data)
+{
+	struct fake_vc *f = ofono_voicecall_get_data(vc);
+
+	f->dialled++;
+	g_strlcpy(f->dialled_number, ph->number, sizeof(f->dialled_number));
+	reply_ok(cb, data);
+}
+
+static void fake_answer(struct ofono_voicecall *vc, ofono_voicecall_cb_t cb,
+			void *data)
+{
+	struct fake_vc *f = ofono_voicecall_get_data(vc);
+
+	f->answered++;
+	reply_ok(cb, data);
+}
+
+static void fake_hangup_active(struct ofono_voicecall *vc,
+				ofono_voicecall_cb_t cb, void *data)
+{
+	struct fake_vc *f = ofono_voicecall_get_data(vc);
+
+	f->hung_up++;
+	reply_ok(cb, data);
+}
+
+static void fake_generic(struct ofono_voicecall *vc, ofono_voicecall_cb_t cb,

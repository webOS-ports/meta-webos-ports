+/* ---- the headset end ----------------------------------------------------- */
+
+struct hf {
+	int fd;
+	GString *in;
+};
+
+static gboolean quit_cb(gpointer data)
+{
+	*(bool *) data = true;
+	return G_SOURCE_REMOVE;
+}
+
+/* Run the main loop for a while, collecting what the AG sends */
+static void spin(struct hf *hf, unsigned int ms)
+{
+	bool done = false;
+	char buf[512];
+	ssize_t n;
+
+	g_timeout_add(ms, quit_cb, &done);
+
+	while (!done) {
+		g_main_context_iteration(NULL, FALSE);
+
+		while (hf && (n = read(hf->fd, buf, sizeof(buf))) > 0)
+			g_string_append_len(hf->in, buf, n);
+
+		g_usleep(1000);
+	}
+}
+
+static void hf_send(struct hf *hf, const char *cmd)
+{
+	size_t len = strlen(cmd);
+
+	if (getenv("TEST_VERBOSE"))
+		fprintf(stderr, "HF > %s\n", cmd);
+
+	assert(write(hf->fd, cmd, len) == (ssize_t) len);
+	assert(write(hf->fd, "\r", 1) == 1);
+}
+
+/* Wait for a line from the AG, consuming everything up to and including it */
+static bool hf_expect(struct hf *hf, const char *line)
+{
+	unsigned int waited = 0;
+	char *pat = g_strdup_printf("\r\n%s\r\n", line);
+	bool found = false;
+
+	while (waited < 1000) {
+		const char *p = strstr(hf->in->str, pat);
+
+		if (p) {
+			g_string_erase(hf->in, 0, p - hf->in->str +
+						strlen(pat));
+			found = true;
+			break;
+		}
+
+		spin(hf, 10);
+		waited += 10;
+	}
+
+	if (!found)
+		fprintf(stderr, "expected \"%s\", have \"%s\"\n", line,
+			g_strescape(hf->in->str, NULL));
+
+	g_free(pat);
+	return found;
+}
+
+/* No such line within a short while */
+static bool hf_absent(struct hf *hf, const char *line)
+{
+	char *pat = g_strdup_printf("\r\n%s\r\n", line);
+	bool absent;
+
+	spin(hf, 100);
+	absent = strstr(hf->in->str, pat) == NULL;
+
+	if (!absent)
+		fprintf(stderr, "did not expect \"%s\" in \"%s\"\n", line,
+			g_strescape(hf->in->str, NULL));
+
+	g_free(pat);
+	return absent;
+}
+
+static void hf_flush(struct hf *hf)
+{
+	spin(hf, 50);
+	g_string_truncate(hf->in, 0);
+}

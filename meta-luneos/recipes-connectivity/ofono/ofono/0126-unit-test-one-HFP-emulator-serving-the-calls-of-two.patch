+/* ---- a model of the modem and atom layer --------------------------------- */
+
+struct ofono_modem {
+	char path[16];
+	GSList *atoms;
+	GSList *watches;
+	unsigned int next_watch;
+	unsigned int callids;
+};
+
+struct ofono_atom {
+	enum ofono_atom_type type;
+	void (*destruct)(struct ofono_atom *atom);
+	void (*unregister)(struct ofono_atom *atom);
+	void *data;
+	struct ofono_modem *modem;
+};
+
+struct atom_watch {
+	unsigned int id;
+	enum ofono_atom_type type;
+	ofono_atom_watch_func notify;
+	void *data;
+	ofono_destroy_func destroy;
+};
+
+struct ofono_atom *__ofono_modem_add_atom(struct ofono_modem *modem,
+					enum ofono_atom_type type,
+					void (*destruct)(struct ofono_atom *),
+					void *data)
+{
+	struct ofono_atom *atom = g_new0(struct ofono_atom, 1);
+
+	atom->type = type;
+	atom->destruct = destruct;
+	atom->data = data;
+	atom->modem = modem;
+	modem->atoms = g_slist_prepend(modem->atoms, atom);
+
+	return atom;
+}
+
+struct ofono_atom *__ofono_modem_add_atom_offline(struct ofono_modem *modem,
+					enum ofono_atom_type type,
+					void (*destruct)(struct ofono_atom *),
+					void *data)
+{
+	return __ofono_modem_add_atom(modem, type, destruct, data);
+}
+
+void *__ofono_atom_get_data(struct ofono_atom *atom)
+{
+	return atom->data;
+}
+
+const char *__ofono_atom_get_path(struct ofono_atom *atom)
+{
+	return atom->modem->path;
+}
+
+struct ofono_modem *__ofono_atom_get_modem(struct ofono_atom *atom)
+{
+	return atom->modem;
+}
+
+gboolean __ofono_atom_get_registered(struct ofono_atom *atom)
+{
+	return atom->unregister ? TRUE : FALSE;
+}
+
+static void call_watches(struct ofono_atom *atom,
+				enum ofono_atom_watch_condition cond)
+{
+	GSList *copy = g_slist_copy(atom->modem->watches);
+	GSList *l;
+
+	for (l = copy; l; l = l->next) {
+		struct atom_watch *w = l->data;
+
+		/* skip watches removed by an earlier one in this round */
+		if (!g_slist_find(atom->modem->watches, w))
+			continue;
+
+		if (w->type == atom->type)
+			w->notify(atom, cond, w->data);
+	}
+
+	g_slist_free(copy);
+}
+
+void __ofono_atom_register(struct ofono_atom *atom,
+				void (*unregister)(struct ofono_atom *))
+{
+	if (unregister == NULL)
+		return;
+
+	atom->unregister = unregister;
+	call_watches(atom, OFONO_ATOM_WATCH_CONDITION_REGISTERED);
+}
+
+static void atom_unregister(struct ofono_atom *atom)
+{
+	if (atom->unregister == NULL)
+		return;
+
+	call_watches(atom, OFONO_ATOM_WATCH_CONDITION_UNREGISTERED);
+	atom->unregister(atom);
+	atom->unregister = NULL;
+}
+
+void __ofono_atom_free(struct ofono_atom *atom)
+{
+	struct ofono_modem *modem = atom->modem;
+
+	modem->atoms = g_slist_remove(modem->atoms, atom);
+	atom_unregister(atom);
+
+	if (atom->destruct)
+		atom->destruct(atom);
+
+	g_free(atom);
+}
+
+unsigned int __ofono_modem_add_atom_watch(struct ofono_modem *modem,
+					enum ofono_atom_type type,
+					ofono_atom_watch_func notify,
+					void *data, ofono_destroy_func destroy)
+{
+	struct atom_watch *w = g_new0(struct atom_watch, 1);
+	GSList *l;
+
+	w->id = ++modem->next_watch;
+	w->type = type;
+	w->notify = notify;
+	w->data = data;
+	w->destroy = destroy;
+	modem->watches = g_slist_append(modem->watches, w);
+
+	for (l = modem->atoms; l; l = l->next) {
+		struct ofono_atom *atom = l->data;
+
+		if (atom->type == type && atom->unregister)
+			notify(atom, OFONO_ATOM_WATCH_CONDITION_REGISTERED,
+				data);
+	}
+
+	return w->id;
+}
+
+gboolean __ofono_modem_remove_atom_watch(struct ofono_modem *modem,
+						unsigned int id)
+{
+	GSList *l;
+
+	for (l = modem->watches; l; l = l->next) {
+		struct atom_watch *w = l->data;
+
+		if (w->id != id)
+			continue;
+
+		modem->watches = g_slist_delete_link(modem->watches, l);
+
+		if (w->destroy)
+			w->destroy(w->data);
+
+		g_free(w);
+		return TRUE;
+	}
+
+	return FALSE;
+}
+
+struct ofono_atom *__ofono_modem_find_atom(struct ofono_modem *modem,
+						enum ofono_atom_type type)
+{
+	GSList *l;
+
+	for (l = modem->atoms; l; l = l->next) {
+		struct ofono_atom *atom = l->data;
+
+		if (atom->type == type && atom->unregister)
+			return atom;
+	}
+
+	return NULL;
+}
+
+void __ofono_modem_foreach_registered_atom(struct ofono_modem *modem,
+						enum ofono_atom_type type,
+						ofono_atom_func callback,
+						void *data)
+{
+	GSList *l;
+
+	for (l = modem->atoms; l; l = l->next) {
+		struct ofono_atom *atom = l->data;
+
+		if (atom->type == type && atom->unregister)
+			callback(atom, data);
+	}
+}
+
+/* As flush_atoms() on power down: unregister, then free, in list order */
+static void modem_flush(struct ofono_modem *modem)
+{
+	while (modem->atoms) {
+		struct ofono_atom *atom = modem->atoms->data;
+
+		modem->atoms = g_slist_delete_link(modem->atoms,
+							modem->atoms);
+		atom_unregister(atom);
+
+		if (atom->destruct)
+			atom->destruct(atom);
+
+		g_free(atom);
+	}
+}
+
+unsigned int __ofono_modem_callid_next(struct ofono_modem *modem)
+{
+	unsigned int i;
+
+	for (i = 1; i < 32; i++)
+		if (!(modem->callids & (1u << i)))
+			return i;
+
+	return 0;
+}
+
+void __ofono_modem_callid_hold(struct ofono_modem *modem, int id)
+{
+	modem->callids |= 1u << id;
+}
+
+void __ofono_modem_callid_release(struct ofono_modem *modem, int id)
+{
+	modem->callids &= ~(1u << id);
+}

+/* ---- fixtures ------------------------------------------------------------ */
+
+static DBusConnection *conn;
+
+struct phone {
+	struct ofono_modem *modem[2];
+	struct ofono_sim *sim[2];
+	struct fake_vc fvc[2];
+	struct ofono_emulator *em;
+	struct hf hf;
+};
+
+static void sim_unregister(struct ofono_atom *atom)
+{
+}
+
+static void sim_destruct(struct ofono_atom *atom)
+{
+	g_free(__ofono_atom_get_data(atom));
+}
+
+static void modem_init(struct phone *p, int i)
+{
+	struct ofono_modem *modem = g_new0(struct ofono_modem, 1);
+	struct ofono_atom *sim_atom;
+
+	snprintf(modem->path, sizeof(modem->path), "/ril_%d", i);
+	p->modem[i] = modem;
+
+	p->sim[i] = g_new0(struct ofono_sim, 1);
+	snprintf(p->sim[i]->imsi, sizeof(p->sim[i]->imsi),
+			"20404000000000%d", i);
+	sim_atom = __ofono_modem_add_atom(modem, OFONO_ATOM_TYPE_SIM,
+						sim_destruct, p->sim[i]);
+	__ofono_atom_register(sim_atom, sim_unregister);
+
+	p->fvc[i].vc = ofono_voicecall_create(modem, 0, "fake", &p->fvc[i]);
+	assert(p->fvc[i].vc);
+	ofono_voicecall_register(p->fvc[i].vc);
+}
+
+static void phone_connect(struct phone *p, int n_modems)
+{
+	int sv[2];
+	int i;
+
+	assert(socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0);
+
+	p->em = ofono_emulator_create(OFONO_EMULATOR_TYPE_HFP);
+	assert(p->em);
+
+	for (i = 0; i < n_modems; i++)
+		ofono_emulator_add_modem(p->em, p->modem[i]);
+
+	ofono_emulator_register(p->em, sv[0]);
+
+	p->hf.fd = sv[1];
+	p->hf.in = g_string_new(NULL);
+	assert(fcntl(p->hf.fd, F_SETFL, O_NONBLOCK) == 0);
+
+	/* SLC: no three-way calling and no HF indicators, so CMER ends it */
+	hf_send(&p->hf, "AT+BRSF=0");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_send(&p->hf, "AT+CIND=?");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_send(&p->hf, "AT+CIND?");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_send(&p->hf, "AT+CMER=3,0,0,1");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_send(&p->hf, "AT+CLIP=1");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_flush(&p->hf);
+}
+
+static struct phone *phone_new(int n_modems_connected)
+{
+	struct phone *p = g_new0(struct phone, 1);
+
+	modem_init(p, 0);
+	modem_init(p, 1);
+	phone_connect(p, n_modems_connected);
+
+	return p;
+}
+
+static void phone_free(struct phone *p)
+{
+	int i;
+
+	/* The headset hangs up: the emulator goes with its last atom */
+	close(p->hf.fd);
+	spin(NULL, 50);
+
+	for (i = 0; i < 2; i++) {
+		if (p->modem[i] == NULL)
+			continue;
+
+		modem_flush(p->modem[i]);
+		assert(p->modem[i]->watches == NULL);
+		g_free(p->modem[i]);
+	}
+
+	g_string_free(p->hf.in, TRUE);
+	g_free(p);
+}
+
+static void call_notify(struct phone *p, int modem, int id, int status,
+			int direction, const char *number)
+{
+	struct ofono_call call;
+
+	ofono_call_init(&call);
+	call.id = id;
+	call.status = status;
+	call.direction = direction;
+	g_strlcpy(call.phone_number.number, number,
+			sizeof(call.phone_number.number));
+	call.phone_number.type = 145;
+	call.clip_validity = CLIP_VALIDITY_VALID;
+
+	ofono_voicecall_notify(p->fvc[modem].vc, &call);
+}
+
+static void call_gone(struct phone *p, int modem, int id)
+{
+	ofono_voicecall_disconnected(p->fvc[modem].vc, id,
+				OFONO_DISCONNECT_REASON_REMOTE_HANGUP, NULL);
+}
+
+/* ---- tests ------------------------------------------------------------- */
+
+/* A call on the second modem rings, with its number, and the first is idle */
+static void test_ring_second_modem(void)
+{
+	struct phone *p = phone_new(2);
+
+	call_notify(p, 1, 1, CALL_STATUS_INCOMING,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31612345678");
+	assert(hf_expect(&p->hf, "+CIEV: 3,1"));
+	assert(hf_expect(&p->hf, "RING"));
+	assert(hf_expect(&p->hf, "+CLIP: \"+31612345678\",145"));
+
+	call_gone(p, 1, 1);
+	assert(hf_expect(&p->hf, "+CIEV: 3,0"));
+
+	phone_free(p);
+}
+
+/* ATA and AT+CHUP for a call on the second modem go to that modem */
+static void test_answer_hangup_routed(void)
+{
+	struct phone *p = phone_new(2);
+
+	call_notify(p, 1, 1, CALL_STATUS_INCOMING,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31612345678");
+	assert(hf_expect(&p->hf, "+CIEV: 3,1"));
+
+	hf_send(&p->hf, "ATA");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[1].answered == 1);
+	assert(p->fvc[0].answered == 0);
+
+	call_notify(p, 1, 1, CALL_STATUS_ACTIVE,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31612345678");
+	assert(hf_expect(&p->hf, "+CIEV: 2,1"));
+	assert(hf_expect(&p->hf, "+CIEV: 3,0"));
+
+	hf_send(&p->hf, "AT+CLCC");
+	assert(hf_expect(&p->hf, "+CLCC: 1,1,0,0,0,\"+31612345678\",145"));
+	assert(hf_expect(&p->hf, "OK"));
+
+	hf_send(&p->hf, "AT+CHUP");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[1].hung_up == 1);
+	assert(p->fvc[0].hung_up == 0);
+
+	call_gone(p, 1, 1);
+	assert(hf_expect(&p->hf, "+CIEV: 2,0"));
+
+	phone_free(p);
+}
+
+/* The same on the first modem, so neither is special */
+static void test_answer_first_modem(void)
+{
+	struct phone *p = phone_new(2);
+
+	call_notify(p, 0, 1, CALL_STATUS_INCOMING,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31600000001");
+	assert(hf_expect(&p->hf, "RING"));
+	assert(hf_expect(&p->hf, "+CLIP: \"+31600000001\",145"));
+
+	hf_send(&p->hf, "ATA");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[0].answered == 1);
+	assert(p->fvc[1].answered == 0);
+
+	call_gone(p, 0, 1);
+	phone_free(p);
+}
+
+/*
+ * Indicators are merged: the idle modem reporting its state does not hide
+ * the other modem's active call.
+ */
+static void test_indicators_merged(void)
+{
+	struct phone *p = phone_new(2);
+
+	call_notify(p, 0, 1, CALL_STATUS_ACTIVE,
+			CALL_DIRECTION_MOBILE_ORIGINATED, "+31600000001");
+	assert(hf_expect(&p->hf, "+CIEV: 2,1"));
+
+	/* A short call comes and goes on the other modem */
+	call_notify(p, 1, 1, CALL_STATUS_ALERTING,
+			CALL_DIRECTION_MOBILE_ORIGINATED, "+31600000002");
+	call_notify(p, 1, 1, CALL_STATUS_ACTIVE,
+			CALL_DIRECTION_MOBILE_ORIGINATED, "+31600000002");
+	call_gone(p, 1, 1);
+	assert(hf_absent(&p->hf, "+CIEV: 2,0"));
+
+	/* The second modem going away entirely does not end it either */
+	modem_flush(p->modem[1]);
+	g_free(p->modem[1]);
+	p->modem[1] = NULL;
+	assert(hf_absent(&p->hf, "+CIEV: 2,0"));
+
+	call_gone(p, 0, 1);
+	assert(hf_expect(&p->hf, "+CIEV: 2,0"));
+
+	phone_free(p);
+}
+
+/* ATD dials on the first modem when idle, and next to an existing call */
+static void test_dial_choice(void)
+{
+	struct phone *p = phone_new(2);
+
+	hf_send(&p->hf, "ATD+31600000003;");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[0].dialled == 1);
+	assert(p->fvc[1].dialled == 0);
+	/* the driver gets the digits, the "+" goes into the type */
+	assert(!strcmp(p->fvc[0].dialled_number, "31600000003"));
+
+	/* The dial result has no call yet; the driver reports it */
+	call_notify(p, 0, 1, CALL_STATUS_DIALING,
+			CALL_DIRECTION_MOBILE_ORIGINATED, "+31600000003");
+	call_gone(p, 0, 1);
+	hf_flush(&p->hf);
+
+	call_notify(p, 1, 1, CALL_STATUS_ACTIVE,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31600000004");
+	hf_flush(&p->hf);
+
+	hf_send(&p->hf, "ATD+31600000005;");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[1].dialled == 1);
+	assert(p->fvc[0].dialled == 1);
+
+	call_gone(p, 1, 1);
+	phone_free(p);
+}
+
+/*
+ * The modem whose handlers answer goes away while the headset stays: the
+ * other modem's handlers take over, and nothing is left pointing at the
+ * departed one (run under ASan or valgrind to see the difference).
+ */
+static void test_first_modem_leaves(void)
+{
+	struct phone *p = phone_new(2);
+
+	modem_flush(p->modem[0]);
+	g_free(p->modem[0]);
+	p->modem[0] = NULL;
+	hf_flush(&p->hf);
+
+	call_notify(p, 1, 1, CALL_STATUS_INCOMING,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31612345678");
+	assert(hf_expect(&p->hf, "RING"));
+
+	hf_send(&p->hf, "ATA");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[1].answered == 1);
+
+	hf_send(&p->hf, "AT+CLCC");
+	assert(hf_expect(&p->hf, "OK"));
+
+	call_gone(p, 1, 1);
+	phone_free(p);
+}
+
+static unsigned int xtest_calls;
+static unsigned int xtest_destroyed;
+
+static void xtest_cb(struct ofono_emulator *em,
+			struct ofono_emulator_request *req, void *userdata)
+{
+	struct ofono_error ok = { .type = OFONO_ERROR_TYPE_NO_ERROR };
+
+	xtest_calls++;
+	ofono_emulator_send_final(em, &ok);
+}
+
+static void xtest_destroy(void *data)
+{
+	xtest_destroyed++;
+}
+
+/*
+ * A command only one modem answers goes with that modem: its handler is
+ * released when the modem leaves, not kept until the headset goes, and
+ * the command is no longer accepted.
+ */
+static void test_leaving_modem_takes_its_handlers(void)
+{
+	struct phone *p = phone_new(2);
+	struct ofono_atom *atom;
+
+	atom = __ofono_modem_find_atom(p->modem[0],
+					OFONO_ATOM_TYPE_EMULATOR_HFP);
+	assert(atom);
+	xtest_calls = xtest_destroyed = 0;
+	assert(__ofono_emulator_add_atom_handler(atom, "+XTEST", xtest_cb,
+						NULL, xtest_destroy));
+
+	hf_send(&p->hf, "AT+XTEST");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(xtest_calls == 1);
+
+	modem_flush(p->modem[0]);
+	g_free(p->modem[0]);
+	p->modem[0] = NULL;
+	assert(xtest_destroyed == 1);
+
+	hf_flush(&p->hf);
+	hf_send(&p->hf, "AT+XTEST");
+	assert(hf_expect(&p->hf, "ERROR"));
+	assert(xtest_calls == 1);
+
+	phone_free(p);
+	assert(xtest_destroyed == 1);
+}
+
+/* A modem added to a live link is served from then on */
+static void test_modem_joins_later(void)
+{
+	struct phone *p = phone_new(1);
+
+	ofono_emulator_add_modem(p->em, p->modem[1]);
+	/* adding twice is harmless */
+	ofono_emulator_add_modem(p->em, p->modem[1]);
+	hf_flush(&p->hf);
+
+	call_notify(p, 1, 1, CALL_STATUS_INCOMING,
+			CALL_DIRECTION_MOBILE_TERMINATED, "+31612345678");
+	assert(hf_expect(&p->hf, "+CIEV: 3,1"));
+	assert(hf_expect(&p->hf, "+CLIP: \"+31612345678\",145"));
+
+	hf_send(&p->hf, "ATA");
+	assert(hf_expect(&p->hf, "OK"));
+	assert(p->fvc[1].answered == 1);
+
+	call_gone(p, 1, 1);
+	phone_free(p);
+}
+
+/* AT+BAC: CVSD need not be first, but has to be there */
+static void test_bac_order(void)
+{
+	struct phone *p = phone_new(2);
+
+	hf_send(&p->hf, "AT+BAC=2,1");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_send(&p->hf, "AT+BAC=1,2");
+	assert(hf_expect(&p->hf, "OK"));
+	hf_send(&p->hf, "AT+BAC=2");
+	assert(hf_expect(&p->hf, "ERROR"));
+
+	phone_free(p);
+}
+
+int main(int argc, char **argv)
+{
+	DBusError err;
+	int r;
+
+	if (!getenv("DBUS_SESSION_BUS_ADDRESS")) {
+		printf("1..0 # SKIP needs a D-Bus bus, run under dbus-run-session\n");
+		return 0;
+	}
+
+	g_test_init(&argc, &argv, NULL);
+
+	dbus_error_init(&err);
+	conn = g_dbus_setup_private(DBUS_BUS_SESSION, NULL, &err);
+	assert(conn);
+	__ofono_dbus_init(conn);
+
+	g_test_add_func("/emulator-multimodem/ring-second-modem",
+				test_ring_second_modem);
+	g_test_add_func("/emulator-multimodem/answer-hangup-routed",
+				test_answer_hangup_routed);
+	g_test_add_func("/emulator-multimodem/answer-first-modem",
+				test_answer_first_modem);
+	g_test_add_func("/emulator-multimodem/indicators-merged",
+				test_indicators_merged);
+	g_test_add_func("/emulator-multimodem/dial-choice", test_dial_choice);
+	g_test_add_func("/emulator-multimodem/first-modem-leaves",
+				test_first_modem_leaves);
+	g_test_add_func("/emulator-multimodem/leaving-modem-takes-its-handlers",
+				test_leaving_modem_takes_its_handlers);
+	g_test_add_func("/emulator-multimodem/modem-joins-later",
+				test_modem_joins_later);
+	g_test_add_func("/emulator-multimodem/bac-order", test_bac_order);
+
+	r = g_test_run();
+
+	__ofono_dbus_cleanup();
+	dbus_connection_close(conn);
+	dbus_connection_unref(conn);
+
+	return r;
+}

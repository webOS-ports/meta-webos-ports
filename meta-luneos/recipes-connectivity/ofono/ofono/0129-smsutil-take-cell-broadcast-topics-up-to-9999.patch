--- a/unit/test-sms.c
+++ b/unit/test-sms.c
@@ -1505,8 +1505,10 @@ static void test_cbs_padding_character(void)
 
 static const char *ranges[] = { "1-5, 2, 3, 600, 569-900, 999",
 				"0-20, 33, 44, 50-60, 20-50, 1-5, 5, 3, 5",
+				"4370-4379,4383,4386-4392,4400",
+				"0-9999",
 				NULL };
-static const char *inv_ranges[] = { "1-5, 3333", "1-5, afbcd", "1-5, 3-5,,",
+static const char *inv_ranges[] = { "1-5, 10000", "1-5, afbcd", "1-5, 3-5,,",
 					"1-5, 3-5, c", NULL };
 
 static void test_range_minimizer(void)
@@ -1541,6 +1543,23 @@ static void test_range_minimizer(void)
 	}
 }
 
+/* What voicecall's channel catalog asks for in the Netherlands */
+static void test_range_public_warning(void)
+{
+	static const char topics[] = "4370-4379,4383,4386-4392,4400";
+	GSList *r = cbs_extract_topic_ranges(topics);
+	char *rangestr;
+
+	g_assert(r != NULL);
+
+	rangestr = cbs_topic_ranges_to_string(r);
+	g_assert(rangestr != NULL);
+	g_assert_cmpstr(rangestr, ==, topics);
+
+	g_free(rangestr);
+	g_slist_free_full(r, g_free);
+}
+
 static void test_sr_assembly(void)
 {
 	const char *sr_pdu1 = "06040D91945152991136F00160124130340A0160124130"
@@ -1795,6 +1814,9 @@ int main(int argc, char **argv)
 
 	g_test_add_func("/testsms/Range minimizer", test_range_minimizer);
 
+	g_test_add_func("/testsms/Public warning ranges",
+			test_range_public_warning);
+
 	g_test_add_func("/testsms/Status Report Assembly", test_sr_assembly);
 
 	g_test_add_data_func("/testsms/Test WAP Push 1", &wap_push_1,

From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] cbs: a public warning is not a base station id

A broadcast with geographical scope 00 was always taken for a base station
ID and went to the network name, never to IncomingBroadcast. TS 23.041
9.4.1.2.1 says scope 00 is intended for that and can be used for other
things too: it means cell wide, immediate display, which suits a warning.
Such a warning would have vanished into the operator name.

Whether a real EU-Alert uses scope 00 could not be established: Austria's
implementing rules fix it to 01 and nothing was found for the Netherlands.
This is for the case that one does.

So the message identifier has the last word: nothing in the warning range
of 9.4.1.2.2, 0x1100 to 0x18FF, is a base station ID. ETWS already had its
own branch ahead of this one, so this changes CMAS and EU-Alert.

The test is on a new function, since ofono_cbs_notify() needs a whole atom.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending

diff --git a/src/cbs.c b/src/cbs.c
index 843710e..7f9c59f 100644
--- a/src/cbs.c
+++ b/src/cbs.c
@@ -243,11 +243,7 @@ void ofono_cbs_notify(struct ofono_cbs *cbs, const unsigned char *pdu,
 		goto out;
 	}
 
-	/*
-	 * 3GPP 23.041: NOTE 5:	Code 00 is intended for use by the
-	 * network operators for base station IDs.
-	 */
-	if (c.gs == CBS_GEO_SCOPE_CELL_IMMEDIATE) {
+	if (cbs_is_base_station_id(&c)) {
 		cbs_dispatch_base_station_id(cbs, message);
 		goto out;
 	}
diff --git a/src/smsutil.c b/src/smsutil.c
index 7bf6a5e..41988f6 100644
--- a/src/smsutil.c
+++ b/src/smsutil.c
@@ -3910,6 +3910,21 @@ gboolean cbs_decode(const unsigned char *pdu, int len, struct cbs *out)
 	return TRUE;
 }
 
+/*
+ * 3GPP 23.041 9.4.1.2.1: geographical scope 00 is for base station IDs, and
+ * "can also be used for other applications". It means cell wide, immediate
+ * display, which a warning is free to ask for, so the message identifier has
+ * the last word: a warning is never the name of a cell.
+ */
+gboolean cbs_is_base_station_id(const struct cbs *cbs)
+{
+	if (cbs->gs != CBS_GEO_SCOPE_CELL_IMMEDIATE)
+		return FALSE;
+
+	return cbs->message_identifier < CBS_FIRST_WARNING_TOPIC ||
+			cbs->message_identifier > CBS_LAST_WARNING_TOPIC;
+}
+
 gboolean cbs_encode(const struct cbs *cbs, int *len, unsigned char *pdu)
 {
 	pdu[0] = (cbs->gs << 6) | ((cbs->message_code >> 4) & 0x3f);
diff --git a/src/smsutil.h b/src/smsutil.h
index e622b5f..3720b15 100644
--- a/src/smsutil.h
+++ b/src/smsutil.h
@@ -9,6 +9,10 @@ enum cbs_language;
 
 #define CBS_MAX_GSM_CHARS 93
 #define CBS_MAX_TOPIC 9999
+
+/* 3GPP 23.041 9.4.1.2.2: ETWS, CMAS, EU-Alert and the range kept for them */
+#define CBS_FIRST_WARNING_TOPIC 0x1100
+#define CBS_LAST_WARNING_TOPIC 0x18FF
 #define SMS_MSGID_LEN 20
 
 enum sms_type {
@@ -542,6 +546,7 @@ gboolean cbs_dcs_decode(guint8 dcs, gboolean *udhi, enum sms_class *cls,
 			enum cbs_language *language, gboolean *iso639);
 
 gboolean cbs_decode(const unsigned char *pdu, int len, struct cbs *out);
+gboolean cbs_is_base_station_id(const struct cbs *cbs);
 gboolean cbs_encode(const struct cbs *cbs, int *len, unsigned char *pdu);
 gboolean cbs_extract_app_port(const struct cbs *cbs, int *dst, int *src,
 				gboolean *is_8bit);
diff --git a/unit/test-sms.c b/unit/test-sms.c
index 15322da..f2c2a39 100644
--- a/unit/test-sms.c
+++ b/unit/test-sms.c
@@ -1560,6 +1560,36 @@ static void test_range_public_warning(void)
 	g_slist_free_full(r, g_free);
 }
 
+static void test_base_station_id(void)
+{
+	struct cbs c;
+
+	memset(&c, 0, sizeof(c));
+	c.gs = CBS_GEO_SCOPE_CELL_IMMEDIATE;
+
+	c.message_identifier = 50;
+	g_assert(cbs_is_base_station_id(&c));
+
+	/* Either side of the warning range */
+	c.message_identifier = 0x10FF;
+	g_assert(cbs_is_base_station_id(&c));
+	c.message_identifier = 0x1900;
+	g_assert(cbs_is_base_station_id(&c));
+
+	/* EU-Alert level 1, and the ends of the range */
+	c.message_identifier = 4370;
+	g_assert(!cbs_is_base_station_id(&c));
+	c.message_identifier = 0x1100;
+	g_assert(!cbs_is_base_station_id(&c));
+	c.message_identifier = 0x18FF;
+	g_assert(!cbs_is_base_station_id(&c));
+
+	/* Any other scope is an ordinary message, whatever the identifier */
+	c.gs = CBS_GEO_SCOPE_PLMN;
+	c.message_identifier = 50;
+	g_assert(!cbs_is_base_station_id(&c));
+}
+
 static void test_sr_assembly(void)
 {
 	const char *sr_pdu1 = "06040D91945152991136F00160124130340A0160124130"
@@ -1817,6 +1847,8 @@ int main(int argc, char **argv)
 	g_test_add_func("/testsms/Public warning ranges",
 			test_range_public_warning);
 
+	g_test_add_func("/testsms/Base station id", test_base_station_id);
+
 	g_test_add_func("/testsms/Status Report Assembly", test_sr_assembly);
 
 	g_test_add_data_func("/testsms/Test WAP Push 1", &wap_push_1,

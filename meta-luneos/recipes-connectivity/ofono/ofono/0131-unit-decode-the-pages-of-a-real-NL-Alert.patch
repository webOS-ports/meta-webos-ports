From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] unit: decode the pages of a real NL-Alert

Three pages of the national test of 2023-12-04 as a modem delivered them:
channel 4371, Dutch, and a last page of 65 bytes where the others have 88.
The tests so far only knew pages built for the tests.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>

Upstream-Status: Pending
---
diff --git a/unit/test-sms.c b/unit/test-sms.c
index f2c2a39..28cf4e1 100644
--- a/unit/test-sms.c
+++ b/unit/test-sms.c
@@ -1455,6 +1455,67 @@ static void test_cbs_assembly(void)
 	cbs_assembly_free(assembly);
 }
 
+/*
+ * The three pages of the national NL-Alert test of 2023-12-04, as a modem
+ * delivered them (published by the Phosh project). The last page is short.
+ */
+static const char *nl_alert_page[] = {
+	"46A0111305134E662BC82ECBE92018AD1593B56430D90C1493E960301D885A9C52"
+	"8545697288A4BA40C432E86D2FCBD1E53419740F87E5F331BA7EA783D465103DAD"
+	"2697DD7390FBFD26CFD3F47A989E2ECF41F67418E404",
+	"46A011130523CC56905D96D35D206519C42E97E7741039EC06DDC37490BA0C6ABF"
+	"CB7410F95D7683CA6ED03D1C9683D46550BB5C9683D26EF35BDE0ED3D365D03AEC"
+	"06D9D36E72D9ED02A9542A10B538A5829AC5E9347804",
+	"46A0111305334590B34C4797E5ECB09B3C071DDFF6B2DCDD2EBBE920685DCC4E8F"
+	"41D7B0DC9D769F41D3FC9C5E6EBB40CE37283CA6A7DF6E90BC1CAFA7E565B2AB",
+};
+
+static void test_cbs_nl_alert(void)
+{
+	static const char text[] = "NL-Alert 04-12-2023 12:00: TESTBERICHT. "
+		"De overheid waarschuwt je tijdens noodsituaties via NL-Alert. "
+		"Je leest dan wat je moet doen en waar je meer informatie kan "
+		"vinden. *** TEST MESSAGE Netherlands Government Public "
+		"Warning System. No action required.";
+	struct cbs_assembly *assembly = cbs_assembly_new();
+	GSList *l = NULL;
+	struct cbs dec;
+	char iso639_lang[3];
+	char *utf8;
+	unsigned int i;
+
+	g_assert(assembly);
+
+	for (i = 0; i < L_ARRAY_SIZE(nl_alert_page); i++) {
+		size_t pdu_len;
+		unsigned char *pdu = l_util_from_hexstring(nl_alert_page[i],
+								&pdu_len);
+
+		g_assert(pdu);
+		g_assert(pdu_len == (i < 2 ? 88 : 65));
+		g_assert(cbs_decode(pdu, pdu_len, &dec));
+		l_free(pdu);
+
+		g_assert(dec.message_identifier == 4371);
+		g_assert(dec.dcs == 0x05);
+		g_assert(dec.max_pages == 3);
+		g_assert(dec.page == i + 1);
+
+		g_assert(l == NULL);
+		l = cbs_assembly_add_page(assembly, &dec);
+	}
+
+	g_assert(l);
+	utf8 = cbs_decode_text(l, iso639_lang);
+	g_assert(utf8);
+	g_assert_cmpstr(utf8, ==, text);
+	g_assert_cmpstr(iso639_lang, ==, "nl");
+
+	g_free(utf8);
+	g_slist_free_full(l, g_free);
+	cbs_assembly_free(assembly);
+}
+
 static void test_cbs_padding_character(void)
 {
 	unsigned char *decoded_pdu;
@@ -1839,6 +1900,8 @@ int main(int argc, char **argv)
 			test_cbs_encode_decode);
 	g_test_add_func("/testsms/Test CBS Assembly", test_cbs_assembly);
 
+	g_test_add_func("/testsms/Test NL-Alert CBS",
+					test_cbs_nl_alert);
 	g_test_add_func("/testsms/Test CBS Padding Character",
 			test_cbs_padding_character);
 

+
+struct ofono_modem *__ofono_atom_get_modem(struct ofono_atom *atom)
+{
+	return atom->modem;
+}
+
+void __ofono_atom_register(struct ofono_atom *atom,
+				void (*unregister)(struct ofono_atom *))
+{
+	atom->unregister = unregister;
+}
+
+/* As __ofono_atom_free() in src/modem.c: unregister, then destruct */
+void __ofono_atom_free(struct ofono_atom *atom)
+{
+	struct ofono_modem *modem = atom->modem;
+
+	modem->atoms = g_slist_remove(modem->atoms, atom);
+
+	if (atom->unregister) {
+		atom->unregister(atom);
+		atom->unregister = NULL;
+	}
+
+	if (atom->destruct)
+		atom->destruct(atom);
+
+	g_free(atom);
+}
+
+unsigned int __ofono_modem_add_atom_watch(struct ofono_modem *modem,
+					enum ofono_atom_type type,
+					ofono_atom_watch_func notify,
+					void *data, ofono_destroy_func destroy)
+{
+	struct atom_watch *w = g_new0(struct atom_watch, 1);
+
+	w->id = ++modem->next_watch;
+	w->destroy = destroy;
+	w->data = data;
+	modem->watches = g_slist_append(modem->watches, w);
+
+	return w->id;
+}
+
+gboolean __ofono_modem_remove_atom_watch(struct ofono_modem *modem,
+						unsigned int id)
+{
+	GSList *l;
+
+	for (l = modem->watches; l; l = l->next) {
+		struct atom_watch *w = l->data;
+
+		if (w->id != id)
+			continue;
+
+		modem->watches = g_slist_delete_link(modem->watches, l);
+
+		if (w->destroy)
+			w->destroy(w->data);
+
+		g_free(w);
+		return TRUE;
+	}
+
+	return FALSE;
+}

+/* Registering on an operator is not queued, in Sailfish neither */
+static void test_netreg_manual(void)
+{
+	struct call a = { 0 }, b = { 0 }, c = { 0 }, d = { 0 }, e = { 0 };
+	const char *path = NULL;
+	char *op_path;
+
+	netreg_setup();
+
+	scan(&a);
+	flush();
+	op_finish(OP_SCAN, TRUE);
+	flush();
+	assert_ok(&a);
+	g_assert_cmpuint(scan_result(&a, &path), ==, 1);
+	op_path = g_strdup(path);
+
+	/* While something runs: InProgress at once */
+	scan(&b);
+	flush();
+	call_method(&c, op_path, OFONO_NETWORK_OPERATOR_INTERFACE, "Register");
+	flush();
+	assert_error(&c, ERR_BUSY);
+	op_finish(OP_SCAN, TRUE);
+	flush();
+	assert_ok(&b);
+
+	/* A Scan behind it survives its failure, and runs */
+	call_method(&d, op_path, OFONO_NETWORK_OPERATOR_INTERFACE, "Register");
+	scan(&e);
+	flush();
+	g_assert_cmpuint(ops_started, ==, 3);
+	op_finish(OP_REGISTER_MANUAL, FALSE);
+	flush();
+	assert_error(&d, ERR_FAILED);
+	g_assert_cmpuint(e.replies, ==, 0);
+	g_assert_cmpuint(ops_started, ==, 4);
+	op_finish(OP_SCAN, TRUE);
+	flush();
+	assert_ok(&e);
+
+	g_free(op_path);
+	test_end();
+	call_done(&a);
+	call_done(&b);
+	call_done(&c);
+	call_done(&d);
+	call_done(&e);
+}

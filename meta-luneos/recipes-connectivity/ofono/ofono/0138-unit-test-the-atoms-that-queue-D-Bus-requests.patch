+	g_assert_cmpstr(prop_string(&c, SCA), ==, "+31600000000");
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+	call_done(&c);
+}
+
+/* As before: no SCA is no error, and the next client queries again */
+static void test_sms_get_failed(void)
+{
+	struct call a = { 0 }, b = { 0 }, c = { 0 };
+
+	sms_setup();
+
+	sms_get(&a);
+	sms_get(&b);
+	flush();
+	op_finish(OP_SCA_QUERY, FALSE);
+	flush();
+	assert_ok(&a);
+	assert_ok(&b);
+	g_assert_cmpuint(ops_started, ==, 1);
+
+	sms_get(&c);
+	flush();
+	g_assert_cmpuint(ops_started, ==, 2);
+	op_finish(OP_SCA_QUERY, TRUE);
+	flush();
+	assert_ok(&c);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+	call_done(&c);
+}
+
+/* SetProperty and GetProperties do not wait for each other any more */
+static void test_sms_set_and_get(void)
+{
+	struct call a = { 0 }, b = { 0 };
+
+	sms_setup();
+
+	sms_get(&a);
+	flush();
+	set_property(&b, MM, SCA, "+31600000001");
+	flush();
+	g_assert_cmpuint(ops_started, ==, 2);
+
+	op_finish(OP_SCA_QUERY, TRUE);
+	flush();
+	assert_ok(&a);
+	g_assert_cmpuint(b.replies, ==, 0);
+
+	op_finish(OP_SCA_SET, TRUE);
+	flush();
+	op_finish(OP_SCA_QUERY, TRUE);
+	flush();
+	assert_ok(&b);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+}
+
+static void test_sms_removed(void)
+{
+	struct call a = { 0 }, b = { 0 };
+
+	sms_setup();
+
+	sms_get(&a);
+	sms_get(&b);
+	flush();
+
+	modem_flush();
+	assert_error(&a, ERR_CANCELED);
+	assert_error(&b, ERR_CANCELED);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+}
+
+static void test_sms_removed_driver_answers(void)
+{
+	struct call a = { 0 }, b = { 0 };
+
+	sms_setup();
+
+	sms_get(&a);
+	sms_get(&b);
+	flush();
+
+	fail_ops_on_remove = TRUE;
+	modem_flush();
+	assert_error(&a, ERR_CANCELED);
+	assert_error(&b, ERR_CANCELED);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+}
+
+/* ---- org.ofono.CallForwarding -------------------------------------------- */
+
+#define CF OFONO_CALL_FORWARDING_INTERFACE
+
+static void cf_setup(void)
+{
+	struct ofono_call_forwarding *cf;
+
+	test_begin();
+	cf = ofono_call_forwarding_create(&modem, 0, "test", NULL);
+	assert(cf);
+	ofono_call_forwarding_register(cf);
+}
+
+static void cf_get(struct call *call)
+{
+	call_method(call, MODEM_PATH, CF, "GetProperties");
+}
+
+/* One query per condition, then everyone waiting is told */
+static void cf_finish_query(void)
+{
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		flush();
+		op_finish(OP_CF_QUERY, TRUE);
+	}
+
+	flush();
+}
+
+static void test_cf_single(void)
+{
+	struct call a = { 0 }, b = { 0 };
+
+	cf_setup();
+
+	cf_get(&a);
+	flush();
+	g_assert_cmpuint(ops_started, ==, 1);
+	g_assert_cmpuint(a.replies, ==, 0);
+	cf_finish_query();
+	assert_ok(&a);
+	g_assert_cmpuint(ops_started, ==, 4);
+
+	cf_get(&b);
+	flush();
+	assert_ok(&b);
+	g_assert_cmpuint(ops_started, ==, 4);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+}
+
+static void test_cf_get_shared(void)
+{
+	struct call a = { 0 }, b = { 0 }, c = { 0 };
+
+	cf_setup();
+
+	cf_get(&a);
+	flush();
+
+	/* Half way through the conditions counts as well */
+	op_finish(OP_CF_QUERY, TRUE);
+	cf_get(&b);
+	cf_get(&c);
+	flush();
+	g_assert_cmpuint(a.replies + b.replies + c.replies, ==, 0);
+
+	op_finish(OP_CF_QUERY, TRUE);
+	flush();
+	op_finish(OP_CF_QUERY, TRUE);
+	flush();
+	op_finish(OP_CF_QUERY, TRUE);
+	flush();
+	assert_ok(&a);
+	assert_ok(&b);
+	assert_ok(&c);
+	g_assert_cmpuint(ops_started, ==, 4);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+	call_done(&c);
+}
+
+/* Changing something during the query is still InProgress */
+static void test_cf_set_during_get(void)
+{
+	struct call a = { 0 }, b = { 0 };
+
+	cf_setup();
+
+	cf_get(&a);
+	flush();
+	set_property(&b, CF, "VoiceUnconditional", "+31600000001");
+	flush();
+	assert_error(&b, ERR_BUSY);
+	g_assert_cmpuint(a.replies, ==, 0);
+	cf_finish_query();
+	assert_ok(&a);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+}
+
+/* USSD still blocks a query about to start, not one that is running */
+static void test_cf_ussd_busy(void)
+{
+	struct call a = { 0 }, b = { 0 }, c = { 0 };
+
+	cf_setup();
+
+	test_ussd_busy = TRUE;
+	cf_get(&a);
+	flush();
+	assert_error(&a, ERR_BUSY);
+	test_ussd_busy = FALSE;
+
+	cf_get(&b);
+	flush();
+	test_ussd_busy = TRUE;
+	cf_get(&c);
+	flush();
+	g_assert_cmpuint(c.replies, ==, 0);
+	test_ussd_busy = FALSE;
+	cf_finish_query();
+	assert_ok(&b);
+	assert_ok(&c);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+	call_done(&c);
+}
+
+static void test_cf_removed(void)
+{
+	struct call a = { 0 }, b = { 0 };
+
+	cf_setup();
+
+	cf_get(&a);
+	cf_get(&b);
+	flush();
+
+	modem_flush();
+	assert_error(&a, ERR_CANCELED);
+	assert_error(&b, ERR_CANCELED);
+
+	test_end();
+	call_done(&a);
+	call_done(&b);
+}
+
+int main(int argc, char **argv)
+{
+	test_dbus_require_bus();
+
+	g_test_init(&argc, &argv, NULL);
+
+#define T(name) g_test_add_func("/dbus-queue-atoms/" #name, test_ ## name)
+	T(netreg_single);
+	T(netreg_scan_shared);
+	T(netreg_scan_failed);
+	T(netreg_register_queued);
+	T(netreg_register_failed);
+	T(netreg_mixed);
+	T(netreg_sync_failure);
+	T(netreg_manual);
+	T(netreg_removed);
+	T(netreg_removed_driver_answers);
+	T(radio_single);
+	T(radio_get_shared);
+	T(radio_get_failed);
+	T(radio_get_after_set);
+	T(radio_set_back);
+	T(radio_bad_request_queued);
+	T(radio_removed);
+	T(radio_removed_driver_answers);
+	T(sms_single);
+	T(sms_get_shared);
+	T(sms_get_failed);
+	T(sms_set_and_get);
+	T(sms_removed);
+	T(sms_removed_driver_answers);
+	T(cf_single);
+	T(cf_get_shared);
+	T(cf_set_during_get);
+	T(cf_ussd_busy);
+	T(cf_removed);
+#undef T
+
+	return g_test_run();
+}

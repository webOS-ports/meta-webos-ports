+/* ---- the client end ------------------------------------------------------ */
+
+struct call {
+	unsigned int replies;
+	char *error;
+	DBusMessage *reply;
+};
+
+static struct test_dbus_context dbus;
+static struct ofono_modem modem;
+static unsigned int stray_replies;
+static guint timeout_id;
+
+static gboolean test_timeout(gpointer data)
+{
+	assert(!"TIMEOUT");
+	return G_SOURCE_REMOVE;
+}
+
+/* A reply the client is not waiting for comes this way: a second answer */
+static DBusHandlerResult client_filter(DBusConnection *conn, DBusMessage *msg,
+					void *data)
+{
+	int type = dbus_message_get_type(msg);
+
+	if (type == DBUS_MESSAGE_TYPE_METHOD_RETURN ||
+			type == DBUS_MESSAGE_TYPE_ERROR)
+		stray_replies++;
+
+	return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static void on_reply(DBusPendingCall *pending, void *data)
+{
+	struct call *call = data;
+	DBusMessage *reply = dbus_pending_call_steal_reply(pending);
+
+	call->replies++;
+
+	if (dbus_message_get_type(reply) == DBUS_MESSAGE_TYPE_ERROR)
+		call->error = g_strdup(dbus_message_get_error_name(reply));
+
+	if (call->reply)
+		dbus_message_unref(call->reply);
+
+	call->reply = reply;
+	dbus_pending_call_unref(pending);
+}
+
+static void call_done(struct call *call)
+{
+	g_free(call->error);
+
+	if (call->reply)
+		dbus_message_unref(call->reply);
+}
+
+static void test_begin(void)
+{
+	memset(&dbus, 0, sizeof(dbus));
+	memset(&modem, 0, sizeof(modem));
+	stray_replies = 0;
+	ops_started = 0;
+	sync_fail_kind = -1;
+	fail_ops_on_remove = FALSE;
+	test_ussd_busy = FALSE;
+
+	timeout_id = g_timeout_add_seconds(30, test_timeout, NULL);
+
+	test_dbus_setup(&dbus);
+	assert(dbus_connection_add_filter(dbus.client_connection,
+						client_filter, NULL, NULL));
+}
+
+/* Returns when everything sent so far was handled and answered */
+static void flush(void)
+{
+	struct call ping = { 0 };
+
+	test_dbus_send(&dbus, test_dbus_new_call(&dbus, "/",
+				"org.freedesktop.DBus.Peer", "Ping"),
+				on_reply, &ping);
+
+	while (!ping.replies)
+		g_main_context_iteration(NULL, TRUE);
+
+	g_assert_cmpstr(ping.error, ==, NULL);
+	call_done(&ping);
+}
+
+static void modem_flush(void)
+{
+	while (modem.atoms)
+		__ofono_atom_free(modem.atoms->data);
+
+	flush();
+}
+
+static void test_end(void)
+{
+	modem_flush();
+	g_assert_cmpuint(stray_replies, ==, 0);
+	assert(g_queue_is_empty(&ops));
+
+	dbus_connection_remove_filter(dbus.client_connection, client_filter,
+					NULL);
+	test_dbus_shutdown(&dbus);
+	g_source_remove(timeout_id);
+}
+
+static void call_method(struct call *call, const char *path, const char *iface,
+			const char *method)
+{
+	test_dbus_send(&dbus, test_dbus_new_call(&dbus, path, iface, method),
+			on_reply, call);
+}
+
+static void set_property(struct call *call, const char *iface,
+				const char *name, const char *value)
+{
+	DBusMessage *msg = test_dbus_new_call(&dbus, MODEM_PATH, iface,
+							"SetProperty");
+	DBusMessageIter iter, var;
+
+	dbus_message_iter_init_append(msg, &iter);
+	dbus_message_iter_append_basic(&iter, DBUS_TYPE_STRING, &name);
+	dbus_message_iter_open_container(&iter, DBUS_TYPE_VARIANT,
+					DBUS_TYPE_STRING_AS_STRING, &var);
+	dbus_message_iter_append_basic(&var, DBUS_TYPE_STRING, &value);
+	dbus_message_iter_close_container(&iter, &var);
+
+	test_dbus_send(&dbus, msg, on_reply, call);
+}
+
+static const char *prop_string(struct call *call, const char *name)
+{
+	DBusMessageIter iter, dict;
+
+	assert(call->reply);
+	assert(dbus_message_iter_init(call->reply, &iter));
+	dbus_message_iter_recurse(&iter, &dict);
+
+	while (dbus_message_iter_get_arg_type(&dict) == DBUS_TYPE_DICT_ENTRY) {
+		DBusMessageIter entry, var;
+		const char *key;
+		const char *value;
+
+		dbus_message_iter_recurse(&dict, &entry);
+		dbus_message_iter_get_basic(&entry, &key);
+		dbus_message_iter_next(&entry);
+		dbus_message_iter_recurse(&entry, &var);
+
+		if (!strcmp(key, name)) {
+			dbus_message_iter_get_basic(&var, &value);
+			return value;
+		}
+
+		dbus_message_iter_next(&dict);
+	}
+
+	return NULL;
+}
+
+/* Number of operators in a Scan reply, and the path of the last one */
+static unsigned int scan_result(struct call *call, const char **path)
+{
+	DBusMessageIter iter, array;
+	unsigned int n = 0;
+
+	assert(call->reply);
+	g_assert_cmpstr(dbus_message_get_signature(call->reply), ==,
+							"a(oa{sv})");
+	assert(dbus_message_iter_init(call->reply, &iter));
+	dbus_message_iter_recurse(&iter, &array);
+
+	while (dbus_message_iter_get_arg_type(&array) == DBUS_TYPE_STRUCT) {
+		DBusMessageIter st;
+
+		dbus_message_iter_recurse(&array, &st);
+
+		if (path)
+			dbus_message_iter_get_basic(&st, path);
+
+		n++;
+		dbus_message_iter_next(&array);
+	}
+
+	return n;
+}
+
+static void assert_ok(struct call *call)
+{
+	g_assert_cmpuint(call->replies, ==, 1);
+	g_assert_cmpstr(call->error, ==, NULL);
+}
+
+static void assert_error(struct call *call, const char *error)
+{
+	g_assert_cmpuint(call->replies, ==, 1);
+	g_assert_cmpstr(call->error, ==, error);
+}

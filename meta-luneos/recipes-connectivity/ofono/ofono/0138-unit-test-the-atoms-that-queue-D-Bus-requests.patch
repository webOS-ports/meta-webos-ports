+/* ---- scripted drivers --------------------------------------------------- */
+
+enum op_kind {
+	OP_SCAN,
+	OP_REGISTER_AUTO,
+	OP_REGISTER_MANUAL,
+	OP_RAT_QUERY,
+	OP_RAT_SET,
+	OP_SCA_QUERY,
+	OP_SCA_SET,
+	OP_CF_QUERY,
+};
+
+struct op {
+	enum op_kind kind;
+	void *cb;
+	void *data;
+	unsigned int mode;
+};
+
+/* The driver operations the atoms have started and not finished */
+static GQueue ops = G_QUEUE_INIT;
+static unsigned int ops_started;
+
+/* The next operation of this kind fails within the driver call */
+static int sync_fail_kind = -1;
+
+/* The driver is being removed: starting anything now is a bug */
+static gboolean driver_removing;
+
+/* The driver's remove() finishes what it has, with an error */
+static gboolean fail_ops_on_remove;
+
+static const struct ofono_error error_ok = { OFONO_ERROR_TYPE_NO_ERROR, 0 };
+static const struct ofono_error error_failed = { OFONO_ERROR_TYPE_FAILURE, 0 };
+
+static const struct ofono_network_operator test_operator = {
+	.name = "Test",
+	.mcc = "204",
+	.mnc = "08",
+	.status = OPERATOR_STATUS_AVAILABLE,
+	.tech = ACCESS_TECHNOLOGY_GSM,
+};
+
+static void op_run(struct op *op, gboolean ok)
+{
+	const struct ofono_error *e = ok ? &error_ok : &error_failed;
+
+	switch (op->kind) {
+	case OP_SCAN:
+		((ofono_netreg_operator_list_cb_t) op->cb)(e, ok ? 1 : 0,
+					ok ? &test_operator : NULL, op->data);
+		break;
+	case OP_REGISTER_AUTO:
+	case OP_REGISTER_MANUAL:
+		((ofono_netreg_register_cb_t) op->cb)(e, op->data);
+		break;
+	case OP_RAT_QUERY:
+		((ofono_radio_settings_rat_mode_query_cb_t) op->cb)(e,
+				OFONO_RADIO_ACCESS_MODE_UMTS, op->data);
+		break;
+	case OP_RAT_SET:
+		((ofono_radio_settings_rat_mode_set_cb_t) op->cb)(e, op->data);
+		break;
+	case OP_SCA_QUERY: {
+		struct ofono_phone_number sca = { .type = 145 };
+
+		strcpy(sca.number, "31600000000");
+		((ofono_sms_sca_query_cb_t) op->cb)(e, ok ? &sca : NULL,
+								op->data);
+		break;
+	}
+	case OP_SCA_SET:
+		((ofono_sms_sca_set_cb_t) op->cb)(e, op->data);
+		break;
+	case OP_CF_QUERY:
+		((ofono_call_forwarding_query_cb_t) op->cb)(e, 0, NULL,
+								op->data);
+		break;
+	}
+}
+
+static void op_add(enum op_kind kind, void *cb, void *data, unsigned int mode)
+{
+	struct op *op = g_new0(struct op, 1);
+
+	assert(!driver_removing);
+
+	op->kind = kind;
+	op->cb = cb;
+	op->data = data;
+	op->mode = mode;
+	ops_started++;
+
+	if ((int) kind == sync_fail_kind) {
+		sync_fail_kind = -1;
+		op_run(op, FALSE);
+		g_free(op);
+		return;
+	}
+
+	g_queue_push_tail(&ops, op);
+}
+
+/* Finishes the oldest operation, which must be of this kind */
+static void op_finish(enum op_kind kind, gboolean ok)
+{
+	struct op *op = g_queue_pop_head(&ops);
+
+	assert(op);
+	g_assert_cmpint(op->kind, ==, kind);
+	op_run(op, ok);
+	g_free(op);
+}
+
+static void driver_remove_common(void)
+{
+	struct op *op;
+
+	driver_removing = TRUE;
+
+	while (fail_ops_on_remove && (op = g_queue_pop_head(&ops))) {
+		op_run(op, FALSE);
+		g_free(op);
+	}
+
+	/* A driver cancels the rest without calling back */
+	g_queue_clear_full(&ops, g_free);
+	driver_removing = FALSE;
+}
+
+static int netreg_probe(struct ofono_netreg *netreg, unsigned int vendor,

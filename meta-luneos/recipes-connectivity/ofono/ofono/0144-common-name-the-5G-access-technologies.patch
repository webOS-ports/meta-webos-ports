From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] common: name the 5G access technologies

The public access technology enumeration has the 27.007 values for 5G
(EUTRA_5GCN, NR_5GCN, NG_RAN and EUTRA_NR), but
registration_tech_to_string() stops at NB_IOT_NB1, so a driver that
reports one of them gets an empty name. NetworkRegistration.Technology
and the operator Technologies then read "", and a client has no idea
what the modem is on.

Seen on a FuriLabs FLX1s (radon, HIDL radio) on an LTE cell with an NR
leg: ofono-binder-plugin reported EUTRA_NR, Technology was "", and the
status bar showed no network type at all. The same phone on Sailfish
OS-derived oFono shows "nr" there.

Name them the way Sailfish OS's oFono does: LTE on a 5G core is still
LTE on the air, so EUTRA_5GCN is "lte"; NR standalone, NG-RAN and LTE
with an NR leg (EN-DC) are "nr". Add the common.h aliases the other
technologies have, list "nr" in the API document, and test the names.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 doc/network-api.txt |    4 ++--
 src/common.c        |    8 ++++++++
 src/common.h        |    4 ++++
 unit/test-common.c  |   20 ++++++++++++++++++++
 4 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/doc/network-api.txt b/doc/network-api.txt
--- a/doc/network-api.txt
+++ b/doc/network-api.txt
@@ -118,7 +118,7 @@
 			Contains the technology of the current network.
 
 			The possible values are: "gsm", "edge", "umts", "hspa",
-							"lte"
+							"lte", "nr"
 
 		string Name [readonly]
 
@@ -201,7 +201,7 @@
 			from this network provider.
 
 			The possible values are: "gsm", "edge", "umts", "hspa",
-							"lte"
+							"lte", "nr"
 
 		string AdditionalInformation [readonly, optional]
 
diff --git a/src/common.c b/src/common.c
--- a/src/common.c
+++ b/src/common.c
@@ -659,6 +659,14 @@
 		return "lte-cat-m1";
 	case ACCESS_TECHNOLOGY_NB_IOT_NB1:
 		return "lte-cat-nb1";
+	/* LTE connected to a 5G core is still LTE on the air */
+	case ACCESS_TECHNOLOGY_EUTRA_5GCN:
+		return "lte";
+	/* NR standalone, NG-RAN, and LTE with an NR leg (EN-DC) */
+	case ACCESS_TECHNOLOGY_NR_5GCN:
+	case ACCESS_TECHNOLOGY_NG_RAN:
+	case ACCESS_TECHNOLOGY_EUTRA_NR:
+		return "nr";
 	default:
 		return "";
 	}
diff --git a/src/common.h b/src/common.h
--- a/src/common.h
+++ b/src/common.h
@@ -23,6 +23,10 @@
 #define ACCESS_TECHNOLOGY_EUTRAN                   OFONO_ACCESS_TECHNOLOGY_EUTRAN
 #define ACCESS_TECHNOLOGY_NB_IOT_M1                OFONO_ACCESS_TECHNOLOGY_NB_IOT_M1
 #define ACCESS_TECHNOLOGY_NB_IOT_NB1               OFONO_ACCESS_TECHNOLOGY_NB_IOT_NB1
+#define ACCESS_TECHNOLOGY_EUTRA_5GCN               OFONO_ACCESS_TECHNOLOGY_EUTRA_5GCN
+#define ACCESS_TECHNOLOGY_NR_5GCN                  OFONO_ACCESS_TECHNOLOGY_NR_5GCN
+#define ACCESS_TECHNOLOGY_NG_RAN                   OFONO_ACCESS_TECHNOLOGY_NG_RAN
+#define ACCESS_TECHNOLOGY_EUTRA_NR                 OFONO_ACCESS_TECHNOLOGY_EUTRA_NR
 
 /* 27.007 Section 7.2 <stat> */
 /* Defined publicly as enum ofono_netreg_status */
diff --git a/unit/test-common.c b/unit/test-common.c
--- a/unit/test-common.c
+++ b/unit/test-common.c
@@ -172,6 +172,25 @@
 	}
 }
 
+static void test_tech_names(void)
+{
+	g_assert_cmpstr(registration_tech_to_string(ACCESS_TECHNOLOGY_GSM),
+								==, "gsm");
+	g_assert_cmpstr(registration_tech_to_string(ACCESS_TECHNOLOGY_EUTRAN),
+								==, "lte");
+	g_assert_cmpstr(registration_tech_to_string(
+				ACCESS_TECHNOLOGY_EUTRA_5GCN), ==, "lte");
+	g_assert_cmpstr(registration_tech_to_string(ACCESS_TECHNOLOGY_NR_5GCN),
+								==, "nr");
+	g_assert_cmpstr(registration_tech_to_string(ACCESS_TECHNOLOGY_NG_RAN),
+								==, "nr");
+	g_assert_cmpstr(registration_tech_to_string(ACCESS_TECHNOLOGY_EUTRA_NR),
+								==, "nr");
+	g_assert_cmpstr(registration_tech_to_string(OFONO_ACCESS_TECHNOLOGY_NONE),
+								==, "");
+	g_assert_cmpstr(registration_tech_to_string(14), ==, "");
+}
+
 int main(int argc, char **argv)
 {
 	g_test_init(&argc, &argv, NULL);
@@ -179,6 +198,7 @@
 	g_test_add_func("/testutil/Invalid", test_invalid);
 	g_test_add_func("/testutil/Valid", test_valid);
 	g_test_add_func("/testutil/APN", test_apn);
+	g_test_add_func("/testutil/TechNames", test_tech_names);
 
 	return g_test_run();
 }

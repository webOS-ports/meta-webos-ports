+
+/*
+ * org.ofono.SmsHistory as Sailfish OS has it (plugins/smshistory.c in
+ * https://github.com/sailfishos/ofono): a StatusReport signal for each
+ * SMS status report, so that a client can tell the sender a message
+ * was delivered. Upstream oFono passes status reports only to its
+ * history drivers and has nothing on D-Bus for them.
+ *
+ * StatusReport(string message, dict info)
+ *   message: the path the message had while it was being sent,
+ *            <modem>/message_<uuid>
+ *   info:    { "Delivered": boolean }
+ *
+ * The signal comes from the modem path, where the interface is
+ * registered.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <errno.h>
+#include <glib.h>
+#include <gdbus.h>
+
+#define OFONO_API_SUBJECT_TO_CHANGE
+#include <ofono/plugin.h>
+#include <ofono/log.h>
+#include <ofono/history.h>
+#include <ofono/types.h>
+
+#include "ofono.h"
+#include "common.h"
+
+#define SMS_HISTORY_INTERFACE "org.ofono.SmsHistory"
+
+static const GDBusSignalTable sms_history_signals[] = {
+	{ GDBUS_SIGNAL("StatusReport",
+		GDBUS_ARGS({ "message", "s" }, { "info", "a{sv}" })) },
+	{ }
+};
+
+static int sms_history_probe(struct ofono_history_context *context)
+{
+	DBusConnection *conn = ofono_dbus_get_connection();
+	struct ofono_modem *modem = context->modem;
+	const char *path = ofono_modem_get_path(modem);
+
+	DBG("%s", path);
+
+	if (!g_dbus_register_interface(conn, path, SMS_HISTORY_INTERFACE,
+					NULL, sms_history_signals, NULL,
+					NULL, NULL)) {
+		ofono_error("Could not create %s interface",
+				SMS_HISTORY_INTERFACE);
+		return -EIO;
+	}
+
+	ofono_modem_add_interface(modem, SMS_HISTORY_INTERFACE);
+
+	return 0;
+}
+
+static void sms_history_remove(struct ofono_history_context *context)
+{
+	DBusConnection *conn = ofono_dbus_get_connection();
+	struct ofono_modem *modem = context->modem;
+	const char *path = ofono_modem_get_path(modem);
+
+	DBG("%s", path);
+
+	ofono_modem_remove_interface(modem, SMS_HISTORY_INTERFACE);
+	g_dbus_unregister_interface(conn, path, SMS_HISTORY_INTERFACE);
+}
+
+static void sms_history_sms_send_status(struct ofono_history_context *context,
+					const struct ofono_uuid *uuid,
+					time_t when,
+					enum ofono_history_sms_status status)
+{
+	DBusConnection *conn = ofono_dbus_get_connection();
+	struct ofono_atom *atom;
+	const char *sms_path;
+	const char *modem_path;
+	char *message;
+	dbus_bool_t delivered;
+	DBusMessage *signal;
+	DBusMessageIter iter;
+	DBusMessageIter dict;
+
+	if (status != OFONO_HISTORY_SMS_STATUS_DELIVERED &&
+			status != OFONO_HISTORY_SMS_STATUS_DELIVER_FAILED)
+		return;
+
+	atom = __ofono_modem_find_atom(context->modem, OFONO_ATOM_TYPE_SMS);
+	if (atom == NULL)
+		return;
+
+	sms_path = __ofono_atom_get_path(atom);
+	modem_path = ofono_modem_get_path(context->modem);
+	if (sms_path == NULL || modem_path == NULL || conn == NULL)
+		return;
+
+	delivered = (status == OFONO_HISTORY_SMS_STATUS_DELIVERED);
+	message = g_strconcat(sms_path, "/message_", ofono_uuid_to_str(uuid),
+				NULL);
+
+	DBG("%s delivered: %d", message, delivered);
+
+	signal = dbus_message_new_signal(modem_path, SMS_HISTORY_INTERFACE,
+						"StatusReport");
+	if (signal == NULL) {
+		g_free(message);
+		return;
+	}
+
+	dbus_message_iter_init_append(signal, &iter);
+	dbus_message_iter_append_basic(&iter, DBUS_TYPE_STRING, &message);
+	dbus_message_iter_open_container(&iter, DBUS_TYPE_ARRAY,
+					OFONO_PROPERTIES_ARRAY_SIGNATURE,
+					&dict);
+	ofono_dbus_dict_append(&dict, "Delivered", DBUS_TYPE_BOOLEAN,
+				&delivered);
+	dbus_message_iter_close_container(&iter, &dict);
+
+	g_dbus_send_message(conn, signal);
+	g_free(message);
+}
+
+static struct ofono_history_driver smshistory_driver = {
+	.name = "SMS History",
+	.probe = sms_history_probe,
+	.remove = sms_history_remove,
+	.sms_send_status = sms_history_sms_send_status,
+};
+
+static int sms_history_init(void)
+{
+	return ofono_history_driver_register(&smshistory_driver);
+}
+
+static void sms_history_exit(void)
+{
+	ofono_history_driver_unregister(&smshistory_driver);
+}
+
+OFONO_PLUGIN_DEFINE(sms_history, "SMS History Plugin",
+			VERSION, OFONO_PLUGIN_PRIORITY_DEFAULT,
+			sms_history_init, sms_history_exit)

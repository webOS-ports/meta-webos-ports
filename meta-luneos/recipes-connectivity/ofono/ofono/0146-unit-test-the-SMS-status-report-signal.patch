+
+/*
+ * plugins/smshistory.c on a private bus: the modem and its SMS atom are
+ * faked here, the signal is read back by a second connection.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+
+#include <glib.h>
+#include <gdbus.h>
+
+#include "ofono.h"
+#include "test-dbus.h"
+
+#define MODEM_PATH "/test_0"
+#define IFACE "org.ofono.SmsHistory"
+
+/* ---- logging ------------------------------------------------------------ */
+
+static void vlog(const char *format, va_list ap) G_GNUC_PRINTF(1, 0);
+
+static void vlog(const char *format, va_list ap)
+{
+	if (g_test_verbose()) {
+		vfprintf(stderr, format, ap);
+		fputc('\n', stderr);
+	}
+}
+
+void ofono_debug(const char *format, ...)
+{
+	va_list ap;
+
+	va_start(ap, format);
+	vlog(format, ap);
+	va_end(ap);
+}
+
+void ofono_error(const char *format, ...)
+{
+	va_list ap;
+
+	va_start(ap, format);
+	vlog(format, ap);
+	va_end(ap);
+}
+
+/* ---- the modem and its atoms -------------------------------------------- */
+
+struct ofono_modem {
+	const char *path;
+	GSList *interfaces;
+	gboolean has_sms;
+};
+
+struct ofono_atom {
+	const char *path;
+};
+
+static struct ofono_modem modem;
+static struct ofono_atom sms_atom = { MODEM_PATH };
+static const struct ofono_history_driver *registered;
+
+const char *ofono_modem_get_path(struct ofono_modem *m)
+{
+	return m->path;
+}
+
+void ofono_modem_add_interface(struct ofono_modem *m, const char *iface)
+{
+	m->interfaces = g_slist_append(m->interfaces, g_strdup(iface));
+}
+
+void ofono_modem_remove_interface(struct ofono_modem *m, const char *iface)
+{
+	GSList *l = g_slist_find_custom(m->interfaces, iface,
+					(GCompareFunc) strcmp);
+
+	g_assert(l);
+	g_free(l->data);
+	m->interfaces = g_slist_delete_link(m->interfaces, l);
+}
+
+struct ofono_atom *__ofono_modem_find_atom(struct ofono_modem *m,
+						enum ofono_atom_type type)
+{
+	if (type == OFONO_ATOM_TYPE_SMS && m->has_sms)
+		return &sms_atom;
+
+	return NULL;
+}
+
+const char *__ofono_atom_get_path(struct ofono_atom *atom)
+{
+	return atom->path;
+}
+
+int ofono_history_driver_register(const struct ofono_history_driver *d)
+{
+	g_assert(registered == NULL);
+	registered = d;
+	return 0;
+}
+
+void ofono_history_driver_unregister(const struct ofono_history_driver *d)
+{
+	g_assert(registered == d);
+	registered = NULL;
+}
+
+extern struct ofono_plugin_desc __ofono_builtin_sms_history;
+
+/* ---- the signals as the client sees them -------------------------------- */
+
+struct report {
+	char *path;
+	char *message;
+	gboolean delivered;
+};
+
+static struct test_dbus_context dbus;
+static GSList *reports;
+static guint timeout_id;
+
+static void report_free(gpointer data)
+{
+	struct report *r = data;
+
+	g_free(r->path);
+	g_free(r->message);
+	g_free(r);
+}
+
+static void read_report(DBusMessage *msg)
+{
+	struct report *r = g_new0(struct report, 1);
+	DBusMessageIter it, dict, entry, var;
+	const char *s;
+	dbus_bool_t b;
+	int entries = 0;
+
+	g_assert_cmpstr(dbus_message_get_signature(msg), ==, "sa{sv}");
+	r->path = g_strdup(dbus_message_get_path(msg));
+
+	dbus_message_iter_init(msg, &it);
+	dbus_message_iter_get_basic(&it, &s);
+	r->message = g_strdup(s);
+
+	dbus_message_iter_next(&it);
+	dbus_message_iter_recurse(&it, &dict);
+	while (dbus_message_iter_get_arg_type(&dict) == DBUS_TYPE_DICT_ENTRY) {
+		dbus_message_iter_recurse(&dict, &entry);
+		dbus_message_iter_get_basic(&entry, &s);
+		g_assert_cmpstr(s, ==, "Delivered");
+		dbus_message_iter_next(&entry);
+		dbus_message_iter_recurse(&entry, &var);
+		g_assert_cmpint(dbus_message_iter_get_arg_type(&var), ==,
+							DBUS_TYPE_BOOLEAN);
+		dbus_message_iter_get_basic(&var, &b);
+		r->delivered = b ? TRUE : FALSE;
+		entries++;
+		dbus_message_iter_next(&dict);
+	}
+	g_assert_cmpint(entries, ==, 1);
+
+	reports = g_slist_append(reports, r);
+}
+
+static DBusHandlerResult client_filter(DBusConnection *conn, DBusMessage *msg,
+								void *data)
+{
+	if (dbus_message_is_signal(msg, IFACE, "StatusReport")) {
+		read_report(msg);
+		g_main_loop_quit(dbus.loop);
+		return DBUS_HANDLER_RESULT_HANDLED;
+	}
+
+	return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+}
+
+static gboolean test_timeout(gpointer data)
+{
+	g_assert_not_reached();
+	return G_SOURCE_REMOVE;
+}
+
+static void wait_for_report(void)
+{
+	g_main_loop_run(dbus.loop);
+}
+
+/* ---- set up and tear down ----------------------------------------------- */
+
+static struct ofono_history_context context;
+
+static const struct ofono_uuid uuid = { {
+	0x60, 0x78, 0xab, 0xd6, 0xee, 0x28, 0x0e, 0x68, 0x28, 0x34,
+	0xd0, 0xc4, 0x30, 0x5d, 0xb0, 0x01, 0x02, 0x03, 0x04, 0x05
+} };
+
+static void test_start(gboolean has_sms)
+{
+	memset(&modem, 0, sizeof(modem));
+	modem.path = MODEM_PATH;
+	modem.has_sms = has_sms;
+
+	timeout_id = g_timeout_add_seconds(10, test_timeout, NULL);
+
+	test_dbus_setup(&dbus);
+	g_assert(dbus_connection_add_filter(dbus.client_connection,
+						client_filter, NULL, NULL));
+	dbus_bus_add_match(dbus.client_connection,
+			"type='signal',interface='" IFACE "'", NULL);
+	dbus_connection_flush(dbus.client_connection);
+
+	g_assert_cmpint(__ofono_builtin_sms_history.init(), ==, 0);
+	g_assert(registered);
+
+	context.driver = (struct ofono_history_driver *) registered;
+	context.modem = &modem;
+	g_assert_cmpint(registered->probe(&context), ==, 0);
+	g_assert(g_slist_find_custom(modem.interfaces, IFACE,
+					(GCompareFunc) strcmp));
+}
+
+static void test_end(void)
+{
+	registered->remove(&context);
+	g_assert_null(modem.interfaces);
+	__ofono_builtin_sms_history.exit();
+	g_assert_null(registered);
+
+	test_dbus_shutdown(&dbus);
+	g_source_remove(timeout_id);
+	g_slist_free_full(reports, report_free);
+	reports = NULL;
+}
+
+static void send_status(enum ofono_history_sms_status status)
+{
+	registered->sms_send_status(&context, &uuid, 0, status);
+}
+
+/* ---- the tests ---------------------------------------------------------- */
+
+static void check_report(const struct report *r, gboolean delivered)
+{
+	char *expected = g_strconcat(MODEM_PATH, "/message_",
+					ofono_uuid_to_str(&uuid), NULL);
+
+	g_assert_cmpstr(r->path, ==, MODEM_PATH);
+	g_assert_cmpstr(r->message, ==, expected);
+	g_assert_cmpint(r->delivered, ==, delivered);
+	g_free(expected);
+}
+
+static void test_delivered(void)
+{
+	test_start(TRUE);
+	send_status(OFONO_HISTORY_SMS_STATUS_DELIVERED);
+	wait_for_report();
+	g_assert_cmpint(g_slist_length(reports), ==, 1);
+	check_report(reports->data, TRUE);
+	test_end();
+}
+
+static void test_deliver_failed(void)
+{
+	test_start(TRUE);
+	send_status(OFONO_HISTORY_SMS_STATUS_DELIVER_FAILED);
+	wait_for_report();
+	g_assert_cmpint(g_slist_length(reports), ==, 1);
+	check_report(reports->data, FALSE);
+	test_end();
+}
+
+/* Submitting is the Message object's State, not a status report */
+static void test_submit_states(void)
+{
+	test_start(TRUE);
+	send_status(OFONO_HISTORY_SMS_STATUS_PENDING);
+	send_status(OFONO_HISTORY_SMS_STATUS_SUBMITTED);
+	send_status(OFONO_HISTORY_SMS_STATUS_SUBMIT_FAILED);
+	send_status(OFONO_HISTORY_SMS_STATUS_SUBMIT_CANCELLED);
+	/* the signals go out in order: this one has to be the first seen */
+	send_status(OFONO_HISTORY_SMS_STATUS_DELIVERED);
+	wait_for_report();
+	g_assert_cmpint(g_slist_length(reports), ==, 1);
+	check_report(reports->data, TRUE);
+	test_end();
+}
+
+static void test_no_sms_atom(void)
+{
+	test_start(FALSE);
+	send_status(OFONO_HISTORY_SMS_STATUS_DELIVERED);
+	modem.has_sms = TRUE;
+	send_status(OFONO_HISTORY_SMS_STATUS_DELIVER_FAILED);
+	wait_for_report();
+	g_assert_cmpint(g_slist_length(reports), ==, 1);
+	check_report(reports->data, FALSE);
+	test_end();
+}
+
+int main(int argc, char **argv)
+{
+	test_dbus_require_bus();
+
+	g_test_init(&argc, &argv, NULL);
+
+#define T(name) g_test_add_func("/smshistory/" #name, test_ ## name)
+	T(delivered);
+	T(deliver_failed);
+	T(submit_states);
+	T(no_sms_atom);
+#undef T
+
+	return g_test_run();
+}

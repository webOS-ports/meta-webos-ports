From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] gprs: add an XCAP context type

On LTE with IMS, a modem reads and changes supplementary services (call
forwarding, call waiting, barring, caller ID) over XCAP: HTTP to the
operator's XCAP server, through an access point of its own. Android
names that access point in its APN list with the type "xcap", and its
RIL hands it to the modem with the other data profiles.

oFono had no such type, so the modem was never told the XCAP access
point. On a MediaTek modem (MT6789) every supplementary service request
then fails over XCAP and is made again over the circuit-switched
network, which moves the phone from LTE to 3G and back for each one.

Add "xcap" as a context type, in the D-Bus API and in the provisioning
tool. The context is for the modem's own use: a driver passes its
settings to the modem, nothing here activates it.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 doc/connman-api.txt    | 6 ++++++
 include/gprs-context.h | 1 +
 src/gprs.c             | 7 +++++++
 tools/provisiontool    | 2 ++
 4 files changed, 16 insertions(+)

diff --git a/doc/connman-api.txt b/doc/connman-api.txt
index 578b975..579b1e9 100644
--- a/doc/connman-api.txt
+++ b/doc/connman-api.txt
@@ -189,6 +189,12 @@ Properties	boolean Active [readwrite]
 				"mms" - Used by MMS related services
 				"wap" - Used by WAP related services
 				"ims" - Used by IMS related services
+				"xcap" - The access point the modem
+					uses for supplementary services
+					over XCAP (call forwarding,
+					waiting, barring, caller ID).
+					The modem brings it up itself;
+					it is not activated from here.
 
 		string AuthenticationMethod [readwrite]
 			Holds the PPP authentication method to use.  Valid
diff --git a/include/gprs-context.h b/include/gprs-context.h
index 509077f..c8dfa44 100644
--- a/include/gprs-context.h
+++ b/include/gprs-context.h
@@ -27,6 +27,7 @@ enum ofono_gprs_context_type {
 	OFONO_GPRS_CONTEXT_TYPE_IMS		= 0x0008,
 	OFONO_GPRS_CONTEXT_TYPE_SUPL		= 0x0010,
 	OFONO_GPRS_CONTEXT_TYPE_IA		= 0x0020,
+	OFONO_GPRS_CONTEXT_TYPE_XCAP		= 0x0040,
 };
 
 struct ofono_gprs_primary_context {
diff --git a/src/gprs.c b/src/gprs.c
index 11824bc..1d59830 100644
--- a/src/gprs.c
+++ b/src/gprs.c
@@ -169,6 +169,8 @@ static const char *gprs_context_default_name(enum ofono_gprs_context_type type)
 		return "SUPL";
 	case OFONO_GPRS_CONTEXT_TYPE_IA:
 		return "Initial Attach";
+	case OFONO_GPRS_CONTEXT_TYPE_XCAP:
+		return "XCAP";
 	}
 
 	return NULL;
@@ -192,6 +194,8 @@ static const char *gprs_context_type_to_string(
 		return "supl";
 	case OFONO_GPRS_CONTEXT_TYPE_IA:
 		return "ia";
+	case OFONO_GPRS_CONTEXT_TYPE_XCAP:
+		return "xcap";
 	}
 
 	return NULL;
@@ -215,6 +219,9 @@ static gboolean gprs_context_string_to_type(const char *str,
 	} else if (g_str_equal(str, "supl")) {
 		*out = OFONO_GPRS_CONTEXT_TYPE_SUPL;
 		return TRUE;
+	} else if (g_str_equal(str, "xcap")) {
+		*out = OFONO_GPRS_CONTEXT_TYPE_XCAP;
+		return TRUE;
 	}
 
 	return FALSE;
diff --git a/tools/provisiontool b/tools/provisiontool
index 0b15abd..2bb9375 100755
--- a/tools/provisiontool
+++ b/tools/provisiontool
@@ -254,6 +254,8 @@ class ProvisionContext(ctypes.LittleEndianStructure):
                 r |= 0x0010
             elif t == 'ia':
                 r |= 0x0020
+            elif t == 'xcap':
+                r |= 0x0040
 
         return r
 

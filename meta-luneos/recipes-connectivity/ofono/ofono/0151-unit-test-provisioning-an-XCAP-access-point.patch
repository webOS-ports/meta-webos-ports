From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] unit: test provisioning an XCAP access point

An XCAP access point listed as a provider of its own on a network's
MCC/MNC is merged into that network's contexts with the XCAP type, and
picking the best access point of each type keeps it next to the
internet one the SPN chooses, last.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 unit/test-provision.c    | 56 ++++++++++++++++++++++++++++++++++++++++
 unit/test-provision.json | 31 ++++++++++++++++++++++
 2 files changed, 87 insertions(+)

diff --git a/unit/test-provision.c b/unit/test-provision.c
index 6ce44a1..1926d37 100644
--- a/unit/test-provision.c
+++ b/unit/test-provision.c
@@ -190,6 +190,35 @@ static const struct provision_test lookup_gamma_mvno = {
 	.items = gamma_mvno_contexts,
 };
 
+/*
+ * An XCAP access point, listed as a provider of its own on the network's
+ * MCC/MNC, is merged in with its type
+ */
+static const struct provision_db_entry delta_contexts[] = {
+	{
+		.type = OFONO_GPRS_CONTEXT_TYPE_INTERNET,
+		.proto = OFONO_GPRS_PROTO_IPV4V6,
+		.name = "Delta Internet",
+		.apn = "delta.internet",
+		.auth_method = OFONO_GPRS_AUTH_METHOD_CHAP,
+	},
+	{
+		.type = OFONO_GPRS_CONTEXT_TYPE_XCAP,
+		.proto = OFONO_GPRS_PROTO_IPV4V6,
+		.name = "XCAP",
+		.apn = "delta.xcap",
+		.auth_method = OFONO_GPRS_AUTH_METHOD_NONE,
+	},
+};
+
+static const struct provision_test lookup_delta_xcap = {
+	.mcc = "999",
+	.mnc = "79",
+	.result = 0,
+	.n_items = L_ARRAY_SIZE(delta_contexts),
+	.items = delta_contexts,
+};
+
 /* Make sure mccmnc not in the database isn't found */
 static const struct provision_test unknown_mcc_mnc = {
 	.mcc = "994",
@@ -336,6 +365,7 @@ static void provision_lookup(const void *data)
 #define T_INTERNET OFONO_GPRS_CONTEXT_TYPE_INTERNET
 #define T_MMS OFONO_GPRS_CONTEXT_TYPE_MMS
 #define T_IMS OFONO_GPRS_CONTEXT_TYPE_IMS
+#define T_XCAP OFONO_GPRS_CONTEXT_TYPE_XCAP
 
 struct pick_test {
 	const char *spn;
@@ -453,6 +483,28 @@ static const struct pick_test pick_internet_first = {
 	.n_out = 2, .apns = mms_first_apns,
 };
 
+/*
+ * Odido NL (20416) once its providers and its XCAP access point are merged:
+ * the XCAP one is kept whatever the SPN, as the only one of its type, and
+ * comes last
+ */
+static const struct provision_db_entry odido_like[] = {
+	{ .type = T_INTERNET, .name = "T-Mobile Internet", .apn = "internet" },
+	{ .type = T_MMS, .name = "T-Mobile NL MMS", .apn = "mms" },
+	{ .type = T_XCAP, .name = "XCAP", .apn = "hos" },
+	{ .type = T_INTERNET, .name = "Simpel", .apn = "internet.access.nl" },
+};
+
+static const char *const odido_simpel[] = {
+	"internet.access.nl", "mms", "hos"
+};
+
+static const struct pick_test pick_xcap_kept = {
+	.spn = "Simpel",
+	.n_in = L_ARRAY_SIZE(odido_like), .in = odido_like,
+	.n_out = 3, .apns = odido_simpel,
+};
+
 static void provision_pick(const void *data)
 {
 	const struct pick_test *test = data;
@@ -508,6 +560,8 @@ int main(int argc, char **argv)
 				provision_lookup, &lookup_gamma_merged);
 	l_test_add("Unmerged provider keeps its own contexts",
 				provision_lookup, &lookup_gamma_mvno);
+	l_test_add("XCAP access point is merged in with its type",
+				provision_lookup, &lookup_delta_xcap);
 	l_test_add("Pick: Vodafone NL, no SPN", provision_pick,
 						&pick_vodafone_no_spn);
 	l_test_add("Pick: Vodafone NL, SPN vodafone", provision_pick,
@@ -517,6 +571,8 @@ int main(int argc, char **argv)
 						&pick_nocase_beats_partial);
 	l_test_add("Pick: partial SPN match", provision_pick, &pick_partial);
 	l_test_add("Pick: mixed types", provision_pick, &pick_mixed);
+	l_test_add("Pick: the XCAP access point is kept, last", provision_pick,
+						&pick_xcap_kept);
 	l_test_add("Pick: SPN picks a combined type", provision_pick,
 						&pick_mixed_spn_both);
 	l_test_add("Pick: distinct types kept", provision_pick, &pick_distinct);
diff --git a/unit/test-provision.json b/unit/test-provision.json
index 0d66a59..ca06062 100644
--- a/unit/test-provision.json
+++ b/unit/test-provision.json
@@ -132,5 +132,36 @@
         ]
       }
     ]
+  },
+  {
+    "name": "Operator Delta",
+    "ids": [
+      "99979"
+    ],
+    "apns": [
+      {
+        "name": "Delta Internet",
+        "apn": "delta.internet",
+        "type": [
+          "internet"
+        ]
+      }
+    ]
+  },
+  {
+    "name": "Operator Delta",
+    "ids": [
+      "99979"
+    ],
+    "apns": [
+      {
+        "name": "XCAP",
+        "apn": "delta.xcap",
+        "type": [
+          "xcap"
+        ],
+        "authentication": "none"
+      }
+    ]
   }
 ]

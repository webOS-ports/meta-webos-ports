From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] voicecall: say whether a call is carried over IMS

A UI has no way to tell a VoLTE call from a circuit-switched one: both
are org.ofono.VoiceCall objects with the same properties. The modem
driver often knows (a vendor IMS extension reports its calls apart
from the radio's call list), but struct ofono_call has nowhere to put
it.

Add an ims flag to struct ofono_call and show it as a boolean IMS
property on the call. Drivers that cannot tell leave it false, which
ofono_call_init() already does. A driver that reports a change of
transport during a call (SRVCC, from LTE to a circuit-switched
network) makes it signal PropertyChanged once.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 doc/voicecall-api.txt |  8 ++++++++
 include/types.h       |  5 +++++
 src/voicecall.c       | 29 +++++++++++++++++++++++++++++
 3 files changed, 42 insertions(+)

diff --git a/doc/voicecall-api.txt b/doc/voicecall-api.txt
index 2d715be..8731696 100644
--- a/doc/voicecall-api.txt
+++ b/doc/voicecall-api.txt
@@ -174,6 +174,14 @@ Properties	string LineIdentification [readonly]
 			Contains the indication if the voice call is an
 			emergency call or not.
 
+		boolean IMS [readonly]
+
+			True if the call is carried over IMS (VoLTE, VoNR
+			or VoWiFi), false if it is a circuit-switched call
+			or the modem driver cannot tell. It can change
+			during a call, for example on a handover from LTE
+			to a circuit-switched network (SRVCC).
+
 		boolean RemoteHeld [experimental]
 
 			Contains the indication whether the voice call is put
diff --git a/include/types.h b/include/types.h
index de6b87e..0f79e53 100644
--- a/include/types.h
+++ b/include/types.h
@@ -81,6 +81,11 @@ struct ofono_call {
 	char name[OFONO_MAX_CALLER_NAME_LENGTH + 1];
 	int clip_validity;
 	int cnap_validity;
+	/*
+	 * The call is carried over IMS (VoLTE, VoNR, VoWiFi) instead of the
+	 * circuit-switched network. Drivers that cannot tell leave it false.
+	 */
+	ofono_bool_t ims;
 };
 
 struct ofono_network_time {
diff --git a/src/voicecall.c b/src/voicecall.c
index c1feeb9..76917a0 100644
--- a/src/voicecall.c
+++ b/src/voicecall.c
@@ -387,6 +387,7 @@ static void append_voicecall_properties(struct voicecall *v,
 	const char *name;
 	ofono_bool_t mpty;
 	dbus_bool_t emergency_call;
+	dbus_bool_t ims;
 
 	status = call_status_to_string(call->status);
 
@@ -453,6 +454,9 @@ static void append_voicecall_properties(struct voicecall *v,
 
 	ofono_dbus_dict_append(dict, "Emergency",
 					DBUS_TYPE_BOOLEAN, &emergency_call);
+
+	ims = call->ims;
+	ofono_dbus_dict_append(dict, "IMS", DBUS_TYPE_BOOLEAN, &ims);
 }
 
 static DBusMessage *voicecall_get_properties(DBusConnection *conn,
@@ -1026,6 +1030,29 @@ static void voicecall_set_call_name(struct voicecall *v,
 						DBUS_TYPE_STRING, &name_str);
 }
 
+static void voicecall_set_call_ims(struct voicecall *v, ofono_bool_t ims)
+{
+	struct ofono_call *call = v->call;
+	DBusConnection *conn = ofono_dbus_get_connection();
+	const char *path;
+	dbus_bool_t value;
+
+	ims = ims ? TRUE : FALSE;
+
+	if (call->ims == ims)
+		return;
+
+	call->ims = ims;
+
+	path = voicecall_build_path(v->vc, call);
+	value = ims;
+
+	ofono_dbus_signal_property_changed(conn, path,
+						OFONO_VOICECALL_INTERFACE,
+						"IMS",
+						DBUS_TYPE_BOOLEAN, &value);
+}
+
 static bool voicecall_dbus_register(struct voicecall *v)
 {
 	DBusConnection *conn = ofono_dbus_get_connection();
@@ -2377,6 +2404,7 @@ void ofono_voicecall_notify(struct ofono_voicecall *vc,
 		voicecall_set_call_calledid(l->data, &call->called_number);
 		voicecall_set_call_name(l->data, call->name,
 						call->cnap_validity);
+		voicecall_set_call_ims(l->data, call->ims);
 
 		return;
 	}
@@ -2384,6 +2412,7 @@ void ofono_voicecall_notify(struct ofono_voicecall *vc,
 	DBG("Did not find a call with id: %d", call->id);
 
 	newcall = l_memdup(call, sizeof(struct ofono_call));
+	newcall->ims = call->ims ? TRUE : FALSE;
 	v = voicecall_create(vc, newcall);
 
 	if (vc->flags & VOICECALL_FLAG_STK_MODEM_CALLSETUP) {

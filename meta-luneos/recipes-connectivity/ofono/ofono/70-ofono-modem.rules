# Which oFono driver handles a modem the kernel has exposed.
#
# smdpkt and rpmsg are the older Qualcomm shared-memory transports, where
# rpmsgexport creates a "modem" symlink for the channel oFono should use.
SYMLINK=="modem", SUBSYSTEM=="smdpkt",   ENV{OFONO_DRIVER}="gobi"
SYMLINK=="modem", SUBSYSTEM=="rpmsg",    ENV{OFONO_DRIVER}="gobi", ENV{OFONO_NETWORK_INTERFACE}="rmnet0"

# Newer mainline kernels put the msm8916-era modem behind the wwan subsystem
# instead (rpmsg_wwan_ctrl's /dev/wwan0qmi0, with BAM-DMUX wwan0..wwan7 for
# data). No rule is needed for it: oFono's udevng recognises that pair by the
# bam-dmux netdev and creates an embedded gobi modem itself - see
# 0009-gobi-support-embedded-QMUX-modems-on-BAM-DMUX-SoCs.patch. An
# OFONO_DRIVER set on the wwan port would not be read.

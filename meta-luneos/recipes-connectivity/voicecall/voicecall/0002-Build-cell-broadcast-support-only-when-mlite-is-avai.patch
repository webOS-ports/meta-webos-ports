From da39d36dd4752e409210a34f59d3d44f1e7eb3a3 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sat, 15 Aug 2026 21:31:08 +0200
Subject: [PATCH 2/2] Build cell broadcast support only when mlite is available

The cell broadcast controller keeps its settings in MDConfItem, so src/
gained a hard dependency on mlite. mlite is part of the Nemo stack and is
not packaged everywhere, which makes the whole voicecall-manager
unbuildable on those distributions rather than just costing them the
feature.

Gate it the way enable-audiopolicy and enable-ngf already work: build the
cell broadcast sources when mlite is present, and compile the daemon out of
main() otherwise.

Also fixes the build with Qt 6 while here: QString::SkipEmptyParts moved to
Qt::SkipEmptyParts in 5.14 and is gone in 6.

Upstream-Status: Pending [written against 8e6ec88, intended for sailfishos/voicecall]
---
 src/cellbroadcasttopics.cpp |  5 +++++
 src/main.cpp                |  4 ++++
 src/src.pro                 | 28 ++++++++++++++++++++--------
 3 files changed, 29 insertions(+), 8 deletions(-)

diff --git a/src/cellbroadcasttopics.cpp b/src/cellbroadcasttopics.cpp
index bcea244..2b7bf32 100644
--- a/src/cellbroadcasttopics.cpp
+++ b/src/cellbroadcasttopics.cpp
@@ -18,6 +18,7 @@
  * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
  *
  */
+#include <QtGlobal>
 #include "cellbroadcasttopics.h"
 
 #include <algorithm>
@@ -45,7 +46,11 @@ CellBroadcastTopicRangeList CellBroadcastTopics::parse(const QString &topics)
         return ranges;
     }
 
+    #if QT_VERSION >= QT_VERSION_CHECK(5, 14, 0)
+    const QStringList parts = trimmed.split(QLatin1Char(','), Qt::SkipEmptyParts);
+#else
     const QStringList parts = trimmed.split(QLatin1Char(','), QString::SkipEmptyParts);
+#endif
     for (const QString &part : parts) {
         const QString range = part.trimmed();
         const int separator = range.indexOf(QLatin1Char('-'));
diff --git a/src/main.cpp b/src/main.cpp
index 2ffbcbf..cba0685 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -22,7 +22,9 @@
 
 #include "voicecallmanager.h"
 #include "basicvoicecallconfigurator.h"
+#ifdef WITH_CELL_BROADCAST
 #include "cellbroadcastdaemon.h"
+#endif
 
 Q_DECL_EXPORT int main(int argc, char **argv)
 {
@@ -39,10 +41,12 @@ Q_DECL_EXPORT int main(int argc, char **argv)
         return -1;
     }
 
+#ifdef WITH_CELL_BROADCAST
     CellBroadcastDaemon cellBroadcastDaemon;
     if (!cellBroadcastDaemon.registerObject()) {
         qWarning("VoiceCall: failed to register cell broadcast D-Bus object");
     }
+#endif
 
     return app.exec();
 }
diff --git a/src/src.pro b/src/src.pro
index a1ce753..628b168 100644
--- a/src/src.pro
+++ b/src/src.pro
@@ -30,10 +30,6 @@ equals(QT_MAJOR_VERSION, 5):packagesExist(qt5-boostable) {
 LIBS += -L../lib/src -lvoicecall
 
 HEADERS += \
-    cellbroadcastcatalog.h \
-    cellbroadcastcontroller.h \
-    cellbroadcastdaemon.h \
-    cellbroadcasttopics.h \
     dbus/voicecallmanagerdbusservice.h \
     basicvoicecallconfigurator.h \
     voicecallmanager.h \
@@ -41,10 +37,6 @@ HEADERS += \
     dbus/voicecallhandlerdbusadapter.h
 
 SOURCES += \
-    cellbroadcastcatalog.cpp \
-    cellbroadcastcontroller.cpp \
-    cellbroadcastdaemon.cpp \
-    cellbroadcasttopics.cpp \
     dbus/voicecallmanagerdbusservice.cpp \
     dbus/voicecallmanagerdbusadapter.cpp \
     dbus/voicecallhandlerdbusadapter.cpp \
@@ -52,6 +44,26 @@ SOURCES += \
     voicecallmanager.cpp \
     main.cpp \
 
+# Cell broadcast keeps its settings in MDConfItem, so it needs mlite. That is
+# part of the Nemo stack and is not present everywhere, so build the feature
+# only when the library is actually installed instead of failing the build.
+packagesExist(mlite$${QT_MAJOR_VERSION}) {
+    PKGCONFIG += mlite$${QT_MAJOR_VERSION}
+    DEFINES += WITH_CELL_BROADCAST
+    HEADERS += \
+        cellbroadcastcatalog.h \
+        cellbroadcastcontroller.h \
+        cellbroadcastdaemon.h \
+        cellbroadcasttopics.h
+    SOURCES += \
+        cellbroadcastcatalog.cpp \
+        cellbroadcastcontroller.cpp \
+        cellbroadcastdaemon.cpp \
+        cellbroadcasttopics.cpp
+} else {
+    warning("mlite not found; cell broadcast support will not be built")
+}
+
 enable-audiopolicy {
     PKGCONFIG += libresourceqt5
     HEADERS += audiocallpolicyproxy.h

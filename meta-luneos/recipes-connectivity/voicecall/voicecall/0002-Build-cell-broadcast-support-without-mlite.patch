diff --git a/src/cellbroadcastsettings.cpp b/src/cellbroadcastsettings.cpp
new file mode 100644
index 0000000..1ca2df0
--- /dev/null
+++ b/src/cellbroadcastsettings.cpp
@@ -0,0 +1,133 @@
+/*
+ * This file is a part of the Voice Call Manager project
+ *
+ * Copyright (C) 2026 Jolla Mobile Ltd
+ *

diff --git a/src/cellbroadcastsettings.cpp b/src/cellbroadcastsettings.cpp
new file mode 100644
index 0000000..1ca2df0
--- /dev/null
+++ b/src/cellbroadcastsettings.cpp
@@ -0,0 +1,133 @@
+/*
+ * This file is a part of the Voice Call Manager project
+ *
+ * Copyright (C) 2026 Jolla Mobile Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program; if not, write to the Free Software Foundation, Inc.,
+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+ *
+ */
+#include "cellbroadcastsettings.h"
+
+#ifndef HAVE_MLITE
+
+#include <QDir>
+#include <QGlobalStatic>
+#include <QHash>
+#include <QList>
+#include <QSettings>
+#include <QStandardPaths>
+
+namespace {
+
+QString settingsFilePath()
+{
+    QString base = QString::fromLocal8Bit(qgetenv("VOICECALL_CONFIG_HOME"));
+    if (base.isEmpty()) {
+        base = QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation);
+    }
+    // voicecall-manager is often started as a system service, which has no HOME
+    // for QStandardPaths to work from. Keep the store out of "/" in that case.
+    if (base.isEmpty() || !QDir::isAbsolutePath(base) || base == QLatin1String("/")) {
+        base = QStringLiteral("/var/lib");
+    }
+    return base + QStringLiteral("/voicecall/cellbroadcast.conf");
+}
+
+QSettings *store()
+{
+    static QSettings settings(settingsFilePath(), QSettings::IniFormat);
+    return &settings;
+}
+
+// dconf keys are absolute paths, QSettings keys are relative to the file root.
+QString settingsKey(const QString &key)
+{
+    int start = 0;
+    while (start < key.size() && key.at(start) == QLatin1Char('/')) {
+        ++start;
+    }
+    return key.mid(start);
+}
+
+typedef QHash<QString, QList<CellBroadcastSettingItem *> > ItemsByKey;
+Q_GLOBAL_STATIC(ItemsByKey, itemsByKey)
+
+}
+
+CellBroadcastSettingItem::CellBroadcastSettingItem(const QString &key, QObject *parent)
+    : QObject(parent)
+    , m_key(key)
+{
+    (*itemsByKey())[m_key].append(this);
+}
+
+CellBroadcastSettingItem::~CellBroadcastSettingItem()
+{
+    if (!itemsByKey.isDestroyed()) {
+        QList<CellBroadcastSettingItem *> &items = (*itemsByKey())[m_key];
+        items.removeAll(this);
+        if (items.isEmpty()) {
+            itemsByKey()->remove(m_key);
+        }
+    }
+}
+
+QString CellBroadcastSettingItem::key() const
+{
+    return m_key;
+}
+
+QVariant CellBroadcastSettingItem::value() const
+{
+    return store()->value(settingsKey(m_key));
+}
+
+QVariant CellBroadcastSettingItem::value(const QVariant &def) const
+{
+    return store()->value(settingsKey(m_key), def);
+}
+
+void CellBroadcastSettingItem::set(const QVariant &val)
+{
+    if (value() == val) {
+        return;
+    }
+
+    if (val.isValid()) {
+        store()->setValue(settingsKey(m_key), val);
+    } else {
+        store()->remove(settingsKey(m_key));
+    }
+    store()->sync();
+
+    Q_EMIT valueChanged();
+
+    // MDConfItem notifies the item that was written to right away and the other
+    // items for the same key once the event loop runs. Match that, so callers
+    // which set a value from within a valueChanged() handler behave the same.
+    const QList<CellBroadcastSettingItem *> items = itemsByKey()->value(m_key);
+    for (CellBroadcastSettingItem *item : items) {
+        if (item != this) {
+            QMetaObject::invokeMethod(item, "valueChanged", Qt::QueuedConnection);
+        }
+    }
+}
+
+void CellBroadcastSettingItem::unset()
+{
+    set(QVariant());
+}
+
+#endif // HAVE_MLITE
diff --git a/src/cellbroadcastsettings.h b/src/cellbroadcastsettings.h
new file mode 100644
index 0000000..6b69b69
--- /dev/null
+++ b/src/cellbroadcastsettings.h
@@ -0,0 +1,77 @@
+/*
+ * This file is a part of the Voice Call Manager project
+ *
+ * Copyright (C) 2026 Jolla Mobile Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program; if not, write to the Free Software Foundation, Inc.,
+ * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+ *
+ */
+#ifndef CELLBROADCASTSETTINGS_H
+#define CELLBROADCASTSETTINGS_H
+
+/*
+ * The cell broadcast settings are dconf keys on Sailfish OS, reached through
+ * mlite's MDConfItem. mlite is part of the Nemo stack and is not packaged
+ * everywhere, so this header hands out a CellBroadcastSettingItem that is
+ * MDConfItem where it exists, and a QSettings-backed stand-in with the same
+ * small API where it does not.
+ */
+
+#ifdef HAVE_MLITE
+
+#include <MDConfItem>
+
+typedef MDConfItem CellBroadcastSettingItem;
+
+#else
+
+#include <QObject>
+#include <QString>
+#include <QVariant>
+
+/*
+ * Only the parts of MDConfItem that the cell broadcast code uses. Keys keep
+ * their dconf spelling ("/apps/sailfish/cellbroadcast/enabled") so the two
+ * backends stay interchangeable; the leading slash is dropped when the key is
+ * handed to QSettings.
+ *
+ * Unlike dconf this store is per-process: a change made by another process is
+ * not noticed. That is enough here because voicecall-manager owns these keys
+ * and everyone else goes through its cell broadcast D-Bus interface.
+ */
+class CellBroadcastSettingItem : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit CellBroadcastSettingItem(const QString &key, QObject *parent = 0);
+    ~CellBroadcastSettingItem();
+
+    QString key() const;
+    QVariant value() const;
+    QVariant value(const QVariant &def) const;
+    void set(const QVariant &val);
+    void unset();
+
+Q_SIGNALS:
+    void valueChanged();
+
+private:
+    const QString m_key;
+};
+
+#endif // HAVE_MLITE
+
+#endif // CELLBROADCASTSETTINGS_H
diff --git a/src/src.pro b/src/src.pro
index a90370c..3b9c419 100644
--- a/src/src.pro
+++ b/src/src.pro
@@ -13,7 +13,18 @@ VOICECALL_LIBDIR = $$[QT_INSTALL_LIBS]
 !isEmpty(VOICECALL_INSTALL_LIBDIR): VOICECALL_LIBDIR = $${VOICECALL_INSTALL_LIBDIR}
 DEFINES += VOICECALL_PLUGIN_DIRECTORY=\"\\\"$${VOICECALL_LIBDIR}/voicecall/plugins\\\"\"
 
-PKGCONFIG += mlite$${QT_MAJOR_VERSION} qofono-qt$${QT_MAJOR_VERSION}
+PKGCONFIG += qofono-qt$${QT_MAJOR_VERSION}
+
+# The cell broadcast settings live in dconf, which is reached through mlite.
+# mlite is part of the Nemo stack and is not packaged everywhere, so use it
+# when it is there and fall back to a QSettings-backed store when it is not,
+# rather than dropping the feature. See cellbroadcastsettings.h.
+packagesExist(mlite$${QT_MAJOR_VERSION}) {
+    PKGCONFIG += mlite$${QT_MAJOR_VERSION}
+    DEFINES += HAVE_MLITE
+} else {
+    warning("mlite not found; cell broadcast settings will be kept in a local settings file")
+}
 
 enable-nemo-devicelock {
     PKGCONFIG += nemodevicelock
@@ -31,6 +42,7 @@ LIBS += -L../lib/src -lvoicecall
 
 HEADERS += \

     cellbroadcastdaemon.h \
     cellbroadcastgeofence.h \
@@ -45,6 +57,7 @@ HEADERS += \
 
 SOURCES += \
     cellbroadcastcatalog.cpp \
+    cellbroadcastsettings.cpp \
     cellbroadcastcontroller.cpp \
     cellbroadcastdaemon.cpp \
     cellbroadcastgeofence.cpp \

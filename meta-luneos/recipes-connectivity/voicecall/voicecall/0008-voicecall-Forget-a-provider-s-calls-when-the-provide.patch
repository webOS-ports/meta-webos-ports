 tests/tst_voicecallmanager.cpp           | 257 +++++++++++++++++++++++
 10 files changed, 561 insertions(+), 21 deletions(-)
 create mode 100644 tests/fakes/fake_voicecall.h
 create mode 100644 tests/manager.pro
 create mode 100644 tests/tst_voicecallmanager.cpp

diff --git a/plugins/mce/src/mceplugin.cpp b/plugins/mce/src/mceplugin.cpp

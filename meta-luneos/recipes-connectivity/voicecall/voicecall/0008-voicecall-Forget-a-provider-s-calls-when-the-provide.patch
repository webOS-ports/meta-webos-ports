 private:
     class VoiceCallManagerPrivate *d_ptr;
diff --git a/tests/fakes/fake_voicecall.h b/tests/fakes/fake_voicecall.h
new file mode 100644
index 0000000..f00c56a
--- /dev/null
+++ b/tests/fakes/fake_voicecall.h
@@ -0,0 +1,155 @@
+/*

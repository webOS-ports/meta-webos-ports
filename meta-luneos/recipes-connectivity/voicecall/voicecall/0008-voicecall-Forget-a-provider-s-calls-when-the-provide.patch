@@ -48,8 +49,12 @@ public:
     QHash<QString, AbstractVoiceCallProvider*> providers;
 
     QHash<QString, AbstractVoiceCallHandler*> voiceCalls;
+    // Handler ids in the order the calls were added, to break ties when

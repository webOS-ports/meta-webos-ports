+    QTest::newRow("inf vertex")
+            << "polygon|-35.30,149.10|-35.30,-inf|-35.20,149.20" << -30.0 << 140.0 << 10.0;
+    QTest::newRow("nan latitude") << circle << nan << 140.0 << 10.0;
+    QTest::newRow("nan longitude") << circle << -30.0 << nan << 10.0;

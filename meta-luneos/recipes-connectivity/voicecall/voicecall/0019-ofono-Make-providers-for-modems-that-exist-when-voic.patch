From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Thu, 12 Nov 2026 07:21:25 +0100
Subject: [PATCH] [ofono] Make providers for modems that exist when voicecall
 starts.

The provider factory made a provider for each modem libqofono reported
with modemAdded(), and for the modems QOfonoManager already listed when
the plugin was configured. QOfonoManager learns the modems that exist
from an asynchronous GetModems, at start and each time oFono comes back,
and reports those with modemsChanged() alone. When the plugin is
configured that reply is not in yet, so its list is empty.

So a voicecall-manager started while oFono already runs had no
providers at all. That is every restart: Restart=always after a crash,
or a manual restart. No call could be made or received until a modem
came or went, typically until oFono was restarted too. The same could
happen to modems already present when oFono reappears after a restart.
Seen on brax3 and sargo: "Unable to find voice call provider" for every
modem after systemctl restart voicecall-manager.

Follow modemsChanged() as well: add a provider for each listed modem
that has none, and drop the providers of modems no longer listed.
modemAdded() and modemRemoved() still work as before, and each modem
gets one provider however it is announced.

The tests drive the factory against a fake QOfonoManager that emits what
libqofono emits in each case.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 .../src/ofonovoicecallproviderfactory.cpp     | 26 ++++++-
 .../ofono/src/ofonovoicecallproviderfactory.h |  3 +
 tests/fakes/ofono/fake_qofono.h               | 64 +++++++++++++++++
 tests/fakes/ofono/qofonomanager.h             |  2 +
 tests/ofono.pro                               |  8 ++-
 tests/tst_ofonoprovider.cpp                   | 70 +++++++++++++++++++
 6 files changed, 168 insertions(+), 5 deletions(-)
 create mode 100644 tests/fakes/ofono/qofonomanager.h

diff --git a/plugins/providers/ofono/src/ofonovoicecallproviderfactory.cpp b/plugins/providers/ofono/src/ofonovoicecallproviderfactory.cpp
index 7f5d79e..daf8d8a 100644
--- a/plugins/providers/ofono/src/ofonovoicecallproviderfactory.cpp
+++ b/plugins/providers/ofono/src/ofonovoicecallproviderfactory.cpp
@@ -87,12 +87,16 @@ bool OfonoVoiceCallProviderFactory::configure(VoiceCallManagerInterface *manager
 
     QObject::connect(d->ofonoModemManager, SIGNAL(modemAdded(QString)), SLOT(onModemAdded(QString)));
     QObject::connect(d->ofonoModemManager, SIGNAL(modemRemoved(QString)), SLOT(onModemRemoved(QString)));
+    // QOfonoManager learns the modems that already exist from an asynchronous
+    // GetModems, at start and each time oFono reappears, and reports those
+    // with modemsChanged() only, never modemAdded(). Started while oFono was
+    // already running (a restart after a crash), voicecall would otherwise
+    // have no providers at all until a modem came or went.
+    QObject::connect(d->ofonoModemManager, SIGNAL(modemsChanged(QStringList)), SLOT(onModemsChanged(QStringList)));
 
     d->isConfigured = true;
 
-    foreach (QString modemPath, d->ofonoModemManager->modems()) {
-        this->onModemAdded(modemPath);
-    }
+    onModemsChanged(d->ofonoModemManager->modems());
 
     return true;
 }
@@ -139,6 +143,22 @@ void OfonoVoiceCallProviderFactory::onModemAdded(const QString &modemPath)
     }
 }
 
+void OfonoVoiceCallProviderFactory::onModemsChanged(const QStringList &modemPaths)
+{
+    TRACE
+    Q_D(OfonoVoiceCallProviderFactory);
+
+    const QStringList known = d->providers.keys();
+    for (const QString &modemPath : known) {
+        if (!modemPaths.contains(modemPath))
+            onModemRemoved(modemPath);
+    }
+    for (const QString &modemPath : modemPaths) {
+        if (!d->providers.contains(modemPath))
+            onModemAdded(modemPath);
+    }
+}
+
 void OfonoVoiceCallProviderFactory::onModemRemoved(const QString &modemPath)
 {
     TRACE
diff --git a/plugins/providers/ofono/src/ofonovoicecallproviderfactory.h b/plugins/providers/ofono/src/ofonovoicecallproviderfactory.h
index 3200b41..461b7fb 100644
--- a/plugins/providers/ofono/src/ofonovoicecallproviderfactory.h
+++ b/plugins/providers/ofono/src/ofonovoicecallproviderfactory.h
@@ -23,6 +23,8 @@
 
 #include <abstractvoicecallmanagerplugin.h>
 
+#include <QStringList>
+
 class OfonoVoiceCallProviderFactory : public AbstractVoiceCallManagerPlugin
 {
     Q_OBJECT
@@ -45,6 +47,7 @@ public Q_SLOTS:
 protected Q_SLOTS:
     void onModemAdded(const QString &modemPath);
     void onModemRemoved(const QString &modemPath);
+    void onModemsChanged(const QStringList &modemPaths);
 
 private:
     class OfonoVoiceCallProviderFactoryPrivate *d_ptr;
diff --git a/tests/fakes/ofono/fake_qofono.h b/tests/fakes/ofono/fake_qofono.h
index 749ed52..c5e8ce9 100644
--- a/tests/fakes/ofono/fake_qofono.h
+++ b/tests/fakes/ofono/fake_qofono.h
@@ -185,4 +185,68 @@ private:
     QStringList m_interfaces = initialInterfaces();
 };
 
+class QOfonoManager : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit QOfonoManager(QObject *parent = 0) : QObject(parent), m_modems(initialModems()) { last() = this; }
+    ~QOfonoManager() { if (last() == this) last() = 0; }
+
+    static QOfonoManager *&last()
+    {
+        static QOfonoManager *manager = 0;
+        return manager;
+    }
+    // Modems the next manager already knows when it is created
+    static QStringList &initialModems()
+    {
+        static QStringList modems;
+        return modems;
+    }
+
+    QStringList modems() const { return m_modems; }
+
+    // Test controls, emitting what libqofono emits in each case:
+    // the GetModems reply (at start and when oFono reappears) only
+    // changes the list; ModemAdded and ModemRemoved also name the modem;
+    // oFono going away removes each modem.
+    void getModemsReply(const QStringList &modems)
+    {
+        m_modems = modems;
+        m_modems.sort();
+        emit modemsChanged(m_modems);
+    }
+    void addModem(const QString &path)
+    {
+        m_modems.append(path);
+        m_modems.sort();
+        emit modemAdded(path);
+        emit modemsChanged(m_modems);
+    }
+    void removeModem(const QString &path)
+    {
+        if (m_modems.removeOne(path)) {
+            emit modemRemoved(path);
+            emit modemsChanged(m_modems);
+        }
+    }
+    void ofonoGone()
+    {
+        const QStringList modems = m_modems;
+        for (const QString &path : modems)
+            emit modemRemoved(path);
+        m_modems.clear();
+        emit modemsChanged(m_modems);
+    }
+
+Q_SIGNALS:
+    void modemAdded(const QString &path);
+    void modemRemoved(const QString &path);
+    void modemsChanged(const QStringList &modems);
+
+private:
+    QStringList m_modems;
+};
+
 #endif // FAKE_QOFONO_H
diff --git a/tests/fakes/ofono/qofonomanager.h b/tests/fakes/ofono/qofonomanager.h
new file mode 100644
index 0000000..8873f73
--- /dev/null
+++ b/tests/fakes/ofono/qofonomanager.h
@@ -0,0 +1,2 @@

diff --git a/tests/tst_dbusservice.cpp b/tests/tst_dbusservice.cpp
new file mode 100644
index 0000000..4c56eb0
--- /dev/null
+++ b/tests/tst_dbusservice.cpp
@@ -0,0 +1,172 @@
+/*

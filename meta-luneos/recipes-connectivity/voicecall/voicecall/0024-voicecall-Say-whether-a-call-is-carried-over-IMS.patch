 private:
+    // The service answers from this thread, so the call must not block it.
+    QVariantMap properties(const QString &sender, const QString &path)
+    {
+        QDBusMessage msg = QDBusMessage::createMethodCall(sender, path,
+                                                          QLatin1String(CallInterface),
+                                                          QStringLiteral("getProperties"));
+        QDBusPendingCall pending = m_client.asyncCall(msg);
+        QDBusPendingCallWatcher watcher(pending);
+        QSignalSpy finished(&watcher, SIGNAL(finished(QDBusPendingCallWatcher*)));
+        if (!finished.wait(3000) && !pending.isFinished())
+            return QVariantMap();
+        QDBusPendingReply<QVariantMap> reply = pending;
+        if (reply.isError())
+            qWarning() << "getProperties:" << reply.error().message();
+        return reply.isError() ? QVariantMap() : reply.value();
+    }
+
     static bool registered(const QString &id)
     {
         return QDBusConnection::sessionBus().objectRegisteredAt(QStringLiteral("/calls/") + id);
@@ -167,6 +189,44 @@ void tst_DBusService::callBackBeforeItLeftStays()
     QVERIFY(registered(QStringLiteral("back")));
 }
 
+class ImsListener : public QObject
+{
+    Q_OBJECT
+
+public:
+    QList<bool> changes;
+
+public Q_SLOTS:
+    void onImsChanged(bool ims) { changes << ims; }
+};
+
+// Clients see whether a call goes over IMS, in its properties and when it
+// changes.
+void tst_DBusService::imsReachesClients()
+{
+    const QString sender = QDBusConnection::sessionBus().baseService();
+    const QString path = QStringLiteral("/calls/ims1");
+    FakeVoiceCallHandler *call = m_provider->addCall(QStringLiteral("ims1"), false,
+                                                     H::STATUS_ACTIVE);
+    call->setIms(true);
+
+    QVariantMap props = properties(sender, path);
+    QVERIFY(props.contains(QStringLiteral("isIms")));
+    QCOMPARE(props.value(QStringLiteral("isIms")).toBool(), true);
+
+    ImsListener listener;
+    QVERIFY(m_client.connect(sender, path, QLatin1String(CallInterface),
+                             QStringLiteral("imsChanged"),
+                             &listener, SLOT(onImsChanged(bool))));
+    QVERIFY(m_client.interface()->isServiceRegistered(sender).value());
+
+    call->setIms(false);
+    QTRY_COMPARE_WITH_TIMEOUT(listener.changes, QList<bool>() << false, 3000);
+
+    props = properties(sender, path);
+    QCOMPARE(props.value(QStringLiteral("isIms")).toBool(), false);
+}
+
 QTEST_GUILESS_MAIN(tst_DBusService)
 

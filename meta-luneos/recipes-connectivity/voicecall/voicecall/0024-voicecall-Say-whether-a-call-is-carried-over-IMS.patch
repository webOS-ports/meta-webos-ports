+// Whether oFono carries the call over IMS reaches the handler, and a
+// handover out of IMS (SRVCC) is signalled.
+void tst_OfonoProvider::imsFollowsOfono()
+{
+    const QString path = QStringLiteral("/ril_0/voicecall01");
+    OfonoVoiceCallHandler *handler = addValidCall(path, QStringLiteral("dialing"));
+    QVERIFY(handler);
+    QOfonoVoiceCall *call = QOfonoVoiceCall::instances().value(path);
+    QVERIFY(call);
+    QVERIFY(!handler->isIms());
+
+    QSignalSpy spy(handler, SIGNAL(imsChanged(bool)));
+    call->changeIms(true);
+    QVERIFY(handler->isIms());
+    QCOMPARE(spy.count(), 1);
+    QCOMPARE(spy.at(0).at(0).toBool(), true);
+
+    call->changeIms(false);
+    QVERIFY(!handler->isIms());
+    QCOMPARE(spy.count(), 2);
+    QCOMPARE(spy.at(1).at(0).toBool(), false);
+}
+

#!/bin/sh
# wlan-suspend-mode - tell the Qualcomm WLAN driver when the display is off.
#
# On Halium phones with the prima driver (WCNSS/Pronto, e.g. tissot) the firmware's
# broadcast/multicast filter, ARP/NS offload and multicast-address list are armed only
# by the Android private ioctl "DRIVER SETSUSPENDMODE 1" (hdd_set_wlan_suspend_mode);
# the cfg80211 suspend callback does not arm them. Without it every LAN broadcast
# holds qcom_rx_wakelock for 50 ms and the phone is woken every few seconds while
# suspended. Android sends the command on screen off / screen on; this daemon does
# the same from luna://com.palm.display/control/status. On qcacld-3.0 (sargo) the
# command is a no-op (drv_cmd_dummy), so it is harmless there.
#
# Subscription semantics: the first reply carries "state": on|off|dimmed; every later
# push carries only "event": displayOff|displayOn|displayDimmed|displayActive|
# displayInactive|blockedDisplay|unblockedDisplay.
#
# MediaTek's gen4m driver (MP01, module wlan_drv_gen4m_*) implements the same
# command (priv_driver_set_suspend_mode: ARP/NS offload and the multicast white
# list) but takes the request as struct priv_driver_cmd_s {char buf[512]; int
# used_len; int total_len} with the buffer inline, where the Qualcomm drivers
# take {char *buf; int used_len; int total_len}. The layout is picked by the
# loaded module; the wrong one is rejected with EINVAL and does nothing.
#
# MediaTek's older gen2 driver (mindphone, MT6739, module wlan_drv_gen2)
# answers a private command set of three - GET_WIFI_TYPE, SETALWAYSSCANSTATE,
# SET_CHIP - and rejects SETSUSPENDMODE with EINVAL. It does, however,
# advertise nl80211 testmode, and takes the same suspend request that way:
# NL80211_CMD_TESTMODE with NL80211_ATTR_TESTDATA carrying
# struct {u32 idx; u32 buflen; u8 suspend;} with idx 101 (TESTMODE_CMD_ID_SUSPEND).
# That is the mechanism FuriLabs' batman uses for this driver generation
# (src/wifi.c, wifi_set_wmtwifi, itself descended from Jolla's wmtWifi
# handling); the two paths are tried in turn because which one a chip answers
# is a property of the driver generation, not of the request.
#
# The private ioctl is tried first so that every chip that already answers it -
# prima, qcacld, gen4m - behaves exactly as before and testmode is only reached
# where the ioctl has failed.
#
# gen4m also takes "DRIVER SET_MDTIM <which> <n>", which sets how many DTIM
# periods the firmware skips before it listens for buffered group-addressed
# traffic: <which> 0 is the value used while wake-on-WLAN is armed (the
# suspended case, "WOW On MDTIM"), anything else the value used otherwise
# ("WOW Off MDTIM"). Listening on every DTIM is what makes the chip raise the
# host for each beacon that announces buffered broadcast traffic, which on MP01
# was the largest single wake source ("WLAN timeout"). With SETSUSPENDMODE 1
# already dropping that traffic in the firmware, listening every DTIM buys
# nothing, so the screen-off path raises the suspend-time value. Qualcomm
# drivers do not implement SET_MDTIM; the command is only sent for gen4m.

IF=${IF:-wlan0}
STATE=/run/wlan-suspend-mode
# Set while the interface is down *because we downed it*, so the way back up is
# not tied to which mechanism is in use. Without it, a phone left down by the
# fallback and then upgraded to a build whose testmode call succeeds would take
# the early return and never bring the interface back.
DOWNMARK=/run/wlan-suspend-mode.ifdown
cur=$(cat $STATE 2>/dev/null)

log() { echo "$(date -u +%FT%TZ) $*"; }

# MDTIM periods to skip while suspended. 1 keeps the pre-existing behaviour.
MDTIM=${MDTIM:-3}
IW=${IW:-/usr/sbin/iw}

# Take the station interface down once the display has been off this long, on
# chips where staying associated across suspend costs too much to keep up all
# night. "auto" picks 900 s where the "any" WoWLAN trigger is armed and 0 (off)
# elsewhere, a number of seconds sets the delay, "never" or 0 turns it off.
#
# "any" is what luneos-wowlan-arm arms on MediaTek connectivity-chip Wi-Fi
# (Titan, Titan Pocket), which offers no magic-packet trigger: without a trigger
# cfg80211 drops the association on every suspend and the reconnects keep the
# phone awake. With "any" the phones sleep, but the chip stays powered for it.
# Measured 13 Nov 2026, unplugged, display off, both phones 98-99.5% asleep:
#
#                   associated ("any")   Wi-Fi off (wlan0 down)
#   Titan           ~70 mA (126 min)     ~30 mA (166 min)
#   Titan Pocket   ~117 mA (126 min)     ~23 mA (181 min)
#
# so the association alone is 40-95 mA, more than half the Pocket's battery a
# day. Android makes the same trade with "keep Wi-Fi on during sleep: never".
# The delay keeps short screen-offs connected; the down is plain "ip link set
# down", which connman takes as "disconnected" without touching its own Wi-Fi
# setting (Powered stays true, so nothing persists and the UI is unchanged), and
# the display coming on brings it back up; connman was online again 4 s later.
#
# A plain sleep would not do as the timer: CLOCK_MONOTONIC stops in suspend and
# 15 minutes would take hours. Nor would a systemd OnActiveSec= timer, even
# with WakeSystem=true: systemd counts it from the monotonic clock and converts
# to boottime afresh after every resume, so the deadline slid back by exactly
# the time spent suspended (measured on the Titan Pocket, 13 Nov 2026: 108 s
# in 3 minutes). An OnCalendar= time is absolute, and with WakeSystem=true
# systemd arms it as CLOCK_REALTIME_ALARM, which wakes the phone.
#
# Nothing is taken down while the phone is not really sleeping - on a charger,
# or when less than half of the delay was spent in suspend, which is what a
# stream or download holding the phone awake looks like. The check is made
# again one delay later.
WLAN_SLEEP_OFF=${WLAN_SLEEP_OFF:-auto}
SLEEPMARK=/run/wlan-suspend-mode.sleepoff

driver_layout() {
    # SIOCDEVPRIVATE+1 (0x89F1). Qualcomm: hdd_priv_data_t {u8 *buf; int used_len;
    # int total_len}. MediaTek gen4m: priv_driver_cmd_s {char buf[512]; int used_len;
    # int total_len}.
    layout=qcom
    for m in /sys/module/wlan_drv_gen4m*; do [ -e "$m" ] && layout=mtk; done
    # ...and when gen4m is built into the kernel there is no module directory to
    # find, so the loop above leaves "qcom" and the wrong struct goes down the
    # ioctl. Measured on radon (MT6877, CONFIG_MTK_COMBO=y), wlan0 up:
    #
    #   SETSUSPENDMODE 0  layout=qcom -> EINVAL
    #   SETSUSPENDMODE 0  layout=mtk  -> OK
    #
    # so this is not cosmetic: fixing only the unit's condition would have left
    # the command failing on every screen-off. /dev/wmtWifi is MediaTek's WMT
    # character device, created by the combo driver whether it is built in or
    # loaded, and it is already what mtk-connectivity keys off. Checked only
    # after the module loop, so a machine with the module keeps deciding the
    # same way it always did.
    [ "$layout" = qcom ] && [ -e /dev/wmtWifi ] && layout=mtk
    echo "$layout"
}

drvcmd() {
    layout=$(driver_layout)
    python3 - "$IF" "$1" "$layout" <<'PY'
import sys, socket, fcntl, ctypes, struct
ifname, cmd, layout = sys.argv[1], sys.argv[2].encode() + b"\0", sys.argv[3]
if layout == "mtk":
    priv = ctypes.create_string_buffer(512 + 8)
    ctypes.memmove(priv, cmd, len(cmd))
    struct.pack_into("ii", priv, 512, len(cmd), 512)
else:
    buf = ctypes.create_string_buffer(cmd, 4096)
    priv = ctypes.create_string_buffer(struct.pack("PiiI", ctypes.addressof(buf), len(cmd), 4096, 0))
ifr = struct.pack("16sP", ifname.encode(), ctypes.addressof(priv)) + b"\0" * 16
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    fcntl.ioctl(s.fileno(), 0x89F1, ifr)
except OSError as e:
    sys.exit("DRIVER %s failed: %s" % (cmd[:-1].decode(), e))
PY
}

# Some drivers have no screen-off command at all. MediaTek's older gen2
# (mindphone, MT6739) is detected by mtk-wifi-suspend, which returns failure
# there so the interface-down path is used: measured on mindphone 2026-09-21,
# 4 suspends in a 957 s window, 948 s of it asleep, longest 588 s.
#
# So where the driver cannot filter, take the station interface down instead.
# That is only acceptable because nothing is being given up: this chip
# advertises no magic-packet trigger either (only "any", which keeps the chip
# fully powered, and "disconnect"), so cfg80211 would tear the association
# down on suspend regardless. Where a driver does accept the command, or the
# chip can be woken by a magic packet, this path is never used.
iface_down_allowed() {
    [ "${WLAN_DOWN_FALLBACK:-auto}" = "never" ] && return 1
    [ "${WLAN_DOWN_FALLBACK:-auto}" = "always" ] && return 0
    # auto: only when the chip could not be woken over the air anyway
    "$IW" phy "$(iface_phy)" info 2>/dev/null | grep -q "wake up on magic packet" && return 1
    return 0
}

iface_phy() {
    if [ -e "/sys/class/net/$IF/phy80211" ]; then
        basename "$(readlink -f "/sys/class/net/$IF/phy80211")"
    else
        echo phy0
    fi
}

iface_state() { cat "/sys/class/net/$IF/operstate" 2>/dev/null; }

# Bring the station interface back if the fallback had taken it down. Safe to
# call whenever we return to normal: it does nothing unless we left the marker.
undo_iface_down() {
    [ -e "$DOWNMARK" ] || return 0
    if ip link set "$IF" up 2>/dev/null; then
        rm -f $DOWNMARK
        log "$1 -> $IF brought back up after earlier fallback (state=$(iface_state))"
    else
        log "$1 -> $IF still down and could not be brought up"
    fi
}

sleep_off_delay() {
    case "$WLAN_SLEEP_OFF" in
        never) echo 0 ;;
        auto)
            if "$IW" phy "$(iface_phy)" wowlan show 2>/dev/null | grep -q "any"; then
                echo 900
            else
                echo 0
            fi ;;
        ''|*[!0-9]*) echo 0 ;;
        *) echo "$WLAN_SLEEP_OFF" ;;
    esac
}

# Seconds since boot, and how many of them were spent in suspend.
clocks() {
    python3 -c 'import time; b = time.clock_gettime(time.CLOCK_BOOTTIME); print("%d %d" % (b, b - time.clock_gettime(time.CLOCK_MONOTONIC)))'
}

on_charger() {
    for d in /sys/class/power_supply/*/; do
        case "$(cat "$d/type" 2>/dev/null)" in
            Mains|USB|USB_PD|USB_PD_DRP|USB_TYPE_C) ;;
            *) continue ;;
        esac
        [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && return 0
    done
    return 1
}

cancel_sleep_off() {
    systemctl stop 'wlan-sleep-off-*.timer' 2>/dev/null
    rm -f $SLEEPMARK
}

# A new unit name each time: the re-arm runs from inside the service the last
# timer started, and that unit name is still taken while it runs.
arm_sleep_off() {
    delay=$(sleep_off_delay)
    [ "$delay" -gt 0 ] || return 0
    cancel_sleep_off
    clocks > $SLEEPMARK
    # The timer's service is started by systemd, not by us: hand it the
    # settings this instance runs with, or a re-arm from there falls back to
    # the defaults.
    now=$(date +%s)
    at=$(date -u -d "@$((now + delay))" "+%Y-%m-%d %H:%M:%S UTC")
    if systemd-run --quiet --collect --unit="wlan-sleep-off-$now" \
        --setenv=IF="$IF" --setenv=WLAN_SLEEP_OFF="$WLAN_SLEEP_OFF" \
        --on-calendar="$at" --timer-property=WakeSystem=true \
        --timer-property=AccuracySec=10s \
        /usr/sbin/wlan-suspend-mode sleep-off 2>/dev/null; then
        log "$1 -> $IF goes down in ${delay}s if the display stays off"
    else
        log "$1 -> could not arm the ${delay}s Wi-Fi sleep timer"
    fi
}

sleep_off() {
    if [ "$cur" != suspendmode ]; then
        log "sleep timer -> display is on, nothing to do"; return 0
    fi
    if [ -e "$DOWNMARK" ] || [ "$(iface_state)" != up ]; then
        # Already down: ours, or Wi-Fi switched off - neither is ours to undo.
        log "sleep timer -> $IF not up, leaving it"; rm -f $SLEEPMARK; return 0
    fi
    if on_charger; then
        log "sleep timer -> on a charger, keeping $IF up"
        arm_sleep_off "sleep timer"; return 0
    fi
    # Split on purpose: "<boot> <asleep>" at display-off, then the same now.
    # shellcheck disable=SC2046
    set -- $(cat $SLEEPMARK 2>/dev/null) $(clocks)
    if [ $# = 4 ] && [ "$3" -gt "$1" ]; then
        pct=$(( ($4 - $2) * 100 / ($3 - $1) ))
        if [ "$pct" -lt 50 ]; then
            log "sleep timer -> only ${pct}% asleep since the display went off, something is using the phone: keeping $IF up"
            arm_sleep_off "sleep timer"; return 0
        fi
    fi
    if ip link set "$IF" down 2>/dev/null; then
        : > $DOWNMARK; rm -f $SLEEPMARK
        log "sleep timer -> display off for $(sleep_off_delay)s, $IF down until it comes on (state=$(iface_state))"
    else
        log "sleep timer -> $IF could not be brought down"
    fi
}

# r9 switched the CPU governors to powersave at display off and kept the
# originals here. CPU tuning is batman-luna's job now; if this file is still
# there (upgraded while the display was off), put those governors back once.
# /run is gone after a reboot, so this only ever runs in that window.
GOVMARK=/run/wlan-suspend-mode.governors
if [ -e "$GOVMARK" ]; then
    while IFS='=' read -r cpu gov; do
        f="/sys/devices/system/cpu/cpu${cpu}/cpufreq/scaling_governor"
        [ -f "$f" ] && echo "$gov" > "$f" 2>/dev/null || true
    done < "$GOVMARK"
    rm -f "$GOVMARK"
    log "startup -> cpufreq governors left by r9 restored"
fi

apply() {  # $1 = suspendmode|normal, $2 = reason
    if [ "$1" = normal ]; then
        # Before anything else, and also when already normal: the sleep timer
        # downs the interface from its own process, behind this one's back.
        cancel_sleep_off
        undo_iface_down "$2"
    fi
    if [ "$1" = "$cur" ]; then log "$2 -> already $1"; return; fi
    if [ "$1" = suspendmode ]; then n=1; else n=0; fi

    # Not on gen3 (Titan, Titan Pocket): it has no SET_MDTIM, and its private
    # command handler logs "Unknown driver command ... - ignored" and still
    # returns success (gl_wext_priv.c, priv_driver_cmds), so sending it there
    # only put a false "ok" in this log.
    if [ "$n" = 1 ] && [ "$(driver_layout)" = mtk ] && [ "$MDTIM" -gt 1 ] &&
       [ ! -d /sys/module/wlan_drv_gen3 ] && [ ! -d /sys/module/wlan_drv_gen2 ]; then
        if drvcmd "SET_MDTIM 0 $MDTIM"; then
            log "$2 -> SET_MDTIM 0 $MDTIM ok"
        else
            log "$2 -> SET_MDTIM 0 $MDTIM FAILED"
        fi
    fi
    # mtk-wifi-suspend tries SETSUSPENDMODE via SIOCDEVPRIVATE+1 (auto-layout)
    # first, then NL80211 testmode CMD_ID 101.  Gen2 (wlan_drv_gen2) accepts
    # both but filters nothing; the binary returns failure there so the
    # interface-down path below is used instead.
    # return 0, not bare return: the [ "$n" = 1 ] test below is the last
    # command run before the return, and it is FALSE when n=1, so a bare
    # return would exit 1 from the successful suspend path.
    if err=$(mtk-wifi-suspend "$IF" "$n" 2>&1); then
        cur=$1; echo "$1" > $STATE; log "$2 -> wifi-suspend suspend=$n ok (mode=$1)"
        [ "$n" = 1 ] && arm_sleep_off "$2"
        [ "$n" = 0 ] && undo_iface_down "$2"
        return 0
    fi
    log "$2 -> wifi-suspend suspend=$n failed (${err:-no detail})"

    # Only now is there genuinely no way to make the firmware filter.
    if ! iface_down_allowed; then
        return
    fi
    if [ "$n" = 1 ]; then
        if ip link set "$IF" down 2>/dev/null; then
            cur=$1; echo "$1" > $STATE; : > $DOWNMARK
            log "$2 -> no driver filter, $IF down instead (state=$(iface_state))"
        else
            log "$2 -> no driver filter and $IF could not be brought down"
        fi
    else
        if ip link set "$IF" up 2>/dev/null; then
            cur=$1; echo "$1" > $STATE; rm -f $DOWNMARK
            log "$2 -> $IF up again (state=$(iface_state))"
        else
            log "$2 -> $IF could not be brought up"
        fi
    fi
}

case "$1" in
    on|normal)       apply normal "manual"; exit ;;
    sleep-off)       sleep_off; exit ;;
    off|suspendmode) apply suspendmode "manual"; exit ;;
    status)          echo "mode=${cur:-unset}"; exit ;;
esac

# The unit starts with the display manager, which on a Halium phone is before
# the container has loaded the WLAN driver: no wlan0 yet, and the private ioctl
# answers ENODEV. Wait for the interface (measured on tissot: it appears about
# a minute into boot) rather than firing the first command into nothing.
#
# Bounded, because this wait is now the only gate. The unit used to carry
# ConditionPathExistsGlob=/sys/module/wlan*, which silently excluded every
# machine whose driver is built in rather than loaded - radon ran for its whole
# uptime with ConditionResult=no. Waiting here instead covers module and
# built-in alike, but an unbounded loop would then leave a process spinning for
# ever on a machine that has no WLAN at all, so give up and tell systemd not to
# restart us (exit 3 is in the unit's RestartPreventExitStatus).
waited=0
while [ ! -e /sys/class/net/$IF ]; do
    waited=$((waited + 2))
    if [ $waited -ge ${WLAN_IFACE_WAIT:-300} ]; then
        log "no $IF after ${waited}s - nothing to manage on this machine, giving up"
        exit 3
    fi
    sleep 2
done
log "watching luna://com.palm.display/control/status on $IF (current mode=${cur:-unset})"
# A subscription that fails (hub not ready, display manager restarting) ends
# the reader loop; systemd restarts the unit, and the state file keeps the last
# mode across that.
tail -f /dev/null | luna-send -i -f luna://com.palm.display/control/status '{"subscribe":true}' 2>/dev/null |
while read -r line; do
    case "$line" in
        *'"state"'*'"off"'*)                        apply suspendmode "state off" ;;
        *'"state"'*'"on"'*|*'"state"'*'"dimmed"'*)  apply normal "state $(echo "$line" | tr -d ' ,')" ;;
        *'"event"'*'"displayOff"'*)                 apply suspendmode "event displayOff" ;;
        *'"event"'*'"displayOn"'*)                  apply normal "event displayOn" ;;
        *'"event"'*'"displayDimmed"'*)              apply normal "event displayDimmed" ;;
    esac
done
# luna-send went away (display manager restarted?) - leave the driver in normal mode
# so a screen-on phone is never left filtering; systemd restarts us.
apply normal "subscription ended"
exit 1

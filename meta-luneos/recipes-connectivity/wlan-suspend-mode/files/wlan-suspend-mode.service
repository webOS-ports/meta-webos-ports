[Unit]
Description=Arm WLAN firmware broadcast/multicast filtering while the display is off
Documentation=file:///usr/sbin/wlan-suspend-mode
# The private ioctl exists on the Qualcomm Halium drivers (prima / qcacld,
# module "wlan") and on MediaTek gen4m ("wlan_drv_gen4m_<soc>").
ConditionPathExistsGlob=/sys/module/wlan*
After=luna-displaymanager.service ls-hubd.service
Wants=luna-displaymanager.service

[Service]
Type=simple
ExecStart=/usr/sbin/wlan-suspend-mode
ExecStopPost=/usr/sbin/wlan-suspend-mode normal
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

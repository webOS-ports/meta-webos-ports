[Unit]
Description=Arm WLAN firmware broadcast/multicast filtering while the display is off
Documentation=file:///usr/sbin/wlan-suspend-mode
# No ConditionPathExistsGlob=/sys/module/wlan* here, deliberately. The private
# ioctl exists on the Qualcomm Halium drivers (prima / qcacld, module "wlan")
# and on MediaTek gen4m ("wlan_drv_gen4m_<soc>"), and testing for the module
# directory looked like a cheap way to ask "is one of those loaded". It is not:
# it assumes the driver is a MODULE. radon builds the MediaTek combo driver
# into the kernel (CONFIG_MTK_COMBO=y), so /sys/module/wlan* never exists there
# and systemd reported ConditionResult=no for the whole uptime - the unit had
# never run once on that machine.
#
# There is no better path to test either: a built-in driver's only early marks
# are its own character devices, which are vendor-specific. So the gate moved
# into the script, which waits for the station interface itself and gives up
# cleanly (exit 3) if none appears - covering module, built-in, early and late
# alike. RestartPreventExitStatus keeps that give-up from being restarted.
After=luna-displaymanager.service ls-hubd.service
Wants=luna-displaymanager.service

[Service]
Type=simple
ExecStart=/usr/sbin/wlan-suspend-mode
ExecStopPost=/usr/sbin/wlan-suspend-mode normal
Restart=always
RestartPreventExitStatus=3
RestartSec=5

[Install]
WantedBy=multi-user.target

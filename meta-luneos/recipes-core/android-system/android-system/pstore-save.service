[Unit]
Description=Save the kernel's crash records from pstore
# After the container, whose init.ramoops.sh decrypts the records on a Pixel.
After=android-system.service

[Service]
# Not oneshot: multi-user.target would wait for it, and it can wait up to
# two minutes for the vendor's decryption.
Type=simple
ExecStart=/usr/bin/save-pstore.sh

[Install]
WantedBy=multi-user.target

# Raspberry Pi (2-model-b-rev2), assuming the official 7" 800x480 touchscreen.
#
# Migrated from luna-sysmgr-conf/raspberrypi2/luna-platform.conf. One adaptation per
# board compatible, because the codename comes from the device tree - the part
# after the comma in /proc/device-tree/compatible - and each board model
# reports its own.
#
# deviceinfo_grid_unit is pinned: the derivation from 133 PPI gives 8 only by
# rounding, and the shipped 8 is what the UI was laid out against.
#
# No buttons of any kind on a bare board, so the shell must not offer the
# affordances that assume them.
deviceinfo_display_dpi="133"
deviceinfo_grid_unit="8"
deviceinfo_tablet_ui="true"
deviceinfo_show_notifications_at_top="true"
deviceinfo_has_volume_button="false"
deviceinfo_has_power_button="false"
deviceinfo_has_brightness_control="false"

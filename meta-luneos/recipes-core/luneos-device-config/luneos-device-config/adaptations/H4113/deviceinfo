# Tier 1 adaptation for the Sony Xperia XA2 (pioneer, SDM630).
#
# THE DIRECTORY NAME IS THE MODEL NUMBER, NOT THE CODENAME (as OnePlus6T/ for
# fajita). luneos-device-config keys adaptations by ro.product.vendor.device, and
# LineageOS's pioneer vendor reports the Sony model there: an H4113 on
# LineageOS 24.0 (24.0-20261015-NIGHTLY) reads
#
#   ro.product.vendor.device=H4113
#   ro.product.device=H4113
#
# H3113, H3123, H3133 and H4133 are symlinks to this directory. Those four names
# are the other XA2 models from the LineageOS wiki, assumed - not observed - to
# be reported the same way.
#
# Measured on an H4113 (getevent -p, 27 Oct 2026, LineageOS kernel):
#
#   event0  qpnp_pon                         KEY_VOLUMEUP, KEY_POWER
#   event1  s5712_sensor                     no keys
#   event2  SOMC USB Removal                 KEY 0xc2
#   event3  gpio-keys                        KEY_VOLUMEDOWN + the two camera keys
#   event4  synaptics_dsx                    the touchscreen (the only ABS device)
#   event5  sdm660-snd-card-mtp Headset Jack
#   event6  sdm660-snd-card-mtp Button Jack  KEY_VOLUMEDOWN/UP and media keys
#
# The touchscreen derives (one device advertises ID_INPUT_TOUCHSCREEN) and is
# not pinned.

# Derivation takes everything claiming KEY_POWER or a volume key that is not the
# touchscreen, which here also sweeps in the headset button jack (event6). Pin the
# two real key devices, by name, never by node number.
deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys"

# The panel's true physical PPI: 5.2" diagonal at 1080x1920 is
# sqrt(1080^2+1920^2)/5.2 = 423.6. Not derivable - an internal DSI panel does not
# report its physical size - and Android's density bucket (420) is a different
# number. The panel is a Truly TD4322 command-mode DSI
# (mdss_dsi_td4322_truly_fhd_cmd on this unit's cmdline).
deviceinfo_display_dpi="424"

# Carried over from sargo, whose panel is the same 1080 px wide in the same
# 420-440 density bucket: 1080/2.4 = 450 CSS px, which fixed-layout Enyo apps
# are built for. Measured on sargo, only reasoned about here - if the UI looks
# right without it, delete the line rather than keeping a number nobody checked.
deviceinfo_device_pixel_ratio="2.4"

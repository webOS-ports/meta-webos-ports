# Tier 1 adaptation for the OnePlus 6T (fajita).
#
# THE DIRECTORY NAME IS NOT THE CODENAME, AND THAT IS DELIBERATE.
#
# luneos-device-config keys adaptations by what the *vendor* calls the device -
# ro.product.vendor.device - because on a GSI ro.product.device is the GSI's
# (halium_arm64), not the phone's. Google and Xiaomi put the codename there, so
# sargo/sunfish/surya adaptations are named for their codename and the
# distinction never came up. OnePlus does not: this vendor's build.prop says
#
#   ro.product.vendor.device=OnePlus6T
#   ro.product.vendor.model=ONEPLUS A6013
#
# (read out of the vendor.img in lineage-22.2-20260922-nightly-fajita). An
# adaptations/fajita directory is therefore never looked at - the log says "no
# adaptation for 'OnePlus6T'" and the port silently runs on derived values only.
# The Yocto MACHINE stays "fajita"; only this directory follows the vendor.
#
# Only what cannot be derived belongs here. The codename, the vendor API level
# and the touchscreen node all derive at runtime; nothing about them is pinned.
#
# UNVERIFIED: written from LineageOS's device and kernel trees (lineage-22.2),
# not from a booted OnePlus 6T. Check each value against the device before
# trusting it - especially the input names, which are driver/DT names and can
# differ from what the node ends up advertising.

# Key devices. Derivation takes everything claiming KEY_POWER or a volume key
# that is not the touchscreen, and this device has an unusually crowded input
# space for a slab phone - which is exactly the athena trap:
#
#   qpnp_pon        power key, pm8998 (and the volume-down half of the pon combo)
#   gpio_keys       volume up, volume down (pm8998_gpios 5) and the hall sensor;
#                   the node sets compatible = "gpio-keys", label = "gpio-keys",
#                   which is the name the driver gives the input device
#   tri_state_key   the alert slider (oneplus,tri-state-key) - a switch, so it
#                   should not claim keys, but it is an input device
#   goodix_fp       the under-display fingerprint reader, whose driver and HAL
#                   can register an input device of their own
#
# The two real ones are pinned by name, never by node number: numbering shifts
# with which drivers register on a given boot.
deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys"

# The panel's true physical PPI: 6.41" diagonal at 1080x2340 is
# sqrt(1080^2+2340^2)/6.41 = 402. Not derivable - it needs the panel's physical
# dimensions, which an internal DSI panel does not report - and Android's
# density bucket for this device (450, TARGET_SCREEN_DENSITY) is a different
# number that happens to be close.
deviceinfo_display_dpi="402"

# Carried over from sargo and sunfish, whose panels are the same 1080 px wide.
# webOS apps are fixed-layout Enyo pages, so the ratio decides how many CSS
# pixels they get: 1080/2.4 = 450, which is what they are built for, while the
# "natural" density/160 of 2.51 gives 430 and they inflate and clip. That was
# measured on sargo and only reasoned about here - if the UI looks right without
# it, delete the line rather than keeping a number nobody checked.
deviceinfo_device_pixel_ratio="2.4"

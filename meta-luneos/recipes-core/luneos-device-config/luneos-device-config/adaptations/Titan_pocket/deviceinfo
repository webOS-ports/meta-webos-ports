# LuneOS adaptation for the Unihertz Titan Pocket (Titan_pocket, MT6771).
#
# Only what cannot be derived belongs here. The panel, density, touchscreen,
# keys and modem slots all derive correctly on this device (journal of
# 9 Oct 2026).

# The vendor blobs are VNDK 30 (/vendor/etc/selinux/plat_sepolicy_vers.txt
# reads 30.0) but the GSI is Android 16, and audio.primary.mt6771.so fails to
# load into pulseaudio on the same symbol the Mindset's MT6739 HAL did:
#
#   cannot locate symbol "_ZN7android13TypeConverterINS_13DefaultTraitsI14audio_format_tEEE6mTableE"
#     referenced by "/android/vendor/lib64/hw/audio.primary.mt6771.so"
#
# module-droid-card then fails, only the null sinks exist, and the phone is
# silent while the volume keys still give their feedback. This makes
# 70-pulseaudio-env put HYBRIS_USE_VENDOR_NAMESPACE and HYBRIS_PREFER_VNDK in
# pulseaudio's environment; see that generator for why it takes both.
deviceinfo_hybris_prefer_vndk="1"

# The back camera's preview is upside down on gst-droid: the HAL reports a
# mounting the picture does not have. Measured on the device (12 Oct 2026): a
# back rotation of 180 gives an upright, unmirrored preview (printed text reads
# normally), and the front camera is right at the default. 36-camera-app hands
# this to the Camera app.
deviceinfo_camera_back_rotation="180"

# The keyboard backlight is the LED class device button-backlight (the kernel's
# GPIO 159 pulse driver), and the lights HAL here is an empty stub, so nyx finds
# no keyboard light by itself. Measured on the device (11 Nov 2026): 255 lights
# the keys, 0 turns them off. 30-nyx-conf hands this to nyx's led_controller.
deviceinfo_keypad_backlight_path="/sys/class/leds/button-backlight"

# The notification LED is the MT6370's RGB LED, four numbered channels.
# Measured on the device (11 Nov 2026), each lit on its own with the cc_mode
# trigger: led4 is red (it is also the charge indicator, which the charger
# drives when nothing else does), led2 green, led3 blue; led1 lights nothing.
# 30-nyx-conf hands these to nyx's led_controller.
deviceinfo_notification_led_red_path="/sys/class/leds/mt6370_pmu_led4"
deviceinfo_notification_led_green_path="/sys/class/leds/mt6370_pmu_led2"
deviceinfo_notification_led_blue_path="/sys/class/leds/mt6370_pmu_led3"

# The vendor's neural-network HAL (neuralnetworks_hal_service_mtk_neuron)
# exits with status 1 as soon as it starts, and init restarted it every 5 s,
# each time also running flags_health_check UPDATABLE_CRASHING (45 restarts in
# a boot's first 4 minutes, 205 in 17 minutes, 13 Nov 2026). It is "disabled",
# but the vendor rc starts it itself on ro.vendor.mtk_nn_support=1, so keeping
# start-android-hals.sh from starting it was not enough: it is stopped.
# Nothing on LuneOS uses the Android neural-network API.
deviceinfo_android_stop_services="neuralnetworks_hal_service_mtk_neuron"

# The red programmable key on the left side. As on the Titan, the vendor's dtbo
# gives it keycode 250 on mtk-kpd (kpd-hw-init-map slot 1, read on the device
# 13 Nov 2026), which the keymap gives Qt as Key_Launch1. It does nothing until
# the user picks something in Settings > Buttons.
deviceinfo_key_actions="Key_Launch1=none|hold=none|label=Red key"

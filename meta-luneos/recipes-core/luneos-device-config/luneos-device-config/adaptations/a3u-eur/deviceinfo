# Tier 1 adaptation for the Samsung Galaxy A3 (2015), mainline kernel.
#
# The directory name is "a3u-eur", not the machine name "a3-2015": this device
# has no Android container, so every ro.product.* property is empty and the
# codename falls through to the device tree, where
# msm8916-samsung-a3u-eur.dts says
#     compatible = "samsung,a3u-eur", "qcom,msm8916";
# and the generator takes the part after the comma. One device tree covers
# every A3 2015 variant (a3lte, a3ulte, a33g), so one adaptation does too.
deviceinfo_name="Samsung Galaxy A3 (2015)"
deviceinfo_name_short="Galaxy A3"

# Five separate input devices carry keys or switches on this board, and none of
# them is where a single-node guess would put it:
#   pm8941_pwrkey              power              (PM8916, pon@800:pwrkey)
#   pm8941_resin               volume down        (PM8916, pon@800:resin)
#   GPIO Buttons               volume up, home    (gpio-keys, the DT `label`)
#   tm2-touchkey               back, recents      (capacitive keys below the screen)
#   GPIO Hall Effect Sensor    flip cover         (gpio-keys, EV_SW/SW_LID, tlmm 52)
#
# By name, never by node number. The Zinitix touchscreen does not always probe,
# and everything enumerated after a device that failed to appear shifts up one,
# so /dev/input/eventN is a bet on enumeration order that silently points at the
# wrong device when it loses.
#
# tm2-touchkey is included deliberately: without it the two capacitive keys
# either side of the home button do nothing at all, which on a phone with no
# on-screen back affordance is the difference between usable and not. Drop it
# from this list if the touchkeys turn out to fire spuriously - the DT node is
# &touchkey in msm8916-samsung-a3u-eur.dts.
# The hall sensor is a second, separate gpio-keys node with its own DT label,
# not part of "GPIO Buttons", so it needs naming here too. It reports EV_SW
# SW_LID rather than a key press, which is what an S View flip cover closing
# over the screen looks like.
deviceinfo_key_devices_by_name="GPIO Buttons;GPIO Hall Effect Sensor;pm8941_pwrkey;pm8941_resin;tm2-touchkey"

# The A3 has a physical home button below the screen, which is the one chassis
# property 50-luna-platform cannot guess - it defaults off, because most
# devices have none. Everything else luna-sysmgr needs is either derived from
# the panel or correct at its default, so this machine ships no
# luna-platform.conf of its own.
#
# EnableALS is deliberately NOT declared: the generator looks for an IIO device
# exposing illuminance and answers the question directly. This board has a
# cm36652 at 0x60, so it comes out true without anyone saying so - and if that
# driver ever fails to probe, the slider disables itself rather than lingering
# with nothing behind it.
deviceinfo_has_home_button="true"

# 4.5" 540x960 AMOLED, so 245 PPI. This is the one number 50-luna-platform
# cannot work out for itself: it needs the panel's physical size, and an
# internal DSI panel carries no EDID to read it from. Without it the generator
# falls back to 320 and the whole shell comes out the wrong size.
#
# GridUnit is deliberately not declared alongside it. Declaring a DPI means
# declaring the number GridUnit is computed from, and the derivation lands on
# 14 here - the same value this device shipped by hand before it had an
# adaptation.
deviceinfo_display_dpi="245"

# Everything else - panel geometry, DPI, grid unit, compositor geometry, pixel
# ratio, battery and charger sysfs paths - derives correctly from the DRM
# connector and /sys/class/power_supply (rt5033-battery / rt5033-charger), so
# it is deliberately not declared here.

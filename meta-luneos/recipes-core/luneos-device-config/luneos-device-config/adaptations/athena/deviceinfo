# Tier 1 adaptation for the BlackBerry KEY2 (athena, BBF100-8, SDM660).
#
# Only what cannot be derived belongs here.
#
# The touchscreen normally derives: exactly one input device advertises
# ID_INPUT_TOUCHSCREEN. It is pinned anyway because athena has an unusually
# crowded input space for a phone - seven nodes, three of which are key-like -
# and because the one that matters is not the obvious one:
#
#   event0  qpnp_pon         power button
#   event1  touch_keypad     capacitive keys below the screen
#   event2  stmpe_keypad     the physical QWERTY keyboard
#   event3  synaptics_dsx_2  the touchscreen   <- this one
#   event4  qti-haptics      vibrator
#   event5  nav_key          navigation strip
#   event6  gpio-keys        volume etc.
#
# event1 being a *keypad* named "touch_keypad" is the trap: the shipped
# placeholder used to be /dev/input/event1, which is the touchscreen on sargo,
# and on athena it points at the capacitive keys instead - a compositor that
# starts, draws, and never responds to the panel.
#
# Pinned by name, never by node number, for the reason sargo's file gives:
# numbering shifts with which drivers register on a given boot.
deviceinfo_touchscreen_by_name="synaptics_dsx_2"

# Derivation takes everything claiming KEY_POWER or a volume key that is not the
# touchscreen, which here also sweeps in the haptics node and the capacitive
# keys. Pin the four that are real keys. The QWERTY keyboard is the reason this
# device exists, so stmpe_keypad is not optional.
deviceinfo_key_devices_by_name="qpnp_pon;stmpe_keypad;nav_key;gpio-keys"

# 4.5" 1080x1620 (3:2). sqrt(1080^2+1620^2)/4.5 = 433.
# The LineageOS device tree buckets this as TARGET_SCREEN_DENSITY := 384, which
# is the Android bucket, not the panel's real PPI.
deviceinfo_display_dpi="433"

# Deliberately NOT set here: deviceinfo_device_pixel_ratio. sargo needed a value
# well away from the natural density/160, and the only way to find it is to look
# at the device. Until someone does, the derived value stands.

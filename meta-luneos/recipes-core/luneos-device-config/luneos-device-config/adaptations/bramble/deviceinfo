# Tier 1 adaptation for the Google Pixel 4a 5G (bramble).
#
# Only what cannot be derived belongs here. UNVERIFIED throughout: written from
# LineageOS's redbull trees and the stock factory image, not from a booted
# device.

# The same trap sargo documents, and for the same reason: bramble has an fpc
# fingerprint sensor (fpc1020_platform_tee.ko in redbull's modules.load), whose
# HAL registers a uinput device that advertises key codes. Derivation would
# sweep it in alongside the real keys.
#
# qpnp-power-on.ko is the power key; the volume keys come off the same PMIC
# node on this platform. Pinned by name, never by node number - numbering
# shifts with which modules registered on a given boot, which on a device that
# loads 329 of them is less stable than usual.
deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys"

# 6.24" 1080x2340: sqrt(1080^2+2340^2)/6.24 = 413, which is also what Google
# publishes. Not derivable - an internal DSI panel reports no physical size -
# and Android's density bucket (410) is a different number.
deviceinfo_display_dpi="413"

# Deliberately NOT set: deviceinfo_device_pixel_ratio. sunfish inherits sargo's
# 2.4 because the two panels are the same width in the same density bucket;
# bramble is 1080 wide too, so 2.4 is the number to try first - but nobody has
# looked at this screen, and athena's file makes the case for leaving the
# derived value in place until someone does.

# Tier 1 adaptation for the LG Nexus 5X (bullhead), machine bullhead-halium.
#
# Only what cannot be derived belongs here. The codename derives from the vendor
# (ro.product.vendor.device=bullhead in its build.prop).
#
# The panel's physical PPI, which an internal DSI panel does not report. The
# kernel's device tree gives the 1080x1920 panel as 65 x 115 mm
# (qcom,mdss-pan-physical-{width,height}-dimension), 422 and 424 pixels per inch
# on the two axes; Android's density bucket (ro.sf.lcd_density=420) is a
# different number. Not yet checked on a booted device, and nothing else here
# (key devices, pixel ratio) has been looked at on one either.
deviceinfo_display_dpi="423"

# wcnss_filter (start_hci_filter, "disabled" in the vendor's init.bullhead.rc) only runs when
# libbt-vendor asks for it through wc_transport.start_hci. Here libbt-vendor opens /dev/ttyHS0
# itself, and with start-android-hals.sh force-starting the filter at boot both read the UART: the
# filter ate the controller's answers ("WCNSS_FILTER: handle_soc_events: Unexpected data format"),
# Bluetooth initialisation never finished and bluebinder timed out (rounds 10 and 11).
deviceinfo_android_skip_services="start_hci_filter"

# LuneOS adaptation for hammerhead.

# Migrated from luna-sysmgr-conf/hammerhead,hammerhead-halium/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
#
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) does not
# land on what this device shipped, and the shipped value is the one that was
# actually looked at on the hardware. Where the two agree it is left out so the
# derivation stays in charge.
deviceinfo_display_dpi="445"
deviceinfo_grid_unit="26"

# Mainline only (the generator ignores it where an Android container is present,
# so hammerhead-halium keeps its GPU).
# The Nexus 5 has an Adreno 330, but the mainline msm driver cannot run it yet:
# there is no IOMMU the kernel can use on the MSM8974, so the DRM device comes up
# without a GPU and freedreno fails on its first query. Until that is solved the
# compositor has to render in software; 25-surface-manager-swrast turns this
# into the Mesa environment. Remove the line when the GPU works.
deviceinfo_gpu_accelerated="false"

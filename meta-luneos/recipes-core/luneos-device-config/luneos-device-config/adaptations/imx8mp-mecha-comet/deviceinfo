# LuneOS device adaptation: Mecha Comet (i.MX8M Plus).
# Read by /usr/bin/luneos-device-config (Tier 1); values not derivable from the
# hardware. Installed at
# /usr/share/luneos/adaptations/imx8mp-mecha-comet/deviceinfo.
#
# Named for the device tree codename ("mecha,imx8mp-mecha-comet"), not the Yocto
# MACHINE (comet-imx8mp).
#
# This sits here rather than in meta-mecha-luneos because luneos-device-config
# ships every adaptation in one non-MACHINE_ARCH package on purpose - the whole
# set is a few hundred KB and the image stays universal. That is the opposite of
# the argument the nyx-modules bbappend in meta-mecha-luneos makes, and
# deliberately so: this is runtime content, not per-machine build input.

# Shown as the device name in Settings. Derivation would give the device tree's
# model, "IMX8MP Mecha Comet", which leads with the SoC. See
# generators/90-prefs-properties.
deviceinfo_name="Comet"

# The panel's true physical PPI, and the one number 50-luna-platform cannot work
# out for itself: an internal DSI panel carries no EDID and there is no Android
# container to read a density from, so without this the generator falls all the
# way through to LAST_RESORT_DPI and sizes the shell for 320.
#
# 421 is read off the panel driver rather than guessed. rp5_display_mode in
# drivers/gpu/drm/panel/panel-ddic-ch13726a.c is 1080x1240 at 65x75 mm:
#
#   across    1080 * 25.4 / 65 = 422
#   down      1240 * 25.4 / 75 = 420
#   diagonal  1644 px / 3.91 in = 421
#
# Caveat worth knowing before trusting it to the pixel: that driver's width_mm
# carries the comment "or round as needed", so the millimetres are the vendor's
# round numbers rather than a measurement. They are at least self-consistent -
# 65x75 mm is a 99.2 mm diagonal, which is the 3.91" Mecha publishes.
#
# This makes the Comet the densest panel LuneOS runs on: the PinePhones are 282
# and the PineTab2 is 132.
deviceinfo_display_dpi="421"

# deviceinfo_grid_unit is deliberately NOT pinned.
#
# The derivation gives 421 * 1.44 mm / 25.4 = 24, which keeps a grid unit the
# same physical size as on every other device. The PineTab2 pins its 10 because
# the value that device shipped was looked at on the hardware and the derivation
# disagreed; nothing comparable has been looked at here, so there is nothing to
# pin that would not be a guess dressed up as a measurement. Pin it if a Comet
# in hand says 24 is wrong.

# KEY_HOME is a gpio-keys node in imx8mp-mecha-comet.dts, alongside KEY_VOLUMEUP
# and KEY_VOLUMEDOWN. A physical home button is the uncommon case so the
# generator defaults HasHomeButton to false - this is the declaration that turns
# it on. Volume, power and brightness all default to true already and are left
# alone: the volume keys are in the device tree, and power reaches the PCA9450
# PMIC rather than a gpio-key, which is what the default assumes anyway.
deviceinfo_has_home_button="true"

# No modem. imx8mp-mecha-comet.dts has no modem, WWAN or Quectel node of any
# kind, and cellular on this device is a snap-on module rather than something on
# the board. Same declaration the Wi-Fi-only tablets make, and it keeps
# 40-ofono-binder from waiting on a modem that will never appear.
deviceinfo_modem="false"

# LuneOS adaptation for mako.

# Migrated from luna-sysmgr-conf/mako/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
#
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) does not
# land on what this device shipped, and the shipped value is the one that was
# actually looked at on the hardware. Where the two agree it is left out so the
# derivation stays in charge.
deviceinfo_display_dpi="264"
deviceinfo_grid_unit="18"

# The keys below were found on mako-halium, the Halium 16.0 GSI with the converted Android 9 vendor
# (16 Oct 2026). The Halium 9 MACHINE "mako" reports the same codename and so reads them too; they
# have not been tried there.
#
# The vendor's hwcomposer.msm8960.so is HWC 1.4. Opened in-process by the qpa plugin while the
# composer service runs as well, surface-manager crashes in hwc_prepare; through the composer
# service (HWC2) it works, as on n2awifi.
deviceinfo_force_hwc2="1"

# The container's own Wi-Fi stack (the legacy Wi-Fi HAL, wificond and its wpa_supplicant) fights
# the host's wpa_supplicant over wlan0: every association was rejected (ASSOC-REJECT
# status_code=1) until these were kept from starting.
deviceinfo_android_skip_services="vendor.wifi_hal_legacy wificond wpa_supplicant"

# rild registers IRadio@1.1 on slot1 only, and later than the generator's probe of the HAL looks
# (the modem needs rmnet_usb first: mako-rmnet-init.service). The plugin's default interface, 1.2,
# is one this rild does not have.
deviceinfo_binder_slots="slot1"
deviceinfo_binder_radio_interface="1.1"

# The camera flash (lm3559) is /sys/class/leds/spotlight, a name the torch search does not take
# for a torch or flash.
deviceinfo_torch_sysfs_path="/sys/class/leds/spotlight"

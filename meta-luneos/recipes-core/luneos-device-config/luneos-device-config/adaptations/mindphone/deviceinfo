# LuneOS adaptation for mindphone.

# Migrated from luna-sysmgr-conf/mindphone/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
deviceinfo_display_dpi="190"

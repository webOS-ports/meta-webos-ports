# LuneOS device adaptation: PinePhone (Allwinner A64).
# Read by /usr/bin/luneos-device-config (Tier 1); values not derivable from the
# hardware. Installed at /usr/share/luneos/adaptations/pinephone-1.2/deviceinfo.
#
# The directory is named for the device tree's own codename, which is the first
# entry of /proc/device-tree/compatible with the vendor prefix removed -
# "pine64,pinephone-1.2" - and not for the Yocto MACHINE (pinephone). The
# hardware revision is part of that name, so a 1.0 or 1.1 board does not match
# this directory and falls back to derivation, which is the intended behaviour:
# nothing here is revision-specific yet.

# Shown as the device name in Settings. Derivation would give the device tree's
# model, "Pine64 PinePhone (1.2)"; the board revision is not something to put in
# front of a user. See generators/90-prefs-properties.
deviceinfo_name="PinePhone"

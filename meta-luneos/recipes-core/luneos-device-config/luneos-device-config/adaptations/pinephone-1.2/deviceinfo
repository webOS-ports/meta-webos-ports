# LuneOS device adaptation: PinePhone (Allwinner A64).
# Read by /usr/bin/luneos-device-config (Tier 1); values not derivable from the
# hardware. Installed at /usr/share/luneos/adaptations/pinephone-1.2/deviceinfo.
#
# The directory is named for the device tree's own codename, which is the first
# entry of /proc/device-tree/compatible with the vendor prefix removed -
# "pine64,pinephone-1.2" - and not for the Yocto MACHINE (pinephone). The
# hardware revision is part of that name, so a 1.0 or 1.1 board does not match
# this directory and falls back to derivation, which is the intended behaviour:
# nothing here is revision-specific yet.

# Shown as the device name in Settings. Derivation would give the device tree's
# model, "Pine64 PinePhone (1.2)"; the board revision is not something to put in
# front of a user. See generators/90-prefs-properties.
deviceinfo_name="PinePhone"

# Migrated from luna-sysmgr-conf/pinephone/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
#
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) does not
# land on what this device shipped, and the shipped value is the one that was
# actually looked at on the hardware. Where the two agree it is left out so the
# derivation stays in charge.
deviceinfo_display_dpi="282"
deviceinfo_grid_unit="19"

# The same cover-glass calibration the PinePhone Pro carries, and for the same
# reason: without it every indoor reading lands in the DARK region, the backlight
# is scaled to backlightDarkScale (10%), and the screen looks like it failed to
# come on.
#
# Not measured on this device - inherited from the PinePhone Pro's measurement
# (palm 0, room 2.1-2.2, torch against the glass 67-123, giving ~50x). That is
# sound here rather than a value copied for convenience, because the two inputs
# the factor depends on are the same on both phones:
#
#   the sensor      both are an stk3310, and sensord-pinephone.conf and
#                   sensord-pinephonepro.conf declare identical [als] blocks -
#                   same intervals, same default_interval, no per-device scale -
#                   so nothing transforms the reading differently before this
#                   multiplier is applied
#   the optics      same sensor placement and the same cover glass, which is
#                   what the factor actually compensates for
#
# If a PinePhone 1.2 ever disagrees, re-measure it the way the Pro's comment
# describes and pin the result here; the two need not stay equal.
deviceinfo_als_calibration="50"

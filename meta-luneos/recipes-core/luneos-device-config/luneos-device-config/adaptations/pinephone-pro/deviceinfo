# Adaptation for the PinePhone Pro.
#
# Only what cannot be derived belongs here; everything else is worked out at
# runtime.

# How far below the real ambient level the ambient light sensor reads.
#
# The stk3310 sits under the cover glass next to the earpiece, and the glass
# attenuates it by one to two orders of magnitude. Measured on device, sensor
# lux against the light it was actually standing in:
#
#   palm held over the sensor      0        (dark)
#   normal room lighting           2.1-2.2  (~100-150 lux)
#   torch against the cover glass  67-123   (several thousand lux)
#
# ~50x, which is what turns those readings back into numbers the region borders
# in luna-displaymanager are expressed in. Without it every indoor reading fell
# in the DARK region, the backlight was scaled to backlightDarkScale (10%), and
# on this panel - max_brightness 51 - that is a backlight value of 4. The screen
# looked like it had failed to turn on.
#
# Not derivable: the sensor reports nothing about what is in front of it. Any
# device whose ALS is similarly covered wants its own measurement here.
deviceinfo_als_calibration="50"

# Shown as the device name in Settings and anywhere else luna-prefs' deviceName
# is read. Derivable in principle - /proc/device-tree/model says "Pine64
# PinePhone Pro" - but declared so the Pine devices read consistently: the
# others carry a board revision in their model string that nobody wants to see
# in the UI. See generators/90-prefs-properties.
deviceinfo_name="PinePhone Pro"

# Migrated from luna-sysmgr-conf/pinephonepro/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
#
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) does not
# land on what this device shipped, and the shipped value is the one that was
# actually looked at on the hardware. Where the two agree it is left out so the
# derivation stays in charge.
deviceinfo_display_dpi="282"
deviceinfo_grid_unit="19"

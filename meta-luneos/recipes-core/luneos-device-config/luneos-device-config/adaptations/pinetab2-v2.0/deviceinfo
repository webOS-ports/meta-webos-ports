# LuneOS device adaptation: PineTab2 (Rockchip RK3566).
# Read by /usr/bin/luneos-device-config (Tier 1); values not derivable from the
# hardware. Installed at /usr/share/luneos/adaptations/pinetab2-v2.0/deviceinfo.
#
# Named for the device tree codename ("pine64,pinetab2-v2.0"), not the Yocto
# MACHINE (pinetab2) - see the note in the PinePhone adaptation.

# Shown as the device name in Settings. Derivation would give "Pine64 PineTab2
# v2.0". See generators/90-prefs-properties.
deviceinfo_name="PineTab2"

# Migrated from luna-sysmgr-conf/pinetab2/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
#
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) does not
# land on what this device shipped, and the shipped value is the one that was
# actually looked at on the hardware. Where the two agree it is left out so the
# derivation stays in charge.
deviceinfo_display_dpi="132"
deviceinfo_grid_unit="10"
deviceinfo_has_home_button="true"
deviceinfo_show_notifications_at_top="true"
deviceinfo_tablet_ui="true"

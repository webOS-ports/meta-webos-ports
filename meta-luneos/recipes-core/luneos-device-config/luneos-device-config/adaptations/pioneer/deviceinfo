# Tier 1 adaptation for the Sony Xperia XA2 (pioneer, SDM630).
#
# luneos-device-config keys adaptations by ro.product.vendor.device. Inside the
# LuneOS container the LineageOS pioneer vendor reports "pioneer" (measured on an
# H4113, 28 Oct 2026). Under LineageOS itself the same phone reads "H4113" - its
# init rewrites the property per model at runtime, which the Halium container
# never runs - so the model number is NOT the key here.
#
# Measured on an H4113 under LuneOS (/proc/bus/input/devices, udevadm):
#
#   event0  qpnp_pon                         ID_INPUT_KEY: power, volume up
#   event1  s5712_sensor                     ID_INPUT_SWITCH
#   event2  SOMC USB Removal                 ID_INPUT_KEY: a USB-unplug event, not a key
#   event3  gpio-keys                        ID_INPUT_KEY: volume down, camera keys
#   event4  synaptics_dsx                    ID_INPUT_TOUCHSCREEN
#
# (Under LineageOS two more appear: the sdm660-snd-card-mtp Headset Jack and
# Button Jack, the latter also advertising volume keys.)

# The touchscreen is deliberately NOT pinned. synaptics_dsx sits behind the panel
# (handlers "mdss_fb kgsl") and registers only once the compositor has powered
# the panel on: at 44.1 s and at 66.0 s on two boots, both after
# luneos-device-config had finished. No node exists to pin or derive at that
# point however long it waits (a 30 s wait was tried: it only delayed the
# compositor). With no touchscreen found, the surface-manager generator gives
# the compositor a bare "evdevtouch", which discovers the touchscreen through
# udev and hot-plugs it when it appears.

# Derivation takes everything claiming KEY_POWER or a volume key that is not the
# touchscreen, which here also sweeps in "SOMC USB Removal" (event2). Pin the two
# real key devices, by name, never by node number.
deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys"

# The panel's true physical PPI: 5.2" diagonal at 1080x1920 is
# sqrt(1080^2+1920^2)/5.2 = 423.6. Not derivable - an internal DSI panel does not
# report its physical size - and Android's density bucket (420, which is what
# ro.sf.lcd_density gives) is a different number. The panel is a Truly TD4322
# command-mode DSI (mdss_dsi_td4322_truly_fhd_cmd on the cmdline).
deviceinfo_display_dpi="424"

# Carried over from sargo, whose panel is the same 1080 px wide in the same
# 420-440 density bucket: 1080/2.4 = 450 CSS px, which fixed-layout Enyo apps
# are built for. Measured on sargo, only reasoned about here - if the UI looks
# right without it, delete the line rather than keeping a number nobody checked.
deviceinfo_device_pixel_ratio="2.4"

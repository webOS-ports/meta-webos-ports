# Tier 1 adaptation for the Google Pixel 4a (sunfish).
#
# Only what cannot be derived belongs here. The codename, the vendor API level
# (this device's last OTA is Android 13, so vndk 33) and the touchscreen node
# all derive at runtime; nothing about them is pinned.
#
# UNVERIFIED: written from LineageOS's device and kernel trees, not from a
# booted Pixel 4a. Check each value against the device before trusting it -
# especially the input names, which are driver names and can differ from what
# the node ends up advertising.

# Key devices are the same trap sargo documents. Derivation takes everything
# claiming KEY_POWER or a volume key that is not the touchscreen, and on a
# Pixel that also catches the fingerprint sensor's uinput device: sunfish ships
# uinput-fpc.idc and uinput-fpc.kl, exactly as sargo does, and a uinput device
# advertises whatever keys the HAL gives it.
#
# The two real ones, from arch/arm64/boot/dts/google/sm7150-sunfish-common.dtsi
# and the pm6150 pon binding:
#
#   qpnp_pon    power key (and the volume-down side of the pon combo)
#   gpio-keys   volume up, on pm6150l_gpios 2
#
# Pinned by name, never by node number: numbering shifts with which drivers
# register on a given boot, and uinput-fpc only exists on boots where the
# fingerprint HAL registers it.
deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys"

# The panel's true physical PPI: 5.81" diagonal at 1080x2340 is
# sqrt(1080^2+2340^2)/5.81 = 443.5, and 443 is also what Google publishes.
# Not derivable - it needs the panel's physical dimensions, which an internal
# DSI panel does not report - and Android's density bucket (440) is close but
# is a different number.
deviceinfo_display_dpi="443"

# Carried over from sargo, whose panel is the same 1080 px wide in the same
# 440 density bucket. webOS apps are fixed-layout Enyo pages, so the ratio
# decides how many CSS pixels they get: 1080/2.4 = 450, which is what they are
# built for, while the "natural" density/160 of 2.75 gives 393 and they inflate
# and clip. That was measured on sargo and only reasoned about here - if the UI
# looks right without it, delete the line rather than keeping a number nobody
# checked.
deviceinfo_device_pixel_ratio="2.4"

# LuneOS device adaptation: Google Pixel Tablet (tangorpro, Tensor G2 / gs201).
# Read by /usr/bin/luneos-device-config (Tier 1); values not derivable from the
# hardware. Installed at /usr/share/luneos/adaptations/tangorpro/deviceinfo.
#
# The panel scans out portrait 1600x2560 (DRM card0-DSI-1) and the tablet is
# used landscape. Declare the compositor rotation once; the generators derive
# the evdevtouch rotation (20-surface-manager-env) and the swapped
# luna-platform DisplayWidth/Height (50-luna-platform) from it.
deviceinfo_compositor_geometry="1600x2560+0+0r270s1"

# Touch already arrives rotated through the compositor's output rotation on this
# device (hwcomposer QPA). Deriving an evdevtouch rotate=270 from the geometry as
# well turned every tap a second quarter turn (verified 17 Sep 2026), so opt out.
deviceinfo_touch_rotate="0"

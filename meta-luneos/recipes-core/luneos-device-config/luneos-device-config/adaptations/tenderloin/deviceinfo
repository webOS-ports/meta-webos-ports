# LuneOS device adaptation: HP TouchPad (tenderloin).
# Read by /usr/bin/luneos-device-config (Tier 1); values not derivable from the
# hardware. Installed at /usr/share/luneos/adaptations/tenderloin/deviceinfo.

# The TouchPad has two A6 microcontrollers on i2c-2 (0x31 and 0x32). a6-0 is the
# battery fuel-gauge/charger MCU; a6-1 is the second Touchstone coil's A6, used
# by the legacy webOS tap2shared daemon for Touch-to-Share. The kernel driver
# does not distinguish their roles, so both register as power_supply
# type=Battery and the derivation - which walks /sys/class/power_supply and has
# nothing to tell them apart - can land on a6-1. That one reports zero
# everywhere, and the cardshell battery indicator sits at 0%.
#
# This was a -DBATTERY_SYSFS_PATH in the machine's nyx-modules cmake until that
# per-machine file went away. It belongs here: it is a fact about the hardware,
# it is wanted at runtime rather than at build time, and pinning it here also
# reaches the halium build of the same tablet, which never had the define.
deviceinfo_battery_sysfs_path="/sys/class/power_supply/a6-0"

# Migrated from luna-sysmgr-conf/tenderloin,tenderloin-halium/luna-platform.conf. These are the values
# that device shipped by hand; 50-luna-platform derives everything else from
# the panel, so the machine no longer needs a luna-platform.conf of its own.
#
# deviceinfo_display_dpi is the panel's true physical PPI and is the one number
# the generator cannot work out for itself - an internal DSI panel carries no
# EDID. Without it the generator falls back to 320 and the shell is sized wrong.
#
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) does not
# land on what this device shipped, and the shipped value is the one that was
# actually looked at on the hardware. Where the two agree it is left out so the
# derivation stays in charge.
deviceinfo_display_dpi="132"
deviceinfo_grid_unit="10"
deviceinfo_has_home_button="true"
deviceinfo_show_notifications_at_top="true"
deviceinfo_tablet_ui="true"

# The GPU driver for the Halium build on the 16.0 GSI: the Adreno 220's libEGL_adreno200.so and
# libGLESv2_adreno200.so, which halium-legacy-vendor moves from the Halium 9 build's /system/lib/egl to
# /vendor/lib/egl. Without it surface-manager finds no OpenGL ES implementation and aborts (7 Oct 2026).
deviceinfo_hardware_egl="adreno200"

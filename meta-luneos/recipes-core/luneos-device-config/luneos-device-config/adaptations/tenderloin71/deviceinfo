# HP TouchPad (tenderloin71).
#
# Same panel and chassis as tenderloin - these are variants of the one device -
# so the values are deliberately identical to that adaptation rather than
# re-measured.
#
# deviceinfo_display_dpi is the one number 50-luna-platform cannot derive: it
# needs the panel's physical size and there is no EDID to read it from.
# deviceinfo_grid_unit is pinned because the derivation (dpi * 1.44 mm) gives 7
# here, not the 10 these devices shipped and were tuned against.
#
# EnableALS is not declared: the generator looks for an IIO device exposing
# illuminance and answers that itself.
deviceinfo_display_dpi="132"
deviceinfo_grid_unit="10"
deviceinfo_tablet_ui="true"
deviceinfo_show_notifications_at_top="true"
deviceinfo_has_home_button="true"

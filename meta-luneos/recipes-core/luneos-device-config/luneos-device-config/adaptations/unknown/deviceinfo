# Virtual machine / emulator.
#
# The codename resolves to "unknown" - a VM reports no Android product
# properties and its device tree carries no vendor,board compatible - so this
# adaptation is deliberately named for that fallback. It is the only name that
# can ever match a machine with nothing to identify it.
#
# Migrated from luna-sysmgr-conf/qemux86{,-64}/luna-platform.conf. Those files
# declared no DPI at all, so the generator was already falling back to 320;
# that value is stated here explicitly rather than left to a fallback, so it is
# visible and can be changed deliberately.
#
# deviceinfo_grid_unit is pinned at the shipped 10: deriving from 320 PPI would
# give 18 and resize the whole UI.
deviceinfo_display_dpi="320"
deviceinfo_grid_unit="10"
deviceinfo_tablet_ui="true"
deviceinfo_show_notifications_at_top="true"
deviceinfo_luna_type="emulator"
deviceinfo_has_volume_button="false"
deviceinfo_has_power_button="false"
deviceinfo_has_home_button="false"
deviceinfo_has_brightness_control="false"

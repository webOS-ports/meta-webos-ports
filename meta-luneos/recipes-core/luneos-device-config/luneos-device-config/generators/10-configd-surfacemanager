#!/bin/sh
# Display scaling for webApps, into the configd override layer.
#
# NOT derived from density. That was tried and is wrong for this stack: webOS
# apps are fixed-layout Enyo pages with no viewport meta, so they do not adapt
# to the device pixel ratio, they simply receive however many CSS pixels the
# scale factor leaves them. Measured over the remote inspector on sargo at
# DPR 2.4, every app reports innerWidth=450 and zoom=1, and Calendar's own
# layout is built for roughly that. Raising the ratio to the "natural"
# density/160 of 2.75 narrows the viewport to 393px and the apps inflate and
# clip off the right edge - confirmed on device.
#
# The per-device values are therefore a tuned compromise, not a derivable
# constant. Across LuneOS devices they all land in a 380-450 CSS px band:
#
#   sargo               1080 / 2.4 = 450
#   hammerhead/mido/tissot 1080 / 2.6 = 415
#   rosy, pinephone      720 / 1.9 = 379
#   sagit               1080 / 1.9 = 568   (the one real outlier)
#
# So: take the declared value when there is one, and for an unknown device fall
# back to whatever ratio puts the viewport in that band. That keeps a new phone
# usable on first boot without pretending the number is physics.
#
# The machine's own shipped value outranks that band, because it was
# arrived at the same way: by looking at the device. The 450px default derives
# 1.60 for rosy and the PinePhones against the 1.9 they ship, 2.28 for tenderloin
# against 1.0, and 4.27 for a Pi on a 1080p HDMI screen against 1.0. Those
# machines only escaped it because this generator never ran on them - it exits
# early without a panel size, and the derivation produced none until the unit was
# ordered after udev. Now that it does run, take what they ship.
#
# configd is not up yet (this service is Before=configd.service), so read the
# base layer as a file. It is the same data configd would serve; the overlay this
# generator writes sits at priority 900 and outranks it, which is exactly why not
# writing a key is the only way to let the shipped one through.
TARGET_CSS_WIDTH=${deviceinfo_target_css_width:-450}
BASE_LAYER=/etc/configd/layers/base/com.webos.surfacemanager.json

shipped_key() {
    [ -r "$BASE_LAYER" ] || return 1
    _v=$(sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
             "$BASE_LAYER" | head -n1)
    [ -n "$_v" ] || return 1
    printf '%s\n' "$_v"
}

dpr=${deviceinfo_device_pixel_ratio:-}
[ -n "$dpr" ] || dpr=$(shipped_key devicePixelRatio)
if [ -z "$dpr" ]; then
    [ -n "${panel_w:-}" ] || exit 0
    dpr=$(awk -v w="$panel_w" -v t="$TARGET_CSS_WIDTH" 'BEGIN { printf "%.2f", w / t }')
    echo "luneos-device-config: no declared devicePixelRatio, derived $dpr for a ${TARGET_CSS_WIDTH}px viewport"
fi

# Compositor geometry.
#
# surface-manager.sh asks configd for com.webos.surfacemanager.compositorGeometry
# and falls back to a hardcoded 1920x1080+0+0r0s1 - a webOS TV default - when the
# key is absent. On a phone that is both landscape and the wrong size, and it is
# what you get on any device whose configd has not accumulated the key from some
# earlier boot. Deriving it removes that dependency on stored state entirely.
#
# r0s1 is rotation 0, scale 1. A panel whose native scanout is not the way the
# device is held declares deviceinfo_compositor_geometry instead - the MP01 does,
# with r270, matching what its stock firmware states as
# ro.surface_flinger.primary_display_orientation=ORIENTATION_270 - and guessing a
# rotation from the panel aspect would be wrong for tablets.
geometry=${deviceinfo_compositor_geometry:-}
if [ -z "$geometry" ] && [ -n "${panel_w:-}" ] && [ -n "${panel_h:-}" ]; then
    geometry="${panel_w}x${panel_h}+0+0r0s1"
fi

# configd caches the merged result of all its layers in
# /var/preferences/configd_db.json and answers from that cache, so a value this
# generator changes after the first boot is served stale indefinitely - the layer
# file on disk says one thing and getConfigs returns another. It cost a long
# debugging session on the MP01: compositorGeometry was written as r270, read
# back as r0, and the compositor duly rotated nothing. Drop the cache whenever
# what we just wrote is not what the cache holds; configd rebuilds it on start.
invalidate_configd_cache_if_stale() {
    _db=/var/preferences/configd_db.json
    [ -f "$_db" ] || return 0
    grep -qF "\"compositorGeometry\": \"$1\"" "$_db" 2>/dev/null && return 0
    grep -qF "\"compositorGeometry\":\"$1\"" "$_db" 2>/dev/null && return 0
    rm -f "$_db" /var/preferences/configd_debug_db.json
    echo "luneos-device-config: dropped stale configd cache (compositorGeometry)"
}

if [ -n "$geometry" ]; then
    printf '{\n    "devicePixelRatio": "%s",\n    "compositorGeometry": "%s"\n}\n' \
        "$dpr" "$geometry" > "$GEN/configd/com.webos.surfacemanager.json"
    invalidate_configd_cache_if_stale "$geometry"
    echo "luneos-device-config: devicePixelRatio=$dpr compositorGeometry=$geometry"
else
    printf '{\n    "devicePixelRatio": "%s"\n}\n' "$dpr" > "$GEN/configd/com.webos.surfacemanager.json"
    echo "luneos-device-config: devicePixelRatio=$dpr (no panel size, geometry left to surface-manager)"
fi

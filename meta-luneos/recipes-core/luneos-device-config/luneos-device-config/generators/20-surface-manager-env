#!/bin/sh
# The compositor's input nodes.
#
# surface-manager.env is almost entirely generic - QT_IM_MODULE, EGL_PLATFORM,
# WEBOS_COMPOSITOR_PLATFORM and the highdpi flag are the same on every Halium
# device. The single device-specific part is the evdev node in
# WEBOS_COMPOSITOR_EXTRA_OPTIONS, and that is exactly derivable: precisely one
# input device advertises ID_INPUT_TOUCHSCREEN.
#
# The keyboard plugin stays as shipped: one bare "-plugin evdevkeyboard". This
# used to emit one "-plugin evdevkeyboard:<node>" per device in $keydevs, on the
# theory that Qt's discovery only matches ID_INPUT_KEYBOARD and so misses a
# keypad tagged ID_INPUT_KEY. Neither half holds. QDeviceDiscovery matches
# ID_INPUT_KEY too (qdevicediscovery_udev.cpp), so a keypad is found unaided.
# And surface-manager.sh exports QT_QPA_EVDEV_KEYBOARD_PARAMETERS=keymap=...,
# which QEvdevKeyboardManager takes *instead of* the plugin's own spec whenever
# it is non-empty - so every named node was discarded and each instance fell
# back to discovery anyway. Two instances then each attached to every key
# device and every key press arrived twice. Measured on the MP01 (two devices
# in $keydevs): two fds per event node in the compositor and every QWERTY key
# registering double; with the one bare instance, one fd each and single keys.
#
# Substitute into the shipped file rather than emitting a whole copy, so the
# generic content stays owned by luna-surfacemanager-conf and does not go stale
# here when upstream changes it.
SRC=/etc/surface-manager.d/surface-manager.env
[ -f "$SRC" ] || exit 0

# Nothing to substitute into on a device whose compositor takes no evdev plugins
# at all. The mainline eglfs_kms targets - rosy, mido, tissot, hammerhead, the
# PinePhones, pinetab2 and the qemu machines - let Qt find input itself and ship
# an env file with no -plugin line. Warning about a missing anchor on every one
# of them on every boot is noise, not a finding.
grep -q -- '-plugin ' "$SRC" || exit 0

tmp=$(mktemp)
cp "$SRC" "$tmp"
changed=0

if [ -n "${touchscreen:-}" ]; then
    if ! grep -q "evdevtouch:" "$tmp"; then
        echo "luneos-device-config: WARNING: no evdevtouch anchor in $SRC; cannot set this value"
    elif ! grep -q "evdevtouch:$touchscreen\b" "$tmp"; then
        # [^ "]* rather than event[0-9]*: the shipped value is a placeholder,
        # not a node number, so the anchor must not assume the shape of what it
        # replaces.
        sed -i "s|evdevtouch:[^ \"]*|evdevtouch:$touchscreen|" "$tmp"
        changed=1
        echo "luneos-device-config: compositor touchscreen -> $touchscreen"
    fi
fi

# Rotate touch to match a panel that is mounted rotated.
#
# deviceinfo_compositor_geometry carries the rotation the compositor applies to
# its output (the "r" field - see 10-configd-surfacemanager). evdevtouch reports
# in the panel's own orientation and knows nothing about that, so without the
# same rotation here every tap lands a quarter turn from what is drawn. Derive it
# from the one declaration rather than asking boards to state it twice.
#
# Not to be confused with the gesture positions fixed in luna-next-cardshell's
# OrientationHelper: this corrects what Qt delivers to items, that corrects what
# GestureHandler reads straight off QScreen.
#
# Not universal, though. Whether evdevtouch needs the rotation depends on how the
# touch controller reports relative to the panel and on the QPA: on the MP01 it
# does, on the Pixel Tablet (tangorpro, hwcomposer QPA, r270) the compositor's
# output rotation already carries touch through the rotated item tree, and
# rotating evdevtouch as well turned every tap a second quarter turn. So the
# geometry only provides the default; an adaptation that knows better declares
# deviceinfo_touch_rotate (0 = leave evdevtouch alone, or 90/180/270).
case "${deviceinfo_compositor_geometry:-}" in
    *r90s*)  touch_rotate=90 ;;
    *r180s*) touch_rotate=180 ;;
    *r270s*) touch_rotate=270 ;;
    *)       touch_rotate= ;;
esac
if [ -n "${deviceinfo_touch_rotate:-}" ]; then
    touch_rotate=$deviceinfo_touch_rotate
    [ "$touch_rotate" = "0" ] && touch_rotate=
fi
if [ -n "$touch_rotate" ] && grep -q "evdevtouch:" "$tmp" && ! grep -q "rotate=" "$tmp"; then
    sed -i "s|\(evdevtouch:[^ \"]*\)|\1:rotate=$touch_rotate|" "$tmp"
    changed=1
    echo "luneos-device-config: compositor touch rotation -> $touch_rotate"
fi

# Do not open the hwcomposer HAL a second time in the compositor process.
#
# qt6-qpa-hwcomposer-plugin normally calls hw_get_module()/open() to discover the
# HWC version before handing the work to libhwc2_compat_layer, which reaches the
# HAL over HIDL. On MediaTek that second open constructs an HWCMediator which
# immediately tries to take DRM master, and the Android composer service already
# holds it - neither yields, and the compositor spends its whole start timeout
# logging "[DRMDEV] failed to get drm master". The plugin has an escape hatch for
# exactly this case and its comment names it: "on some devices loading hwc2
# module twice breaks graphics (The first load is in the composer android
# service.)".
#
# Opt-in, because on adaptations where the extra open is harmless the plugin's
# version probe is worth keeping.
if [ "${deviceinfo_force_hwc2:-0}" = "1" ] && ! grep -q "QT_QPA_FORCE_HWC2" "$tmp"; then
    echo 'QT_QPA_FORCE_HWC2=1' >> "$tmp"
    changed=1
    echo "luneos-device-config: compositor QT_QPA_FORCE_HWC2=1"
fi

# Which GLES driver Android's EGL loader should use.
#
# Loader.cpp tries persist.graphics.egl, then ro.hardware.egl, then
# ro.board.platform, and for each name looks for libGLES_<name>.so (or the
# split libEGL_/libGLESv1_CM_/libGLESv2_ trio) under /vendor/lib64/egl. If none
# resolves it aborts the process outright:
#
#   couldn't find an OpenGL ES implementation, make sure one of
#   persist.graphics.egl, ro.hardware.egl and ro.board.platform is set
#
# Several MediaTek vendor images set only ro.board.platform - the FLX1s reports
# mt6877 - while shipping no libGLES_mt6877.so, just libGLES_mali.so and Mali's
# libGLES_meow.so wrapper. surface-manager then SIGABRTs on every start, which
# systemd retries into the hundreds. The MP01 needs the same value, and
# libhybris here already carries a patch written for that blob
# (0007-hooks-hook-MEOW_get_tls_meow_offset-for-Mali-blobs).
#
# Exported as an environment variable rather than set here: this generator runs
# before the Android container's property service exists, so the setprop has to
# happen later. surface-manager-daemon.service reads this file as its
# EnvironmentFile and does it in an ExecStartPre.
if [ -n "${deviceinfo_hardware_egl:-}" ] && ! grep -q "LUNEOS_ANDROID_EGL" "$tmp"; then
    echo "LUNEOS_ANDROID_EGL=${deviceinfo_hardware_egl}" >> "$tmp"
    changed=1
    echo "luneos-device-config: compositor ro.hardware.egl=${deviceinfo_hardware_egl}"
fi

if [ "$changed" = "1" ]; then
    mkdir -p "$GEN/files/etc/surface-manager.d"
    cp "$tmp" "$GEN/files/etc/surface-manager.d/surface-manager.env"
fi
rm -f "$tmp"

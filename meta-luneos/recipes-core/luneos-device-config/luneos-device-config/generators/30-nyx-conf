#!/bin/sh
# nyx's device paths.
#
# nyx used to take these as compile-time -D defines from a per-machine cmake
# include, which is why nyx-modules is PACKAGE_ARCH = MACHINE_ARCH and why
# there are 57 machine cmake files. It now reads them from /etc/nyx.conf, and
# this generator writes that file.
#
# One generator owns the whole file rather than one per value: they all write
# the same target, and the last one to run would otherwise clobber the rest.
#
# A value we do not have is left exactly as shipped, which for everything but
# the key list means empty - and empty tells nyx to fall through to its own
# detection. Guessing would be worse than that fallback.

SRC=/etc/nyx.conf
[ -f "$SRC" ] || SRC=/etc/nyx/nyx.conf
[ -f "$SRC" ] || exit 0

target=${SRC#/}
out=$GEN/files/$target
mkdir -p "$(dirname "$out")"
cp "$SRC" "$out" || exit 0

changed=0

# set_value <group> <key> <value>
#
# Rewrites key= inside [group] only, so the same key name can appear under more
# than one module. Does nothing when the value is empty, or when the key is not
# already present: the shipped file declares every key this generator knows
# about, so a missing one means the config and this script have drifted, and
# inventing the line would hide that.
set_value() {
    _group=$1 _key=$2 _val=$3
    [ -n "$_val" ] || return 0

    if ! awk -v g="[$_group]" -v k="$_key" '
            /^\[/ { ing = ($0 == g); next }
            ing && index($0, k "=") == 1 { found = 1 }
            END { exit !found }' "$out"; then
        echo "luneos-device-config: WARNING: no $_key= under [$_group] in $SRC"
        return 0
    fi

    awk -v g="[$_group]" -v k="$_key" -v v="$_val" '
        /^\[/ { ing = ($0 == g); print; next }
        ing && index($0, k "=") == 1 { print k "=" v; next }
        { print }' "$out" > "$out.new" && mv "$out.new" "$out"

    echo "luneos-device-config: nyx [$_group] $_key -> $_val"
    changed=1
}

# Derived by the caller - but not every shipped value is a guess, and the two
# kinds have to be told apart.
#
# Measured on the devices we have attached:
#
#   tissot  ships event0 = qpnp_pon, the power key, and nothing else. The volume
#           rocker is event4 (gpio-keys) and never reaches nyx. Derivation finds
#           both, so it is a real improvement and must not be suppressed.
#   rosy    ships event0 = gpio-keys and misses the PMIC power key entirely.
#   pinephone, pinephonepro, pinetab2 and tenderloin-halium ship
#           /dev/input/by-path/... links instead. Those survive a change in
#           enumeration order, which is the whole argument this file's header
#           makes, and derivation would replace them with the numeric nodes the
#           header condemns - and widen them, because derivation only narrows to
#           a superset of everything claiming a key that is not the touchscreen.
#
# So: a value that pins by a stable path is a declaration and is kept; a bare
# /dev/input/eventN is the guess derivation exists to replace. Tier 1 outranks
# both - that is how sargo excludes its fingerprint sensor, and how rosy gets its
# power key by name.
shipped_value_of() {
    awk -v g="[$1]" -v k="$2" '
        /^\[/ { ing = ($0 == g); next }
        ing && index($0, k "=") == 1 { sub(/^[^=]*=/, ""); print; exit }' "$SRC"
}

# True when the value is nothing but bare event nodes, i.e. a node-number guess.
# Strip every /dev/input/eventN out and see whether anything is left; a by-path
# link, or anything else we have not thought of, leaves a remainder and is
# therefore treated as deliberate.
looks_like_node_guess() {
    [ -z "$(printf '%s' "$1" | sed 's#/dev/input/event[0-9][0-9]*;*##g')" ]
}

# set_derived <group> <key> <derived value> <tier 1 value, if any>
set_derived() {
    _shipped=$(shipped_value_of "$1" "$2")
    if [ -n "$4" ] || [ -z "$_shipped" ] || looks_like_node_guess "$_shipped"; then
        set_value "$1" "$2" "$3"
    else
        echo "luneos-device-config: nyx [$1] $2 kept as shipped ($_shipped)"
    fi
}

set_derived module.keys       paths "${keydevs:-}" \
            "${deviceinfo_key_devices_by_name:-}${deviceinfo_key_devices:-}"
set_derived module.touchpanel path  "${touchscreen:-}" \
            "${deviceinfo_touchscreen_by_name:-}${deviceinfo_touchscreen_device:-}"

# The power supplies, derived together because telling them apart takes the
# same information.
#
# Not every battery the kernel lists belongs to the device. A PinePhone (Pro)
# docked in its keyboard has two supplies of type "Battery": its own and the
# keyboard's, which charges the phone over USB. nyx used to take whichever the
# directory walk returned first, so which cell the shell displayed came down to
# filesystem order.
#
# This is a table, not a heuristic. A battery is an accessory's because we know
# the driver behind it; anything unrecognised is left alone for the tier 1 pin
# to settle, because there is no property of a power_supply that says "this one
# powers the device" and guessing would be worse than nyx's own fallback.
accessory_battery_role() {
    case "${1##*/}" in
        ip5xxx-battery) echo keyboard ;;   # PinePhone (Pro) keyboard, IP5209
        *)              echo "" ;;
    esac
}

# The sysfs device a power_supply hangs off. Supplies belonging to one piece of
# hardware share it, which is how the keyboard's boost converter is recognised
# as part of the keyboard rather than as this device's charger.
supply_device() {
    _real=$(readlink -f "$1" 2>/dev/null) || return 1
    case "$_real" in
        */power_supply/*) echo "${_real%/power_supply/*}" ;;
        *)                return 1 ;;
    esac
}

mainbat=
extrabats=
accessory_devices=
ambiguous=0

for _d in /sys/class/power_supply/*; do
    [ -r "$_d/type" ] || continue
    [ "$(cat "$_d/type" 2>/dev/null)" = "Battery" ] || continue

    _role=$(accessory_battery_role "$_d")

    if [ -n "$_role" ]; then
        extrabats="${extrabats}${_role}:${_d};"
        if _dev=$(supply_device "$_d"); then
            accessory_devices="${accessory_devices}${_dev} "
        fi
    elif [ -z "$mainbat" ]; then
        mainbat=$_d
    else
        # Two batteries that both look like the device's own. Nothing here can
        # say which one powers it, so say nothing.
        ambiguous=1
    fi
done

if [ "$ambiguous" = 1 ]; then
    echo "luneos-device-config: WARNING: more than one battery that is not a known accessory;" \
         "set deviceinfo_battery_sysfs_path to pin the primary"
    mainbat=
fi

# The USB charger supply. nyx's own fallback walks /sys/class/power_supply for
# type == "USB" exactly, and on a modern Qualcomm charger that finds pc_port -
# a secondary input that never reports online - while the supply that actually
# charges is the one named "usb", whose type is dynamic (USB, USB_PD, USB_DCP,
# ... after whatever was negotiated). Measured on sargo: batteryd broadcast
# USBConnected:false while the battery charged at 2.4A, so DisplayManager
# thought it was on battery and turned the lock screen off after five seconds
# on the cable. Prefer the conventional "usb" node, otherwise anything whose
# type starts with USB; empty still falls through to nyx's own walk.
#
# An accessory's supplies are skipped. The keyboard's boost converter is a type
# USB supply as well, and it is the phone's own charger input that says whether
# the phone is charging - "the keyboard is producing 5V" is not the same fact.
#
# A supply must also expose "online" to be worth naming. nyx decides that a
# charger is attached by reading <usb_sysfs_path>/online and nothing else, so a
# node without it reports "no charger" whatever is plugged in - a worse answer
# than nyx's own walk, because it is a confident one. The PinePhone Pro is the
# board that shows it: the phone's charger input, rk818-usb, has present,
# health and input_current_limit but no online at all, while the fusb302 TCPM's
# tcpm-source-psy-4-0022 carries online, usb_type and current_max - exactly the
# three attributes the charger module reads. Sorting reached rk818-usb first
# and the cable was never detected. Requiring online only ever skips a node
# that could not have worked.
usb_supply_is_usable() {
    [ -r "$1/online" ]
}

usbpsy=
if [ -r /sys/class/power_supply/usb/type ] &&
   usb_supply_is_usable /sys/class/power_supply/usb; then
    usbpsy=/sys/class/power_supply/usb
else
    for _d in /sys/class/power_supply/*; do
        if [ -n "$accessory_devices" ] && _dev=$(supply_device "$_d"); then
            case " $accessory_devices " in
                *" $_dev "*) continue ;;
            esac
        fi
        case "$(cat "$_d/type" 2>/dev/null)" in
            USB*) usb_supply_is_usable "$_d" || continue
                  usbpsy=$_d; break ;;
        esac
    done
fi

# The second half of the charger input, on Qualcomm smb2/smb5 parts.
#
# "usb" and "pc_port" are not two chargers, they are one signal split in two by
# the driver, and the two getters are exact mirror images of each other. Both
# start from smblib_get_prop_usb_online(); then, for a plain SDP source
# (typec_mode SOURCE_DEFAULT or a micro-USB connector, with real_charger_type
# USB), qpnp-smb5.c's "usb" getter forces online to 0 while its "pc_port"
# getter forces it to 1, and for anything else - DCP, CDP, PD - the reverse.
# Measured on sargo attached to a PC: usb/online 0, pc_port/online 1,
# typec_mode "Source attached (default current)".
#
# So neither node alone can answer "is a charger attached". The kernel does not
# try: qpnp-fg-gen3.c computes online = usb || pc_port || dc. nyx has the same
# OR - is_charging = usb_online || ac_online || touch_online || wireless_online
# in charger.c - so wiring both slots gives the right answer for both source
# types, with no dependence on which one happened to be live at module init.
#
# The earlier revision of this file pinned "usb" alone and said pc_port "never
# reports online". That was measured on a wall charger, where it is true; on a
# PC it is exactly backwards, and the result was chargerStatusQuery answering
# Charging:false with the cable in and the battery taking current.
#
# The slot each node goes in is not arbitrary. pc_port is the SDP half, so it
# is the one that means "plugged into a computer" and belongs in usb_sysfs_path:
# that way chargerStatusQuery reports USBConnected true and USBName "pc" on a
# PC, and "wall" on a charger. Verified both ways round on sargo - swapping
# them keeps Charging correct but inverts USBConnected and USBName.
sdppsy=
if [ -n "$usbpsy" ] && [ "$usbpsy" != /sys/class/power_supply/pc_port ] \
   && [ -r /sys/class/power_supply/pc_port/online ]; then
    sdppsy=/sys/class/power_supply/pc_port
fi

# With both halves present the SDP node takes the USB slot and the negotiated
# one takes the AC slot; with only one, it stays where it was. An "ac" default
# of empty leaves nyx to walk for type Mains, which on these boards finds "bms"
# or "main" - supplies with no online attribute at all, so nothing is lost.
if [ -n "$sdppsy" ]; then
    acpsy=$usbpsy
    usbpsy=$sdppsy
else
    acpsy=
fi

# The tier 1 pins win throughout: they exist for the boards where the
# convention, or the table above, is wrong.
set_value module.battery sysfs_path        "${deviceinfo_battery_sysfs_path:-$mainbat}"
set_value module.battery extra_sysfs_paths "${deviceinfo_battery_extra_sysfs_paths:-$extrabats}"
set_value module.charger usb_sysfs_path    "${deviceinfo_charger_usb_sysfs_path:-$usbpsy}"
set_value module.charger ac_sysfs_path     "${deviceinfo_charger_ac_sysfs_path:-$acpsy}"

# Nothing to say: drop the file so the caller does not bind a copy of the
# original over the original.
if [ "$changed" = 0 ] || cmp -s "$SRC" "$out"; then
    rm -f "$out"
fi

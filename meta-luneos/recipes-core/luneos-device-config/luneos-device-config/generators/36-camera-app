#!/bin/sh
# Tell the Camera app how a device's cameras are mounted, where its camera HAL
# reports it wrongly.
#
# The app takes the mounting from the device tree on a mainline device and
# from the Android HAL through gst-droid on a Halium one. Where the HAL's
# answer does not match the hardware (the Titan Pocket's back camera, 180 deg
# out), the adaptation says so:
#
#   deviceinfo_camera_back_rotation="180"
#   deviceinfo_camera_front_rotation="0"
#
# in degrees, on the scale of the app's backSensorRotation and
# frontSensorRotation (see qml/PreferencesModel.qml). The app ships
# qml/DeviceCamera.js with no overrides (-1); this shadows it with the values
# given. An app too old to have the file is left alone.
DST=/usr/palm/applications/org.webosports.app.camera/qml/DeviceCamera.js
[ -f "$DST" ] || exit 0

valid() {
    case "$1" in
        0|90|180|270) echo "$1" ;;
        "") echo -1 ;;
        *) echo "luneos-device-config: ignoring camera rotation '$1', not 0/90/180/270" >&2
           echo -1 ;;
    esac
}
back=$(valid "${deviceinfo_camera_back_rotation:-}")
front=$(valid "${deviceinfo_camera_front_rotation:-}")
[ "$back" = -1 ] && [ "$front" = -1 ] && exit 0

out=$GEN/files$DST
mkdir -p "$(dirname "$out")"
cat > "$out" <<EOT
.pragma library

// Written by luneos-device-config (generators/36-camera-app) from this
// device's adaptation.
var backRotation = $back;
var frontRotation = $front;
EOT
echo "luneos-device-config: camera mounting back=$back front=$front"

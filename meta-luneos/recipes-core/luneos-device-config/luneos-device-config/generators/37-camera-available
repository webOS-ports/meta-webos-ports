#!/bin/sh
# Whether the device has a camera to use, for configd and the camera stack.
#
# A camera that enumerates is not necessarily one that can be used. The
# GreenTouch MindPhone's HAL lists MediaTek's reference-design sensors, but
# nothing has ever delivered a frame from them and its case covers the camera
# anyway, so Settings offered Geotag Photos on a device that will never take a
# photo.
#
# Not derived: nothing a script can see answers it. V4L2 nodes are no guide -
# on the Zinwa Q25 all of /dev/video* are the JPEG and video codecs, and the
# cameras sit behind the HAL - and the HAL's binary is named by the vendor
# (camerahalserver on MediaTek). So only an adaptation that says so is heard:
#
#   deviceinfo_has_camera="false"
#
# published as luneos.device.camera.available. Without the key nothing is
# written, and a consumer gets it back under missingConfigs and assumes a
# camera, as it did before this existed.
#
# "false" also turns the camera stack off, through $RUN/no-camera:
#
#   droidcam2v4l2.service         skipped, by ConditionPathExists
#   waydroid-luneos-prepare       masks Waydroid's camera provider
#
# and start-android-hals.sh, which runs before this does, reads the deviceinfo
# key itself to keep the container's camera services down. The torch is not
# part of it: torchd opens the flash driver directly and needs none of these.
case "${deviceinfo_has_camera:-}" in
    false) : > "$RUN/no-camera" ;;
    *) rm -f "$RUN/no-camera" ;;
esac

case "${deviceinfo_has_camera:-}" in
    true|false) ;;
    "") exit 0 ;;
    *) echo "luneos-device-config: ignoring deviceinfo_has_camera '$deviceinfo_has_camera', not true/false" >&2
       exit 0 ;;
esac

cat > "$GEN/configd/luneos.device.camera.json" <<EOT
{
    "available": $deviceinfo_has_camera
}
EOT
echo "luneos-device-config: camera available -> $deviceinfo_has_camera"

#!/bin/sh
# ofono's RIL topology, from what the vendor's RIL actually advertises.
#
# ofono-binder-plugin enumerates slots from the HAL, not from binder.conf, so a
# slot present on the device but missing from the file is not "single SIM" - it
# is a missing entry, and ofonod aborts at startup with "Missing path for slot
# slotN" and is restarted forever. sargo hit exactly this: its vendor RIL is a
# multi-SIM build, init starts qcrild and qcrild2, and both register, so the HAL
# advertises IRadio/slot1 and /slot2 while binder.conf declared only slot1.
#
# Deriving it from the HAL cannot disagree with the HAL, which is the point.
#
# The IRadio version is derived from the same listing, with a cap. A vendor
# registers every version it implements - the MT6739 offers 1.0 through 1.5 for
# each slot - and the plugin's own default of 1.2 is usually too low: below 1.4
# it sends the 1.0 getSignalStrength, which that modem answers
# "getSignalStrengthResponse_1_2 INVALID_RESPONSE" on an endless retry, so
# NetworkRegistration never gains a Strength property and the UI has no bars.
#
# Taking the highest is wrong too. 1.5 is where the plugin starts using
# setRadioPower_1_5 and setIndicationFilter_1_5, and a vendor that registers
# 1.5 without implementing those leaves the radio unpowered: measured on the
# MT6739, 1.5 produces no registration at all, while 1.4 reports strength
# immediately. 1.4 is also the last version whose requests the plugin picks up
# for the everyday paths, so cap there and let deviceinfo override it for a
# device that wants otherwise.

# deviceinfo_binder_slots lets a device state its slots outright, the same way
# it can already state the IRadio version and the signal strength range. That
# is not only a shortcut: lshal is not dependable everywhere. On sargo it dies
# in getDeviceHalManifest with "VINTF parse error: Not a valid XML:
# /apex/apex-info-list.xml", so the poll below sees nothing, this generator
# bails, and the shipped single-slot binder.conf stays - which leaves
# ofono-binder-plugin logging "Missing path for slot slot2" for a slot the HAL
# really does have. A device that knows its own topology should not have to ask.
slots=${deviceinfo_binder_slots:-}

LSHAL=
if [ -z "$slots" ]; then
    for c in lshal /android/system/bin/lshal /system/bin/lshal; do
        command -v "$c" >/dev/null 2>&1 && { LSHAL=$c; break; }
    done
    [ -n "$LSHAL" ] || exit 0
fi

# The RIL registers asynchronously once init's gates are open, so poll rather
# than sample once. Getting this wrong is not harmless: with no slots we write
# nothing, ofono falls back to the shipped generic ril_subscription.conf which
# still uses socket=/dev/socket/rild, and on a binder device that means an
# abort-restart loop.
i=0
while [ -z "$slots" ] && [ $i -lt 30 ]; do
    slots=$($LSHAL 2>/dev/null |
            grep -oE 'android\.hardware\.radio@[0-9.]+::IRadio/slot[0-9]+' |
            sed 's|.*/||' | sort -u)
    [ -n "$slots" ] && break
    i=$((i + 1))
    sleep 0.5
done
if [ -z "$slots" ]; then
    echo "luneos-device-config: WARNING: no IRadio slots after 15s; leaving the shipped ofono config in place"
    exit 0
fi

radio_interface=${deviceinfo_binder_radio_interface:-}
if [ -z "$radio_interface" ] && [ -n "$LSHAL" ]; then
    highest=$($LSHAL 2>/dev/null |
              grep -oE 'android\.hardware\.radio@[0-9]+\.[0-9]+::IRadio/slot[0-9]+' |
              sed -E 's|.*@([0-9]+\.[0-9]+)::.*|\1|' |
              sort -t. -k1,1n -k2,2n | tail -n 1)
    case "$highest" in
        1.4|1.5) radio_interface=1.4 ;;
        1.[0-3]) radio_interface=$highest ;;
        *) radio_interface= ;;
    esac
    [ -n "$radio_interface" ] &&
        echo "luneos-device-config: IRadio $highest advertised, using $radio_interface"
fi

# The dBm window the plugin maps onto the 0-100 percentage ofono publishes,
# which LuneOS turns into bars as (percent * 5) / 100.
#
# The plugin's own default is -100,-60. That is a sensible window for GSM,
# where the reading is RSSI, but the plugin prefers RSRP whenever the modem
# reports one, and on LTE RSRP sits some 20-25 dB lower for the same radio
# conditions - it is power per resource element, not over the whole carrier.
# With the default window anything weaker than -92 dBm RSRP came out under
# 20%, which is 0 bars: a phone registered on LTE at -96 dBm, where Android
# draws two bars, showed no signal at all.
#
# -125,-85 keeps a usable GSM curve while putting the LTE range where the
# readings actually fall. deviceinfo_binder_signal_strength_range overrides it
# for a device whose modem reports something else.
signal_strength_range=${deviceinfo_binder_signal_strength_range:--125,-85}

mkdir -p "$GEN/files/etc/ofono"

# ExpectSlots names only the first: boot should not wait on slots that are
# empty unless a SIM or eUICC profile is present.
{
    echo "# Generated by luneos-device-config from the RIL HAL's advertised slots."
    echo "[Settings]"
    echo "ExpectSlots = slot1"
    for s in $slots; do
        n=${s#slot}
        echo
        echo "[$s]"
        echo "path = /ril_$((n - 1))"
        echo "slot = $((n - 1))"
        [ -n "$radio_interface" ] && echo "radioInterface = $radio_interface"
        echo "signalStrengthRange = $signal_strength_range"
    done
} > "$GEN/files/etc/ofono/binder.conf"

{
    echo "# Generated by luneos-device-config from the RIL HAL's advertised slots."
    echo "[Settings]"
    echo "allowDataReq=on"
    for s in $slots; do
        n=${s#slot}
        echo
        echo "[ril_$((n - 1))]"
        echo "transport=binder:name=$s"
        echo "name=$s"
    done
} > "$GEN/files/etc/ofono/ril_subscription.conf"

echo "luneos-device-config: ofono slots derived: $(echo $slots | tr '\n' ' ')"

#!/bin/sh
# Display geometry for luna-sysmgr.
#
# DisplayWidth/DisplayHeight come straight from the connected DRM connector, and
# DPI from the panel's own density, so none of the three needs per-device data.
#
# GridUnit is the interesting one. It is the base layout unit, and across
# LuneOS devices it works out to a roughly constant *physical* size rather than
# a fixed pixel count:
#
#   sargo      DPI 441  GU 25  -> 1.44 mm      mido/tissot DPI 480 GU 26 -> 1.38 mm
#   hammerhead DPI 445  GU 26  -> 1.48 mm      rosy/pinephone DPI 282 GU 19 -> 1.71 mm
#   sagit      DPI 428  GU 19  -> 1.13 mm      (an outlier, as it is for devicePixelRatio)
#
# Deriving it as a constant 1.44 mm keeps touch targets the same physical size
# on any panel, and reproduces sargo's shipped 25 exactly. It is within one or
# two units on the others and well out on sagit, so the shipped values are not
# perfectly consistent - a device that cares pins deviceinfo_grid_unit.
SRC=/etc/palm/luna-platform.conf
[ -f "$SRC" ] || exit 0

GRID_UNIT_MM=${deviceinfo_grid_unit_mm:-1.44}

# DPI here is the panel's true physical PPI, which is NOT derivable: it needs
# the panel's physical dimensions, and an internal DSI panel exposes no EDID.
#
# This file used to say "never read back out of $SRC", and that rule came from a
# real bug - but it was drawn too wide. The bug was that the *generic* placeholder
# shipped an invented DPI and taking it as a fallback made that number the
# effective DPI of every device without an adaptation. The per-machine files are
# not placeholders: raspberrypi3 ships 133/8, tenderloin 132/10, rosy and the
# PinePhones 282/19, hammerhead 445/26, mido and tissot 480/26. Those are
# measured, hand-tuned numbers, and refusing to look at them meant writing
# LAST_RESORT_DPI over every one of them - 320/18 on the whole non-Halium fleet,
# which is a much larger error than the one the rule was written to prevent.
#
# So distinguish the two cases the way the shipped files already do. The generic
# machine ships DPI=0 GridUnit=0 (luna-sysmgr-conf/halium), which is the "we do
# not know" marker; any non-zero value is a measurement. The universal image is
# the generic machine, so it still derives everything; a machine we have actually
# ported keeps what was measured on it.
#
# DPI, in order of trust:
#
#   1. deviceinfo - the panel's true physical PPI, declared by a Tier 1
#      adaptation.
#   2. the value this machine ships, when it is not the 0 placeholder.
#   3. ro.sf.lcd_density - Android's density *bucket*. Close but not the same
#      thing (440 on sargo where the panel is 441), so it loses to a measurement
#      and beats nothing at all.
#   4. a last resort in code, so an unknown device still boots to a usable UI
#      rather than a zero-sized one. Deliberately here and not in the config
#      file: a fallback belongs where it can be seen to be a fallback.
LAST_RESORT_DPI=320

# A value the machine ships, or nothing if it ships the placeholder.
shipped_value() {
    _v=$(sed -n "s/^$1=\\(.*\\)$/\\1/p" "$SRC" | head -n1)
    case "$_v" in ''|0) return 1 ;; esac
    printf '%s\n' "$_v"
}

dpi=${deviceinfo_display_dpi:-}
[ -n "$dpi" ] || dpi=$(shipped_value DPI)
[ -n "$dpi" ] || dpi=$density
if [ -z "$dpi" ]; then
    dpi=$LAST_RESORT_DPI
    echo "luneos-device-config: WARNING: no DPI from deviceinfo, $SRC or the" \
         "vendor; falling back to $dpi"
fi

# GridUnit follows the same order with one exception, and the exception is the
# whole point: an adaptation that declares deviceinfo_display_dpi is declaring
# the number GridUnit is computed from, so there the derivation must run.
#
# The mindphone is the case that proves it. Its panel is 480x800 at a real
# ~233 PPI, and deriving from that gives GridUnit 13-14, which makes the shell
# chrome - the system menu is Units.gu(40) - wider than the screen and it
# overflows both edges. Its adaptation therefore declares dpi=190, picked so the
# formula lands on 11. Letting the shipped GridUnit=19 outrank that derivation
# gave a UI 1.7x too big on every surface, with gu(40) at 760px on a 480px
# panel. The DPI is the tuning knob; overriding what it tunes defeats it.
#
# Where no adaptation names a DPI there is nothing being tuned, so the shipped
# value stands - which is what keeps tissot at the 26 it ships rather than the
# 27 its density bucket derives, and rosy at 19 rather than 16.
grid=${deviceinfo_grid_unit:-}
if [ -z "$grid" ] && [ -z "${deviceinfo_display_dpi:-}" ]; then
    grid=$(shipped_value GridUnit)
fi
if [ -z "$grid" ]; then
    grid=$(awk -v d="$dpi" -v mm="$GRID_UNIT_MM" 'BEGIN { printf "%d", (d * mm / 25.4) + 0.5 }')
fi

# The panel's shape: the rectangles the UI has to keep clear of, and the corner
# radii. Neither is derivable - no sysfs node, no EDID and no Android property
# reports a notch - so these are written only when an adaptation declares them,
# leaving the shipped empty values (an ordinary rectangular panel) otherwise.
#
# Rects are "x y w h" in the panel's own scanout pixels, ';' separated, and the
# radii are one value or "tl;tr;br;bl". Rectangles rather than the SVG paths
# gmobile and Android use, because the only thing that consumes them is a layout
# that needs to know how much room it lost; a path would only buy a prettier
# corner mask, which nothing draws yet.
#
# Where to get the numbers, in order of trust:
#
#   1. The vendor's own gmobile display-panel JSON, where one exists. radon is
#      the easy case: FuriLabs ship furilabs,flx1s.json themselves, and its
#      notch path is already an axis-aligned rectangle.
#   2. The LineageOS device tree's config_mainBuiltInDisplayCutout. Mind the
#      origin - Android's is CENTRE-top, so x_here = x_android + panel_w / 2.
#   3. Measured on the hardware.
#
# Rotation. A rect is only meaningful together with the orientation it was
# measured in, and 10-configd-surfacemanager may tell the compositor to rotate
# its output (the MP01 is r270). The shell lays out in the rotated space, so a
# rect declared in scanout space has to be turned to match here - doing it in the
# shell instead would mean every QML consumer had to know about outputRotation.
# This is the same correction the panel_w/panel_h swap below makes, for the same
# reason, so the two are kept together.
rotate_rects() {
    # $1 = ';' separated "x y w h" list, $2 = rotation, $3/$4 = scanout w/h
    awk -v list="$1" -v rot="$2" -v pw="$3" -v ph="$4" 'BEGIN {
        n = split(list, rects, ";")
        out = ""
        for (i = 1; i <= n; i++) {
            if (rects[i] == "") continue
            split(rects[i], f, " ")
            if (length(f) != 4) continue
            x = f[1]; y = f[2]; w = f[3]; h = f[4]
            # Clockwise output rotation by rot takes scanout (x,y) to the
            # rotated frame; w/h swap on the quarter turns.
            if (rot == 90)       { nx = ph - y - h; ny = x;            nw = h; nh = w }
            else if (rot == 180) { nx = pw - x - w; ny = ph - y - h;   nw = w; nh = h }
            else if (rot == 270) { nx = y;          ny = pw - x - w;   nw = h; nh = w }
            else                 { nx = x;          ny = y;            nw = w; nh = h }
            out = out (out == "" ? "" : ";") nx " " ny " " nw " " nh
        }
        print out
    }'
}

# The four radii follow the same turn: tl;tr;br;bl is a cycle, so a clockwise
# quarter turn of the frame shifts every corner one place along it.
rotate_radii() {
    awk -v list="$1" -v rot="$2" 'BEGIN {
        n = split(list, r, ";")
        if (n == 1) { r[2] = r[1]; r[3] = r[1]; r[4] = r[1]; n = 4 }
        if (n != 4) { print list; exit }
        shift = 0
        if (rot == 90) shift = 1; else if (rot == 180) shift = 2; else if (rot == 270) shift = 3
        for (i = 0; i < 4; i++) {
            # corner i of the rotated frame was corner (i - shift) of the panel
            j = ((i - shift) % 4 + 4) % 4 + 1
            printf "%s%s", (i ? ";" : ""), r[j]
        }
        printf "\n"
    }'
}

cutouts=${deviceinfo_display_cutouts:-}
corner_radii=${deviceinfo_display_corner_radii:-}

# The rotation the compositor applies, parsed out of WxH+X+Y r<rot> s<scale>.
out_rot=0
case "${deviceinfo_compositor_geometry:-}" in
    *r90s*)  out_rot=90 ;;
    *r180s*) out_rot=180 ;;
    *r270s*) out_rot=270 ;;
esac

if [ -n "$cutouts" ] && [ "$out_rot" != "0" ]; then
    if [ -n "${panel_w:-}" ] && [ -n "${panel_h:-}" ]; then
        cutouts=$(rotate_rects "$cutouts" "$out_rot" "$panel_w" "$panel_h")
        echo "luneos-device-config: rotated cutouts by r$out_rot -> $cutouts"
    else
        echo "luneos-device-config: WARNING: cutouts declared and output is r$out_rot," \
             "but no panel size to rotate them about; leaving them as declared"
    fi
fi
[ -n "$corner_radii" ] && [ "$out_rot" != "0" ] && \
    corner_radii=$(rotate_radii "$corner_radii" "$out_rot")

# A panel mounted a quarter turn off scans out landscape while the device is held
# portrait, and the compositor rotates its output to match (the "r" field of
# deviceinfo_compositor_geometry - see 10-configd-surfacemanager). panel_w and
# panel_h come straight from the DRM connector and know nothing about that, so
# without swapping them here luna-sysmgr and every web app lay out to the raw
# 800x600 while the display presents 600x800: the app renders at the wrong
# resolution and only looks right once the device is physically turned.
#
# Swap for the quarter turns only. 180 keeps the same aspect and needs nothing.
case "${deviceinfo_compositor_geometry:-}" in
    *r90s*|*r270s*)
        if [ -n "${panel_w:-}" ] && [ -n "${panel_h:-}" ]; then
            _pw=$panel_w
            panel_w=$panel_h
            panel_h=$_pw
            echo "luneos-device-config: panel is mounted rotated, using ${panel_w}x${panel_h}"
        fi
        ;;
esac

changed=0
tmp=$(mktemp)
cp "$SRC" "$tmp"
set_kv() {
    grep -q "^$1=" "$tmp" || { echo "luneos-device-config: WARNING: no $1= anchor in $SRC"; return; }
    grep -q "^$1=$2\$" "$tmp" && return
    sed -i "s|^$1=.*|$1=$2|" "$tmp"
    changed=1
}
# set_kv insists on an anchor in the shipped file, and for DisplayWidth or DPI
# that is right - a missing one there means the template is wrong and a silent
# insert would hide it. The panel-shape keys are different: no template declares
# them, and none should have to. /etc/palm/luna-platform.conf is a bind mount
# over the copy this generator writes, so the generated file is the live one and
# the template is only a starting point; requiring an anchor would mean editing
# every machine's template to add two empty lines.
#
# So: rewrite the key if it is there, otherwise append it to the end of the named
# section.
set_or_add_kv() {
    if grep -q "^$1=" "$tmp"; then
        set_kv "$1" "$2"
        return
    fi
    if ! grep -q "^\[$3\]$" "$tmp"; then
        echo "luneos-device-config: WARNING: no [$3] section in $SRC for $1"
        return
    fi
    # Insert after the section's last real line, keeping any blank line that
    # separates it from the next header - hold blanks back while inside the
    # section and flush them after the inserted key.
    awk -v sect="[$3]" -v line="$1=$2" '
        function flush() { while (held > 0) { print ""; held-- } }
        $0 == sect          { inside = 1; print; next }
        inside && /^\[/     { print line; flush(); inside = 0; print; next }
        inside && /^$/      { held++; next }
        inside              { flush(); print; next }
                            { print }
        END                 { if (inside) { print line; flush() } }
    ' "$tmp" > "$tmp.new" && mv "$tmp.new" "$tmp"
    changed=1
}

[ -n "${panel_w:-}" ] && set_kv DisplayWidth "$panel_w"
[ -n "${panel_h:-}" ] && set_kv DisplayHeight "$panel_h"
set_kv DPI "$dpi"
set_kv GridUnit "$grid"

# How far below the real ambient level this device's ALS reads, because of the
# cover glass in front of it. Not derivable - the sensor reports nothing about
# what is covering it - so it is only written when an adaptation declares it,
# leaving the shipped 1.0 (take the reading at face value) otherwise.
[ -n "${deviceinfo_als_calibration:-}" ] && set_kv AlsCalibration "$deviceinfo_als_calibration"

# How much brighter (or dimmer) the backlight goes outdoors, as a percentage of
# the user's setting. Only an adaptation knows whether its panel is emissive or
# reflective, so this too is written only when one declares it.
[ -n "${deviceinfo_backlight_outdoor_scale:-}" ] && set_kv BrightnessOutdoorScale "$deviceinfo_backlight_outdoor_scale"

# The panel's shape. Only written when declared, for the reason above the
# rotate_rects() helper: an undeclared panel is a rectangular one.
[ -n "$cutouts" ] && set_or_add_kv Cutouts "$cutouts" Display
[ -n "$corner_radii" ] && set_or_add_kv CornerRadii "$corner_radii" Display

if [ "$changed" = "1" ]; then
    mkdir -p "$GEN/files/etc/palm"
    cp "$tmp" "$GEN/files/etc/palm/luna-platform.conf"
    echo "luneos-device-config: luna-platform ${panel_w}x${panel_h} dpi=$dpi gridUnit=$grid${deviceinfo_als_calibration:+ alsCal=$deviceinfo_als_calibration}${deviceinfo_backlight_outdoor_scale:+ outdoorScale=$deviceinfo_backlight_outdoor_scale}${cutouts:+ cutouts=$cutouts}${corner_radii:+ radii=$corner_radii}"
fi
rm -f "$tmp"

#!/bin/sh
# Display geometry for luna-sysmgr.
#
# DisplayWidth/DisplayHeight come straight from the connected DRM connector, and
# DPI from the panel's own density, so none of the three needs per-device data.
#
# GridUnit is the interesting one. It is the base layout unit, and across
# LuneOS devices it works out to a roughly constant *physical* size rather than
# a fixed pixel count:
#
#   sargo      DPI 441  GU 25  -> 1.44 mm      mido/tissot DPI 480 GU 26 -> 1.38 mm
#   hammerhead DPI 445  GU 26  -> 1.48 mm      rosy/pinephone DPI 282 GU 19 -> 1.71 mm
#   sagit      DPI 428  GU 19  -> 1.13 mm      (an outlier, as it is for devicePixelRatio)
#
# Deriving it as a constant 1.44 mm keeps touch targets the same physical size
# on any panel, and reproduces sargo's shipped 25 exactly. It is within one or
# two units on the others and well out on sagit, so the shipped values are not
# perfectly consistent - a device that cares pins deviceinfo_grid_unit.
SRC=/etc/palm/luna-platform.conf
[ -f "$SRC" ] || exit 0

GRID_UNIT_MM=${deviceinfo_grid_unit_mm:-1.44}

# DPI here is the panel's true physical PPI, which is NOT derivable: it needs
# the panel's physical dimensions, and an internal DSI panel exposes no EDID.
#
# This file used to say "never read back out of $SRC", and that rule came from a
# real bug - but it was drawn too wide. The bug was that the *generic* placeholder
# shipped an invented DPI and taking it as a fallback made that number the
# effective DPI of every device without an adaptation. The per-machine files are
# not placeholders: raspberrypi3 ships 133/8, tenderloin 132/10, rosy and the
# PinePhones 282/19, hammerhead 445/26, mido and tissot 480/26. Those are
# measured, hand-tuned numbers, and refusing to look at them meant writing
# LAST_RESORT_DPI over every one of them - 320/18 on the whole non-Halium fleet,
# which is a much larger error than the one the rule was written to prevent.
#
# So distinguish the two cases the way the shipped files already do. The generic
# machine ships DPI=0 GridUnit=0 (luna-sysmgr-conf/halium), which is the "we do
# not know" marker; any non-zero value is a measurement. The universal image is
# the generic machine, so it still derives everything; a machine we have actually
# ported keeps what was measured on it.
#
# DPI, in order of trust:
#
#   1. deviceinfo - the panel's true physical PPI, declared by a Tier 1
#      adaptation.
#   2. the value this machine ships, when it is not the 0 placeholder.
#   3. ro.sf.lcd_density - Android's density *bucket*. Close but not the same
#      thing (440 on sargo where the panel is 441), so it loses to a measurement
#      and beats nothing at all.
#   4. a last resort in code, so an unknown device still boots to a usable UI
#      rather than a zero-sized one. Deliberately here and not in the config
#      file: a fallback belongs where it can be seen to be a fallback.
LAST_RESORT_DPI=320

# A value the machine ships, or nothing if it ships the placeholder.
shipped_value() {
    _v=$(sed -n "s/^$1=\\(.*\\)$/\\1/p" "$SRC" | head -n1)
    case "$_v" in ''|0) return 1 ;; esac
    printf '%s\n' "$_v"
}

dpi=${deviceinfo_display_dpi:-}
[ -n "$dpi" ] || dpi=$(shipped_value DPI)
[ -n "$dpi" ] || dpi=$density
if [ -z "$dpi" ]; then
    dpi=$LAST_RESORT_DPI
    echo "luneos-device-config: WARNING: no DPI from deviceinfo, $SRC or the" \
         "vendor; falling back to $dpi"
fi

# GridUnit follows the same order with one exception, and the exception is the
# whole point: an adaptation that declares deviceinfo_display_dpi is declaring
# the number GridUnit is computed from, so there the derivation must run.
#
# The mindphone is the case that proves it. Its panel is 480x800 at a real
# ~233 PPI, and deriving from that gives GridUnit 13-14, which makes the shell
# chrome - the system menu is Units.gu(40) - wider than the screen and it
# overflows both edges. Its adaptation therefore declares dpi=190, picked so the
# formula lands on 11. Letting the shipped GridUnit=19 outrank that derivation
# gave a UI 1.7x too big on every surface, with gu(40) at 760px on a 480px
# panel. The DPI is the tuning knob; overriding what it tunes defeats it.
#
# Where no adaptation names a DPI there is nothing being tuned, so the shipped
# value stands - which is what keeps tissot at the 26 it ships rather than the
# 27 its density bucket derives, and rosy at 19 rather than 16.
grid=${deviceinfo_grid_unit:-}
if [ -z "$grid" ] && [ -z "${deviceinfo_display_dpi:-}" ]; then
    grid=$(shipped_value GridUnit)
fi
if [ -z "$grid" ]; then
    grid=$(awk -v d="$dpi" -v mm="$GRID_UNIT_MM" 'BEGIN { printf "%d", (d * mm / 25.4) + 0.5 }')
fi

changed=0
tmp=$(mktemp)
cp "$SRC" "$tmp"
set_kv() {
    grep -q "^$1=" "$tmp" || { echo "luneos-device-config: WARNING: no $1= anchor in $SRC"; return; }
    grep -q "^$1=$2\$" "$tmp" && return
    sed -i "s|^$1=.*|$1=$2|" "$tmp"
    changed=1
}
[ -n "${panel_w:-}" ] && set_kv DisplayWidth "$panel_w"
[ -n "${panel_h:-}" ] && set_kv DisplayHeight "$panel_h"
set_kv DPI "$dpi"
set_kv GridUnit "$grid"

if [ "$changed" = "1" ]; then
    mkdir -p "$GEN/files/etc/palm"
    cp "$tmp" "$GEN/files/etc/palm/luna-platform.conf"
    echo "luneos-device-config: luna-platform ${panel_w}x${panel_h} dpi=$dpi gridUnit=$grid"
fi
rm -f "$tmp"

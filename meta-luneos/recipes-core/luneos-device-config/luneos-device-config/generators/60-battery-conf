#!/bin/sh
# batteryd's critical-percent shutdown.
#
# batteryd powers the device off after three readings at or below
# critical_percent while nothing is charging. That is only safe when the gauge
# reports a real state of charge. A board whose gauge answers -1 (MTK's
# userspace fuel gauge on the MP01 rejects its nvram calibration and never
# publishes a capacity) is "at or below 2%" forever, and gets shut down every
# boot while sitting at 4.4 V on a charger.
#
# The config file has to carry this, not batteryd's --critical-percent flag:
# config_init() runs after option parsing and the shipped file's value wins.
#
# Opt-in per adaptation via deviceinfo_battery_critical_percent; the voltage and
# temperature triggers are untouched either way.
[ -n "${deviceinfo_battery_critical_percent:-}" ] || exit 0

SRC=/etc/default/com.webos.service.battery.conf
[ -f "$SRC" ] || exit 0

case "$deviceinfo_battery_critical_percent" in
    *[!0-9]*)
        echo "luneos-device-config: WARNING: deviceinfo_battery_critical_percent='$deviceinfo_battery_critical_percent' is not a number, ignoring"
        exit 0 ;;
esac

if ! grep -q '^critical_percent[[:space:]]*=' "$SRC"; then
    echo "luneos-device-config: WARNING: no critical_percent key in $SRC; cannot set this value"
    exit 0
fi

out=$GEN/files${SRC}
mkdir -p "$(dirname "$out")"
sed "s|^critical_percent[[:space:]]*=.*|critical_percent = $deviceinfo_battery_critical_percent|" "$SRC" > "$out"
echo "luneos-device-config: batteryd critical_percent -> $deviceinfo_battery_critical_percent"

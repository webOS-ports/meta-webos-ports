#!/bin/sh
# The physical keyboard's layout, for the input method to report onward.
#
# com.webos.service.ime carries it in getKeyboardStatus alongside whether a
# keyboard is attached, and WebAppMgr publishes it as
# PalmSystem.deviceInfo.keyboardType - the field legacy filled from the
# com.palm.properties.KEYoBRD nvram token. Vocabulary is legacy's: QWERTY,
# QWERTZ, AZERTY, AZERTY_FR, QWERTZ_DE.
#
# Tier 1 only, with no Tier 0 fallback, because there is nothing to derive from.
# Evdev scancodes are positional - a QWERTZ keyboard and a QWERTY one advertise
# exactly the same keys - and the ones that differ do so by purchase option, not
# by anything the device knows about itself: the Astro Slide ships in QWERTY,
# QWERTZ and AZERTY from the same hardware. A USB or Bluetooth keyboard's layout
# lives in the compositor's xkb keymap, which is a separate question from what the
# phone's own keyboard is.
#
#   deviceinfo_keyboard_layout="QWERTY"
#
# Not validated here beyond its shape. The set of names is the input method's to
# know, and a typo it can see is better reported there than guessed at here.
SRC=/etc/maliit/hwkeyboard-layout
[ -f "$SRC" ] || exit 0

layout=${deviceinfo_keyboard_layout:-}
[ -n "$layout" ] || exit 0

# One word, so a stray quote or a whole sentence cannot become a layout name.
case "$layout" in
    *[!A-Za-z0-9_]*)
        echo "luneos-device-config: WARNING: keyboard layout '$layout' is not one word, ignoring" >&2
        exit 0 ;;
esac

out=$GEN/files${SRC}
mkdir -p "$(dirname "$out")"

# The whole file, not an append: it is read as "the first line that is not blank
# and not a comment", so the shipped comment is kept for anyone who looks at it
# on the device and wonders where the value came from.
{
    echo "# Generated by luneos-device-config from deviceinfo_keyboard_layout."
    echo "# The shipped default is all comment; see the package's own copy."
    echo "$layout"
} > "$out"

echo "luneos-device-config: hardware keyboard layout: $layout"

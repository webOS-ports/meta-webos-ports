#!/bin/sh
# bluebinder's controller workarounds, per adaptation.
#
# bluebinder can rewrite what the controller reports about itself before the
# kernel sees it (see bluebinder.c):
#
#   BLUEBINDER_LOCAL_EXT_FEATURES_PAGE_2_MASK   bits cleared from Read Local
#       Extended Features page 2 (byte 0 is the top byte of the mask)
#   BLUEBINDER_LOCAL_COMMANDS_SET               bits added to Read Local
#       Supported Commands, "<octet>:<hex mask>,..."
#
# The kernel trusts those answers during hci init and aborts it if a command it
# then sends is refused. The Minimal Phone MP01's MT6789 advertises
# Synchronization Train support in page 2 but answers Read Synchronization
# Train Parameters with "Unknown HCI Command", so hci0 never comes up
# ("Can't init device hci0: Invalid request code").
#
# bluebinder.service reads /var/lib/environment/bluebinder/*.conf, and this
# package ships luneos-device.conf there empty so there is something to shadow.
DST=/var/lib/environment/bluebinder/luneos-device.conf
[ -f "$DST" ] || exit 0

mask=${deviceinfo_bluebinder_ext_features_page_2_mask:-}
cmds=${deviceinfo_bluebinder_local_commands_set:-}
[ -n "$mask$cmds" ] || exit 0

out=$GEN/files${DST}
mkdir -p "$(dirname "$out")"
cp "$DST" "$out"
if [ -n "$mask" ]; then
    echo "BLUEBINDER_LOCAL_EXT_FEATURES_PAGE_2_MASK=$mask" >> "$out"
    echo "luneos-device-config: bluebinder ext features page 2 mask $mask"
fi
if [ -n "$cmds" ]; then
    echo "BLUEBINDER_LOCAL_COMMANDS_SET=$cmds" >> "$out"
    echo "luneos-device-config: bluebinder local commands set $cmds"
fi

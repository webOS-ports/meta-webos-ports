[Unit]
Description=Derive LuneOS device configuration
DefaultDependencies=no
# Needs the container's property service to read the *vendor's* idea of which
# device this is, and must land before anything that consumes the result.
#
# Wants, not Requires: this only needs the container to be *running* (getprop
# answering), not android-system.service's readiness verdict. That service is
# marked failed if its ExecStartPost probes (lshal, the graphics-HAL wait) time
# out or crash even though the container itself is up - and a Requires= turned
# that into a skipped device-config, which leaves the compositor and luna-sysmgr
# on the shipped placeholder: no touch device and no power keys, i.e. a phone
# that cannot be unlocked and whose power button does not wake the screen. With
# Wants=, After= still orders us after the container has finished starting (or
# failed), but a failed verdict no longer suppresses config generation.
After=android-system.service
Wants=android-system.service
# And after udev, which is the ordering this unit never had.
#
# DefaultDependencies=no has to stay: the service is RequiredBy=basic.target, and
# the implicit After=basic.target that default dependencies would add makes an
# ordering cycle that systemd can only resolve by dropping one of the two jobs.
# But switching them off also drops the implicit After=sysinit.target, which left
# android-system.service as the only ordering on this unit - and there is no
# android-system.service on a mainline machine. On rosy, mido, tissot,
# hammerhead, tenderloin, the Pis, the PinePhones and the qemu targets the
# service therefore had no ordering at all and raced udev, which it lost: it ran
# in the first second of userspace, before /sys/class/drm had any card and before
# udevd was even started, so every Tier 0 value came back empty and every
# generator below fell through to its "we know nothing" branch.
#
# systemd-udev-trigger.service is the coldplug. It pulls in systemd-udevd.service
# and is itself Before=sysinit.target, so ordering after it keeps this unit in the
# same slot relative to basic.target and introduces no cycle.
After=systemd-udev-trigger.service
Wants=systemd-udev-trigger.service
# Before configd, so the generated layer is in place and the stale cache is
# gone before it builds its merged view.
#
# nyx.target is the ordering point for everything that reads /etc/nyx.conf,
# which this service generates. Naming the target rather than its consumers
# matters: luna-sysmgr is After=nyx.target and was not in the list below, so it
# opened nyx before the generated config was bound and got the shipped
# placeholder - no key devices and no touchpanel, which is a phone whose power
# button does not wake the screen. Anything that reads nyx.conf in future is
# covered by the target without having to be added here.
Before=surface-manager-daemon.service sensorfwd.service ofono.service configd.service
Before=nyx.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The derivation waits for the display to appear before reading it - see the
# comment on DISPLAY_WAIT in luneos-device-config. Be explicit about the room
# that needs rather than leaning on DefaultTimeoutStartSec, because this unit
# sits in front of nyx.target and the compositor.
TimeoutStartSec=120
ExecStart=/usr/bin/luneos-device-config

[Install]
RequiredBy=basic.target

# Remove core dumps after three days.
#
# systemd's tmpfiles.d/systemd.conf gives /var/lib/systemd/coredump an age of
# 2w, but only "systemd-tmpfiles --clean" acts on that, and its daily timer is
# masked by webos-initscripts, so dumps were never removed for their age. That
# timer has to stay masked: it would also age /tmp, where the /tmp/lsm-ready
# that webapp-mgr.service needs to start, /tmp/boot-done and others are created
# once at boot and must last the whole uptime.
#
# So this cleans the one directory, from the line on stdin: giving
# systemd-tmpfiles a config of its own means it reads nothing else. The dumps
# systemd-coredump is still writing are younger than this age.
[Unit]
Description=Remove core dumps older than three days
Documentation=man:systemd-coredump(8) man:tmpfiles.d(5)
After=local-fs.target

[Service]
Type=oneshot
ExecStart=systemd-tmpfiles --clean -
StandardInputText=d /var/lib/systemd/coredump 0755 root root 3d
SuccessExitStatus=DATAERR
IOSchedulingClass=idle

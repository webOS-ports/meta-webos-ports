# Same schedule as systemd-tmpfiles-clean.timer. No Condition= on the service:
# OnUnitActiveSec= counts from its last run, so a run that was skipped would
# stop the timer. Enabled by a static link in timers.target.wants, as systemd
# does for its own timer.
[Unit]
Description=Daily removal of old core dumps
Documentation=man:systemd-coredump(8) man:tmpfiles.d(5)

[Timer]
OnBootSec=15min
OnUnitActiveSec=1d

#!/bin/sh
# ExecCondition for serial-getty@.service: exit 1 (skip the unit, no restart)
# when the serial port named by $1 (e.g. ttyS0) has no UART behind it.
#
# The 8250 driver registers the legacy ttyS0-3 on every PC, found or not, and
# systemd-getty-generator starts a getty for console=ttyS0 on the kernel
# command line. Without hardware the serial core reports type 0
# (PORT_UNKNOWN) and every open sets TTY_IO_ERROR, so agetty fails, and
# Restart=always starts it again, over and over (every ~10 s on VirtualBox
# without a serial port). A port with a UART, or a tty that is not a
# serial-core port (hvc0, ttyGS0: no type attribute), gets its getty as before.

tty="${1:-}"
[ -n "${tty}" ] || exit 0

type_file="/sys/class/tty/${tty}/type"
[ -r "${type_file}" ] || exit 0
read -r port_type < "${type_file}" || exit 0

# Nothing to print: stdout is that port, which takes no writes. systemd logs
# the skip ("Skipped due to 'exec-condition'").
[ "${port_type}" != 0 ]

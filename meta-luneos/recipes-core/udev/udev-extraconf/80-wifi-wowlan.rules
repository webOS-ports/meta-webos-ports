# Arm a WoWLAN trigger on every Wi-Fi phy as it appears, so cfg80211 does not
# disconnect the interface on suspend. The helper picks a trigger the chip
# actually supports - magic-packet where available, nothing otherwise; see it
# for why "disconnect" is not used.
SUBSYSTEM=="ieee80211", ACTION=="add", KERNEL=="phy*", RUN+="/usr/sbin/luneos-wowlan-arm %k"

#!/bin/sh
# Turn on 802.11 power save for a station interface as it appears.
#
# With power save off the chip receives continuously: it never dozes between
# the beacons of its AP, so the radio draws its full receive current even
# while the phone is suspended and the CPU is off. Measured on tissot
# (prima/WCNSS, 2026-09-20): "iw dev wlan0 get power_save" read "off" while
# the phone slept 97.5% of a 40-minute window and still lost about 80 mAh per
# hour, where sargo, whose qcacld driver comes up with power save on, drew
# 31 mAh/h under the same kind of load.
#
# cfg80211 defaults this per driver, so it is not uniform across our phones;
# set it explicitly rather than inheriting whatever the vendor driver chose.
# Only managed (station) interfaces: an AP or P2P interface must not doze.
IF=${1:-wlan0}
IW=/usr/sbin/iw
TAG=luneos-wifi-powersave

[ -x "$IW" ] || exit 0
[ -d "/sys/class/net/$IF" ] || exit 0

type=$("$IW" dev "$IF" info 2>/dev/null | sed -n 's/^[[:space:]]*type //p')
case "$type" in
    managed) ;;
    *)       exit 0 ;;
esac

if "$IW" dev "$IF" set power_save on 2>/dev/null; then
    logger -t "$TAG" "$IF: power save on"
else
    logger -t "$TAG" "$IF: could not set power save"
fi

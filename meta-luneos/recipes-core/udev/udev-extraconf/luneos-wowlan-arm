#!/bin/sh
# Arm the best WoWLAN trigger this phy supports, so cfg80211 keeps the
# association across suspend instead of tearing it down.
#
# Without any trigger, wiphy_suspend() calls cfg80211_leave_all() and the
# device disconnects on every suspend, reconnects on resume, and the driver's
# own wakelocks then block the next attempt (measured on sargo: WiFi down and
# up on every cycle until magic-packet was armed).
#
# What is supported differs per chip, so ask rather than assume:
#   qcacld/prima (sargo, tissot)  magic-packet
#   rtw88 (PineTab2)              no magic-packet; "disconnect" only
#   brcmfmac (PinePhone Pro)      none at all - nothing to do
# "any" is deliberately not used: it keeps the chip fully powered and saves
# nothing.
PHY=${1:-phy0}
IW=/usr/sbin/iw
TAG=luneos-wowlan-arm

[ -x "$IW" ] || exit 0

# The udev rule passes %k from the ieee80211 subsystem, so the argument is a
# phy. By hand the obvious thing to type is the interface, which used to exit
# here without a word and look like "the helper did nothing"; accept it.
if [ ! -d "/sys/class/ieee80211/$PHY" ] && [ -e "/sys/class/net/$PHY/phy80211" ]; then
    PHY=$(basename "$(readlink -f "/sys/class/net/$PHY/phy80211")")
fi

[ -d "/sys/class/ieee80211/$PHY" ] || exit 0

caps=$("$IW" phy "$PHY" info 2>/dev/null | sed -n '/WoWLAN support:/,/^	[a-z]/p')
# Only magic-packet. "disconnect" looks like a cheap way to keep the
# association across suspend, and on the PineTab2's bes2600 it stops the phone
# suspending at all: the driver waits five seconds for the chip to reach its
# low-power state, gives up ("wait device idle timeout"), cfg80211's
# wiphy_suspend returns -EBUSY and the kernel aborts the whole transition.
# Measured 2026-09-20: 46 consecutive failed suspends with the trigger armed,
# and the first attempt succeeded the moment it was disabled. "any" is worse
# still - it keeps the chip fully powered.
#
# The exception is MediaTek's connectivity-chip Wi-Fi (Titan, Titan Pocket),
# which offers only "any" and "disconnect". It is known by /dev/wmtWifi, the
# node its chip is powered up through, which exists before the phy does; the
# phy itself is a virtual device with no driver to ask. Its firmware
# keeps the association itself and filters broadcast and multicast while the
# display is off (wlan-suspend-mode's SETSUSPENDMODE), so "any" does not keep
# the host awake there. Left off, the phones hardly slept: each suspend
# attempt dropped the link, connman reconnected, and the driver's "WLAN
# timeout" wakelock blocked the next attempt. Measured 13 Nov 2026, unplugged,
# display off: Titan Pocket 1.5% asleep over 26 min with 462 reconnects, Titan
# 78% asleep with 36 failed suspends to 12; with "any" both 98% asleep over
# 10 min, no reconnects, Wi-Fi still up.
case "$caps" in
    *"wake up on magic packet"*) trigger="magic-packet" ;;
    *"wake up on anything"*)
        if [ -e /dev/wmtWifi ]; then
            trigger="any"
        else
            logger -t "$TAG" "$PHY: no magic-packet trigger, leaving WoWLAN off"; exit 0
        fi ;;
    *)                           logger -t "$TAG" "$PHY: no magic-packet trigger, leaving WoWLAN off"; exit 0 ;;
esac

if "$IW" phy "$PHY" wowlan enable "$trigger" 2>/dev/null; then
    logger -t "$TAG" "$PHY: armed $trigger"
else
    logger -t "$TAG" "$PHY: arming $trigger failed"
fi

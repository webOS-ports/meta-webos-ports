+/*
+ * LuneOS's libadbd_auth (adbd_auth_luneos.cpp): the parts the tests use
+ * besides adbd_auth.h. adbd itself uses adbd_auth.h only.
+ */
+
+#include <string>
+#include <string_view>
+
+#include "include/adbd_auth.h"
+
+namespace adbd_auth_luneos {
+
+// What one line of adb_keys is.
+enum class KeyLine {
+    kKey,      // an adb RSA key, maybe followed by a comment
+    kBlank,    // empty or white space only: skipped silently
+    kNotText,  // has a NUL in it
+    kTooLong,  // longer than any key line can be
+    kNotAKey,  // anything else
+};
+
+// `line` without its '\n'; a '\r' before it is allowed.
+KeyLine ClassifyKeyLine(std::string_view line);
+
+// "SHA256:<base64 of the SHA-256 of the decoded key>" (as ssh-keygen -l and
+// the developer mode service print it) for a key line, "" for anything else.
+std::string Fingerprint(std::string_view key_line);
+
+// Makes adbd_auth_run() return, for the tests; adbd never stops it.
+void Stop(AdbdAuthContext* ctx);
+
+}  // namespace adbd_auth_luneos

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 06:33:01 +0100
Subject: [PATCH] adbd: fall back to blocking FunctionFS I/O without AIO

adbd 35 reads and writes the FunctionFS bulk endpoints only through
Linux AIO. FunctionFS gained ->aio_read/->aio_write in Linux 3.15, and
io_submit() fails with EINVAL on a file without them, so on an older
kernel the first read fails as soon as the function is enabled:

  UsbFfs: connection terminated: failed to submit read: Invalid argument

The gadget stays enumerated, the host sees the device "offline" and
retries every few seconds, for good (mako-halium, kernel 3.4.113). AOSP
dropped the blocking implementation (usb_legacy.cpp) in Android 11.

When io_submit() of the first read fails with EINVAL, remember it for
the life of adbd and use blocking I/O on this and every later
connection. The worker thread then writes the queued blocks in order
with write(), woken by the eventfd Write() and Stop() already signal,
and a reader thread reads each header and then exactly its payload
(bounded by MAX_PAYLOAD), as adbd did before AIO; a zero-length read is
a host ZLP and is skipped, and an EPIPE before any data (ClearFeature
HALT) is retried as ReadEvents() does. On A_CNXN the writes still
queued for the previous host are dropped.

The ep0 monitor is unchanged. StopWorker() interrupts both threads with
SIGUSR2, whose handler is installed without SA_RESTART so that a blocked
read() or write() on an endpoint returns EINTR; the AIO path keeps
SIGUSR1 and its restarting handler. A mutex orders StopWorker() against
the worker's switch to blocking I/O, so a disable that races the switch
stops whichever mode won. Kernels with FunctionFS AIO keep the AIO path.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [LuneOS: kernels without FunctionFS AIO]
---
 packages/modules/adb/daemon/usb.cpp | 253 +++++++++++++++++++++++++++-
 1 file changed, 252 insertions(+), 1 deletion(-)

diff --git a/packages/modules/adb/daemon/usb.cpp b/packages/modules/adb/daemon/usb.cpp
index 73316ca..5a9c654 100644
--- a/packages/modules/adb/daemon/usb.cpp
+++ b/packages/modules/adb/daemon/usb.cpp
@@ -28,10 +28,12 @@
 #include <unistd.h>
 
 #include <linux/usb/functionfs.h>
+#include <signal.h>
 #include <sys/eventfd.h>
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <future>
 #include <memory>
 #include <mutex>
@@ -68,6 +70,11 @@ static constexpr size_t kUsbReadSize = 16384;
 static constexpr size_t kUsbWriteQueueDepth = 8;
 static constexpr size_t kUsbWriteSize = 16384;
 
+// Set once the kernel has refused AIO on a FunctionFS endpoint: FunctionFS gained
+// ->aio_read/->aio_write in Linux 3.15, and io_submit() fails with EINVAL on a file
+// without them. Every later connection then goes straight to blocking I/O.
+static std::atomic<bool> g_ffs_aio_unsupported = false;
+
 static const char* to_string(enum usb_functionfs_event_type type) {
     switch (type) {
         case FUNCTIONFS_BIND:
@@ -410,9 +417,27 @@ struct UsbFfsConnection : public Connection {
             } exit_flag{worker_exited_};
             LOG(INFO) << "UsbFfs-worker thread spawned";
 
+            if (g_ffs_aio_unsupported) {
+                RunBlocking();
+                return;
+            }
+
             for (size_t i = 0; i < kUsbReadQueueDepth; ++i) {
                 read_requests_[i] = CreateReadBlock(next_read_id_++);
-                if (!SubmitRead(&read_requests_[i])) {
+                IoReadBlock* block = &read_requests_[i];
+                block->pending = true;
+                struct iocb* iocb = &block->control;
+                if (io_submit(aio_context_.get(), 1, &iocb) != 1) {
+                    int err = errno;
+                    block->pending = false;
+                    if (i == 0 && err == EINVAL) {
+                        LOG(WARNING) << "FunctionFS has no AIO (io_submit: " << strerror(err)
+                                     << "), using blocking reads and writes";
+                        g_ffs_aio_unsupported = true;
+                        RunBlocking();
+                        return;
+                    }
+                    HandleError(StringPrintf("failed to submit read: %s", strerror(err)));
                     return;
                 }
             }
@@ -439,6 +464,19 @@ struct UsbFfsConnection : public Connection {
             return;
         }
 
+        bool blocking;
+        {
+            // From here on the worker will not switch to blocking I/O, so the mode
+            // read here is the one to stop.
+            std::lock_guard<std::mutex> lock(mode_mutex_);
+            interrupt_requested_ = true;
+            blocking = blocking_;
+        }
+        if (blocking) {
+            StopBlocking();
+            return;
+        }
+
         pthread_t worker_thread_handle = worker_thread_.native_handle();
         while (true) {
             int rc = pthread_kill(worker_thread_handle, kInterruptionSignal);
@@ -464,6 +502,209 @@ struct UsbFfsConnection : public Connection {
         worker_thread_.join();
     }
 
+    // Blocking I/O, for kernels whose FunctionFS has no AIO. The worker thread
+    // becomes the writer: it sleeps on worker_event_fd_, which Write() and Stop()
+    // already signal, and writes the queued blocks in order. A reader thread reads
+    // each packet's header and then exactly its payload, as adbd did before AIO
+    // (usb_legacy.cpp); a zero-length read is a ZLP from the host and is skipped.
+    //
+    // Both threads are interrupted with kBlockingInterruptionSignal, whose handler
+    // is installed without SA_RESTART so that a blocked read() or write() on an
+    // endpoint returns EINTR. The AIO path keeps kInterruptionSignal, installed
+    // with signal() and so restarting, because its eventfd reads treat EINTR as
+    // fatal.
+    void RunBlocking() {
+        if (!EnterBlocking()) {
+            return;
+        }
+        BlockingWriteLoop();
+    }
+
+    // Switches to blocking I/O and starts the reader, unless StopWorker() has
+    // already been called: then it fixed the mode as AIO and waits for this
+    // thread to exit.
+    bool EnterBlocking() {
+        std::lock_guard<std::mutex> lock(mode_mutex_);
+        if (interrupt_requested_) {
+            return false;
+        }
+        blocking_ = true;
+
+        static std::once_flag handler_once;
+        std::call_once(handler_once, []() {
+            struct sigaction sa = {};
+            sa.sa_handler = [](int) {};
+            sigemptyset(&sa.sa_mask);
+            sa.sa_flags = 0;
+            if (sigaction(kBlockingInterruptionSignal, &sa, nullptr) != 0) {
+                PLOG(FATAL) << "failed to install the blocking USB interruption handler";
+            }
+        });
+
+        reader_thread_ = std::thread([this]() {
+            adb_thread_setname("UsbFfs-reader");
+            struct ExitFlag {
+                std::atomic<bool>& f;
+                ~ExitFlag() { f = true; }
+            } exit_flag{reader_exited_};
+            BlockingReadLoop();
+        });
+        return true;
+    }
+
+    bool BlockingShouldExit() const { return interrupt_requested_ || stopped_; }
+
+    // Reads exactly len bytes. Returns false, having reported any error, when the
+    // connection is going away.
+    bool BlockingRead(char* data, size_t len) {
+        while (len > 0) {
+            if (BlockingShouldExit()) {
+                return false;
+            }
+            size_t chunk = std::min(len, kUsbReadSize);
+            ssize_t n = unix_read_interruptible(read_fd_, data, chunk);
+            if (n < 0) {
+                int err = errno;
+                if (err == EINTR) {
+                    continue;
+                }
+                // A ClearFeature(HALT) from a host resynchronising after its adb server
+                // was killed fails the read in progress; retry until data has arrived,
+                // as ReadEvents() does on the AIO path.
+                if (err == EPIPE && !connection_started_) {
+                    continue;
+                }
+                HandleError(StringPrintf("blocking read failed: %s", strerror(err)));
+                return false;
+            }
+            if (n == 0) {
+                continue;
+            }
+            connection_started_ = true;
+            data += n;
+            len -= static_cast<size_t>(n);
+        }
+        return true;
+    }
+
+    void BlockingReadLoop() {
+        while (!BlockingShouldExit()) {
+            amessage msg;
+            if (!BlockingRead(reinterpret_cast<char*>(&msg), sizeof(msg))) {
+                return;
+            }
+            LOG(DEBUG) << "USB read:" << dump_header(&msg);
+
+            if (msg.data_length > MAX_PAYLOAD) {
+                HandleError(StringPrintf("received packet with payload of %" PRIu32
+                                         " bytes, more than %zu",
+                                         msg.data_length, MAX_PAYLOAD));
+                return;
+            }
+
+            if (msg.command == A_CNXN) {
+                // Drop what is queued for the previous host; a write already
+                // under way cannot be taken back.
+                std::lock_guard<std::mutex> lock(write_mutex_);
+                write_requests_.clear();
+            }
+
+            auto packet = std::make_unique<apacket>();
+            packet->msg = msg;
+            if (msg.data_length > 0) {
+                packet->payload.resize(msg.data_length);
+                if (!BlockingRead(packet->payload.data(), msg.data_length)) {
+                    return;
+                }
+            }
+            transport_->HandleRead(std::move(packet));
+        }
+    }
+
+    // Writes exactly len bytes; false when the connection is going away.
+    bool BlockingWrite(const char* data, size_t len) {
+        while (len > 0) {
+            if (BlockingShouldExit()) {
+                return false;
+            }
+            ssize_t n = ::write(write_fd_.get(), data, len);
+            if (n < 0) {
+                int err = errno;
+                if (err == EINTR) {
+                    continue;
+                }
+                HandleError(StringPrintf("blocking write failed: %s", strerror(err)));
+                return false;
+            }
+            if (n == 0) {
+                HandleError("blocking write wrote nothing");
+                return false;
+            }
+            data += n;
+            len -= static_cast<size_t>(n);
+        }
+        return true;
+    }
+
+    void BlockingWriteLoop() {
+        while (!BlockingShouldExit()) {
+            uint64_t dummy;
+            ssize_t rc = unix_read_interruptible(worker_event_fd_, &dummy, sizeof(dummy));
+            if (rc == -1) {
+                if (errno == EINTR) {
+                    continue;
+                }
+                PLOG(FATAL) << "failed to read from eventfd";
+            } else if (rc == 0) {
+                LOG(FATAL) << "hit EOF on eventfd";
+            }
+
+            while (!BlockingShouldExit()) {
+                IoWriteBlock block;
+                {
+                    std::lock_guard<std::mutex> lock(write_mutex_);
+                    if (write_requests_.empty()) {
+                        break;
+                    }
+                    block = std::move(write_requests_.front());
+                    write_requests_.pop_front();
+                }
+                const char* data = reinterpret_cast<const char*>(
+                        static_cast<uintptr_t>(block.control.aio_buf));
+                if (!BlockingWrite(data, block.control.aio_nbytes)) {
+                    return;
+                }
+            }
+        }
+    }
+
+    void StopBlocking() {
+        // Wake the writer if it is waiting for work.
+        uint64_t notify = 1;
+        if (adb_write(worker_event_fd_.get(), &notify, sizeof(notify)) < 0) {
+            PLOG(ERROR) << "failed to wake the blocking USB writer";
+        }
+
+        InterruptUntilExited(worker_thread_, worker_exited_, "writer");
+        worker_thread_.join();
+        InterruptUntilExited(reader_thread_, reader_exited_, "reader");
+        reader_thread_.join();
+    }
+
+    static void InterruptUntilExited(std::thread& thread, const std::atomic<bool>& exited,
+                                     const char* name) {
+        pthread_t handle = thread.native_handle();
+        while (!exited) {
+            int rc = pthread_kill(handle, kBlockingInterruptionSignal);
+            if (rc != 0) {
+                LOG(ERROR) << "failed to interrupt the blocking USB " << name << ": "
+                           << strerror(rc);
+                break;
+            }
+            std::this_thread::sleep_for(100ms);
+        }
+    }
+
     void PrepareReadBlock(IoReadBlock* block, uint64_t id) {
         block->pending = false;
         if (block->payload.capacity() >= kUsbReadSize) {
@@ -717,6 +958,15 @@ struct UsbFfsConnection : public Connection {
     std::atomic<bool> worker_exited_ = false;
     std::thread worker_thread_;
 
+    // Blocking I/O (RunBlocking()). mode_mutex_ orders the worker's switch to
+    // blocking I/O against StopWorker(); reader_thread_ is set under it together
+    // with blocking_.
+    std::mutex mode_mutex_;
+    bool blocking_ GUARDED_BY(mode_mutex_) = false;
+    std::atomic<bool> interrupt_requested_ = false;
+    std::atomic<bool> reader_exited_ = false;
+    std::thread reader_thread_;
+
     std::atomic<bool> stopped_;
     std::promise<void> destruction_notifier_;
     std::once_flag error_flag_;
@@ -748,6 +998,7 @@ struct UsbFfsConnection : public Connection {
     size_t writes_submitted_ GUARDED_BY(write_mutex_) = 0;
 
     static constexpr int kInterruptionSignal = SIGUSR1;
+    static constexpr int kBlockingInterruptionSignal = SIGUSR2;
 };
 
 static void usb_ffs_open_thread() {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 30 Oct 2026 06:40:17 +0100
Subject: [PATCH] adb: check saved keys with OpenSSL; skip a damaged adb_keys
 line

adbd crashed in libcrypto on every start once a host had been allowed
"always" (one key in /var/lib/adbd/adb_keys), and the host saw "device
offline":

    adbd general protection fault ... in libcrypto.so.3
    #0 RSA_verify (libcrypto.so.3 + 0x33d784)

adb_auth_verify() called mincrypt's

    RSA_verify(const RSAPublicKey *key, sig, siglen, hash, hashlen)

but meta-oe's adbd.mk does not build libmincrypt and links -lcrypto, so
the call was bound to OpenSSL's RSA_verify(int type, m, m_len, sigbuf,
siglen, RSA *rsa) - another function with the same name - which took a
garbage RSA pointer. adbd imports RSA_verify@OPENSSL_3.0.0 and nothing
else from libcrypto. It was never reached before: with no key saved
there is nothing to verify against.

The key is now built with OpenSSL itself: adb_keys' line is mincrypt's
RSAPublicKey in base64, read field by field as little-endian (a 64-word
length, then the modulus and the exponent; n0inv and rr are mincrypt's
precomputations and not needed), turned into an EVP_PKEY, and the
host's signature is checked as PKCS#1 v1.5 over the token as a SHA-1
digest, which is what adb's host side signs.

A line that is not a key - bad base64, another size, an exponent other
than 3 or 65537, a modulus that is not an odd 2048-bit number, a NUL in
it, longer than the buffer - is skipped with a line on stderr (the
journal) naming the file and line, and the next line is still read. A
damaged adb_keys can no longer crash adbd or keep the other hosts out.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [LuneOS-specific: fixes the key check 0001 brings in; meta-oe's adbd does not authenticate]
---
 adb/adb_auth_client.c | 194 ++++++++++++++++++++++++++++++++++++------
 1 file changed, 167 insertions(+), 27 deletions(-)

diff --git a/adb/adb_auth_client.c b/adb/adb_auth_client.c
index ba6aeb58d8..01c3eb4b0a 100644
--- a/adb/adb_auth_client.c
+++ b/adb/adb_auth_client.c
@@ -30,18 +30,118 @@
 #include "adb.h"
 #include "adb_auth.h"
 #include "fdevent.h"
-#include "mincrypt/rsa.h"
 #include "mincrypt/sha.h"
 
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/evp.h>
+#include <openssl/param_build.h>
+#include <openssl/rsa.h>
+
 #define TRACE_TAG TRACE_AUTH
 
 extern int b64_pton(const char* src, uint8_t* target, size_t targsize);
 
+/*
+ * LuneOS: a key is checked with OpenSSL. adbd.mk (meta-oe) does not build
+ * libmincrypt but links -lcrypto, so mincrypt's
+ *     RSA_verify(const RSAPublicKey *, sig, siglen, hash, hashlen)
+ * was bound to OpenSSL's RSA_verify(int type, m, m_len, sig, siglen, RSA *)
+ * at run time - a different function - and adbd crashed in libcrypto as soon
+ * as adb_keys held a key. The key line is mincrypt's RSAPublicKey in base64,
+ * all fields little-endian:
+ *     uint32 len (= 64 words)  uint32 n0inv  uint8 n[256]  uint8 rr[256]
+ *     uint32 exponent
+ * Only n and the exponent are needed; n0inv and rr are mincrypt's own
+ * precomputations and are ignored.
+ */
+#define ADB_KEY_WORDS 64
+#define ADB_KEY_BYTES (ADB_KEY_WORDS * 4)
+#define ADB_KEY_STRUCT_BYTES (4 + 4 + ADB_KEY_BYTES + ADB_KEY_BYTES + 4)
+
 struct adb_public_key {
     struct listnode node;
-    RSAPublicKey key;
+    EVP_PKEY *pkey;
 };
 
+static uint32_t le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* One adb_keys line's key (the base64 alone), or NULL with why in *why. */
+static EVP_PKEY *adb_key_decode(const char *b64, const char **why)
+{
+    /* 4 bytes over: b64_pton wants room for a partial last group. */
+    uint8_t raw[ADB_KEY_STRUCT_BYTES + 4];
+    uint32_t exponent;
+    BIGNUM *n = NULL, *e = NULL;
+    OSSL_PARAM_BLD *bld = NULL;
+    OSSL_PARAM *params = NULL;
+    EVP_PKEY_CTX *ctx = NULL;
+    EVP_PKEY *pkey = NULL;
+    int ret;
+
+    ret = b64_pton(b64, raw, sizeof(raw));
+    if (ret != ADB_KEY_STRUCT_BYTES) {
+        *why = "not the base64 of an adb key";
+        return NULL;
+    }
+    if (le32(raw) != ADB_KEY_WORDS) {
+        *why = "not a 2048-bit adb key";
+        return NULL;
+    }
+    exponent = le32(raw + (size_t)(8 + 2 * ADB_KEY_BYTES));
+    if (exponent != 3 && exponent != 65537) {
+        *why = "an exponent adb keys do not have";
+        return NULL;
+    }
+    n = BN_lebin2bn(raw + 8, ADB_KEY_BYTES, NULL);
+    e = BN_new();
+    if (!n || !e || !BN_set_word(e, exponent) || BN_num_bits(n) != ADB_KEY_BYTES * 8 || !BN_is_odd(n)) {
+        *why = "not a 2048-bit RSA modulus";
+        goto out;
+    }
+    bld = OSSL_PARAM_BLD_new();
+    if (bld && OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_RSA_N, n) &&
+        OSSL_PARAM_BLD_push_BN(bld, OSSL_PKEY_PARAM_RSA_E, e))
+        params = OSSL_PARAM_BLD_to_param(bld);
+    if (!params) {
+        *why = "out of memory";
+        goto out;
+    }
+    ctx = EVP_PKEY_CTX_new_from_name(NULL, "RSA", NULL);
+    if (!ctx || EVP_PKEY_fromdata_init(ctx) <= 0 ||
+        EVP_PKEY_fromdata(ctx, &pkey, EVP_PKEY_PUBLIC_KEY, params) <= 0) {
+        *why = "OpenSSL did not take the key";
+        pkey = NULL;
+    }
+out:
+    EVP_PKEY_CTX_free(ctx);
+    OSSL_PARAM_free(params);
+    OSSL_PARAM_BLD_free(bld);
+    BN_free(n);
+    BN_free(e);
+    return pkey;
+}
+
+/* The host's signature of token: PKCS#1 v1.5 over the token as a SHA-1
+ * digest, which is what adb_auth_host.c's RSA_sign(NID_sha1, ...) made. */
+static int adb_key_verify(EVP_PKEY *pkey, const uint8_t *sig, size_t siglen,
+                          const uint8_t *token, size_t token_len)
+{
+    EVP_PKEY_CTX *ctx;
+    int ok = 0;
+
+    ctx = EVP_PKEY_CTX_new(pkey, NULL);
+    if (ctx && EVP_PKEY_verify_init(ctx) > 0 &&
+        EVP_PKEY_CTX_set_rsa_padding(ctx, RSA_PKCS1_PADDING) > 0 &&
+        EVP_PKEY_CTX_set_signature_md(ctx, EVP_sha1()) > 0)
+        ok = EVP_PKEY_verify(ctx, sig, siglen, token, token_len) == 1;
+    EVP_PKEY_CTX_free(ctx);
+    return ok;
+}
+
 /*
  * LuneOS: the keys the user allowed "always" are kept in /var/lib/adbd, which
  * only root can read or write; the developer mode service
@@ -83,13 +183,51 @@ static struct adisconnect usb_disconnect = { usb_disconnected, 0, 0, 0 };
 static atransport* usb_transport;
 static bool needs_retry = false;
 
+/*
+ * One line of f into buf (NUL-terminated, without its newline), however long
+ * it is: what does not fit is read and dropped, so the next call starts on
+ * the next line. 0 at the end of the file. *too_long and *has_nul say the
+ * line was not one buf could hold, or not text (fgets cannot tell a NUL in a
+ * line from its end, and took what followed one for a line of its own).
+ */
+static int read_line(FILE *f, char *buf, size_t size, bool *too_long, bool *has_nul)
+{
+    size_t n = 0;
+    int c, any = 0;
+
+    *too_long = *has_nul = false;
+    buf[0] = '\0';
+    if (feof(f) || ferror(f))
+        return 0;
+    while ((c = getc(f)) != EOF) {
+        any = 1;
+        if (c == '\n')
+            break;
+        if (c == '\0')
+            *has_nul = true;
+        if (n + 1 < size)
+            buf[n++] = (char)c;
+        else
+            *too_long = true;
+    }
+    buf[n] = '\0';
+    return any;
+}
+
+/*
+ * Every key in file. A line that is not one is skipped, with a line on stderr
+ * (the journal), never the end of adbd: the file may be damaged, and a key it
+ * cannot read must not keep every other host out.
+ */
 static void read_keys(const char *file, struct listnode *list)
 {
     struct adb_public_key *key;
+    EVP_PKEY *pkey;
     FILE *f;
     char buf[MAX_PAYLOAD];
-    char *sep;
-    int ret;
+    const char *why;
+    bool too_long, has_nul;
+    int lineno = 0;
 
     f = fopen(file, "re");
     if (!f) {
@@ -97,31 +235,30 @@ static void read_keys(const char *file, struct listnode *list)
         return;
     }
 
-    while (fgets(buf, sizeof(buf), f)) {
-        /* Allocate 4 extra bytes to decode the base64 data in-place */
-        key = calloc(1, sizeof(*key) + 4);
-        if (!key) {
-            D("Can't malloc key\n");
-            break;
-        }
-
-        sep = strpbrk(buf, " \t");
-        if (sep)
-            *sep = '\0';
-
-        ret = b64_pton(buf, (u_char *)&key->key, sizeof(key->key) + 4);
-        if (ret != sizeof(key->key)) {
-            D("%s: Invalid base64 data ret=%d\n", file, ret);
-            free(key);
+    while (read_line(f, buf, sizeof(buf), &too_long, &has_nul)) {
+        lineno++;
+        if (too_long || has_nul) {
+            fprintf(stderr, "adbd: %s:%d: %s, skipped\n", file, lineno,
+                    too_long ? "line too long" : "not a line of text");
             continue;
         }
+        buf[strcspn(buf, " \t\r")] = '\0';
+        if (buf[0] == '\0')
+            continue;
 
-        if (key->key.len != RSANUMWORDS) {
-            D("%s: Invalid key len %d\n", file, key->key.len);
-            free(key);
+        why = "";
+        pkey = adb_key_decode(buf, &why);
+        if (!pkey) {
+            fprintf(stderr, "adbd: %s:%d: %s, skipped\n", file, lineno, why);
             continue;
         }
-
+        key = calloc(1, sizeof(*key));
+        if (!key) {
+            EVP_PKEY_free(pkey);
+            D("Can't malloc key\n");
+            break;
+        }
+        key->pkey = pkey;
         list_add_tail(list, &key->node);
     }
 
@@ -131,11 +268,14 @@ static void read_keys(const char *file, struct listnode *list)
 static void free_keys(struct listnode *list)
 {
     struct listnode *item;
+    struct adb_public_key *key;
 
     while (!list_empty(list)) {
         item = list_head(list);
         list_remove(item);
-        free(node_to_item(item, struct adb_public_key, node));
+        key = node_to_item(item, struct adb_public_key, node);
+        EVP_PKEY_free(key->pkey);
+        free(key);
     }
 }
 
@@ -176,14 +316,14 @@ int adb_auth_verify(void *token, void *sig, int siglen)
     struct listnode key_list;
     int ret = 0;
 
-    if (siglen != RSANUMBYTES)
+    if (siglen != ADB_KEY_BYTES)
         return 0;
 
     load_keys(&key_list);
 
     list_for_each(item, &key_list) {
         key = node_to_item(item, struct adb_public_key, node);
-        ret = RSA_verify(&key->key, sig, siglen, token, SHA_DIGEST_SIZE);
+        ret = adb_key_verify(key->pkey, sig, (size_t)siglen, token, SHA_DIGEST_SIZE);
         if (ret)
             break;
     }
-- 
2.53.0


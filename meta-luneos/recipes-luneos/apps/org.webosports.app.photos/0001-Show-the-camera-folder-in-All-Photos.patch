\ No newline at end of file
+	The photo library: the camera's DCIM folder, listed through the file manager service.
+	The camera writes a thumbnail for each photo to .thumbnails, named after the MD5 of the
+	photo's path, so the grid can show small images instead of decoding full-size ones.
+*/
+
+var photoLibrary = {
+	dir: "/media/internal/DCIM",
+	thumbDir: "/media/internal/.thumbnails",
+
+	// Asks the user to let the app read photos; passes true when allowed to callback.
+	askAccess: function(callback) {
+		this.call("luna://com.palm.mediapermissions/request", {rights: {read: ["com.palm.media.image.file:1"]}}, function(reply) {
+			callback(reply.returnValue === true && reply.isAllowed === true);
+		});
+	},
+
+	// Passes the photos in the camera folder, newest first, to callback.
+	list: function(callback) {
+		this.call("luna://org.webosports.service.filemanager/GetDirectories", {dir: this.dir}, function(reply) {
+			var names = reply.returnValue && reply.files ? reply.files.split(",") : [];
+			var photos = names.filter(function(name) {
+				return /\.(jpe?g|png)$/i.test(name);
+			}).sort().reverse();
+			callback(photos.map(function(name) {
+				var path = photoLibrary.dir + "/" + name;
+				return {path: path, thumb: photoLibrary.thumbDir + "/" + md5(path) + ".jpg"};
+			}));
+		});
+	},
+
+	// Calls a luna service through the webOS bridge and passes the parsed reply to callback.
+	call: function(uri, params, callback) {
+		var bridge = new PalmServiceBridge();
+		bridge.onservicecallback = function(msg) {
+			callback(JSON.parse(msg));
+		};
+		bridge.call(uri, JSON.stringify(params));
+	}
+};
+
+// MD5 (RFC 1321) of a string, as lowercase hex.
+function md5(str) {
+	var bytes = unescape(encodeURIComponent(str));
+	var words = [], i, j;
+	for (i = 0; i < bytes.length; i++) {
+		words[i >> 2] = (words[i >> 2] || 0) | (bytes.charCodeAt(i) << ((i % 4) * 8));
+	}
+	words[bytes.length >> 2] = (words[bytes.length >> 2] || 0) | (0x80 << ((bytes.length % 4) * 8));
+	while (words.length % 16 !== 14) {
+		words.push(0);
+	}
+	words.push(bytes.length * 8, 0);
+
+	var K = [], S = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];
+	for (i = 0; i < 64; i++) {
+		K[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 4294967296) | 0;
+	}
+
+	var a = 0x67452301, b = 0xefcdab89 | 0, c = 0x98badcfe | 0, d = 0x10325476;
+	for (i = 0; i < words.length; i += 16) {
+		var oa = a, ob = b, oc = c, od = d;
+		for (j = 0; j < 64; j++) {
+			var f, g;
+			if (j < 16) {
+				f = (b & c) | (~b & d);
+				g = j;
+			} else if (j < 32) {
+				f = (d & b) | (~d & c);
+				g = (5 * j + 1) % 16;
+			} else if (j < 48) {
+				f = b ^ c ^ d;
+				g = (3 * j + 5) % 16;
+			} else {
+				f = c ^ (b | ~d);
+				g = (7 * j) % 16;
+			}
+			var s = S[Math.floor(j / 16) * 4 + (j % 4)];
+			var x = (a + f + K[j] + words[i + g]) | 0;
+			a = d;
+			d = c;
+			c = b;
+			b = (b + ((x << s) | (x >>> (32 - s)))) | 0;
+		}
+		a = (a + oa) | 0;
+		b = (b + ob) | 0;
+		c = (c + oc) | 0;
+		d = (d + od) | 0;
+	}
+
+	function hex(n) {
+		var h = "";
+		for (var k = 0; k < 4; k++) {
+			h += ("0" + ((n >> (k * 8)) & 0xff).toString(16)).slice(-2);
+		}
+		return h;
+	}
+	return hex(a) + hex(b) + hex(c) + hex(d);
+}

+
+	create: function() {
+		this.inherited(arguments);
+		var self = this;
+		photoLibrary.askAccess(function(allowed) {
+			if (!allowed) {
+				self.addMessage("Photo access is off. Allow it when asked to see your photos.");
+				return;
+			}
+			self.loadPhotos();
+		});
+	},
+
+	addMessage: function(text) {
+		this.$.grid.createComponent({content: text, style: "color: lightgrey; padding: 10px;"}, {owner: this});
+		this.$.grid.render();
+	},
+
+	loadPhotos: function() {
+		var self = this;
+		photoLibrary.list(function(photos) {
+			if (photos.length === 0) {
+				self.addMessage("No photos in " + photoLibrary.dir);
+			}
+			photos.forEach(function(photo) {
+				self.$.grid.createComponent({
+					kind: "enyo.Image",
+					src: photo.thumb,
+					photoPath: photo.path,
+					style: "width: 110px; height: 110px; object-fit: cover; margin: 4px;",
+					onerror: "thumbFailed",
+					ontap: "showPhoto"
+				}, {owner: self});
+			});
+			self.$.grid.render();
+		});
+	},
+
+	// Photos without a camera thumbnail show a generic icon instead of decoding the original.
+	thumbFailed: function(inSender, inEvent) {
+		inSender.setSrc("assets/allphotos.png");
+	},
+
+	showPhoto: function(inSender, inEvent) {
+		this.$.photo.setSrc(inSender.photoPath);
+		this.$.viewer.show();
+		return true;
+	},
+
+	hideViewer: function(inSender, inEvent) {
+		this.$.viewer.hide();
+		this.$.photo.setSrc("");
 	},
 
 	grabberDragStart: function(inSender, inEvent) {

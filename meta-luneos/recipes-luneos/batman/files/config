[Settings]
# CPU core offlining: off. There is no audio-playing signal on LuneOS yet, so
# it would also offline cores during screen-off playback, and measured it only
# paid off on big.LITTLE.
OFFLINE=false
# CPU/GPU/devfreq powersave governors and the power HAL hints at screen off.
POWERSAVE=true
CHARGESAVE=true
BUSSAVE=true
GPUSAVE=true
# Bluetooth: off. Powering the adapter down behind the LuneOS Bluetooth
# service would leave the UI showing the wrong state.
BTSAVE=false
HYBRIS=true
# WiFi: off. wlan-suspend-mode owns WLAN screen-off handling (SETSUSPENDMODE,
# interface down); two owners would race.
WIFI=false

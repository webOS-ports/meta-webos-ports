[Settings]
# CPU core offlining: off. batman-luna now keeps cores online while audiod
# reports playback, but measured, offlining only paid off on big.LITTLE.
OFFLINE=false
# CPU/GPU/devfreq powersave governors and the power HAL hints at screen off.
POWERSAVE=true
CHARGESAVE=true
BUSSAVE=true
GPUSAVE=true
# Bluetooth: off. Powering the adapter down behind the LuneOS Bluetooth
# service would leave the UI showing the wrong state.
BTSAVE=false
HYBRIS=true
# Vendor knobs (MediaTek cpufreq/GED/perfmgr, Qualcomm LPM, UFS clock gating):
# low-power values at screen off, but no boost at screen on. The boost table
# sets Qualcomm lpm sleep_disabled=Y and MediaTek game mode for as long as the
# screen is on; with BOOST=false screen on puts back the pre-batman values.
TWEAKS=true
BOOST=false
# WiFi: off. wlan-suspend-mode owns WLAN screen-off handling (SETSUSPENDMODE,
# interface down); two owners would race.
WIFI=false

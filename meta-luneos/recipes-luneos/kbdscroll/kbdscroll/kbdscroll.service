[Unit]
Description=Scrolling and cursor movement from a capacitive keyboard or trackpad
Documentation=file:///etc/kbdscroll.conf
# No input devices at all: nothing to read and nothing to inject into.
ConditionPathExistsGlob=/dev/input/event*
# The contacts are injected into the touchscreen's own event stream, which the
# compositor has to have opened for them to arrive anywhere.
After=surface-manager.service
Wants=surface-manager.service

[Service]
Type=simple
ExecStart=/usr/sbin/kbdscroll
# A machine with no touch surface behind its keys exits 0 straight away and is
# meant to stay stopped; a surface that disappears under us exits non-zero and
# is meant to come back.
Restart=on-failure
RestartSec=3
# It follows a finger: late events are worse than none.
Nice=-5
OOMScoreAdjust=-100

[Install]
WantedBy=multi-user.target

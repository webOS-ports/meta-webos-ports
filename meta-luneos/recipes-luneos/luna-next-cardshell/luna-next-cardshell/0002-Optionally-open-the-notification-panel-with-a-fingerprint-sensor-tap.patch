     }
 
+    // Unlocked: any capture, matched or not, is a tap.
+    function handleFingerprintTap(response) {
+        var capture = response.identified === true ||
+                      (response.identified === false && response.finished === false);
+        if (capture) {
+            var now = Date.now();
+            if (now >= _fingerprintQuietUntil)
+                fingerprintTapped();
+            _fingerprintQuietUntil = Math.max(_fingerprintQuietUntil, now + 800);
+        }
+        // A match, a timeout and an abort all end the session.
+        if (response.identified === true || (response.identified === false && response.finished !== false)) {
+            _endIdentify();
+            if (fingerprintListening)
+                identifyRestartTimer.restart();
+        }
+    }
+
     function handleFingerprintError(message) {
         console.log("Fingerprint identify error: " + message.payload);
         _endIdentify();
-        if (fingerprintActive)
+        if (fingerprintListening)
             identifyRestartTimer.restart();
     }
 

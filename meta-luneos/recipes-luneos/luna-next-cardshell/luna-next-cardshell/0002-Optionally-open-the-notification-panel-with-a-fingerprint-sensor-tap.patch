@@ -114,6 +141,18 @@
 
     function handleFingerprintIdentify(message) {
         var response = JSON.parse(message.payload);
+        if (response.returnValue === false) {
+            // Refused - "Another fingerprint operation is in progress" - which
+            // is not a read. Ask again later; getStatus going idle is sooner.
+            _endIdentify();
+            if (fingerprintListening)
+                identifyRetryTimer.restart();
+            return;
+        }
+        if (!locked) {
+            handleFingerprintTap(response);
+            return;
+        }

[Unit]
Description=LuneOS long-press actions for hardware keys (camera key opens Camera)
# It launches apps through the application manager, so the bus has to be up.
After=ls-hubd.service
Wants=ls-hubd.service

[Service]
Type=simple
ExecStart=/usr/sbin/luneos-key-actions
# on-failure: with no configured key on any input device it exits 0 and stays
# down, which is the right answer on a device without a camera key. A lost input
# device exits 1 and comes back.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

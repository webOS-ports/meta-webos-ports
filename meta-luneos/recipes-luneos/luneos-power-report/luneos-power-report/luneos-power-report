#!/bin/sh
# luneos-power-report - one-shot power audit for a LuneOS device.
#
# Snapshots the kernel's power accounting, waits a measurement window,
# snapshots again, and prints ranked deltas plus a list of red flags. This is
# the standard first step of any battery complaint: run it with the screen
# off, attach the output.
#
#   luneos-power-report [window-seconds]     (default 60)
#
# Everything is best-effort: a missing interface prints nothing rather than
# failing, so the same script runs on every device and kernel generation.
# Timestamps use the monotonic/boottime clocks only - the wall clock cannot be
# trusted on a device whose RTC never got set.

WINDOW=${1:-60}
S=/tmp/luneos-power-report.$$
mkdir -p "$S" || exit 1
trap 'rm -rf "$S"' EXIT INT TERM

say()  { printf '%s\n' "$*"; }
hdr()  { printf '\n=== %s ===\n' "$*"; }
flag() { FLAGS="${FLAGS}FLAG: $*
"; }
FLAGS=

read_or() { cat "$1" 2>/dev/null || printf '%s' "${2:--}"; }

# CLOCK_BOOTTIME advances through suspend, CLOCK_MONOTONIC does not, so the
# difference is time spent suspended. /proc/uptime field 1 is boottime;
# /proc/timer_list's "now at N nsecs" is monotonic.
boottime()  { cut -d' ' -f1 /proc/uptime; }
monotonic() { awk '/^now at/ { printf "%.2f", $3 / 1000000000; exit }' /proc/timer_list 2>/dev/null; }

snap() {
    d=$1
    mkdir -p "$d"
    cat /proc/interrupts                       > "$d/interrupts"    2>/dev/null
    cat /sys/kernel/debug/wakeup_sources       > "$d/wakeup"        2>/dev/null
    ps -eo pid,time,comm                       > "$d/ps"            2>/dev/null
    for c in /sys/devices/system/cpu/cpu*/cpuidle/state*; do
        [ -d "$c" ] || continue
        printf '%s %s %s\n' "$c" "$(read_or "$c/usage" 0)" "$(read_or "$c/time" 0)"
    done > "$d/cpuidle"
    read_or /sys/class/power_supply/battery/charge_counter '' > "$d/charge"
    boottime  > "$d/boottime"
    monotonic > "$d/monotonic"
    grep -E 'success|^fail' /sys/kernel/debug/suspend_stats 2>/dev/null | head -n 2 > "$d/suspend"
    command -v journalctl >/dev/null 2>&1 &&
        journalctl -q -n 0 --show-cursor 2>/dev/null | sed -n 's/^-- cursor: *//p' > "$d/cursor"
}

say "luneos-power-report  window=${WINDOW}s"
say "device:  $(read_or /etc/hostname unknown) / $(uname -r)"
say "uptime:  $(uptime)"

snap "$S/a"
sleep "$WINDOW"
snap "$S/b"

# ---------------------------------------------------------------- suspend --
hdr "suspend health"
say "suspend_stats:   $(tr '\n' ' ' < "$S/b/suspend" 2>/dev/null)"
AUTOSLEEP=$(read_or /sys/power/autosleep)
MEMSLEEP=$(read_or /sys/power/mem_sleep)
LPM=$(read_or /sys/module/lpm_levels/parameters/sleep_disabled)
say "autosleep:       $AUTOSLEEP"
say "mem_sleep:       $MEMSLEEP"
[ "$LPM" != "-" ] && say "lpm sleep_disabled: $LPM"
say "wake_lock:       $(read_or /sys/power/wake_lock none)"

BT=$(cat "$S/b/boottime") MONO=$(cat "$S/b/monotonic")
if [ -n "$MONO" ]; then
    say "$(awk -v b="$BT" -v m="$MONO" 'BEGIN {
        d = b-m; if (d < 0) d = 0; printf "time suspended:  %.0fs of %.0fs since boot (%.1f%%)", d, b, d*100/b }')"
fi

SUCC=$(awk '/success/ { print $2 }' "$S/b/suspend" 2>/dev/null)
UPT=${BT%.*}
[ "${SUCC:-0}" = 0 ] && [ "${UPT:-0}" -gt 1800 ] &&
    flag "device has never suspended (success: 0 after ${UPT}s uptime)"
[ "$LPM" = "Y" ] && flag "SoC low-power modes disabled (lpm_levels sleep_disabled=Y)"
case "$MEMSLEEP" in *"[s2idle]"*deep*) flag "mem_sleep selects s2idle although deep is available" ;; esac

# ---------------------------------------------------------------- battery --
hdr "battery"
CUR=$(read_or /sys/class/power_supply/battery/current_now '')
say "capacity: $(read_or /sys/class/power_supply/battery/capacity)%  status: $(read_or /sys/class/power_supply/battery/status)"
[ -n "$CUR" ] && say "$(awk -v c="$CUR" 'BEGIN { printf "current_now: %.1f mA (sign convention is per-device)", c/1000 }')"
CA=$(cat "$S/a/charge") CB=$(cat "$S/b/charge")
if [ -n "$CA" ] && [ -n "$CB" ]; then
    say "$(awk -v a="$CA" -v b="$CB" -v w="$WINDOW" 'BEGIN {
        printf "charge_counter delta: %.2f mAh over window (avg %.1f mA)", (b-a)/1000, (b-a)*3.6/w }')"
fi
case "$(read_or /sys/class/power_supply/battery/status)" in
    Charging|Full) say "NOTE: on external power - drain figures are meaningless, measure on battery" ;;
esac

# ---------------------------------------------------------------- cpuidle --
hdr "cpuidle residency (delta over window)"
awk 'NR==FNR { a[$1]=$2; next }
     {
        split($1, p, "/"); cpu=p[6]; st=p[8]
        d = $2 - a[$1]
        key = st
        du[key] += d; tot[st] += $2
        if (cpu == "cpu0") c0[st] = d
     }
     END {
        for (s in du) printf "  %-7s entries this window: %-8d (all cores, total since boot: %d)\n", s, du[s], tot[s]
     }' "$S/a/cpuidle" "$S/b/cpuidle" | sort
DEEP=$(awk '$1 !~ /state0$/ { split($1,p,"/"); if (p[8] != "state0") sum += $2 } END { print sum+0 }' "$S/b/cpuidle")
[ "${DEEP:-0}" = 0 ] && [ -s "$S/b/cpuidle" ] &&
    flag "no CPU has ever entered a deep idle state (C1+ usage all zero)"

# ------------------------------------------------------------- interrupts --
hdr "top interrupt sources (delta over window)"
awk 'NR==FNR {
        n = 0; for (i=2; i<=NF && $i ~ /^[0-9]+$/; i++) n += $i
        a[$1] = n; next
     }
     {
        n = 0; name = ""
        for (i=2; i<=NF; i++) { if ($i ~ /^[0-9]+$/ && name == "") n += $i; else name = name " " $i }
        d = n - a[$1]
        if (d > 0) printf "%10d  %-6s %s\n", d, $1, name
     }' "$S/a/interrupts" "$S/b/interrupts" | sort -rn | head -n 8

# -------------------------------------------------------------- processes --
hdr "top CPU consumers (delta over window)"
awk 'function tosec(t,  n, p, s, i) {
        n = split(t, p, /[-:]/); s = 0
        for (i = 1; i <= n; i++) s = s * 60 + p[i]
        if (n == 4) s = p[1]*86400 + p[2]*3600 + p[3]*60 + p[4]
        return s
     }
     NR==FNR { if ($1 ~ /^[0-9]+$/) a[$1] = tosec($2); next }
     $1 ~ /^[0-9]+$/ {
        d = tosec($2) - a[$1]
        if (d > 0) printf "%6ds  pid %-6s %s\n", d, $1, $3
     }' "$S/a/ps" "$S/b/ps" | sort -rn | head -n 8

# ---------------------------------------------------------- wakeup sources --
hdr "wakeup sources most active this window"
awk -F'\t' 'NR==FNR { if (FNR > 1) a[$1] = $2; next }
     FNR > 1 && $1 in a {
        d = $2 - a[$1]
        if (d > 0) printf "%8d activations  %s\n", d, $1
     }' "$S/a/wakeup" "$S/b/wakeup" 2>/dev/null | sort -rn | head -n 6

# ----------------------------------------------------------------- journal --
if [ -s "$S/a/cursor" ] && command -v journalctl >/dev/null 2>&1; then
    hdr "journal traffic this window"
    journalctl -q --after-cursor="$(cat "$S/a/cursor")" 2>/dev/null > "$S/jdelta"
    LINES=$(wc -l < "$S/jdelta")
    say "$(awk -v l="$LINES" -v w="$WINDOW" 'BEGIN { printf "%d lines (%.1f/min)", l, l*60/w }')"
    [ "$LINES" -gt 0 ] && {
        say "most repeated:"
        awk '{ $1=$2=$3=$4="" ; print }' "$S/jdelta" | sort | uniq -c | sort -rn | head -n 5 | sed 's/^/  /'
    }
    RATE=$(awk -v l="$LINES" -v w="$WINDOW" 'BEGIN { print int(l*60/w) }')
    [ "$RATE" -gt 100 ] && flag "journal flooding at ${RATE} lines/min - find the looping service above"
    grep -c "starting service" "$S/jdelta" >/dev/null 2>&1 && {
        RESPAWN=$(grep -c "starting service" "$S/jdelta")
        [ "$RESPAWN" -gt 5 ] && flag "Android init started services ${RESPAWN}x this window - respawn loop"
    }
fi

# ------------------------------------------------------------- peripherals --
hdr "peripherals"
if command -v pactl >/dev/null 2>&1; then
    pactl list sinks short 2>/dev/null | awk '{ print "  sink " $2 ": " $NF }'
    pactl list sinks short 2>/dev/null | grep -q RUNNING &&
        flag "an audio sink is RUNNING - if nothing is audible, the ADSP/codec is being held awake"
fi
if command -v iw >/dev/null 2>&1; then
    PS=$(iw dev wlan0 get power_save 2>/dev/null)
    say "  wifi ${PS:-n/a}"
    case "$PS" in *off*) flag "wifi power save is off" ;; esac
fi
say "  backlight: $(read_or /sys/class/backlight/*/brightness -)"
LOAD=$(cut -d' ' -f1 /proc/loadavg)
say "  load average: $(cut -d' ' -f1-3 /proc/loadavg)"
awk -v l="$LOAD" 'BEGIN { exit !(l > 1.0) }' && [ "$(read_or /sys/class/backlight/*/brightness 0)" = "0" ] &&
    flag "load average ${LOAD} with the screen off - something is busy, see top CPU consumers"

# ------------------------------------------------------------------- flags --
hdr "red flags"
if [ -n "$FLAGS" ]; then printf '%s' "$FLAGS"; else say "none - nothing obviously wrong in this window"; fi
say ""
say "Ranked by impact: fix suspend-health flags first, then the top CPU"
say "consumer, then interrupt/journal floods, then peripheral holds."

[Unit]
Description=Keep the device awake while an ssh or adb session is attached
Documentation=file:///usr/sbin/luneos-remote-wakelock
# No kernel wakelocks (CONFIG_PM_WAKELOCKS unset): nothing to hold, and the
# script exits 0 at once anyway.
ConditionPathExists=/sys/power/wake_lock
After=android-tools-adbd.service sshd.socket

[Service]
Type=simple
ExecStart=/usr/sbin/luneos-remote-wakelock watch
# Never leave a lock behind when the watcher goes away.
ExecStopPost=/usr/sbin/luneos-remote-wakelock release
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target

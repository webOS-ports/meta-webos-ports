# tenderloin: /media/internal is webOS's FAT media partition. FAT has no owners,
# so "media" cannot take over .thumbnails there, and mount options cannot help:
# the partition is one superblock shared with /media/cryptofs and the Android
# container's /data, so a group-writable mount would hand all of those to it.
# Thumbnails live on the root filesystem instead, where chown works, and
# mediaindexer keeps running as "media".
[Unit]
Description=Thumbnails of the media indexer, off the FAT partition
DefaultDependencies=no
After=systemd-tmpfiles-setup.service
Conflicts=umount.target
Before=umount.target
RequiresMountsFor=/media/internal /var/luna/data

[Mount]
What=/var/luna/data/mediaindexer/thumbnails
Where=/media/internal/.thumbnails
Type=none
Options=bind,nosuid,nodev,noexec

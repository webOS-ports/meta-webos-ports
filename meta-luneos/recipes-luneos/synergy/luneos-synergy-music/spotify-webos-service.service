[Unit]
Description=Music+Spotify streaming backend (localhost HTTP on 127.0.0.1:8730)
# Not a bus service, but a client of one: at start-up it reads the provider accounts'
# credentials from com.palm.service.accounts through luna-send.
Requires=ls-hubd.service
After=ls-hubd.service network.target

[Service]
Type=simple
# Every token, secret, the librespot binary and its cache live here (service/paths.go, a
# compile-time constant). The backend writes into it but never creates it.
ExecStartPre=@BASE_BINDIR@/mkdir -p -m 0700 /media/cryptofs/spotify-webos
# Exec'd directly, as the upstart job does: a shell wrapper once left orphaned instances
# fighting over the port.
ExecStart=@SBINDIR@/spotify-webos-service -addr 127.0.0.1:8730
# The upstart job respawns it whatever the exit status; so does this.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

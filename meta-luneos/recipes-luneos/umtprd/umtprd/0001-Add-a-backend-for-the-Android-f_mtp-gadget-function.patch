 #include "mtp_operations.h"
 
 #include "usb_gadget_fct.h"
+#include "usb_f_mtp.h"
+
+// The rest of the data phase, after the part that came with the header.
+static uint32_t receive_f_mtp_data(mtp_ctx * ctx, MTP_PACKET_HEADER * hdr, int file, int first_size, int first_written)
+{
+	int64_t remaining;
+	int64_t expected;
+	off64_t offset;
+
+	if( first_size < 0 )
+		first_size = 0;
+
+	if( hdr->length == F_MTP_UNKNOWN_LENGTH )
+		remaining = F_MTP_UNKNOWN_LENGTH;
+	else
+		remaining = (int64_t)hdr->length - (int64_t)sizeof(MTP_PACKET_HEADER) - first_size;
+
+	// Hosts send objects of 4 GB and up with an unknown length.
+	expected = ( hdr->length == F_MTP_UNKNOWN_LENGTH ) ? (int64_t)ctx->SendObjInfoSize : remaining;
+
+	if( !first_written || ( expected > 0 && !f_mtp_has_room(file, expected) ) )
+	{
+		PRINT_WARN("SEND_OBJECT : no room for this object, discarding the data");
+
+		if( expected > 0 && f_mtp_discard(ctx->usb_ctx, expected) == -2 )
+			return MTP_RESPONSE_NO_RESPONSE;
+
+		return MTP_RESPONSE_STORAGE_FULL;
+	}
+
+	if( remaining <= 0 )
+		return MTP_RESPONSE_OK;
+
+	offset = lseek64(file, 0, SEEK_CUR);
+	if( offset < 0 )
+		return MTP_RESPONSE_GENERAL_ERROR;
+
+	switch( f_mtp_receive_file(ctx->usb_ctx, file, offset, remaining) )
+	{
+		case 0:
+			return MTP_RESPONSE_OK;
+		case -2:
+			return MTP_RESPONSE_NO_RESPONSE;
+		default:
+			return MTP_RESPONSE_INCOMPLETE_TRANSFER;
+	}
+}
 
 uint32_t mtp_op_SendObject(mtp_ctx * ctx,MTP_PACKET_HEADER * mtp_packet_hdr, int * size,uint32_t * ret_params, int * ret_params_size)
 {
@@ -49,6 +96,7 @@ uint32_t mtp_op_SendObject(mtp_ctx * ctx,MTP_PACKET_HEADER * mtp_packet_hdr, int
 	unsigned char * tmp_ptr;
 	int file;
 	int flags;
+	int first_written;
 	mode_t mode;
 	int sz;
 
@@ -107,16 +155,42 @@ uint32_t mtp_op_SendObject(mtp_ctx * ctx,MTP_PACKET_HEADER * mtp_packet_hdr, int
 						tmp_ptr = ((unsigned char*)mtp_packet_hdr) ;
 						tmp_ptr += sizeof(MTP_PACKET_HEADER);
 
+						first_written = 1;
+
 						if(sz > 0)
 						{
 							if( write(file, tmp_ptr, sz) != sz)
 							{
 								// TODO : Handle this error case properly
+								first_written = 0;
 							}
 
 							ctx->SendObjInfoSize -= sz;
 						}
 
+						if( ((usb_gadget *)ctx->usb_ctx)->f_mtp )
+						{
+							response_code = receive_f_mtp_data(ctx, mtp_packet_hdr, file, sz, first_written);
+
+							if( response_code == MTP_RESPONSE_STORAGE_FULL &&
+								mtp_packet_hdr->code != MTP_OPERATION_SEND_PARTIAL_OBJECT &&
+								ftruncate(file, 0) != 0 )
+							{
+								PRINT_WARN("SEND_OBJECT : can't empty the partial file");
+							}
+
+							entry->size = lseek64(file, 0, SEEK_END);
+
+							ctx->transferring_file_data = 0;
+
+							if( mtp_packet_hdr->code != MTP_OPERATION_SEND_PARTIAL_OBJECT )
+								entry_close(ctx->fs_db, entry);
+
+							pthread_mutex_unlock( &ctx->inotify_mutex );
+
+							return response_code;
+						}
+
 						tmp_ptr = ctx->rdbuffer2;
 						if( sz == ( ctx->usb_rd_buffer_max_size - sizeof(MTP_PACKET_HEADER) ) )
 						{

diff --git a/src/usb_f_mtp.c b/src/usb_f_mtp.c
new file mode 100644
index 0000000..cd8240b
--- /dev/null
+++ b/src/usb_f_mtp.c
@@ -0,0 +1,386 @@
+/*
+ * uMTP Responder
+ * Android f_mtp (/dev/mtp_usb) USB backend, for kernels with the android_usb
+ * gadget driver and no configfs or FunctionFS MTP function.
+ *
+ * uMTP Responder is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public
+ * License as published by the Free Software Foundation; either
+ * version 3.0 of the License, or (at your option) any later version.
+ *
+ * uMTP Responder is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
+ * General Public License version 3 for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with uMTP Responder; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
+ */
+
+/*
+ * The driver owns the USB function: descriptors, endpoints and the class
+ * requests, including Cancel. It differs from the FunctionFS endpoints in
+ * ways the MTP layer has to be shielded from:
+ *
+ * - One device node stands for all three endpoints.
+ * - A write() whose size is a multiple of the packet size is followed by a
+ *   ZLP, so each write() ends a USB transfer. A container has to go out in
+ *   one write(), and the MTP layer's own ZLP must not go out at all.
+ * - A received ZLP never reaches read().
+ * - A host Cancel surfaces as ECANCELED, not as a setup packet.
+ * - File data has to go through ioctls: only they keep one transfer open
+ *   across the driver's buffers.
+ * - The driver takes one ioctl at a time and fails any other with EBUSY, and
+ *   events come from the inotify thread, so ioctls are serialized here. An
+ *   event raised during a file transfer waits for the end of the transfer.
+ * - The driver has room for one event and waits 1 s for the host to read it.
+ *   Many hosts never read the interrupt endpoint, and each further event
+ *   would then hold up the next transfer for that second, so sending stops
+ *   for a while after a timeout.
+ * - MTP_RECEIVE_FILE cannot recover from a failed file write: it leaves a read
+ *   queued and the host still sending, so the rest of the file would be taken
+ *   for commands. Uploads that will not fit are discarded with read() instead,
+ *   and if a write fails anyway the only way back is a new USB session.
+ */
+
+#include "buildconf.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <sys/ioctl.h>
+#include <sys/statvfs.h>
+#include <time.h>
+
+#include "mtp.h"
+
+#include "usb_f_mtp.h"
+#include "usb_gadget_fct.h"
+
+#include "logs_out.h"
+
+// From the kernel's include/linux/usb/f_mtp.h, which is not exported to
+// userspace on the kernels this backend is for.
+struct mtp_file_range {
+	int fd;
+	int64_t offset;
+	int64_t length;
+	uint16_t command;
+	uint32_t transaction_id;
+};
+
+struct mtp_event {
+	size_t length;
+	void * data;
+};
+
+#define MTP_RECEIVE_FILE          _IOW('M', 1, struct mtp_file_range)
+#define MTP_SEND_EVENT            _IOW('M', 3, struct mtp_event)
+#define MTP_SEND_FILE_WITH_HEADER _IOW('M', 4, struct mtp_file_range)
+
+extern void* io_thread(void* arg);
+
+static void drop_pending(usb_gadget * ctx)
+{
+	free(ctx->f_mtp_pending);
+	ctx->f_mtp_pending = NULL;
+	ctx->f_mtp_pending_size = 0;
+	ctx->f_mtp_pending_fill = 0;
+}
+
+int f_mtp_open(usb_gadget * ctx, const char * path)
+{
+	ctx->usb_device = open(path, O_RDWR);
+	if (ctx->usb_device < 0)
+	{
+		PRINT_ERROR("f_mtp : Can't open %s : %s", path, strerror(errno));
+		return -1;
+	}
+
+	pthread_mutex_init(&ctx->f_mtp_ioctl_mutex, NULL);
+	ctx->f_mtp = 1;
+
+	return 0;
+}
+
+void f_mtp_close(usb_gadget * ctx)
+{
+	drop_pending(ctx);
+	pthread_mutex_destroy(&ctx->f_mtp_ioctl_mutex);
+}
+
+int f_mtp_read(usb_gadget * ctx, unsigned char * buffer, int maxsize)
+{
+	int ret;
+
+	if (!buffer || maxsize <= 0)
+		return -1;
+
+	if (maxsize > F_MTP_MAX_READ_SIZE)
+		maxsize = F_MTP_MAX_READ_SIZE;
+
+	// The previous operation is over if the host is sending again.
+	if (ctx->f_mtp_pending)
+	{
+		PRINT_WARN("f_mtp : dropping a partial container (%d of %d bytes)",
+			ctx->f_mtp_pending_fill, ctx->f_mtp_pending_size);
+		drop_pending(ctx);
+	}
+
+	ret = read(ctx->usb_device, buffer, maxsize);
+	if (ret < 0)
+	{
+		// Same as a ZLP for the callers: nothing to do, read again.
+		if (errno == ECANCELED || errno == EINTR)
+			return 0;
+
+		PRINT_DEBUG("f_mtp : read failed : %s", strerror(errno));
+	}
+
+	return ret;
+}
+
+static int send_container(usb_gadget * ctx, unsigned char * buffer, int size)
+{
+	int ret;
+
+	ret = write(ctx->usb_device, buffer, size);
+	if (ret < 0 && errno != ECANCELED)
+	{
+		PRINT_DEBUG("f_mtp : write failed : %s", strerror(errno));
+	}
+
+	return ret;
+}
+
+static int queue_container(usb_gadget * ctx, unsigned char * buffer, int size)
+{
+	uint32_t length;
+
+	if (!ctx->f_mtp_pending)
+	{
+		if (size < 4)
+			return send_container(ctx, buffer, size);
+
+		length = (uint32_t)buffer[0] |
+			 ((uint32_t)buffer[1] << 8) |
+			 ((uint32_t)buffer[2] << 16) |
+			 ((uint32_t)buffer[3] << 24);
+
+		if (length <= (uint32_t)size || length == 0xFFFFFFFF)
+			return send_container(ctx, buffer, size);
+
+		if (length > F_MTP_MAX_CONTAINER_SIZE)
+		{
+			PRINT_ERROR("f_mtp : %u byte container is too large", length);
+			return -1;
+		}
+
+		ctx->f_mtp_pending = malloc(length);
+		if (!ctx->f_mtp_pending)
+			return -1;
+
+		ctx->f_mtp_pending_size = length;
+		ctx->f_mtp_pending_fill = 0;
+	}
+
+	if (size > ctx->f_mtp_pending_size - ctx->f_mtp_pending_fill)
+	{
+		PRINT_ERROR("f_mtp : data past the end of the container");
+		drop_pending(ctx);
+		return -1;
+	}
+
+	memcpy(ctx->f_mtp_pending + ctx->f_mtp_pending_fill, buffer, size);
+	ctx->f_mtp_pending_fill += size;
+
+	if (ctx->f_mtp_pending_fill == ctx->f_mtp_pending_size)
+	{
+		int ret;
+
+		ret = send_container(ctx, ctx->f_mtp_pending, ctx->f_mtp_pending_size);
+		drop_pending(ctx);
+
+		return ret < 0 ? ret : size;
+	}
+
+	return size;
+}
+
+static int64_t now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+
+	return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+int f_mtp_write(usb_gadget * ctx, int channel, unsigned char * buffer, int size)
+{
+	struct mtp_event event;
+	int ret;
+	int err;
+
+	if (!buffer || size < 0)
+		return -1;
+
+	if (channel == EP_DESCRIPTOR_INT_IN)
+	{
+		event.length = size;
+		event.data = buffer;
+
+		pthread_mutex_lock(&ctx->f_mtp_ioctl_mutex);
+		if (now_ms() < ctx->f_mtp_events_resume_ms)
+		{
+			pthread_mutex_unlock(&ctx->f_mtp_ioctl_mutex);
+			return -1;
+		}
+
+		ret = ioctl(ctx->usb_device, MTP_SEND_EVENT, &event);
+		err = errno;
+		if (ret < 0 && err == ETIME)
+			ctx->f_mtp_events_resume_ms = now_ms() + F_MTP_EVENT_BACKOFF_MS;
+		pthread_mutex_unlock(&ctx->f_mtp_ioctl_mutex);
+
+		if (ret < 0)
+		{
+			PRINT_DEBUG("f_mtp : event not sent : %s", strerror(err));
+		}
+
+		return ret < 0 ? -1 : size;
+	}
+
+	if (channel != EP_DESCRIPTOR_IN)
+		return -1;
+
+	// The driver has sent any ZLP this transfer needed.
+	if (!size)
+		return 0;
+
+	return queue_container(ctx, buffer, size);
+}
+
+static int file_ioctl(usb_gadget * ctx, unsigned long request, struct mtp_file_range * range)
+{
+	int ret;
+	int err;
+
+	pthread_mutex_lock(&ctx->f_mtp_ioctl_mutex);
+	ret = ioctl(ctx->usb_device, request, range);
+	err = errno;
+	pthread_mutex_unlock(&ctx->f_mtp_ioctl_mutex);
+
+	if (ret == 0)
+		return 0;
+
+	if (err == ECANCELED)
+		return -2;
+
+	PRINT_ERROR("f_mtp : file transfer failed : %s", strerror(err));
+
+	errno = err;
+
+	return -1;
+}
+
+int f_mtp_send_file(usb_gadget * ctx, int fd, int64_t offset, int64_t length, uint16_t command, uint32_t tx_id)
+{
+	struct mtp_file_range range;
+
+	if (length < 0 || (uint64_t)length > F_MTP_MAX_SEND_SIZE)
+	{
+		PRINT_ERROR("f_mtp : can't send %lld bytes", (long long)length);
+		return -1;
+	}
+
+	memset(&range, 0, sizeof(range));
+	range.fd = fd;
+	range.offset = offset;
+	range.length = length;
+	range.command = command;
+	range.transaction_id = tx_id;
+
+	return file_ioctl(ctx, MTP_SEND_FILE_WITH_HEADER, &range);
+}
+
+int f_mtp_receive_file(usb_gadget * ctx, int fd, int64_t offset, int64_t length)
+{
+	struct mtp_file_range range;
+	int ret;
+
+	memset(&range, 0, sizeof(range));
+	range.fd = fd;
+	range.offset = offset;
+	range.length = length;
+
+	ret = file_ioctl(ctx, MTP_RECEIVE_FILE, &range);
+	if (ret == -1 && errno == EIO)
+	{
+		ctx->f_mtp_lost = 1;
+		ctx->stop = 1;
+	}
+
+	return ret;
+}
+
+int f_mtp_has_room(int fd, uint64_t needed)
+{
+	struct statvfs st;
+
+	// Say yes if the question can't be answered: the transfer may still work.
+	if (fstatvfs(fd, &st) != 0)
+		return 1;
+
+	return (uint64_t)st.f_bavail * st.f_frsize >= needed;
+}
+
+int f_mtp_discard(usb_gadget * ctx, int64_t length)
+{
+	unsigned char buffer[F_MTP_MAX_READ_SIZE];
+	int ret;
+
+	while (length > 0)
+	{
+		ret = read(ctx->usb_device, buffer, sizeof(buffer));
+		if (ret < 0)
+		{
+			if (errno == ECANCELED || errno == EINTR)
+				return -2;
+
+			return -1;
+		}
+
+		length -= ret;
+
+		// A short packet ends the data phase whatever the length said.
+		if (ret < (int)sizeof(buffer))
+			break;
+	}
+
+	return 0;
+}
+
+int handle_f_mtp(usb_gadget * ctx)
+{
+	ctx->stop = 0;
+
+	ctx->thread_not_started = pthread_create(&ctx->thread, NULL, io_thread, ctx);
+	if (ctx->thread_not_started)
+	{
+		PRINT_ERROR("f_mtp : Can't start the I/O thread");
+		return -1;
+	}
+
+	while (!ctx->stop && !shutdown_requested)
+		usleep(100 * 1000);
+
+	return ctx->f_mtp_lost ? -1 : 0;
+}

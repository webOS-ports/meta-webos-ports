+ */
+
+#ifndef _INC_USB_F_MTP_H_
+#define _INC_USB_F_MTP_H_
+
+#include <stdint.h>
+
+#include "usb_gadget.h"
+
+// Largest read() the driver accepts (MTP_BULK_BUFFER_SIZE).
+#define F_MTP_MAX_READ_SIZE 16384
+
+// Largest data container built in memory. Only containers written in several
+// pieces are buffered, which leaves object handle lists: 4 bytes per object.
+#define F_MTP_MAX_CONTAINER_SIZE (16 * 1024 * 1024)
+
+// The driver's container header holds a 32-bit length it does not clamp, so
+// it cannot send an object of 4 GB or more.
+#define F_MTP_MAX_SEND_SIZE (0xFFFFFFFFULL - 12)
+
+// How long events are dropped after the host left one unread.
+#define F_MTP_EVENT_BACKOFF_MS 30000
+
+// Length that tells MTP_RECEIVE_FILE to read up to the first short packet.
+#define F_MTP_UNKNOWN_LENGTH 0xFFFFFFFF
+
+int f_mtp_open(usb_gadget * ctx, const char * path);
+void f_mtp_close(usb_gadget * ctx);
+
+int f_mtp_read(usb_gadget * ctx, unsigned char * buffer, int maxsize);
+int f_mtp_write(usb_gadget * ctx, int channel, unsigned char * buffer, int size);
+
+// Both return 0 when done, -2 when the host cancelled and -1 on failure.
+int f_mtp_send_file(usb_gadget * ctx, int fd, int64_t offset, int64_t length, uint16_t command, uint32_t tx_id);
+int f_mtp_receive_file(usb_gadget * ctx, int fd, int64_t offset, int64_t length);
+// 1 if the filesystem holding fd can take needed more bytes.
+int f_mtp_has_room(int fd, uint64_t needed);
+// Reads and drops the rest of a data phase. 0, -2 if cancelled, -1 on error.
+int f_mtp_discard(usb_gadget * ctx, int64_t length);
+
+int handle_f_mtp(usb_gadget * ctx);
+
+#endif

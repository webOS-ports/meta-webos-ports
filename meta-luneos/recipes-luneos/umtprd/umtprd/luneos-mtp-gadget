#!/bin/sh
# luneos-mtp-gadget - set up / tear down the FunctionFS MTP function for umtprd
# inside a USB configfs gadget.
#
# Verbs (called by umtprd.service):
#   prepare - create a dedicated ffs.luneosmtp function and mount its
#             FunctionFS, so umtprd can open the endpoints. Does NOT touch the
#             UDC binding yet, so adb stays up while umtprd starts.
#   bind    - wait for umtprd to have written its descriptors (ep1 present),
#             then link the function into the active config and (re)bind the
#             UDC. Run after umtprd is up.
#   cleanup - unlink the function, restore the gadget to its previous state,
#             stop serving. Run after umtprd stops.
#
# Two device classes, detected at runtime:
#   halium   - the Android side already owns a configfs gadget bound to a UDC
#              (typically with ffs.adb). We add our OWN dedicated ffs instance
#              (never the contended android 'mtp' instance) beside it and
#              rebind; adb stays linked so it returns after the brief rebind.
#   mainline - no gadget is bound. We create a standalone gadget with just the
#              MTP function.
#
# Proven on sargo (Pixel 3a, halium): umtprd serves MTP browsable from
# kio-mtp/Dolphin with adb preserved.

CONFIGFS=/sys/kernel/config
GROOT=$CONFIGFS/usb_gadget
INST=luneosmtp                 # FunctionFS instance name
FUNC=ffs.$INST                 # configfs function dir name
FFS=/dev/ffs-$INST             # FunctionFS mount point
STATE=/run/luneos-mtp
OWN_GADGET=$GROOT/luneos       # gadget we create in mainline mode

log(){ logger -t luneos-mtp-gadget "$@"; }
die(){ log "$@"; exit 1; }

bind_udc(){   # $1=gadget dir, $2=udc name; retry — a transient EBUSY is common
    _g=$1; _u=$2
    for _ in 1 2 3 4 5; do
        echo "$_u" > "$_g/UDC" 2>/dev/null
        [ -n "$(cat "$_g/UDC" 2>/dev/null)" ] && return 0
        sleep 1
    done
    return 1
}

find_bound_gadget(){   # echo the gadget dir whose UDC is currently bound
    for g in "$GROOT"/*/; do
        [ -d "$g" ] || continue
        [ -n "$(cat "$g/UDC" 2>/dev/null)" ] && { echo "${g%/}"; return 0; }
    done
    return 1
}

first_config(){   # echo the first config dir of gadget $1
    for c in "$1"/configs/*/; do [ -d "$c" ] && { echo "${c%/}"; return 0; }; done
    return 1
}

do_prepare(){
    mkdir -p "$STATE"
    [ -d "$GROOT" ] || modprobe libcomposite 2>/dev/null
    mountpoint -q "$CONFIGFS" 2>/dev/null || mount -t configfs none "$CONFIGFS" 2>/dev/null
    [ -d "$GROOT" ] || die "no usb_gadget support"

    gadget=$(find_bound_gadget)
    if [ -n "$gadget" ]; then
        # halium: reuse the active gadget, add our function beside its own
        udc=$(cat "$gadget/UDC")
        echo halium > "$STATE/mode"
    else
        # mainline: build our own gadget
        echo mainline > "$STATE/mode"
        gadget=$OWN_GADGET
        mkdir -p "$gadget" || die "cannot create gadget"
        echo 0x18d1 > "$gadget/idVendor"
        echo 0x4ee1 > "$gadget/idProduct"   # a PID hosts recognise as MTP
        mkdir -p "$gadget/strings/0x409"
        serial=$(cat /etc/machine-id 2>/dev/null || echo 0123456789)
        echo "$serial" > "$gadget/strings/0x409/serialnumber"
        echo "LuneOS" > "$gadget/strings/0x409/manufacturer"
        echo "LuneOS Device" > "$gadget/strings/0x409/product"
        mkdir -p "$gadget/configs/c.1/strings/0x409"
        echo "MTP" > "$gadget/configs/c.1/strings/0x409/configuration"
        echo 500 > "$gadget/configs/c.1/MaxPower"
        udc=""; for u in /sys/class/udc/*; do [ -e "$u" ] && { udc=${u##*/}; break; }; done
    fi
    [ -n "$udc" ] || die "no UDC available"
    config=$(first_config "$gadget") || die "gadget has no config"

    printf '%s' "$gadget" > "$STATE/gadget"
    printf '%s' "$config" > "$STATE/config"
    printf '%s' "$udc"    > "$STATE/udc"

    [ -d "$gadget/functions/$FUNC" ] || mkdir "$gadget/functions/$FUNC" \
        || die "cannot create $FUNC"
    mkdir -p "$FFS"
    mountpoint -q "$FFS" 2>/dev/null || mount -t functionfs "$INST" "$FFS" \
        || die "cannot mount functionfs $INST"
    log "prepared $FUNC on $gadget (mode $(cat "$STATE/mode"), udc $udc)"
}

do_bind(){
    gadget=$(cat "$STATE/gadget" 2>/dev/null); config=$(cat "$STATE/config" 2>/dev/null)
    udc=$(cat "$STATE/udc" 2>/dev/null)
    [ -d "$gadget" ] || die "no prepared gadget"

    # umtprd must have opened ep0 and written descriptors (ep1 appears) or the
    # UDC bind fails with ENODEV.
    i=0; while [ "$i" -lt 40 ]; do [ -e "$FFS/ep1" ] && break; i=$((i+1)); sleep 0.25; done
    [ -e "$FFS/ep1" ] || die "umtprd endpoints not ready"

    echo "" > "$gadget/UDC" 2>/dev/null           # unbind to edit function list
    [ -e "$config/$FUNC" ] || ln -s "$gadget/functions/$FUNC" "$config/$FUNC"
    bind_udc "$gadget" "$udc" || die "failed to bind UDC $udc"
    log "bound $FUNC on $gadget -> $udc"
}

do_cleanup(){
    gadget=$(cat "$STATE/gadget" 2>/dev/null); config=$(cat "$STATE/config" 2>/dev/null)
    udc=$(cat "$STATE/udc" 2>/dev/null); mode=$(cat "$STATE/mode" 2>/dev/null)
    [ -d "$gadget" ] || { rm -rf "$STATE"; exit 0; }

    echo "" > "$gadget/UDC" 2>/dev/null
    rm -f "$config/$FUNC" 2>/dev/null
    mountpoint -q "$FFS" 2>/dev/null && umount "$FFS"
    rmdir "$gadget/functions/$FUNC" 2>/dev/null

    if [ "$mode" = mainline ]; then
        rmdir "$config/strings/0x409" "$config" 2>/dev/null
        rmdir "$gadget/strings/0x409" 2>/dev/null
        rmdir "$gadget" 2>/dev/null
    else
        # halium: rebind the original gadget (adb-only again)
        bind_udc "$gadget" "$udc" || log "warning: could not rebind $udc"
    fi
    rm -rf "$STATE"
    log "cleaned up $FUNC"
}

case "$1" in
    prepare) do_prepare ;;
    bind)    do_bind ;;
    cleanup) do_cleanup ;;
    *) echo "usage: $0 prepare|bind|cleanup" >&2; exit 2 ;;
esac

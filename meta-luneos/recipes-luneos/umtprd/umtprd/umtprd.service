[Unit]
Description=uMTP-Responder MTP daemon
Documentation=https://github.com/viveris/uMTP-Responder
# Started on demand via luna://com.palm.storage (storaged -> nyx msm_mtp)
RequiresMountsFor=/media/internal

[Service]
# umtprd sends READY=1 once its FunctionFS endpoints are set up; only then
# may the gadget be bound to the UDC (ExecStartPost).
Type=notify
ExecStartPre=/usr/bin/luneos-mtp-gadget prepare
ExecStart=/usr/bin/umtprd
ExecStartPost=/usr/bin/luneos-mtp-gadget bind
ExecStopPost=/usr/bin/luneos-mtp-gadget cleanup
# umtprd acts on SIGTERM at once ("initiating graceful shutdown", then
# "Disconnected"), but with a host still attached its process then does not
# exit, and systemd waited out its stop timeout (10 s on athena) before SIGKILL -
# leaving the gadget half torn down and File Transfer refusing to come back
# meanwhile.
TimeoutStopSec=2
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

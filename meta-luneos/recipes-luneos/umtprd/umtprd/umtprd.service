[Unit]
Description=uMTP-Responder MTP daemon
Documentation=https://github.com/viveris/uMTP-Responder
# Started on demand via luna://com.palm.storage (storaged -> nyx msm_mtp)
RequiresMountsFor=/media/internal

[Service]
# umtprd sends READY=1 once its FunctionFS endpoints are set up; only then
# may the gadget be bound to the UDC (ExecStartPost).
Type=notify
ExecStartPre=/usr/bin/luneos-mtp-gadget prepare
# prepare leaves UMTPRD_ARGS here when the device needs another config.
EnvironmentFile=-/run/luneos-mtp/umtprd.env
ExecStart=/usr/bin/umtprd $UMTPRD_ARGS
ExecStartPost=/usr/bin/luneos-mtp-gadget bind
ExecStopPost=/usr/bin/luneos-mtp-gadget cleanup
# umtprd used to hang on SIGTERM with a host attached (fixed in the inotify
# patch). If it ever hangs again, kill it soon: until it is gone the gadget is
# half torn down and File Transfer refuses to come back.
TimeoutStopSec=2
# On f_mtp it exits with an error when a write fails during an upload: only a
# new USB session, which the restart brings, gets the host back in step.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

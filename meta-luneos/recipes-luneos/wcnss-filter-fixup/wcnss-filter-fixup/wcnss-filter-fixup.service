[Unit]
Description=Stop redundant busy-looping wcnss_filter (tissot BT workaround)
After=android-system.service bluebinder.service
Wants=android-system.service

[Service]
Type=simple
ExecStart=/usr/sbin/tissot-wcnss-filter-fixup.sh
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target

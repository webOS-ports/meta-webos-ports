 src/plugin/editor.h           |  5 +++
 src/plugin/inputmethod.cpp    | 67 +++++++++++++++++++++++++++++++++++
 src/plugin/inputmethod.h      |  5 +++
 src/view/abstracttexteditor.h |  4 ++-
 5 files changed, 85 insertions(+), 1 deletion(-)


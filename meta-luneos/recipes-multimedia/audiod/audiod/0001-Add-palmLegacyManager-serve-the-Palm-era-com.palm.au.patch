+{
+    PalmLegacyManager *self = getPalmLegacyManagerInstance();
+    LSMessageJsonParser msg(message, SCHEMA_1(OPTIONAL(mute, boolean)));
+    if (!msg.parse(__FUNCTION__, sh))

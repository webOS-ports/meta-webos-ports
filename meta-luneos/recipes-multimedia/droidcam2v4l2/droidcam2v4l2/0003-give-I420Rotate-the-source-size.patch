From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sat, 14 Nov 2026 07:03:19 +0100
Subject: [PATCH] droidcam2v4l2: give I420Rotate() the source size

libyuv's I420Rotate() takes the width and height of the source. It was
given the destination size swapped, which equals the source size only
for 90 and 270 degrees. Cameras mounted at 0 or 180 degrees, as on
tablets, came out garbled when their preview was not square, and
libyuv read past the end of the source frame.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/droidcam2v4l2.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/src/droidcam2v4l2.c b/src/droidcam2v4l2.c
index a0893d3..c54b628 100644
--- a/src/droidcam2v4l2.c
+++ b/src/droidcam2v4l2.c
@@ -335,11 +335,9 @@ rotate_yuv420p(const void *src_y, const void *src_u, const void *src_v, void *ds
 {
     enum RotationMode mode;
     int dst_width = src_width;
-    int dst_height = src_height;
     switch (rotation) {
         case 90:
             dst_width = src_height;
-            dst_height = src_width;
             mode = kRotate90;
             break;
         case 180:
@@ -347,7 +345,6 @@ rotate_yuv420p(const void *src_y, const void *src_u, const void *src_v, void *ds
             break;
         case 270:
             dst_width = src_height;
-            dst_height = src_width;
             mode = kRotate270;
             break;
         default:
@@ -361,7 +358,7 @@ rotate_yuv420p(const void *src_y, const void *src_u, const void *src_v, void *ds
                (uint8_t *)dst_y, dst_width,
                (uint8_t *)dst_u, dst_width / 2,
                (uint8_t *)dst_v, dst_width / 2,
-               dst_height, dst_width, mode);
+               src_width, src_height, mode);
 }
 
 void

[Unit]
Description=Bridge Android (droidmedia) cameras to V4L2 via v4l2loopback
After=lxc@android.service
# The control node only exists once the v4l2loopback module is loaded. On a
# machine that has not added v4l2loopback (the kernel half is named per-machine,
# like wireguard-module), it never appears and this service is skipped cleanly.
ConditionPathExists=/dev/v4l2loopback
# Nothing to bridge on a device whose adaptation says deviceinfo_has_camera="false".
# luneos-device-config writes this flag (generators/37-camera-available), and the
# After= is what makes the check mean anything: measured on the mindphone, this
# unit started 6.6 s before the Android container's init, and the flag comes later
# still.
After=luneos-device-config.service
ConditionPathExists=!/run/luneos-device/no-camera
# Give up when droidmedia keeps reporting no cameras. Restart= covers a camera
# HAL that is still coming up, but without a limit the daemon was restarted every
# 5.75 s forever: measured on tenderloin, each attempt is about 0.7 s of CPU in
# the Android linker. The default limit (5 starts in 10 s) can never trip at that
# pace. This one stops after 12 attempts, about 68 s on tenderloin.
StartLimitIntervalSec=600
StartLimitBurst=12

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
# Belt-and-suspenders: the module is normally auto-loaded at boot
# (KERNEL_MODULE_AUTOLOAD), but load it here too in case it was not.
ExecStartPre=-/usr/sbin/modprobe v4l2loopback
ExecStart=/usr/sbin/droidcam2v4l2

[Install]
WantedBy=multi-user.target

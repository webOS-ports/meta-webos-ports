[Unit]
Description=Bridge Android (droidmedia) cameras to V4L2 via v4l2loopback
After=lxc@android.service
# The control node only exists once the v4l2loopback module is loaded. On a
# machine that has not added v4l2loopback (the kernel half is named per-machine,
# like wireguard-module), it never appears and this service is skipped cleanly.
ConditionPathExists=/dev/v4l2loopback

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
# Belt-and-suspenders: the module is normally auto-loaded at boot
# (KERNEL_MODULE_AUTOLOAD), but load it here too in case it was not.
ExecStartPre=-/usr/sbin/modprobe v4l2loopback
ExecStart=/usr/sbin/droidcam2v4l2

[Install]
WantedBy=multi-user.target

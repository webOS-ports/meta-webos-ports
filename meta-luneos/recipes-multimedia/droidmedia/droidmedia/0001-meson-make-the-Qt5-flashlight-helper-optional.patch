From 973626c974c624f42533be86f5edb86e53acb3f1 Mon Sep 17 00:00:00 2001
From: Herrie <claude.ai@herrie.org>
Date: Fri, 28 Aug 2026 08:04:25 +0200
Subject: [PATCH] meson: make the Qt5 flashlight helper optional

The flashlight helper needs Qt5 and libresourceqt5, which LuneOS (Qt6)
does not ship; the static library, headers and pkg-config file are all
we need.

Upstream-Status: Inappropriate [configuration]
---
 meson.build       | 2 ++
 meson_options.txt | 2 ++
 2 files changed, 4 insertions(+)
 create mode 100644 meson_options.txt

diff --git a/meson.build b/meson.build
index b39638c..ebc8aa5 100644
--- a/meson.build
+++ b/meson.build
@@ -32,6 +32,7 @@ droidmedia_headers = [
 install_headers(droidmedia_headers, subdir : meson.project_name())
 install_data('hybris.c', install_dir : get_option('datadir') / meson.project_name())
 
+if get_option('flashlight')
 qt5 = import('qt5')
 
 flashlight_qt_deps = [
@@ -68,6 +69,7 @@ install_data(
   'flashlight/org.sailfish.flashlight.provider.service',
   install_dir : get_option('datadir') / 'dbus-1' / 'services',
 )
+endif
 
 pkg = import('pkgconfig')
 pkg.generate(libdroidmedia_a,
diff --git a/meson_options.txt b/meson_options.txt
new file mode 100644
index 0000000..90c7684
--- /dev/null
+++ b/meson_options.txt
@@ -0,0 +1,2 @@
+option('flashlight', type : 'boolean', value : true,
+       description : 'Build the Qt5/D-Bus droidmedia-flashlight helper')
-- 
2.53.0


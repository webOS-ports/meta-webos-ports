From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] recorder: runtime encoder control glue

Wrappers for droid_media_recorder_request_sync_frame() and
droid_media_recorder_set_video_bitrate(), resolved on first use with
__try_resolve_sym() as droid_media_camera_set_torch_mode() is: the
symbols only exist in newer in-container libdroidmedia builds, and the
generated HYBRIS_WRAPPER macros abort on a missing symbol. A missing
symbol means the feature is unsupported and the wrappers return false,
so callers degrade gracefully against an older Android side.

This is the glibc half of the droidmedia branch luneos/encoder-control
(not sent upstream yet); the Android half has to be in the device's
Halium system image.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending

diff --git a/droidmediarecorder.h b/droidmediarecorder.h
index c0caae9..f3d1d4f 100644
--- a/droidmediarecorder.h
+++ b/droidmediarecorder.h
@@ -39,6 +39,11 @@ void droid_media_recorder_stop(DroidMediaRecorder *recorder);
 void droid_media_recorder_set_data_callbacks(DroidMediaRecorder *recorder,
 					     DroidMediaCodecDataCallbacks *cb, void *data);
 
+/* Runtime encoder control while recording (Android 13 and newer).
+ * Both return false when unsupported. */
+bool droid_media_recorder_request_sync_frame(DroidMediaRecorder *recorder);
+bool droid_media_recorder_set_video_bitrate(DroidMediaRecorder *recorder, int32_t bitrate);
+
 #ifdef __cplusplus
 };
 #endif
diff --git a/hybris.c b/hybris.c
index 8e90a4a..81067af 100644
--- a/hybris.c
+++ b/hybris.c
@@ -271,6 +271,34 @@ HYBRIS_WRAPPER_1_1(bool,DroidMediaRecorder*,droid_media_recorder_start);
 HYBRIS_WRAPPER_0_1(DroidMediaRecorder*,droid_media_recorder_stop);
 HYBRIS_WRAPPER_0_3(DroidMediaRecorder*,DroidMediaCodecDataCallbacks*,void*,droid_media_recorder_set_data_callbacks);
 
+/* Resolved on first use rather than through HYBRIS_WRAPPER, so that an
+ * older libdroidmedia without them reports false instead of aborting. */
+bool droid_media_recorder_request_sync_frame(DroidMediaRecorder *recorder)
+{
+  static bool (* _sym)(DroidMediaRecorder *) = NULL;
+  static bool attempted = false;
+
+  if (!attempted) {
+    _sym = __try_resolve_sym("droid_media_recorder_request_sync_frame");
+    attempted = true;
+  }
+
+  return _sym ? _sym(recorder) : false;
+}
+
+bool droid_media_recorder_set_video_bitrate(DroidMediaRecorder *recorder, int32_t bitrate)
+{
+  static bool (* _sym)(DroidMediaRecorder *, int32_t) = NULL;
+  static bool attempted = false;
+
+  if (!attempted) {
+    _sym = __try_resolve_sym("droid_media_recorder_set_video_bitrate");
+    attempted = true;
+  }
+
+  return _sym ? _sym(recorder, bitrate) : false;
+}
+
 bool droid_media_camera_set_torch_mode(bool enabled)
 {
   static bool (* _sym)(bool) = NULL;

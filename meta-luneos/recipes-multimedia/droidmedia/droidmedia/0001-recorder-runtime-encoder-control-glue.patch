From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] recorder: runtime encoder control glue

Wrappers for droid_media_recorder_request_sync_frame() and
droid_media_recorder_set_video_bitrate(), resolved tolerantly: the
symbols only exist in newer in-container libdroidmedia builds, and the
generated HYBRIS_WRAPPER macros abort on a missing symbol. Absent
symbol means the feature is unsupported and the wrappers return false,
so callers degrade gracefully against an older Android side.

Upstream-Status: Submitted [https://github.com/sailfishos/droidmedia]

diff -ru a/droidmediarecorder.h b/droidmediarecorder.h
--- a/droidmediarecorder.h
+++ b/droidmediarecorder.h
@@ -39,6 +39,11 @@
 void droid_media_recorder_set_data_callbacks(DroidMediaRecorder *recorder,
 					     DroidMediaCodecDataCallbacks *cb, void *data);
 
+/* Runtime encoder control while recording. Both return false when the
+ * in-container libdroidmedia does not support it. */
+bool droid_media_recorder_request_sync_frame(DroidMediaRecorder *recorder);
+bool droid_media_recorder_set_video_bitrate(DroidMediaRecorder *recorder, int32_t bitrate);
+
 #ifdef __cplusplus
 };
 #endif
diff -ru a/hybris.c b/hybris.c
--- a/hybris.c
+++ b/hybris.c
@@ -284,6 +284,41 @@
   return _sym ? _sym(enabled) : false;
 }
 
+/* Runtime encoder control. Hand-written rather than HYBRIS_WRAPPER: these
+ * symbols only exist in newer in-container libdroidmedia builds, and the
+ * generated wrappers abort on a missing symbol. Absent symbol = feature
+ * unsupported, report false. */
+static inline void *__resolve_sym_optional(const char *sym)
+{
+  if (!__handle) {
+    __load_library();
+  }
+
+  return _android_dlsym(__handle, sym);
+}
+
+bool droid_media_recorder_request_sync_frame(DroidMediaRecorder *recorder)
+{
+  static bool (* _sym)(DroidMediaRecorder *) = NULL;
+  static int _resolved = 0;
+  if (!_resolved) {
+    _sym = __resolve_sym_optional("droid_media_recorder_request_sync_frame");
+    _resolved = 1;
+  }
+  return _sym ? _sym(recorder) : false;
+}
+
+bool droid_media_recorder_set_video_bitrate(DroidMediaRecorder *recorder, int32_t bitrate)
+{
+  static bool (* _sym)(DroidMediaRecorder *, int32_t) = NULL;
+  static int _resolved = 0;
+  if (!_resolved) {
+    _sym = __resolve_sym_optional("droid_media_recorder_set_video_bitrate");
+    _resolved = 1;
+  }
+  return _sym ? _sym(recorder, bitrate) : false;
+}
+
 bool droid_media_init(void)
 {
   if (__init_glue()) {
Only in a: hybris.c.orig

[Unit]
Description=Expose gst-droid once the Android media services are up
# Ordered against android-system.service rather than a target.
#
# The obvious "After=android-system.service, Before=basic.target" is a cycle:
# android-system.service is a normal service, so DefaultDependencies gives it
# After=basic.target, and systemd resolves the loop by silently dropping this
# job - "Found ordering cycle on gst-droid-gate.service/start ... deleted to
# break ordering cycle". The gate then never runs and gst-droid stays hidden.
#
# Anchoring to the container service instead is also more honest: this is only
# meaningful once the container is up, and the compositor is already ordered
# after android-system.service, so sitting between the two puts the answer in
# place before anything initialises GStreamer. surface-manager-daemon is pulled
# from local-fs.target.wants, not basic.target, which is the other reason the
# target-based ordering did not do what it looked like it did.
After=android-system.service
Before=surface-manager-daemon.service
Before=mediaindexer.service
ConditionPathExists=/dev/hwbinder

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@BINDIR@/gst-droid-gate.sh
# binder-ping answers immediately or not at all; never hold up boot for it.
TimeoutStartSec=30s

[Install]
WantedBy=android-system.service

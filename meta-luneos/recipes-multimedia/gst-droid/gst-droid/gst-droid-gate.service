[Unit]
Description=Expose gst-droid once the Android media services are up
Documentation=man:gst-plugin-scanner(1)
# The check needs the container running, and the answer has to be in place
# before anything that initialises GStreamer starts. android-system.service is
# already pulled into basic.target.requires by the android-system recipe, so
# sitting between it and basic.target covers every service started later.
After=android-system.service
Before=basic.target
ConditionPathExists=/dev/hwbinder

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@BINDIR@/gst-droid-gate.sh
# binder-ping answers immediately or not at all; never hold up boot for it.
TimeoutStartSec=30s

[Install]
WantedBy=basic.target

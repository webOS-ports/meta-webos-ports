From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 19 Sep 2026 00:00:00 +0200
Subject: [PATCH] ipa: libipa: add a camera sensor helper for the GC02M2

The PineTab 2 front camera is a GalaxyCore GC02M2. Its driver exposes the
total gain in 1/64 steps with 0x40 as unity, splitting it into the sensor's
analogue step table and a digital remainder itself, so a linear helper with
a divisor of 64 describes it.

Upstream-Status: Pending

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
diff -ruN lh_a/src/ipa/libipa/camera_sensor_helper.cpp lh_b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp	2026-09-18 19:59:21.140874286 +0200
+++ b/src/ipa/libipa/camera_sensor_helper.cpp	2026-09-18 19:59:21.157860162 +0200
@@ -508,6 +508,21 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("gc05a2", CameraSensorHelperGc05a2)
 
+class CameraSensorHelperGc02m2 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperGc02m2()
+	{
+		/*
+		 * The driver exposes the total (analogue plus digital) gain
+		 * in 1/64 steps, 0x40 being unity, and splits it into the
+		 * sensor's analogue step table and digital remainder itself.
+		 */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 64 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("gc02m2", CameraSensorHelperGc02m2)
+
 class CameraSensorHelperGc08a3 : public CameraSensorHelper
 {
 public:

#!/bin/sh
# Generate a pulseaudio-modules-droid friendly copy of the Android audio
# policy configuration in /run/droid-audio.
#
# Many vendor HALs advertise 24-bit PCM on mix ports that
# pulseaudio-modules-droid cannot match. On the input side this leaves the
# droid card without a source and the device has no microphone; on the
# output side the sink is created but opening the stream fails with
# "Couldn't find compatible configuration for mix port", the sink stays
# SUSPENDED and the device is silent. sargo's vendor XML hits both: the
# input ports advertise AUDIO_FORMAT_PCM_8_24_BIT and the deep_buffer
# output port - the one the droid sink actually opens, the primary output
# being FAST - advertises AUDIO_FORMAT_PCM_24_BIT_PACKED and nothing else.
#
# The HALs accept 16-bit at stream-open time regardless (the XML is policy,
# not capability), so rewrite 24-bit PCM to 16-bit on every mix port and
# drop maxActiveCount="0" quirks from the input ports. Compressed output
# ports are untouched: their formats are MP3/AAC, not PCM.
#
# The vendor XML xi:includes sibling files with relative paths, so those
# are copied alongside. If anything fails the vendor file is copied
# verbatim, which keeps module-droid-card's behaviour identical to
# parsing it in place.

SRC=""
for d in /android/vendor/etc /vendor/etc /android/system/etc /odm/etc; do
    if [ -f "$d/audio_policy_configuration.xml" ]; then
        SRC="$d"
        break
    fi
done
[ -n "$SRC" ] || exit 0

OUT=/run/droid-audio
mkdir -p "$OUT"

# Included files referenced from the main XML.
for f in $(sed -n 's/.*xi:include href="\([^"]*\)".*/\1/p' \
        "$SRC/audio_policy_configuration.xml"); do
    [ -f "$SRC/$f" ] && cp "$SRC/$f" "$OUT/" 2>/dev/null
done

awk '
/<mixPort/ && /role="sink"/ { insink = 1 }
{
    gsub(/AUDIO_FORMAT_PCM_8_24_BIT/, "AUDIO_FORMAT_PCM_16_BIT")
    gsub(/AUDIO_FORMAT_PCM_24_BIT_PACKED/, "AUDIO_FORMAT_PCM_16_BIT")
}
insink {
    gsub(/ maxActiveCount="0"/, "")
}
/<\/mixPort>/ || (/<mixPort/ && /\/>/) { insink = 0 }
{ print }
' "$SRC/audio_policy_configuration.xml" > "$OUT/audio_policy_configuration.xml" \
    || cp "$SRC/audio_policy_configuration.xml" "$OUT/audio_policy_configuration.xml"

exit 0

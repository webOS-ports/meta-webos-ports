#!/usr/bin/pulseaudio -nF
#
# This file is part of PulseAudio.
#
# PulseAudio is free software; you can redistribute it and/or modify it
# under the terms of the GNU Lesser General Public License as published by
# the Free Software Foundation; either version 2 of the License, or
# (at your option) any later version.
#
# PulseAudio is distributed in the hope that it will be useful, but
# WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
# General Public License for more details.
#
# You should have received a copy of the GNU Lesser General Public License
# along with PulseAudio; if not, see <http://www.gnu.org/licenses/>.

# This startup script is used only if PulseAudio is started in system
# mode.

### Restore each card's last-used profile. Must be loaded before the modules
### that create cards below, because it acts on the card-new hook -- loaded
### afterwards it would never see the cards that already exist.
load-module module-card-restore

### Automatically load driver modules depending on the hardware available
###
### Left off deliberately. audiod owns device loading now: it reads
### audiod_internal_device_loading.json, tells module-palm-policy which sinks to
### create and by what name, and routes the virtual sinks onto them. udev-detect
### gets there first, loads module-alsa-card for every card it finds and takes
### the PCM with it, so audiod's own sink then fails to load and nothing is ever
### routed - silently, because a card was found and a sink does exist, just not
### the one anything is looking for.
###
### Turn these back on together with audiod, not instead of it, if a machine
### ever needs PulseAudio to do the discovering.
#.ifexists module-udev-detect.so
#load-module module-udev-detect
#.else
#### Use the static hardware detection module (for systems that lack udev/hal support)
#load-module module-detect
#.endif

### Load several protocols
.ifexists module-esound-protocol-unix.so
load-module module-esound-protocol-unix
.endif
load-module module-native-protocol-unix auth-anonymous=true

### LuneOS addition: Automatically load the Pulseaudio Droid
.ifexists module-droid-card.so
# /run/droid-audio is generated before startup (droid-audio-config-gen,
# ExecStartPre drop-in): a copy of the vendor audio policy XML with input
# mix ports rewritten to 16-bit so the droid source (microphone) can be
# created - many vendor HALs advertise only 24-bit input, which
# pulseaudio-modules-droid cannot match. Falls back to the plain load on
# machines where the generator produced nothing.
.ifexists /run/droid-audio/audio_policy_configuration.xml
load-module module-droid-card config=/run/droid-audio/audio_policy_configuration.xml
.else
load-module module-droid-card
.endif
# audiod and module-palm-policy route by sink name: audioRouter hands a name to
# setSoundOutputOnRange() and the policy module resolves it with pa_namereg_get().
# The name they expect is pcm_output, but module-droid-card names its sink
# sink.primary_output, so nothing resolves and every stream stays on the virtual
# sink it was created on - audible as complete silence with a perfectly healthy
# audio stack underneath.
#
# Alias it rather than renaming anything. The Android HAL has to keep the card
# on these devices - it is what sets up the mixer paths, so talking to the PCM
# directly tends to give you a device that opens and stays silent - and audiod
# is told the sink is preloaded so it never tries to load one itself.
.endif

# .nofail rather than .ifexists: this has to sit outside the block above because
# PulseAudio refuses to nest .ifexists ("Nested .ifexists ... not supported" and
# the daemon then fails to start at all), and on a machine with no droid card
# there is no sink.primary_output to remap, so the load is expected to fail
# there and must not be fatal.
.nofail
load-module module-remap-sink sink_name=pcm_output master=sink.primary_output remix=no
.fail

.ifexists module-droid-hidl.so
load-module module-droid-hidl
.endif
### LuneOS addition: Automatically load the Pulseaudio Droid

.ifexists module-dbus-protocol.so
load-module module-dbus-protocol
.endif

### Automatically restore the volume of streams and devices
load-module module-stream-restore
load-module module-device-restore

### Automatically restore the default sink/source when changed by the user
### during runtime
### NOTE: This should be loaded as early as possible so that subsequent modules
### that look up the default sink/source get the right value
load-module module-default-device-restore

### Make sure we always have a sink around, even if it is a null sink.
load-module module-always-sink

### Automatically suspend sinks/sources that become idle for too long
load-module module-suspend-on-idle

### Enable positioned event sounds
load-module module-position-event-sounds
### LuneOS addition: audiod's control socket.
### audiod does not mix through libpulse -- it drives PulseAudio over an abstract
### UNIX socket served by this module, and is inert without it. Guarded by
### .ifexists so this is a no-op on images that still use audio-service: the
### module is only installed as a runtime dependency of audiod.

.ifexists module-palm-policy.so
# Virtual sinks/sources module-palm-policy routes between. It resolves these by
# name and aborts if one is missing, so they must exist before it loads. Kept
# inside this guard so images built with audio-service instead of audiod, which
# has no policy module, do not carry 30 unused null sinks.
.include /etc/pulse/webos-virtual-devices.pa
load-module module-palm-policy
.endif

#!/usr/bin/pulseaudio -nF
#
# Virtual sinks and sources for module-palm-policy.
#
# module-palm-policy routes every stream to one of these by name and asserts the
# sink exists, e.g. in route_sink_input_new_hook_callback():
#
#     sink = pa_namereg_get(c, "pdefaultapp", PA_NAMEREG_SINK);
#     pa_assert(sink != NULL);
#
# so a missing entry is not a degraded route, it aborts pulseaudio. Any app
# starting playback without naming a sink lands on pdefaultapp, which meant no
# audio at all and a crash loop on first play.
#
# The first block comes from virtualsinkmap[]/virtualsourcemap[] in
# module-palm-policy-tables-default.h and must stay in step with them - webOS
# OSE's own palm/open_system.pa declares exactly the same 21 sinks and 9
# sources. The second block restores the phone-era devices Palm shipped in
# webOS 3.0.5 and OSE dropped on its way to being TV-only, because LuneOS
# targets phones.
#
# Include this from webos-system.pa *before* module-palm-policy is loaded;
# the module resolves these by name as soon as a stream appears.

### virtual sinks - applications write here, policy routes to hardware
load-module module-null-sink sink_name=palerts            sink_properties=device.description="alert\ virtual\ sink"
load-module module-null-sink sink_name=pfeedback          sink_properties=device.description="tactile\ feedback\ virtual\ sink"
load-module module-null-sink sink_name=pringtones         sink_properties=device.description="ringtone\ virtual\ sink"
load-module module-null-sink sink_name=pmedia             sink_properties=device.description="media\ sound\ virtual\ sink"
load-module module-null-sink sink_name=pdefaultapp        sink_properties=device.description="all\ other\ applications\ use\ this"
load-module module-null-sink sink_name=peffects           sink_properties=device.description="special\ effects\ virtual\ sink"
load-module module-null-sink sink_name=ptts               sink_properties=device.description="text\ to\ speech\ virtual\ sink"
load-module module-null-sink sink_name=pvoicerecognition  sink_properties=device.description="voice\ recognition\ virtual\ sink"
load-module module-null-sink sink_name=voipcall           sink_properties=device.description="voip\ call\ virtual\ sink"
load-module module-null-sink sink_name=btstream           sink_properties=device.description="bluetooth\ a2dp\ virtual\ sink"
load-module module-null-sink sink_name=btcall             sink_properties=device.description="bluetooth\ hfp\ call\ virtual\ sink"
load-module module-null-sink sink_name=fm                 sink_properties=device.description="fm\ radio\ virtual\ sink"
load-module module-null-sink sink_name=am                 sink_properties=device.description="am\ radio\ virtual\ sink"
load-module module-null-sink sink_name=hdradio            sink_properties=device.description="hd\ radio\ virtual\ sink"
load-module module-null-sink sink_name=radio              sink_properties=device.description="radio\ virtual\ sink"
load-module module-null-sink sink_name=default1           sink_properties=device.description="display\ 1\ default\ virtual\ sink"
load-module module-null-sink sink_name=tts1               sink_properties=device.description="display\ 1\ tts\ virtual\ sink"
load-module module-null-sink sink_name=voipcall1          sink_properties=device.description="display\ 1\ voip\ virtual\ sink"
load-module module-null-sink sink_name=default2           sink_properties=device.description="display\ 2\ default\ virtual\ sink"
load-module module-null-sink sink_name=tts2               sink_properties=device.description="display\ 2\ tts\ virtual\ sink"
load-module module-null-sink sink_name=voipcall2          sink_properties=device.description="display\ 2\ voip\ virtual\ sink"

### phone-era virtual sinks, kept from Palm's webOS 3.0.5 /etc/pulse/system.pa
#
# webOS OSE dropped these when it became TV-only; LuneOS is a phone OS and its
# legacy applications still open them by name. They are deliberately not in
# module-palm-policy's virtualsinkmap[], so the policy module will not route
# them - a stream landing here plays into a null sink until either audiod or
# the table learns about it. Present and inert beats absent.
load-module module-null-sink sink_name=pnotifications     sink_properties=device.description="notification\ virtual\ sink"
load-module module-null-sink sink_name=pflash             sink_properties=device.description="flash\ virtual\ sink"
load-module module-null-sink sink_name=pnavigation        sink_properties=device.description="navigation\ services\ virtual\ sink"
load-module module-null-sink sink_name=pvoicedial         sink_properties=device.description="voice\ dialling\ prompts"
load-module module-null-sink sink_name=pvoip              sink_properties=device.description="voip\ virtual\ sink"
load-module module-null-sink sink_name=pDTMF              sink_properties=device.description="DTMF\ tone\ virtual\ sink"
load-module module-null-sink sink_name=pcalendar          sink_properties=device.description="calendar\ alert\ virtual\ sink"
load-module module-null-sink sink_name=palarm             sink_properties=device.description="alarm\ alert\ virtual\ sink"
load-module module-null-sink sink_name=pvvm               sink_properties=device.description="visual\ voice\ mail\ virtual\ sink"

### virtual sources - applications record from these
load-module module-null-source source_name=record            description="general recording virtual source"
load-module module-null-source source_name=btcallsource      description="bluetooth hfp call virtual source"
load-module module-null-source source_name=alexa             description="alexa virtual source"
load-module module-null-source source_name=webcall           description="web call virtual source"
load-module module-null-source source_name=voiceassistance   description="voice assistance virtual source"
load-module module-null-source source_name=webcall1          description="display 1 web call virtual source"
load-module module-null-source source_name=record1           description="display 1 recording virtual source"
load-module module-null-source source_name=alexa1            description="display 1 alexa virtual source"
load-module module-null-source source_name=webcall2          description="display 2 web call virtual source"

### phone-era virtual sources, kept from Palm's webOS 3.0.5, same reasoning as
### the phone-era sinks above
load-module module-null-source source_name=precord           description="general recording virtual source"
load-module module-null-source source_name=pvoipsource       description="voip virtual source"
load-module module-null-source source_name=pvoicedialsource  description="voice dial virtual source"

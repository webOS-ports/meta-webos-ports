From b9bb588ffbc4318392295db52bda6a2db5cc50a2 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <Github.com@herrie.org>
Date: Mon, 24 Aug 2026 09:41:59 +0200
Subject: [PATCH] modules: declare the PulseAudio version we build against

PulseAudio will not load a module unless the version the module declares
is exactly its own PACKAGE_VERSION:

    Module "module-droid-card.so" version (14.2.103) doesn't match the
    expected version (17.0).

The modules declare PACKAGE_VERSION, which here is this project's own
version - 14.2.x - and so never matches any PulseAudio at all. The rpm
packaging works around it by rewriting .tarball-version to
<pulseaudio major.minor>.<module version> before the build, which makes
PACKAGE_VERSION something like 17.0.103; that still is not equal to
17.0, and it also means the version the build reports depends on which
PulseAudio happens to be installed.

Take it from libpulse's pkg-config version instead, which is exactly
PulseAudio's PACKAGE_VERSION, and declare that. The project version is
left alone, so the .pc file and PACKAGE_VERSION keep their meaning.

pulseaudio-modules-droid-jb2q carries the same fix for its autotools
build ("module-droid-*: use PA_MAJORMINOR as PA_MODULE_VERSION").

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 meson.build                     | 5 +++++
 src/droid/module-droid-card.c   | 2 +-
 src/droid/module-droid-sink.c   | 2 +-
 src/droid/module-droid-source.c | 2 +-
 4 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/meson.build b/meson.build
index e66f676..ced5a79 100644
--- a/meson.build
+++ b/meson.build
@@ -22,6 +22,7 @@ hybris_dep = dependency('libhardware', version : '>= 0.1.0', required : true)
 hybris_common_dep = cc.find_library('hybris-common', required : true)
 ltdl_dep = cc.find_library('ltdl', required : true)
 pulsecore_dep = dependency('pulsecore', version : '>= 14.2', required : true)
+libpulse_dep = dependency('libpulse', version : '>= 14.2', required : true)
 udev_dep = dependency('libudev', required : true)
 evdev_dep = dependency('libevdev', version : '>= 1.0', required : true)
 
@@ -48,6 +49,10 @@ cdata.set_quoted('PACKAGE', meson.project_name())
 cdata.set_quoted('PACKAGE_NAME', meson.project_name())
 cdata.set_quoted('PACKAGE_VERSION', pa_version_str)
 cdata.set_quoted('VERSION', pa_version_str)
+# PulseAudio refuses to load a module whose declared version is not exactly
+# its own PACKAGE_VERSION, so a module has to advertise the version of the
+# PulseAudio it was built against, not this project's own version.
+cdata.set_quoted('PULSEAUDIO_PACKAGE_VERSION', libpulse_dep.version())
 
 # Atomic operations
 
diff --git a/src/droid/module-droid-card.c b/src/droid/module-droid-card.c
index beb81cc..d62e545 100644
--- a/src/droid/module-droid-card.c
+++ b/src/droid/module-droid-card.c
@@ -69,7 +69,7 @@
 
 PA_MODULE_AUTHOR("Juho Hämäläinen");
 PA_MODULE_DESCRIPTION("Droid card");
-PA_MODULE_VERSION(PACKAGE_VERSION);
+PA_MODULE_VERSION(PULSEAUDIO_PACKAGE_VERSION);
 PA_MODULE_USAGE(
         "card_name=<name for the card> "
         "sink_name=<name for the sink> "
diff --git a/src/droid/module-droid-sink.c b/src/droid/module-droid-sink.c
index 13546cd..51ce8a7 100644
--- a/src/droid/module-droid-sink.c
+++ b/src/droid/module-droid-sink.c
@@ -45,7 +45,7 @@ PA_MODULE_AUTHOR("Juho Hämäläinen");
 PA_MODULE_DESCRIPTION("Droid sink");
 PA_MODULE_USAGE("master_sink=<sink to connect to> "
                 "sink_name=<name of created sink>");
-PA_MODULE_VERSION(PACKAGE_VERSION);
+PA_MODULE_VERSION(PULSEAUDIO_PACKAGE_VERSION);
 
 static const char* const valid_modargs[] = {
     "config",
diff --git a/src/droid/module-droid-source.c b/src/droid/module-droid-source.c
index 6fda995..c8c23fc 100644
--- a/src/droid/module-droid-source.c
+++ b/src/droid/module-droid-source.c
@@ -44,7 +44,7 @@ PA_MODULE_AUTHOR("Juho Hämäläinen");
 PA_MODULE_DESCRIPTION("Droid source");
 PA_MODULE_USAGE("master_source=<source to connect to> "
                 "source_name=<name of created source>");
-PA_MODULE_VERSION(PACKAGE_VERSION);
+PA_MODULE_VERSION(PULSEAUDIO_PACKAGE_VERSION);
 
 static const char* const valid_modargs[] = {
     "config",

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Mon, 24 Aug 2026 00:00:00 +0000
Subject: [PATCH] conversion: accept space separated list values in XML configs

Parsing a vendor's audio_policy_configuration.xml can fail outright, leaving
PulseAudio with no droid card at all:

    conversion.c: [/vendor/etc/audio_policy_configuration.xml:33] Failed to
        parse flags (AUDIO_OUTPUT_FLAG_PRIMARY AUDIO_OUTPUT_FLAG_FAST)
    conversion.c: [/vendor/etc/audio_policy_configuration.xml:44] Bad sample
        rate value 44100 48000
    droid-config.c: Failed to parse any configuration.
    module.c: Failed to load module "module-droid-card"

Two separate causes, with the same root.

First, pa_conversion_parse_output_flags() and its input counterpart hardcode
"|" as the separator while being called from both config parsers. The legacy
audio_policy.conf does use '|', but the XML does not. Every other list-valued
parser already takes a "legacy" argument and calls value_separator(); the flag
parsers are the only ones that never did, so they gain it here.

Second, value_separator() assumed XML always uses a comma. It does not: flags=
has always been space separated, and samplingRates= and channelMasks= are space
separated on newer vendors while older ones use commas. Since pa_split() takes
a string delimiter rather than a character set, a file using the other
convention arrives as one long token and matches nothing.

Rather than track which attribute uses which separator on which platform
version, accept either - fold commas into spaces and split on space, skipping
the empty entries that repeated spaces produce. The legacy path is untouched.

This only shows up once a list carries more than one value, which is why a
Pixel 3a on its Android 11 vendor parsed fine and the same phone on its
Android 12L vendor did not.

Upstream-Status: Pending
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
diff -ruN ../pmd.orig/src/common/config-parser-legacy.c ./src/common/config-parser-legacy.c
--- a/src/common/config-parser-legacy.c	2023-01-07 01:35:43.000000000 +0100
+++ b/src/common/config-parser-legacy.c	2026-08-24 08:40:21.962950872 +0200
@@ -385,10 +385,10 @@
                         success = pa_conversion_parse_input_devices(filename, n, value, true, false, &input->devices);
                 } else if (pa_streq(v, FLAGS_TAG)) {
                     if (in_output)
-                        success = pa_conversion_parse_output_flags(filename, n, value, &output->flags);
+                        success = pa_conversion_parse_output_flags(filename, n, value, true, &output->flags);
                     else {
 #if AUDIO_API_VERSION_MAJ >= 3
-                        success = pa_conversion_parse_input_flags(filename, n, value, &input->flags);
+                        success = pa_conversion_parse_input_flags(filename, n, value, true, &input->flags);
 #else
                         pa_log("[%s:%u] failed to parse line - output flags inside input definition", filename, n);
                         success = false;
diff -ruN ../pmd.orig/src/common/config-parser-xml.c ./src/common/config-parser-xml.c
--- a/src/common/config-parser-xml.c	2023-01-07 01:35:43.000000000 +0100
+++ b/src/common/config-parser-xml.c	2026-08-24 08:40:21.963130672 +0200
@@ -709,8 +709,8 @@
     /* flags is not mandatory element attribute */
     if (get_element_attr(data, attributes, false, ATTRIBUTE_flags, &flags)) {
         if (!(pa_streq(p->role, PORT_TYPE_source) ?
-                pa_conversion_parse_output_flags(data->fn, data->lineno, flags, &p->flags)
-              : pa_conversion_parse_input_flags(data->fn, data->lineno, flags, &p->flags)))
+                pa_conversion_parse_output_flags(data->fn, data->lineno, flags, false, &p->flags)
+              : pa_conversion_parse_input_flags(data->fn, data->lineno, flags, false, &p->flags)))
             goto done;
     }
 
diff -ruN ../pmd.orig/src/common/conversion.c ./src/common/conversion.c
--- a/src/common/conversion.c	2023-01-07 01:35:43.000000000 +0100
+++ b/src/common/conversion.c	2026-08-24 08:41:36.783493045 +0200
@@ -55,7 +55,31 @@
 CONVERT_FUNC(output_channel);
 CONVERT_FUNC(input_channel);
 
-#define value_separator(legacy) (legacy ? "|" : ",")
+#define value_separator(legacy) (legacy ? "|" : " ")
+
+/* AOSP's XML separates list values with a space in some attributes and a comma
+ * in others, and which is which has moved across releases: flags= has always
+ * been space separated, while samplingRates= and channelMasks= are space
+ * separated on newer vendors and comma separated on older ones. pa_split()
+ * takes a string delimiter rather than a character set, so a file using the
+ * other convention parses as one long token and the whole config is rejected.
+ *
+ * Rather than track it per attribute and per platform version, accept either:
+ * fold commas into spaces and split on space. The legacy audio_policy.conf is
+ * left alone - it genuinely uses '|'. Caller frees the result if non-NULL. */
+static char *normalize_separators(const char *str, bool legacy) {
+    char *s;
+
+    if (legacy)
+        return NULL;
+
+    s = pa_xstrdup(str);
+    for (char *p = s; *p; p++) {
+        if (*p == ',')
+            *p = ' ';
+    }
+    return s;
+}
 
 static bool string_convert_num_to_str(const struct string_conversion *list, const uint32_t value, const char **to_str) {
     pa_assert(list);
@@ -253,6 +277,12 @@
     char *entry;
     char *unknown = NULL;
     const char *state = NULL;
+    char *normalized;
+
+    if ((normalized = normalize_separators(str, pa_streq(separator, "|")))) {
+        str = normalized;
+        separator = " ";
+    }
 
     pa_assert(table);
     pa_assert(separator);
@@ -266,6 +296,12 @@
     while ((entry = pa_split(str, separator, &state))) {
         uint32_t d = 0;
 
+        /* Repeated spaces yield empty entries; they are not values. */
+        if (!*entry) {
+            pa_xfree(entry);
+            continue;
+        }
+
         if (!string_convert_str_to_num(table, entry, &d)) {
             if (*unknown_entries) {
                 unknown = pa_sprintf_malloc("%s|%s", *unknown_entries, entry);
@@ -284,6 +320,8 @@
         pa_xfree(entry);
     }
 
+    pa_xfree(normalized);
+
     return count;
 }
 
@@ -330,9 +368,22 @@
     const char *state = NULL;
 
     uint32_t pos = 0;
-    while ((entry = pa_split(str, value_separator(legacy), &state))) {
+    char *normalized;
+    const char *separator = value_separator(legacy);
+
+    if ((normalized = normalize_separators(str, legacy))) {
+        str = normalized;
+        separator = " ";
+    }
+
+    while ((entry = pa_split(str, separator, &state))) {
         int32_t val;
 
+        if (!*entry) {
+            pa_xfree(entry);
+            continue;
+        }
+
 #if AUDIO_API_VERSION_MAJ >= 3
         if (pos == 0 && pa_streq(entry, "dynamic")) {
             sampling_rates[pos++] = (uint32_t) -1;
@@ -344,12 +395,14 @@
         if (pos == AUDIO_MAX_SAMPLING_RATES) {
             pa_log("[%s:%u] Too many sample rate entries (> %d)", fn, ln, AUDIO_MAX_SAMPLING_RATES);
             pa_xfree(entry);
+            pa_xfree(normalized);
             return false;
         }
 
         if (pa_atoi(entry, &val) < 0) {
             pa_log("[%s:%u] Bad sample rate value %s", fn, ln, entry);
             pa_xfree(entry);
+            pa_xfree(normalized);
             return false;
         }
 
@@ -361,6 +414,8 @@
 
     sampling_rates[pos] = 0;
 
+    pa_xfree(normalized);
+
     return true;
 }
 
@@ -495,7 +550,7 @@
 }
 
 bool pa_conversion_parse_output_flags(const char *fn, const unsigned ln,
-                                      const char *str, audio_output_flags_t *flags) {
+                                      const char *str, bool legacy, audio_output_flags_t *flags) {
     int count;
     char *unknown = NULL;
 
@@ -503,13 +558,13 @@
     pa_assert(str);
     pa_assert(flags);
 
-    count = pa_conversion_parse_list(CONV_STRING_OUTPUT_FLAG, "|", str, flags, &unknown);
+    count = pa_conversion_parse_list(CONV_STRING_OUTPUT_FLAG, value_separator(legacy), str, flags, &unknown);
 
     return check_and_log(fn, ln, "flags", count, str, unknown, false);
 }
 
 bool pa_conversion_parse_input_flags(const char *fn, const unsigned ln,
-                                     const char *str, uint32_t *flags) {
+                                     const char *str, bool legacy, uint32_t *flags) {
     int count;
     char *unknown = NULL;
 
@@ -517,7 +572,7 @@
     pa_assert(str);
     pa_assert(flags);
 
-    count = pa_conversion_parse_list(CONV_STRING_INPUT_FLAG, "|", str, flags, &unknown);
+    count = pa_conversion_parse_list(CONV_STRING_INPUT_FLAG, value_separator(legacy), str, flags, &unknown);
 
     return check_and_log(fn, ln, "flags", count, str, unknown, false);
 }
diff -ruN ../pmd.orig/src/common/include/droid/conversion.h ./src/common/include/droid/conversion.h
--- a/src/common/include/droid/conversion.h	2023-01-07 01:35:43.000000000 +0100
+++ b/src/common/include/droid/conversion.h	2026-08-24 08:40:21.962584168 +0200
@@ -105,9 +105,9 @@
                                        char *str, bool legacy, bool must_recognize_all,
                                        audio_devices_t *devices);
 bool pa_conversion_parse_output_flags(const char *fn, const unsigned ln,
-                                      const char *str, audio_output_flags_t *flags);
+                                      const char *str, bool legacy, audio_output_flags_t *flags);
 bool pa_conversion_parse_input_flags(const char *fn, const unsigned ln,
-                                     const char *str, uint32_t *flags);
+                                     const char *str, bool legacy, uint32_t *flags);
 bool pa_conversion_parse_version(const char *fn, const unsigned ln, const char *str, uint32_t *version);
 
 #endif

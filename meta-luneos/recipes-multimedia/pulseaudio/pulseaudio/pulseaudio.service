[Unit]
Description=meta-webos - "%n"

[Service]
BusName=org.pulseaudio.Server
OOMScoreAdjust=-500
ExecStartPre=/bin/sh -euc 'if test -x /usr/sbin/alsactl -a -f /var/lib/alsa/asound.state -a "`cat /var/lib/alsa/asound.state | wc -l`" -gt 1; then /usr/sbin/alsactl -f /var/lib/alsa/asound.state restore; fi'
# Run the LuneOS startup script rather than the stock /etc/pulse/system.pa that
# "pulseaudio --system" would otherwise pick up. pulseaudio-distro-conf ships a
# webos-system.pa -- that is where module-droid-card, module-droid-hidl,
# module-palm-policy and auth-anonymous live -- and without this nothing ever
# points the daemon at it, so all of it is dead config. The -nF spelling is
# what that file's own "#!/usr/bin/pulseaudio -nF" shebang expects: -n skips
# the default script, -F runs the named one.
# The audio HAL is a vendor library and needs the vendor's own copies of the
# VNDK libraries, not the ones a newer GSI ships in /system. Without this,
# module-droid-card cannot load its HAL at all on a system side newer than the
# vendor it runs over (LuneOS's Android 16-based halium_arm64 rootfs over
# bluejay's real Android 14 gs101 vendor) - the device would be silent with no
# further diagnostic. It is set per unit rather than globally because
# processes that use the newer side's own libraries, the compositor among
# them, need the opposite.
Environment=HYBRIS_PREFER_VNDK=1
ExecStart=/usr/bin/pulseaudio --system --resample-method=ffmpeg -nF /etc/pulse/webos-system.pa
Restart=on-failure
EnvironmentFile=-/etc/default/pulseaudio.conf


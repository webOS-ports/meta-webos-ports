[Unit]
Description=meta-webos - "%n"

[Service]
BusName=org.pulseaudio.Server
OOMScoreAdjust=-500
ExecStartPre=/bin/sh -euc 'if test -x /usr/sbin/alsactl -a -f /var/lib/alsa/asound.state -a "`cat /var/lib/alsa/asound.state | wc -l`" -gt 1; then /usr/sbin/alsactl -f /var/lib/alsa/asound.state restore; fi'
# Run the LuneOS startup script rather than the stock /etc/pulse/system.pa that
# "pulseaudio --system" would otherwise pick up. pulseaudio-distro-conf ships a
# per-machine webos-system.pa -- that is where module-droid-card,
# module-droid-hidl, module-palm-policy and auth-anonymous live -- and until now
# nothing ever pointed the daemon at it, so all of it was dead config. The -nF
# spelling is what those files' own "#!/usr/bin/pulseaudio -nF" shebang expects:
# -n skips the default script, -F runs the named one.
#
# The path is written out rather than taken from a variable: EnvironmentFile is
# optional (leading -), so a missing file would expand the variable to nothing
# and leave -F without an argument, and systemd has no syntax for a fallback
# value. The PULSE_SCRIPT variable that used to name this script has been dropped
# from pulseaudio-distro-conf; EnvironmentFile is kept only as an escape hatch for
# local overrides, and no LuneOS package ships that file any more.
ExecStart=/usr/bin/pulseaudio --system --resample-method=ffmpeg -nF /etc/pulse/webos-system.pa
Restart=on-failure
EnvironmentFile=-/etc/default/pulseaudio.conf


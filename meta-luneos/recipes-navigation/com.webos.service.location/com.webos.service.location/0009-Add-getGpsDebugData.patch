+nyx_error_t GPSNyxInterface::getDebugData(char *dest, size_t destLen) {
+    if (nullptr == mNyxGpsSystem || nullptr == dest || 0 == destLen)
+        return NYX_ERROR_INVALID_VALUE;
+
+    return nyx_gps_get_debug_data(mNyxGpsSystem, dest, destLen);
+}

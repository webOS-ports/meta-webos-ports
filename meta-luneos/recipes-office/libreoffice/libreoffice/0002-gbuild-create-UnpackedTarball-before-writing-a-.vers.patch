From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] gbuild: create UnpackedTarball/ before writing a .version file

The rule for $(WORKDIR)/UnpackedTarball/<name>.version writes the file but
does not depend on the directory existing. In a normal build something
else has made the directory by then; in the cross-toolset of a cross
build (workdir_for_build) the first external to get there is fast_float,
a header-only one, and the build stops:

  /bin/sh: 1: cannot create .../workdir_for_build/UnpackedTarball/
  fast_float.version: Directory nonexistent

Give the rule the same order-only .dir prerequisite the unpack rule has.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
--- a/solenv/gbuild/UnpackedTarball.mk
+++ b/solenv/gbuild/UnpackedTarball.mk
@@ -166,7 +166,7 @@
 $(dir $(call gb_UnpackedTarball_get_target,%)).dir :
 	$(if $(wildcard $(dir $@)),,mkdir -p $(dir $@))
 
-$(call gb_UnpackedTarball_get_version_target,%) : $(gb_Helper_PHONY)
+$(call gb_UnpackedTarball_get_version_target,%) : $(gb_Helper_PHONY) | $(dir $(call gb_UnpackedTarball_get_target,%)).dir
 	$(if $(and $(wildcard $@),$(filter $(UNPACKED_TARBALL),$(file < $@))),,\
 		printf $(UNPACKED_TARBALL) > $@)
 

     if (!self->cancel_client) {
         g_debug("No operation to cancel");
         return FALSE;
@@ -1107,6 +1268,14 @@ fingerprint_aidl_cleanup(BiomFingerprintAidl* self)
 
     self->available = FALSE;
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 22:12:13 +0100
Subject: [PATCH] fingerprint: survive a restarted Gatekeeper HAL in the HIDL
 backend

fingerprint_hidl_gatekeeper_delete_user() used the reply without
checking it. When the Gatekeeper HAL had been restarted since biomd
connected, the transaction on the dead remote failed, the response
struct was NULL and biomd crashed with SIGSEGV at the start of every
enrolment. Seen on the BraX3 (11 Nov 2026) after the HAL was restarted.

Check the transaction, the status and the response before using them,
and report only success: the caller does not need the reply data, and
the blob it used to return was never freed. Free the blob returned by
fingerprint_hidl_gatekeeper_enroll() too, which the caller also dropped.

Before an enrolment, get the Gatekeeper service again if the remote
object is dead, so a restarted HAL no longer needs a biomd restart.

gbinder_servicemanager_get_service_sync() returns autoreleased objects,
but both backends stored them without a reference and released them in
cleanup, which unrefs objects biomd never owned. Take references when
storing them. The first version of the reconnect released the old
remote the same way and crashed in g_object_unref().

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/fingerprint_binder_aidl.c |  6 ++-
 src/fingerprint_binder_hidl.c | 98 ++++++++++++++++++++++++++++-------
 2 files changed, 83 insertions(+), 21 deletions(-)

diff --git a/src/fingerprint_binder_aidl.c b/src/fingerprint_binder_aidl.c
index dedc07e..2581948 100644
--- a/src/fingerprint_binder_aidl.c
+++ b/src/fingerprint_binder_aidl.c
@@ -1018,7 +1018,8 @@ fingerprint_aidl_init(const FingerprintAidlCallbacks* callbacks, gpointer user_d
 
     self = g_new0(BiomFingerprintAidl, 1);
     self->sm = sm;
-    self->fingerprint_remote = fingerprint_remote;
+    /* get_service_sync() returns autoreleased objects; cleanup releases ours */
+    self->fingerprint_remote = gbinder_remote_object_ref(fingerprint_remote);
     self->available = FALSE;
 
     if (callbacks)
@@ -1058,7 +1059,8 @@ fingerprint_aidl_init(const FingerprintAidlCallbacks* callbacks, gpointer user_d
      * Gatekeeper is only needed to mint an enrollment token. A device without it
      * can still authenticate and remove, so this is not fatal.
      */
-    self->gatekeeper_remote = gbinder_servicemanager_get_service_sync(sm, GK_AIDL_SERVICE, NULL);
+    self->gatekeeper_remote = gbinder_remote_object_ref(
+        gbinder_servicemanager_get_service_sync(sm, GK_AIDL_SERVICE, NULL));
     if (self->gatekeeper_remote) {
         self->gatekeeper_client = gbinder_client_new(self->gatekeeper_remote, GK_AIDL);
     } else {
diff --git a/src/fingerprint_binder_hidl.c b/src/fingerprint_binder_hidl.c
index f3e812d..d377b69 100644
--- a/src/fingerprint_binder_hidl.c
+++ b/src/fingerprint_binder_hidl.c
@@ -751,6 +751,46 @@ fingerprint_hidl_gatekeeper_load_handle_file(guint32 uid, void** handle, guint32
     return success;
 }
 
+/*
+ * The Gatekeeper HAL may have been restarted since biomd connected (init
+ * restarts a crashed HAL, and so does anything that restarts the container's
+ * services). The old remote object is then dead and every transaction on it
+ * fails, so get the service again before using it.
+ */
+static gboolean
+fingerprint_hidl_gatekeeper_connect(BiomFingerprintHidl* self)
+{
+    GBinderRemoteObject* remote;
+    GBinderClient* client;
+
+    if (self->gatekeeper_client && self->gatekeeper_remote &&
+        !gbinder_remote_object_is_dead(self->gatekeeper_remote))
+        return TRUE;
+
+    g_message("Gatekeeper service went away, connecting again");
+
+    /* Autoreleased: take our own reference, released on replacement/cleanup */
+    remote = gbinder_remote_object_ref(
+        gbinder_servicemanager_get_service_sync(self->sm, GK_SERVICE, NULL));
+    if (!remote) {
+        g_warning("Failed to get gatekeeper remote service");
+        return FALSE;
+    }
+
+    client = gbinder_client_new(remote, GK);
+    if (!client) {
+        g_warning("Failed to create gatekeeper client");
+        gbinder_remote_object_unref(remote);
+        return FALSE;
+    }
+
+    gbinder_client_unref(self->gatekeeper_client);
+    gbinder_remote_object_unref(self->gatekeeper_remote);
+    self->gatekeeper_remote = remote;
+    self->gatekeeper_client = client;
+    return TRUE;
+}
+
 char*
 fingerprint_hidl_gatekeeper_enroll(BiomFingerprintHidl* self, guint32 uid, const char* password)
 {
@@ -897,7 +937,12 @@ cleanup:
     return success;
 }
 
-char*
+/*
+ * Best effort: the only caller clears the user before enrolling it afresh, and
+ * a failure here does not stop the enrolment. The reply carries no data worth
+ * returning, so only success is reported.
+ */
+static gboolean
 fingerprint_hidl_gatekeeper_delete_user(BiomFingerprintHidl* self, guint32 uid)
 {
     const gint gk_code = GK_DELETE_USER;
@@ -906,8 +951,8 @@ fingerprint_hidl_gatekeeper_delete_user(BiomFingerprintHidl* self, guint32 uid)
     GBinderReader reader;
     GBinderRemoteReply* reply;
     const GatekeeperResponse* gatekeeper_response;
-    gint32 status;
-    char* crypto_blob;
+    gint32 status = -1;
+    gboolean success = FALSE;
 
     /* deleteUser(uint32_t uid)
      *     generates (GatekeeperResponse response); */
@@ -916,26 +961,32 @@ fingerprint_hidl_gatekeeper_delete_user(BiomFingerprintHidl* self, guint32 uid)
     gbinder_writer_append_int32(&writer, uid);
 
     reply = gbinder_client_transact_sync_reply(self->gatekeeper_client, gk_code, req, &status);
-    gbinder_remote_reply_init_reader(reply, &reader);
-    gbinder_reader_read_int32(&reader, &status);
+    if (!reply || status != 0) {
+        g_warning("Gatekeeper delete user transaction failed: %d", status);
+        goto cleanup;
+    }
 
-    g_debug("Gatekeeper delete user status %d", status);
+    gbinder_remote_reply_init_reader(reply, &reader);
+    if (!gbinder_reader_read_int32(&reader, &status) || status != 0) {
+        g_warning("Gatekeeper delete user returned status %d", status);
+        goto cleanup;
+    }
 
     gatekeeper_response = gbinder_reader_read_hidl_struct(&reader, GatekeeperResponse);
-    g_debug("Gatekeeper delete user timeout: %d, gatekeeper status code: %d", gatekeeper_response->timeout, gatekeeper_response->code);
-
-    crypto_blob = g_malloc(gatekeeper_response->data.count + 1);
-    if (crypto_blob) {
-        memcpy(crypto_blob, gatekeeper_response->data.data.ptr, gatekeeper_response->data.count);
-        crypto_blob[gatekeeper_response->data.count] = '\0';
+    if (!gatekeeper_response) {
+        g_warning("Could not read gatekeeper delete user response");
+        goto cleanup;
     }
 
-    g_debug("Gatekeeper delete user data: %s", crypto_blob);
+    g_debug("Gatekeeper delete user timeout: %u, gatekeeper status code: %d",
+            gatekeeper_response->timeout, (gint32) gatekeeper_response->code);
+    /* GatekeeperStatusCode is signed: negative values are errors */
+    success = ((gint32) gatekeeper_response->code >= 0);
 
+cleanup:
     gbinder_local_request_unref(req);
     gbinder_remote_reply_unref(reply);
-
-    return crypto_blob;
+    return success;
 }
 
 BiomFingerprintHidl*
@@ -964,15 +1015,19 @@ fingerprint_hidl_init(const FingerprintHidlCallbacks* callbacks, gpointer user_d
     gatekeeper_remote = gbinder_servicemanager_get_service_sync(sm, GK_SERVICE, NULL);
     if (!gatekeeper_remote) {
         g_warning("Failed to get gatekeeper remote service");
-        gbinder_remote_object_unref(fingerprint_remote);
+        /* Autoreleased, not ours to unref */
         gbinder_servicemanager_unref(sm);
         return NULL;
     }
 
     self = g_new0(BiomFingerprintHidl, 1);
     self->sm = sm;
-    self->fingerprint_remote = fingerprint_remote;
-    self->gatekeeper_remote = gatekeeper_remote;
+    /*
+     * get_service_sync() returns autoreleased objects; take references, since
+     * fingerprint_hidl_cleanup() and the Gatekeeper reconnect release them.
+     */
+    self->fingerprint_remote = gbinder_remote_object_ref(fingerprint_remote);
+    self->gatekeeper_remote = gbinder_remote_object_ref(gatekeeper_remote);
     self->available = FALSE;
 
     if (callbacks)
@@ -1093,6 +1148,9 @@ fingerprint_hidl_perform_enrollment(BiomFingerprintHidl* self, const gchar* pass
         return FALSE;
     }
 
+    if (!fingerprint_hidl_gatekeeper_connect(self))
+        return FALSE;
+
     /* 69 bytes for hw_auth_token_t */
     auth_token = g_malloc(69);
     if (!auth_token) {
@@ -1103,7 +1161,9 @@ fingerprint_hidl_perform_enrollment(BiomFingerprintHidl* self, const gchar* pass
     if (!fingerprint_hidl_gatekeeper_load_handle_file(0 /* uid */, &handle, &handle_size)) {
         g_debug("No existing handle found, enrolling password first");
         fingerprint_hidl_gatekeeper_delete_user(self, 0 /* uid */);
-        fingerprint_hidl_gatekeeper_enroll(self, 0 /* uid */, password ? password : "default_password");
+        /* The handle is read back from the file it was saved to below. */
+        g_free(fingerprint_hidl_gatekeeper_enroll(self, 0 /* uid */,
+                                                  password ? password : "default_password"));
 
         if (!fingerprint_hidl_gatekeeper_load_handle_file(0 /* uid */, &handle, &handle_size)) {
             g_warning("Failed to load password handle after enrollment");
-- 
2.53.0


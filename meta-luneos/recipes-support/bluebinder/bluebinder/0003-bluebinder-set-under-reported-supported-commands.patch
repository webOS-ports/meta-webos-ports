From 4820c251cd1d4cdfa184bedf60d7774adcccbb6a Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <Github.com@herrie.org>
Date: Mon, 31 Aug 2026 15:01:55 +0200
Subject: [PATCH] Let a controller's under-reported supported commands be
 corrected

Read_Local_Supported_Commands is not just informational: the kernel keys
real behaviour off it. hci_init gates the LE event mask on it -

    if (hdev->commands[26] & 0x08) events[0] |= 0x02; /* LE Advertising Report */
    if (hdev->commands[26] & 0x10) events[0] |= 0x01; /* LE Connection Complete */

and likewise commands[27] for LE Connection Update Complete and LE Read
Remote Used Features Complete - so a controller that answers those commands
but forgets to claim them gets an LE event mask without the matching bits,
and then dutifully emits none of those events.

The MT6739 combo chip does exactly that: it claims 137 classic commands and
zeroes octets 25-28, the whole LE range. Every LE command it is sent returns
success and no LE meta event ever reaches the host, so LE discovery finds
nothing and LE connects time out while classic inquiry works.

Add BLUEBINDER_LOCAL_COMMANDS_SET, taking comma separated <octet>:<hex mask>
pairs that are ORed into the bitmap as the event passes through - the same
shape as the existing BLUEBINDER_LOCAL_FEATURES_MASK, which clears bits
rather than setting them. Unset, nothing changes.

For the MT6739 the setting is "26:18,27:24", which restores the four bits
that gate events only. Bits whose effect is to make the kernel issue further
commands are left to the porter to add deliberately.

Upstream-Status: Pending [not device specific; intended for mer-hybris]

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015GkgzGjSP937CGDY3S8j9X
---
 bluebinder.c | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/bluebinder.c b/bluebinder.c
index c6724d7..9c1b6d8 100644
--- a/bluebinder.c
+++ b/bluebinder.c
@@ -896,6 +896,8 @@ bluebinder_callbacks_transact(
 {
     static unsigned long long local_features_mask = 0;
     static unsigned long long local_ext_features_page_2_mask = 0;
+    static unsigned char local_commands_set[64] = { 0 };
+    static int local_commands_set_any = 0;
     static int env_gotten = 0;
     struct proxy *proxy = user_data;
     const char* iface = gbinder_remote_request_interface(req);
@@ -909,6 +911,26 @@ bluebinder_callbacks_transact(
         if (ext_value)
             local_ext_features_page_2_mask = strtoull(ext_value, 0, 16);
         fprintf(stderr, "Got BLUEBINDER_LOCAL_EXT_FEATURES_PAGE_2_MASK 0x%llx\n", local_ext_features_page_2_mask);
+        const char *cmds_value = getenv("BLUEBINDER_LOCAL_COMMANDS_SET");
+        if (cmds_value) {
+            /* Comma separated <octet>:<hex mask> pairs, e.g. "26:18". */
+            const char *p = cmds_value;
+            while (*p) {
+                char *end;
+                unsigned long octet = strtoul(p, &end, 10);
+                if (end == p || *end != ':')
+                    break;
+                unsigned long mask = strtoul(end + 1, &end, 16);
+                if (octet < sizeof(local_commands_set) && mask <= 0xff) {
+                    local_commands_set[octet] |= (unsigned char)mask;
+                    local_commands_set_any = 1;
+                    fprintf(stderr, "Got BLUEBINDER_LOCAL_COMMANDS_SET octet %lu |= 0x%02lx\n", octet, mask);
+                }
+                if (*end != ',')
+                    break;
+                p = end + 1;
+            }
+        }
         env_gotten = 1;
     }
 
@@ -1021,6 +1043,30 @@ bluebinder_callbacks_transact(
                 }
             }
 
+            if (local_commands_set_any) {
+                /* Command complete for HCI_Read_Local_Supported_Commands.
+                 *
+                 * Some controllers under-report here: they answer the command
+                 * fine but leave its bit clear, and the kernel keys real
+                 * behaviour off this bitmap rather than treating it as
+                 * informational. The MT6739 combo chip claims 137 classic
+                 * commands and zeroes octets 25-28, the entire LE range, so
+                 * hci_init leaves the matching bits out of the LE event mask
+                 * and the controller is then told to emit no LE meta events at
+                 * all - LE discovery finds nothing and LE connects time out, on
+                 * a chip whose LE commands every one return success. Let the
+                 * bits be put back.
+                 *
+                 * 3 bytes of event header, opcode and status, then 64 octets. */
+                if (packet[0] == HCI_EVENT_PKT && count >= 70 && packet[1] == 0x0e) {
+                    if (((packet[5] << 8) | packet[4]) == 0x1002) {
+                        for (int l = 0; l < 64; l++) {
+                            packet[7+l] |= local_commands_set[l];
+                        }
+                    }
+                }
+            }
+
             dev_write_packet(proxy, packet, count + 1);
 
             free(packet);
-- 

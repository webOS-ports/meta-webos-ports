From e1d580eb01a3eb6ed93fbc8b68def05fec5d9c4d Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Thu, 8 Oct 2026 15:53:02 +0200
Subject: [PATCH] bluebinder_post: read the address file through the
 container's root

ro.bt.bdaddr_path and ro.vendor.bt.bdaddr_path name a path inside the
Android container, but this script runs on the host. On a Halium host
that does not share the path, the container's root is at /android, and
the copy fails: on the Galaxy A3 (2015), whose address is in Samsung's
EFS (/efs/bluetooth/bt_addr, mounted at /android/efs on the host),

  cp: can't stat '/efs/bluetooth/bt_addr': No such file or directory
  Failed to copy /efs/bluetooth/bt_addr.

and the failing ExecStartPost stops bluebinder again right after it has
set up vhci. Fall back to /android<path> when the path itself does not
exist on the host.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending [not device specific; intended for mer-hybris]
---
 bluebinder_post.sh | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/bluebinder_post.sh b/bluebinder_post.sh
index dc889fd..a76d201 100644
--- a/bluebinder_post.sh
+++ b/bluebinder_post.sh
@@ -12,9 +12,19 @@ fi
 
 mkdir -p /var/lib/bluetooth
 
+# The properties name a path inside the Android container. Where the host does
+# not share that path, the container's root is mounted at /android.
+container_file() {
+    if [ -n "$1" ] && [ ! -e "$1" ] && [ -e "/android$1" ]; then
+        echo "/android$1"
+    else
+        echo "$1"
+    fi
+}
+
 # Getting address file from properties
-bt_addr_file=$(/usr/bin/getprop ro.bt.bdaddr_path)
-bt_addr_vendor_file=$(/usr/bin/getprop ro.vendor.bt.bdaddr_path)
+bt_addr_file=$(container_file "$(/usr/bin/getprop ro.bt.bdaddr_path)")
+bt_addr_vendor_file=$(container_file "$(/usr/bin/getprop ro.vendor.bt.bdaddr_path)")
 if [ "$bt_addr_file" != "" ]; then
     if ! cp $bt_addr_file /var/lib/bluetooth/board-address; then
         echo "Failed to copy $bt_addr_file."
-- 
2.53.0


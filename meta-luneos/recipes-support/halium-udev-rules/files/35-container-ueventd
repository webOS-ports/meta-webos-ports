#!/bin/sh
# Give the container's ueventd the vendor init's /dev permissions, as
# /odm/etc/ueventd.rc, before the container's init starts.
#
# The vendor tree is mounted by now (mount-android.sh runs before lxc-start),
# and the container's ueventd has not read its configuration yet. See
# halium-generate-udev-rules for why the container needs this.
#
# Never fails the container start: without the file the container comes up as
# it did before, only with late-loading modules' nodes root 0600.
/usr/bin/halium-generate-udev-rules --container-ueventd || true
exit 0

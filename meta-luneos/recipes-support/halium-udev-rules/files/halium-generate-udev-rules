#!/bin/sh
# Translate Android's ueventd device-permission rules into udev rules.
#
# Android assigns ownership of its device nodes through ueventd*.rc. Halium does
# not run ueventd, so without this those nodes are created root:root 0600 and
# every Android daemon that runs as a non-root user - which is most of them -
# silently fails to open the hardware it needs.
#
# This is the mechanism the rest of the Halium ecosystem already has; Droidian
# and UBports ship per-device rules generated the same way. Generating at boot
# from whatever the device actually mounts means one implementation covers every
# machine instead of a rules file per port.
#
# Concretely: mnld runs as uid gps, /dev/stpgps was root:root 0600, and it could
# never open the GPS channel - it emitted a burst of null NMEA, never searched,
# and died. /vendor/ueventd.rc had said "0660 gps gps" all along.

# Written persistently rather than to /run: the nodes this covers are created on
# demand, sometimes long after boot, and udev reads /etc/udev/rules.d at startup.
# Persisting means the rules are in force even on a boot where this service runs
# late or not at all, and regenerating each boot keeps them correct if the
# vendor partition is ever replaced.
OUT=/etc/udev/rules.d/70-android.rules
SRC="/ueventd.rc /ueventd.*.rc /vendor/ueventd.rc /vendor/ueventd.*.rc
     /system/etc/ueventd.rc /odm/ueventd.rc
     /var/lib/lxc/android/rootfs/ueventd.rc /var/lib/lxc/android/rootfs/ueventd.*.rc"

mkdir -p /etc/udev/rules.d

# Nodes already covered by another rules file are left strictly alone.
#
# LuneOS ships /etc/udev/rules.d/65-android.rules from udev-extraconf - a static
# generic list carried over from Canonical's lxc-android-config, 21 rules of
# common Android nodes. It is not generated per device, which is why it does not
# mention this platform's own nodes: MTK's /dev/stpgps among them.
#
# So this augments that file rather than replacing it, and must never restate a
# node the existing rules already handle. Emitting a competing value at a higher
# priority is not theoretical: a first version of this generated 34 rules on
# sargo, overriding its curated set, and the GNSS engine stopped producing NMEA
# altogether - 0 bytes where it had been emitting 69KB in 45 seconds. Removing
# the file restored it. Additive only.
COVERED=$(mktemp 2>/dev/null || echo /tmp/.hur_covered)
: > "$COVERED"
for existing in /lib/udev/rules.d/*.rules /etc/udev/rules.d/*.rules; do
    [ -e "$existing" ] || continue
    [ "$existing" = "$OUT" ] && continue
    sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$existing" >> "$COVERED" 2>/dev/null
done
sort -u "$COVERED" -o "$COVERED" 2>/dev/null

FOUND=""
for f in $SRC; do
    [ -f "$f" ] && FOUND="$FOUND $f"
done

if [ -z "$FOUND" ]; then
    echo "halium-udev-rules: no ueventd rc files found, nothing to translate" >&2
    exit 0
fi

{
    echo "# Generated from Android ueventd rules by halium-generate-udev-rules."
    echo "# Source:$FOUND"
    echo "# Do not edit; regenerated on every boot."

    # ueventd lines are: <path> <mode> <user> <group> [options]
    # Only /dev entries are ours; /sys entries use a different syntax and are
    # left alone. OWNER/GROUP/MODE are assignments, so a single '=' - the
    # pipeline in the Halium docs uses '==' there, which would quietly match
    # nothing instead of applying anything.
    cat $FOUND 2>/dev/null \
      | tr -d '\r' \
      | grep '^/dev/' \
      | awk '$2 != "" && $3 != "" && $4 != "" {
              path = $1
              sub(/^\/dev\//, "", path)
              # A trailing * in ueventd is a prefix match; KERNEL== globs the
              # same way, so the pattern carries over unchanged.
              printf "ACTION==\"add\", KERNEL==\"%s\", OWNER=\"%s\", GROUP=\"%s\", MODE=\"%s\"\n", path, $3, $4, $2
            }' \
      | sort -u \
      | while IFS= read -r rule; do
            k=$(printf '%s' "$rule" | sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p')
            grep -qxF "$k" "$COVERED" 2>/dev/null && continue
            printf '%s\n' "$rule"
        done
} > "$OUT"

rm -f "$COVERED"

COUNT=$(grep -c '^ACTION' "$OUT" 2>/dev/null)
if [ "${COUNT:-0}" -eq 0 ]; then
    rm -f "$OUT"
    echo "halium-udev-rules: existing rules already cover every node, nothing added"
    exit 0
fi
echo "halium-udev-rules: added $COUNT rules not covered elsewhere, to $OUT"

# Reload so the new file is in force for nodes created from here on - which is
# the case that matters, since these appear when a subsystem is first powered.
#
# Deliberately no "udevadm trigger --action=add": re-firing an add event for
# every device on a running system is far more invasive than it looks, and on
# sargo it stopped the GNSS engine producing NMEA even when the rules themselves
# changed nothing it used. Nodes that already exist keep their current
# ownership until the next boot, which is an acceptable trade for not disturbing
# a running system.
udevadm control --reload-rules 2>/dev/null

exit 0

#!/bin/sh
# Translate Android's ueventd device-permission rules into udev rules.
#
# Android assigns ownership of its device nodes through ueventd*.rc. Halium does
# not run ueventd, so without this those nodes are created root:root 0600 and
# every Android daemon that runs as a non-root user - which is most of them -
# silently fails to open the hardware it needs.
#
# This is the mechanism the rest of the Halium ecosystem already has; Droidian
# and UBports ship per-device rules generated the same way. Generating at boot
# from whatever the device actually mounts means one implementation covers every
# machine instead of a rules file per port.
#
# Concretely: mnld runs as uid gps, /dev/stpgps was root:root 0600, and it could
# never open the GPS channel - it emitted a burst of null NMEA, never searched,
# and died. /vendor/ueventd.rc had said "0660 gps gps" all along.

# Written persistently rather than to /run: the nodes this covers are created on
# demand, sometimes long after boot, and udev reads /etc/udev/rules.d at startup.
# Persisting means the rules are in force even on a boot where this service runs
# late or not at all, and regenerating each boot keeps them correct if the
# vendor partition is ever replaced.
OUT=/etc/udev/rules.d/70-android.rules

# --container-ueventd: write only the container's ueventd rules (see the end of
# this script), from the Android container's pre-start hook. That runs after
# mount-android.sh has mounted the vendor tree and before the container's init
# and ueventd start, which is the only window that works: a unit ordered before
# the container cannot read the vendor tree yet, because mounting it is part
# of starting the container.
MODE=udev
[ "${1:-}" = "--container-ueventd" ] && MODE=container
if [ "$MODE" = container ] && [ ! -e /vendor/build.prop ]; then
    echo "halium-udev-rules: vendor tree not mounted, leaving the container ueventd rules alone" >&2
    exit 0
fi

# In the order ueventd reads them, because the order decides (see below):
# the platform's file first, then the vendor's and the ODM's, then the
# per-hardware ones. Android 10 moved the vendor's and the ODM's files into
# etc/; older vendors keep them at the partition root, so both are listed. Only
# the root ones used to be, and on a vendor that has just the etc/ file - the
# BraX3's iodeOS 7.9, Android 16 - this read nothing but /system/etc/ueventd.rc:
# 7 rules instead of the vendor's 110, so every MediaTek modem node, the audio
# HAL's /dev/ccci_aud among them, stayed root:root 0600.
SRC="/system/etc/ueventd.rc /ueventd.rc
     /vendor/etc/ueventd.rc /vendor/ueventd.rc
     /odm/etc/ueventd.rc /odm/ueventd.rc
     /ueventd.*.rc /vendor/ueventd.*.rc
     /var/lib/lxc/android/rootfs/ueventd.rc /var/lib/lxc/android/rootfs/ueventd.*.rc"

[ "$MODE" = udev ] && mkdir -p /etc/udev/rules.d

# Wait for the Android tree, bounded.
#
# Ordering alone is not enough to guarantee it: the mount units are generated
# per device, their names differ, and on mindphone android-vendor.mount does not
# carry /android/vendor as its Where=, so RequiresMountsFor does not resolve to
# it. The unit then runs with only /system/etc/ueventd.rc visible and produces a
# partial set - 21 rules instead of 95, missing exactly the vendor nodes this
# exists for. Waiting for the file we actually need does not care what the mount
# is called.
#
# Not every vendor has the file, though: the TouchPad's, derived from its Halium
# 9 build, carries none, and the loop sat out its whole minute on every boot.
# build.prop is on every vendor partition, so once it is there the vendor tree
# is mounted and a missing ueventd.rc is not coming.
i=0
while [ "$MODE" = udev ] && [ $i -lt 60 ]; do
    [ -r /vendor/etc/ueventd.rc ] && break
    [ -r /vendor/ueventd.rc ] && break
    [ -e /vendor/build.prop ] && break
    sleep 1
    i=$((i + 1))
done

# Nodes already covered by another rules file are left strictly alone.
#
# LuneOS ships /etc/udev/rules.d/65-android.rules from udev-extraconf - a static
# generic list carried over from Canonical's lxc-android-config, 21 rules of
# common Android nodes. It is not generated per device, which is why it does not
# mention this platform's own nodes: MTK's /dev/stpgps among them.
#
# So this augments that file rather than replacing it, and must never restate a
# node the existing rules already handle. Emitting a competing value at a higher
# priority is not theoretical: a first version of this generated 34 rules on
# sargo, overriding its curated set, and the GNSS engine stopped producing NMEA
# altogether - 0 bytes where it had been emitting 69KB in 45 seconds. Removing
# the file restored it. Additive only.
COVERED=$(mktemp 2>/dev/null || echo /tmp/.hur_covered)
: > "$COVERED"
for existing in /lib/udev/rules.d/*.rules /etc/udev/rules.d/*.rules; do
    [ -e "$existing" ] || continue
    [ "$existing" = "$OUT" ] && continue
    sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p' "$existing" >> "$COVERED" 2>/dev/null
done
sort -u "$COVERED" -o "$COVERED" 2>/dev/null

# The patterns among them, one alternative per line, for the init rules below.
# Those name single nodes, which the host's rules often cover by a glob instead:
# 65-android.rules gives KERNEL=="video*" to system:camera 0777, and the BraX3's
# vendor init gives video0, video1 and video3 to media or camera, group system,
# 0660, which would have overridden it. Only rules that set OWNER, GROUP or
# MODE count: systemd's own rules match broad globs such as "vd*" and "md*" to
# name disks and RAID arrays, which says nothing about MediaTek's vdec-fmt or
# mdp_sync. A bare "*" matches every node and says nothing about any one of
# them either.
GLOBS=$(mktemp 2>/dev/null || echo /tmp/.hur_globs)
for existing in /lib/udev/rules.d/*.rules /etc/udev/rules.d/*.rules; do
    [ -e "$existing" ] || continue
    [ "$existing" = "$OUT" ] && continue
    grep -E '(OWNER|GROUP|MODE)=' "$existing" 2>/dev/null \
      | sed -n 's/.*KERNEL=="\([^"]*\)".*/\1/p'
done | tr '|' '\n' | grep '[][*?]' | grep -vx '\*' | sort -u > "$GLOBS"

# Drops every rule whose node another rules file already gives permissions to:
# by exact name always, by one of the patterns in $GLOBS as well when called
# with "globs". One awk process for the lot - a sed and a grep per rule took 7 s
# on the BraX3 under boot load, and the container now waits for this unit.
not_covered() {
    awk -v covered="$COVERED" -v globs="$GLOBS" -v useglobs="${1:-}" '
        # udev KERNEL== patterns are fnmatch globs; turn one into a regex.
        function g2r(p,    r, i, c) {
            r = "^"
            for (i = 1; i <= length(p); i++) {
                c = substr(p, i, 1)
                if (c == "*") r = r ".*"
                else if (c == "?") r = r "."
                else if (c == "[" && substr(p, i + 1, 1) == "!") { r = r "[^"; i++ }
                else if (c == "[" || c == "]") r = r c
                else if (index(".^$+(){}|\\", c)) r = r "\\" c
                else r = r c
            }
            return r "$"
        }
        BEGIN {
            while ((getline line < covered) > 0) cov[line] = 1
            close(covered)
            if (useglobs == "globs") {
                while ((getline line < globs) > 0) re[++nre] = g2r(line)
                close(globs)
            }
        }
        {
            k = $0
            sub(/.*KERNEL=="/, "", k)
            sub(/".*/, "", k)
            if (k in cov) next
            for (i = 1; i <= nre; i++)
                if (k ~ re[i]) next
            print
        }'
}

# The first line of the container ueventd rules this writes to
# /odm/etc/ueventd.rc (see below). That path is also one of the vendor files
# read here, so a file starting with this line is our own output from the last
# boot and is skipped: read back, its rules bypassed the glob check the init
# rules get.
ODMMARK="# Generated by halium-generate-udev-rules"

FOUND=""
for f in $SRC; do
    [ -f "$f" ] || continue
    head -n 1 "$f" 2>/dev/null | grep -qxF "$ODMMARK" && continue
    FOUND="$FOUND $f"
done

# Not every node is in ueventd.rc: vendors also chown and chmod nodes from their
# init scripts, and Halium runs those in the container, where the commands
# never reach the host's /dev. The BraX3's MediaTek vendor (iodeOS 7.9) gives
# only /dev/camera_eeprom* to the camera in ueventd.rc and sets kd_camera_hw,
# seninf and camera-isp/-mem/-dip/-fdvt to "system camera 0660" from
# /vendor/etc/init. Those stayed root:root 0600, camerahalserver (uid
# cameraserver) could not open the sensor driver, and the camera provider
# reported 0 devices, so there was no camera at all (measured 14 Nov 2026).
# Only the vendor's and the ODM's: those set up the hardware.
INITSRC="/vendor/etc/init/*.rc /vendor/etc/init/hw/*.rc
         /odm/etc/init/*.rc /odm/etc/init/hw/*.rc"
INITFOUND=""
for f in $INITSRC; do
    [ -f "$f" ] && INITFOUND="$INITFOUND $f"
done

if [ -z "$FOUND$INITFOUND" ]; then
    echo "halium-udev-rules: no ueventd or vendor init rc files found, nothing to translate" >&2
    rm -f "$COVERED" "$GLOBS"
    exit 0
fi

# The vendor init's chown and chmod of /dev nodes, one "name owner group mode"
# line per node, "-" for what it does not set.
#
# Only from the boot-time triggers, and only when the trigger is
# unconditional: a chown under "on property:..." or "on boot && ..." depends
# on state this cannot evaluate. Lines inside a service block are its options,
# not commands. Only direct children of /dev: init also chowns /dev/cpuset/*,
# /dev/socket/* and the like, which are not device nodes, and KERNEL== matches
# a node's name, not its path. The last chown and the last chmod of a node win,
# as they would in init.
INITPERMS=$(mktemp 2>/dev/null || echo /tmp/.hur_initperms)
[ -n "$INITFOUND" ] && cat $INITFOUND 2>/dev/null \
  | tr -d '\r' \
  | awk '
      { sub(/#.*/, "") }
      $1 == "on" {
          trig = (NF == 2 && $2 ~ /^(early-init|init|late-init|early-fs|fs|post-fs|late-fs|post-fs-data|early-boot|boot)$/)
          next
      }
      $1 == "service" || $1 == "import" { trig = 0; next }
      !trig { next }
      $1 == "chown" && (NF == 3 || NF == 4) {
          path = $NF
          if (path !~ /^\/dev\/[^\/*]+$/) next
          n = substr(path, 6)
          own[n] = $2
          grp[n] = (NF == 4) ? $3 : ""
          if (!(n in seen)) { seen[n] = 1; order[++c] = n }
      }
      $1 == "chmod" && NF == 3 && $2 ~ /^[0-7]+$/ {
          path = $3
          if (path !~ /^\/dev\/[^\/*]+$/) next
          n = substr(path, 6)
          mode[n] = $2
          if (!(n in seen)) { seen[n] = 1; order[++c] = n }
      }
      END {
          for (i = 1; i <= c; i++) {
              n = order[i]
              print n, (own[n] != "" ? own[n] : "-"), (grp[n] != "" ? grp[n] : "-"), \
                    (mode[n] != "" ? mode[n] : "-")
          }
      }' > "$INITPERMS"

# --container-ueventd: the same, for the container's own ueventd, and nothing
# else.
#
# The container has a /dev of its own (a tmpfs, lxc.autodev = 0) that its
# ueventd fills, so the udev rules below never reach it. Init's chown and
# chmod only fix the nodes that exist when init runs them, and on the BraX3
# the camera_isp, camera_mem and camera_dip modules load about ten seconds
# after the container starts: their nodes were created root 0600 and stayed
# that way, so the cameras enumerated but startCamera failed (errno 13 on
# /dev/camera-mem in the HAL) on some boots and not others.
#
# The platform's /system/etc/ueventd.rc imports /odm/etc/ueventd.rc, and the
# container's /odm is the host's, bind-mounted by the LXC config. A rule there
# applies whenever a node appears. It goes after the vendor's ueventd.rc in
# the import order, so it wins as init's chown would. The legacy
# /odm/ueventd.rc must never be created: with a first API level of 33 or
# later, ueventd aborts when it finds one.
#
# Written only to a writable /odm without an ueventd.rc of its own: a real ODM
# partition's file is left alone.
if [ "$MODE" = container ]; then
    ODMRC=/odm/etc/ueventd.rc
    if [ -d /odm ] && [ -w /odm ] && { [ ! -e "$ODMRC" ] || head -n 1 "$ODMRC" | grep -qxF "$ODMMARK"; }; then
        if [ -s "$INITPERMS" ]; then
            mkdir -p /odm/etc
            {
                echo "$ODMMARK"
                echo "# from the vendor init's chown and chmod of /dev nodes:$INITFOUND"
                echo "# Do not edit; regenerated each time the container starts."
                # ueventd defaults: a node nobody gives an owner or a mode is
                # root:root 0600, which is what init's chown or chmod alone leaves.
                awk '{ printf "/dev/%s %s %s %s\n", $1, ($4 != "-" ? $4 : "0600"),
                           ($2 != "-" ? $2 : "root"), ($3 != "-" ? $3 : "root") }' "$INITPERMS"
            } > "$ODMRC.tmp" && mv -f "$ODMRC.tmp" "$ODMRC"
            echo "halium-udev-rules: wrote $(grep -c '^/dev/' "$ODMRC") container ueventd rules to $ODMRC"
        else
            rm -f "$ODMRC"
        fi
    fi
    rm -f "$COVERED" "$GLOBS" "$INITPERMS"
    exit 0
fi

{
    echo "# Generated from Android ueventd rules by halium-generate-udev-rules."
    echo "# Source:$FOUND"
    [ -n "$INITFOUND" ] && echo "# Init:$INITFOUND"
    echo "# Do not edit; regenerated on every boot."

    # ueventd lines are: <path> <mode> <user> <group> [options]
    # Only /dev entries are ours; /sys entries use a different syntax and are
    # left alone. OWNER/GROUP/MODE are assignments, so a single '=' - the
    # pipeline in the Halium docs uses '==' there, which would quietly match
    # nothing instead of applying anything.
    #
    # Kept in file order, with exact repeats dropped: ueventd applies the last
    # rule that matches a node, and udev's later assignments override earlier
    # ones the same way, so the order carries the meaning over. Sorting did
    # not: it put "foo" ahead of "foo*", the wildcard then won, and which of
    # two files' rules applied came down to the alphabet. The BraX3's vendor
    # gives /dev/ccci* to radio and then /dev/ccci_aud to audio.
    [ -n "$FOUND" ] && cat $FOUND 2>/dev/null \
      | tr -d '\r' \
      | grep '^/dev/' \
      | awk '$2 != "" && $3 != "" && $4 != "" {
              path = $1
              sub(/^\/dev\//, "", path)
              # A trailing * in ueventd is a prefix match; KERNEL== globs the
              # same way, so the pattern carries over unchanged.
              printf "ACTION==\"add\", KERNEL==\"%s\", OWNER=\"%s\", GROUP=\"%s\", MODE=\"%s\"\n", path, $3, $4, $2
            }' \
      | awk '!seen[$0]++' \
      | not_covered

    # Init's chown and chmod come after ueventd's, as on Android, where init
    # runs them after ueventd's coldboot has created the nodes, so they win.
    awk '{
            r = "ACTION==\"add\", KERNEL==\"" $1 "\""
            if ($2 != "-") r = r ", OWNER=\"" $2 "\""
            if ($3 != "-") r = r ", GROUP=\"" $3 "\""
            if ($4 != "-") r = r ", MODE=\"" $4 "\""
            print r
        }' "$INITPERMS" \
      | not_covered globs
} > "$OUT"

rm -f "$COVERED" "$GLOBS" "$INITPERMS"

COUNT=$(grep -c '^ACTION' "$OUT" 2>/dev/null)
if [ "${COUNT:-0}" -eq 0 ]; then
    rm -f "$OUT"
    echo "halium-udev-rules: existing rules already cover every node, nothing added"
    exit 0
fi
echo "halium-udev-rules: added $COUNT rules not covered elsewhere, to $OUT"

# Reload so the new file is in force for nodes created from here on - which is
# the case that matters, since these appear when a subsystem is first powered.
#
# Deliberately no "udevadm trigger --action=add": re-firing an add event for
# every device on a running system is far more invasive than it looks, and on
# sargo it stopped the GNSS engine producing NMEA even when the rules themselves
# changed nothing it used. Nodes that already exist keep their current
# ownership until the next boot, which is an acceptable trade for not disturbing
# a running system.
udevadm control --reload-rules 2>/dev/null

exit 0

[Unit]
Description=Translate Android ueventd device permissions into udev rules

# The ueventd files live in the Android tree - /vendor is a symlink to
# /android/vendor - so this cannot run until that is mounted. Naming a mount
# unit directly does not travel: the units are generated per device and differ
# between them, so an After= on a name that does not exist on this device is
# silently a no-op and the unit runs seconds into boot, finds nothing, and skips
# itself. RequiresMountsFor resolves the path to whichever mount units actually
# provide it on this machine.
RequiresMountsFor=/android/vendor /android
After=systemd-udevd.service

# No ConditionPathExists: the generator already exits cleanly when a device has
# no ueventd files, and a condition here only converts "ran and found nothing"
# into "never ran", which is far harder to tell apart from a broken unit.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/halium-generate-udev-rules

[Install]
WantedBy=multi-user.target

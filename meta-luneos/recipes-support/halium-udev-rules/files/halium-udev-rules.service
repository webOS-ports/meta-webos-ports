[Unit]
Description=Translate Android ueventd device permissions into udev rules
# /vendor is a symlink into the Android tree, so the ueventd files do not exist
# until android.mount has run. Ordering this earlier - before systemd-udevd, as
# a first instinct suggests - means the source files are simply absent and the
# unit skips itself silently.
#
# Racing udev is not needed anyway: the nodes this matters for are created on
# demand when a subsystem is first powered, long after boot. The rules only have
# to be in place before that, not before udev starts.
After=android.mount local-fs.target systemd-udevd.service
Wants=android.mount
ConditionPathExists=/vendor/ueventd.rc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/halium-generate-udev-rules

[Install]
WantedBy=multi-user.target

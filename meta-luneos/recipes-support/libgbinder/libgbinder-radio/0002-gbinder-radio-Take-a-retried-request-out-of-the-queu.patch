From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 07:38:40 +0100
Subject: [PATCH] [gbinder-radio] Take a retried request out of the queue on
 response

radio_request_retry() puts a pending request back into the queue
without changing its serial. If it can't be resubmitted right away
(e.g. because a request group is waiting to become the owner), it
stays in the queue under the old serial, and the response to the
previous transmission is still going to arrive.

radio_base_handle_resp() then treated it as an ordinary pending
request:

- if it was done, the state was set to DONE before calling
  radio_base_deactivate_request(), which only takes QUEUED requests
  out of the queue. The completed request was released while still
  linked into the queue, and radio_base_submit_queued_requests()
  walked into freed memory right after that;

- if it was to be retried again, it was appended to the queue it was
  already in, which looped the queue and made the following
  radio_base_submit_queued_requests() spin forever.

Take the request out of the queue first.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/mer-hybris/libgbinder-radio/pull/40]
---
 src/radio_base.c               | 12 +++++
 unit/unit_client/unit_client.c | 89 ++++++++++++++++++++++++++++++++++
 2 files changed, 101 insertions(+)

diff --git a/src/radio_base.c b/src/radio_base.c
index 86fe3e9..b30b424 100644
--- a/src/radio_base.c
+++ b/src/radio_base.c
@@ -805,6 +805,18 @@ radio_base_handle_resp(
         /* It's no longer pending */
         g_hash_table_remove(priv->pending, KEY(info->serial));
 
+        /*
+         * The request may be back in the queue, waiting to be resubmitted
+         * after radio_request_retry(), and this is the response to the
+         * previous transmission. Take it out of the queue, both outcomes
+         * below assume that it's not there (re-queueing would loop the
+         * queue, and a completed request would be left in it after it's
+         * been freed).
+         */
+        if (req->state == RADIO_REQUEST_STATE_QUEUED) {
+            radio_base_dequeue_request(priv, req);
+        }
+
         /* Response may come before completion of the request */
         radio_base_cancel_request(self, req);
 
diff --git a/unit/unit_client/unit_client.c b/unit/unit_client/unit_client.c
index 3726396..8301bc8 100644
--- a/unit/unit_client/unit_client.c
+++ b/unit/unit_client/unit_client.c
@@ -1603,6 +1603,94 @@ test_block_queued_timeout2(
     test_simple_cleanup(&test);
 }
 
+/*==========================================================================*
+ * block_retry_resp
+ *
+ * A pending request is retried but can't be resubmitted right away
+ * because a group is waiting to become the owner. Then the response
+ * to the original transmission arrives.
+ *==========================================================================*/
+
+static
+void
+test_block_retry_resp_complete_cb(
+    RadioRequest* req,
+    RADIO_TX_STATUS status,
+    RADIO_RESP resp,
+    RADIO_ERROR error,
+    const GBinderReader* reader,
+    gpointer user_data)
+{
+    TestSimple* test = user_data;
+
+    g_assert_cmpint(status, == ,RADIO_TX_STATUS_OK);
+    g_assert(!test->completed);
+    test->completed++;
+}
+
+static
+void
+test_block_retry_resp(
+    void)
+{
+    GBinderLocalRequest* resp;
+    GBinderWriter writer;
+    RadioResponseInfo info;
+    TestSimple test;
+    RadioClient* client = test_simple_init(&test);
+    GBinderClient* resp_client;
+    RadioRequestGroup* group = radio_request_group_new(client);
+    RadioRequest* req = radio_request_new(client, IGNORE_REQ, NULL,
+        test_block_retry_resp_complete_cb, test_simple_destroy_cb, &test);
+    RadioRequest* req2 = radio_request_new(client, RADIO_REQ_GET_MUTE, NULL,
+        NULL, NULL, NULL);
+    guint32 serial;
+
+    test_common_connected(&test.common);
+    resp_client = test.common.service.resp_client;
+
+    radio_request_set_retry(req, 0, 1);
+    g_assert(radio_request_submit(req));
+    g_assert_cmpint(req->state, == ,RADIO_REQUEST_STATE_PENDING);
+    serial = req->serial2;
+
+    /* The group has to wait for the pending request */
+    g_assert_cmpint(radio_request_group_block(group), ==,
+        RADIO_BLOCK_QUEUED);
+
+    /* Retry can't resubmit it, so it gets queued */
+    radio_request_retry(req);
+    g_assert_cmpint(req->state, == ,RADIO_REQUEST_STATE_QUEUED);
+    radio_request_unref(req);
+
+    /* The response to the original transmission */
+    memset(&info, 0, sizeof(info));
+    info.type = RADIO_RESP_SOLICITED;
+    info.serial = serial;
+    resp = gbinder_client_new_request2(resp_client,
+        RADIO_RESP_GET_SIGNAL_STRENGTH);
+    gbinder_local_request_init_writer(resp, &writer);
+    gbinder_writer_append_buffer_object(&writer, &info, sizeof(info));
+    g_assert_cmpint(gbinder_client_transact_sync_oneway(resp_client,
+        RADIO_RESP_GET_SIGNAL_STRENGTH, resp), == ,GBINDER_STATUS_OK);
+    gbinder_local_request_unref(resp);
+    g_assert_cmpint(test.completed, == ,1);
+    g_assert_cmpint(test.destroyed, == ,1);
+    test_run(&test_opt, test.loop); /* test_simple_destroy_cb quits it */
+
+    /* The queue must still be usable */
+    g_assert_cmpint(radio_request_group_block_status(group), ==,
+        RADIO_BLOCK_ACQUIRED);
+    radio_request_group_unblock(group);
+    g_assert(radio_request_submit(req2));
+    g_assert_cmpint(req2->state, == ,RADIO_REQUEST_STATE_PENDING);
+    radio_request_drop(req2);
+
+    /* Cleanup */
+    radio_request_group_unref(group);
+    test_simple_cleanup(&test);
+}
+
 /*==========================================================================*
  * block_retry
  *==========================================================================*/
@@ -2338,6 +2426,7 @@ int main(int argc, char* argv[])
     g_test_add_func(TEST_("block/2"), test_block2);
     g_test_add_func(TEST_("block/timeout"), test_block_timeout);
     g_test_add_func(TEST_("block/retry"), test_block_retry);
+    g_test_add_func(TEST_("block/retry_resp"), test_block_retry_resp);
     g_test_add_func(TEST_("block/queued_timeout"),
         test_block_queued_timeout);
     g_test_add_func(TEST_("block/queued_timeout2"),
-- 

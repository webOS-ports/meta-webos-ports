From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 07:38:50 +0100
Subject: [PATCH] [gbinder-radio] Let the next group become the owner when the
 queue moves

A group that wants to become the owner has to wait until no requests
of other groups are pending. It was only made the owner when such a
request completed, or when one of its own requests got submitted. A
pending request can also stop being pending without completing, when
it's retried with radio_request_retry() or when a response asks for
a retry and the request is put back into the queue with a delay.

Then nobody made the group the owner. Requests outside of the group
couldn't be submitted while it was waiting, including the request it
had been waiting for, and a group that blocks the client before
submitting anything (like ofono-binder-plugin's radio capability
switch does) waited forever.

Check whether the next group can become the owner every time the
queue is pushed.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/mer-hybris/libgbinder-radio/pull/40]
---
 src/radio_base.c               |  10 +++
 unit/unit_client/unit_client.c | 108 +++++++++++++++++++++++++++++++++
 2 files changed, 118 insertions(+)

diff --git a/src/radio_base.c b/src/radio_base.c
index b30b424..b551559 100644
--- a/src/radio_base.c
+++ b/src/radio_base.c
@@ -425,6 +425,16 @@ radio_base_submit_queued_requests(
     RadioBasePriv* priv = self->priv;
     guint submitted = 0;
 
+    /*
+     * The group waiting to become the owner may have been waiting for
+     * a request that's no longer pending without having completed (it
+     * has been retried, dropped or has timed out). Otherwise it would
+     * keep waiting until one of its own requests gets submitted, and
+     * the requests outside of the group would stay in the queue behind
+     * it, possibly forever.
+     */
+    radio_base_move_owner_queue(self);
+
     if (RADIO_BASE_GET_CLASS(self)->can_submit_requests(self)) {
         RadioRequest* prev = NULL;
         RadioRequest* req = priv->queue_first;
diff --git a/unit/unit_client/unit_client.c b/unit/unit_client/unit_client.c
index 8301bc8..3666656 100644
--- a/unit/unit_client/unit_client.c
+++ b/unit/unit_client/unit_client.c
@@ -1663,6 +1663,10 @@ test_block_retry_resp(
     g_assert_cmpint(req->state, == ,RADIO_REQUEST_STATE_QUEUED);
     radio_request_unref(req);
 
+    /* Nothing is pending anymore, the group becomes the owner */
+    g_assert_cmpint(radio_request_group_block_status(group), ==,
+        RADIO_BLOCK_ACQUIRED);
+
     /* The response to the original transmission */
     memset(&info, 0, sizeof(info));
     info.type = RADIO_RESP_SOLICITED;
@@ -1691,6 +1695,109 @@ test_block_retry_resp(
     test_simple_cleanup(&test);
 }
 
+/*==========================================================================*
+ * block_retry_resp2
+ *
+ * Same as block_retry_resp but the response asks for yet another retry.
+ * The request must end up in the queue once.
+ *==========================================================================*/
+
+static
+gboolean
+test_block_retry_resp2_retry(
+    RadioRequest* req,
+    RADIO_TX_STATUS status,
+    guint32 resp,
+    RADIO_ERROR error,
+    const GBinderReader* reader,
+    void* user_data)
+{
+    int* retried = user_data;
+
+    (*retried)++;
+    return TRUE;
+}
+
+static
+void
+test_block_retry_resp2_complete_cb(
+    RadioRequest* req,
+    RADIO_TX_STATUS status,
+    RADIO_RESP resp,
+    RADIO_ERROR error,
+    const GBinderReader* reader,
+    gpointer user_data)
+{
+    TestSimple* test = user_data;
+
+    g_assert_cmpint(status, == ,RADIO_TX_STATUS_OK);
+    g_assert_cmpint(resp, == ,RADIO_RESP_GET_MUTE);
+    test->completed++;
+    test_quit_later(test->loop);
+}
+
+static
+void
+test_block_retry_resp2(
+    void)
+{
+    GBinderLocalRequest* resp;
+    GBinderWriter writer;
+    RadioResponseInfo info;
+    TestSimple test;
+    RadioClient* client = test_simple_init(&test);
+    GBinderClient* resp_client;
+    RadioRequestGroup* group = radio_request_group_new(client);
+    int retried = 0;
+    RadioRequest* req = radio_request_new(client, IGNORE_REQ, NULL,
+        NULL, NULL, &retried);
+    RadioRequest* req2 = radio_request_new(client, RADIO_REQ_GET_MUTE, NULL,
+        test_block_retry_resp2_complete_cb, NULL, &test);
+    guint32 serial;
+
+    test_common_connected(&test.common);
+    resp_client = test.common.service.resp_client;
+
+    radio_request_set_retry(req, 0, -1);
+    radio_request_set_retry_func(req, test_block_retry_resp2_retry);
+    g_assert(radio_request_submit(req));
+    serial = req->serial2;
+    g_assert_cmpint(radio_request_group_block(group), ==,
+        RADIO_BLOCK_QUEUED);
+    radio_request_retry(req);
+    g_assert_cmpint(req->state, == ,RADIO_REQUEST_STATE_QUEUED);
+
+    /* The response to the original transmission */
+    memset(&info, 0, sizeof(info));
+    info.type = RADIO_RESP_SOLICITED;
+    info.serial = serial;
+    resp = gbinder_client_new_request2(resp_client,
+        RADIO_RESP_GET_SIGNAL_STRENGTH);
+    gbinder_local_request_init_writer(resp, &writer);
+    gbinder_writer_append_buffer_object(&writer, &info, sizeof(info));
+    g_assert_cmpint(gbinder_client_transact_sync_oneway(resp_client,
+        RADIO_RESP_GET_SIGNAL_STRENGTH, resp), == ,GBINDER_STATUS_OK);
+    gbinder_local_request_unref(resp);
+    g_assert_cmpint(retried, == ,1);
+    g_assert_cmpint(req->state, == ,RADIO_REQUEST_STATE_QUEUED);
+
+    /* The queue still works (a looped one would hang here) */
+    g_assert(radio_request_submit(req2));
+    g_assert_cmpint(req2->state, == ,RADIO_REQUEST_STATE_QUEUED);
+    g_assert_cmpint(radio_request_group_block_status(group), ==,
+        RADIO_BLOCK_ACQUIRED);
+    radio_request_group_unblock(group);
+    test_run(&test_opt, test.loop);
+    g_assert_cmpint(req->state, == ,RADIO_REQUEST_STATE_PENDING);
+    g_assert_cmpint(req2->state, == ,RADIO_REQUEST_STATE_DONE);
+
+    /* Cleanup */
+    radio_request_drop(req);
+    radio_request_unref(req2);
+    radio_request_group_unref(group);
+    test_simple_cleanup(&test);
+}
+
 /*==========================================================================*
  * block_retry
  *==========================================================================*/
@@ -2427,6 +2534,7 @@ int main(int argc, char* argv[])
     g_test_add_func(TEST_("block/timeout"), test_block_timeout);
     g_test_add_func(TEST_("block/retry"), test_block_retry);
     g_test_add_func(TEST_("block/retry_resp"), test_block_retry_resp);
+    g_test_add_func(TEST_("block/retry_resp2"), test_block_retry_resp2);
     g_test_add_func(TEST_("block/queued_timeout"),
         test_block_queued_timeout);
     g_test_add_func(TEST_("block/queued_timeout2"),
-- 

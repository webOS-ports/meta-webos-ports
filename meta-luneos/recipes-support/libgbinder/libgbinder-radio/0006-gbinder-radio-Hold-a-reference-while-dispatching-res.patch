From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 08:00:34 +0100
Subject: [PATCH] [gbinder-radio] Hold a reference while dispatching responses
 and indications

radio_instance_response() and radio_instance_indication() emit several
signals in a row and then may ack the transaction, all on an instance
that nothing guarantees to be alive once the first handler has run.
A handler which drops the last reference to the instance (directly,
or by releasing the RadioClient that holds it) made the remaining
observers and the ack run on freed memory.

Hold a reference for the duration, as radio_instance_died() and
radio_config_response() already do. Do the same in
radio_config_indication(). Only the response path is covered by the
new test; the indication paths follow the same pattern.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/mer-hybris/libgbinder-radio/pull/41]
---
 src/radio_config.c                 |  3 +
 src/radio_instance.c               |  8 +++
 unit/unit_instance/unit_instance.c | 88 ++++++++++++++++++++++++++++++
 3 files changed, 99 insertions(+)

diff --git a/src/radio_config.c b/src/radio_config.c
index 3f54ca1..7c1932f 100644
--- a/src/radio_config.c
+++ b/src/radio_config.c
@@ -468,11 +468,14 @@ radio_config_indication(
             const guint* signals = radio_config_signals +
                 SIGNAL_OBSERVE_INDICATION_0;
 
+            /* Observers may drop the last reference */
+            radio_config_ref(self);
             for (i = RADIO_OBSERVER_PRIORITY_COUNT - 1; i >=0; i--) {
                 if (signals[i]) {
                     g_signal_emit(self, signals[i], quark, code, &args);
                 }
             }
+            radio_config_unref(self);
             *status = GBINDER_STATUS_OK;
         } else {
             GWARN("Failed to decode IRadioConfig indication %u", code);
diff --git a/src/radio_instance.c b/src/radio_instance.c
index f40b2b5..0a0703d 100644
--- a/src/radio_instance.c
+++ b/src/radio_instance.c
@@ -378,6 +378,9 @@ radio_instance_indication(
             int p = RADIO_OBSERVER_PRIORITY_HIGHEST;
             gboolean handled = FALSE;
 
+            /* Handlers may drop the last reference to the instance */
+            radio_instance_ref(self);
+
             /* High-priority observers are notified first */
             for (; p > RADIO_OBSERVER_PRIORITY_DEFAULT; p--) {
                 if (signals[RADIO_OBSERVER_PRIORITY_INDEX(p)]) {
@@ -419,6 +422,7 @@ radio_instance_indication(
                 GDEBUG("ack unhandled indication");
                 radio_instance_ack(self);
             }
+            radio_instance_unref(self);
             *status = GBINDER_STATUS_OK;
         } else {
             GWARN("Failed to decode indication %u", code);
@@ -478,6 +482,9 @@ radio_instance_response(
         int p = RADIO_OBSERVER_PRIORITY_HIGHEST;
         gboolean handled = FALSE;
 
+        /* Handlers may drop the last reference to the instance */
+        radio_instance_ref(self);
+
         /* High-priority observers are notified first */
         for (; p > RADIO_OBSERVER_PRIORITY_DEFAULT; p--) {
             if (signals[RADIO_OBSERVER_PRIORITY_INDEX(p)]) {
@@ -506,6 +513,7 @@ radio_instance_response(
             GDEBUG("ack unhandled response");
             radio_instance_ack(self);
         }
+        radio_instance_unref(self);
     }
     *status = GBINDER_STATUS_OK;
     return NULL;
diff --git a/unit/unit_instance/unit_instance.c b/unit/unit_instance/unit_instance.c
index dcf8f53..6449334 100644
--- a/unit/unit_instance/unit_instance.c
+++ b/unit/unit_instance/unit_instance.c
@@ -863,6 +863,93 @@ test_resp(
     gbinder_servicemanager_unref(sm);
 }
 
+/*==========================================================================*
+ * resp_unref
+ *
+ * The response handler drops the last reference to the instance.
+ *==========================================================================*/
+
+static
+gboolean
+test_resp_unref_handle(
+    RadioInstance* radio,
+    RADIO_RESP code,
+    const RadioResponseInfo* info,
+    const GBinderReader* reader,
+    gpointer user_data)
+{
+    RadioInstance** ptr = user_data;
+
+    g_assert(*ptr == radio);
+    *ptr = NULL;
+    radio_instance_unref(radio);
+    return FALSE; /* Not handled, i.e. to be acked */
+}
+
+static
+void
+test_resp_unref_observe(
+    RadioInstance* radio,
+    RADIO_RESP code,
+    const RadioResponseInfo* info,
+    const GBinderReader* reader,
+    gpointer user_data)
+{
+    int* count = user_data;
+
+    (*count)++;
+}
+
+static
+void
+test_resp_unref(
+    void)
+{
+    const char* slot = "slot2";
+    const char* fqname = RADIO_1_0 "/slot2";
+    TestRadioService service;
+    GBinderServiceManager* sm = gbinder_servicemanager_new(DEV);
+    GBinderRemoteObject* remote;
+    GBinderLocalRequest* req;
+    GBinderClient* resp;
+    RadioInstance* radio;
+    RadioResponseInfo info;
+    GBinderWriter writer;
+    int observed = 0;
+
+    test_service_init(&service);
+    memset(&info, 0, sizeof(info));
+    info.type = RADIO_RESP_SOLICITED_ACK_EXP;
+    info.serial = 123;
+
+    remote = test_gbinder_servicemanager_new_service(sm, fqname, service.obj);
+    radio = radio_instance_new_with_version(DEV, slot, RADIO_INTERFACE_1_4);
+    g_assert(radio_instance_add_response_handler(radio, TEST_RESP,
+        test_resp_unref_handle, &radio));
+    g_assert(radio_instance_add_response_observer_with_priority(radio,
+        RADIO_INSTANCE_PRIORITY_LOWEST, TEST_RESP,
+        test_resp_unref_observe, &observed));
+
+    resp = gbinder_client_new2(service.resp_obj,
+        TEST_ARRAY_AND_COUNT(radio_resp_iface_info));
+    req = gbinder_client_new_request2(resp, TEST_RESP);
+    gbinder_local_request_init_writer(req, &writer);
+    gbinder_writer_append_buffer_object(&writer, &info, sizeof(info));
+    gbinder_client_transact_sync_oneway(resp, TEST_RESP, req);
+    g_assert(!radio); /* Released by the handler */
+
+    /* The low priority observer still saw it, and the response got acked */
+    g_assert_cmpint(observed, == ,1);
+    g_assert_cmpint(test_service_req_count(&service,
+        RADIO_REQ_RESPONSE_ACKNOWLEDGEMENT), == ,1);
+
+    gbinder_local_request_unref(req);
+    gbinder_client_unref(resp);
+    test_service_cleanup(&service);
+    gbinder_remote_object_unref(remote);
+    gbinder_servicemanager_unref(sm);
+}
+
 /*==========================================================================*
  * ack
  *==========================================================================*/
@@ -1190,6 +1277,7 @@ int main(int argc, char* argv[])
     g_test_add_func(TEST_("ind"), test_ind);
     g_test_add_func(TEST_("req"), test_req);
     g_test_add_func(TEST_("resp"), test_resp);
+    g_test_add_func(TEST_("resp_unref"), test_resp_unref);
     g_test_add_func(TEST_("ack"), test_ack);
     g_test_add_func(TEST_("send_req"), test_send_req);
     g_test_add_func(TEST_("enabled"), test_enabled);
-- 

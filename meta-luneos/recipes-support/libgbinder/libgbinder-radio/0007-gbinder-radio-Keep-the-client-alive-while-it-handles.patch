From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 08:01:21 +0100
Subject: [PATCH] [gbinder-radio] Keep the client alive while it handles
 rilConnected

radio_client_handle_connected() emits the client's connected signal
and then submits the queued requests. A connected handler that drops
the last reference to the client made radio_base_submit_requests()
run on a freed object. Hold a reference, as the death handler does.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/mer-hybris/libgbinder-radio/pull/41]
---
 src/radio_client.c             |  9 +++++--
 unit/unit_client/unit_client.c | 43 ++++++++++++++++++++++++++++++++++
 2 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/src/radio_client.c b/src/radio_client.c
index 5cb2eac..cab06b2 100644
--- a/src/radio_client.c
+++ b/src/radio_client.c
@@ -144,8 +144,13 @@ radio_client_handle_connected(
     RadioInstance* instance,
     gpointer user_data)
 {
-    g_signal_emit(THIS(user_data), radio_client_signals[SIGNAL_CONNECTED], 0);
-    radio_base_submit_requests(RADIO_BASE(user_data));
+    RadioBase* base = RADIO_BASE(user_data);
+
+    /* Connected handlers may drop the last reference to the client */
+    g_object_ref(base);
+    g_signal_emit(base, radio_client_signals[SIGNAL_CONNECTED], 0);
+    radio_base_submit_requests(base);
+    g_object_unref(base);
 }
 
 static
diff --git a/unit/unit_client/unit_client.c b/unit/unit_client/unit_client.c
index 64c6ec3..6b3dd0c 100644
--- a/unit/unit_client/unit_client.c
+++ b/unit/unit_client/unit_client.c
@@ -861,6 +861,48 @@ test_resp(
     test_simple_cleanup(&test);
 }
 
+/*==========================================================================*
+ * connected_unref
+ *
+ * The connected handler drops the last reference to the client.
+ *==========================================================================*/
+
+static
+void
+test_connected_unref_cb(
+    RadioClient* client,
+    gpointer user_data)
+{
+    RadioClient** ptr = user_data;
+
+    g_assert(*ptr == client);
+    *ptr = NULL;
+    radio_client_unref(client);
+}
+
+static
+void
+test_connected_unref(
+    void)
+{
+    TestSimple test;
+    RadioClient* client = test_simple_init(&test);
+    GBinderClient* ind_client = test.common.service.ind_client;
+    GBinderLocalRequest* req;
+
+    g_assert(radio_client_add_connected_handler(client,
+        test_connected_unref_cb, &test.common.client));
+    req = gbinder_client_new_request2(ind_client, RADIO_IND_RIL_CONNECTED);
+    gbinder_local_request_append_int32(req, RADIO_IND_ACK_EXP);
+    g_assert_cmpint(gbinder_client_transact_sync_oneway(ind_client,
+        RADIO_IND_RIL_CONNECTED, req), == ,GBINDER_STATUS_OK);
+    gbinder_local_request_unref(req);
+    g_assert(!test.common.client); /* Released by the handler */
+
+    /* Cleanup (radio_client_unref(NULL) is fine) */
+    test_simple_cleanup(&test);
+}
+
 /*==========================================================================*
  * group
  *==========================================================================*/
@@ -2643,6 +2685,7 @@ int main(int argc, char* argv[])
     g_test_add_func(TEST_("cancel_queue"), test_cancel_queue);
     g_test_add_func(TEST_("ind"), test_ind);
     g_test_add_func(TEST_("resp"), test_resp);
+    g_test_add_func(TEST_("connected_unref"), test_connected_unref);
     g_test_add_func(TEST_("group"), test_group);
     g_test_add_func(TEST_("group2"), test_group2);
     g_test_add_func(TEST_("group3"), test_group3);
-- 

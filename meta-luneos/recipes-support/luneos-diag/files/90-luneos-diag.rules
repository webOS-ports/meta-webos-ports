# Re-run the state dump whenever the Type-C port or the charger changes state,
# so an attach/detach that happens minutes after boot is captured. Appends to
# /var/log/luneos-diag-events.txt.
SUBSYSTEM=="typec", ACTION=="add|change|remove", TAG+="systemd", ENV{SYSTEMD_WANTS}+="luneos-diag-event.service"
SUBSYSTEM=="power_supply", ACTION=="change", TAG+="systemd", ENV{SYSTEMD_WANTS}+="luneos-diag-event.service"
SUBSYSTEM=="extcon", ACTION=="change", TAG+="systemd", ENV{SYSTEMD_WANTS}+="luneos-diag-event.service"

[Unit]
Description=LuneOS hardware state dump (triggered by a USB-C / power event)

[Service]
Type=oneshot
Environment=LUNEOS_DIAG_OUT=/var/log/luneos-diag-events.txt
Environment=LUNEOS_DIAG_APPEND=1
# Let the Type-C state machine settle before snapshotting it.
ExecStartPre=/bin/sh -c 'sleep 3'
ExecStart=/usr/sbin/luneos-diag.sh

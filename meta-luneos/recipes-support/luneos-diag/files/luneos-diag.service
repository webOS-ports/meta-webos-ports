[Unit]
Description=LuneOS boot-time hardware state dump
After=multi-user.target graphical.target
Wants=multi-user.target

[Service]
Type=oneshot
# Give the graphics stack and connman a moment to settle so the dump reflects
# steady state rather than a half-started system.
ExecStartPre=/bin/sh -c 'sleep 25'
ExecStart=/usr/sbin/luneos-diag.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

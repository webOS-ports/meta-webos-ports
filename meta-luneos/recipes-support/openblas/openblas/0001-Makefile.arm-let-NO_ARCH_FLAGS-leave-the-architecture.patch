From f3f12a82e197756ed13a84ba1c41a988515e331e Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Thu, 12 Nov 2026 21:49:34 +0100
Subject: [PATCH] Makefile.arm: let NO_ARCH_FLAGS leave the architecture to the
 compiler

For 32-bit ARM v7 cores, Makefile.arm adds -march=armv7-a and, outside
Android, -mfpu=vfpv3. A cross toolchain that already selects the CPU
(-mcpu=cortex-a8 -mfpu=neon, as Yocto's does) then warns on every file
that -mcpu conflicts with -march, and the later -mfpu=vfpv3 turns NEON
off for the C code. With NO_ARCH_FLAGS=1 those flags are left out and
the compiler's own are used.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 Makefile.arm | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Makefile.arm b/Makefile.arm
index a27b58e..bff5723 100644
--- a/Makefile.arm
+++ b/Makefile.arm
@@ -1,5 +1,7 @@
 ifeq ($(CORE), $(filter $(CORE),ARMV7 CORTEXA9 CORTEXA15))
-ifeq ($(OSNAME), Android)
+ifdef NO_ARCH_FLAGS
+# The compiler's own flags choose the architecture and FPU.
+else ifeq ($(OSNAME), Android)
 CCOMMON_OPT += -mfpu=neon -march=armv7-a
 FCOMMON_OPT += -mfpu=neon -march=armv7-a
 else

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Thu, 5 Nov 2026 15:27:27 +0100
Subject: [PATCH] Do not dereference a missing device ID when pruning devices

prune_devices() logs "Deleting bogous device %s" with device.ID.String()
in the branch where device.ID is nil, which panics. Log the message
without the ID.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/hoehermann/purple-gowhatsapp/pull/298]
---
 login.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/login.go b/login.go
index fe775ef..69d6a84 100644
--- a/login.go
+++ b/login.go
@@ -238,7 +238,7 @@ func (handler *Handler) prune_devices(deviceJid types.JID) {
 	if err == nil {
 		for _, device := range devices {
 			if device.ID == nil {
-				handler.log.Infof("Deleting bogous device %s from database...", device.ID.String())
+				handler.log.Infof("Deleting bogous device without ID from database...")
 				device.Delete(ctx) // ignores errors
 			} else {
 				obsolete := device.ID.ToNonAD() == deviceJid.ToNonAD() && *device.ID != deviceJid

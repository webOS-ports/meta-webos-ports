From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 20 Oct 2026 16:26:43 +0200
Subject: [PATCH] Set the group subject when group info loads on the first try

query_group_participants_retry() only calls purple_update_group() on the
delayed-retry path. On the common path - GetGroupInfo() succeeding at the
first attempt - it returns the participant list without ever passing the
group's subject to purple, so the chat keeps showing the raw
"<digits>-<digits>@g.us" JID as its name.

Update the group on every successful lookup and still return the
participants on the first attempt.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 groups.go | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/groups.go b/groups.go
index acdf515..5d9c60b 100644
--- a/groups.go
+++ b/groups.go
@@ -16,9 +16,10 @@ import (
 func (handler *Handler) query_group_participants_retry(group_jid types.JID, seconds_backoff int, max_retries int, retry_count int) []types.GroupParticipant {
 	group, err := handler.client.GetGroupInfo(context.TODO(), group_jid)
 	if err == nil && group != nil {
-		if retry_count > 0 {
-			purple_update_group(handler.account, group)
-		} else {
+		// Always push the group name/subject, not only on a delayed retry. Otherwise a group whose
+		// info loaded on the first try never gets its subject and the chat shows the raw JID.
+		purple_update_group(handler.account, group)
+		if retry_count == 0 {
 			return group.Participants
 		}
 	} else {

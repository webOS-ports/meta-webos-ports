 		if len(frame) == 0 {
@@ -428,9 +426,41 @@ func attachMedia(ci *callInfo) {
 	}))
 }
 
+// openCallAudio opens the ALSA playback+capture path so the call is audible, and with it the
+// active call glue/call.c reports to audiod, which pauses the music and routes to the earpiece.
+// An outgoing call does this when it is placed, an incoming one only once it is answered: while
+// it rings it is not a call in progress yet (callaudio.TakesPathAtStart). Opening it at the
+// offer, as before, told audiod a call was active the moment WhatsApp preaccepted, and the
+// music stopped under the ringtone.
+func openCallAudio(ci *callInfo) {
+	if !callAudio.Take(ci.id) {
+		return // already open, for this call or another one in progress
+	}
+	// The MLow encoder runs on a tight 60ms budget; a mid-call GC stop-the-world can stall the send
+	// loop and drop a frame. Raise the GC threshold for the call's duration (fewer, and with
+	// GOMAXPROCS>=2 concurrent, collections), then restore it on disconnect. Scoped to calls so the
+	// transport's steady-state memory is unaffected.
+	callPrevGCPercent = debug.SetGCPercent(400)
+	C.gowhatsapp_call_audio_active(C.int(1)) // open playback + start mic capture -> read_mic
+}
+
+// closeCallAudio drops call id's hold on the audio path and closes the path when it was the last
+// one. A ringing call that is rejected or missed never took it, so ending it cannot cut off the
+// audio of another call in progress.
+func closeCallAudio(id string) {
+	if !callAudio.Release(id) {
+		return
+	}
+	C.gowhatsapp_call_audio_active(C.int(0)) // close ALSA playback + stop mic capture
+	debug.SetGCPercent(callPrevGCPercent)    // restore normal GC pacing after the call
+}
+
 func handleIncoming(mcCall *meowcaller.Call) {
 	ci := wireCall(mcCall, "incoming", "")
 	attachMedia(ci)
+	if callaudio.TakesPathAtStart(ci.origin) {
+		openCallAudio(ci)
+	}
 	emitCallState() // ring the UI
 }
 

diff --git a/callaudio/callaudio.go b/callaudio/callaudio.go
new file mode 100644
index 0000000..9d8634c
--- /dev/null
+++ b/callaudio/callaudio.go
@@ -0,0 +1,64 @@
+// Package callaudio decides when a WhatsApp call holds the device's call audio
+// path: the ALSA "voip"/"voipsource" streams glue/call.c opens, and the active
+// call it reports to audiod with phone/CallStatusUpdate. audiod pauses the music
+// and routes to the earpiece for an active call, so the path must only be taken
+// by a call that is really in progress.
+//
+// It is plain Go, without cgo, so that it can be tested on its own; call.go
+// does the C calls the answers here ask for.
+package callaudio
+
+import "sync"
+
+// TakesPathAtStart reports whether a call holds the audio path from the moment
+// it is set up. An outgoing call does: the user started it and expects the
+// ringback on the earpiece. An incoming call does not until it is answered:
+// while it rings, the device sounds the ringtone and the music keeps playing.
+func TakesPathAtStart(origin string) bool {
+	return origin != "incoming"
+}
+
+// Path is the call audio path, shared by every call. It is open while at least
+// one call holds it. The zero value is a closed path, ready to use.
+type Path struct {
+	mu      sync.Mutex
+	holders map[string]struct{}
+}
+
+// Take records that call id holds the path. It reports whether the path was
+// closed until now, that is, whether the caller must open it. Taking it again
+// for the same call changes nothing.
+func (p *Path) Take(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.holders == nil {
+		p.holders = make(map[string]struct{})
+	}
+	if _, ok := p.holders[id]; ok {
+		return false
+	}
+	p.holders[id] = struct{}{}
+	return len(p.holders) == 1
+}
+
+// Release drops call id's hold. It reports whether that was the last hold, that
+// is, whether the caller must close the path. Releasing a call that never took
+// the path, such as a ringing call that was rejected or missed, changes nothing,
+// so it cannot cut off the audio of another call in progress.
+func (p *Path) Release(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if _, ok := p.holders[id]; !ok {
+		return false
+	}
+	delete(p.holders, id)
+	return len(p.holders) == 0
+}
+
+// Held reports whether call id holds the path.
+func (p *Path) Held(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	_, ok := p.holders[id]
+	return ok
+}
diff --git a/callaudio/callaudio_test.go b/callaudio/callaudio_test.go
new file mode 100644
index 0000000..dfc3684
--- /dev/null
+++ b/callaudio/callaudio_test.go
@@ -0,0 +1,117 @@
+package callaudio
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTakesPathAtStart(t *testing.T) {
+	if TakesPathAtStart("incoming") {
+		t.Error("a ringing incoming call takes the audio path, so the music stops before it is answered")
+	}
+	if !TakesPathAtStart("outgoing") {
+		t.Error("an outgoing call does not take the audio path when it is placed")
+	}
+}
+
+// The 30 October fault: the music paused while a WhatsApp call was still
+// ringing. Ringing must not touch the path; answering opens it.
+func TestRingingThenAnswered(t *testing.T) {
+	var p Path
+	if p.Held("A") {
+		t.Fatal("a new path is held")
+	}
+	if !p.Take("A") {
+		t.Fatal("answering the call did not open the path")
+	}
+	if !p.Held("A") {
+		t.Fatal("the answered call does not hold the path")
+	}
+	if !p.Release("A") {
+		t.Fatal("hanging up the only call did not close the path")
+	}
+	if p.Held("A") {
+		t.Fatal("the call still holds the path after hanging up")
+	}
+}
+
+func TestRejectedRingingCallLeavesThePathAlone(t *testing.T) {
+	var p Path
+	if p.Release("ringing") {
+		t.Fatal("rejecting a call that never took the path asks to close it")
+	}
+	// With another call in progress, the rejected one must not end its audio.
+	p.Take("active")
+	if p.Release("ringing") {
+		t.Fatal("rejecting a second, ringing call closes the path of the call in progress")
+	}
+	if !p.Held("active") {
+		t.Fatal("the call in progress lost the path")
+	}
+}
+
+func TestTakeTwiceOpensOnce(t *testing.T) {
+	var p Path
+	if !p.Take("A") {
+		t.Fatal("the first take did not open the path")
+	}
+	if p.Take("A") {
+		t.Fatal("taking the path again for the same call asks to open it again")
+	}
+	if !p.Release("A") {
+		t.Fatal("one release after two takes does not close the path")
+	}
+	if p.Release("A") {
+		t.Fatal("a second release asks to close the path again")
+	}
+}
+
+func TestPathStaysOpenUntilTheLastCallEnds(t *testing.T) {
+	var p Path
+	if !p.Take("A") {
+		t.Fatal("the first call did not open the path")
+	}
+	if p.Take("B") {
+		t.Fatal("a second call asks to open a path that is already open")
+	}
+	if p.Release("A") {
+		t.Fatal("ending the first call closes the path the second still holds")
+	}
+	if !p.Release("B") {
+		t.Fatal("ending the last call does not close the path")
+	}
+	if !p.Take("C") {
+		t.Fatal("a call after the path closed does not open it again")
+	}
+}
+
+func TestConcurrentCalls(t *testing.T) {
+	var p Path
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	opened, closed := 0, 0
+	for i := range 64 {
+		wg.Add(1)
+		go func(id string) {
+			defer wg.Done()
+			o := p.Take(id)
+			c := p.Release(id)
+			mu.Lock()
+			if o {
+				opened++
+			}
+			if c {
+				closed++
+			}
+			mu.Unlock()
+		}(fmt.Sprint(i))
+	}
+	wg.Wait()
+	if opened != closed {
+		t.Fatalf("the path was opened %d times and closed %d times", opened, closed)
+	}
+	if opened == 0 {
+		t.Fatal("the path was never opened")
+	}
+}

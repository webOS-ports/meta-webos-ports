+extern int gowhatsapp_go_call_answer(char *cID, int video);
+extern int gowhatsapp_go_call_hangup_all(void);
+extern int gowhatsapp_go_call_changemedia(char *cID, int hasOutgoing, int outgoing, int hasIncoming, int incoming);
+extern int gowhatsapp_go_call_hangup(char *cID);
+#endif
diff --git a/glue/tests/playout_test.cpp b/glue/tests/playout_test.cpp
new file mode 100644
index 0000000..51f8601
--- /dev/null
+++ b/glue/tests/playout_test.cpp
@@ -0,0 +1,215 @@
+// Unit tests for glue/playout.c, the playout ring between the call decoder and the playback thread.
+#include <gtest/gtest.h>
+#include <atomic>
+#include <thread>
+#include <vector>
+
+extern "C" {
+#include "playout.h"
+}
+
+namespace {
+
+std::vector<short> ramp(int n, short start) {
+	std::vector<short> v(n);
+	for (int i = 0; i < n; i++) v[i] = static_cast<short>(start + i);
+	return v;
+}
+
+class Playout : public ::testing::Test {
+protected:
+	void SetUp() override { wa_playout_init(&p, 100, 300); }
+	void TearDown() override { wa_playout_destroy(&p); }
+	std::vector<short> pull(int n, int *got = nullptr) {
+		std::vector<short> out(n, 0x5555);
+		int g = wa_playout_pull(&p, out.data(), n);
+		if (got) *got = g;
+		return out;
+	}
+	wa_playout p;
+};
+
+TEST_F(Playout, EmptyRingGivesSilence) {
+	int got = -1;
+	auto out = pull(50, &got);
+	EXPECT_EQ(got, 0);
+	for (short s : out) EXPECT_EQ(s, 0);
+	EXPECT_EQ(p.silence, 50u);
+	EXPECT_EQ(p.underflows, 0u); // never started playing, so it did not run dry
+}
+
+TEST_F(Playout, HoldsBackUntilPrefillIsQueued) {
+	auto a = ramp(60, 1);
+	wa_playout_push(&p, a.data(), 60);
+	int got = -1;
+	pull(20, &got);
+	EXPECT_EQ(got, 0) << "60 < prefill 100: still collecting";
+	auto b = ramp(40, 61);
+	wa_playout_push(&p, b.data(), 40);
+	auto out = pull(30, &got);
+	EXPECT_EQ(got, 30);
+	for (int i = 0; i < 30; i++) EXPECT_EQ(out[i], 1 + i);
+}
+
+TEST_F(Playout, PlaysInOrderAcrossTheRingEnd) {
+	// Walk head close to the end of the buffer, then push across it.
+	std::vector<short> big = ramp(250, 0);
+	int got;
+	for (int round = 0; round < 64; round++) {
+		wa_playout_push(&p, big.data(), 250);
+		auto out = pull(250, &got);
+		ASSERT_EQ(got, 250);
+		for (int i = 0; i < 250; i++) ASSERT_EQ(out[i], i) << "round " << round;
+		pull(1, &got); // ran dry -> rebuffers, keeps the ring index moving
+	}
+	EXPECT_EQ(p.dropped, 0u);
+}
+
+TEST_F(Playout, QueuedAudioShortOfThePrefillPlaysAfterWaitingThatLong) {
+	auto a = ramp(40, 1); // a lone tail, less than the prefill of 100
+	wa_playout_push(&p, a.data(), 40);
+	int got;
+	pull(60, &got);
+	EXPECT_EQ(got, 0);
+	pull(30, &got);
+	EXPECT_EQ(got, 0) << "waited 60 of 100";
+	auto out = pull(30, &got); // waited 90: still short
+	EXPECT_EQ(got, 0);
+	out = pull(30, &got); // waited 120 >= 100: plays what there is
+	EXPECT_EQ(got, 30);
+	EXPECT_EQ(out[0], 1);
+	pull(30, &got);
+	EXPECT_EQ(got, 10);
+	EXPECT_EQ(p.underflows, 1u);
+	EXPECT_EQ(p.fill, 0);
+}
+
+TEST_F(Playout, WaitingOnlyCountsWhileAudioIsQueued) {
+	int got;
+	pull(500, &got); // a long silence with nothing queued
+	auto a = ramp(40, 1);
+	wa_playout_push(&p, a.data(), 40);
+	pull(20, &got);
+	EXPECT_EQ(got, 0) << "the empty wait before the push does not count";
+}
+
+TEST_F(Playout, ShortfallIsZeroFilledAndRebuffers) {
+	auto a = ramp(120, 1);
+	wa_playout_push(&p, a.data(), 120);
+	int got;
+	auto out = pull(200, &got);
+	EXPECT_EQ(got, 120);
+	for (int i = 0; i < 120; i++) EXPECT_EQ(out[i], 1 + i);
+	for (int i = 120; i < 200; i++) EXPECT_EQ(out[i], 0);
+	EXPECT_EQ(p.underflows, 1u);
+	// After running dry it waits for the prefill again rather than playing a sliver.
+	auto b = ramp(50, 500);
+	wa_playout_push(&p, b.data(), 50);
+	pull(10, &got);
+	EXPECT_EQ(got, 0);
+	wa_playout_push(&p, b.data(), 50);
+	pull(10, &got);
+	EXPECT_EQ(got, 10);
+}
+
+TEST_F(Playout, BurstBeyondMaxFillDropsTheOldest) {
+	auto a = ramp(250, 0);
+	wa_playout_push(&p, a.data(), 250);
+	auto b = ramp(100, 1000);
+	wa_playout_push(&p, b.data(), 100); // 350 > max_fill 300: 50 oldest go
+	EXPECT_EQ(p.dropped, 50u);
+	EXPECT_EQ(p.fill, 300);
+	int got;
+	auto out = pull(300, &got);
+	EXPECT_EQ(got, 300);
+	EXPECT_EQ(out[0], 50);
+	EXPECT_EQ(out[199], 249);
+	EXPECT_EQ(out[200], 1000);
+	EXPECT_EQ(out[299], 1099);
+}
+
+TEST_F(Playout, PushLargerThanTheRingKeepsTheNewest) {
+	std::vector<short> huge(WA_PLAYOUT_CAP + 500);
+	for (size_t i = 0; i < huge.size(); i++) huge[i] = static_cast<short>(i & 0x7fff);
+	wa_playout_push(&p, huge.data(), static_cast<int>(huge.size()));
+	EXPECT_EQ(p.fill, WA_PLAYOUT_CAP) << "max_fill is raised to what a single push needs";
+	EXPECT_EQ(p.dropped, 500u);
+	int got;
+	auto out = pull(1, &got);
+	EXPECT_EQ(out[0], 500);
+}
+
+TEST_F(Playout, CountersAddUp) {
+	int got;
+	for (int i = 0; i < 40; i++) {
+		auto a = ramp(37 * (i % 5), 0);
+		wa_playout_push(&p, a.data(), static_cast<int>(a.size()));
+		pull(29, &got);
+	}
+	EXPECT_EQ(p.played + p.silence, 40u * 29u);
+	EXPECT_EQ(p.pushed, p.played + p.dropped + static_cast<unsigned long long>(p.fill));
+}
+
+TEST_F(Playout, ResetEmptiesAndRestartsBuffering) {
+	auto a = ramp(200, 1);
+	wa_playout_push(&p, a.data(), 200);
+	int got;
+	pull(10, &got);
+	ASSERT_EQ(got, 10);
+	wa_playout_reset(&p);
+	EXPECT_EQ(p.fill, 0);
+	EXPECT_EQ(p.pushed, 0u);
+	pull(10, &got);
+	EXPECT_EQ(got, 0);
+}
+
+TEST(PlayoutInit, ClampsLimits) {
+	wa_playout q;
+	wa_playout_init(&q, -5, WA_PLAYOUT_CAP * 2);
+	EXPECT_EQ(q.prefill, 0);
+	EXPECT_EQ(q.max_fill, WA_PLAYOUT_CAP);
+	wa_playout_destroy(&q);
+	wa_playout_init(&q, 200, 100);
+	EXPECT_EQ(q.max_fill, 200);
+	wa_playout_destroy(&q);
+}
+
+// Producer and consumer on two threads, as in a call: samples come out in order (TSan target).
+TEST(PlayoutThreads, ConcurrentPushPullKeepsOrder) {
+	static wa_playout q;
+	wa_playout_init(&q, 64, WA_PLAYOUT_CAP);
+	std::atomic<bool> done{false};
+	const int total = 200000;
+	std::thread prod([&] {
+		short buf[96];
+		int next = 1;
+		while (next <= total) {
+			int n = 0;
+			for (; n < 96 && next <= total; n++) buf[n] = static_cast<short>(next++ % 30000 + 1);
+			for (;;) { // back-pressure, so the test checks ordering rather than max_fill drops
+				pthread_mutex_lock(&q.mx);
+				int fill = q.fill;
+				pthread_mutex_unlock(&q.mx);
+				if (fill < WA_PLAYOUT_CAP / 2) break;
+				std::this_thread::yield();
+			}
+			wa_playout_push(&q, buf, n);
+		}
+		done = true;
+	});
+	int expect = 1, seen = 0;
+	short out[50];
+	while (seen < total) {
+		int got = wa_playout_pull(&q, out, 50);
+		for (int i = 0; i < got; i++) {
+			ASSERT_EQ(out[i], static_cast<short>(expect % 30000 + 1));
+			expect++;
+		}
+		seen += got;
+	}
+	prod.join();
+	EXPECT_EQ(q.dropped, 0u);
+	wa_playout_destroy(&q);
+}
+
+} // namespace

-		if (f < -1.0f) f = -1.0f;
-		buf[i] = (short)(f * 32767.0f);
+	while (n > 0) {
+		int m = n > 2048 ? 2048 : n;
+		for (int i = 0; i < m; i++) {
+			float f = frame[i];
+			if (f > 1.0f) f = 1.0f;
+			if (f < -1.0f) f = -1.0f;
+			buf[i] = (short)(f * 32767.0f);
+		}
+		wa_playout_push(&g_playout, buf, m);
+		frame += m;
+		n -= m;
 	}
-	wa_aec_farend(buf, n); // this is exactly what hits the loudspeaker -> AECM's echo reference
-	if (AEC_CALIB) far_push(buf, n); // calibration: mirror it into the ring for the aligned dump
-	snd_pcm_sframes_t w = snd_pcm_writei(h, buf, n);
-	if (w < 0) snd_pcm_recover(h, (int)w, 1);
 }
 
 // Tell audiod there's an active voip call so it enables the phone scenario.
@@ -871,6 +945,10 @@ void gowhatsapp_call_audio_active(int on) {
 			fprintf(stderr, "wa-call: AEC_CALIB mic=%p farend=%p\n", (void*)g_dump_capraw, (void*)g_dump_farend);
 		}
 		g_idle_add(audiod_status_idle, GINT_TO_POINTER(1));
+		pthread_once(&g_playout_once, playout_init_once);
+		wa_playout_reset(&g_playout); // nothing left over from a previous call
+		g_play_thread_started = pthread_create(&g_play_thread, NULL, playback_thread, NULL) == 0;
+		if (!g_play_thread_started) fprintf(stderr, "wa-call: cannot start the playback thread\n");
 		pthread_create(&g_cap_thread, NULL, audio_thread, NULL);
 	} else if (!on && g_audio_on) {
 		g_idle_add(audiod_status_idle, GINT_TO_POINTER(0));
@@ -884,9 +962,11 @@ void gowhatsapp_call_audio_active(int on) {
 			snd_pcm_close(g_cap);
 			g_cap = NULL;
 		}
-		snd_pcm_t *p = g_play;
-		g_play = NULL;
-		if (p) snd_pcm_close(p);
+		// Returns within one write; the thread closes its own playback device.
+		if (g_play_thread_started) {
+			pthread_join(g_play_thread, NULL);
+			g_play_thread_started = 0;
+		}
 		// capture thread joined + Go has stopped pulling: safe to close the dump files
 		if (g_dump_capraw) { fclose(g_dump_capraw); g_dump_capraw = NULL; }
 		if (g_dump_send)   { fclose(g_dump_send);   g_dump_send = NULL; }
diff --git a/glue/playout.c b/glue/playout.c
new file mode 100644
index 0000000..7522de4
--- /dev/null
+++ b/glue/playout.c
@@ -0,0 +1,98 @@
+#include "playout.h"
+#include <string.h>
+
+static int clamp_samples(int v) {
+	if (v < 0) return 0;
+	if (v > WA_PLAYOUT_CAP) return WA_PLAYOUT_CAP;
+	return v;
+}
+
+static void reset_locked(wa_playout *p) {
+	p->head = 0;
+	p->fill = 0;
+	p->buffering = 1;
+	p->waited = 0;
+	p->pushed = p->played = p->silence = p->dropped = 0;
+	p->underflows = 0;
+}
+
+void wa_playout_init(wa_playout *p, int prefill, int max_fill) {
+	memset(p->buf, 0, sizeof p->buf);
+	pthread_mutex_init(&p->mx, NULL);
+	p->prefill = clamp_samples(prefill);
+	p->max_fill = clamp_samples(max_fill);
+	if (p->max_fill < p->prefill) p->max_fill = p->prefill;
+	reset_locked(p);
+}
+
+void wa_playout_destroy(wa_playout *p) {
+	pthread_mutex_destroy(&p->mx);
+}
+
+void wa_playout_reset(wa_playout *p) {
+	pthread_mutex_lock(&p->mx);
+	reset_locked(p);
+	pthread_mutex_unlock(&p->mx);
+}
+
+void wa_playout_push(wa_playout *p, const short *s, int n) {
+	if (n <= 0) return;
+	pthread_mutex_lock(&p->mx);
+	p->pushed += (unsigned long long)n;
+	// Of a push larger than the ring itself only the newest samples can be kept.
+	if (n > WA_PLAYOUT_CAP) {
+		p->dropped += (unsigned long long)(n - WA_PLAYOUT_CAP);
+		s += n - WA_PLAYOUT_CAP;
+		n = WA_PLAYOUT_CAP;
+	}
+	// Make room: drop the oldest queued samples so that at most max_fill remain after the push
+	// (and never more than the ring holds).
+	int limit = p->max_fill > n ? p->max_fill : n;
+	int over = p->fill + n - limit;
+	if (over > 0) {
+		if (over > p->fill) over = p->fill;
+		p->head = (p->head + over) % WA_PLAYOUT_CAP;
+		p->fill -= over;
+		p->dropped += (unsigned long long)over;
+	}
+	int tail = (p->head + p->fill) % WA_PLAYOUT_CAP;
+	int first = WA_PLAYOUT_CAP - tail;
+	if (first > n) first = n;
+	memcpy(p->buf + tail, s, (size_t)first * sizeof *s);
+	memcpy(p->buf, s + first, (size_t)(n - first) * sizeof *s);
+	p->fill += n;
+	pthread_mutex_unlock(&p->mx);
+}
+
+int wa_playout_pull(wa_playout *p, short *out, int n) {
+	if (n <= 0) return 0;
+	int got = 0;
+	pthread_mutex_lock(&p->mx);
+	// Play on once the prefill is queued, or once queued audio has waited as long as the prefill
+	// would take to arrive: a lone frame at the end of a talkspurt is not held back until the
+	// next one comes in.
+	if (p->buffering && p->fill > 0 && (p->fill >= p->prefill || p->waited >= p->prefill)) {
+		p->buffering = 0;
+		p->waited = 0;
+	}
+	if (!p->buffering) {
+		got = p->fill < n ? p->fill : n;
+		int first = WA_PLAYOUT_CAP - p->head;
+		if (first > got) first = got;
+		memcpy(out, p->buf + p->head, (size_t)first * sizeof *out);
+		memcpy(out + first, p->buf, (size_t)(got - first) * sizeof *out);
+		p->head = (p->head + got) % WA_PLAYOUT_CAP;
+		p->fill -= got;
+		p->played += (unsigned long long)got;
+		if (got < n) { // ran dry: collect the prefill again before playing on
+			p->buffering = 1;
+			p->underflows++;
+		}
+	} else if (p->fill > 0) {
+		p->waited += n;
+	}
+	p->silence += (unsigned long long)(n - got);
+	pthread_mutex_unlock(&p->mx);
+	memset(out + got, 0, (size_t)(n - got) * sizeof *out);
+	return got;
+}
diff --git a/glue/playout.h b/glue/playout.h
new file mode 100644
index 0000000..ea4db6c
--- /dev/null
+++ b/glue/playout.h
@@ -0,0 +1,52 @@
+#ifndef WA_PLAYOUT_H
+#define WA_PLAYOUT_H
+// webOS WhatsApp calling: the playout buffer between the decoder and the loudspeaker.
+//
+// meowcaller hands over a decoded frame (60 ms) whenever a packet arrives, which is irregular:
+// the relay delivers in bursts, and the peer sends nothing at all while it is silent (DTX).
+// The ALSA playback device, on the other hand, has to be written at its own pace: once the
+// pulse plug-in's stream runs dry it reports an underrun, and recovering from that recreates
+// the PulseAudio stream (a new sink-input, re-routed by palm-policy) and waits for the buffer to
+// fill again before anything is heard.
+//
+// The decoder pushes into this ring; the playback thread pulls fixed chunks from it at device
+// pace and gets silence for whatever the ring cannot supply. After the ring has run dry it
+// first collects `prefill` samples again, or waits as long as those would take, so arrival
+// jitter of up to that much does not chop every frame. `max_fill` bounds the delay a burst can
+// build up: older samples beyond it are dropped.
+//
+// Push and pull may run on different threads; the ring has its own lock.
+#include <pthread.h>
+
+#define WA_PLAYOUT_CAP 16000 // 1 s of 16 kHz mono
+
+typedef struct {
+	short buf[WA_PLAYOUT_CAP];
+	int head;      // next sample to play
+	int fill;      // samples queued
+	int prefill;   // samples to collect before playing again after running dry
+	int max_fill;  // queued samples beyond this are dropped, oldest first
+	int buffering; // 1 while collecting the prefill
+	int waited;    // silence pulled while buffering with audio queued
+	// Counters, for the end-of-call log line and the tests.
+	unsigned long long pushed;      // samples handed to push
+	unsigned long long played;      // queued samples pull returned
+	unsigned long long silence;     // samples pull filled with zeros
+	unsigned long long dropped;     // samples discarded to stay within max_fill
+	unsigned long underflows;       // times the ring ran dry while playing
+	pthread_mutex_t mx;
+} wa_playout;
+
+// Sets up an empty ring. prefill and max_fill are clamped to 0..WA_PLAYOUT_CAP, and max_fill
+// to at least prefill.
+void wa_playout_init(wa_playout *p, int prefill, int max_fill);
+void wa_playout_destroy(wa_playout *p);
+// Empties the ring and zeroes the counters, keeping prefill and max_fill.
+void wa_playout_reset(wa_playout *p);
+// Queues n samples.
+void wa_playout_push(wa_playout *p, const short *s, int n);
+// Writes exactly n samples to out: queued audio first, zeros for the rest. Returns how many
+// of them were queued audio.
+int wa_playout_pull(wa_playout *p, short *out, int n);
+
+#endif
diff --git a/glue/tests/Makefile b/glue/tests/Makefile
new file mode 100644
index 0000000..cb9bfe0
--- /dev/null
+++ b/glue/tests/Makefile
@@ -0,0 +1,39 @@
+# Unit tests for the call audio playout (glue/playout.c) and glue/call.c's playback thread,
+# which runs against fakes.c's ALSA device instead of a real one. Needs gtest, and the glib,
+# luna-service2 and alsa-lib headers (luna-service2 and ALSA are not linked: fakes.c replaces
+# what call.c uses of them). Point CPPFLAGS/LDFLAGS at a sysroot when the host lacks them:
+#   make CPPFLAGS="-I$SYSROOT/usr/include -I$SYSROOT/usr/include/glib-2.0 \
+#                  -I$SYSROOT/usr/lib/glib-2.0/include" LDFLAGS="-L$SYSROOT/usr/lib"
+#   make check
+# SAN="-fsanitize=address,undefined" or SAN=-fsanitize=thread builds them sanitized.
+CC ?= cc
+CXX ?= c++
+GLUE := ..
+CFLAGS ?= -O1 -g -Wall -Wextra
+CXXFLAGS ?= -O1 -g -Wall -Wextra
+SAN ?=
+INC := -I$(GLUE) -I. -Ifakes
+LIBS := -lgtest -lgtest_main -lglib-2.0 -lpthread -lm
+
+all: playout_test call_playback_test
+
+playout_test: playout_test.cpp $(GLUE)/playout.c $(GLUE)/playout.h
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/playout.c -o playout.o
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) playout_test.cpp playout.o -o $@ $(LDFLAGS) $(LIBS)
+
+# PLUGIN_VERSION only matters to init.c; call.c is compiled as the recipe does otherwise.
+call_playback_test: call_playback_test.cpp fakes.c fakes.h $(GLUE)/call.c $(GLUE)/playout.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/playout.c -o playout.o
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/call.c -o call.o
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c fakes.c -o fakes.o
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) call_playback_test.cpp call.o playout.o fakes.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
+check: all
+	./playout_test
+	./call_playback_test
+
+clean:
+	rm -f *.o playout_test call_playback_test
+
+.PHONY: all check clean
diff --git a/glue/tests/call_playback_test.cpp b/glue/tests/call_playback_test.cpp
new file mode 100644
index 0000000..7c0a567
--- /dev/null
+++ b/glue/tests/call_playback_test.cpp
@@ -0,0 +1,142 @@
+// Tests glue/call.c's playback path against a fake ALSA device (tests/fakes.c): the device is
+// written continuously from the moment the call audio opens, whatever the packet arrival, the
+// stream is opened once, and AECM's far-end reference is exactly what was written.
+#include <gtest/gtest.h>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#include "fakes.h"
+
+namespace {
+
+using namespace std::chrono;
+
+// Real-time milliseconds scaled to the fake device's pace.
+void wait_ms(int ms) { std::this_thread::sleep_for(milliseconds(ms / FAKE_SPEEDUP)); }
+
+// One decoded 60 ms frame with recognisable non-zero samples.
+std::vector<float> frame(int seq) {
+	std::vector<float> f(960);
+	for (int i = 0; i < 960; i++) f[i] = static_cast<float>(1 + (seq * 960 + i) % 20000) / 32767.0f;
+	return f;
+}
+short as_written(float f) { return static_cast<short>(f * 32767.0f); }
+
+long written_n() {
+	fake_lock();
+	long n = fake.written_n;
+	fake_unlock();
+	return n;
+}
+
+class CallPlayback : public ::testing::Test {
+protected:
+	void SetUp() override { fake_reset(); }
+	void TearDown() override { gowhatsapp_call_audio_active(0); }
+};
+
+TEST_F(CallPlayback, SilenceKeepsTheDeviceRunning) {
+	gowhatsapp_call_audio_active(1);
+	wait_ms(400); // no packets at all, like a peer in DTX
+	long mid = written_n();
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	EXPECT_GT(mid, 16000 * 200 / 1000) << "the device must be written while nothing arrives";
+	EXPECT_GT(fake.written_n, mid);
+	for (long i = 0; i < fake.written_n; i++) ASSERT_EQ(fake.written[i], 0);
+	EXPECT_EQ(fake.playback_opens, 1);
+	EXPECT_EQ(fake.recovers, 0);
+}
+
+TEST_F(CallPlayback, GappedArrivalPlaysEverythingInOrderWithOneStream) {
+	gowhatsapp_call_audio_active(1);
+	std::vector<short> sent;
+	int seq = 0;
+	// Bursts of 1-3 frames separated by 150-500 ms gaps (relay jitter, DTX).
+	const int bursts[][2] = {{2, 150}, {1, 300}, {3, 500}, {1, 200}, {2, 450}, {3, 250}, {1, 400}};
+	for (auto &b : bursts) {
+		for (int k = 0; k < b[0]; k++, seq++) {
+			auto f = frame(seq);
+			gowhatsapp_call_on_speaker(f.data(), static_cast<int>(f.size()));
+			for (float v : f) sent.push_back(as_written(v));
+		}
+		wait_ms(b[1]);
+	}
+	wait_ms(600); // let the ring drain
+	gowhatsapp_call_audio_active(0);
+
+	EXPECT_EQ(fake.playback_opens, 1);
+	EXPECT_EQ(fake.closes, 2) << "playback and capture, once each, at the end";
+	EXPECT_EQ(fake.recovers, 0) << "no underrun, so the stream was never recreated";
+	// Every decoded sample reaches the device, in order, with only silence in between.
+	std::vector<short> played;
+	for (long i = 0; i < fake.written_n; i++)
+		if (fake.written[i] != 0) played.push_back(fake.written[i]);
+	EXPECT_EQ(played, sent);
+	// The device ran for the whole call, not just while packets came in.
+	EXPECT_GT(fake.written_n, static_cast<long>(sent.size()) + 16000);
+}
+
+TEST_F(CallPlayback, FarEndReferenceIsExactlyWhatWasWritten) {
+	gowhatsapp_call_audio_active(1);
+	for (int s = 0; s < 6; s++) {
+		auto f = frame(s);
+		gowhatsapp_call_on_speaker(f.data(), static_cast<int>(f.size()));
+		wait_ms(s % 2 ? 250 : 60);
+	}
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	ASSERT_GT(fake.written_n, 0);
+	EXPECT_EQ(fake.farend_bad_len, 0);
+	ASSERT_EQ(fake.farend_n, fake.written_n);
+	EXPECT_EQ(0, memcmp(fake.farend, fake.written, sizeof(short) * fake.written_n));
+}
+
+TEST_F(CallPlayback, UnderrunIsRecoveredAndPlaybackContinues) {
+	gowhatsapp_call_audio_active(1);
+	wait_ms(100);
+	fake_lock();
+	fake.inject_epipe = 1;
+	fake_unlock();
+	auto f = frame(7);
+	gowhatsapp_call_on_speaker(f.data(), 960);
+	gowhatsapp_call_on_speaker(f.data(), 960);
+	wait_ms(500);
+	long mid = written_n();
+	wait_ms(200);
+	gowhatsapp_call_audio_active(0);
+	EXPECT_EQ(fake.recovers, 1);
+	EXPECT_EQ(fake.playback_opens, 1);
+	EXPECT_GT(fake.written_n, mid);
+	ASSERT_EQ(fake.farend_n, fake.written_n) << "the failed chunk is rewritten, then referenced once";
+	EXPECT_EQ(0, memcmp(fake.farend, fake.written, sizeof(short) * fake.written_n));
+	long nonzero = 0;
+	for (long i = 0; i < fake.written_n; i++) nonzero += fake.written[i] != 0;
+	EXPECT_EQ(nonzero, 2 * 960);
+}
+
+TEST_F(CallPlayback, FramesOutsideACallAreNotQueued) {
+	auto f = frame(1);
+	gowhatsapp_call_on_speaker(f.data(), 960); // ringing: audio path not open
+	gowhatsapp_call_audio_active(1);
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	for (long i = 0; i < fake.written_n; i++) ASSERT_EQ(fake.written[i], 0);
+}
+
+TEST_F(CallPlayback, SecondCallStartsFromAnEmptyRing) {
+	gowhatsapp_call_audio_active(1);
+	auto f = frame(3);
+	for (int i = 0; i < 4; i++) gowhatsapp_call_on_speaker(f.data(), 960);
+	gowhatsapp_call_audio_active(0); // ends at once, audio still queued
+	fake_reset();
+	gowhatsapp_call_audio_active(1);
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	for (long i = 0; i < fake.written_n; i++) ASSERT_EQ(fake.written[i], 0);
+	EXPECT_EQ(fake.playback_opens, 1);
+}
+
+} // namespace

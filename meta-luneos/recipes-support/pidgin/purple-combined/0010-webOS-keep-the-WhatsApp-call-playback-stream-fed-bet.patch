+static pthread_t g_play_thread;  // peer -> speaker, see playback_thread
+static int g_play_thread_started = 0;
+// Atomic: the Go threads, the capture and playback threads and the mainloop all read it.
+static _Atomic int g_audio_on = 0;
+
+/* Playback. The peer's audio is not written to ALSA as it arrives: packets come in bursts and
+ * stop altogether while the peer is silent (DTX), and every time the pulse plug-in's stream ran
+ * dry it reported an underrun, snd_pcm_recover's prepare disconnected the stream and connected a
+ * new one (a new sink-input for palm-policy to route and audiod to set up), and nothing played
+ * until the buffer had filled again. Observed on the mindphone as the voipcall sink-input being
+ * closed and reopened about once a second through a call, with choppy or no incoming audio.
+ * Instead gowhatsapp_call_on_speaker queues the decoded frames in g_playout and playback_thread
+ * writes to the device at its own pace, with silence wherever the ring cannot supply audio, so
+ * the one stream opened for the call keeps running until the call ends. */
+#define WA_PLAY_LATENCY_US 120000 /* ALSA buffer; WA_AEC_DELAY_MS was measured with this size */
+#define WA_PLAY_CHUNK 320         /* 20ms per write; a multiple of AECM's 160-sample block */
+#define WA_PLAY_PREFILL 1920      /* 120ms (two MLow frames) collected before playing after the
+                                   * ring ran dry: absorbs the relay's arrival jitter */
+#define WA_PLAY_MAX_FILL 5760     /* 360ms: a burst beyond this drops its oldest samples, so a
+                                   * network stall cannot leave the call permanently delayed */
+static wa_playout g_playout;
+static pthread_once_t g_playout_once = PTHREAD_ONCE_INIT;
+static void playout_init_once(void) {
+	wa_playout_init(&g_playout, WA_PLAY_PREFILL, WA_PLAY_MAX_FILL);
+}
 
 /* ---- CALL_DUMP: ground-truth capture of the LIVE call audio (the call-scenario mic differs from a
  * standalone arecord — audiod switches routing/DSP when a call is active, which the offline PESQ test
@@ -708,15 +734,60 @@ static snd_pcm_t *pcm_open(const char *dev, snd_pcm_stream_t dir, unsigned int l
 	return h;
 }
 
-// Capture thread: pure C. Opens both ALSA devices (off the mainloop — snd_pcm_open
-// on the pulse plugin can block) then reads mic -> ring buffer. Never calls into Go.
+// Playback thread: pure C. Opens the ALSA playback device (off the mainloop: snd_pcm_open on
+// the pulse plug-in can block) and keeps it fed for the whole call, pulling a chunk from the
+// playout ring per write and blocking in snd_pcm_writei until the device has room for it. What
+// was written is handed to AECM as the echo reference, silence included, so the reference
+// follows the loudspeaker's clock rather than packet arrival. Never calls into Go.
+static void *playback_thread(void *arg) {
+	(void)arg;
+	snd_pcm_t *h = pcm_open("voip", SND_PCM_STREAM_PLAYBACK, WA_PLAY_LATENCY_US);
+	fprintf(stderr, "wa-call: audio %s\n", h ? "playback-ok" : "playback-FAIL");
+	if (!h) return NULL;
+	short buf[WA_PLAY_CHUNK];
+	unsigned long recovers = 0;
+	while (g_audio_on) {
+		wa_playout_pull(&g_playout, buf, WA_PLAY_CHUNK);
+		int off = 0;
+		while (off < WA_PLAY_CHUNK && g_audio_on) {
+			snd_pcm_sframes_t w = snd_pcm_writei(h, buf + off, (snd_pcm_uframes_t)(WA_PLAY_CHUNK - off));
+			if (w > 0) {
+				off += (int)w;
+				continue;
+			}
+			if (w == 0 || w == -EAGAIN) { // no room yet (not expected in blocking mode)
+				snd_pcm_wait(h, 100);
+				continue;
+			}
+			// Only reached if this thread was kept off the CPU for longer than the buffer: the
+			// recovery prepares the stream, which the pulse plug-in does by recreating it.
+			recovers++;
+			int err = snd_pcm_recover(h, (int)w, 1);
+			fprintf(stderr, "wa-call: playback write failed (%s), recover %s (stream recreated %lu times)\n",
+			        snd_strerror((int)w), err < 0 ? snd_strerror(err) : "ok", recovers);
+			if (err < 0) g_usleep(20000); // do not spin on a dead device; retried until the call ends
+		}
+		if (off == WA_PLAY_CHUNK) {
+			wa_aec_farend(buf, WA_PLAY_CHUNK); // exactly what the loudspeaker gets -> AECM's echo reference
+			if (AEC_CALIB) far_push(buf, WA_PLAY_CHUNK); // calibration: mirror it into the ring for the aligned dump
+		}
+	}
+	snd_pcm_drop(h);
+	snd_pcm_close(h);
+	pthread_mutex_lock(&g_playout.mx);
+	fprintf(stderr, "wa-call: playback done: %llu samples played, %llu silence, %llu dropped, "
+	        "%lu ring underflows, %lu stream recoveries\n",
+	        g_playout.played, g_playout.silence, g_playout.dropped, g_playout.underflows, recovers);
+	pthread_mutex_unlock(&g_playout.mx);
+	return NULL;
+}
+
+// Capture thread: pure C. Opens the ALSA capture device (off the mainloop) then reads
+// mic -> ring buffer. Never calls into Go.
 static void *audio_thread(void *arg) {
 	(void)arg;
-	g_play = pcm_open("voip", SND_PCM_STREAM_PLAYBACK, 120000);   // keep playback headroom (60ms Opus frames) -> no underrun/choppy

index 0000000..5cebe7f
--- /dev/null
+++ b/glue/tests/fakes.c
@@ -0,0 +1,156 @@
+#include "fakes.h"
+#include <alsa/asoundlib.h>
+#include <luna-service2/lunaservice.h>
+#include <errno.h>
+#include <pthread.h>
+#include <string.h>
+#include <time.h>
+#include "libwhatsmeow.h"
+#include "voipkit.h"
+#include "aec.h"
+#include "denoise.h"
+
+struct fake_state fake;
+static pthread_mutex_t fake_mx = PTHREAD_MUTEX_INITIALIZER;
+void fake_lock(void) { pthread_mutex_lock(&fake_mx); }
+void fake_unlock(void) { pthread_mutex_unlock(&fake_mx); }
+void fake_reset(void) {
+	fake_lock();
+	memset(&fake, 0, sizeof fake);
+	fake_unlock();
+}
+
+static void sleep_frames(long frames) {
+	long us = frames * 1000000L / 16000 / FAKE_SPEEDUP;
+	struct timespec ts = { us / 1000000L, (us % 1000000L) * 1000L };
+	nanosleep(&ts, NULL);
+}
+
+/* ---- ALSA ---- */
+static int dev_play, dev_cap; // distinct addresses stand in for the handles
+int snd_pcm_open(snd_pcm_t **pcm, const char *name, snd_pcm_stream_t stream, int mode) {
+	(void)name; (void)mode;
+	fake_lock();
+	if (stream == SND_PCM_STREAM_PLAYBACK) {
+		fake.playback_opens++;
+		*pcm = (snd_pcm_t *)&dev_play;
+	} else {
+		fake.capture_opens++;
+		*pcm = (snd_pcm_t *)&dev_cap;
+	}
+	fake_unlock();
+	return 0;
+}
+int snd_pcm_set_params(snd_pcm_t *pcm, snd_pcm_format_t format, snd_pcm_access_t access,
+                       unsigned int channels, unsigned int rate, int soft_resample,
+                       unsigned int latency) {
+	(void)pcm; (void)format; (void)access; (void)channels; (void)rate; (void)soft_resample;
+	(void)latency;
+	return 0;
+}
+snd_pcm_sframes_t snd_pcm_writei(snd_pcm_t *pcm, const void *buffer, snd_pcm_uframes_t size) {
+	if (pcm != (snd_pcm_t *)&dev_play) return -EBADFD;
+	fake_lock();
+	if (fake.inject_epipe > 0) {
+		fake.inject_epipe--;
+		fake_unlock();
+		return -EPIPE;
+	}
+	// Accept at most one 20 ms period per call, as a device with little room would.
+	long n = (long)size > 320 ? 320 : (long)size;
+	if (fake.written_n + n <= FAKE_MAX_SAMPLES) {
+		memcpy(fake.written + fake.written_n, buffer, (size_t)n * sizeof(short));
+		fake.written_n += n;
+	}
+	fake_unlock();
+	sleep_frames(n); // blocking write: returns once the device has played that much
+	return n;
+}
+snd_pcm_sframes_t snd_pcm_readi(snd_pcm_t *pcm, void *buffer, snd_pcm_uframes_t size) {
+	(void)pcm;
+	memset(buffer, 0, size * sizeof(short));
+	sleep_frames((long)size);
+	return (snd_pcm_sframes_t)size;
+}
+int snd_pcm_recover(snd_pcm_t *pcm, int err, int silent) {
+	(void)pcm; (void)silent;
+	fake_lock();
+	fake.recovers++;
+	fake_unlock();
+	return err == -EPIPE ? 0 : err;
+}
+int snd_pcm_wait(snd_pcm_t *pcm, int timeout) { (void)pcm; (void)timeout; return 1; }
+int snd_pcm_drop(snd_pcm_t *pcm) { (void)pcm; fake_lock(); fake.drops++; fake_unlock(); return 0; }
+int snd_pcm_close(snd_pcm_t *pcm) { (void)pcm; fake_lock(); fake.closes++; fake_unlock(); return 0; }
+const char *snd_strerror(int errnum) { (void)errnum; return "fake error"; }
+
+/* ---- AECM / NS ---- */
+void wa_aec_start(int fs, int delay_ms) { (void)fs; (void)delay_ms; }
+void wa_aec_farend(const short *f, int n) {
+	fake_lock();
+	if (n % 160) fake.farend_bad_len++;
+	if (fake.farend_n + n <= FAKE_MAX_SAMPLES) {
+		memcpy(fake.farend + fake.farend_n, f, (size_t)n * sizeof(short));
+		fake.farend_n += n;
+	}
+	fake_unlock();
+}
+void wa_aec_process(short *mic, int n) { (void)mic; (void)n; }
+void wa_aec_stop(void) {}
+void wa_ns_start(int fs) { (void)fs; }
+void wa_ns_process(short *buf, int n) { (void)buf; (void)n; }
+void wa_ns_stop(void) {}
+
+/* ---- voipkit ---- */
+void voipkit_video_start(void) {}
+int voipkit_video_wait_thread_b(int timeoutMs) { (void)timeoutMs; return 1; }
+void voipkit_video_stop(void) {}
+void voipkit_video_receive_frame(const unsigned char *access_unit, unsigned int len) {
+	(void)access_unit; (void)len;
+}
+
+/* ---- Go exports ---- */
+char *gowhatsapp_go_call_dial(char *cAddr, int video) { (void)cAddr; (void)video; return NULL; }
+int gowhatsapp_go_call_answer(char *cID, int video) { (void)cID; (void)video; return 0; }
+int gowhatsapp_go_call_hangup_all(void) { return 0; }
+int gowhatsapp_go_call_changemedia(char *cID, int a, int b, int c, int d) {
+	(void)cID; (void)a; (void)b; (void)c; (void)d;
+	return 0;
+}
+int gowhatsapp_go_call_hangup(char *cID) { (void)cID; return 0; }
+
+/* ---- luna-service2: calls only get as far as these and fail quietly ---- */
+bool LSErrorInit(LSError *e) { memset(e, 0, sizeof *e); return true; }
+void LSErrorFree(LSError *e) { (void)e; }
+bool LSMessageReply(LSHandle *sh, LSMessage *msg, const char *payload, LSError *e) {
+	(void)sh; (void)msg; (void)payload; (void)e;
+	return true;
+}
+const char *LSMessageGetPayload(LSMessage *msg) { (void)msg; return "{}"; }
+bool LSCallOneReply(LSHandle *sh, const char *uri, const char *payload, LSFilterFunc cb,
+                    void *ctx, LSMessageToken *t, LSError *e) {
+	(void)sh; (void)uri; (void)payload; (void)cb; (void)ctx; (void)t; (void)e;
+	return true;
+}
+bool LSSubscriptionReply(LSHandle *sh, const char *key, const char *payload, LSError *e) {
+	(void)sh; (void)key; (void)payload; (void)e;
+	return true;
+}
+bool LSSubscriptionAdd(LSHandle *sh, const char *key, LSMessage *msg, LSError *e) {
+	(void)sh; (void)key; (void)msg; (void)e;
+	return true;
+}
+bool LSRegister(const char *name, LSHandle **sh, LSError *e) {
+	(void)name; (void)sh; (void)e;
+	return false;
+}
+bool LSRegisterCategory(LSHandle *sh, const char *category, LSMethod *methods,
+                        LSSignal *signals, LSProperty *props, LSError *e) {
+	(void)sh; (void)category; (void)methods; (void)signals; (void)props; (void)e;
+	return false;
+}
+bool LSGmainContextAttach(LSHandle *sh, GMainContext *ctx, LSError *e) {
+	(void)sh; (void)ctx; (void)e;
+	return false;
+}
+bool LSUnregister(LSHandle *sh, LSError *e) { (void)sh; (void)e; return true; }
diff --git a/glue/tests/fakes.h b/glue/tests/fakes.h
new file mode 100644
index 0000000..a81a4c5
--- /dev/null
+++ b/glue/tests/fakes.h
@@ -0,0 +1,34 @@
+// Fakes glue/call.c is linked against in call_playback_test: a fake ALSA device that records what
+// is written to it at a scaled device pace, AECM that records its far-end reference, and no-op
+// luna-service2, voipkit and Go exports.
+#ifndef WA_TEST_FAKES_H
+#define WA_TEST_FAKES_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FAKE_MAX_SAMPLES (16000 * 60) /* one minute at 16 kHz */
+#define FAKE_SPEEDUP 4                /* the fake device consumes 4x faster than real time */
+
+struct fake_state {
+	int playback_opens, capture_opens, closes, drops, recovers;
+	int inject_epipe;       // next N playback writes fail with -EPIPE
+	long written_n;         // samples accepted by the playback device
+	short written[FAKE_MAX_SAMPLES];
+	long farend_n;          // samples handed to wa_aec_farend
+	short farend[FAKE_MAX_SAMPLES];
+	int farend_bad_len;     // farend calls whose length was not a multiple of 160
+};
+extern struct fake_state fake;
+void fake_reset(void);
+void fake_lock(void);
+void fake_unlock(void);
+
+// glue/call.c's entry points the tests drive.
+void gowhatsapp_call_audio_active(int on);
+void gowhatsapp_call_on_speaker(const float *frame, int n);
+
+#ifdef __cplusplus
+}
+#endif
+#endif

 }
 
 TEST_F(CallVideo, ThePhoneAppLearnsWhereThePictureIs) {
@@ -144,6 +147,31 @@ TEST_F(CallVideo, ThePhoneAppLearnsWhereThePictureIs) {
 	EXPECT_FALSE(has(r, "videoWidth")) << r;
 }
 
+// While we send, the Phone app also learns where our own picture is, and how to show it.
+TEST_F(CallVideo, ThePhoneAppLearnsWhereOurOwnPictureIs) {
+	want_video();
+	fake_reply(find_engine_call("capabilities"),
+	           "{\"returnValue\":true,\"videoCallCapable\":true,\"cameraCount\":2}");
+	int start = find_engine_call("start");
+	ASSERT_GE(start, 0);
+	EXPECT_TRUE(has(payload_of(start), "\"previewShmPath\":\"/tmp/wa-rtc-preview\"")) << payload_of(start);
+	fake_reply(start, "{\"returnValue\":true,\"txSocket\":\"/tmp/wa-rtc-tx.sock\","
+	                  "\"rxSocket\":\"/tmp/wa-rtc-rx.sock\"}");
+	pump();
+	std::string r = fake.last_subscription_reply;
+	EXPECT_TRUE(has(r, "\"videoPreviewURI\":\"/tmp/wa-rtc-preview\",\"videoPreviewWidth\":320,"
+	                   "\"videoPreviewHeight\":240,\"videoPreviewOrientation\":1,"
+	                   "\"videoPreviewMirrored\":true"))
+		<< r;
+}
+
+TEST_F(CallVideo, NoOwnPictureWhenReceivingOnly) {
+	want_video();
+	int start = bring_up(false);
+	EXPECT_TRUE(has(payload_of(start), "\"previewShmPath\":\"\"")) << payload_of(start);
+	EXPECT_FALSE(has(fake.last_subscription_reply, "videoPreviewURI")) << fake.last_subscription_reply;
+}
+
 TEST_F(CallVideo, TurningTheViewOffStopsTheEngine) {
 	want_video();
 	bring_up(false);
@@ -206,6 +234,27 @@ TEST_F(CallVideo, AnOldStartAnswerIsNotTakenForTheNewSession) {
 	EXPECT_EQ(fake.video_starts, 1) << "the new session still comes up";
 }
 
+// A video call shows the user's face: with a front and a back camera the front one
+// (HAL id 1) is opened, with a single camera that one.
+TEST_F(CallVideo, TheFrontCameraIsUsedWhereThereAreTwo) {
+	want_video();
+	fake_reply(find_engine_call("capabilities"),
+	           "{\"returnValue\":true,\"videoCallCapable\":true,\"cameraCount\":2}");
+	int start = find_engine_call("start");
+	ASSERT_GE(start, 0);
+	EXPECT_TRUE(has(payload_of(start), "\"camera\":1")) << payload_of(start);
+	fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":false}");
+	pump();
+	fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":true}");
+	pump();
+	int caps = find_engine_call("capabilities", start + 1);
+	ASSERT_GE(caps, 0);
+	fake_reply(caps, "{\"returnValue\":true,\"videoCallCapable\":true,\"cameraCount\":1}");
+	int again = find_engine_call("start", start + 1);
+	ASSERT_GE(again, 0);
+	EXPECT_TRUE(has(payload_of(again), "\"camera\":0")) << payload_of(again);
+}
+
 TEST_F(CallVideo, ALateCapabilitiesAnswerStartsNothing) {
 	want_video();
 	int caps = find_engine_call("capabilities");
@@ -277,12 +326,17 @@ TEST_F(CallVideo, PeerKeyframeRequestsReachTheEncoderRateLimited) {
 	g_usleep(550 * 1000);
 	gowhatsapp_call_request_keyframe();
 	pump();
+	EXPECT_EQ(count_engine_calls("requestKeyframe"), 1) << "at most one a second";
+	g_usleep(500 * 1000);
+	gowhatsapp_call_request_keyframe();
+	pump();
 	EXPECT_EQ(count_engine_calls("requestKeyframe"), 2);
 }
 
 TEST_F(CallVideo, NoKeyframeRequestsWithoutAnEncoder) {
 	want_video();
 	bring_up(false);
+	EXPECT_EQ(fake.video_orientation_sets, 0) << "nothing of ours to turn";
 	g_usleep(550 * 1000);
 	gowhatsapp_call_request_keyframe();
 	pump();

index 4a3b674..0873831 100644
--- a/call.go
+++ b/call.go
@@ -75,8 +75,11 @@ type callInfo struct {
 	// streaming), "streaming" (peer video actively flowing). Driven by
 	// meowcaller's OnVideoState callback, see wireCall.
 	incomingVideoState string
-	cause              string
-	mic                *micSource
+	// incomingVideoOrientation is the peer's device orientation from its <video> stanzas,
+	// in quarter turns (0..3), as meowcaller's VideoState.Orientation reports it.
+	incomingVideoOrientation int
+	cause                    string
+	mic                      *micSource
 	// everActive latches true the first time this call reaches "active" (peer accepted) and is
 	// never cleared — state itself gets overwritten to "disconnected" on end (see setCallState),
 	// so callWasAnswered needs this separately to tell "answered then hung up" apart from "never
@@ -176,6 +179,9 @@ func emitCallState() {
 		IncomingVideo      bool   `json:"incomingVideo"`
 		OutgoingVideo      bool   `json:"outgoingVideo"`
 		IncomingVideoState string `json:"incomingVideoState"`
+		// The peer's device orientation in quarter turns (0..3); the Phone app turns the
+		// picture by it.
+		IncomingVideoOrientation int `json:"incomingVideoOrientation"`
 	}
 	callMu.Lock()
 	var cjs []callJSON
@@ -184,6 +190,7 @@ func emitCallState() {
 	lineIncomingVid := false
 	lineOutgoingVid := false
 	lineIVS := "unavailable"
+	lineOrientation := 0
 	for _, ci := range calls {
 		lineState = ci.state // single call per line: the line state IS the call state
 		cause = ci.cause
@@ -195,7 +202,7 @@ func emitCallState() {
 			ID: ci.id, Address: ci.address, DisplayName: ci.displayName,
 			Origin: ci.origin, OnHold: ci.state == "onHold",
 			IncomingVideo: ci.incomingVid, OutgoingVideo: ci.outgoingVid,
-			IncomingVideoState: ivs,
+			IncomingVideoState: ivs, IncomingVideoOrientation: ci.incomingVideoOrientation,
 		})
 		// ActiveCall.js reads outgoingVideo/incomingVideo/incomingVideoState directly on
 		// the LINE object (activeLines[0].outgoingVideo etc.), not nested under calls[] -
@@ -203,6 +210,7 @@ func emitCallState() {
 		lineIncomingVid = ci.incomingVid
 		lineOutgoingVid = ci.outgoingVid
 		lineIVS = ivs
+		lineOrientation = ci.incomingVideoOrientation
 	}
 	callMu.Unlock()
 
@@ -213,7 +221,7 @@ func emitCallState() {
 		line := map[string]any{
 			"state": lineState, "calls": cjs,
 			"incomingVideo": lineIncomingVid, "outgoingVideo": lineOutgoingVid,
-			"incomingVideoState": lineIVS,
+			"incomingVideoState": lineIVS, "incomingVideoOrientation": lineOrientation,
 		}
 		if lineState == "disconnected" {
 			line["disconnectDetails"] = map[string]any{"cause": cause}
@@ -286,9 +294,15 @@ func wireCall(mcCall *meowcaller.Call, origin string, address string) *callInfo
 	// camera/rendering, not the WhatsApp-level signaling this reflects).
 	mcCall.OnVideoState(func(vs meowcaller.VideoState) {
 		callMu.Lock()
-		var anyVideo bool
+		var anyVideo, known, outVid, inVid, mcVideo bool
 		if c, ok := calls[ci.id]; ok {
+			known = true
 			c.incomingVid = vs.Active
+			// Only a state with the peer's camera on carries its orientation; the
+			// upgrade handshake (state 4, 6, 11) says 0 and would turn the picture.
+			if vs.Active {
+				c.incomingVideoOrientation = vs.Orientation & 3
+			}
 			switch {
 			case vs.Active:
 				c.incomingVideoState = "streaming"
@@ -297,9 +311,16 @@ func wireCall(mcCall *meowcaller.Call, origin string, address string) *callInfo
 			default:
 				c.incomingVideoState = "unavailable"
 			}
-			anyVideo = c.outgoingVid || c.incomingVid || c.c.IsVideo()
+			outVid, inVid, mcVideo = c.outgoingVid, c.incomingVid, c.c.IsVideo()
+			anyVideo = outVid || inVid || mcVideo
 		}
 		callMu.Unlock()
+		if !known {
+			// The call is gone from the table: its OnEnd closes video. Turning
+			// video off here would close it under a call that is still up.
+			fmt.Fprintln(os.Stderr, "wacall: OnVideoState for an unknown call", ci.id, "state", vs.Raw)
+			return
+		}
 		// Same fix as gowhatsapp_go_call_dial/answer: the peer's video turning on (or
 		// being active from the initial offer, before changeMedia is ever called) must
 		// also open the local clonk session, or voipkit_video_receive_frame silently
@@ -313,8 +334,8 @@ func wireCall(mcCall *meowcaller.Call, origin string, address string) *callInfo
 		// tear down/rebuild the local clonk pipeline via gowhatsapp_call_video_active, which
 		// would visually look exactly like the reported flicker) in lockstep with the
 		// measured frame-arrival stalls, or whether it fires once and stays put.
-		fmt.Fprintln(os.Stderr, "wacall: OnVideoState id=", ci.id, "active=", vs.Active,
-			"anyVideo=", anyVideo, "ts_ms=", time.Now().UnixMilli())
+		fmt.Fprintln(os.Stderr, "wacall: OnVideoState id=", ci.id, "state=", vs.Raw, "active=", vs.Active,
+			"anyVideo=", anyVideo, "out=", outVid, "in=", inVid, "mc=", mcVideo, "ts_ms=", time.Now().UnixMilli())
 		if diagRec != nil {
 			diagRec.Emit("clonk", map[string]any{
 				"event": "on_video_state", "call_id": ci.id, "peer_active": vs.Active,
@@ -382,6 +403,16 @@ func callWasAnswered(id string) bool {
 	return ok && ci.everActive
 }
 
+// callWasIncoming reports whether call.go tracked this call as one rung in from the peer --
+// a 1:1 call the Phone app showed, which therefore has no chat message yet. Like
+// callWasAnswered it relies on the entry outliving the end of the call by a moment.
+func callWasIncoming(id string) bool {
+	callMu.Lock()
+	defer callMu.Unlock()
+	ci, ok := calls[id]
+	return ok && ci.origin == "incoming"
+}
+
 // callBubbleText returns the "call log" style chat bubble text for a call, keyed by whether
 // call.go has this call tracked as a video call (see callInfo.c.IsVideo()). Defaults to the
 // audio phrasing when the call isn't tracked here at all (e.g. a group-call notice).
@@ -748,11 +779,15 @@ func gowhatsapp_go_call_changemedia(cID *C.char, hasOutgoing, outgoing, hasIncom
 				err = ci.c.SetVideoEnabled(true)
 			case want:
 				err = ci.c.StartVideo()
-			case ci.c.IsVideo():
-				err = ci.c.SetVideoEnabled(false)
+			case ci.c.IsSendingVideo():
+				// Camera off is <video state=6>, as WhatsApp's own clients send it;
+				// state 0 made the far side drop its video as well.
+				err = ci.c.StopVideo()
 			}
 			if err != nil {
 				fmt.Fprintln(os.Stderr, "wacall: changeMedia outgoingVideo error:", err)
+			} else {
+				fmt.Fprintln(os.Stderr, "wacall: changeMedia outgoingVideo", want)
 			}
 			ci.outgoingVid = want
 		}
@@ -790,6 +825,31 @@ func gowhatsapp_go_call_request_peer_keyframe() {
 	}
 }
 
+// gowhatsapp_go_call_set_video_orientation tells the peer of every live call which way our
+// camera's picture is up, in quarter turns (0..3) as <video device_orientation> carries it.
+// glue/call.c calls it once our camera is being sent. The stanza goes out off the C
+// mainloop.
+//
+//export gowhatsapp_go_call_set_video_orientation
+func gowhatsapp_go_call_set_video_orientation(orientation C.int) {
+	o := int(orientation) & 3
+	callMu.Lock()
+	var live []*callInfo
+	for _, c := range calls {
+		if c.c != nil && c.state != "disconnected" {
+			live = append(live, c)
+		}
+	}
+	callMu.Unlock()
+	for _, ci := range live {
+		go func(ci *callInfo) {
+			if err := ci.c.SetVideoOrientation(o); err != nil {
+				fmt.Fprintln(os.Stderr, "wacall: SetVideoOrientation failed:", err)
+			}
+		}(ci)
+	}
+}
+
 //export gowhatsapp_go_call_hangup
 func gowhatsapp_go_call_hangup(cID *C.char) C.int {
 	id := C.GoString(cID)
diff --git a/glue/call.c b/glue/call.c
index c0d09f0..0398f8c 100644
--- a/glue/call.c
+++ b/glue/call.c
@@ -85,6 +85,21 @@ static gboolean json_true(const char *json, const char *key) {
 	return strncmp(c, "true", 4) == 0;
 }
 
+// A non-negative integer value, or -1 when the key is missing or not a number.
+static long json_uint(const char *json, const char *key) {
+	char pat[64];
+	snprintf(pat, sizeof pat, "\"%s\"", key);
+	const char *k = strstr(json, pat);
+	if (!k) return -1;
+	const char *c = strchr(k + strlen(pat), ':');
+	if (!c) return -1;
+	for (c++; *c == ' ' || *c == '\t'; c++) {}
+	if (*c < '0' || *c > '9') return -1;
+	long v = 0;
+	for (; *c >= '0' && *c <= '9' && v < 100000; c++) v = v * 10 + (*c - '0');
+	return v;
+}
+
 static void reply(LSHandle *sh, LSMessage *msg, const char *payload) {
 	LSError e;
 	LSErrorInit(&e);
@@ -112,15 +127,27 @@ static void reply(LSHandle *sh, LSMessage *msg, const char *payload) {
 #define RTC_RX_SOCKET "/tmp/wa-rtc-rx.sock"
 #define RTC_TX_SOCKET "/tmp/wa-rtc-tx.sock"
 #define RTC_SHM_PATH "/tmp/wa-rtc-video"
+// Our own camera's picture for the Phone app's inset, while we send (the engine decodes
+// what it encodes); a quarter of the sent frame.
+#define RTC_PREVIEW_PATH "/tmp/wa-rtc-preview"
+#define RTC_PREVIEW_W 320
+#define RTC_PREVIEW_H 240
 // The frame size the engine renders to (and encodes at, with a camera). Receive-only is
 // portrait, as phones send; the engine letterboxes other shapes.
 #define RTC_RX_ONLY_W 480
 #define RTC_RX_ONLY_H 640
 #define RTC_TX_W 640
 #define RTC_TX_H 480
-#define RTC_TX_BITRATE 500000
-// Peer keyframe requests (PLI/FIR) are passed to the encoder at most this often.
-#define RTC_KEYFRAME_MIN_INTERVAL_US (500 * 1000)
+// 500 kbit/s looked heavily compressed on the far side at 640x480 (sargo, 3 Nov).
+#define RTC_TX_BITRATE 1200000
+// Peer keyframe requests (PLI/FIR) are passed to the encoder at most this often. Every IDR
+// costs the frames after it their share of the bitrate; at 500 ms a lossy link kept the
+// encoder making one every two seconds.
+#define RTC_KEYFRAME_MIN_INTERVAL_US (1000 * 1000)
+// Our camera's picture, in the quarter turns WhatsApp's <video device_orientation> carries:
+// the phone is held upright, which callers announce as 1, and the receiver turns the
+// picture by it.
+#define RTC_TX_ORIENTATION 1
 
 typedef enum { VID_IDLE, VID_PROBING, VID_STARTING, VID_RUNNING } vid_state_t;
 static vid_state_t g_vid_state = VID_IDLE;
@@ -129,6 +156,7 @@ static int g_vid_view;      // the user asked to see it (Phone app)
 static int g_vid_failed;    // start failed; no retry until the wish changes
 static int g_vid_retried;   // one stop-and-retry after "already running"
 static int g_vid_tx;        // the running session encodes our camera
+static int g_vid_camera;    // the camera it opens: the front one where there are two
 static int g_vid_w, g_vid_h;
 static unsigned g_vid_gen;  // bumped on every close
 static gint64 g_last_keyframe_us;
@@ -233,6 +261,7 @@ static bool rtc_start_reply(LSHandle *sh, LSMessage *msg, void *ctx) {
 	        g_vid_tx ? "on" : "off");
 	// The renderer joins mid-stream: ask the peer for an IDR to start decoding from.
 	gowhatsapp_go_call_request_peer_keyframe();
+	if (g_vid_tx) gowhatsapp_go_call_set_video_orientation(RTC_TX_ORIENTATION);
 	video_changed();
 	if (g_test_inject_mode) test_inject_begin();
 	return true;
@@ -245,9 +274,11 @@ static void video_start_session(int tx) {
 	g_vid_h = tx ? RTC_TX_H : RTC_RX_ONLY_H;
 	snprintf(payload, sizeof payload,
 	         "{\"rxSocket\":\"%s\",\"txSocket\":\"%s\",\"rxEnabled\":true,\"txEnabled\":%s,"
-	         "\"shmPath\":\"%s\",\"width\":%d,\"height\":%d,\"bitrate\":%d}",
+	         "\"shmPath\":\"%s\",\"width\":%d,\"height\":%d,\"bitrate\":%d,\"camera\":%d,"
+	         "\"previewShmPath\":\"%s\",\"previewWidth\":%d,\"previewHeight\":%d}",
 	         RTC_RX_SOCKET, RTC_TX_SOCKET, tx ? "true" : "false", RTC_SHM_PATH, g_vid_w,
-	         g_vid_h, RTC_TX_BITRATE);
+	         g_vid_h, RTC_TX_BITRATE, g_vid_camera, tx ? RTC_PREVIEW_PATH : "", RTC_PREVIEW_W,
+	         RTC_PREVIEW_H);
 	g_vid_state = VID_STARTING;
 	if (!rtc_call("start", payload, rtc_start_reply, GUINT_TO_POINTER(g_vid_gen))) {
 		g_vid_state = VID_IDLE;
@@ -267,6 +298,10 @@ static bool rtc_caps_reply(LSHandle *sh, LSMessage *msg, void *ctx) {
 	}
 	// videoCallCapable honours the device's own policy (deviceinfo_video_call): a device
 	// without a usable camera still shows the peer, it just sends no video.
+	// A video call shows the user's face: with two cameras take the front one. Android's
+	// HAL numbers the main back camera 0 and the front camera 1, and the engine's droid
+	// backend passes the index to droidcamsrc as that HAL id.
+	g_vid_camera = json_uint(p, "cameraCount") >= 2 ? 1 : 0;
 	video_start_session(json_true(p, "videoCallCapable"));
 	return true;
 }
@@ -334,8 +369,17 @@ static char *inject_video_uri(const char *json) {
 	static const char needle[] = "\"videoURI\":\"\"";
 	const char *pos = strstr(json, needle);
 	if (!pos || !video_shown()) return g_strdup(json);
-	return g_strdup_printf("%.*s\"videoURI\":\"%s\",\"videoWidth\":%d,\"videoHeight\":%d%s",
-	                       (int)(pos - json), json, RTC_SHM_PATH, g_vid_w, g_vid_h,
+	// While we send, our own picture too: turned like the sent one, mirrored for the front
+	// camera as a mirror shows the user.
+	char preview[192] = "";
+	if (g_vid_tx)
+		snprintf(preview, sizeof preview,
+		         ",\"videoPreviewURI\":\"%s\",\"videoPreviewWidth\":%d,\"videoPreviewHeight\":%d,"
+		         "\"videoPreviewOrientation\":%d,\"videoPreviewMirrored\":%s",
+		         RTC_PREVIEW_PATH, RTC_PREVIEW_W, RTC_PREVIEW_H, RTC_TX_ORIENTATION,
+		         g_vid_camera == 1 ? "true" : "false");
+	return g_strdup_printf("%.*s\"videoURI\":\"%s\",\"videoWidth\":%d,\"videoHeight\":%d%s%s",
+	                       (int)(pos - json), json, RTC_SHM_PATH, g_vid_w, g_vid_h, preview,
 	                       pos + sizeof(needle) - 1);
 }
 

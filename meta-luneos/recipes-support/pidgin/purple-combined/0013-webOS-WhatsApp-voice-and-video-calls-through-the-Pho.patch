diff --git a/glue/tests/Makefile b/glue/tests/Makefile
new file mode 100644
index 0000000..8c47e95
--- /dev/null
+++ b/glue/tests/Makefile
@@ -0,0 +1,55 @@
+# Unit tests for the call audio playout (glue/playout.c), glue/call.c's playback thread, which
+# runs against fakes.c's ALSA device instead of a real one, call.c's luneos-rtc-engine session
+# (fakes.c records its LS2 calls), and the engine's socket bridge (glue/voipkit_rtcengine.c,
+# against real unix sockets). Needs gtest, and the glib,
+# luna-service2 and alsa-lib headers (luna-service2 and ALSA are not linked: fakes.c replaces
+# what call.c uses of them). Point CPPFLAGS/LDFLAGS at a sysroot when the host lacks them:
+#   make CPPFLAGS="-I$SYSROOT/usr/include -I$SYSROOT/usr/include/glib-2.0 \
+#                  -I$SYSROOT/usr/lib/glib-2.0/include" LDFLAGS="-L$SYSROOT/usr/lib"
+#   make check
+# SAN="-fsanitize=address,undefined" or SAN=-fsanitize=thread builds them sanitized.
+CC ?= cc
+CXX ?= c++
+GLUE := ..
+CFLAGS ?= -O1 -g -Wall -Wextra
+CXXFLAGS ?= -O1 -g -Wall -Wextra
+SAN ?=
+INC := -I$(GLUE) -I. -Ifakes
+LIBS := -lgtest -lgtest_main -lglib-2.0 -lpthread -lm
+
+all: playout_test call_playback_test call_video_test voipkit_rtcengine_test
+
+playout_test: playout_test.cpp $(GLUE)/playout.c $(GLUE)/playout.h
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/playout.c -o playout.o
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) playout_test.cpp playout.o -o $@ $(LDFLAGS) $(LIBS)
+
+# PLUGIN_VERSION only matters to init.c; call.c is compiled as the recipe does otherwise.
+call_playback_test: call_playback_test.cpp fakes.c fakes.h $(GLUE)/call.c $(GLUE)/playout.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/playout.c -o playout.o
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/call.c -o call.o
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c fakes.c -o fakes.o
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) call_playback_test.cpp call.o playout.o fakes.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
+call_video_test: call_video_test.cpp fakes.c fakes.h $(GLUE)/call.c $(GLUE)/playout.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/playout.c -o playout.o
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/call.c -o call.o
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c fakes.c -o fakes.o
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) call_video_test.cpp call.o playout.o fakes.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
+voipkit_rtcengine_test: voipkit_rtcengine_test.cpp $(GLUE)/voipkit_rtcengine.c $(GLUE)/voipkit_rtcengine.h
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/voipkit_rtcengine.c -o voipkit_rtcengine.o
+	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) voipkit_rtcengine_test.cpp voipkit_rtcengine.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
+check: all
+	./playout_test
+	./call_playback_test
+	./call_video_test
+	./voipkit_rtcengine_test
+
+clean:
+	rm -f *.o playout_test call_playback_test call_video_test voipkit_rtcengine_test
+
+.PHONY: all check clean
diff --git a/glue/tests/call_playback_test.cpp b/glue/tests/call_playback_test.cpp
new file mode 100644
index 0000000..7c0a567
--- /dev/null
+++ b/glue/tests/call_playback_test.cpp
@@ -0,0 +1,142 @@
+// Tests glue/call.c's playback path against a fake ALSA device (tests/fakes.c): the device is
+// written continuously from the moment the call audio opens, whatever the packet arrival, the
+// stream is opened once, and AECM's far-end reference is exactly what was written.
+#include <gtest/gtest.h>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#include "fakes.h"
+
+namespace {
+
+using namespace std::chrono;
+
+// Real-time milliseconds scaled to the fake device's pace.
+void wait_ms(int ms) { std::this_thread::sleep_for(milliseconds(ms / FAKE_SPEEDUP)); }
+
+// One decoded 60 ms frame with recognisable non-zero samples.
+std::vector<float> frame(int seq) {
+	std::vector<float> f(960);
+	for (int i = 0; i < 960; i++) f[i] = static_cast<float>(1 + (seq * 960 + i) % 20000) / 32767.0f;
+	return f;
+}
+short as_written(float f) { return static_cast<short>(f * 32767.0f); }
+
+long written_n() {
+	fake_lock();
+	long n = fake.written_n;
+	fake_unlock();
+	return n;
+}
+
+class CallPlayback : public ::testing::Test {
+protected:
+	void SetUp() override { fake_reset(); }
+	void TearDown() override { gowhatsapp_call_audio_active(0); }
+};
+
+TEST_F(CallPlayback, SilenceKeepsTheDeviceRunning) {
+	gowhatsapp_call_audio_active(1);
+	wait_ms(400); // no packets at all, like a peer in DTX
+	long mid = written_n();
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	EXPECT_GT(mid, 16000 * 200 / 1000) << "the device must be written while nothing arrives";
+	EXPECT_GT(fake.written_n, mid);
+	for (long i = 0; i < fake.written_n; i++) ASSERT_EQ(fake.written[i], 0);
+	EXPECT_EQ(fake.playback_opens, 1);
+	EXPECT_EQ(fake.recovers, 0);
+}
+
+TEST_F(CallPlayback, GappedArrivalPlaysEverythingInOrderWithOneStream) {
+	gowhatsapp_call_audio_active(1);
+	std::vector<short> sent;
+	int seq = 0;
+	// Bursts of 1-3 frames separated by 150-500 ms gaps (relay jitter, DTX).
+	const int bursts[][2] = {{2, 150}, {1, 300}, {3, 500}, {1, 200}, {2, 450}, {3, 250}, {1, 400}};
+	for (auto &b : bursts) {
+		for (int k = 0; k < b[0]; k++, seq++) {
+			auto f = frame(seq);
+			gowhatsapp_call_on_speaker(f.data(), static_cast<int>(f.size()));
+			for (float v : f) sent.push_back(as_written(v));
+		}
+		wait_ms(b[1]);
+	}
+	wait_ms(600); // let the ring drain
+	gowhatsapp_call_audio_active(0);
+
+	EXPECT_EQ(fake.playback_opens, 1);
+	EXPECT_EQ(fake.closes, 2) << "playback and capture, once each, at the end";
+	EXPECT_EQ(fake.recovers, 0) << "no underrun, so the stream was never recreated";
+	// Every decoded sample reaches the device, in order, with only silence in between.
+	std::vector<short> played;
+	for (long i = 0; i < fake.written_n; i++)
+		if (fake.written[i] != 0) played.push_back(fake.written[i]);
+	EXPECT_EQ(played, sent);
+	// The device ran for the whole call, not just while packets came in.
+	EXPECT_GT(fake.written_n, static_cast<long>(sent.size()) + 16000);
+}
+
+TEST_F(CallPlayback, FarEndReferenceIsExactlyWhatWasWritten) {
+	gowhatsapp_call_audio_active(1);
+	for (int s = 0; s < 6; s++) {
+		auto f = frame(s);
+		gowhatsapp_call_on_speaker(f.data(), static_cast<int>(f.size()));
+		wait_ms(s % 2 ? 250 : 60);
+	}
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	ASSERT_GT(fake.written_n, 0);
+	EXPECT_EQ(fake.farend_bad_len, 0);
+	ASSERT_EQ(fake.farend_n, fake.written_n);
+	EXPECT_EQ(0, memcmp(fake.farend, fake.written, sizeof(short) * fake.written_n));
+}
+
+TEST_F(CallPlayback, UnderrunIsRecoveredAndPlaybackContinues) {
+	gowhatsapp_call_audio_active(1);
+	wait_ms(100);
+	fake_lock();
+	fake.inject_epipe = 1;
+	fake_unlock();
+	auto f = frame(7);
+	gowhatsapp_call_on_speaker(f.data(), 960);
+	gowhatsapp_call_on_speaker(f.data(), 960);
+	wait_ms(500);
+	long mid = written_n();
+	wait_ms(200);
+	gowhatsapp_call_audio_active(0);
+	EXPECT_EQ(fake.recovers, 1);
+	EXPECT_EQ(fake.playback_opens, 1);
+	EXPECT_GT(fake.written_n, mid);
+	ASSERT_EQ(fake.farend_n, fake.written_n) << "the failed chunk is rewritten, then referenced once";
+	EXPECT_EQ(0, memcmp(fake.farend, fake.written, sizeof(short) * fake.written_n));
+	long nonzero = 0;
+	for (long i = 0; i < fake.written_n; i++) nonzero += fake.written[i] != 0;
+	EXPECT_EQ(nonzero, 2 * 960);
+}
+
+TEST_F(CallPlayback, FramesOutsideACallAreNotQueued) {
+	auto f = frame(1);
+	gowhatsapp_call_on_speaker(f.data(), 960); // ringing: audio path not open
+	gowhatsapp_call_audio_active(1);
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	for (long i = 0; i < fake.written_n; i++) ASSERT_EQ(fake.written[i], 0);
+}
+
+TEST_F(CallPlayback, SecondCallStartsFromAnEmptyRing) {
+	gowhatsapp_call_audio_active(1);
+	auto f = frame(3);
+	for (int i = 0; i < 4; i++) gowhatsapp_call_on_speaker(f.data(), 960);
+	gowhatsapp_call_audio_active(0); // ends at once, audio still queued
+	fake_reset();
+	gowhatsapp_call_audio_active(1);
+	wait_ms(400);
+	gowhatsapp_call_audio_active(0);
+	for (long i = 0; i < fake.written_n; i++) ASSERT_EQ(fake.written[i], 0);
+	EXPECT_EQ(fake.playback_opens, 1);
+}
+
+} // namespace

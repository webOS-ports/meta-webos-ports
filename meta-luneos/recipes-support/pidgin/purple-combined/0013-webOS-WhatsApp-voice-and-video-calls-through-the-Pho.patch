@@ -0,0 +1,29 @@
+// voipkit_rtcengine.h -- extra entry points of the luneos-rtc-engine video bridge
+// (glue/voipkit_rtcengine.c), on top of the backend-neutral ones in voipkit.h.
+#ifndef VOIPKIT_RTCENGINE_H
+#define VOIPKIT_RTCENGINE_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Sets the engine's socket paths, as its LS2 start reply returned them. tx_path NULL or ""
+// means no outgoing video (no TX thread); rx_path NULL or "" means the peer's video is not
+// passed on. Returns 0, leaving both cleared, when a path does not fit a sockaddr_un or the
+// bridge is running (call voipkit_video_stop first).
+int voipkit_rtcengine_set_sockets(const char *tx_path, const char *rx_path);
+
+// 1 when the Annex-B access unit holds an IDR slice (NAL type 5).
+int voipkit_rtcengine_au_has_idr(const unsigned char *au, size_t len);
+
+// Access units passed to the engine and dropped since the last voipkit_video_start.
+// Either pointer may be NULL.
+void voipkit_rtcengine_stats(unsigned long long *sent, unsigned long long *dropped);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

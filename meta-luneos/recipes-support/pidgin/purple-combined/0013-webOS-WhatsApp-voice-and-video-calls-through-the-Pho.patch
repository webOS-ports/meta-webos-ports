+static gboolean test_inject_frame_tick(gpointer data) {
+	(void)data;
+	if (!g_test_inject_mode) return G_SOURCE_REMOVE;
+	voipkit_video_receive_frame(TEST_IDR_FRAME, sizeof(TEST_IDR_FRAME));
+	return G_SOURCE_CONTINUE;

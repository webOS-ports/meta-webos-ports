diff --git a/glue/tests/playout_test.cpp b/glue/tests/playout_test.cpp
new file mode 100644
index 0000000..51f8601
--- /dev/null
+++ b/glue/tests/playout_test.cpp
@@ -0,0 +1,215 @@
+// Unit tests for glue/playout.c, the playout ring between the call decoder and the playback thread.
+#include <gtest/gtest.h>
+#include <atomic>
+#include <thread>
+#include <vector>
+
+extern "C" {
+#include "playout.h"
+}
+
+namespace {
+
+std::vector<short> ramp(int n, short start) {
+	std::vector<short> v(n);
+	for (int i = 0; i < n; i++) v[i] = static_cast<short>(start + i);
+	return v;
+}
+
+class Playout : public ::testing::Test {
+protected:
+	void SetUp() override { wa_playout_init(&p, 100, 300); }
+	void TearDown() override { wa_playout_destroy(&p); }
+	std::vector<short> pull(int n, int *got = nullptr) {
+		std::vector<short> out(n, 0x5555);
+		int g = wa_playout_pull(&p, out.data(), n);
+		if (got) *got = g;
+		return out;
+	}
+	wa_playout p;
+};
+
+TEST_F(Playout, EmptyRingGivesSilence) {
+	int got = -1;
+	auto out = pull(50, &got);
+	EXPECT_EQ(got, 0);
+	for (short s : out) EXPECT_EQ(s, 0);
+	EXPECT_EQ(p.silence, 50u);
+	EXPECT_EQ(p.underflows, 0u); // never started playing, so it did not run dry
+}
+
+TEST_F(Playout, HoldsBackUntilPrefillIsQueued) {
+	auto a = ramp(60, 1);
+	wa_playout_push(&p, a.data(), 60);
+	int got = -1;
+	pull(20, &got);
+	EXPECT_EQ(got, 0) << "60 < prefill 100: still collecting";
+	auto b = ramp(40, 61);
+	wa_playout_push(&p, b.data(), 40);
+	auto out = pull(30, &got);
+	EXPECT_EQ(got, 30);
+	for (int i = 0; i < 30; i++) EXPECT_EQ(out[i], 1 + i);
+}
+
+TEST_F(Playout, PlaysInOrderAcrossTheRingEnd) {
+	// Walk head close to the end of the buffer, then push across it.
+	std::vector<short> big = ramp(250, 0);
+	int got;
+	for (int round = 0; round < 64; round++) {
+		wa_playout_push(&p, big.data(), 250);
+		auto out = pull(250, &got);
+		ASSERT_EQ(got, 250);
+		for (int i = 0; i < 250; i++) ASSERT_EQ(out[i], i) << "round " << round;
+		pull(1, &got); // ran dry -> rebuffers, keeps the ring index moving
+	}
+	EXPECT_EQ(p.dropped, 0u);
+}
+
+TEST_F(Playout, QueuedAudioShortOfThePrefillPlaysAfterWaitingThatLong) {
+	auto a = ramp(40, 1); // a lone tail, less than the prefill of 100
+	wa_playout_push(&p, a.data(), 40);
+	int got;
+	pull(60, &got);
+	EXPECT_EQ(got, 0);
+	pull(30, &got);
+	EXPECT_EQ(got, 0) << "waited 60 of 100";
+	auto out = pull(30, &got); // waited 90: still short
+	EXPECT_EQ(got, 0);
+	out = pull(30, &got); // waited 120 >= 100: plays what there is
+	EXPECT_EQ(got, 30);
+	EXPECT_EQ(out[0], 1);
+	pull(30, &got);
+	EXPECT_EQ(got, 10);
+	EXPECT_EQ(p.underflows, 1u);
+	EXPECT_EQ(p.fill, 0);
+}
+
+TEST_F(Playout, WaitingOnlyCountsWhileAudioIsQueued) {
+	int got;
+	pull(500, &got); // a long silence with nothing queued
+	auto a = ramp(40, 1);
+	wa_playout_push(&p, a.data(), 40);
+	pull(20, &got);
+	EXPECT_EQ(got, 0) << "the empty wait before the push does not count";
+}
+
+TEST_F(Playout, ShortfallIsZeroFilledAndRebuffers) {
+	auto a = ramp(120, 1);
+	wa_playout_push(&p, a.data(), 120);
+	int got;
+	auto out = pull(200, &got);
+	EXPECT_EQ(got, 120);
+	for (int i = 0; i < 120; i++) EXPECT_EQ(out[i], 1 + i);
+	for (int i = 120; i < 200; i++) EXPECT_EQ(out[i], 0);
+	EXPECT_EQ(p.underflows, 1u);
+	// After running dry it waits for the prefill again rather than playing a sliver.
+	auto b = ramp(50, 500);
+	wa_playout_push(&p, b.data(), 50);
+	pull(10, &got);
+	EXPECT_EQ(got, 0);
+	wa_playout_push(&p, b.data(), 50);
+	pull(10, &got);
+	EXPECT_EQ(got, 10);
+}
+
+TEST_F(Playout, BurstBeyondMaxFillDropsTheOldest) {
+	auto a = ramp(250, 0);
+	wa_playout_push(&p, a.data(), 250);
+	auto b = ramp(100, 1000);
+	wa_playout_push(&p, b.data(), 100); // 350 > max_fill 300: 50 oldest go
+	EXPECT_EQ(p.dropped, 50u);
+	EXPECT_EQ(p.fill, 300);
+	int got;
+	auto out = pull(300, &got);
+	EXPECT_EQ(got, 300);
+	EXPECT_EQ(out[0], 50);
+	EXPECT_EQ(out[199], 249);
+	EXPECT_EQ(out[200], 1000);
+	EXPECT_EQ(out[299], 1099);
+}
+
+TEST_F(Playout, PushLargerThanTheRingKeepsTheNewest) {
+	std::vector<short> huge(WA_PLAYOUT_CAP + 500);
+	for (size_t i = 0; i < huge.size(); i++) huge[i] = static_cast<short>(i & 0x7fff);
+	wa_playout_push(&p, huge.data(), static_cast<int>(huge.size()));
+	EXPECT_EQ(p.fill, WA_PLAYOUT_CAP) << "max_fill is raised to what a single push needs";
+	EXPECT_EQ(p.dropped, 500u);
+	int got;
+	auto out = pull(1, &got);
+	EXPECT_EQ(out[0], 500);
+}
+
+TEST_F(Playout, CountersAddUp) {
+	int got;
+	for (int i = 0; i < 40; i++) {
+		auto a = ramp(37 * (i % 5), 0);
+		wa_playout_push(&p, a.data(), static_cast<int>(a.size()));
+		pull(29, &got);
+	}
+	EXPECT_EQ(p.played + p.silence, 40u * 29u);
+	EXPECT_EQ(p.pushed, p.played + p.dropped + static_cast<unsigned long long>(p.fill));
+}
+
+TEST_F(Playout, ResetEmptiesAndRestartsBuffering) {
+	auto a = ramp(200, 1);
+	wa_playout_push(&p, a.data(), 200);
+	int got;
+	pull(10, &got);
+	ASSERT_EQ(got, 10);
+	wa_playout_reset(&p);
+	EXPECT_EQ(p.fill, 0);
+	EXPECT_EQ(p.pushed, 0u);
+	pull(10, &got);
+	EXPECT_EQ(got, 0);
+}
+
+TEST(PlayoutInit, ClampsLimits) {
+	wa_playout q;
+	wa_playout_init(&q, -5, WA_PLAYOUT_CAP * 2);
+	EXPECT_EQ(q.prefill, 0);
+	EXPECT_EQ(q.max_fill, WA_PLAYOUT_CAP);
+	wa_playout_destroy(&q);
+	wa_playout_init(&q, 200, 100);
+	EXPECT_EQ(q.max_fill, 200);
+	wa_playout_destroy(&q);
+}
+
+// Producer and consumer on two threads, as in a call: samples come out in order (TSan target).
+TEST(PlayoutThreads, ConcurrentPushPullKeepsOrder) {
+	static wa_playout q;
+	wa_playout_init(&q, 64, WA_PLAYOUT_CAP);
+	std::atomic<bool> done{false};
+	const int total = 200000;
+	std::thread prod([&] {
+		short buf[96];
+		int next = 1;
+		while (next <= total) {
+			int n = 0;
+			for (; n < 96 && next <= total; n++) buf[n] = static_cast<short>(next++ % 30000 + 1);
+			for (;;) { // back-pressure, so the test checks ordering rather than max_fill drops
+				pthread_mutex_lock(&q.mx);
+				int fill = q.fill;
+				pthread_mutex_unlock(&q.mx);
+				if (fill < WA_PLAYOUT_CAP / 2) break;
+				std::this_thread::yield();
+			}
+			wa_playout_push(&q, buf, n);
+		}
+		done = true;
+	});
+	int expect = 1, seen = 0;
+	short out[50];
+	while (seen < total) {
+		int got = wa_playout_pull(&q, out, 50);
+		for (int i = 0; i < got; i++) {
+			ASSERT_EQ(out[i], static_cast<short>(expect % 30000 + 1));
+			expect++;
+		}
+		seen += got;
+	}
+	prod.join();
+	EXPECT_EQ(q.dropped, 0u);
+	wa_playout_destroy(&q);
+}
+
+} // namespace
diff --git a/glue/tests/voipkit_rtcengine_test.cpp b/glue/tests/voipkit_rtcengine_test.cpp
new file mode 100644
index 0000000..d6df40f
--- /dev/null
+++ b/glue/tests/voipkit_rtcengine_test.cpp
@@ -0,0 +1,330 @@
+// Tests glue/voipkit_rtcengine.c against real AF_UNIX SOCK_SEQPACKET listeners standing in for
+// luneos-rtc-engine: whole access units in order, nothing passed on before an IDR, drops and
+// reconnects recover at the next IDR and ask the peer for one (rate-limited), the TX thread hands
+// every unit to Go and stops promptly, and the caller is never blocked.
+#include <gtest/gtest.h>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "voipkit.h"
+#include "voipkit_rtcengine.h"
+
+namespace {
+
+std::mutex g_mx;
+std::vector<std::vector<unsigned char>> g_out; // what reached Go from the TX socket
+std::atomic<int> g_keyframe_requests{0};
+
+} // namespace
+
+extern "C" void gowhatsapp_call_video_frame_out(char *data, int length) {
+	std::lock_guard<std::mutex> l(g_mx);
+	g_out.emplace_back(reinterpret_cast<unsigned char *>(data),
+	                   reinterpret_cast<unsigned char *>(data) + length);
+}
+extern "C" void gowhatsapp_go_call_request_peer_keyframe(void) { g_keyframe_requests++; }
+
+namespace {
+
+using namespace std::chrono;
+
+std::vector<unsigned char> au(int nal_type, int tag, size_t size = 64) {
+	std::vector<unsigned char> v(size, static_cast<unsigned char>(tag));
+	v[0] = 0; v[1] = 0; v[2] = 0; v[3] = 1;
+	v[4] = static_cast<unsigned char>(0x60 | nal_type);
+	return v;
+}
+std::vector<unsigned char> idr(int tag, size_t size = 64) {
+	// SPS, PPS, then the IDR slice, as an encoder's first unit.
+	std::vector<unsigned char> v = {0, 0, 0, 1, 0x67, 0x42, 0, 0, 1, 0x68, 0xce};
+	auto s = au(5, tag, size);
+	v.insert(v.end(), s.begin(), s.end());
+	return v;
+}
+std::vector<unsigned char> pframe(int tag, size_t size = 64) { return au(1, tag, size); }
+
+struct Listener {
+	std::string path;
+	int fd = -1;
+	explicit Listener(const std::string &p) : path(p) {
+		unlink(path.c_str());
+		fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+		sockaddr_un sa{};
+		sa.sun_family = AF_UNIX;
+		std::snprintf(sa.sun_path, sizeof sa.sun_path, "%s", path.c_str());
+		EXPECT_EQ(bind(fd, reinterpret_cast<sockaddr *>(&sa), sizeof sa), 0);
+		EXPECT_EQ(listen(fd, 1), 0);
+	}
+	~Listener() {
+		if (fd >= 0) close(fd);
+		unlink(path.c_str());
+	}
+	int accept_within(int ms) {
+		pollfd p{fd, POLLIN, 0};
+		if (poll(&p, 1, ms) <= 0) return -1;
+		return accept4(fd, nullptr, nullptr, SOCK_CLOEXEC);
+	}
+};
+
+std::vector<unsigned char> recv_within(int fd, int ms) {
+	pollfd p{fd, POLLIN, 0};
+	if (poll(&p, 1, ms) <= 0) return {};
+	std::vector<unsigned char> buf(1 << 20);
+	ssize_t n = recv(fd, buf.data(), buf.size(), 0);
+	if (n <= 0) return {};
+	buf.resize(static_cast<size_t>(n));
+	return buf;
+}
+
+void send_au(const std::vector<unsigned char> &v) {
+	voipkit_video_receive_frame(v.data(), static_cast<unsigned int>(v.size()));
+}
+
+std::string tmpdir() {
+	char t[] = "/tmp/wa-rtc-test-XXXXXX"; // the test's own sockets; removed in TearDown
+	return mkdtemp(t);
+}
+
+class Bridge : public ::testing::Test {
+protected:
+	std::string dir;
+	void SetUp() override {
+		dir = tmpdir();
+		std::lock_guard<std::mutex> l(g_mx);
+		g_out.clear();
+		g_keyframe_requests = 0;
+	}
+	void TearDown() override {
+		voipkit_video_stop();
+		voipkit_rtcengine_set_sockets(nullptr, nullptr);
+		rmdir(dir.c_str());
+	}
+};
+
+TEST(BridgeIdr, FindsTheIdrSlice) {
+	auto a = idr(1);
+	EXPECT_TRUE(voipkit_rtcengine_au_has_idr(a.data(), a.size()));
+	auto p = pframe(1);
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(p.data(), p.size()));
+	const unsigned char three[] = {0, 0, 1, 0x65, 0x88};
+	EXPECT_TRUE(voipkit_rtcengine_au_has_idr(three, sizeof three));
+	const unsigned char sps_pps[] = {0, 0, 0, 1, 0x67, 0x42, 0, 0, 1, 0x68, 0xce};
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(sps_pps, sizeof sps_pps));
+	const unsigned char cut[] = {0, 0, 1};
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(cut, sizeof cut));
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(nullptr, 0));
+}
+
+TEST_F(Bridge, RejectsPathsThatDoNotFit) {
+	std::string longp(200, 'x');
+	EXPECT_FALSE(voipkit_rtcengine_set_sockets(nullptr, longp.c_str()));
+	EXPECT_TRUE(voipkit_rtcengine_set_sockets(nullptr, (dir + "/rx").c_str()));
+}
+
+TEST_F(Bridge, PathsCannotChangeWhileRunning) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	EXPECT_FALSE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+}
+
+TEST_F(Bridge, NothingPassesBeforeStart) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	send_au(idr(1));
+	EXPECT_EQ(rx.accept_within(100), -1) << "not running: no connection made";
+}
+
+TEST_F(Bridge, StartsAtAnIdrAndKeepsUnitsWholeAndInOrder) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	EXPECT_TRUE(voipkit_video_wait_thread_b(100));
+	send_au(pframe(1));
+	send_au(pframe(2));
+	EXPECT_EQ(g_keyframe_requests.load(), 1) << "asked once, rate-limited";
+	auto i = idr(3, 30000); // a keyframe-sized unit
+	send_au(i);
+	auto p = pframe(4, 900);
+	send_au(p);
+	EXPECT_EQ(recv_within(c, 500), i);
+	EXPECT_EQ(recv_within(c, 500), p);
+	EXPECT_TRUE(recv_within(c, 100).empty()) << "the P-frames before the IDR were held back";
+	unsigned long long sent = 0, dropped = 0;
+	voipkit_rtcengine_stats(&sent, &dropped);
+	EXPECT_EQ(sent, 2u);
+	EXPECT_EQ(dropped, 2u);
+	close(c);
+}
+
+TEST_F(Bridge, AFullSocketDropsWithoutBlockingAndRecoversAtTheNextIdr) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	send_au(idr(1, 4000));
+	// The engine stops reading: keep sending until the socket is full.
+	auto t0 = steady_clock::now();
+	unsigned long long dropped = 0;
+	for (int k = 0; k < 5000 && dropped == 0; k++) {
+		send_au(pframe(2, 4000));
+		voipkit_rtcengine_stats(nullptr, &dropped);
+	}
+	EXPECT_LT(duration_cast<milliseconds>(steady_clock::now() - t0).count(), 2000)
+		<< "the caller is never blocked";
+	ASSERT_GT(dropped, 0u);
+	int asked = g_keyframe_requests.load();
+	EXPECT_GE(asked, 1);
+	// Drain everything that made it.
+	while (!recv_within(c, 50).empty()) {
+	}
+	send_au(pframe(3));
+	EXPECT_TRUE(recv_within(c, 100).empty()) << "after a drop, nothing until an IDR";
+	auto i = idr(4);
+	send_au(i);
+	EXPECT_EQ(recv_within(c, 500), i);
+	close(c);
+}
+
+TEST_F(Bridge, ReconnectsWhenTheEngineGoesAway) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	send_au(idr(1));
+	ASSERT_FALSE(recv_within(c, 500).empty());
+	close(c); // the engine restarted its RX side
+	send_au(pframe(2)); // fails: the bridge lets go of the socket
+	std::this_thread::sleep_for(milliseconds(250)); // past the reconnect spacing
+	send_au(pframe(3));
+	int c2 = rx.accept_within(1000);
+	ASSERT_GE(c2, 0) << "reconnected";
+	send_au(pframe(4));
+	auto i = idr(5);
+	send_au(i);
+	EXPECT_EQ(recv_within(c2, 500), i) << "resumes at an IDR";
+	close(c2);
+}
+
+TEST_F(Bridge, KeyframeRequestsAreRateLimited) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	for (int k = 0; k < 50; k++) send_au(pframe(k));
+	EXPECT_EQ(g_keyframe_requests.load(), 1);
+	std::this_thread::sleep_for(milliseconds(1050));
+	send_au(pframe(99));
+	EXPECT_EQ(g_keyframe_requests.load(), 2);
+	close(c);
+}
+
+TEST_F(Bridge, TxHandsEveryUnitToGoInOrder) {
+	Listener rx(dir + "/rx"), tx(dir + "/tx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(tx.path.c_str(), rx.path.c_str()));
+	voipkit_video_start();
+	int c = tx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	std::vector<std::vector<unsigned char>> sent;
+	for (int k = 0; k < 20; k++) {
+		sent.push_back(k == 0 ? idr(k, 50000) : pframe(k, 100 + static_cast<size_t>(k)));
+		ASSERT_EQ(send(c, sent.back().data(), sent.back().size(), MSG_NOSIGNAL),
+		          static_cast<ssize_t>(sent.back().size()));
+	}
+	for (int w = 0; w < 100; w++) {
+		{
+			std::lock_guard<std::mutex> l(g_mx);
+			if (g_out.size() >= sent.size()) break;
+		}
+		std::this_thread::sleep_for(milliseconds(10));
+	}
+	std::lock_guard<std::mutex> l(g_mx);
+	EXPECT_EQ(g_out, sent);
+	close(c);
+	int r = rx.accept_within(10);
+	if (r >= 0) close(r);
+}
+
+TEST_F(Bridge, TxReconnectsAfterTheEngineCloses) {
+	Listener tx(dir + "/tx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(tx.path.c_str(), nullptr));
+	voipkit_video_start();
+	int c = tx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	close(c);
+	int c2 = tx.accept_within(2000);
+	ASSERT_GE(c2, 0);
+	auto i = idr(7);
+	ASSERT_EQ(send(c2, i.data(), i.size(), MSG_NOSIGNAL), static_cast<ssize_t>(i.size()));
+	for (int w = 0; w < 100; w++) {
+		{
+			std::lock_guard<std::mutex> l(g_mx);
+			if (!g_out.empty()) break;
+		}
+		std::this_thread::sleep_for(milliseconds(10));
+	}
+	std::lock_guard<std::mutex> l(g_mx);
+	ASSERT_EQ(g_out.size(), 1u);
+	EXPECT_EQ(g_out[0], i);
+	close(c2);
+}
+
+TEST_F(Bridge, StopIsPromptAndIdempotentEvenWithNoEngine) {
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets((dir + "/nobody-tx").c_str(),
+	                                          (dir + "/nobody-rx").c_str()));
+	voipkit_video_start();
+	voipkit_video_start(); // no second TX thread
+	send_au(idr(1));       // nothing listens: dropped quietly
+	EXPECT_FALSE(voipkit_video_wait_thread_b(100));
+	auto t0 = steady_clock::now();
+	voipkit_video_stop();
+	EXPECT_LT(duration_cast<milliseconds>(steady_clock::now() - t0).count(), 1000);
+	voipkit_video_stop();
+}
+
+TEST_F(Bridge, AnOversizedTxUnitIsDroppedNotTruncated) {
+	Listener tx(dir + "/tx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(tx.path.c_str(), nullptr));
+	voipkit_video_start();
+	int c = tx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	int sz = 4 << 20;
+	setsockopt(c, SOL_SOCKET, SO_SNDBUFFORCE, &sz, sizeof sz);
+	setsockopt(c, SOL_SOCKET, SO_SNDBUF, &sz, sizeof sz);
+	auto big = idr(1, (1 << 20) + 100);
+	ssize_t n = send(c, big.data(), big.size(), MSG_NOSIGNAL);
+	auto small = pframe(2);
+	ASSERT_EQ(send(c, small.data(), small.size(), MSG_NOSIGNAL), static_cast<ssize_t>(small.size()));
+	for (int w = 0; w < 100; w++) {
+		{
+			std::lock_guard<std::mutex> l(g_mx);
+			if (!g_out.empty()) break;
+		}
+		std::this_thread::sleep_for(milliseconds(10));
+	}
+	std::lock_guard<std::mutex> l(g_mx);
+	ASSERT_FALSE(g_out.empty());
+	if (n == static_cast<ssize_t>(big.size())) {
+		EXPECT_EQ(g_out.size(), 1u) << "the oversized unit never reaches Go";
+	}
+	EXPECT_EQ(g_out.back(), small);
+	close(c);
+}
+
+} // namespace

+static gboolean test_inject_stream_tick(gpointer data) {
+	(void)data;
+	if (!g_test_inject_mode) return G_SOURCE_REMOVE;
+	int idx = g_test_stream_frame_idx;
+	voipkit_video_receive_frame(TEST_STREAM_DATA + TEST_FRAME_OFFSETS[idx], TEST_FRAME_SIZES[idx]);
+	g_test_stream_frame_idx = (idx + 1) % TEST_STREAM_NUM_FRAMES;
+	unsigned int next_delta = TEST_FRAME_DELTA_MS[g_test_stream_frame_idx];
+	g_timeout_add(next_delta ? next_delta : 1, test_inject_stream_tick, NULL);
+	return G_SOURCE_REMOVE; // rescheduled above with the next unit's own delay
+}

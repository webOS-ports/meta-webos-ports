+package main
+
+import "testing"
+
+func TestAnsweredElsewhereTellsThePhoneAppSo(t *testing.T) {
+	if got := phoneEndCause("accepted_elsewhere"); got != "answeredElsewhere" {
+		t.Fatalf("accepted_elsewhere: cause %q, want answeredElsewhere", got)
+	}
+	if !endedAnsweredElsewhere("accepted_elsewhere") {
+		t.Fatal("accepted_elsewhere is no missed call")
+	}
+}
+
+func TestOtherEndsArePassedOn(t *testing.T) {
+	for _, r := range []string{"", "timeout", "rejected_elsewhere", "group_call_ended", "normal", "Accepted_Elsewhere"} {
+		if got := phoneEndCause(r); got != r {
+			t.Errorf("%q: cause %q, want it passed on", r, got)
+		}
+		if endedAnsweredElsewhere(r) {
+			t.Errorf("%q taken for answered elsewhere", r)
+		}
+	}
+}
diff --git a/callaudio/callaudio.go b/callaudio/callaudio.go
new file mode 100644
index 0000000..9d8634c
--- /dev/null
+++ b/callaudio/callaudio.go
@@ -0,0 +1,64 @@
+// Package callaudio decides when a WhatsApp call holds the device's call audio
+// path: the ALSA "voip"/"voipsource" streams glue/call.c opens, and the active
+// call it reports to audiod with phone/CallStatusUpdate. audiod pauses the music
+// and routes to the earpiece for an active call, so the path must only be taken
+// by a call that is really in progress.
+//
+// It is plain Go, without cgo, so that it can be tested on its own; call.go
+// does the C calls the answers here ask for.
+package callaudio
+
+import "sync"
+
+// TakesPathAtStart reports whether a call holds the audio path from the moment
+// it is set up. An outgoing call does: the user started it and expects the
+// ringback on the earpiece. An incoming call does not until it is answered:
+// while it rings, the device sounds the ringtone and the music keeps playing.
+func TakesPathAtStart(origin string) bool {
+	return origin != "incoming"
+}
+
+// Path is the call audio path, shared by every call. It is open while at least
+// one call holds it. The zero value is a closed path, ready to use.
+type Path struct {
+	mu      sync.Mutex
+	holders map[string]struct{}
+}
+
+// Take records that call id holds the path. It reports whether the path was
+// closed until now, that is, whether the caller must open it. Taking it again
+// for the same call changes nothing.
+func (p *Path) Take(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.holders == nil {
+		p.holders = make(map[string]struct{})
+	}
+	if _, ok := p.holders[id]; ok {
+		return false
+	}
+	p.holders[id] = struct{}{}
+	return len(p.holders) == 1
+}
+
+// Release drops call id's hold. It reports whether that was the last hold, that
+// is, whether the caller must close the path. Releasing a call that never took
+// the path, such as a ringing call that was rejected or missed, changes nothing,
+// so it cannot cut off the audio of another call in progress.
+func (p *Path) Release(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if _, ok := p.holders[id]; !ok {
+		return false
+	}
+	delete(p.holders, id)
+	return len(p.holders) == 0
+}
+
+// Held reports whether call id holds the path.
+func (p *Path) Held(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	_, ok := p.holders[id]
+	return ok
+}
diff --git a/callaudio/callaudio_test.go b/callaudio/callaudio_test.go
new file mode 100644
index 0000000..dfc3684
--- /dev/null
+++ b/callaudio/callaudio_test.go
@@ -0,0 +1,117 @@
+package callaudio
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestTakesPathAtStart(t *testing.T) {
+	if TakesPathAtStart("incoming") {
+		t.Error("a ringing incoming call takes the audio path, so the music stops before it is answered")
+	}
+	if !TakesPathAtStart("outgoing") {
+		t.Error("an outgoing call does not take the audio path when it is placed")
+	}
+}
+
+// The 30 October fault: the music paused while a WhatsApp call was still
+// ringing. Ringing must not touch the path; answering opens it.
+func TestRingingThenAnswered(t *testing.T) {
+	var p Path
+	if p.Held("A") {
+		t.Fatal("a new path is held")
+	}
+	if !p.Take("A") {
+		t.Fatal("answering the call did not open the path")
+	}
+	if !p.Held("A") {
+		t.Fatal("the answered call does not hold the path")
+	}
+	if !p.Release("A") {
+		t.Fatal("hanging up the only call did not close the path")
+	}
+	if p.Held("A") {
+		t.Fatal("the call still holds the path after hanging up")
+	}
+}
+
+func TestRejectedRingingCallLeavesThePathAlone(t *testing.T) {
+	var p Path
+	if p.Release("ringing") {
+		t.Fatal("rejecting a call that never took the path asks to close it")
+	}
+	// With another call in progress, the rejected one must not end its audio.
+	p.Take("active")
+	if p.Release("ringing") {
+		t.Fatal("rejecting a second, ringing call closes the path of the call in progress")
+	}
+	if !p.Held("active") {
+		t.Fatal("the call in progress lost the path")
+	}
+}
+
+func TestTakeTwiceOpensOnce(t *testing.T) {
+	var p Path
+	if !p.Take("A") {
+		t.Fatal("the first take did not open the path")
+	}
+	if p.Take("A") {
+		t.Fatal("taking the path again for the same call asks to open it again")
+	}
+	if !p.Release("A") {
+		t.Fatal("one release after two takes does not close the path")
+	}
+	if p.Release("A") {
+		t.Fatal("a second release asks to close the path again")
+	}
+}
+
+func TestPathStaysOpenUntilTheLastCallEnds(t *testing.T) {
+	var p Path
+	if !p.Take("A") {
+		t.Fatal("the first call did not open the path")
+	}
+	if p.Take("B") {
+		t.Fatal("a second call asks to open a path that is already open")
+	}
+	if p.Release("A") {
+		t.Fatal("ending the first call closes the path the second still holds")
+	}
+	if !p.Release("B") {
+		t.Fatal("ending the last call does not close the path")
+	}
+	if !p.Take("C") {
+		t.Fatal("a call after the path closed does not open it again")
+	}
+}
+
+func TestConcurrentCalls(t *testing.T) {
+	var p Path
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	opened, closed := 0, 0
+	for i := range 64 {
+		wg.Add(1)
+		go func(id string) {
+			defer wg.Done()
+			o := p.Take(id)
+			c := p.Release(id)
+			mu.Lock()
+			if o {
+				opened++
+			}
+			if c {
+				closed++
+			}
+			mu.Unlock()
+		}(fmt.Sprint(i))
+	}
+	wg.Wait()
+	if opened != closed {
+		t.Fatalf("the path was opened %d times and closed %d times", opened, closed)
+	}
+	if opened == 0 {
+		t.Fatal("the path was never opened")
+	}
+}
diff --git a/glue/aec.cc b/glue/aec.cc
new file mode 100644
index 0000000..a4a3490
--- /dev/null
+++ b/glue/aec.cc
@@ -0,0 +1,69 @@
+// webOS WhatsApp calling: echo cancellation through webrtc-audio-processing's AudioProcessing in
+// mobile mode, which runs the same AECM (fixed point, speakerphone routing) the calls used before.
+// AudioProcessing takes 10 ms frames: 160 samples at 16 kHz. The render side (what we play) and the
+// capture side (the mic) run on different threads; AudioProcessing locks them internally, the mutex
+// here only guards the handle's lifetime against start/stop.
+extern "C" {
+#include "aec.h"
+}
+
+#include <modules/audio_processing/include/audio_processing.h>
+
+#include <mutex>
+
+namespace {
+constexpr int kBlockMs = 10;
+std::mutex g_mx;
+rtc::scoped_refptr<webrtc::AudioProcessing> g_apm;
+int g_rate = 0;
+int g_delay_ms = 0;
+} // namespace
+
+extern "C" void wa_aec_start(int fs, int delay_ms)
+{
+	wa_aec_stop();
+	if (fs != 16000 && fs != 8000)
+		return;
+	std::lock_guard<std::mutex> lock(g_mx);
+	rtc::scoped_refptr<webrtc::AudioProcessing> apm = webrtc::AudioProcessingBuilder().Create();
+	if (!apm)
+		return;
+	webrtc::AudioProcessing::Config cfg;
+	cfg.echo_canceller.enabled = true;
+	cfg.echo_canceller.mobile_mode = true; // AECM, speakerphone routing (echoMode 3)
+	apm->ApplyConfig(cfg);
+	g_apm = apm;
+	g_rate = fs;
+	g_delay_ms = delay_ms;
+}
+
+extern "C" void wa_aec_farend(const short *f, int n)
+{
+	std::lock_guard<std::mutex> lock(g_mx);
+	if (!g_apm)
+		return;
+	const webrtc::StreamConfig sc(g_rate, 1);
+	const int blk = g_rate * kBlockMs / 1000;
+	short scratch[480];
+	for (int off = 0; off + blk <= n; off += blk)
+		g_apm->ProcessReverseStream(f + off, sc, sc, scratch);
+}
+
+extern "C" void wa_aec_process(short *mic, int n)
+{
+	std::lock_guard<std::mutex> lock(g_mx);
+	if (!g_apm)
+		return;
+	const webrtc::StreamConfig sc(g_rate, 1);
+	const int blk = g_rate * kBlockMs / 1000;
+	for (int off = 0; off + blk <= n; off += blk) {
+		g_apm->set_stream_delay_ms(g_delay_ms);
+		g_apm->ProcessStream(mic + off, sc, sc, mic + off);
+	}
+}
+
+extern "C" void wa_aec_stop(void)
+{
+	std::lock_guard<std::mutex> lock(g_mx);
+	g_apm = nullptr;
+}
diff --git a/glue/aec.h b/glue/aec.h
new file mode 100644
index 0000000..6eccb33
--- /dev/null
+++ b/glue/aec.h
@@ -0,0 +1,13 @@
+#ifndef WA_AEC_H
+#define WA_AEC_H
+// webOS WhatsApp calling: acoustic echo cancellation for the speakerphone. The TouchPad has no
+// earpiece, so a call runs on the loudspeaker; the mic then re-captures the far-end voice coming out
+// of the speaker and we send it back, so the peer hears themselves. WebRTC's mobile AEC (AECM, fixed
+// point, through webrtc-audio-processing's AudioProcessing) removes it: it needs the far-end (what
+// we PLAY) as a reference, buffered before we process the matching near-end (mic) frame. farend()
+// and process() run on different threads (playback vs capture); see aec.cc for the locking.
+void wa_aec_start(int fs, int delay_ms); // create + init AECM for the capture rate; delay_ms = render->capture echo delay hint
+void wa_aec_farend(const short *f, int n); // buffer the played loudspeaker reference (int16, n a multiple of 160)
+void wa_aec_process(short *mic, int n);    // cancel the echo from the mic IN PLACE
+void wa_aec_stop(void);
+#endif
diff --git a/glue/call.c b/glue/call.c
new file mode 100644
index 0000000..4a4940b
--- /dev/null
+++ b/glue/call.c
@@ -0,0 +1,1104 @@
+// call.c — luna-service2 call service for WhatsApp calling, hosted INSIDE the
+// messaging plugin (imlibpurpletransport) instead of a separate wacallm process.
+//
+// Ported from wacallm's svc/main.c. Differences:
+//   * registers com.palm.whatsapp.call and attaches to libpurple's default
+//     GMainContext (the transport already services it) — no own mainloop, mirroring
+//     signal/purple-presage/src/c/call.c and telegram/tdlib-purple/call-luna.cpp.
+//   * initialised once from glue/login.c (whatsapp_call_luna_init) on login.
+//   * the WhatsApp engine (meowcaller) is attached to the plugin's shared whatsmeow
+//     client in Go (call.go:startCalling) — C here only bridges Luna + audio.
+//
+// Go -> C callbacks (called from call.go):
+//   gowhatsapp_call_on_state(json)      -> push to callStateQuery subscribers (mainloop-safe)
+//   gowhatsapp_call_on_speaker(pcm, n)  -> received PCM -> playout ring -> ALSA playback thread
+//   gowhatsapp_call_audio_active(on)    -> open/close the ALSA playback+capture path
+//   gowhatsapp_call_read_mic(out, n)    -> Go PULLS mic PCM from the C ring
+//   gowhatsapp_call_video_active(on)    -> the call carries video (engine session, see below)
+//   gowhatsapp_call_request_keyframe()  -> the peer wants an IDR from our encoder
+// C -> Go exports (from libwhatsmeow.h): gowhatsapp_go_call_dial/_answer/_hangup/_hangup_all
+
+#include <glib.h>
+#include <luna-service2/lunaservice.h>
+#include <alsa/asoundlib.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <dirent.h>
+#include <sys/resource.h>
+#include <fcntl.h>
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#include "denoise.h"
+#include "aec.h"
+#include "playout.h"
+#include "call.h"
+
+// Acoustic-echo-cancellation delay hint (render -> mic echo). MEASURED on-device by cross-correlating
+// the played far-end against the raw mic echo (AEC_CALIB build + scratchpad/echo_delay.py): 179ms,
+// peak/median 17.8 (confident). AECM's own estimator refines around it. Re-run the calibration if the
+// audio path (ALSA buffer sizes, kernel) changes.
+#define WA_AEC_DELAY_MS 179
+
+#include "libwhatsmeow.h" // go-generated: gowhatsapp_go_call_dial/_answer/_hangup/_hangup_all
+#include "voipkit.h"            // video bridge: access units to and from luneos-rtc-engine
+#include "voipkit_rtcengine.h"  // its socket set-up
+
+// LuneOS has one bus, so one handle serves the Phone app, audiod and the rtc engine alike.
+static LSHandle *g_sh = NULL;
+static int g_registered = 0;
+
+/* ---------- minimal JSON helpers (flat CallSynergizer payloads only) ---------- */
+static gboolean json_str(const char *json, const char *key, char *out, size_t outsz) {
+	char pat[64];
+	snprintf(pat, sizeof pat, "\"%s\"", key);
+	const char *k = strstr(json, pat);
+	if (!k) return FALSE;
+	const char *c = strchr(k + strlen(pat), ':');
+	if (!c) return FALSE;
+	for (c++; *c == ' ' || *c == '\t'; c++) {}
+	if (*c != '"') return FALSE;
+	c++;
+	size_t i = 0;
+	while (*c && *c != '"' && i + 1 < outsz) {
+		if (*c == '\\' && c[1]) c++;
+		out[i++] = *c++;
+	}
+	out[i] = 0;
+	return TRUE;
+}
+static gboolean json_true(const char *json, const char *key) {
+	char pat[64];
+	snprintf(pat, sizeof pat, "\"%s\"", key);
+	const char *k = strstr(json, pat);
+	if (!k) return FALSE;
+	const char *c = strchr(k + strlen(pat), ':');
+	if (!c) return FALSE;
+	for (c++; *c == ' ' || *c == '\t'; c++) {}
+	return strncmp(c, "true", 4) == 0;
+}
+
+// A non-negative integer value, or -1 when the key is missing or not a number.
+static long json_uint(const char *json, const char *key) {
+	char pat[64];
+	snprintf(pat, sizeof pat, "\"%s\"", key);
+	const char *k = strstr(json, pat);
+	if (!k) return -1;
+	const char *c = strchr(k + strlen(pat), ':');
+	if (!c) return -1;
+	for (c++; *c == ' ' || *c == '\t'; c++) {}
+	if (*c < '0' || *c > '9') return -1;
+	long v = 0;
+	for (; *c >= '0' && *c <= '9' && v < 100000; c++) v = v * 10 + (*c - '0');
+	return v;
+}
+
+static void reply(LSHandle *sh, LSMessage *msg, const char *payload) {
+	LSError e;
+	LSErrorInit(&e);
+	if (!LSMessageReply(sh, msg, payload, &e)) {
+		fprintf(stderr, "wa-call: LSMessageReply failed: %s\n", e.message);
+		LSErrorFree(&e);
+	}
+}
+
+/* ---------- video: a luneos-rtc-engine session behind the call's video ----------
+ * The engine (org.webosports.rtcengine; luneos-rtc-engine docs/API.md) decodes the peer's
+ * H.264 and publishes the frames on a gst-shm socket, which the Phone app renders with
+ * LuneOS.Foreign's RtcVideoFactory. On a device with a usable camera it also encodes ours.
+ * glue/voipkit_rtcengine.c moves the access units over the engine's sockets.
+ *
+ * The session runs while the call carries video (Go: gowhatsapp_call_video_active) AND the
+ * user asked to see it (the Phone app's changeMedia {incomingVideo:true} -- legacy webOS's
+ * "Switch to video?" accept). Until then nothing is decoded and audiod keeps treating the
+ * call as a voice call.
+ *
+ * Everything here runs on the GLib mainloop: LS2 calls are not made from Go's threads.
+ * Replies of a session that was closed in the meantime are recognised by g_vid_gen. */
+#define RTC_SERVICE "luna://org.webosports.rtcengine/"
+// Device-side paths the engine binds; its own defaults are in /tmp as well.
+#define RTC_RX_SOCKET "/tmp/wa-rtc-rx.sock"
+#define RTC_TX_SOCKET "/tmp/wa-rtc-tx.sock"
+#define RTC_SHM_PATH "/tmp/wa-rtc-video"
+// Our own camera's picture for the Phone app's inset, while we send (the engine decodes
+// what it encodes); a quarter of the sent frame.
+#define RTC_PREVIEW_PATH "/tmp/wa-rtc-preview"
+#define RTC_PREVIEW_W 320
+#define RTC_PREVIEW_H 240
+// The frame size the engine renders to (and encodes at, with a camera). Receive-only is
+// portrait, as phones send; the engine letterboxes other shapes.
+#define RTC_RX_ONLY_W 480
+#define RTC_RX_ONLY_H 640
+#define RTC_TX_W 640
+#define RTC_TX_H 480
+// 500 kbit/s looked heavily compressed on the far side at 640x480 (sargo, 3 Nov).
+#define RTC_TX_BITRATE 1200000
+// Peer keyframe requests (PLI/FIR) are passed to the encoder at most this often. Every IDR
+// costs the frames after it their share of the bitrate; at 500 ms a lossy link kept the
+// encoder making one every two seconds.
+#define RTC_KEYFRAME_MIN_INTERVAL_US (1000 * 1000)
+// Our camera's picture, in the quarter turns WhatsApp's <video device_orientation> carries:
+// the phone is held upright, which callers announce as 1, and the receiver turns the
+// picture by it.
+#define RTC_TX_ORIENTATION 1
+
+// Which way the phone is held, from the Phone app's changeMedia {deviceOrientation}: quarter
+// turns in the shell's convention (0 top up, 1 left edge up, 2 upside down, 3 right edge up).
+static int g_device_turns;
+
+typedef enum { VID_IDLE, VID_PROBING, VID_STARTING, VID_RUNNING } vid_state_t;
+static vid_state_t g_vid_state = VID_IDLE;
+static int g_vid_call;      // the call carries video (Go)
+static int g_vid_view;      // the user asked to see it (Phone app)
+static int g_vid_failed;    // start failed; no retry until the wish changes
+static int g_vid_retried;   // one stop-and-retry after "already running"
+static int g_vid_tx;        // the running session encodes our camera
+static int g_vid_camera;    // the camera it opens: the front one where there are two
+static int g_vid_w, g_vid_h;
+
+// The turn the peer needs for our picture, as the phone is held now. The camera turns with the
+// phone, so its picture needs the turn for the phone held upright plus the phone's own turn
+// (sargo, 10 Nov: the other way round arrived upside down held sideways); the front camera
+// faces the user, so for the back one the phone's turn counts the other way.
+static int tx_orientation(void) {
+	int turns = g_vid_camera == 1 ? g_device_turns : -g_device_turns;
+	return (RTC_TX_ORIENTATION + turns + 4) & 3;
+}
+static unsigned g_vid_gen;  // bumped on every close
+static gint64 g_last_keyframe_us;
+static char *g_last_callstate_json = NULL; // most recent raw JSON from Go
+
+// TEST-ONLY harness (testInjectVideo, below): feeds a recorded WhatsApp stream to the engine
+// without a call.
+static int g_test_inject_mode;
+static int g_test_inject_delay_ms;
+static int g_test_inject_interval_ms;
+static int g_test_inject_use_real_stream;
+static gboolean test_inject_start_tick(gpointer data);
+// Defined further down, with the rest of the ALSA/audiod bridge.
+static gboolean audiod_status_idle(gpointer d);
+static _Atomic int g_audio_on;
+
+static void video_reconcile(void);
+static void publish_callstate_locked(const char *json);
+
+static bool rtc_log_reply(LSHandle *sh, LSMessage *msg, void *ctx) {
+	(void)sh;
+	fprintf(stderr, "wa-video: rtcengine %s: %s\n", (const char *)ctx, LSMessageGetPayload(msg));
+	return true;
+}
+
+// ctx is passed to cb; with cb NULL the reply is logged and ctx must be the method name.
+static gboolean rtc_call(const char *method, const char *payload, LSFilterFunc cb, void *ctx) {
+	char uri[96];
+	LSError e;
+	LSMessageToken t;
+	if (!g_sh) return FALSE;
+	snprintf(uri, sizeof uri, "%s%s", RTC_SERVICE, method);
+	LSErrorInit(&e);
+	if (!LSCallOneReply(g_sh, uri, payload, cb ? cb : rtc_log_reply, cb ? ctx : (void *)method,
+	                    &t, &e)) {
+		fprintf(stderr, "wa-video: rtcengine %s call failed: %s\n", method, e.message);
+		LSErrorFree(&e);
+		return FALSE;
+	}
+	return TRUE;
+}
+
+static int video_shown(void) {
+	return g_vid_state == VID_RUNNING;
+}
+
+// Republish the call state (videoURI changed) and tell audiod (a video call leaves the
+// earpiece for the speaker -- audiod's own policy, unless a headset or BT is connected).
+static void video_changed(void) {
+	if (g_last_callstate_json) publish_callstate_locked(g_last_callstate_json);
+	if (g_audio_on) audiod_status_idle(GINT_TO_POINTER(1));
+}
+
+static void test_inject_begin(void);
+static void video_start_session(int tx);
+
+static bool rtc_start_reply(LSHandle *sh, LSMessage *msg, void *ctx) {
+	(void)sh;
+	const char *p = LSMessageGetPayload(msg);
+	gboolean ok = p && json_true(p, "returnValue");
+	char err[128] = "", rx[108] = RTC_RX_SOCKET, tx[108] = RTC_TX_SOCKET;
+	if (GPOINTER_TO_UINT(ctx) != g_vid_gen || g_vid_state != VID_STARTING) {
+		// Closed while starting: stop what this start brought up.
+		if (ok) rtc_call("stop", "{}", NULL, NULL);
+		return true;
+	}
+	if (!ok) {
+		if (p) json_str(p, "errorText", err, sizeof err);
+		g_vid_state = VID_IDLE;
+		if (!g_vid_retried && strcmp(err, "already running") == 0) {
+			// A session we lost track of (the service restarted during a call): stop it and
+			// start ours.
+			fprintf(stderr, "wa-video: engine already running, stopping it and retrying\n");
+			g_vid_retried = 1;
+			rtc_call("stop", "{}", NULL, NULL);
+			video_reconcile();
+			return true;
+		}
+		if (g_vid_tx && strcmp(err, "tx start failed") == 0) {
+			// No usable camera or encoder after all (capabilities counts cameras, not
+			// encoders): still show the peer.
+			fprintf(stderr, "wa-video: engine cannot send video, receiving only\n");
+			video_start_session(0);
+			return true;
+		}
+		fprintf(stderr, "wa-video: engine start failed: %s\n", err[0] ? err : (p ? p : "?"));
+		g_vid_failed = 1;
+		return true;
+	}
+	json_str(p, "rxSocket", rx, sizeof rx);
+	json_str(p, "txSocket", tx, sizeof tx);
+	if (!voipkit_rtcengine_set_sockets(g_vid_tx ? tx : NULL, rx)) {
+		fprintf(stderr, "wa-video: unusable socket paths in %s\n", p);
+		rtc_call("stop", "{}", NULL, NULL);
+		g_vid_state = VID_IDLE;
+		g_vid_failed = 1;
+		return true;
+	}
+	voipkit_video_start();
+	g_vid_state = VID_RUNNING;
+	fprintf(stderr, "wa-video: engine running (%dx%d, tx %s)\n", g_vid_w, g_vid_h,
+	        g_vid_tx ? "on" : "off");
+	// The renderer joins mid-stream: ask the peer for an IDR to start decoding from.
+	gowhatsapp_go_call_request_peer_keyframe();
+	if (g_vid_tx) gowhatsapp_go_call_set_video_orientation(tx_orientation());
+	video_changed();
+	if (g_test_inject_mode) test_inject_begin();
+	return true;
+}
+
+static void video_start_session(int tx) {
+	char payload[512];
+	g_vid_tx = tx;
+	g_vid_w = tx ? RTC_TX_W : RTC_RX_ONLY_W;
+	g_vid_h = tx ? RTC_TX_H : RTC_RX_ONLY_H;
+	snprintf(payload, sizeof payload,
+	         "{\"rxSocket\":\"%s\",\"txSocket\":\"%s\",\"rxEnabled\":true,\"txEnabled\":%s,"
+	         "\"shmPath\":\"%s\",\"width\":%d,\"height\":%d,\"bitrate\":%d,\"camera\":%d,"
+	         "\"previewShmPath\":\"%s\",\"previewWidth\":%d,\"previewHeight\":%d}",
+	         RTC_RX_SOCKET, RTC_TX_SOCKET, tx ? "true" : "false", RTC_SHM_PATH, g_vid_w,
+	         g_vid_h, RTC_TX_BITRATE, g_vid_camera, tx ? RTC_PREVIEW_PATH : "", RTC_PREVIEW_W,
+	         RTC_PREVIEW_H);
+	g_vid_state = VID_STARTING;
+	if (!rtc_call("start", payload, rtc_start_reply, GUINT_TO_POINTER(g_vid_gen))) {
+		g_vid_state = VID_IDLE;
+		g_vid_failed = 1;
+	}
+}
+
+static bool rtc_caps_reply(LSHandle *sh, LSMessage *msg, void *ctx) {
+	(void)sh;
+	const char *p = LSMessageGetPayload(msg);
+	if (GPOINTER_TO_UINT(ctx) != g_vid_gen || g_vid_state != VID_PROBING) return true;
+	if (!p || !json_true(p, "returnValue")) {
+		fprintf(stderr, "wa-video: engine capabilities failed: %s\n", p ? p : "?");
+		g_vid_state = VID_IDLE;
+		g_vid_failed = 1;
+		return true;
+	}
+	// videoCallCapable honours the device's own policy (deviceinfo_video_call): a device
+	// without a usable camera still shows the peer, it just sends no video.
+	// A video call shows the user's face: with two cameras take the front one. Android's
+	// HAL numbers the main back camera 0 and the front camera 1, and the engine's droid
+	// backend passes the index to droidcamsrc as that HAL id.
+	g_vid_camera = json_uint(p, "cameraCount") >= 2 ? 1 : 0;
+	video_start_session(json_true(p, "videoCallCapable"));
+	return true;
+}
+
+static void video_close(void) {
+	vid_state_t was = g_vid_state;
+	g_vid_gen++;
+	g_vid_state = VID_IDLE;
+	if (was == VID_IDLE) return;
+	voipkit_video_stop();
+	// STARTING: rtc_start_reply sees the old generation and stops what it started.
+	if (was == VID_RUNNING) rtc_call("stop", "{}", NULL, NULL);
+	fprintf(stderr, "wa-video: engine session closed\n");
+	video_changed();
+}
+
+static void video_reconcile(void) {
+	int want = g_vid_call && g_vid_view;
+	if (!want) {
+		g_vid_failed = 0;
+		g_vid_retried = 0;
+		video_close();
+		return;
+	}
+	if (g_vid_state != VID_IDLE || g_vid_failed) return;
+	g_vid_state = VID_PROBING;
+	if (!rtc_call("capabilities", "{}", rtc_caps_reply, GUINT_TO_POINTER(g_vid_gen))) {
+		g_vid_state = VID_IDLE;
+		g_vid_failed = 1;
+	}
+}
+
+static gboolean video_active_idle(gpointer d) {
+	g_vid_call = GPOINTER_TO_INT(d);
+	if (!g_vid_call && !g_test_inject_mode) g_vid_view = 0; // a new call asks again
+	video_reconcile();
+	return G_SOURCE_REMOVE;
+}
+
+// Called from Go (a goroutine) whenever the call's overall video state flips (see
+// gowhatsapp_go_call_changemedia, OnVideoState and OnEnd in call.go).
+void gowhatsapp_call_video_active(int on) {
+	g_idle_add(video_active_idle, GINT_TO_POINTER(on ? 1 : 0));
+}
+
+static gboolean keyframe_idle(gpointer d) {
+	(void)d;
+	gint64 now = g_get_monotonic_time();
+	if (g_vid_state != VID_RUNNING || !g_vid_tx) return G_SOURCE_REMOVE;
+	if (now - g_last_keyframe_us < RTC_KEYFRAME_MIN_INTERVAL_US) return G_SOURCE_REMOVE;
+	g_last_keyframe_us = now;
+	rtc_call("requestKeyframe", "{}", NULL, NULL);
+	return G_SOURCE_REMOVE;
+}
+
+// Called from Go (Call.OnVideoKeyframeRequest) when the peer sends PLI/FIR feedback: our
+// encoder should make its next access unit an IDR.
+void gowhatsapp_call_request_keyframe(void) {
+	g_idle_add(keyframe_idle, NULL);
+}
+
+// Fills Go's "videoURI":"" placeholder with the engine's shm socket and frame size while a
+// session runs. Caller g_free()s the result.
+static char *inject_video_uri(const char *json) {
+	static const char needle[] = "\"videoURI\":\"\"";
+	const char *pos = strstr(json, needle);
+	if (!pos || !video_shown()) return g_strdup(json);
+	// While we send, our own picture too: turned like the sent one, mirrored for the front
+	// camera as a mirror shows the user.
+	char preview[192] = "";
+	if (g_vid_tx)
+		snprintf(preview, sizeof preview,
+		         ",\"videoPreviewURI\":\"%s\",\"videoPreviewWidth\":%d,\"videoPreviewHeight\":%d,"
+		         "\"videoPreviewOrientation\":%d,\"videoPreviewMirrored\":%s",
+		         RTC_PREVIEW_PATH, RTC_PREVIEW_W, RTC_PREVIEW_H, RTC_TX_ORIENTATION,
+		         g_vid_camera == 1 ? "true" : "false");
+	return g_strdup_printf("%.*s\"videoURI\":\"%s\",\"videoWidth\":%d,\"videoHeight\":%d%s%s",
+	                       (int)(pos - json), json, RTC_SHM_PATH, g_vid_w, g_vid_h, preview,
+	                       pos + sizeof(needle) - 1);
+}
+
+static void publish_callstate_locked(const char *json) {
+	char *out = inject_video_uri(json);
+	LSError e;
+	LSErrorInit(&e);
+	if (g_sh && !LSSubscriptionReply(g_sh, "callState", out, &e))
+		LSErrorFree(&e);
+	g_free(out);
+}

+/* ---------- Go -> C: push callState to subscribers on the mainloop ---------- */
+static gboolean push_callstate(gpointer data) {
+	char *json = (char *)data;
+	g_free(g_last_callstate_json);
+	g_last_callstate_json = g_strdup(json);
+	publish_callstate_locked(json);
+	g_free(json);

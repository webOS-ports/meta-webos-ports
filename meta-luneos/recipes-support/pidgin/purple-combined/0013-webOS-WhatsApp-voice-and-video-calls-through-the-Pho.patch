+#include "fakes.h"
+#include <alsa/asoundlib.h>
+#include <luna-service2/lunaservice.h>
+#include <errno.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <string.h>
+#include <time.h>
+#include "libwhatsmeow.h"
+#include "voipkit.h"
+#include "voipkit_rtcengine.h"
+#include "aec.h"

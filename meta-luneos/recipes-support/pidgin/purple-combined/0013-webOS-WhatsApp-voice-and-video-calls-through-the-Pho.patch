+++ b/glue/tests/fakes.h
@@ -0,0 +1,67 @@
+// Fakes glue/call.c is linked against in call_playback_test: a fake ALSA device that records what
+// is written to it at a scaled device pace, AECM that records its far-end reference, and no-op
+// luna-service2, voipkit and Go exports.
+#ifndef WA_TEST_FAKES_H
+#define WA_TEST_FAKES_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FAKE_MAX_SAMPLES (16000 * 60) /* one minute at 16 kHz */
+#define FAKE_SPEEDUP 4                /* the fake device consumes 4x faster than real time */
+
+struct fake_state {
+	int playback_opens, capture_opens, closes, drops, recovers;
+	int inject_epipe;       // next N playback writes fail with -EPIPE
+	long written_n;         // samples accepted by the playback device
+	short written[FAKE_MAX_SAMPLES];
+	long farend_n;          // samples handed to wa_aec_farend
+	short farend[FAKE_MAX_SAMPLES];
+	int farend_bad_len;     // farend calls whose length was not a multiple of 160
+
+	// The video bridge and the Go export it uses (call_video_test).
+	int video_starts, video_stops, peer_keyframe_requests;
+	int video_orientation, video_orientation_sets; /* gowhatsapp_go_call_set_video_orientation */
+	int changemedia_calls;                         /* gowhatsapp_go_call_changemedia */
+	char tx_socket[128], rx_socket[128];
+	int set_sockets_ok;     // what voipkit_rtcengine_set_sockets answers (reset: 1)
+
+	// luna-service2: LS2 calls made, in order, with what is needed to answer them.
+	int ls_registered;      // LSRegister & co. succeed when set
+	int ncalls;
+	struct fake_ls_call {
+		char uri[160];
+		char payload[1024];
+		void *cb;           // LSFilterFunc
+		void *ctx;
+	} calls[64];
+	int nsubscription_replies;
+	char last_subscription_reply[2048];
+	char last_method_reply[256];
+};
+
+// An LSMessage as the fakes hand it to reply callbacks: just its payload.
+struct fake_msg {
+	const char *payload;
+};
+// Answers LS2 call number `index` with `payload`.
+void fake_reply(int index, const char *payload);
+// Calls com.palm.whatsapp.call's `method` as a client would; 0 if call.c has no such method.
+int fake_invoke(const char *method, const char *payload);
+extern struct fake_state fake;
+void fake_reset(void);
+void fake_lock(void);
+void fake_unlock(void);
+
+// glue/call.c's entry points the tests drive.
+void gowhatsapp_call_audio_active(int on);
+void gowhatsapp_call_on_speaker(const float *frame, int n);
+void gowhatsapp_call_video_active(int on);
+void gowhatsapp_call_request_keyframe(void);
+void gowhatsapp_call_on_state(const char *json);
+void whatsapp_call_luna_init(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif

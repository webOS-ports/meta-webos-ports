+	evt.Message = &waArmadilloApplication.Armadillo{Payload: &waArmadilloApplication.Armadillo_Payload{
+		Payload: &waArmadilloApplication.Armadillo_Payload_Content{Content: &waArmadilloApplication.Armadillo_Content{

+// fetched_into_memory tells whether media is downloaded into memory before it is written: only
+// Facebook media, which DownloadFB returns as bytes. WhatsApp media, a sticker too, is streamed
+// into its file as it came.
+func fetched_into_memory(message whatsmeow.DownloadableMessage) bool {
+	_, isFacebook := message.(*fbDownloadable)
+	return isFacebook
+}

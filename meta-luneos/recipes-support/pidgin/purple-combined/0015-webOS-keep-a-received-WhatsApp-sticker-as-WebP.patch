 go.sum               |  2 --
 handle_attachment.go | 19 +++++++++++++++--
 sticker_test.go      | 50 ++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 67 insertions(+), 5 deletions(-)
 create mode 100644 sticker_test.go


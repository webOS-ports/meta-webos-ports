+/*
+ * webOS: the receipt setting when the account has none. Upstream's is "when sending a reply"; here
+ * it is "when interacting with the conversation", which the transport raises when the Messaging
+ * app shows the chat (imlibpurpleservice markRead), so a message is marked read once it is read.
+ */
+func receipt_setting(handler *Handler) string {
+	return purple_get_string(handler.account, C.GOWHATSAPP_SEND_RECEIPT_OPTION, C.GOWHATSAPP_SEND_RECEIPT_CHOICE_ON_INTERACT)
+}
+
 /*
  * Puts ID and sender of a received message in the store.
  *
  * Except if the purple setting is "never send receipts". Then it does nothing.
  */
 func (handler *Handler) mark_read_defer(id types.MessageID, chat types.JID, sender types.JID) {
-	default_setting := C.GOWHATSAPP_SEND_RECEIPT_CHOICE_ON_ANSWER
 	never := C.GoString(C.GOWHATSAPP_SEND_RECEIPT_CHOICE_NEVER)
-	setting := purple_get_string(handler.account, C.GOWHATSAPP_SEND_RECEIPT_OPTION, default_setting)
-	if never == setting {
+	if never == receipt_setting(handler) {
 		return
 	}
-
-	// append to map of map of ids
-	// I really could go for a python defaultdict here
-	senders, ok := handler.deferredReceipts[chat]
-	if !ok {
-		// first sender in this chat
-		senders = make(map[types.JID][]types.MessageID)
-		ids := []types.MessageID{id}
-		senders[sender] = ids
-	} else {
-		// chat already has senders
-		ids, ok := senders[sender]
-		if !ok {
-			// first id for this sender
-			ids = []types.MessageID{id}
-		} else {
-			ids = append(ids, id)
-		}
-		senders[sender] = ids
-	}
-	handler.deferredReceipts[chat] = senders
+	handler.deferredReceipts.add(chat, sender, id)
 }
 

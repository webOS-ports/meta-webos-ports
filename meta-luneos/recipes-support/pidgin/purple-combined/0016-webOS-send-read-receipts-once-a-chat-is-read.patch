diff --git a/handle_message.go b/handle_message.go
index 4649629..5a88e31 100644
--- a/handle_message.go
+++ b/handle_message.go
@@ -609,6 +609,15 @@ func (handler *Handler) handle_message(message *waE2E.Message, info types.Messag
 	}
 	// evt.Info still holds the chat and sender as received, before the conversions above
 	handler.add_to_cache(message, info.ID, info.MessageSource.Chat, info.MessageSource.Sender, evt.Info.MessageSource, info.Timestamp)
+	// webOS: keep what a read receipt needs for each message received, under the chat's name as
+	// the conversation has it (as purple_display_text_message gives it above). Nothing ever did,
+	// so no read receipt was sent at all. Sent when the chat is read (glue/receipt.c), or at once with
+	// the "immediately" setting.
+	if !info.MessageSource.IsFromMe && !isEdit {
+		chat := info.MessageSource.Chat.ToNonAD()
+		handler.mark_read_defer(info.ID, chat, info.MessageSource.Sender)
+		handler.mark_read_if_on_receival(chat)
+	}
 }
 

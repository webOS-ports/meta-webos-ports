diff --git a/deferred_receipts.go b/deferred_receipts.go
new file mode 100644
index 0000000..838af1b
--- /dev/null
+++ b/deferred_receipts.go
@@ -0,0 +1,45 @@
+package main
+
+import (
+	"sync"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+/*
+ * webOS: the read receipts still to send, per chat and per sender. Received messages are added
+ * on whatsmeow's event goroutine and a chat's receipts are taken on libpurple's main loop when the
+ * chat is read (glue/receipt.c), so the store is locked. Taking a chat's receipts removes them: a
+ * receipt goes once, not again each time the chat is looked at. The zero value is ready to use.
+ */
+type deferredReceiptStore struct {
+	mutex   sync.Mutex
+	pending map[types.JID]map[types.JID][]types.MessageID
+}
+
+// Keep the receipt for message id from sender in chat.
+func (store *deferredReceiptStore) add(chat types.JID, sender types.JID, id types.MessageID) {
+	store.mutex.Lock()
+	defer store.mutex.Unlock()
+	if store.pending == nil {
+		store.pending = make(map[types.JID]map[types.JID][]types.MessageID)
+	}
+	senders, ok := store.pending[chat]
+	if !ok {
+		senders = make(map[types.JID][]types.MessageID)
+		store.pending[chat] = senders
+	}
+	senders[sender] = append(senders[sender], id)
+}
+
+// The receipts kept for chat, by sender, and forget them. nil when there are none.
+func (store *deferredReceiptStore) take(chat types.JID) map[types.JID][]types.MessageID {
+	store.mutex.Lock()
+	defer store.mutex.Unlock()
+	senders, ok := store.pending[chat]
+	if !ok {
+		return nil
+	}
+	delete(store.pending, chat)
+	return senders
+}
diff --git a/deferred_receipts_test.go b/deferred_receipts_test.go
new file mode 100644
index 0000000..c51b642
--- /dev/null
+++ b/deferred_receipts_test.go
@@ -0,0 +1,77 @@
+package main
+
+import (
+	"sync"
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+var (
+	anna  = types.NewJID("31611111111", types.DefaultUserServer)
+	ben   = types.NewJID("31622222222", types.DefaultUserServer)
+	group = types.NewJID("120363000000000000", types.GroupServer)
+)
+
+func TestReceiptsAreKeptPerChatAndSender(t *testing.T) {
+	var store deferredReceiptStore
+	store.add(anna, anna, "A1")
+	store.add(group, anna, "G1")
+	store.add(group, ben, "G2")
+	store.add(group, anna, "G3")
+
+	got := store.take(group)
+	if len(got) != 2 || len(got[anna]) != 2 || got[anna][0] != "G1" || got[anna][1] != "G3" || len(got[ben]) != 1 || got[ben][0] != "G2" {
+		t.Fatalf("group receipts: %v", got)
+	}
+	if a := store.take(anna); len(a) != 1 || len(a[anna]) != 1 || a[anna][0] != "A1" {
+		t.Fatalf("anna's chat is its own: %v", a)
+	}
+}
+
+func TestAReceiptGoesOnce(t *testing.T) {
+	var store deferredReceiptStore
+	store.add(anna, anna, "A1")
+	if store.take(anna) == nil {
+		t.Fatal("nothing kept")
+	}
+	if again := store.take(anna); again != nil {
+		t.Fatalf("taken twice: %v", again)
+	}
+	store.add(anna, anna, "A2")
+	if got := store.take(anna); len(got[anna]) != 1 || got[anna][0] != "A2" {
+		t.Fatalf("only what came after: %v", got)
+	}
+}
+
+func TestNothingKeptIsNil(t *testing.T) {
+	var store deferredReceiptStore
+	if got := store.take(anna); got != nil {
+		t.Fatalf("an empty store: %v", got)
+	}
+}
+
+// Received messages are added on whatsmeow's goroutine while the main loop takes a read chat's:
+// nothing may be lost or sent twice. Run with -race.
+func TestAddingAndTakingAtOnce(t *testing.T) {
+	var store deferredReceiptStore
+	const n = 2000
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < n; i++ {
+			store.add(anna, anna, types.MessageID(rune('a'+i%26))+types.MessageID(string(rune('0'+i/26%10))))
+		}
+	}()
+	taken := 0
+	for taken < n {
+		for _, ids := range store.take(anna) {
+			taken += len(ids)
+		}
+	}
+	wg.Wait()
+	if taken != n || store.take(anna) != nil {
+		t.Fatalf("took %d of %d", taken, n)
+	}
+}

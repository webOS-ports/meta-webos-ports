@@ -94,11 +80,15 @@ func (handler *Handler) mark_read_conversation(chat string) {
  * mark_read_defer(…) should have been called before.
  */
 func (handler *Handler) mark_read_unconditionally(chat types.JID) {
-	senders, ok := handler.deferredReceipts[chat]
-	if ok {
-		for sender, ids := range senders {
-			handler.mark_read(ids, chat, sender)
-		}
+	senders := handler.deferredReceipts.take(chat)
+	if senders != nil {
+		// webOS: off the caller's goroutine, which for the chat being read is libpurple's main
+		// loop: each receipt is a round trip to the server.
+		go func() {
+			for sender, ids := range senders {
+				handler.mark_read(ids, chat, sender)
+			}
+		}()
 	}
 }
 

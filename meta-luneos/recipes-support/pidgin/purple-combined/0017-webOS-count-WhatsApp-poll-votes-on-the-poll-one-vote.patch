new file mode 100644
index 0000000..4692e70
--- /dev/null
+++ b/poll_tally.go
@@ -0,0 +1,144 @@
+package main
+
+// webOS: the votes on a poll, shown on the poll itself.
+//
+// A vote came in as a message of its own, "voted in poll „Lunch?“ for „Pizza“", under the poll.
+// Now each voter's latest choice is kept per poll, and the poll message is rewritten in place
+// ("webos-im-edit") with the count for each option, which the Messaging app draws next to it.
+// WhatsApp sends a voter's whole choice each time, so a vote replaces that voter's last one, and
+// an empty one takes it back. Kept in <purple user dir>/<username>.polls.json, so a restart does
+// not start the counts again from nothing.
+//
+// Each poll seen is kept there too (its question, options and how many may be chosen), so a vote
+// still finds its poll when the message cache no longer has it: the cache is only written at a clean
+// log-out (login.go, close) and holds the last 500 messages of all kinds, while this file is written
+// at every change.
+
+import (
+	"encoding/json"
+	"os"
+	"slices"
+	"sync"
+)
+
+// The polls kept; the oldest go first beyond this
+const pollTallyMax = 500
+
+type pollTally struct {
+	mu    sync.Mutex
+	path  string
+	Polls map[string]map[string][]string `json:"polls"`          // poll message id -> voter -> option names
+	Defs  map[string]pollDef             `json:"defs,omitempty"` // poll message id -> the poll
+	Order []string                       `json:"order"`          // poll message ids, oldest first
+}
+
+// pollDef is what a poll asks: its question, its options in their order, and how many may be chosen
+// (PollCreationMessage.SelectableOptionsCount: 1 one, 0 any number).
+type pollDef struct {
+	Name    string   `json:"name"`
+	Options []string `json:"options"`
+	Max     int      `json:"max"`
+}
+
+// loadPollTally reads the votes kept at path ("" keeps them in memory only).
+func loadPollTally(path string) *pollTally {
+	t := &pollTally{path: path}
+	if path != "" {
+		if data, err := os.ReadFile(path); err == nil {
+			_ = json.Unmarshal(data, t)
+		}
+	}
+	if t.Polls == nil {
+		t.Polls = make(map[string]map[string][]string)
+	}
+	if t.Defs == nil {
+		t.Defs = make(map[string]pollDef)
+	}
+	return t
+}
+
+// keepLocked puts a poll among those kept, if it is not already; the oldest go beyond pollTallyMax.
+func (t *pollTally) keepLocked(pollID string) {
+	_, counted := t.Polls[pollID]
+	_, defined := t.Defs[pollID]
+	if counted || defined {
+		return
+	}
+	t.Order = append(t.Order, pollID)
+	for len(t.Order) > pollTallyMax {
+		delete(t.Polls, t.Order[0])
+		delete(t.Defs, t.Order[0])
+		t.Order = t.Order[1:]
+	}
+}
+
+// remember keeps what a poll asks, for its votes to be counted on.
+func (t *pollTally) remember(pollID string, def pollDef) {
+	if pollID == "" {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if old, known := t.Defs[pollID]; known && old.Name == def.Name && old.Max == def.Max && slices.Equal(old.Options, def.Options) {
+		return
+	}
+	t.keepLocked(pollID)
+	def.Options = append([]string(nil), def.Options...)
+	t.Defs[pollID] = def
+	t.saveLocked()
+}
+
+// poll is what a poll kept asks.
+func (t *pollTally) poll(pollID string) (pollDef, bool) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	def, known := t.Defs[pollID]
+	if known {
+		def.Options = append([]string(nil), def.Options...)
+	}
+	return def, known
+}
+
+// vote records a voter's whole choice in a poll, none taking their vote back, and returns how many
+// voters chose each of options, in their order.
+func (t *pollTally) vote(pollID, voter string, chosen []string, options []string) []int {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	voters, known := t.Polls[pollID]
+	if !known {
+		t.keepLocked(pollID)
+		voters = make(map[string][]string)
+		t.Polls[pollID] = voters
+	}
+	if len(chosen) == 0 {
+		delete(voters, voter)
+	} else {
+		voters[voter] = append([]string(nil), chosen...)
+	}
+	t.saveLocked()
+	return countVotes(voters, options)
+}
+
+func countVotes(voters map[string][]string, options []string) []int {
+	counts := make([]int, len(options))
+	for _, chosen := range voters {
+		for i, option := range options {
+			for _, c := range chosen {
+				if c == option {
+					counts[i]++
+					break
+				}
+			}
+		}
+	}
+	return counts
+}
+
+func (t *pollTally) saveLocked() {
+	if t.path == "" {
+		return
+	}
+	if data, err := json.Marshal(t); err == nil {
+		_ = os.WriteFile(t.path, data, 0600)
+	}
+}

+package main
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+// A key found under the LID, asked by the number: the vote is made as the LID, which is how
+// whatsmeow picks our own LID to vote as.
+func TestPollKeySenderIsWhereTheKeyIs(t *testing.T) {
+	pn := types.NewJID("31600000001", types.DefaultUserServer)
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	if got := pollKeySender(pn, lid); got != lid {
+		t.Fatalf("asked by the number, kept under the LID: got %s, want %s", got, lid)
+	}
+	if got := pollKeySender(pn, pn); got != pn {
+		t.Fatalf("kept under the number: got %s, want %s", got, pn)
+	}
+	if got := pollKeySender(pn, types.EmptyJID); got != pn {
+		t.Fatalf("no stored sender: got %s, want what was asked, %s", got, pn)
+	}
+}

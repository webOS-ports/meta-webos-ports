+// pollToken is the "poll:" token for a poll, with the counts of its votes where there are any.
+func pollToken(name string, options []string, max int, votes []int) string {
+	data, err := json.Marshal(pollPayload{Name: name, Options: options, Max: max, Votes: votes})
+	if err != nil {
+		return "Poll: " + name
+	}
+	return "poll:" + base64.RawURLEncoding.EncodeToString(data)
+}
+
+func pollOptionNames(pcm *waE2E.PollCreationMessage) []string {
+	opts := pcm.GetOptions()
+	names := make([]string, 0, len(opts))
+	for _, option := range opts {
+		names = append(names, option.GetOptionName())
+	}
+	return names
 }
 

+
+var lunch = []string{"Pizza", "Soup", "Pasta"}
+
+func TestPollTallyCountsEachVotersLatestChoice(t *testing.T) {
+	tally := loadPollTally("")
+	if got := tally.vote("P1", "anna", []string{"Pizza"}, lunch); !reflect.DeepEqual(got, []int{1, 0, 0}) {
+		t.Fatalf("got %v", got)
+	}
+	if got := tally.vote("P1", "bert", []string{"Pizza", "Pasta"}, lunch); !reflect.DeepEqual(got, []int{2, 0, 1}) {
+		t.Fatalf("got %v", got)
+	}
+	// A new choice replaces the last; the same option twice counts once
+	if got := tally.vote("P1", "anna", []string{"Soup", "Soup"}, lunch); !reflect.DeepEqual(got, []int{1, 1, 1}) {
+		t.Fatalf("got %v", got)
+	}
+	// None takes the vote back
+	if got := tally.vote("P1", "bert", nil, lunch); !reflect.DeepEqual(got, []int{0, 1, 0}) {
+		t.Fatalf("got %v", got)
+	}
+	// Another poll is counted apart; an option the poll has not counts nowhere
+	if got := tally.vote("P2", "anna", []string{"Salad"}, lunch); !reflect.DeepEqual(got, []int{0, 0, 0}) {
+		t.Fatalf("got %v", got)
+	}
+}
+
+func TestPollTallyKeptAcrossRestart(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "me.polls.json")
+	tally := loadPollTally(path)
+	tally.vote("P1", "anna", []string{"Pizza"}, lunch)
+	tally.vote("P1", "bert", []string{"Soup"}, lunch)
+
+	again := loadPollTally(path)
+	if got := again.vote("P1", "carl", []string{"Pizza"}, lunch); !reflect.DeepEqual(got, []int{2, 1, 0}) {
+		t.Fatalf("got %v after reload", got)
+	}
+	// A file that is not ours is no votes, and no crash
+	if bad := loadPollTally(filepath.Join(t.TempDir(), "missing.json")); len(bad.Polls) != 0 {
+		t.Fatalf("votes from nowhere: %v", bad.Polls)
+	}
+}
+
+func TestPollTallyForgetsTheOldestPolls(t *testing.T) {
+	tally := loadPollTally("")
+	for i := 0; i <= pollTallyMax; i++ {
+		tally.vote(string(rune('A'+i%26))+string(rune(i)), "anna", []string{"Pizza"}, lunch)
+	}
+	if len(tally.Polls) != pollTallyMax || len(tally.Order) != pollTallyMax {
+		t.Fatalf("%d polls, %d in order; want %d", len(tally.Polls), len(tally.Order), pollTallyMax)
+	}
+	if _, kept := tally.Polls[string(rune('A'))+string(rune(0))]; kept {
+		t.Fatal("the oldest poll was kept")
+	}
+}
+
+func TestPollTokenCarriesVotes(t *testing.T) {
+	plain := pollToken("Lunch?", lunch, 1, nil)
+	counted := pollToken("Lunch?", lunch, 1, []int{2, 0, 1})
+	if got := decodePollToken(t, plain); got != `{"name":"Lunch?","options":["Pizza","Soup","Pasta"],"max":1}` {
+		t.Fatalf("got %s", got)
+	}
+	if got := decodePollToken(t, counted); got != `{"name":"Lunch?","options":["Pizza","Soup","Pasta"],"max":1,"votes":[2,0,1]}` {
+		t.Fatalf("got %s", got)
+	}
+}
+
+func decodePollToken(t *testing.T, token string) string {
+	t.Helper()
+	if !strings.HasPrefix(token, "poll:") {
+		t.Fatalf("not a poll token: %q", token)
+	}
+	data, err := base64.RawURLEncoding.DecodeString(strings.TrimPrefix(token, "poll:"))
+	if err != nil {
+		t.Fatalf("token %q: %v", token, err)
+	}
+	return string(data)
+}
+
+// Votes come from the event handler and from send_app_poll_vote's goroutine at once.
+func TestPollTallyVotesFromManyGoroutines(t *testing.T) {
+	tally := loadPollTally(filepath.Join(t.TempDir(), "polls.json"))
+	options := []string{"Pizza", "Soup"}
+	done := make(chan []int)
+	for i := 0; i < 8; i++ {
+		go func(i int) {
+			var counts []int
+			for j := 0; j < 20; j++ {
+				counts = tally.vote("poll"+string(rune('A'+j%3)), "voter"+string(rune('a'+i)), []string{options[(i+j)%2]}, options)
+			}
+			done <- counts
+		}(i)
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+	got := tally.vote("pollA", "late", []string{"Pizza", "Soup"}, options)
+	if got[0]+got[1] != 8+2 {
+		t.Fatalf("pollA counts %v: want 9 voters, 10 choices", got)
+	}
+}
+
+// The people and the group of the vote tests: we are 31600000001, by LID 900000000000001.
+var (
+	pollGroup = types.NewJID("120363000000000001", types.GroupServer)
+	usPN      = types.JID{User: "31600000001", Server: types.DefaultUserServer, Device: 12}
+	usLID     = types.JID{User: "900000000000001", Server: types.HiddenUserServer, Device: 3}
+	annaPN    = types.NewJID("31600000002", types.DefaultUserServer)
+	annaLID   = types.JID{User: "900000000000002", Server: types.HiddenUserServer, Device: 7}
+	annaPhone = types.JID{User: "31600000002", Server: types.DefaultUserServer, Device: 4} // her phone, as a device
+)
+
+// voteLidMap stands in for whatsmeow's LID map: what lidToPn makes of a JID with the map as given.
+func voteLidMap(known map[string]types.JID) func(types.JID) types.JID {
+	return func(jid types.JID) types.JID {
+		if pn, ok := known[jid.User]; ok && jid.Server == types.HiddenUserServer {
+			pn.Device = jid.Device
+			return pn
+		}
+		return jid
+	}
+}
+
+func pollCreation(name string, options ...string) *waE2E.PollCreationMessage {
+	pcm := &waE2E.PollCreationMessage{Name: proto.String(name), SelectableOptionsCount: proto.Uint32(1)}
+	for _, option := range options {
+		pcm.Options = append(pcm.Options, &waE2E.PollCreationMessage_Option{OptionName: proto.String(option)})
+	}
+	return pcm
+}
+
+// A vote is the SHA-256 of each chosen option's name, as whatsmeow.HashPollOptions makes it.
+func ballot(options ...string) [][]byte {
+	return whatsmeow.HashPollOptions(options)
+}
+
+func TestAVoterIsOnePersonHoweverAddressed(t *testing.T) {
+	known := voteLidMap(map[string]types.JID{annaLID.User: annaPN, usLID.User: usPN.ToNonAD()})
+	unknown := voteLidMap(nil)
+	for _, c := range []struct {
+		what   string
+		source types.MessageSource
+		lids   func(types.JID) types.JID
+		want   types.JID
+	}{
+		{"anna by number", types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: annaPhone}, unknown, annaPN},
+		{"anna by LID, LID known", types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: annaLID}, known, annaPN},
+		{"anna by LID, number beside it", types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: annaLID, SenderAlt: annaPN}, unknown, annaPN},
+		{"anna by LID, nothing known", types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: annaLID}, unknown, annaLID.ToNonAD()},
+		{"us from our phone by number", types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: usPN, IsFromMe: true}, unknown, usPN.ToNonAD()},
+		{"us from our phone by LID", types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: usLID, IsFromMe: true}, unknown, usPN.ToNonAD()},
+	} {
+		if got := poll_voter(c.source, usPN, c.lids); got != c.want {
+			t.Errorf("%s: voter %s, want %s", c.what, got, c.want)
+		}
+	}
+	// What send_app_poll_vote counts our vote from this device as is the same voter
+	if got := poll_voter(types.MessageSource{Sender: usPN, IsFromMe: true}, usPN, nil); got != usPN.ToNonAD() {
+		t.Errorf("our own vote: %s", got)
+	}
+}
+
+// Our vote from the phone, by LID, and the same vote again from this device count once.
+func TestOurVoteFromThePhoneAndFromHereCountsOnce(t *testing.T) {
+	handler := &Handler{pollTally: loadPollTally("")}
+	handler.show_poll("P1", pollCreation("Lunch?", lunch...))
+	fromPhone := poll_voter(types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: usLID, IsFromMe: true}, usPN, voteLidMap(nil))
+	handler.poll_vote_outcome("P1", fromPhone.String(), ballot("Soup"))
+	fromHere := poll_voter(types.MessageSource{Sender: usPN, IsFromMe: true}, usPN, nil)
+	token, _ := handler.poll_vote_outcome("P1", fromHere.String(), ballot("Pizza"))
+	if got := decodePollToken(t, token); !strings.Contains(got, `"votes":[1,0,0]`) {
+		t.Fatalf("our two votes counted as two voters: %s", got)
+	}
+}
+
+// A poll we made on the phone comes to us as ours (IsFromMe); it is kept, and kept past a restart
+// that the message cache does not survive, so that its votes are counted.
+func TestAPollFromOurPhoneIsKeptForItsVotes(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "me.polls.json")
+	before := &Handler{pollTally: loadPollTally(path)}
+	if text := before.show_poll("OURPOLL", pollCreation("Lunch?", lunch...)); !strings.HasPrefix(text, "poll:") {
+		t.Fatalf("poll shown as %q", text)
+	}
+	// The restart: the cache is empty (it was never written, the transport did not log out)
+	after := &Handler{pollTally: loadPollTally(path)}
+	poll, known := after.poll_definition("OURPOLL")
+	if !known || poll.Name != "Lunch?" || !reflect.DeepEqual(poll.Options, lunch) || poll.Max != 1 {
+		t.Fatalf("poll after restart: %+v, %v", poll, known)
+	}
+	token, line := after.poll_vote_outcome("OURPOLL", annaPN.String(), ballot("Pasta"))
+	if line != "" || !strings.Contains(decodePollToken(t, token), `"votes":[0,0,1]`) {
+		t.Fatalf("vote after restart: token %q, line %q", token, line)
+	}
+}
+
+// A poll the cache has is found there, whoever made it.
+func TestAPollInTheCacheIsFound(t *testing.T) {
+	handler := &Handler{cachedMessages: []CachedMessage{{
+		ID: "CACHED", Chat: pollGroup, Sender: usPN.ToNonAD(),
+		Source: types.MessageSource{Chat: pollGroup, Sender: usPN.ToNonAD(), IsFromMe: true, IsGroup: true},
+		Message: waE2E.Message{PollCreationMessageV3: pollCreation("Lunch?", lunch...)},
+	}}, pollTally: loadPollTally("")}
+	token, line := handler.poll_vote_outcome("CACHED", annaPN.String(), ballot("Soup"))
+	if line != "" || !strings.Contains(decodePollToken(t, token), `"votes":[0,1,0]`) {
+		t.Fatalf("token %q, line %q", token, line)
+	}
+}
+
+// A vote on a poll we have is counted on it, never a line of its own; only one on a poll we never
+// saw is a line, and it is from whoever voted.
+func TestAVoteIsCountedNotShown(t *testing.T) {
+	handler := &Handler{pollTally: loadPollTally("")}
+	handler.show_poll("P1", pollCreation("Lunch?", lunch...))
+	token, line := handler.poll_vote_outcome("P1", annaPN.String(), ballot("Pizza", "Pasta"))
+	if line != "" || token == "" {
+		t.Fatalf("token %q, line %q", token, line)
+	}
+	// Taking the vote back is counted too
+	if token, line = handler.poll_vote_outcome("P1", annaPN.String(), nil); line != "" || !strings.Contains(decodePollToken(t, token), `"votes":[0,0,0]`) {
+		t.Fatalf("taken back: token %q, line %q", token, line)
+	}
+	if token, line = handler.poll_vote_outcome("NEVERSEEN", annaPN.String(), ballot("Pizza")); token != "" || line != pollUntracked {
+		t.Fatalf("unknown poll: token %q, line %q", token, line)
+	}
+	// Without a tally (before log-in) the vote is told, by the options' names
+	bare := &Handler{cachedMessages: []CachedMessage{{ID: "P2", Message: waE2E.Message{PollCreationMessage: pollCreation("Lunch?", lunch...)}}}}
+	if _, line = bare.poll_vote_outcome("P2", annaPN.String(), ballot("Soup", "Pasta")); line != "voted in poll „Lunch?“ for „Soup“ and „Pasta“." {
+		t.Fatalf("told as %q", line)
+	}
+}
+
+// An option is matched by the hash of its name, whatever the poll carries as OptionHash.
+func TestAVoteMatchesTheOptionsByTheirNames(t *testing.T) {
+	pcm := pollCreation("Lunch?", lunch...)
+	pcm.Options[1].OptionHash = proto.String("not-a-hash-of-soup")
+	handler := &Handler{pollTally: loadPollTally("")}
+	handler.show_poll("P1", pcm)
+	token, _ := handler.poll_vote_outcome("P1", annaPN.String(), append(ballot("Soup"), []byte("garbage")))
+	if got := decodePollToken(t, token); !strings.Contains(got, `"votes":[0,1,0]`) {
+		t.Fatalf("got %s", got)
+	}
+	if chosen, unknown := pollChoice(lunch, append(ballot("Pasta"), []byte("garbage"))); !reflect.DeepEqual(chosen, []string{"Pasta"}) || unknown != 1 {
+		t.Fatalf("chosen %v, unknown %d", chosen, unknown)
+	}
+}
+
+// Another member's vote on a poll that is ours (we made it on our phone: its key has FromMe) is
+// that member's: received, from them, never ours. The poll's FromMe has no part in who voted.
+func TestAnotherMembersVoteOnOurPollIsTheirs(t *testing.T) {
+	for _, source := range []types.MessageSource{
+		{Chat: pollGroup, IsGroup: true, Sender: annaPhone},
+		{Chat: pollGroup, IsGroup: true, Sender: annaLID, SenderAlt: annaPN, AddressingMode: types.AddressingModeLID},
+	} {
+		voter := poll_voter(source, usPN, voteLidMap(map[string]types.JID{annaLID.User: annaPN}))
+		if voter != annaPN || voter.String() == usPN.ToNonAD().String() {
+			t.Fatalf("anna's vote (%s) is from %s", source.Sender, voter)
+		}
+	}
+	// Even with nothing known of her LID, it is not us
+	if voter := poll_voter(types.MessageSource{Chat: pollGroup, IsGroup: true, Sender: annaLID}, usPN, voteLidMap(nil)); voter.String() == usPN.ToNonAD().String() {
+		t.Fatalf("anna's vote is ours")
+	}
+}
+
+// The polls kept go with the oldest votes, and a poll kept is not kept twice.
+func TestThePollsKeptAreForgottenWithTheirVotes(t *testing.T) {
+	tally := loadPollTally("")
+	tally.remember("FIRST", pollDef{Name: "Lunch?", Options: lunch, Max: 1})
+	tally.vote("FIRST", "anna", []string{"Pizza"}, lunch)
+	tally.remember("FIRST", pollDef{Name: "Lunch?", Options: lunch, Max: 1})
+	if len(tally.Order) != 1 {
+		t.Fatalf("order %v", tally.Order)
+	}
+	for i := 0; i < pollTallyMax; i++ {
+		tally.remember(fmt.Sprintf("P%d", i), pollDef{Name: "Lunch?", Options: lunch, Max: 1})
+	}
+	if _, kept := tally.poll("FIRST"); kept || tally.Polls["FIRST"] != nil || len(tally.Defs) != pollTallyMax || len(tally.Order) != pollTallyMax {
+		t.Fatalf("FIRST kept %v; %d defs, %d in order", kept, len(tally.Defs), len(tally.Order))
+	}
+}
+
+// Polls are kept from the event handler while votes are counted and polls looked up at once.
+func TestPollTallyKeepsPollsFromManyGoroutines(t *testing.T) {
+	tally := loadPollTally(filepath.Join(t.TempDir(), "polls.json"))
+	done := make(chan bool)
+	for i := 0; i < 8; i++ {
+		go func(i int) {
+			for j := 0; j < 20; j++ {
+				id := fmt.Sprintf("poll%d", j%5)
+				// (a poll edited: kept again, so it is written while others read it)
+				tally.remember(id, pollDef{Name: "Lunch?", Options: lunch, Max: (i + j) % 2})
+				tally.vote(id, fmt.Sprintf("voter%d", i), []string{lunch[j%3]}, lunch)
+				if def, known := tally.poll(id); !known || def.Name != "Lunch?" {
+					t.Errorf("%s: %+v %v", id, def, known)
+				}
+			}
+			done <- true
+		}(i)
+	}
+	for i := 0; i < 8; i++ {
+		<-done
+	}
+	if len(tally.Order) != 5 || len(tally.Defs) != 5 {
+		t.Fatalf("%d in order, %d polls", len(tally.Order), len(tally.Defs))
+	}
+}

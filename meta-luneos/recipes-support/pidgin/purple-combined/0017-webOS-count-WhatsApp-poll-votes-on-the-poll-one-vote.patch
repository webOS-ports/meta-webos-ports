+// pollDefOf is what a poll creation message asks.
+func pollDefOf(pcm *waE2E.PollCreationMessage) pollDef {
+	return pollDef{Name: pcm.GetName(), Options: pollOptionNames(pcm), Max: int(pcm.GetSelectableOptionsCount())}
+}
+
+// pollUntracked is said for a vote on a poll this plug-in never saw (it came before the device was
+// linked, or was let go of long ago).
+const pollUntracked = "voted in a poll, but this plug-in failed to keep track of the poll."
+
+// pollChoice is what a vote chose, by the options' names, and how many of its choices are no option
+// of the poll. A vote carries the SHA-256 of each chosen option's name (whatsmeow HashPollOptions,
+// msgsecret.go:369). The hash is worked out here from the name, not taken from the poll's own
+// OptionHash: that field is optional (WAWebProtobufsE2E.pb.go:24384) and holds whatever the poll's
+// sender put there, which for a poll made on the user's phone this plug-in has never seen filled in.
+func pollChoice(options []string, selected [][]byte) (chosen []string, unknown int) {
+	chosen = []string{}
+	for _, hash := range selected {
+		found := false
+		for _, option := range options {
+			sum := sha256.Sum256([]byte(option))
+			if bytes.Equal(sum[:], hash) {
+				chosen = append(chosen, option)
+				found = true
+				break
+			}
+		}
+		if !found {
+			unknown++
+		}
 	}
-	payload := pollPayload{Name: pcm.GetName(), Options: names, Max: int(pcm.GetSelectableOptionsCount())}
-	data, err := json.Marshal(payload)
-	if err != nil {
-		return "Poll: " + pcm.GetName()
+	return chosen, unknown
+}
+
+// pollVoteLine tells a vote as a line of its own, for when there is no tally to count it in.
+func pollVoteLine(name string, chosen []string, unknown int) string {
+	parts := make([]string, 0, len(chosen)+unknown)
+	for _, c := range chosen {
+		parts = append(parts, fmt.Sprintf("„%s“", c))
+	}
+	for i := 0; i < unknown; i++ {
+		parts = append(parts, "an unknown option")
+	}
+	text := fmt.Sprintf("voted in poll „%s“ for", name)
+	switch len(parts) {
+	case 0:
+		text += " nothing (removed vote)"
+	case 1:
+		text += " " + parts[0]
+	default:
+		text += " " + strings.Join(parts[:len(parts)-1], ", ") + " and " + parts[len(parts)-1]
+	}
+	return text + "."
+}
+
+// poll_voter is who cast a vote, as one identity however WhatsApp addressed them, so that one person
+// is one voter in the tally: the phone-number JID without device, the form the account's username,
+// lidToPn and the Messaging app's addresses use. A vote from one of our own devices is us by our own
+// JID (Store.ID, what send_app_poll_vote counts our vote from this device under), whether it came as
+// our phone number or our LID. Anyone else's LID is resolved through whatsmeow's LID map, and where
+// the map has no number for it yet, by the phone number the stanza carried beside it (SenderAlt,
+// whatsmeow message.go:106-109); only a LID neither knows stays a LID.
+func poll_voter(source types.MessageSource, own types.JID, lidToPn func(types.JID) types.JID) types.JID {
+	if source.IsFromMe && !own.IsEmpty() {
+		return own.ToNonAD()
+	}
+	voter := source.Sender
+	if lidToPn != nil {
+		voter = lidToPn(voter)
+	}
+	if voter.Server == types.HiddenUserServer && source.SenderAlt.Server == types.DefaultUserServer {
+		voter = source.SenderAlt
+	}
+	return voter.ToNonAD()
+}
+
+// own_jid is the JID this device is logged in as, or none before it is.
+func (handler *Handler) own_jid() types.JID {
+	if handler.client == nil || handler.client.Store == nil || handler.client.Store.ID == nil {
+		return types.EmptyJID
 	}
-	return "poll:" + base64.RawURLEncoding.EncodeToString(data)
+	return *handler.client.Store.ID
+}
+
+// poll_definition is what the poll with this id asks: from the message cache, or else from the polls
+// kept with the tally (poll_tally.go), which outlive the cache.
+func (handler *Handler) poll_definition(pollID string) (pollDef, bool) {
+	if cached := handler.lookup_cached_message_by_id(pollID); cached != nil {
+		if pcm := GetAnyPollCreationMessage(&cached.Message); pcm != nil {
+			return pollDefOf(pcm), true
+		}
+	}
+	if handler.pollTally != nil {
+		return handler.pollTally.poll(pollID)
+	}
+	return pollDef{}, false
+}
+
+// show_poll is the text for a poll, kept with the tally under the poll's message id for its votes:
+// any poll, ours (made on this device's phone, IsFromMe) as much as anyone's.
+func (handler *Handler) show_poll(pollID string, pcm *waE2E.PollCreationMessage) string {
+	for _, option := range pcm.GetOptions() {
+		if option.OptionHash == nil {
+			// taken from whatsmeow.HashPollOptions()
+			hash := fmt.Sprintf("%X", sha256.Sum256([]byte(option.GetOptionName())))
+			option.OptionHash = &hash
+		}
+	}
+	if handler.pollTally != nil {
+		handler.pollTally.remember(pollID, pollDefOf(pcm))
+	}
+	return formatPollMessage(pcm)
+}
+
+// webOS: what a voter's whole choice in a poll (the options' SHA-256 hashes) does. On a poll that is
+// known it is counted, and token is the poll's new text, with the counts, to rewrite the poll message
+// with in place ("webos-im-edit"). Only when there is nothing to count it on is it a line of its own.
+func (handler *Handler) poll_vote_outcome(pollID string, voter string, selected [][]byte) (token string, line string) {
+	poll, known := handler.poll_definition(pollID)
+	if !known || pollID == "" {
+		return "", pollUntracked
+	}
+	chosen, unknown := pollChoice(poll.Options, selected)
+	if handler.pollTally == nil {
+		return "", pollVoteLine(poll.Name, chosen, unknown)
+	}
+	counts := handler.pollTally.vote(pollID, voter, chosen, poll.Options)
+	return pollToken(poll.Name, poll.Options, poll.Max, counts), ""
 }
 

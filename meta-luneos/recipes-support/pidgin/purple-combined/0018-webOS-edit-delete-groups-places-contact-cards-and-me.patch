diff --git a/deferred_receipts.go b/deferred_receipts.go
index 838af1b..f1099ba 100644
--- a/deferred_receipts.go
+++ b/deferred_receipts.go
@@ -11,35 +11,47 @@ import (
  * on whatsmeow's event goroutine and a chat's receipts are taken on libpurple's main loop when the
  * chat is read (glue/receipt.c), so the store is locked. Taking a chat's receipts removes them: a
  * receipt goes once, not again each time the chat is looked at. The zero value is ready to use.
+ *
+ * A chat is found by its name as the conversation has it (the phone-number JID, handler.lidToPn),
+ * since that is what reading it gives. The receipt itself goes to the chat and the senders as the
+ * messages came: a chat WhatsApp addresses by LID takes its receipts at the LID.
  */
 type deferredReceiptStore struct {
 	mutex   sync.Mutex
-	pending map[types.JID]map[types.JID][]types.MessageID
+	pending map[types.JID]*deferredChat
 }
 
-// Keep the receipt for message id from sender in chat.
-func (store *deferredReceiptStore) add(chat types.JID, sender types.JID, id types.MessageID) {
+// One chat's receipts: where they go, and the message ids by sender.
+type deferredChat struct {
+	chat    types.JID
+	senders map[types.JID][]types.MessageID
+}
+
+// Keep the receipt for message id from sender in chat, found later by key.
+func (store *deferredReceiptStore) add(key types.JID, chat types.JID, sender types.JID, id types.MessageID) {
 	store.mutex.Lock()
 	defer store.mutex.Unlock()
 	if store.pending == nil {
-		store.pending = make(map[types.JID]map[types.JID][]types.MessageID)
+		store.pending = make(map[types.JID]*deferredChat)
 	}
-	senders, ok := store.pending[chat]
+	kept, ok := store.pending[key]
 	if !ok {
-		senders = make(map[types.JID][]types.MessageID)
-		store.pending[chat] = senders
+		kept = &deferredChat{senders: make(map[types.JID][]types.MessageID)}
+		store.pending[key] = kept
 	}
-	senders[sender] = append(senders[sender], id)
+	kept.chat = chat // the latest message's addressing: a chat moved to LID answers at the LID
+	kept.senders[sender] = append(kept.senders[sender], id)
 }
 
-// The receipts kept for chat, by sender, and forget them. nil when there are none.
-func (store *deferredReceiptStore) take(chat types.JID) map[types.JID][]types.MessageID {
+// The chat and the receipts kept under key, by sender, and forget them; nil senders when there
+// are none.
+func (store *deferredReceiptStore) take(key types.JID) (types.JID, map[types.JID][]types.MessageID) {
 	store.mutex.Lock()
 	defer store.mutex.Unlock()
-	senders, ok := store.pending[chat]
+	kept, ok := store.pending[key]
 	if !ok {
-		return nil
+		return types.EmptyJID, nil
 	}
-	delete(store.pending, chat)
-	return senders
+	delete(store.pending, key)
+	return kept.chat, kept.senders
 }

+// webOS: a NULL-terminated C array of strings, for the participants' phone numbers (one per
+// participant, "" for one whose number is not known), released with g_strfreev.
+func strings_to_ntcstrarray(strs []string) **C.char {
+	var carray **C.char = nil
+	carray = (**C.char)(C.calloc(C.size_t(len(strs)+1), C.size_t(unsafe.Sizeof(carray))))
+	view := unsafe.Slice((**C.char)(carray), len(strs))
+	for i, s := range strs {
+		view[i] = C.CString(s)
+	}
+	return carray
+}
+

diff --git a/history_notice.go b/history_notice.go
new file mode 100644
index 0000000..f16ef54
--- /dev/null
+++ b/history_notice.go
@@ -0,0 +1,108 @@
+package main
+
+import (
+	"fmt"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+)
+
+/*
+ * webOS: a group member may share the group's recent messages with people newly added to it. The
+ * group then gets a MessageHistoryNotice, which the WhatsApp app shows to everyone, and the new
+ * members a MessageHistoryBundle with the messages themselves (as media). Neither carries any text,
+ * so handle_message showed nothing for either.
+ *
+ * The notice is now a notice line in the group, as a group's own news is (group_events.go): "Ann
+ * shared 12 recent messages with Ben and Cara". The bundle is dropped: the messages in it are not
+ * read, and there is nothing to show for it.
+ */
+func (handler *Handler) handle_history_share(message *waE2E.Message, info types.MessageInfo) bool {
+	line, handled := history_share(message, info.MessageSource.Sender, info.MessageSource.IsFromMe, handler.group_people())
+	if !handled {
+		return false
+	}
+	if line == "" {
+		handler.log.Debugf("Ignoring MessageHistoryBundle %s.", info.ID)
+		return true
+	}
+	purple_display_system_message_at(handler.account, info.MessageSource.Chat.ToNonAD().String(), info.MessageSource.IsGroup, line, info.Timestamp)
+	return true
+}
+
+/*
+ * Whether message is a shared message history (handled), and the notice line to show for it: none
+ * for the bundle, which is dropped.
+ */
+func history_share(message *waE2E.Message, sender types.JID, fromMe bool, people groupPeople) (line string, handled bool) {
+	if notice := message.GetMessageHistoryNotice(); notice != nil {
+		return history_notice_text(notice.GetMessageHistoryMetadata(), sender, fromMe, people), true
+	}
+	if message.GetMessageHistoryBundle() != nil {
+		return "", true
+	}
+	return "", false
+}
+
+// More receivers than this are told as the first two and "N others".
+const historyNoticeMaxNames = 3
+
+/*
+ * "Ann shared 12 recent messages with Ben and Cara", "You shared 1 recent message with Ben",
+ * "Ann shared recent messages with you" (no count), "Ann shared 5 recent messages" (no receivers),
+ * "Ann shared 5 recent messages with Ben, Cara and 2 others" ("you, Ben and 3 others" when we are
+ * one of them). Names as group_event_notices gives
+ * them; a receiver that is no JID is left out. Without a sender: "Recent messages were shared
+ * with Ben".
+ */
+func history_notice_text(meta *waE2E.MessageHistoryMetadata, sender types.JID, fromMe bool, people groupPeople) string {
+	var receivers []types.JID
+	for _, receiver := range meta.GetHistoryReceivers() {
+		jid, err := types.ParseJID(receiver)
+		if err != nil || jid.User == "" {
+			continue
+		}
+		if len(people.without(receivers, jid, true)) < len(receivers) {
+			continue // the same person twice, perhaps by number and by LID
+		}
+		receivers = append(receivers, jid)
+	}
+
+	what, were := "recent messages", " were shared"
+	if count := meta.GetMessageCount(); count == 1 {
+		what, were = "1 recent message", " was shared"
+	} else if count > 1 {
+		what = fmt.Sprintf("%d recent messages", count)
+	}
+
+	with := ""
+	if len(receivers) > historyNoticeMaxNames {
+		// We are among those named, not among the others
+		for i, jid := range receivers {
+			if people.self(jid) {
+				receivers = append([]types.JID{jid}, append(receivers[:i:i], receivers[i+1:]...)...)
+				break
+			}
+		}
+		with = " with " + join_names([]string{people.name(receivers[0], "you"), people.name(receivers[1], "you"),
+			fmt.Sprintf("%d others", len(receivers)-2)})
+	} else if len(receivers) > 0 {
+		with = " with " + people.objects(receivers)
+	}
+
+	switch {
+	case fromMe:
+		return "You shared " + what + with
+	case sender.User == "":
+		return upper_first(what) + were + with
+	}
+	return people.subject(sender) + " shared " + what + with
+}
+
+// s with its first letter upper case ("recent messages" -> "Recent messages"); s is ASCII here.
+func upper_first(s string) string {
+	if s == "" || s[0] < 'a' || s[0] > 'z' {
+		return s
+	}
+	return string(s[0]-'a'+'A') + s[1:]
+}
diff --git a/history_notice_test.go b/history_notice_test.go
new file mode 100644
index 0000000..a8253c8
--- /dev/null
+++ b/history_notice_test.go
@@ -0,0 +1,112 @@
+package main
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+)
+
+var (
+	gDan = types.NewJID("31655555555", types.DefaultUserServer)
+	gEve = types.NewJID("31666666666", types.DefaultUserServer)
+)
+
+func historyMeta(count int64, receivers ...types.JID) *waE2E.MessageHistoryMetadata {
+	meta := &waE2E.MessageHistoryMetadata{}
+	if count >= 0 {
+		meta.MessageCount = &count
+	}
+	for _, r := range receivers {
+		meta.HistoryReceivers = append(meta.HistoryReceivers, r.String())
+	}
+	return meta
+}
+
+func historyNotice(t *testing.T, meta *waE2E.MessageHistoryMetadata, sender types.JID, fromMe bool, want string) {
+	t.Helper()
+	got, handled := history_share(&waE2E.Message{MessageHistoryNotice: &waE2E.MessageHistoryNotice{MessageHistoryMetadata: meta}},
+		sender, fromMe, testGroupPeople())
+	if !handled || got != want {
+		t.Errorf("got %q (handled %v), want %q", got, handled, want)
+	}
+}
+
+func TestHistoryNoticeSaysWhoSharedHowManyWithWhom(t *testing.T) {
+	historyNotice(t, historyMeta(12, gBen, gCara), gAnn, false, "Ann shared 12 recent messages with Ben and Cara")
+	historyNotice(t, historyMeta(1, gBen), gAnn, false, "Ann shared 1 recent message with Ben")
+	historyNotice(t, historyMeta(3, gBen, gCara, gDan), gAnn, false, "Ann shared 3 recent messages with Ben, Cara and +31655555555")
+	// The sender by LID, as the number it is known by
+	historyNotice(t, historyMeta(2, gBen), gAnnLid, false, "Ann shared 2 recent messages with Ben")
+}
+
+func TestHistoryNoticeWithoutReceivers(t *testing.T) {
+	historyNotice(t, historyMeta(5), gAnn, false, "Ann shared 5 recent messages")
+	historyNotice(t, &waE2E.MessageHistoryMetadata{HistoryReceivers: []string{}, MessageCount: new(int64(5))}, gAnn, false,
+		"Ann shared 5 recent messages")
+	// Receivers that are no JID are left out, not shown as they came
+	historyNotice(t, &waE2E.MessageHistoryMetadata{HistoryReceivers: []string{"", "@s.whatsapp.net"}, MessageCount: new(int64(5))}, gAnn, false,
+		"Ann shared 5 recent messages")
+}
+
+func TestHistoryNoticeWithoutCount(t *testing.T) {
+	historyNotice(t, historyMeta(-1, gBen), gAnn, false, "Ann shared recent messages with Ben")
+	historyNotice(t, historyMeta(0, gBen), gAnn, false, "Ann shared recent messages with Ben")
+	historyNotice(t, historyMeta(-1), gAnn, false, "Ann shared recent messages")
+	// No metadata at all
+	historyNotice(t, nil, gAnn, false, "Ann shared recent messages")
+}
+
+func TestHistoryNoticeManyReceivers(t *testing.T) {
+	historyNotice(t, historyMeta(9, gBen, gCara, gDan, gEve), gAnn, false, "Ann shared 9 recent messages with Ben, Cara and 2 others")
+	historyNotice(t, historyMeta(9, gBen, gCara, gDan, gEve, gAnn), gMe, true, "You shared 9 recent messages with Ben, Cara and 3 others")
+	// We are named, not one of the others
+	historyNotice(t, historyMeta(9, gBen, gCara, gDan, gMeLid), gAnn, false, "Ann shared 9 recent messages with you, Ben and 2 others")
+}
+
+func TestHistoryNoticeFromUs(t *testing.T) {
+	historyNotice(t, historyMeta(4, gBen), gMe, true, "You shared 4 recent messages with Ben")
+	// Our own other phone, by our LID, or by the store's map of it
+	historyNotice(t, historyMeta(4, gBen), gMeLid, false, "You shared 4 recent messages with Ben")
+	historyNotice(t, historyMeta(4, gBen), gMeLid2, false, "You shared 4 recent messages with Ben")
+	historyNotice(t, historyMeta(4, gBen), types.EmptyJID, true, "You shared 4 recent messages with Ben")
+}
+
+func TestHistoryNoticeToUs(t *testing.T) {
+	historyNotice(t, historyMeta(4, gMeLid), gAnn, false, "Ann shared 4 recent messages with you")
+	historyNotice(t, historyMeta(4, gBen, gMe), gAnn, false, "Ann shared 4 recent messages with Ben and you")
+}
+
+func TestHistoryNoticeNames(t *testing.T) {
+	// A LID with no number known is "Unknown user", never the LID
+	unknown := types.NewJID("900000000000099", types.HiddenUserServer)
+	historyNotice(t, historyMeta(2, unknown), gAnn, false, "Ann shared 2 recent messages with Unknown user")
+	historyNotice(t, historyMeta(2, gBen), unknown, false, "Unknown user shared 2 recent messages with Ben")
+	// Someone by LID and by number once
+	historyNotice(t, historyMeta(2, gAnnLid, gAnn, gBen), gCara, false, "Cara shared 2 recent messages with Ann and Ben")
+	// No sender known
+	historyNotice(t, historyMeta(2, gBen), types.EmptyJID, false, "2 recent messages were shared with Ben")
+	historyNotice(t, historyMeta(1, gBen), types.EmptyJID, false, "1 recent message was shared with Ben")
+	historyNotice(t, historyMeta(-1, gBen), types.EmptyJID, false, "Recent messages were shared with Ben")
+}
+
+func TestHistoryBundleIsDropped(t *testing.T) {
+	msg := &waE2E.Message{MessageHistoryBundle: &waE2E.MessageHistoryBundle{MessageHistoryMetadata: historyMeta(7, gBen)}}
+	if line, handled := history_share(msg, gAnn, false, testGroupPeople()); !handled || line != "" {
+		t.Errorf("bundle: %q, handled %v", line, handled)
+	}
+}
+
+func TestOtherMessagesAreNoHistoryShare(t *testing.T) {
+	for _, msg := range []*waE2E.Message{
+		{},
+		{Conversation: new("hello")},
+		{ExtendedTextMessage: &waE2E.ExtendedTextMessage{Text: new("hello")}},
+		{ImageMessage: &waE2E.ImageMessage{}},
+		{SenderKeyDistributionMessage: &waE2E.SenderKeyDistributionMessage{}},
+	} {
+		if line, handled := history_share(msg, gAnn, false, testGroupPeople()); handled || line != "" {
+			t.Errorf("%v: %q, handled %v", msg, line, handled)
+		}
+	}
+}

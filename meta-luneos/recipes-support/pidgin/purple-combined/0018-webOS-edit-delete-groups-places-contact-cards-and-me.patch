@@ -0,0 +1,70 @@
+package main
+
+import (
+	"html"
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+var mentioned = types.NewJID("31611111111", types.DefaultUserServer)
+
+func TestAMentionTakesTheBuddyAlias(t *testing.T) {
+	if got := pick_mention_name("Anna", mentioned, "Anna Kowalski"); got != "Anna" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestAMentionOfNoBuddyTakesTheStoresName(t *testing.T) {
+	for _, alias := range []string{"", mentioned.String(), "31611111111", "+31611111111"} {
+		if got := pick_mention_name(alias, mentioned, "", "  ", "Anna K", "mentioned"); got != "Anna K" {
+			t.Errorf("alias %q: got %q", alias, got)
+		}
+	}
+}
+
+func TestAMentionNobodyKnowsIsTheNumber(t *testing.T) {
+	if got := pick_mention_name(mentioned.String(), mentioned); got != "31611111111" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestOnlyTheMentionIsReplaced(t *testing.T) {
+	got := replace_mention("@31611111111 call 31611111111 or @316111111112", "31611111111", "Anna")
+	if got != "\x02@Anna\x03 call 31611111111 or @316111111112" {
+		t.Errorf("got %q", got)
+	}
+	if got := replace_mention("@31611111111, @31611111111.", "31611111111", "Anna"); got != "\x02@Anna\x03, \x02@Anna\x03." {
+		t.Errorf("twice: %q", got)
+	}
+	if got := replace_mention("@123 hi", "", "Anna"); got != "@123 hi" {
+		t.Errorf("no user: %q", got)
+	}
+	if got := replace_mention("@123 hi", "123", ""); got != "@123 hi" {
+		t.Errorf("no name: %q", got)
+	}
+}
+
+func TestAMentionIsShownBold(t *testing.T) {
+	text := replace_mention("hi @31611111111 <3 & bye", "31611111111", "A<n>a")
+	got := mention_marks_to_html(html.EscapeString(text))
+	if got != "hi <b>@A&lt;n&gt;a</b> &lt;3 &amp; bye" {
+		t.Errorf("got %q", got)
+	}
+}
+
+func TestASendersOwnMarksMakeNoTags(t *testing.T) {
+	text := strip_mention_marks("a\x02b\x03c")
+	if got := mention_marks_to_html(html.EscapeString(text)); got != "abc" {
+		t.Errorf("got %q", got)
+	}
+	if got := replace_mention("@1 x", "1", "A\x03\x02n"); got != "\x02@An\x03 x" {
+		t.Errorf("name: %q", got)
+	}
+}
+
+func TestAnEditKeepsThePlainMention(t *testing.T) {
+	if got := strip_mention_marks(replace_mention("@1 x", "1", "Anna")); got != "@Anna x" {
+		t.Errorf("got %q", got)
+	}
+}

diff --git a/webos_actions.go b/webos_actions.go
new file mode 100644
index 0000000..964b104
--- /dev/null
+++ b/webos_actions.go
@@ -0,0 +1,311 @@
+package main
+
+/*
+#include "constants.h"
+*/
+import "C"
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+)
+
+/*
+ * webOS: what the Messaging app does to a message or a group besides sending to it, as the
+ * transport's webos-im-send-edit, -send-delete, -group-create, -group-invite, -group-remove,
+ * -group-rename and -group-leave signals bring it (glue/login.c). Each export says whether this account is connected here, which
+ * is what the signal returns to the transport, and does the network call on a goroutine, as the
+ * sends do, so the libpurple main loop is not held up. What fails is said in the chat as a system
+ * line.
+ */
+
+func webos_handler(account *PurpleAccount) (*Handler, bool) {
+	handler, ok := handlers[account]
+	return handler, ok && handler != nil && handler.client != nil
+}
+
+//export gowhatsapp_go_send_edit
+func gowhatsapp_go_send_edit(account *PurpleAccount, chat *C.char, id *C.char, text *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	go handler.send_edit(C.GoString(chat), C.GoString(id), C.GoString(text))
+	return 1
+}
+
+//export gowhatsapp_go_send_delete
+func gowhatsapp_go_send_delete(account *PurpleAccount, chat *C.char, id *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	go handler.send_delete(C.GoString(chat), C.GoString(id))
+	return 1
+}
+
+//export gowhatsapp_go_group_create
+func gowhatsapp_go_group_create(account *PurpleAccount, name *C.char, members *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	go handler.group_create(C.GoString(name), C.GoString(members))
+	return 1
+}
+
+//export gowhatsapp_go_group_invite
+func gowhatsapp_go_group_invite(account *PurpleAccount, chat *C.char, members *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	go handler.group_invite(C.GoString(chat), C.GoString(members))
+	return 1
+}
+
+//export gowhatsapp_go_group_remove
+func gowhatsapp_go_group_remove(account *PurpleAccount, chat *C.char, members *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	go handler.group_remove(C.GoString(chat), C.GoString(members))
+	return 1
+}
+
+// A rename the group could not take is FALSE at once: the transport then says it failed.
+//
+//export gowhatsapp_go_group_rename
+func gowhatsapp_go_group_rename(account *PurpleAccount, chat *C.char, name *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	jid, newName, ok := group_rename_request(C.GoString(chat), C.GoString(name))
+	if !ok {
+		// not the name: what the user typed stays out of the log
+		handler.log.Warnf("group_rename: %s is no group, or the name is empty", C.GoString(chat))
+		return 0
+	}
+	go handler.group_rename(jid, newName)
+	return 1
+}
+
+//export gowhatsapp_go_group_leave
+func gowhatsapp_go_group_leave(account *PurpleAccount, chat *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	go handler.group_leave(C.GoString(chat))
+	return 1
+}
+
+// A chat as the transport names it, and whether it is a group.
+func (handler *Handler) webos_chat(chat string) (types.JID, bool, error) {
+	jid, err := parseJID(chat)
+	if err != nil {
+		return types.EmptyJID, false, err
+	}
+	return jid.ToNonAD(), jid.Server == types.GroupServer, nil
+}
+
+// Edit a message we sent. text is as send_im gets it (HTML), and goes out as the send does.
+func (handler *Handler) send_edit(chat string, id string, text string) {
+	jid, isGroup, err := handler.webos_chat(chat)
+	if err != nil || id == "" {
+		handler.log.Warnf("send_edit: %s / %s: %v", chat, id, err)
+		return
+	}
+	plain, images := decompose_html(text)
+	if len(images) > 0 || plain == "" {
+		purple_display_system_message(handler.account, jid.String(), isGroup, "Only the text of a message can be edited.")
+		return
+	}
+	edit := handler.client.BuildEdit(jid, types.MessageID(id), &waE2E.Message{Conversation: &plain})
+	if _, err := handler.client.SendMessage(context.Background(), jid, edit); err != nil {
+		purple_display_system_message(handler.account, jid.String(), isGroup, fmt.Sprintf("Could not edit the message: %v", err))
+	}
+}
+
+// Delete a message we sent, for everyone.
+func (handler *Handler) send_delete(chat string, id string) {
+	jid, isGroup, err := handler.webos_chat(chat)
+	if err != nil || id == "" {
+		handler.log.Warnf("send_delete: %s / %s: %v", chat, id, err)
+		return
+	}
+	// An empty sender is our own message.
+	revoke := handler.client.BuildRevoke(jid, types.EmptyJID, types.MessageID(id))
+	if _, err := handler.client.SendMessage(context.Background(), jid, revoke); err != nil {
+		purple_display_system_message(handler.account, jid.String(), isGroup, fmt.Sprintf("Could not delete the message: %v", err))
+	}
+}
+
+// Create a group. It shows up as a chat with a line saying so, which gives the app its thread.
+func (handler *Handler) group_create(name string, members string) {
+	participants := parse_webos_members(members)
+	if name == "" || len(participants) == 0 {
+		handler.log.Warnf("group_create: no name or no members")
+		return
+	}
+	info, err := handler.client.CreateGroup(context.Background(), whatsmeow.ReqCreateGroup{Name: name, Participants: participants})
+	if err != nil {
+		handler.log.Warnf("group_create %q failed: %v", name, err)
+		purple_display_system_message(handler.account, handler.client.Store.ID.ToNonAD().String(), false,
+			fmt.Sprintf("Could not create the group %q: %v", name, err))
+		return
+	}
+	purple_update_group(handler, info)
+	purple_display_system_message(handler.account, info.JID.ToNonAD().String(), true, fmt.Sprintf("You created the group %q.", name))
+}
+
+// Add members to a group; who could not be added is said in it.
+func (handler *Handler) group_invite(chat string, members string) {
+	jid, isGroup, err := handler.webos_chat(chat)
+	participants := parse_webos_members(members)
+	if err != nil || !isGroup || len(participants) == 0 {
+		handler.log.Warnf("group_invite: %s is no group, or no members: %v", chat, err)
+		return
+	}
+	result, err := handler.client.UpdateGroupParticipants(context.Background(), jid, participants, whatsmeow.ParticipantChangeAdd)
+	if err != nil {
+		purple_display_system_message(handler.account, jid.String(), true, group_change_failed("add to", err))
+		return
+	}
+	for _, p := range result {
+		if p.Error != 0 {
+			purple_display_system_message(handler.account, jid.String(), true,
+				group_add_failed(p.JID.User, p.Error, p.AddRequest != nil))
+		}
+	}
+}
+
+// Remove members from a group: a JID ("<digits>@s.whatsapp.net", "<id>@lid") or a +E.164 number
+// each, as the group's member list gives them. Who could not be removed is said in it; when anyone
+// was, the chat's member list is read again, so Group Info no longer shows them.
+func (handler *Handler) group_remove(chat string, members string) {
+	jid, isGroup, err := handler.webos_chat(chat)
+	participants := parse_webos_members(members)
+	if err != nil || !isGroup || len(participants) == 0 {
+		handler.log.Warnf("group_remove: %s is no group, or no members: %v", chat, err)
+		return
+	}
+	result, err := handler.client.UpdateGroupParticipants(context.Background(), jid, participants, whatsmeow.ParticipantChangeRemove)
+	if err != nil {
+		purple_display_system_message(handler.account, jid.String(), true, group_change_failed("remove from", err))
+		return
+	}
+	removed := false
+	for _, p := range result {
+		if p.Error != 0 {
+			purple_display_system_message(handler.account, jid.String(), true, group_remove_failed(p.JID.User, p.Error))
+		} else {
+			removed = true
+		}
+	}
+	if removed {
+		if info, err := handler.client.GetGroupInfo(context.Background(), jid); err == nil && info != nil {
+			purple_update_group(handler, info)
+		} else {
+			handler.log.Warnf("group_remove: could not read %s again: %v", jid, err)
+		}
+	}
+}
+
+// The group and the name a rename asks for: the chat must be a group JID, the name not empty once
+// trimmed. The app sends it trimmed and with its spaces collapsed; it is trimmed here again, and
+// otherwise sent as it came. It is not cut to a length: see group_rename_failed.
+func group_rename_request(chat string, name string) (types.JID, string, bool) {
+	name = strings.TrimSpace(name)
+	if chat == "" || name == "" {
+		return types.EmptyJID, "", false
+	}
+	jid, err := parseJID(chat)
+	if err != nil || jid.Server != types.GroupServer {
+		return types.EmptyJID, "", false
+	}
+	return jid.ToNonAD(), name, true
+}
+
+// Rename a group. Once WhatsApp took it, the chat's name here is the new one at once (the app's
+// thread takes it with the next line in the chat), and WhatsApp's own news of the change brings the
+// line "You changed the group name to ..." (group_events.go). What failed is said in the group.
+func (handler *Handler) group_rename(jid types.JID, name string) {
+	if err := handler.client.SetGroupName(context.Background(), jid, name); err != nil {
+		handler.log.Warnf("group_rename: %s refused the new name: %v", jid, err)
+		purple_display_system_message(handler.account, jid.String(), true, group_rename_failed(err))
+		return
+	}
+	purple_rename_group(handler, jid, name)
+}
+
+/*
+ * What to say when the group did not take a new name. 401/403: we are not in the group or not one
+ * of its admins (who may edit its info, when the group allows only admins). 406 ("not
+ * acceptable", whatsmeow.ErrIQNotAcceptable, taken by its code whatever its text) is what WhatsApp
+ * answers a name it will not take; whatsmeow documents it for a name that is too long
+ * (ReqCreateGroup: "Group names are limited to 25 characters"). That limit is not enforced here:
+ * WhatsApp's own limit is what counts, and a name cut here would be one nobody typed.
+ */
+func group_rename_failed(err error) string {
+	var iqErr *whatsmeow.IQError
+	if errors.As(err, &iqErr) && iqErr.Code == 406 {
+		return "Could not rename the group: WhatsApp did not accept the name. It may be too long."
+	}
+	return group_change_failed("rename", err)
+}
+
+// What to say when the group refused the whole change ("add to", "remove from"). 401 and 403 are
+// WhatsApp's "not authorized" and "forbidden" (whatsmeow.ErrIQNotAuthorized, ErrIQForbidden): we
+// are no longer in the group - we left it, even one we made - or not one of its admins.
+func group_change_failed(change string, err error) string {
+	if errors.Is(err, whatsmeow.ErrIQForbidden) || errors.Is(err, whatsmeow.ErrIQNotAuthorized) {
+		return fmt.Sprintf("Could not %s the group: you are no longer in it, or not one of its admins.", change)
+	}
+	return fmt.Sprintf("Could not %s the group: %v", change, err)
+}
+
+// What to say for one person the group did not remove. WhatsApp gives a code per person, which
+// whatsmeow passes on as it comes. No meanings of these codes for a removal are known here, so the
+// code is shown as is.
+func group_remove_failed(who string, code int) string {
+	return fmt.Sprintf("Could not remove %s from the group (error %d).", who, code)
+}
+
+// What to say for one person the group did not take. WhatsApp gives a code per person, which
+// whatsmeow passes on as it comes; the meanings are those other WhatsApp clients document (Baileys:
+// 409 a conflict, already in the group; 403 their privacy settings, with an invite to send them
+// when WhatsApp made one - add_request, whatsmeow's AddRequest). Any other code is shown as is.
+func group_add_failed(who string, code int, invite bool) string {
+	switch {
+	case code == 409:
+		return fmt.Sprintf("%s is already in the group.", who)
+	case code == 403 && invite:
+		return fmt.Sprintf("%s can only be added by an invite, because of their privacy settings.", who)
+	case code == 403:
+		return fmt.Sprintf("%s cannot be added to the group: their privacy settings do not allow it.", who)
+	}
+	return fmt.Sprintf("Could not add %s to the group (error %d).", who, code)
+}
+
+// Leave a group.
+func (handler *Handler) group_leave(chat string) {
+	jid, isGroup, err := handler.webos_chat(chat)
+	if err != nil || !isGroup {
+		handler.log.Warnf("group_leave: %s is no group: %v", chat, err)
+		return
+	}
+	if err := handler.client.LeaveGroup(context.Background(), jid); err != nil {
+		purple_display_system_message(handler.account, jid.String(), true, fmt.Sprintf("Could not leave the group: %v", err))
+		return
+	}
+	purple_display_system_message(handler.account, jid.String(), true, "You left the group.")
+}
diff --git a/webos_send.go b/webos_send.go
new file mode 100644
index 0000000..a7c5a05
--- /dev/null
+++ b/webos_send.go
@@ -0,0 +1,191 @@
+package main
+
+import (
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+/*
+ * webOS: what an outgoing message carries besides its text, as the transport (imlibpurpleservice)
+ * puts it on the conversation for the length of the send (its SendExtras.h). Each is a string the
+ * C glue copies in send_im/send_chat; "" when the message has none.
+ *
+ *   location  "<lat>\x1f<lon>\x1f<name>"
+ *   contact   a vCard
+ *   mentions  "<id>\x1f<name>" records joined by "\x1e"; the text has "@<name>" for each
+ *
+ * The text is always a plain form of the same thing, so whatever cannot be sent natively is sent
+ * as the text.
+ */
+type webosExtras struct {
+	location string
+	contact  string
+	mentions string
+}
+
+type webosLocation struct {
+	latitude  float64
+	longitude float64
+	name      string
+}
+
+// The location of an extras string, or false when there is none or it is not one.
+func parse_webos_location(s string) (webosLocation, bool) {
+	parts := strings.Split(s, "\x1f")
+	if len(parts) != 3 {
+		return webosLocation{}, false
+	}
+	lat, err1 := strconv.ParseFloat(parts[0], 64)
+	lon, err2 := strconv.ParseFloat(parts[1], 64)
+	if err1 != nil || err2 != nil || lat < -90 || lat > 90 || lon < -180 || lon > 180 {
+		return webosLocation{}, false
+	}
+	return webosLocation{latitude: lat, longitude: lon, name: parts[2]}, true
+}
+
+// The name a vCard shows (its FN, else its N as "given family"), or "" when it has neither.
+func vcard_display_name(vcard string) string {
+	var n string
+	for _, line := range strings.Split(strings.ReplaceAll(vcard, "\r\n", "\n"), "\n") {
+		colon := strings.IndexByte(line, ':')
+		if colon < 0 {
+			continue
+		}
+		// "FN;CHARSET=UTF-8:Anna" names FN; parameters come after the first ';'.
+		property := strings.ToUpper(line[:colon])
+		if semi := strings.IndexByte(property, ';'); semi >= 0 {
+			property = property[:semi]
+		}
+		value := strings.TrimSpace(line[colon+1:])
+		switch property {
+		case "FN":
+			if value != "" {
+				return value
+			}
+		case "N":
+			// N:family;given;additional;prefix;suffix
+			fields := strings.Split(value, ";")
+			var given, family string
+			if len(fields) > 1 {
+				given = fields[1]
+			}
+			family = fields[0]
+			n = strings.TrimSpace(given + " " + family)
+		}
+	}
+	return n
+}
+
+type webosMention struct {
+	jid  types.JID
+	name string
+}
+
+/*
+ * A mention's or member's id as a JID. The app names a WhatsApp contact as the threads do: a JID
+ * ("<digits>@s.whatsapp.net", "<id>@lid") or the +E.164 number a group message's sender is written
+ * with ("+31611111111"). Anything else is not a WhatsApp user.
+ */
+func webos_jid(id string) (types.JID, bool) {
+	if !strings.ContainsRune(id, '@') {
+		digits := strings.TrimPrefix(id, "+")
+		if digits == "" || strings.TrimLeft(digits, "0123456789") != "" {
+			return types.EmptyJID, false
+		}
+	}
+	jid, err := parseJID(id)
+	if err != nil || jid.User == "" {
+		return types.EmptyJID, false
+	}
+	return jid.ToNonAD(), true
+}
+
+// The mentions of an extras string whose ids are WhatsApp users, longest name first (so
+// "@Annabel" is matched before "@Anna").
+func parse_webos_mentions(s string) []webosMention {
+	var out []webosMention
+	if s == "" {
+		return out
+	}
+	for _, record := range strings.Split(s, "\x1e") {
+		fields := strings.Split(record, "\x1f")
+		if len(fields) != 2 || fields[0] == "" || fields[1] == "" {
+			continue
+		}
+		jid, ok := webos_jid(fields[0])
+		if !ok {
+			continue
+		}
+		out = append(out, webosMention{jid: jid, name: fields[1]})
+	}
+	sort.SliceStable(out, func(i, j int) bool { return len(out[i].name) > len(out[j].name) })
+	return out
+}
+
+// Whether the text at i (after a mention) does not go on with the name: its end, or a rune that is
+// not a letter or digit.
+func mention_ends_at(text string, i int) bool {
+	if i >= len(text) {
+		return true
+	}
+	r, _ := utf8.DecodeRuneInString(text[i:])
+	return !unicode.IsLetter(r) && !unicode.IsDigit(r)
+}
+
+/*
+ * WhatsApp marks a mention as "@<the user part of the JID>" in the text, with the JID in
+ * ContextInfo.MentionedJID; its clients show the contact's name there. The app writes "@<name>".
+ * Rewrite each "@<name>" of the mentions to "@<user>", and return the JIDs mentioned, each once,
+ * in the order they first appear.
+ */
+func apply_webos_mentions(text string, mentions []webosMention) (string, []string) {
+	if len(mentions) == 0 {
+		return text, nil
+	}
+	var b strings.Builder
+	var jids []string
+	seen := map[string]bool{}
+	for i := 0; i < len(text); {
+		if text[i] == '@' {
+			matched := false
+			for _, m := range mentions {
+				end := i + 1 + len(m.name)
+				if strings.HasPrefix(text[i+1:], m.name) && mention_ends_at(text, end) {
+					b.WriteString("@" + m.jid.User)
+					if j := m.jid.String(); !seen[j] {
+						seen[j] = true
+						jids = append(jids, j)
+					}
+					i = end
+					matched = true
+					break
+				}
+			}
+			if matched {
+				continue
+			}
+		}
+		b.WriteByte(text[i])
+		i++
+	}
+	return b.String(), jids
+}
+
+// "\x1f"-joined members as JIDs, leaving out what is not a WhatsApp user.
+func parse_webos_members(joined string) []types.JID {
+	var out []types.JID
+	for _, member := range strings.Split(joined, "\x1f") {
+		if member == "" {
+			continue
+		}
+		if jid, ok := webos_jid(member); ok {
+			out = append(out, jid)
+		}
+	}
+	return out
+}
diff --git a/webos_send_test.go b/webos_send_test.go
new file mode 100644
index 0000000..e1bf533
--- /dev/null
+++ b/webos_send_test.go
@@ -0,0 +1,216 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"testing"
+
+	"go.mau.fi/whatsmeow"
+)
+
+func TestLocationIsLatitudeLongitudeAndName(t *testing.T) {
+	loc, ok := parse_webos_location("52.3731000\x1f4.8925000\x1fDam")
+	if !ok || loc.latitude != 52.3731 || loc.longitude != 4.8925 || loc.name != "Dam" {
+		t.Fatalf("got %+v %v", loc, ok)
+	}
+	if loc, ok := parse_webos_location("-33.8\x1f151.2\x1f"); !ok || loc.name != "" {
+		t.Fatalf("no name: %+v %v", loc, ok)
+	}
+}
+
+func TestNoLocationFromWhatIsNotOne(t *testing.T) {
+	for _, s := range []string{"", "52\x1f4", "a\x1f4\x1fx", "52\x1f4\x1fx\x1fy", "91\x1f0\x1fx", "0\x1f-181\x1fx"} {
+		if _, ok := parse_webos_location(s); ok {
+			t.Errorf("%q taken for a location", s)
+		}
+	}
+}
+
+func TestTheNameOfAVCard(t *testing.T) {
+	cases := map[string]string{
+		"BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Anna Kowalski\r\nTEL:+31611111111\r\nEND:VCARD\r\n": "Anna Kowalski",
+		"BEGIN:VCARD\nfn;CHARSET=UTF-8: Zoë \nEND:VCARD":                                      "Zoë",
+		"BEGIN:VCARD\nN:Kowalski;Anna;;;\nEND:VCARD":                                          "Anna Kowalski",
+		"BEGIN:VCARD\nN:Kowalski;Anna\nFN:\nEND:VCARD":                                        "Anna Kowalski",
+		"BEGIN:VCARD\nTEL:+316\nEND:VCARD":                                                    "",
+	}
+	for card, want := range cases {
+		if got := vcard_display_name(card); got != want {
+			t.Errorf("%q: %q, want %q", card, got, want)
+		}
+	}
+}
+
+func TestMentionsBecomeNumbersAndJIDs(t *testing.T) {
+	mentions := parse_webos_mentions("31611111111@s.whatsapp.net\x1fAnna\x1e31622222222@s.whatsapp.net\x1fAnnabel")
+	text, jids := apply_webos_mentions("@Anna and @Annabel, @Anna!", mentions)
+	if text != "@31611111111 and @31622222222, @31611111111!" {
+		t.Fatalf("text %q", text)
+	}
+	want := []string{"31611111111@s.whatsapp.net", "31622222222@s.whatsapp.net"}
+	if !reflect.DeepEqual(jids, want) {
+		t.Fatalf("jids %v, want %v (each once, in order)", jids, want)
+	}
+}
+
+func TestTheLongerNameWins(t *testing.T) {
+	// "Anna" followed by a space is a whole name too: the longer one that goes on must be tried first.
+	mentions := parse_webos_mentions("31611111111@s.whatsapp.net\x1fAnna\x1e31622222222@s.whatsapp.net\x1fAnna Kowalski")
+	text, jids := apply_webos_mentions("@Anna Kowalski, @Anna", mentions)
+	if text != "@31622222222, @31611111111" || len(jids) != 2 || jids[0] != "31622222222@s.whatsapp.net" {
+		t.Fatalf("text %q jids %v", text, jids)
+	}
+}
+
+func TestAMentionIsAWholeName(t *testing.T) {
+	mentions := parse_webos_mentions("31611111111@s.whatsapp.net\x1fAnna")
+	text, jids := apply_webos_mentions("mail anna@x.nl, @Annabel @Anna2 @Anna", mentions)
+	if text != "mail anna@x.nl, @Annabel @Anna2 @31611111111" || len(jids) != 1 {
+		t.Fatalf("text %q jids %v", text, jids)
+	}
+}
+
+func TestNoMentionsNoChange(t *testing.T) {
+	if text, jids := apply_webos_mentions("@Anna hi", nil); text != "@Anna hi" || jids != nil {
+		t.Fatalf("%q %v", text, jids)
+	}
+	if got := parse_webos_mentions("not a jid\x1f\x1e\x1fAnna\x1e31611111111@s.whatsapp.net\x1f"); len(got) != 0 {
+		t.Fatalf("broken records taken: %v", got)
+	}
+	// A mentioned name in multi-byte text.
+	mentions := parse_webos_mentions("31611111111@s.whatsapp.net\x1fZoë")
+	if text, _ := apply_webos_mentions("hé @Zoë ✓", mentions); text != "hé @31611111111 ✓" {
+		t.Fatalf("%q", text)
+	}
+}
+
+func TestANumberIsAUser(t *testing.T) {
+	// A group message's sender is written as +E.164; that is who the app mentions.
+	mentions := parse_webos_mentions("+31611111111\x1fMum\x1e31622222222@lid\x1fBen\x1eMum\x1fMum\x1e+31 6\x1fX")
+	if len(mentions) != 2 || mentions[0].jid.String() != "31611111111@s.whatsapp.net" || mentions[1].jid.String() != "31622222222@lid" {
+		t.Fatalf("got %v", mentions)
+	}
+	if got := parse_webos_members("+31611111111\x1fnobody"); len(got) != 1 || got[0].String() != "31611111111@s.whatsapp.net" {
+		t.Fatalf("members %v", got)
+	}
+}
+
+func TestMembersAreJIDs(t *testing.T) {
+	got := parse_webos_members("31611111111@s.whatsapp.net\x1f\x1f31622222222:3@s.whatsapp.net")
+	if len(got) != 2 || got[0].String() != "31611111111@s.whatsapp.net" || got[1].String() != "31622222222@s.whatsapp.net" {
+		t.Fatalf("got %v (device part dropped)", got)
+	}
+}
+
+func TestAGroupSaysWhyItDidNotTakeSomeone(t *testing.T) {
+	cases := []struct {
+		code   int
+		invite bool
+		want   string
+	}{
+		{409, false, "31611111111 is already in the group."},
+		{403, true, "31611111111 can only be added by an invite, because of their privacy settings."},
+		{403, false, "31611111111 cannot be added to the group: their privacy settings do not allow it."},
+		{408, false, "Could not add 31611111111 to the group (error 408)."},
+	}
+	for _, c := range cases {
+		if got := group_add_failed("31611111111", c.code, c.invite); got != c.want {
+			t.Errorf("code %d invite %v: %q, want %q", c.code, c.invite, got, c.want)
+		}
+	}
+}
+
+func TestAGroupWeAreNotInSaysSo(t *testing.T) {
+	left := "Could not add to the group: you are no longer in it, or not one of its admins."
+	if got := group_change_failed("add to", whatsmeow.ErrIQForbidden); got != left {
+		t.Errorf("forbidden: %q", got)
+	}
+	if got := group_change_failed("add to", fmt.Errorf("wrapped: %w", whatsmeow.ErrIQNotAuthorized)); got != left {
+		t.Errorf("not authorized: %q", got)
+	}
+	if got := group_change_failed("add to", errors.New("timed out")); got != "Could not add to the group: timed out" {
+		t.Errorf("other: %q", got)
+	}
+}
+
+func TestARemovalTheGroupRefusedSaysSo(t *testing.T) {
+	notAdmin := "Could not remove from the group: you are no longer in it, or not one of its admins."
+	if got := group_change_failed("remove from", whatsmeow.ErrIQForbidden); got != notAdmin {
+		t.Errorf("forbidden: %q", got)
+	}
+	if got := group_change_failed("remove from", fmt.Errorf("wrapped: %w", whatsmeow.ErrIQNotAuthorized)); got != notAdmin {
+		t.Errorf("not authorized: %q", got)
+	}
+	if got := group_change_failed("remove from", errors.New("timed out")); got != "Could not remove from the group: timed out" {
+		t.Errorf("other: %q", got)
+	}
+	if got := group_remove_failed("31611111111", 404); got != "Could not remove 31611111111 from the group (error 404)." {
+		t.Errorf("one person: %q", got)
+	}
+}
+
+func TestMembersToRemoveAreAnyFormTheMemberListGives(t *testing.T) {
+	// Group Info lists a member by what the plug-in put on the chat: a phone JID, a LID, or the
+	// +E.164 number (bare digits too, once the transport has made a JID of it or not).
+	got := parse_webos_members("+31611111111\x1f31622222222@s.whatsapp.net\x1f123456789012345@lid\x1f31633333333")
+	want := []string{"31611111111@s.whatsapp.net", "31622222222@s.whatsapp.net", "123456789012345@lid", "31633333333@s.whatsapp.net"}
+	if len(got) != len(want) {
+		t.Fatalf("got %v", got)
+	}
+	for i := range want {
+		if got[i].String() != want[i] {
+			t.Errorf("%d: %s, want %s", i, got[i], want[i])
+		}
+	}
+}
+
+func TestARenameIsAGroupAndAName(t *testing.T) {
+	jid, name, ok := group_rename_request("120363000000000001@g.us", "Physics")
+	if !ok || jid.String() != "120363000000000001@g.us" || name != "Physics" {
+		t.Fatalf("got %v %q %v", jid, name, ok)
+	}
+	// trimmed, and otherwise as it came: inner spaces, long names and all
+	long := "A name much longer than twenty-five characters, ünïcödé 🙂"
+	if _, name, ok := group_rename_request("120363000000000001@g.us", " \t"+long+"\n "); !ok || name != long {
+		t.Errorf("trimmed: %q %v", name, ok)
+	}
+}
+
+func TestARenameOfNoGroupOrToNoNameIsRefused(t *testing.T) {
+	for _, c := range []struct{ chat, name string }{
+		{"120363000000000001@g.us", ""},
+		{"120363000000000001@g.us", " \t\n "},
+		{"", "Physics"},
+		{"31611111111@s.whatsapp.net", "Physics"},
+		{"+31611111111", "Physics"},
+		{"900000000000011@lid", "Physics"},
+		{"120363000000000001@newsletter", "Physics"},
+		{"@g.us", "Physics"},
+	} {
+		if _, _, ok := group_rename_request(c.chat, c.name); ok {
+			t.Errorf("%q / %q taken", c.chat, c.name)
+		}
+	}
+}
+
+func TestARenameTheGroupRefusedSaysWhy(t *testing.T) {
+	notAdmin := "Could not rename the group: you are no longer in it, or not one of its admins."
+	if got := group_rename_failed(whatsmeow.ErrIQForbidden); got != notAdmin {
+		t.Errorf("forbidden: %q", got)
+	}
+	if got := group_rename_failed(fmt.Errorf("wrapped: %w", whatsmeow.ErrIQNotAuthorized)); got != notAdmin {
+		t.Errorf("not authorized: %q", got)
+	}
+	tooLong := "Could not rename the group: WhatsApp did not accept the name. It may be too long."
+	if got := group_rename_failed(whatsmeow.ErrIQNotAcceptable); got != tooLong {
+		t.Errorf("not acceptable: %q", got)
+	}
+	// 406 by its code, whatever text WhatsApp gives with it
+	if got := group_rename_failed(fmt.Errorf("x: %w", &whatsmeow.IQError{Code: 406, Text: "subject-too-long"})); got != tooLong {
+		t.Errorf("406 other text: %q", got)
+	}
+	if got := group_rename_failed(errors.New("timed out")); got != "Could not rename the group: timed out" {
+		t.Errorf("other: %q", got)
+	}
+}

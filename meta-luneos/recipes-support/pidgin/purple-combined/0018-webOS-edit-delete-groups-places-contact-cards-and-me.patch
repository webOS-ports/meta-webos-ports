+
+/*
+ * webOS: a WhatsApp group's own news, as notice lines in its chat, the way the WhatsApp app tells
+ * it: "You removed Ann", "Ann added Ben", "Ben left", "Ann changed the group name to “X”", "Ann
+ * made Ben an admin", "Ben joined using this group's invite link". Nothing was said before, so a
+ * member removed from another phone, or from here, only left the member list.
+ *
+ * They are system lines (purple_display_system_message_at), as tdlib-purple writes a Telegram
+ * group's news, so the transport keeps them in the thread without a banner. Each has the time of
+ * the change: one made while we were offline comes on connecting and is an old message like any
+ * other (the glue drops it when "discard old messages" is on).
+ */
+func (handler *Handler) handle_group_info(evt *events.GroupInfo) {
+	chat := evt.JID.ToNonAD().String()
+	if evt.Name != nil {
+		// the chat has its new name before the line saying so (purple_rename_group), so the line,
+		// and the app's thread with it, comes under the new name
+		purple_rename_group(handler, evt.JID, evt.Name.Name)
+	}
+	for _, line := range group_event_notices(evt, handler.group_people()) {
+		purple_display_system_message_at(handler.account, chat, true, line, evt.Timestamp)
+	}
+	if group_members_changed(evt) && !handler.left_group(evt) {
+		handler.refresh_group_soon(evt.JID.ToNonAD())
+	}
+}
+
+// How group_event_notices names people: whether someone is us, their name, and the phone-number
+// JID a LID is known by (the JID itself otherwise). Functions, so the text is tested without a
+// connection.
+type groupPeople struct {
+	isSelf func(types.JID) bool
+	nameOf func(types.JID) string
+	pnOf   func(types.JID) types.JID
+}
+
+func (handler *Handler) group_people() groupPeople {
+	return groupPeople{
+		isSelf: handler.is_self,
+		nameOf: handler.member_name,
+		pnOf: func(jid types.JID) types.JID {
+			return handler.lidToPn(jid, "naming a group member")
+		},
+	}
+}
+
+// Whether jid is our own account, by its phone number or by its LID.
+func (handler *Handler) is_self(jid types.JID) bool {
+	if handler == nil || handler.client == nil || handler.client.Store == nil || jid.User == "" {
+		return false
+	}
+	store := handler.client.Store
+	if store.ID != nil && jid.ToNonAD() == store.ID.ToNonAD() {
+		return true
+	}
+	lid := store.GetLID()
+	return !lid.IsEmpty() && jid.ToNonAD() == lid.ToNonAD()
+}
+
+// The name a group notice gives a member: as a mention names them (the buddy alias, else the names
+// WhatsApp's contact store has), else their number. A LID says nothing of the number, so it is
+// looked up; who has none known is "Unknown user", never the LID.
+func (handler *Handler) member_name(jid types.JID) string {
+	pn := handler.lidToPn(jid, "naming a group member").ToNonAD()
+	alias := purple_get_alias(handler.account, pn.String())
+	var names []string
+	if handler.client.Store.Contacts != nil {
+		for _, who := range []types.JID{pn, jid.ToNonAD()} {
+			if info, err := handler.client.Store.Contacts.GetContact(context.TODO(), who); err == nil {
+				names = append(names, info.FullName, info.FirstName, info.BusinessName, info.PushName)
+			}
+		}
+	}
+	return pick_member_name(alias, pn, names...)
+}
+
+// pick_mention_name, with "+<digits>" for the number, and "Unknown user" for a LID with no number.
+func pick_member_name(alias string, pn types.JID, names ...string) string {
+	if name := pick_mention_name(alias, pn, names...); name != pn.User {
+		return name
+	}
+	if phone := phone_of(pn); phone != "" {
+		return phone
+	}
+	return "Unknown user"
+}
+
+// Whether the change touches who is in the group or what they may do (or its name), so the chat's
+// member list (Group Info) is read again.
+func group_members_changed(evt *events.GroupInfo) bool {
+	return len(evt.Join) > 0 || len(evt.Leave) > 0 || len(evt.Promote) > 0 || len(evt.Demote) > 0 || evt.Name != nil
+}
+
+// Whether we are among those who left or were removed: the group then no longer answers us.
+func (handler *Handler) left_group(evt *events.GroupInfo) bool {
+	for _, jid := range evt.Leave {
+		if handler.is_self(jid) || handler.is_self(handler.lidToPn(jid, "leaving a group")) {
+			return true
+		}
+	}
+	return false
+}
+
+// Changes come in bursts - several on connecting, after a time offline - so the member list is
+// read once a little after the last of them, not once for each.
+const groupRefreshDelay = 2 * time.Second
+
+func (handler *Handler) refresh_group_soon(jid types.JID) {
+	if _, pending := handler.groupRefreshes.LoadOrStore(jid, true); pending {
+		return
+	}
+	go func() {
+		time.Sleep(groupRefreshDelay)
+		handler.groupRefreshes.Delete(jid)
+		info, err := handler.client.GetGroupInfo(context.Background(), jid)
+		if err != nil || info == nil {
+			handler.log.Warnf("Could not read group %s again after a change: %v", jid, err)
+			return
+		}
+		purple_update_group(handler, info)
+	}()
+}
+
+/*
+ * The notices for one change, in the order the WhatsApp app shows them. Empty for a change no
+ * notice is made for (locking the group info, disappearing messages, ...).
+ */
+func group_event_notices(evt *events.GroupInfo, people groupPeople) []string {
+	var lines []string
+	sender, hasSender := first_jid(evt.SenderPN, evt.Sender)
+
+	if evt.Name != nil {
+		who, known := sender, hasSender
+		if !known {
+			who, known = first_jid(&evt.Name.NameSetByPN, &evt.Name.NameSetBy)
+		}
+		if known {
+			lines = append(lines, fmt.Sprintf("%s changed the group name to “%s”", people.subject(who), evt.Name.Name))
+		} else {
+			lines = append(lines, fmt.Sprintf("The group name was changed to “%s”", evt.Name.Name))
+		}
+	}
+
+	if evt.Topic != nil {
+		who, known := sender, hasSender
+		if !known {
+			who, known = first_jid(&evt.Topic.TopicSetByPN, &evt.Topic.TopicSetBy)
+		}
+		verb := "changed"
+		if evt.Topic.TopicDeleted {
+			verb = "deleted"
+		}
+		if known {
+			lines = append(lines, fmt.Sprintf("%s %s the group description", people.subject(who), verb))
+		} else {
+			lines = append(lines, fmt.Sprintf("The group description was %s", verb))
+		}
+	}
+
+	if len(evt.Join) > 0 {
+		added := people.without(evt.Join, sender, hasSender)
+		switch {
+		case evt.JoinReason == "invite":
+			lines = append(lines, people.list(evt.Join)+" joined using this group's invite link")
+		case !hasSender || len(added) == 0:
+			lines = append(lines, people.list(evt.Join)+" joined")
+		default:
+			lines = append(lines, fmt.Sprintf("%s added %s", people.subject(sender), people.objects(added)))
+		}
+	}
+
+	if len(evt.Leave) > 0 {
+		removed := people.without(evt.Leave, sender, hasSender)
+		if !hasSender {
+			lines = append(lines, people.list(evt.Leave)+" left")
+		} else {
+			if len(removed) < len(evt.Leave) {
+				lines = append(lines, people.subject(sender)+" left")
+			}
+			if len(removed) > 0 {
+				lines = append(lines, fmt.Sprintf("%s removed %s", people.subject(sender), people.objects(removed)))
+			}
+		}
+	}
+
+	if len(evt.Promote) > 0 {
+		if hasSender {
+			lines = append(lines, fmt.Sprintf("%s made %s %s", people.subject(sender), people.objects(evt.Promote), admins(len(evt.Promote))))
+		} else {
+			lines = append(lines, fmt.Sprintf("%s %s now %s", people.list(evt.Promote), people.be(evt.Promote), admins(len(evt.Promote))))
+		}
+	}
+
+	if len(evt.Demote) > 0 {
+		lines = append(lines, fmt.Sprintf("%s %s no longer %s", people.list(evt.Demote), people.be(evt.Demote), admins(len(evt.Demote))))
+	}
+	return lines
+}
+
+// The first of the JIDs that is set.
+func first_jid(jids ...*types.JID) (types.JID, bool) {
+	for _, jid := range jids {
+		if jid != nil && !jid.IsEmpty() {
+			return *jid, true
+		}
+	}
+	return types.EmptyJID, false
+}
+
+func admins(n int) string {
+	if n == 1 {
+		return "an admin"
+	}
+	return "admins"
+}
+
+func (people groupPeople) self(jid types.JID) bool {
+	return people.isSelf(jid) || people.isSelf(people.pnOf(jid))
+}
+
+// Whether a and b are the same person, one perhaps by LID and the other by number. We are known
+// by both, even before the store maps our LID.
+func (people groupPeople) same(a, b types.JID) bool {
+	return a.ToNonAD() == b.ToNonAD() || people.pnOf(a).ToNonAD() == people.pnOf(b).ToNonAD() ||
+		(people.self(a) && people.self(b))
+}
+
+// jids without who (when there is a who).
+func (people groupPeople) without(jids []types.JID, who types.JID, hasWho bool) []types.JID {
+	var rest []types.JID
+	for _, jid := range jids {
+		if !hasWho || !people.same(jid, who) {
+			rest = append(rest, jid)
+		}
+	}
+	return rest
+}
+
+// A name, or "You"/"you".
+func (people groupPeople) name(jid types.JID, you string) string {
+	if people.self(jid) {
+		return you
+	}
+	return people.nameOf(jid)
+}
+
+// Who did something, at the start of a line.
+func (people groupPeople) subject(jid types.JID) string {
+	return people.name(jid, "You")
+}
+
+// Who something was done to: "Ben", "Ben and you", "Ben, Cara and Dan".
+func (people groupPeople) objects(jids []types.JID) string {
+	names := make([]string, len(jids))
+	for i, jid := range jids {
+		names[i] = people.name(jid, "you")
+	}
+	return join_names(names)
+}
+
+// Several who did something, at the start of a line.
+func (people groupPeople) list(jids []types.JID) string {
+	names := make([]string, len(jids))
+	for i, jid := range jids {
+		you := "you"
+		if i == 0 {
+			you = "You"
+		}
+		names[i] = people.name(jid, you)
+	}
+	return join_names(names)
+}
+
+// "is", or "are" for more than one, and for "You" alone.
+func (people groupPeople) be(jids []types.JID) string {
+	if len(jids) == 1 && !people.self(jids[0]) {
+		return "is"
+	}
+	return "are"
+}
+
+func join_names(names []string) string {
+	switch len(names) {
+	case 0:
+		return ""
+	case 1:
+		return names[0]
+	}
+	return strings.Join(names[:len(names)-1], ", ") + " and " + names[len(names)-1]
+}
diff --git a/group_events_test.go b/group_events_test.go
new file mode 100644
index 0000000..daf3f45
--- /dev/null
+++ b/group_events_test.go
@@ -0,0 +1,163 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+var (
+	gAnn    = types.NewJID("31611111111", types.DefaultUserServer)
+	gBen    = types.NewJID("31622222222", types.DefaultUserServer)
+	gCara   = types.NewJID("31633333333", types.DefaultUserServer)
+	gMe     = types.NewJID("31600000000", types.DefaultUserServer)
+	gMeLid  = types.NewJID("900000000000001", types.HiddenUserServer)
+	gAnnLid = types.NewJID("900000000000011", types.HiddenUserServer)
+	gMeLid2 = types.NewJID("900000000000002", types.HiddenUserServer) // ours by the store's LID map only
+	gGroup  = types.NewJID("120363000000000001", types.GroupServer)
+)
+
+// Ann, Ben and Cara by name, us by number or LID, Ann's LID known as her number.
+func testGroupPeople() groupPeople {
+	names := map[types.JID]string{gAnn: "Ann", gBen: "Ben", gCara: "Cara"}
+	pnOf := func(j types.JID) types.JID {
+		switch j {
+		case gAnnLid:
+			return gAnn
+		case gMeLid2:
+			return gMe
+		}
+		return j
+	}
+	return groupPeople{
+		isSelf: func(j types.JID) bool { return j == gMe || j == gMeLid },
+		// as member_name: by the number a LID is known by
+		nameOf: func(j types.JID) string {
+			pn := pnOf(j)
+			if n, ok := names[pn]; ok {
+				return n
+			}
+			return pick_member_name(pn.String(), pn)
+		},
+		pnOf: pnOf,
+	}
+}
+
+func jidp(j types.JID) *types.JID { return &j }
+
+func notices(t *testing.T, evt events.GroupInfo, want ...string) {
+	t.Helper()
+	evt.JID = gGroup
+	evt.Timestamp = time.Unix(1700000000, 0)
+	got := group_event_notices(&evt, testGroupPeople())
+	if len(want) == 0 {
+		want = nil
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
+
+func TestGroupRemovedByUs(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gMeLid), Leave: []types.JID{gAnn}}, "You removed Ann")
+	notices(t, events.GroupInfo{Sender: jidp(gMe), Leave: []types.JID{gAnn, gBen, gCara}}, "You removed Ann, Ben and Cara")
+}
+
+func TestGroupRemovedUs(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Leave: []types.JID{gMeLid}}, "Ann removed you")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Leave: []types.JID{gMeLid2}}, "Ann removed you")
+}
+
+func TestGroupSomeoneLeft(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gBen), Leave: []types.JID{gBen}}, "Ben left")
+	notices(t, events.GroupInfo{Leave: []types.JID{gBen, gCara}}, "Ben and Cara left")
+	notices(t, events.GroupInfo{Sender: jidp(gMe), Leave: []types.JID{gMeLid}}, "You left")
+	// The sender by LID, the leaver by number: the same person
+	notices(t, events.GroupInfo{Sender: jidp(gAnnLid), Leave: []types.JID{gAnn}}, "Ann left")
+}
+
+func TestGroupAdded(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Join: []types.JID{gBen}}, "Ann added Ben")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Join: []types.JID{gBen, gMe}}, "Ann added Ben and you")
+	// The sender's number goes before their LID
+	notices(t, events.GroupInfo{Sender: jidp(gMeLid), SenderPN: jidp(gAnn), Join: []types.JID{gBen}}, "Ann added Ben")
+	// Who adds themselves has joined
+	notices(t, events.GroupInfo{Sender: jidp(gAnnLid), Join: []types.JID{gAnn}}, "Ann joined")
+	notices(t, events.GroupInfo{Join: []types.JID{gBen}}, "Ben joined")
+}
+
+func TestGroupJoinedByInviteLink(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gBen), JoinReason: "invite", Join: []types.JID{gBen}},
+		"Ben joined using this group's invite link")
+	notices(t, events.GroupInfo{JoinReason: "invite", Join: []types.JID{gMe}},
+		"You joined using this group's invite link")
+}
+
+func TestGroupNameAndDescription(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Name: &types.GroupName{Name: "Physics"}},
+		"Ann changed the group name to “Physics”")
+	notices(t, events.GroupInfo{Name: &types.GroupName{Name: "Physics", NameSetBy: gMeLid}},
+		"You changed the group name to “Physics”")
+	notices(t, events.GroupInfo{Name: &types.GroupName{Name: "Physics"}}, "The group name was changed to “Physics”")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Topic: &types.GroupTopic{Topic: "Homework"}},
+		"Ann changed the group description")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Topic: &types.GroupTopic{TopicDeleted: true}},
+		"Ann deleted the group description")
+	notices(t, events.GroupInfo{Topic: &types.GroupTopic{TopicSetBy: gBen}}, "Ben changed the group description")
+}
+
+func TestGroupAdmins(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Promote: []types.JID{gBen}}, "Ann made Ben an admin")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Promote: []types.JID{gBen, gMe}}, "Ann made Ben and you admins")
+	notices(t, events.GroupInfo{Promote: []types.JID{gBen}}, "Ben is now an admin")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Demote: []types.JID{gBen}}, "Ben is no longer an admin")
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Demote: []types.JID{gMeLid}}, "You are no longer an admin")
+	notices(t, events.GroupInfo{Demote: []types.JID{gBen, gCara}}, "Ben and Cara are no longer admins")
+}
+
+func TestGroupSeveralChangesAtOnce(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Name: &types.GroupName{Name: "X"}, Join: []types.JID{gBen}, Leave: []types.JID{gCara}},
+		"Ann changed the group name to “X”", "Ann added Ben", "Ann removed Cara")
+}
+
+func TestGroupChangesWithoutNotice(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Locked: &types.GroupLocked{IsLocked: true}})
+}
+
+func TestGroupMemberNames(t *testing.T) {
+	// Nobody known: the number with its "+", never the LID
+	notices(t, events.GroupInfo{Sender: jidp(gAnn), Leave: []types.JID{types.NewJID("31644444444", types.DefaultUserServer)}},
+		"Ann removed +31644444444")
+	notices(t, events.GroupInfo{Leave: []types.JID{types.NewJID("900000000000099", types.HiddenUserServer)}}, "Unknown user left")
+	if got := pick_member_name("Anna", gAnn, "Anna K"); got != "Anna" {
+		t.Errorf("alias: %q", got)
+	}
+	if got := pick_member_name(gAnn.String(), gAnn, "", "Anna K"); got != "Anna K" {
+		t.Errorf("store: %q", got)
+	}
+}
+
+func TestGroupMembersChangedReadsTheGroupAgain(t *testing.T) {
+	for _, evt := range []events.GroupInfo{{Join: []types.JID{gBen}}, {Leave: []types.JID{gBen}},
+		{Promote: []types.JID{gBen}}, {Demote: []types.JID{gBen}}, {Name: &types.GroupName{Name: "X"}}} {
+		if !group_members_changed(&evt) {
+			t.Errorf("%+v: not read again", evt)
+		}
+	}
+	if group_members_changed(&events.GroupInfo{Topic: &types.GroupTopic{}}) {
+		t.Errorf("a description is no member change")
+	}
+}
+
+// Our own rename, from here or another phone, as WhatsApp tells it back
+func TestGroupOurOwnRenameComesBack(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: jidp(gMeLid), SenderPN: jidp(gMe), Name: &types.GroupName{Name: "Physics", NameSetBy: gMeLid}},
+		"You changed the group name to “Physics”")
+	notices(t, events.GroupInfo{Sender: jidp(gMeLid2), Name: &types.GroupName{Name: "Physics"}}, "You changed the group name to “Physics”")
+	if !group_members_changed(&events.GroupInfo{Name: &types.GroupName{Name: "Physics"}}) {
+		t.Errorf("a new name does not read the group again")
+	}
+}
diff --git a/group_phone_test.go b/group_phone_test.go
new file mode 100644
index 0000000..ea500e3
--- /dev/null
+++ b/group_phone_test.go
@@ -0,0 +1,94 @@
+package main
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+func lidMap(known map[string]string, asked *[]types.JID) func(types.JID) types.JID {
+	return func(lid types.JID) types.JID {
+		if asked != nil {
+			*asked = append(*asked, lid)
+		}
+		if pn, ok := known[lid.User]; ok {
+			return types.NewJID(pn, types.DefaultUserServer)
+		}
+		return types.EmptyJID
+	}
+}
+
+func TestAMemberByNumberIsThatNumber(t *testing.T) {
+	p := types.GroupParticipant{JID: types.NewJID("31611111111", types.DefaultUserServer)}
+	if got := participant_phone(p, nil); got != "+31611111111" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestALidMemberTakesTheNumberWhatsAppSent(t *testing.T) {
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	p := types.GroupParticipant{JID: lid, LID: lid, PhoneNumber: types.NewJID("46701234567", types.DefaultUserServer)}
+	var asked []types.JID
+	if got := participant_phone(p, lidMap(map[string]string{"123456789012345": "491701234567"}, &asked)); got != "+46701234567" {
+		t.Fatalf("got %q", got)
+	}
+	if len(asked) != 0 {
+		t.Errorf("the store was asked although the number came with the member: %v", asked)
+	}
+}
+
+func TestALidMemberTakesTheNumberTheStoreKnows(t *testing.T) {
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	var asked []types.JID
+	got := participant_phone(types.GroupParticipant{JID: lid, LID: lid}, lidMap(map[string]string{"123456789012345": "31622222222"}, &asked))
+	if got != "+31622222222" {
+		t.Fatalf("got %q", got)
+	}
+	if len(asked) != 1 || asked[0] != lid {
+		t.Errorf("asked %v, want the LID once", asked)
+	}
+	// Only the JID filled in (no LID field), as an older reply has it.
+	if got := participant_phone(types.GroupParticipant{JID: lid}, lidMap(map[string]string{"123456789012345": "31622222222"}, nil)); got != "+31622222222" {
+		t.Fatalf("by the JID: got %q", got)
+	}
+}
+
+func TestNoNumberForALidNobodyKnows(t *testing.T) {
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	p := types.GroupParticipant{JID: lid, LID: lid}
+	var asked []types.JID
+	if got := participant_phone(p, lidMap(nil, &asked)); got != "" {
+		t.Fatalf("got %q", got)
+	}
+	if len(asked) != 1 {
+		t.Errorf("asked %d times, want once", len(asked))
+	}
+	if got := participant_phone(p, nil); got != "" {
+		t.Fatalf("without a store: got %q", got)
+	}
+}
+
+func TestALidIsNeverTakenForANumber(t *testing.T) {
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	other := func(types.JID) types.JID { return types.NewJID("999", types.HiddenUserServer) }
+	if got := participant_phone(types.GroupParticipant{JID: lid, LID: lid}, other); got != "" {
+		t.Fatalf("got %q", got)
+	}
+	bad := types.GroupParticipant{JID: types.NewJID("31a6", types.DefaultUserServer)}
+	if got := participant_phone(bad, nil); got != "" {
+		t.Fatalf("not digits: got %q", got)
+	}
+}
+
+func TestPhonesAreInTheMembersOrder(t *testing.T) {
+	lid := types.NewJID("123456789012345", types.HiddenUserServer)
+	ps := []types.GroupParticipant{
+		{JID: lid, LID: lid},
+		{JID: types.NewJID("31611111111", types.DefaultUserServer)},
+	}
+	var handler *Handler // no client: no store to ask
+	got := handler.participant_phones(ps)
+	if len(got) != 2 || got[0] != "" || got[1] != "+31611111111" {
+		t.Fatalf("got %q", got)
+	}
+}

+
+// webOS: the name a mention of jid is shown with. The text says "@<number>" (or "@<LID>"), and the
+// buddy list only has an alias for a buddy, which most of a group's members are not: purple's
+// alias for anyone else is the JID itself, so a mention showed as a number (W4). Then the names
+// WhatsApp's contact store has for them, as the bridge's display name takes them; the number last.
+func (handler *Handler) mention_name(jid types.JID) string {
+	pn := handler.lidToPn(jid, "resolving mention").ToNonAD()
+	alias := purple_get_alias(handler.account, pn.String())
+	var names []string
+	for _, who := range []types.JID{pn, jid.ToNonAD()} {
+		if info, err := handler.client.Store.Contacts.GetContact(context.TODO(), who); err == nil {
+			names = append(names, info.FullName, info.FirstName, info.BusinessName, info.PushName)
+		}
+	}
+	return pick_mention_name(alias, pn, names...)
+}
+
+// The buddy alias when there is one (not the JID or number purple falls back to), else the first
+// name the store has, else the number.
+func pick_mention_name(alias string, pn types.JID, names ...string) string {
+	if alias != "" && alias != pn.String() && alias != pn.User && alias != "+"+pn.User {
+		return alias
+	}
+	for _, n := range names {
+		if n = strings.TrimSpace(n); n != "" {
+			return n
+		}
+	}
+	return pn.User
+}
+
+// text with each "@<user>" mention as "@<name>", between mentionOpen and mentionClose; the same
+// digits elsewhere in the text stay, and so does a longer number that starts with them.
+func replace_mention(text string, user string, name string) string {
+	if user == "" || name == "" {
+		return text
+	}
+	at := "@" + user
+	var out strings.Builder
+	for {
+		i := strings.Index(text, at)
+		if i < 0 {
+			out.WriteString(text)
+			return out.String()
+		}
+		end := i + len(at)
+		out.WriteString(text[:i])
+		if end < len(text) && text[end] >= '0' && text[end] <= '9' {
+			out.WriteString(at)
+		} else {
+			out.WriteString(mentionOpen + "@" + strip_mention_marks(name) + mentionClose)
+		}
+		text = text[end:]
+	}
+}
+
+// webOS: a mention is shown bold, as Signal and Telegram show theirs. The text is plain until it is
+// HTML-escaped just before it is shown, so a mention is marked with two control characters that
+// escaping leaves alone, and the marks become <b> and </b> after it (mention_marks_to_html).
+const (
+	mentionOpen  = "\x02"
+	mentionClose = "\x03"
+)
+
+// text without the marks, so that a sender's own control characters make no tags, and so that a
+// text not shown as HTML (an edit) keeps its plain "@<name>"
+func strip_mention_marks(text string) string {
+	return strings.NewReplacer(mentionOpen, "", mentionClose, "").Replace(text)
+}
+
+// an escaped text with each marked mention bold
+func mention_marks_to_html(escaped string) string {
+	return strings.NewReplacer(mentionOpen, "<b>", mentionClose, "</b>").Replace(escaped)
+}

 	}
 	return []types.GroupParticipant{}
 }
+
+/*
+ * webOS: the phone number of a group member, "+<digits>", or "" when it is not known; the
+ * Messaging app's Group Info shows it under the name. A group WhatsApp addresses by LID gives its
+ * members as LIDs ("<id>@lid"), which say nothing of the number: it is the member's phone-number
+ * JID when that is what they are given as, else the number WhatsApp sent with the member, else
+ * the one pnForLid (the store's LID map) knows for their LID.
+ */
+func participant_phone(participant types.GroupParticipant, pnForLid func(types.JID) types.JID) string {
+	for _, jid := range []types.JID{participant.JID, participant.PhoneNumber} {
+		if phone := phone_of(jid); phone != "" {
+			return phone
+		}
+	}
+	if pnForLid == nil {
+		return ""
+	}
+	for i, lid := range []types.JID{participant.LID, participant.JID} {
+		if i == 1 && lid == participant.LID {
+			break // looked up already
+		}
+		if lid.Server == types.HiddenUserServer && lid.User != "" {
+			if phone := phone_of(pnForLid(lid.ToNonAD())); phone != "" {
+				return phone
+			}
+		}
+	}
+	return ""
+}
+
+// "+<digits>" for a phone-number JID, else "".
+func phone_of(jid types.JID) string {
+	if jid.Server != types.DefaultUserServer || jid.User == "" {
+		return ""
+	}
+	for _, c := range jid.User {
+		if c < '0' || c > '9' {
+			return ""
+		}
+	}
+	return "+" + jid.User
+}
+
+// webOS: the phone numbers of participants, in their order ("" for one whose is not known).
+func (handler *Handler) participant_phones(participants []types.GroupParticipant) []string {
+	var pnForLid func(types.JID) types.JID
+	if handler != nil && handler.client != nil && handler.client.Store != nil && handler.client.Store.LIDs != nil {
+		lids := handler.client.Store.LIDs
+		pnForLid = func(lid types.JID) types.JID {
+			pn, err := lids.GetPNForLID(context.TODO(), lid)
+			if err != nil {
+				handler.log.Warnf("Error while looking up LID \"%s\" for a group member's number: %v", lid.String(), err)
+				return types.EmptyJID
+			}
+			return pn
+		}
+	}
+	phones := make([]string, len(participants))
+	for i, participant := range participants {
+		phones[i] = participant_phone(participant, pnForLid)
+	}
+	return phones
+}

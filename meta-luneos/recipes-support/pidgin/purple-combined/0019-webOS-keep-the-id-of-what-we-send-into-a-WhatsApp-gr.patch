From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sun, 8 Nov 2026 17:42:31 +0100
Subject: [PATCH] webOS: keep the id of what we send into a WhatsApp group from
 the phone

A message we send into a group from another of our devices, the phone,
comes back to us as ours (SEND|REMOTE_SEND), and the transport stores it
as an Outbox row. It stores it with the message's WhatsApp id only when
the id is stashed on the conversation ("webos-msg-id", beside the quote
"webos-quoted-*"), and for a group the glue stashed it only for a
message received: so every message we sent into a group from the phone
had no id, and nothing could find it again. A poll made on the phone
was never rewritten with its votes (the poll message is found by its
id), and a reaction, an edit or a delete for such a message was lost.

The id and the quote are now stashed for a group message received or
sent from another device, as for a 1:1 chat already. Never for our
plain local echo (SEND without REMOTE_SEND): the transport ignores it
without reading the stash, which would then stay on the conversation
and go with the next message.

glue/tests has display_message_test (gtest), against fakes of the
libpurple calls display_message.c makes: another member's message in a
group is received from them, with its id; ours from the phone carries
its id and quote; our local echo leaves nothing behind; the 1:1 chat is
as before.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS specific]
---
 glue/display_message.c              |  11 +-
 glue/tests/Makefile                 |  18 ++-
 glue/tests/display_message_test.cpp | 213 ++++++++++++++++++++++++++++
 3 files changed, 237 insertions(+), 5 deletions(-)
 create mode 100644 glue/tests/display_message_test.cpp

diff --git a/glue/display_message.c b/glue/display_message.c
index 80c24a8..b6d6403 100644
--- a/glue/display_message.c
+++ b/glue/display_message.c
@@ -75,13 +75,18 @@ void gowhatsapp_display_text_message(
     // webOS reactions: stash this message's WhatsApp id on the conversation right before serv_got_*
     // (which synchronously drives the transport's incoming_message_cb). The transport reads it as
     // "webos-msg-id" and stores it as serviceMessageId so a later reaction can target this message.
-    // Only for RECV messages - the transport ignores our own echoes.
+    // For a message received, and for one we sent from another of our devices (REMOTE_SEND), which
+    // the transport stores as an Outbox row, reading the same stash for a group as for a 1:1 chat:
+    // without it nothing could find our own message in a group again - not a vote on our poll, nor
+    // a reaction, an edit or a delete. Never for a plain local echo (SEND without REMOTE_SEND): the
+    // transport ignores those without reading the stash, which would then stick to the next message.
     if (isGroup) {
         PurpleConversation *gconv = gowhatsapp_enter_group_chat(connection, remoteJid, NULL, NULL);
-        if (gconv != NULL && (flags & PURPLE_MESSAGE_RECV) && messageId != NULL && *messageId != '\0') {
+        const gboolean stash = gconv != NULL && (flags & (PURPLE_MESSAGE_RECV | PURPLE_MESSAGE_REMOTE_SEND)) != 0;
+        if (stash && messageId != NULL && *messageId != '\0') {
             purple_conversation_set_data(gconv, "webos-msg-id", g_strdup(messageId));
         }
-        if (gconv != NULL && (flags & PURPLE_MESSAGE_RECV)) {
+        if (stash) {
             gowhatsapp_stash_webos_quote(gconv, quotedText, quotedFrom, quotedId);
         }
         purple_serv_got_chat_in(connection, g_str_hash(remoteJid), senderJid, flags, text_with_id, timestamp);
diff --git a/glue/tests/Makefile b/glue/tests/Makefile
index 8c47e95..dc5d4f4 100644
--- a/glue/tests/Makefile
+++ b/glue/tests/Makefile
@@ -1,3 +1,8 @@
+# display_message_test: glue/display_message.c's message direction and the id it hands the
+# transport, against fakes of what it calls of libpurple (in the test). Needs the libpurple
+# headers besides (PURPLE_CPPFLAGS, e.g. -I$SYSROOT/usr/include/libpurple), and the header cgo
+# generates for the Go half, libwhatsmeow.h (GOHDR: the directory it was built into).
+#
 # Unit tests for the call audio playout (glue/playout.c), glue/call.c's playback thread, which
 # runs against fakes.c's ALSA device instead of a real one, call.c's luneos-rtc-engine session
 # (fakes.c records its LS2 calls), and the engine's socket bridge (glue/voipkit_rtcengine.c,
@@ -17,7 +22,7 @@ SAN ?=
 INC := -I$(GLUE) -I. -Ifakes
 LIBS := -lgtest -lgtest_main -lglib-2.0 -lpthread -lm
 
-all: playout_test call_playback_test call_video_test voipkit_rtcengine_test
+all: playout_test call_playback_test call_video_test voipkit_rtcengine_test display_message_test
 
 playout_test: playout_test.cpp $(GLUE)/playout.c $(GLUE)/playout.h
 	$(CC) $(CPPFLAGS) $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/playout.c -o playout.o
@@ -43,13 +48,22 @@ voipkit_rtcengine_test: voipkit_rtcengine_test.cpp $(GLUE)/voipkit_rtcengine.c $
 	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(SAN) $(INC) voipkit_rtcengine_test.cpp voipkit_rtcengine.o \
 		-o $@ $(LDFLAGS) $(LIBS)
 
+PURPLE_CPPFLAGS ?= -I/usr/include/libpurple
+GOHDR ?= .
+display_message_test: display_message_test.cpp $(GLUE)/display_message.c $(GLUE)/../constants.c
+	$(CC) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -I$(GOHDR) -DPURPLE_PLUGINS -D_DEFAULT_SOURCE $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/display_message.c -o display_message.o
+	$(CC) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -DPURPLE_PLUGINS $(CFLAGS) $(SAN) $(INC) -c $(GLUE)/../constants.c -o constants.o
+	$(CXX) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -I$(GOHDR) -DPURPLE_PLUGINS -D_DEFAULT_SOURCE $(CXXFLAGS) $(SAN) $(INC) display_message_test.cpp display_message.o constants.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
 check: all
 	./playout_test
 	./call_playback_test
 	./call_video_test
 	./voipkit_rtcengine_test
+	./display_message_test
 
 clean:
-	rm -f *.o playout_test call_playback_test call_video_test voipkit_rtcengine_test

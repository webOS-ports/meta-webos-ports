diff --git a/glue/tests/display_message_test.cpp b/glue/tests/display_message_test.cpp
new file mode 100644
index 0000000..7d24bd0
--- /dev/null
+++ b/glue/tests/display_message_test.cpp
@@ -0,0 +1,213 @@
+// Tests glue/display_message.c: which way a WhatsApp message goes (received, or sent by us from
+// another device, or our own local echo), and that its id - and the message it quotes - is handed
+// to the transport ("webos-msg-id", "webos-quoted-*" on the conversation) for every message the
+// transport stores: received ones, and ours from another device, in a group as in a 1:1 chat. A
+// plain local echo is ignored by the transport, so nothing may be left on the conversation for it.
+// libpurple is replaced below by what display_message.c calls of it; serv_got_chat_in decides the
+// direction as libpurple 2.14's does (server.c: SEND, and not RECV, when the sender is the chat's
+// nick, which glue/groups.c sets to the account's username), and then reads and clears the stash as
+// the transport's incoming_message_cb does.
+#include <gtest/gtest.h>
+#include <map>
+#include <string>
+#include <vector>
+
+extern "C" {
+#define template template_ // a parameter's name in gowhatsapp.h, a keyword in C++
+#include "gowhatsapp.h"
+#undef template
+#include "constants.h"
+}
+
+namespace {
+
+const char *const kUs = "31600000001@s.whatsapp.net";
+const char *const kAnna = "31600000002@s.whatsapp.net";
+const char *const kGroup = "120363000000000001@g.us";
+
+PurpleAccount account;
+PurpleConnection *const connection = reinterpret_cast<PurpleConnection *>(&account);
+
+struct Conv {
+	PurpleConversation conv;
+	std::map<std::string, char *> data;
+};
+std::map<std::string, Conv *> convs; // by "chat:"/"im:" and name
+
+// What reached the transport, with what was stashed on the conversation at that moment.
+struct Written {
+	bool chat;
+	std::string who;
+	PurpleMessageFlags flags; // as the transport sees them
+	std::string id, quotedId, quotedText, quotedFrom;
+};
+std::vector<Written> written;
+
+Conv *conv_of(PurpleConversation *conv) {
+	for (auto &c : convs)
+		if (&c.second->conv == conv)
+			return c.second;
+	return nullptr;
+}
+
+std::string take(Conv *c, const char *key) {
+	auto it = c->data.find(key);
+	if (it == c->data.end() || it->second == nullptr)
+		return "";
+	std::string value = it->second;
+	g_free(it->second);
+	c->data.erase(it);
+	return value;
+}
+
+// The transport (incoming_message_cb): a local echo (SEND without REMOTE_SEND) is ignored and its
+// stash left alone; anything else is stored with the stash, which is then cleared.
+void transport(Conv *c, bool chat, const char *who, PurpleMessageFlags flags) {
+	Written w{chat, who ? who : "", flags, "", "", "", ""};
+	if ((flags & PURPLE_MESSAGE_RECV) || (flags & PURPLE_MESSAGE_REMOTE_SEND)) {
+		w.id = take(c, "webos-msg-id");
+		w.quotedId = take(c, "webos-quoted-id");
+		w.quotedText = take(c, "webos-quoted-text");
+		w.quotedFrom = take(c, "webos-quoted-from");
+	}
+	written.push_back(w);
+}
+
+Conv *find_or_new(bool chat, const char *name) {
+	std::string key = std::string(chat ? "chat:" : "im:") + name;
+	auto it = convs.find(key);
+	if (it != convs.end())
+		return it->second;
+	Conv *c = new Conv();
+	convs[key] = c;
+	return c;
+}
+
+void reset() {
+	for (auto &c : convs) {
+		for (auto &d : c.second->data)
+			g_free(d.second);
+		delete c.second;
+	}
+	convs.clear();
+	written.clear();
+}
+
+std::string stashed(bool chat, const char *name, const char *key) {
+	Conv *c = find_or_new(chat, name);
+	auto it = c->data.find(key);
+	return it == c->data.end() || it->second == nullptr ? "" : it->second;
+}
+
+// gowhatsapp_display_text_message as glue/process_message.c calls it for a text message.
+void show(const char *sender, const char *chat, bool isGroup, bool isOutgoing, const char *id,
+          const char *quotedText = nullptr, const char *quotedFrom = nullptr, const char *quotedId = nullptr) {
+	gowhatsapp_display_text_message(&account, sender, chat, "text", 1700000000, isGroup, isOutgoing, "Name",
+	                                (PurpleMessageFlags)0, id, quotedText, quotedFrom, quotedId);
+}
+
+} // namespace
+
+extern "C" {
+// libpurple, as display_message.c uses it
+PurpleConnection *purple_account_get_connection(const PurpleAccount *) { return connection; }
+const char *purple_account_get_username(const PurpleAccount *) { return kUs; }
+gboolean purple_account_get_bool(const PurpleAccount *, const char *, gboolean default_value) { return default_value; }
+gboolean purple_strequal(const gchar *left, const gchar *right) { return g_strcmp0(left, right) == 0; }
+void purple_conversation_set_data(PurpleConversation *conv, const char *key, gpointer data) {
+	Conv *c = conv_of(conv);
+	auto it = c->data.find(key);
+	if (it != c->data.end())
+		g_free(it->second); // libpurple's table frees nothing; freeing here keeps ASan's leak report about the test, not the fake
+	c->data[key] = static_cast<char *>(data);
+}
+PurpleConversation *purple_find_conversation_with_account(PurpleConversationType type, const char *name, const PurpleAccount *) {
+	auto it = convs.find(std::string(type == PURPLE_CONV_TYPE_CHAT ? "chat:" : "im:") + name);
+	return it == convs.end() ? nullptr : &it->second->conv;
+}
+PurpleConversation *purple_conversation_new(PurpleConversationType type, PurpleAccount *, const char *name) {
+	return &find_or_new(type == PURPLE_CONV_TYPE_CHAT, name)->conv;
+}
+PurpleConvIm *purple_conversation_get_im_data(const PurpleConversation *conv) {
+	return reinterpret_cast<PurpleConvIm *>(const_cast<PurpleConversation *>(conv));
+}
+void purple_conv_im_write(PurpleConvIm *im, const char *who, const char *, PurpleMessageFlags flags, time_t) {
+	transport(conv_of(reinterpret_cast<PurpleConversation *>(im)), false, who, flags);
+}
+void serv_got_im(PurpleConnection *, const char *who, const char *, PurpleMessageFlags flags, time_t) {
+	transport(find_or_new(false, who), false, who, (PurpleMessageFlags)(flags | PURPLE_MESSAGE_RECV));
+}
+void serv_got_chat_in(PurpleConnection *, int id, const char *who, PurpleMessageFlags flags, const char *, time_t) {
+	EXPECT_EQ((guint)id, g_str_hash(kGroup));
+	if (g_strcmp0(who, kUs) == 0) { // the chat's nick
+		flags = (PurpleMessageFlags)((flags | PURPLE_MESSAGE_SEND) & ~PURPLE_MESSAGE_RECV);
+	} else {
+		flags = (PurpleMessageFlags)(flags | PURPLE_MESSAGE_RECV);
+	}
+	transport(find_or_new(true, kGroup), true, who, flags);
+}
+// the rest of the glue
+PurpleConversation *gowhatsapp_enter_group_chat(PurpleConnection *, const char *remoteJid, char **, char **) {
+	return &find_or_new(true, remoteJid)->conv;
+}
+PurpleBuddy *gowhatsapp_ensure_buddy_in_blist(PurpleAccount *, const char *, const char *) { return nullptr; }
+}
+
+// Another member's message in a group - a vote on our own poll among them - is received, from
+// them, with its id.
+TEST(DisplayMessage, AMembersGroupMessageIsReceivedFromThem) {
+	reset();
+	show(kAnna, kGroup, true, false, "ANNAVOTE");
+	ASSERT_EQ(written.size(), 1u);
+	EXPECT_TRUE(written[0].flags & PURPLE_MESSAGE_RECV);
+	EXPECT_FALSE(written[0].flags & PURPLE_MESSAGE_SEND);
+	EXPECT_FALSE(written[0].flags & PURPLE_MESSAGE_REMOTE_SEND);
+	EXPECT_EQ(written[0].who, kAnna);
+	EXPECT_EQ(written[0].id, "ANNAVOTE");
+}
+
+// Ours, sent from our phone into a group (a poll we made there), is stored with its id, so that
+// votes, reactions, edits and deletes find it.
+TEST(DisplayMessage, OurGroupMessageFromThePhoneKeepsItsId) {
+	reset();
+	show(kUs, kGroup, true, false, "OURPOLL", "the quoted text", "Anna", "QUOTED");
+	ASSERT_EQ(written.size(), 1u);
+	EXPECT_TRUE(written[0].flags & PURPLE_MESSAGE_SEND);
+	EXPECT_TRUE(written[0].flags & PURPLE_MESSAGE_REMOTE_SEND);
+	EXPECT_FALSE(written[0].flags & PURPLE_MESSAGE_RECV);
+	EXPECT_EQ(written[0].id, "OURPOLL");
+	EXPECT_EQ(written[0].quotedId, "QUOTED");
+	EXPECT_EQ(written[0].quotedText, "the quoted text");
+	EXPECT_EQ(written[0].quotedFrom, "Anna");
+}
+
+// Our local echo is the app's own row: nothing is left on the group for the next message to take.
+TEST(DisplayMessage, OurLocalEchoInAGroupLeavesNoId) {
+	reset();
+	show(kUs, kGroup, true, true, "ECHO", "the quoted text", "Anna", "QUOTED");
+	ASSERT_EQ(written.size(), 1u);
+	EXPECT_TRUE(written[0].flags & PURPLE_MESSAGE_SEND);
+	EXPECT_FALSE(written[0].flags & PURPLE_MESSAGE_REMOTE_SEND);
+	EXPECT_EQ(stashed(true, kGroup, "webos-msg-id"), "");
+	EXPECT_EQ(stashed(true, kGroup, "webos-quoted-id"), "");
+	show(kAnna, kGroup, true, false, "NEXT");
+	ASSERT_EQ(written.size(), 2u);
+	EXPECT_EQ(written[1].id, "NEXT");
+	EXPECT_EQ(written[1].quotedId, "");
+}
+
+// The 1:1 chat as it was: received and ours from the phone carry their id, the local echo none.
+TEST(DisplayMessage, OneToOneIdsAsBefore) {
+	reset();
+	show(kAnna, kAnna, false, false, "FROMANNA");
+	show(kUs, kAnna, false, false, "FROMPHONE");
+	show(kUs, kAnna, false, true, "ECHO");
+	ASSERT_EQ(written.size(), 3u);
+	EXPECT_TRUE(written[0].flags & PURPLE_MESSAGE_RECV);
+	EXPECT_EQ(written[0].id, "FROMANNA");
+	EXPECT_TRUE(written[1].flags & PURPLE_MESSAGE_REMOTE_SEND);
+	EXPECT_EQ(written[1].id, "FROMPHONE");
+	EXPECT_FALSE(written[2].flags & PURPLE_MESSAGE_REMOTE_SEND);
+	EXPECT_EQ(stashed(false, kAnna, "webos-msg-id"), "");
+	reset();
+}

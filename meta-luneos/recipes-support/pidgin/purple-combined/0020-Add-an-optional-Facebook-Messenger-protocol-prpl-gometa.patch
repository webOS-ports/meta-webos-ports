+	h.parseTable(&table.LSTable{
+		LSInsertMessage:           []*table.LSInsertMessage{gmInsert("mid.1", "", gmPeer)},
+		LSInsertStickerAttachment: []*table.LSInsertStickerAttachment{{MessageId: "mid.1", AttachmentFbid: "55", PreviewUrl: "https://cdn/s.webp", PreviewUrlMimeType: "image/webp"}},
+	})
+	a := onlyAttachment(t, r)
+	if filepath.Dir(a.path) != h.attachmentDir() || !strings.HasSuffix(a.path, ".webp") || a.m.id != "mid.1" {
+		t.Errorf("got %+v", a)
+	}
+}
+
+func TestGometaPlainPictureCarriesItsCaption(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.media["https://cdn/p.jpg"] = []byte{0xff, 0xd8}
+	h.parseTable(&table.LSTable{
+		LSInsertMessage:        []*table.LSInsertMessage{gmInsert("mid.2", "hello", gmPeer)},
+		LSInsertBlobAttachment: []*table.LSInsertBlobAttachment{{MessageId: "mid.2", AttachmentFbid: "66", PreviewUrl: "https://cdn/p.jpg", PreviewUrlMimeType: "image/jpeg"}},
+	})
+	a := onlyAttachment(t, r)
+	if !strings.HasSuffix(a.path, ".jpg") || a.m.text != "hello" {
+		t.Errorf("got %+v", a)
+	}
+	// The same attachment again (the next login's inbox) is not fetched again.
+	r.attachments = nil
+	h.parseTable(&table.LSTable{
+		LSInsertMessage:        []*table.LSInsertMessage{gmInsert("mid.2", "hello", gmPeer)},
+		LSInsertBlobAttachment: []*table.LSInsertBlobAttachment{{MessageId: "mid.2", AttachmentFbid: "66", PreviewUrl: "https://cdn/p.jpg", PreviewUrlMimeType: "image/jpeg"}},
+	})
+	if len(r.fetched) != 1 {
+		t.Errorf("fetched %d times, want 1", len(r.fetched))
+	}
+}
+
+func TestGometaPlainFileKeepsItsName(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.media["https://cdn/f"] = []byte("%PDF")
+	h.parseTable(&table.LSTable{
+		LSInsertMessage:        []*table.LSInsertMessage{gmInsert("mid.3", "", gmPeer)},
+		LSInsertBlobAttachment: []*table.LSInsertBlobAttachment{{MessageId: "mid.3", AttachmentFbid: "77", PlayableUrl: "https://cdn/f", AttachmentMimeType: "application/pdf", Filename: "Q3 Report.pdf"}},
+	})
+	if a := onlyAttachment(t, r); !strings.HasSuffix(a.path, "/Q3 Report.pdf") || a.mimetype != "application/pdf" {
+		t.Errorf("got %+v", a)
+	}
+}
+
+func TestGometaPlainFailedDownloadStillShowsTheText(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.failNext = errors.New("HTTP 403")
+	h.parseTable(&table.LSTable{
+		LSInsertMessage:        []*table.LSInsertMessage{gmInsert("mid.4", "caption", gmPeer)},
+		LSInsertBlobAttachment: []*table.LSInsertBlobAttachment{{MessageId: "mid.4", AttachmentFbid: "88", PreviewUrl: "https://cdn/x.jpg"}},
+	})
+	if m := onlyMessage(t, r); m.text != "caption" {
+		t.Errorf("got %q", m.text)
+	}
+}
+
+func TestGometaPlainLocationIsShownAsText(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{
+		LSInsertMessage:       []*table.LSInsertMessage{gmInsert("mid.5", "", gmPeer)},
+		LSInsertXmaAttachment: []*table.LSInsertXmaAttachment{{MessageId: "mid.5", AttachmentFbid: "99", TitleText: "Live location", SubtitleText: "Here"}},
+		LSInsertAttachmentCta: []*table.LSInsertAttachmentCta{{AttachmentFbid: "99", Type_: "xma_live_location_sharing", NativeUrl: "52.5,13.4"}},
+	})
+	m := onlyMessage(t, r)
+	if want := gometaLocationText(52.5, 13.4, "Live location", "Here", true); m.text != want {
+		t.Errorf("got %q, want %q", m.text, want)
+	}
+	if len(r.fetched) != 0 {
+		t.Errorf("a location fetched %v", r.fetched)
+	}
+}
+
+func TestGometaPlainThumbsUpIsAnEmoji(t *testing.T) {
+	h, r := newTestGometa(t)
+	msg := gmInsert("mid.6", "", gmPeer)
+	msg.StickerId = 369239263222822
+	h.parseTable(&table.LSTable{
+		LSInsertMessage:           []*table.LSInsertMessage{msg},
+		LSInsertStickerAttachment: []*table.LSInsertStickerAttachment{{MessageId: "mid.6", AttachmentFbid: "1", PreviewUrl: "https://cdn/like.png"}},
+	})
+	if m := onlyMessage(t, r); m.text != "\U0001F44D" || len(r.fetched) != 0 {
+		t.Errorf("got %q, fetched %v", m.text, r.fetched)
+	}
+}
+
+func TestGometaPlainTextAloneIsUnchanged(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{gmInsert("mid.7", "hi", gmPeer), gmInsert("mid.8", "", gmPeer)}})
+	if m := onlyMessage(t, r); m.text != "hi" || m.id != "mid.7" {
+		t.Errorf("got %+v", m)
+	}
+}
diff --git a/gometa_safe.go b/gometa_safe.go
new file mode 100644
index 0000000..fb3ad10
--- /dev/null
+++ b/gometa_safe.go
@@ -0,0 +1,17 @@
+//go:build gometa
+
+package main
+
+import "runtime/debug"
+
+// gometaRecovered runs f and, if it panics, hands the panic value and stack to onPanic instead of
+// letting it unwind further. Go code in this plugin runs on a Go runtime inside the messaging
+// service, so a panic in one of its own goroutines aborts the whole service, every account with it.
+func gometaRecovered(f func(), onPanic func(r any, stack []byte)) {
+	defer func() {
+		if r := recover(); r != nil {
+			onPanic(r, debug.Stack())
+		}
+	}()
+	f()
+}
diff --git a/gometa_safe_test.go b/gometa_safe_test.go
new file mode 100644
index 0000000..284a0fc
--- /dev/null
+++ b/gometa_safe_test.go
@@ -0,0 +1,45 @@
+//go:build gometa
+
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+type bloksLiteral struct{ v any }
+
+func (l *bloksLiteral) value() any { return l.v }
+
+// What took the service down: a method called on a nil pointer deep inside the login.
+func TestGometaRecoveredCatchesANilDereference(t *testing.T) {
+	var got any
+	var stack []byte
+	gometaRecovered(func() {
+		var lit *bloksLiteral
+		_ = lit.value()
+	}, func(r any, s []byte) { got, stack = r, s })
+	if got == nil {
+		t.Fatal("the panic was not handed to onPanic")
+	}
+	if !strings.Contains(string(stack), "bloksLiteral") {
+		t.Errorf("stack does not show where it panicked:\n%s", stack)
+	}
+}
+
+func TestGometaRecoveredLeavesANormalRunAlone(t *testing.T) {
+	ran, panicked := false, false
+	gometaRecovered(func() { ran = true }, func(any, []byte) { panicked = true })
+	if !ran || panicked {
+		t.Fatalf("ran=%v panicked=%v", ran, panicked)
+	}
+}
+
+// The login runs on its own goroutine; the panic must be caught there too.
+func TestGometaRecoveredOnAGoroutine(t *testing.T) {
+	done := make(chan any, 1)
+	go gometaRecovered(func() { panic("bloks") }, func(r any, _ []byte) { done <- r })
+	if r := <-done; r != "bloks" {
+		t.Fatalf("got %v", r)
+	}
+}
diff --git a/gometa_sink.go b/gometa_sink.go
new file mode 100644
index 0000000..48bb6c3
--- /dev/null
+++ b/gometa_sink.go
@@ -0,0 +1,235 @@
+//go:build gometa
+
+package main
+
+// Where the Facebook protocol hands what it received to libpurple (gometaSink), and what it asks of
+// the two Facebook connections besides sending a message (gometaWire). The handler goes through
+// these instead of calling the C bridge and the clients directly, so a test can stand in for both
+// and see what a table or an encrypted event leads to.
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/mautrix-meta/pkg/messagix/useragent"
+	"go.mau.fi/whatsmeow"
+	armadillo "go.mau.fi/whatsmeow/proto"
+	"go.mau.fi/whatsmeow/proto/waMediaTransport"
+	"go.mau.fi/whatsmeow/proto/waMsgApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+)
+
+// gometaIncoming is one message to show: conv is the thread key, who the sender's fbid.
+type gometaIncoming struct {
+	conv, who, name, text, id string
+	ts                        int64
+	isGroup, isOutgoing       bool
+	quotedText, quotedFrom    string // the message this one replies to, if any
+}
+
+type gometaSink interface {
+	buddy(fbid int64, name string) // add or update a contact
+	message(m gometaIncoming)
+	attachment(m gometaIncoming, path, mimetype string) // a received file, kept at path; m.text is its caption
+	edit(id, text string)                               // the message shown under id now reads text
+	remove(id string)                                   // the message shown under id was deleted for everyone
+	reaction(conv, target, actor, emoji string)         // actor reacted to target ("" emoji: took it back)
+	typing(who string, on bool)
+	failed(text string, fatal bool)                          // an error the user is shown
+	notice(conv string, isGroup bool, text string, ts int64) // a line in a chat that nobody wrote
+	members(conv string, fbids []int64)                      // who is in a group chat besides us
+	chat(threadKey int64, name string)                       // a group chat, made or named again
+}
+
+// gometaPurpleSink is the real one: the gometa C bridge (gometabridge.c). Facebook text is plain,
+// so it is escaped for libpurple as the WhatsApp protocol's is (escape_text). Edits, deletions and
+// reactions are shown as text in the chat, as the WhatsApp protocol shows them (handle_message.go);
+// the recent messages index (gometa_index.go) finds which chat they belong to.
+type gometaPurpleSink struct{ h *gometaHandler }
+
+func (s gometaPurpleSink) buddy(fbid int64, name string) { gometaNotifyBuddy(s.h.account, fbid, name) }
+func (s gometaPurpleSink) message(m gometaIncoming) {
+	s.h.index.add(m)
+	if m.quotedText != "" {
+		m.text = gometaQuote(m.quotedText) + m.text
+	}
+	m.text = escape_text(m.text)
+	gometaNotifyMessage(s.h.account, m)
+}
+func (s gometaPurpleSink) attachment(m gometaIncoming, path, mimetype string) {
+	s.h.index.add(m)
+	m.text = escape_text(m.text)
+	gometaNotifyAttachment(s.h.account, m, path, mimetype)
+}
+func (s gometaPurpleSink) edit(id, text string) {
+	if m, ok := s.h.index.editLine(id, text, time.Now().Unix()); ok {
+		m.text = escape_text(m.text)
+		gometaNotifyMessage(s.h.account, m)
+	} else {
+		s.h.logger.Debug().Str("id", id).Msg("edit of a message not shown here, dropped")
+	}
+}
+func (s gometaPurpleSink) remove(id string) {
+	if m, ok := s.h.index.deleteLine(id, time.Now().Unix()); ok {
+		m.text = escape_text(m.text)
+		gometaNotifyMessage(s.h.account, m)
+	} else {
+		s.h.logger.Debug().Str("id", id).Msg("deletion of a message not shown here, dropped")
+	}
+}
+func (s gometaPurpleSink) reaction(conv, target, actor, emoji string) {
+	s.h.mu.Lock()
+	isGroup := s.h.threadGroup[gometaParseID(conv)]
+	name := s.h.contactName[gometaParseID(actor)]
+	s.h.mu.Unlock()
+	m := s.h.index.reactionLine(conv, target, actor, emoji, time.Now().Unix())
+	m.name, m.isGroup, m.isOutgoing = name, isGroup, gometaParseID(actor) == s.h.selfID
+	m.text = escape_text(m.text)
+	gometaNotifyMessage(s.h.account, m)
+}
+func (s gometaPurpleSink) failed(text string, fatal bool) {
+	gometaReportError(s.h.account, text, fatal)
+}
+func (s gometaPurpleSink) chat(threadKey int64, name string) {
+	gometaNotifyChat(s.h.account, threadKey, name)
+}
+func (s gometaPurpleSink) members(conv string, fbids []int64) {
+	gometaNotifyMembers(s.h.account, conv, fbids)
+}
+func (s gometaPurpleSink) notice(conv string, isGroup bool, text string, ts int64) {
+	gometaNotifySystem(s.h.account, conv, isGroup, escape_text(text), ts)
+}
+func (s gometaPurpleSink) typing(who string, on bool) { gometaNotifyTyping(s.h.account, who, on) }
+
+func (h *gometaHandler) out() gometaSink {
+	if h.sink != nil {
+		return h.sink
+	}
+	return gometaPurpleSink{h}
+}
+
+type gometaWire interface {
+	// encrypted chats (the whatsmeow client)
+	chatPresence(ctx context.Context, to waTypes.JID, composing bool) error
+	markRead(ctx context.Context, ids []waTypes.MessageID, ts time.Time, chat, sender waTypes.JID) error
+	downloadFB(ctx context.Context, integral *waMediaTransport.WAMediaTransport_Integral, mediaType whatsmeow.MediaType) ([]byte, error)
+	sendFB(ctx context.Context, to waTypes.JID, msg armadillo.RealMessageApplicationSub, meta *waMsgApplication.MessageApplication_Metadata, id waTypes.MessageID) error
+	// plain chats (the messagix client)
+	fbTask(ctx context.Context, task socket.Task, stateless bool) error
+	sendTask(ctx context.Context, task socket.Task) (*table.LSTable, error) // the tables the reply carries
+	waitSend(ctx context.Context) error                                     // until messages can be sent
+	fetch(ctx context.Context, url, mime string) ([]byte, error)
+}
+
+func (h *gometaHandler) net() gometaWire {
+	if h.wire != nil {
+		return h.wire
+	}
+	return gometaLiveWire{h}
+}
+
+type gometaLiveWire struct{ h *gometaHandler }
+
+var errGometaE2EEDown = fmt.Errorf("encrypted chats are not connected")
+
+func (w gometaLiveWire) chatPresence(ctx context.Context, to waTypes.JID, composing bool) error {
+	if w.h.e2ee == nil {
+		return errGometaE2EEDown
+	}
+	state := waTypes.ChatPresencePaused
+	if composing {
+		state = waTypes.ChatPresenceComposing
+	}
+	return w.h.e2ee.SendChatPresence(ctx, to, state, waTypes.ChatPresenceMediaText)
+}
+
+func (w gometaLiveWire) markRead(ctx context.Context, ids []waTypes.MessageID, ts time.Time, chat, sender waTypes.JID) error {
+	if w.h.e2ee == nil {
+		return errGometaE2EEDown
+	}
+	return w.h.e2ee.MarkRead(ctx, ids, ts, chat, sender)
+}
+
+func (w gometaLiveWire) downloadFB(ctx context.Context, integral *waMediaTransport.WAMediaTransport_Integral, mediaType whatsmeow.MediaType) ([]byte, error) {
+	if w.h.e2ee == nil {
+		return nil, errGometaE2EEDown
+	}
+	return w.h.e2ee.DownloadFB(ctx, integral, mediaType)
+}
+
+func (w gometaLiveWire) sendFB(ctx context.Context, to waTypes.JID, msg armadillo.RealMessageApplicationSub, meta *waMsgApplication.MessageApplication_Metadata, id waTypes.MessageID) error {
+	if w.h.e2ee == nil {
+		return errGometaE2EEDown
+	}
+	_, err := w.h.e2ee.SendFBMessage(ctx, to, msg, meta, whatsmeow.SendRequestExtra{ID: id})
+	return err
+}
+
+func (w gometaLiveWire) sendTask(ctx context.Context, task socket.Task) (*table.LSTable, error) {
+	if w.h.client == nil {
+		return nil, fmt.Errorf("not connected to Facebook")
+	}
+	return w.h.client.ExecuteTasks(ctx, task)
+}
+
+func (w gometaLiveWire) waitSend(ctx context.Context) error {
+	if w.h.client == nil {
+		return fmt.Errorf("not connected to Facebook")
+	}
+	return w.h.client.WaitUntilCanSendMessages(ctx, 20*time.Second)
+}
+
+func (w gometaLiveWire) fbTask(ctx context.Context, task socket.Task, stateless bool) error {
+	if w.h.client == nil {
+		return fmt.Errorf("not connected to Facebook")
+	}
+	if stateless {
+		return w.h.client.ExecuteStatelessTask(ctx, task)
+	}
+	_, err := w.h.client.ExecuteTasks(ctx, task)
+	return err
+}
+
+// gometaMaxDownload bounds a plain chat's attachment, which is read into memory. Facebook's own
+// limit for a file sent in Messenger is stated as 100 MB (not verified here).
+const gometaMaxDownload = 100 << 20
+
+var gometaHTTP = &http.Client{Timeout: 3 * time.Minute}
+
+// fetch downloads a plain chat's attachment from Facebook's CDN. The URL is signed, so it needs
+// no cookies; the headers are those mautrix-meta's mediadl sends.
+func (gometaLiveWire) fetch(ctx context.Context, url, mime string) ([]byte, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "*/*")
+	if strings.HasPrefix(mime, "image/") {
+		req.Header.Set("Accept", "image/avif,image/webp,*/*")
+	}
+	req.Header.Set("Sec-Fetch-Mode", "no-cors")
+	req.Header.Set("Sec-Fetch-Site", "cross-site")
+	req.Header.Set("User-Agent", useragent.UserAgent)
+	resp, err := gometaHTTP.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("HTTP %d", resp.StatusCode)
+	}
+	data, err := io.ReadAll(io.LimitReader(resp.Body, gometaMaxDownload+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > gometaMaxDownload {
+		return nil, fmt.Errorf("larger than %d bytes", gometaMaxDownload)
+	}
+	return data, nil
+}
diff --git a/gometa_video.go b/gometa_video.go
new file mode 100644
index 0000000..8e7d1c1
--- /dev/null
+++ b/gometa_video.go
@@ -0,0 +1,94 @@
+//go:build gometa
+
+package main
+
+// Minimal MP4 box walker to pull width/height/duration out of a video before sending it over the
+// Facebook E2EE transport. Messenger clients render an armadillo VideoMessage much better when the
+// dimensions and duration are populated (mirrors the thumbnail-w/h requirement in sendImageE2EE).
+// We intentionally avoid a full mp4 decode: we only read the moov/mvhd (duration) and the first
+// video trak's tkhd (display width/height, stored as 16.16 fixed point).
+
+func be32(b []byte) uint32 {
+	return uint32(b[0])<<24 | uint32(b[1])<<16 | uint32(b[2])<<8 | uint32(b[3])
+}
+
+// findBoxes returns the payloads (header stripped) of every top-level box named `name` in data.
+func findBoxes(data []byte, name string) [][]byte {
+	var out [][]byte
+	i := 0
+	for i+8 <= len(data) {
+		size := int(be32(data[i:]))
+		typ := string(data[i+4 : i+8])
+		hdr := 8
+		if size == 1 { // 64-bit largesize; assume the high 32 bits are zero (< 4 GiB)
+			if i+16 > len(data) {
+				break
+			}
+			size = int(be32(data[i+12:]))
+			hdr = 16
+		} else if size == 0 { // box extends to end of data
+			size = len(data) - i
+		}
+		if size < hdr || i+size > len(data) {
+			break
+		}
+		if typ == name {
+			out = append(out, data[i+hdr:i+size])
+		}
+		i += size
+	}
+	return out
+}
+
+// videoInfoMP4 extracts (width, height, seconds) from an mp4. Returns zeros for any field it can't
+// parse; the caller substitutes defaults so the send still goes through.
+func videoInfoMP4(data []byte) (width, height, seconds uint32) {
+	moovs := findBoxes(data, "moov")
+	if len(moovs) == 0 {
+		return
+	}
+	moov := moovs[0]
+
+	if mvhds := findBoxes(moov, "mvhd"); len(mvhds) > 0 {
+		mvhd := mvhds[0]
+		if len(mvhd) >= 4 {
+			ver := mvhd[0]
+			var ts, dur uint32
+			if ver == 1 {
+				// version 1: creation(8) mod(8) timescale(4) duration(8)
+				if len(mvhd) >= 32 {
+					ts = be32(mvhd[20:])
+					dur = be32(mvhd[28:]) // low 32 bits of the 64-bit duration
+				}
+			} else {
+				// version 0: creation(4) mod(4) timescale(4) duration(4)
+				if len(mvhd) >= 20 {
+					ts = be32(mvhd[12:])
+					dur = be32(mvhd[16:])
+				}
+			}
+			if ts > 0 {
+				seconds = dur / ts
+			}
+		}
+	}
+
+	// Take the first trak whose tkhd reports non-zero display dimensions (the video track).
+	for _, trak := range findBoxes(moov, "trak") {
+		tkhds := findBoxes(trak, "tkhd")
+		if len(tkhds) == 0 {
+			continue
+		}
+		tk := tkhds[0]
+		// width/height are the final 8 bytes of tkhd, each a 16.16 fixed-point value.
+		if len(tk) >= 8 {
+			w := be32(tk[len(tk)-8:]) >> 16
+			h := be32(tk[len(tk)-4:]) >> 16
+			if w > 0 && h > 0 {
+				width, height = w, h
+				break
+			}
+		}
+	}
+	return
+}
diff --git a/gometabridge.c b/gometabridge.c
new file mode 100644
index 0000000..53ba92d
--- /dev/null
+++ b/gometabridge.c
@@ -0,0 +1,322 @@
+//go:build gometa
+
+// gometabridge.c — the Go->purple boundary of the Facebook protocol. Like the WhatsApp bridge
+// (bridge.c), each message is copied and handled on the glib main thread (purple_timeout_add).
+#include "gometabridge.h"
+#include <stdlib.h> // free/malloc
+#include <string.h> // strdup
+#include <time.h>   // time
+
+// The cgo exports this file calls. libwhatsmeow.h, which declares them, does not exist yet when cgo
+// compiles this file. The signatures must match the //export functions.
+extern void gometa_go_submit_input(PurpleAccount *account, char *value);
+extern void gometa_go_chat_joined(PurpleAccount *account, char *chat);
+
+#if !GLIB_CHECK_VERSION(2, 68, 0)
+#define g_memdup2 g_memdup
+#endif
+
+// The name of the chat a 2FA prompt is shown in when the UI has no request dialogs.
+#define GOMETA_LOGIN_CHAT "Facebook"
+
+// ---- account settings (cache the login session) ----
+char *gometa_get_setting(PurpleAccount *account, const char *key) {
+    const char *v = purple_account_get_string(account, key, NULL);
+    return (v && *v) ? strdup(v) : NULL;
+}
+void gometa_set_setting(PurpleAccount *account, const char *key, const char *value) {
+    purple_account_set_string(account, key, value ? value : "");
+}
+
+// ---- interactive login prompt (2FA) ----
+struct gometa_req { PurpleAccount *account; char *prompt; };
+
+// PurpleRequestInputCb: libpurple calls these as void (*)(void *, const char *)
+static void gometa_input_ok(void *account, const char *value) {
+    gometa_go_submit_input((PurpleAccount *)account, (char *)(value ? value : ""));
+}
+
+static void gometa_input_cancel(void *account, const char *value) {
+    (void)value;
+    gometa_go_submit_input((PurpleAccount *)account, (char *)"");
+}
+
+static gboolean gometa_do_request(gpointer data) {
+    struct gometa_req *r = (struct gometa_req *)data;
+    PurpleConnection *gc = purple_account_get_connection(r->account);
+    if (gc != NULL) {
+        if (purple_request_get_ui_ops() != NULL) {
+            purple_request_input(gc, "Facebook", "Facebook login code", r->prompt, NULL, FALSE, FALSE, NULL,
+                "_OK", G_CALLBACK(gometa_input_ok), "_Cancel", G_CALLBACK(gometa_input_cancel),
+                r->account, NULL, NULL, r->account);
+        } else {
+            // A UI without request dialogs (a bridge, say): ask in a chat; the reply there is the
+            // code (gometa_go_send_message).
+            gchar *text = g_strdup_printf("Facebook needs your login code. Reply to this chat with it.\n%s", r->prompt);
+            gchar *markup = purple_markup_escape_text(text, -1);
+            serv_got_im(gc, GOMETA_LOGIN_CHAT, markup, PURPLE_MESSAGE_RECV, time(NULL));
+            g_free(markup);
+            g_free(text);
+        }
+    } else {
+        gometa_go_submit_input(r->account, (char *)"");
+    }
+    free(r->prompt);
+    g_free(r);
+    return FALSE;
+}
+
+void gometa_request_input(PurpleAccount *account, const char *prompt) {
+    struct gometa_req *r = g_new0(struct gometa_req, 1);
+    r->account = account;
+    r->prompt = strdup(prompt ? prompt : "");
+    purple_timeout_add(0, gometa_do_request, r);
+}
+
+static void gometa_free_strings(gometa_message_t *m) {
+    free(m->who);
+    free(m->conv);
+    free(m->name);
+    free(m->text);
+    free(m->id);
+    free(m->path);
+    free(m->mimetype);
+}
+
+// The buddy-list group all Facebook contacts/chats live under.
+PurpleGroup *gometa_blist_group(void) {
+    PurpleGroup *g = purple_find_group("Facebook");
+    if (!g) { g = purple_group_new("Facebook"); purple_blist_add_group(g, NULL); }
+    return g;
+}
+
+static void gometa_ensure_buddy(PurpleAccount *account, const char *id, const char *name) {
+    if (!id || !*id) return;
+    PurpleBuddy *b = purple_find_buddy(account, id);
+    if (!b) {
+        b = purple_buddy_new(account, id, name);
+        purple_blist_add_buddy(b, NULL, gometa_blist_group(), NULL);
+    }
+    if (name && *name) {
+        serv_got_alias(purple_account_get_connection(account), id, name);
+        purple_blist_node_set_string(&b->node, "server_alias", name);
+    }
+}
+
+// The buddy-list chat of a thread, by its "id" component: a group renamed is no longer found by its
+// old name.
+static PurpleChat *gometa_find_chat_by_id(PurpleAccount *account, const char *threadKey) {
+    for (PurpleBlistNode *node = purple_blist_get_root(); node != NULL; node = purple_blist_node_next(node, TRUE)) {
+        if (!PURPLE_BLIST_NODE_IS_CHAT(node)) continue;
+        PurpleChat *chat = (PurpleChat *)node;
+        if (purple_chat_get_account(chat) != account) continue;
+        GHashTable *comp = purple_chat_get_components(chat);
+        const char *id = comp ? (const char *)g_hash_table_lookup(comp, "id") : NULL;
+        if (id != NULL && strcmp(id, threadKey) == 0) return chat;
+    }
+    return NULL;
+}
+
+// Register a group thread as a blist chat (component "id" = thread key, used by find_blist_chat).
+static void gometa_ensure_chat(PurpleAccount *account, const char *threadKey, const char *name) {
+    if (!threadKey || !*threadKey) return;
+    PurpleChat *chat = gometa_find_chat_by_id(account, threadKey);
+    if (!chat) {
+        GHashTable *comp = g_hash_table_new_full(g_str_hash, g_str_equal, NULL, g_free);
+        g_hash_table_insert(comp, (gpointer)"id", g_strdup(threadKey));
+        chat = purple_chat_new(account, name && *name ? name : threadKey, comp);
+        purple_blist_add_chat(chat, gometa_blist_group(), NULL);
+    } else if (name && *name) {
+        purple_blist_alias_chat(chat, name);
+        // an open chat's title is the buddy list's name for it, which may just have changed
+        PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_CHAT, threadKey, account);
+        if (conv != NULL) purple_conversation_autoset_title(conv);
+    }
+}
+
+// Open a group's chat conversation, as a message in it does, and have Go put its members on it
+// when it is new.
+static void gometa_open_group(PurpleConnection *pc, const char *threadKey) {
+    int chat_id = (int)g_str_hash(threadKey);
+    if (purple_find_chat(pc, chat_id) == NULL) {
+        serv_got_joined_chat(pc, chat_id, threadKey);
+        gometa_go_chat_joined(purple_connection_get_account(pc), (char *)threadKey);
+    }
+}
+
+// Who is in a group besides us, put on its chat conversation when that is open. Each is a buddy
+// already (the participant rows add them), so the chat shows their names.
+static void gometa_set_members(PurpleAccount *account, const char *threadKey, const char *joined) {
+    PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_CHAT, threadKey, account);
+    PurpleConvChat *chat = conv ? purple_conversation_get_chat_data(conv) : NULL;
+    if (chat == NULL) return;
+    purple_conv_chat_clear_users(chat);
+    if (joined == NULL || *joined == '\0') return;
+    gchar **ids = g_strsplit(joined, "\x1f", -1);
+    for (gchar **id = ids; *id != NULL; id++) {
+        if (**id != '\0') purple_conv_chat_add_user(chat, *id, NULL, PURPLE_CBFLAGS_NONE, FALSE);
+    }
+    g_strfreev(ids);
+}
+
+// Write a message (markup) into a 1:1 or group chat. Our own messages from another device are
+// written as sent (PURPLE_MESSAGE_REMOTE_SEND), as the WhatsApp protocol does (glue/display_message.c).
+static void gometa_write(PurpleConnection *pc, PurpleAccount *account, const gometa_message_t *m,
+                         const char *text, PurpleMessageFlags extra, time_t ts) {
+    const PurpleMessageFlags dir = m->isOutgoing
+        ? (PurpleMessageFlags)(PURPLE_MESSAGE_SEND | PURPLE_MESSAGE_REMOTE_SEND)
+        : PURPLE_MESSAGE_RECV;
+    const PurpleMessageFlags flags = (PurpleMessageFlags)(dir | extra);
+    if (m->isGroup) {
+        gometa_open_group(pc, m->conv);
+        const char *from = m->isOutgoing ? purple_account_get_username(account)
+                                         : (m->who && *m->who ? m->who : "unknown");
+        serv_got_chat_in(pc, (int)g_str_hash(m->conv), from, flags, text, ts);
+    } else if (m->isOutgoing) {
+        // serv_got_im would mark it received
+        PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_IM, m->conv, account);
+        if (!conv) conv = purple_conversation_new(PURPLE_CONV_TYPE_IM, account, m->conv);
+        purple_conv_im_write(purple_conversation_get_im_data(conv), m->conv, text, flags, ts);
+    } else {
+        serv_got_im(pc, m->conv, text, flags, ts);
+    }
+}
+
+// A line nobody sent - a group's news, which Facebook words itself - kept in the chat as a system
+// line, not logged, as the WhatsApp protocol writes one.
+static void gometa_system_line(PurpleConnection *pc, PurpleAccount *account, const char *conv,
+                               int isGroup, const char *text, time_t ts) {
+    const PurpleMessageFlags flags = (PurpleMessageFlags)(PURPLE_MESSAGE_RECV | PURPLE_MESSAGE_SYSTEM | PURPLE_MESSAGE_NO_LOG);
+    if (isGroup) {
+        gometa_open_group(pc, conv);
+        serv_got_chat_in(pc, (int)g_str_hash(conv), "system", flags, text, ts);
+    } else {
+        if (purple_find_conversation_with_account(PURPLE_CONV_TYPE_IM, conv, account) == NULL) {
+            purple_conversation_new(PURPLE_CONV_TYPE_IM, account, conv);
+        }
+        serv_got_im(pc, conv, text, flags, ts);
+    }
+}
+
+// A received file: a picture inline, as the WhatsApp protocol shows one (glue/handle_attachment.c),
+// anything else as a link to the file. The caption (markup) comes after it.
+static void gometa_attachment(PurpleConnection *pc, PurpleAccount *account, const gometa_message_t *m, time_t ts) {
+    GString *body = g_string_new(NULL);
+    PurpleMessageFlags extra = 0;
+    int img_id = 0;
+    if (m->mimetype != NULL && g_str_has_prefix(m->mimetype, "image/")) {
+        gchar *data = NULL;
+        gsize len = 0;
+        if (g_file_get_contents(m->path, &data, &len, NULL)) {
+            img_id = purple_imgstore_add_with_id(data, len, NULL); // takes data
+            if (img_id > 0) {
+                g_string_append_printf(body, "<img id=\"%d\"/>", img_id);
+                extra = PURPLE_MESSAGE_IMAGES;
+            }
+        }
+    }
+    if (img_id <= 0) {
+        gchar *uri = g_filename_to_uri(m->path, NULL, NULL);
+        gchar *base = g_path_get_basename(m->path);
+        gchar *label = purple_markup_escape_text(base, -1);
+        if (uri != NULL) {
+            gchar *href = g_markup_escape_text(uri, -1);
+            g_string_append_printf(body, "<a href=\"%s\">%s</a>", href, label);
+            g_free(href);
+        } else {
+            g_string_append(body, label);
+        }
+        g_free(label);
+        g_free(base);
+        g_free(uri);
+    }
+    if (m->text && *m->text) {
+        g_string_append(body, "<br>");
+        g_string_append(body, m->text);
+    }
+    gometa_write(pc, account, m, body->str, extra, ts);
+    if (img_id > 0) purple_imgstore_unref_by_id(img_id);
+    g_string_free(body, TRUE);
+}
+
+static gboolean gometa_dispatch(gpointer data) {
+    gometa_message_t *m = (gometa_message_t *)data;
+    // the account may have been deleted since Go sent this
+    PurpleConnection *pc = g_list_find(purple_accounts_get_all(), m->account) != NULL
+        ? purple_account_get_connection(m->account) : NULL;
+    if (pc != NULL) {
+        time_t ts = m->timestamp ? m->timestamp : time(NULL);
+        switch (m->msgtype) {
+            case gometa_message_type_connected:
+                purple_connection_set_state(pc, PURPLE_CONNECTED);
+                break;
+            case gometa_message_type_disconnected:
+                purple_connection_set_state(pc, PURPLE_DISCONNECTED);
+                break;
+            case gometa_message_type_error:
+                if (m->fatal) {
+                    // A fatal error means "stop, this won't succeed on its own" (e.g. login/2FA
+                    // failed, session expired). Report it with a reason libpurple considers fatal
+                    // (AUTHENTICATION_FAILED) so the account is taken offline and does not
+                    // reconnect: a NETWORK_ERROR would retry the failed login every minute, which
+                    // can get the Facebook account flagged.
+                    purple_connection_error_reason(pc, PURPLE_CONNECTION_ERROR_AUTHENTICATION_FAILED,
+                        m->text ? m->text : "Unknown error");
+                } else {
+                    purple_debug_error(GOMETA_PLUGIN_ID, "%s\n", m->text ? m->text : "error");
+                }
+                break;
+            case gometa_message_type_buddy:
+                gometa_ensure_buddy(m->account, m->who, m->name);
+                break;
+            case gometa_message_type_chat:
+                gometa_ensure_chat(m->account, m->conv, m->name);
+                break;
+            case gometa_message_type_presence:
+                if (m->who && *m->who) {
+                    purple_prpl_got_user_status(m->account, m->who,
+                        m->isOutgoing ? "available" : "offline", NULL);
+                }
+                break;
+            case gometa_message_type_typing:
+                if (m->who && *m->who) {
+                    if (m->isOutgoing) {
+                        serv_got_typing(pc, m->who, 0, PURPLE_TYPING);
+                    } else {
+                        serv_got_typing_stopped(pc, m->who);
+                    }
+                }
+                break;
+            case gometa_message_type_text:
+                if (m->text && m->conv && *m->conv) {
+                    gometa_write(pc, m->account, m, m->text, 0, ts);
+                }
+                break;
+            case gometa_message_type_attachment:
+                if (m->path && *m->path && m->conv && *m->conv) {
+                    gometa_attachment(pc, m->account, m, ts);
+                }
+                break;
+            case gometa_message_type_members:
+                if (m->conv && *m->conv) {
+                    gometa_set_members(m->account, m->conv, m->text);
+                }
+                break;
+            case gometa_message_type_system:
+                if (m->conv && *m->conv && m->text && *m->text) {
+                    gometa_system_line(pc, m->account, m->conv, m->isGroup, m->text, ts);
+                }
+                break;
+            default:
+                break;
+        }
+    }
+    gometa_free_strings(m);
+    g_free(m);
+    return FALSE;
+}
+
+void gometa_process_message(gometa_message_t msg) {
+    gometa_message_t *heap = g_memdup2(&msg, sizeof msg);
+    purple_timeout_add(0, gometa_dispatch, heap);
+}
diff --git a/gometabridge.h b/gometabridge.h
new file mode 100644
index 0000000..cca0053
--- /dev/null
+++ b/gometabridge.h
@@ -0,0 +1,56 @@
+#pragma once
+// The C side of the Facebook Messenger protocol (prpl-gometa, built with -tags gometa / -DGOMETA=ON).
+// All identifiers are gometa_-prefixed so they do not collide with the WhatsApp (gowhatsapp_) code
+// in the same shared object and Go package.
+#include <purple.h>
+#include <time.h>
+
+#define GOMETA_PLUGIN_ID      "prpl-gometa"
+#define GOMETA_PLUGIN_NAME    "Facebook (E2EE)"
+#define GOMETA_PLUGIN_SUMMARY "Facebook Messenger, end-to-end encrypted chats included"
+#define GOMETA_AUTHOR         "Herman van Hazendonk <github.com@herrie.org>"
+
+enum gometa_message_type {
+    gometa_message_type_error,        // text = error; fatal = connection-fatal
+    gometa_message_type_connected,
+    gometa_message_type_disconnected,
+    gometa_message_type_text,         // a message: conv, who, name, text (markup), id, isGroup, isOutgoing
+    gometa_message_type_buddy,        // add/update a contact: who=fbid, name=display name
+    gometa_message_type_chat,         // register a group chat: conv=threadKey, name=thread name
+    gometa_message_type_presence,     // buddy presence: who=fbid, isOutgoing=1 -> available else offline
+    gometa_message_type_system,       // a line nobody sent (a group's news): conv, text (markup), isGroup
+    gometa_message_type_members,      // who is in a group besides us: conv, text = "\x1f"-joined fbids
+    gometa_message_type_typing,       // a 1:1 chat partner typing: who, isOutgoing=1 -> typing else stopped
+    gometa_message_type_attachment,   // a received file: as text, plus path and mimetype; text = caption
+};
+
+typedef struct gometa_message {
+    PurpleAccount *account;
+    char *who;   // for text: sender fbid; for buddy: contact fbid
+    char *conv;  // for text: conversation/thread key (1:1 = other user, group = thread); for chat: thread key
+    char *name;  // display name (sender name, contact name, or group name)
+    char *text;  // message body / error text
+    char *id;    // message id (optional)
+    char *path;     // attachment: the local file
+    char *mimetype; // attachment: its type (optional)
+    time_t timestamp;
+    char msgtype;
+    char isGroup;
+    char isOutgoing;
+    char fatal;
+} gometa_message_t;
+
+// Go -> purple; the C side owns and free()s the strings and handles the message on the glib main thread.
+extern void gometa_process_message(gometa_message_t msg);
+
+// Interactive login prompt (2FA code), asked on the main thread. The answer comes back via the Go
+// export gometa_go_submit_input(account, value).
+extern void gometa_request_input(PurpleAccount *account, const char *prompt);
+
+// Account settings (used to cache the login session). Returned string is malloc'd;
+// the Go caller frees it. Returns NULL if unset.
+extern char *gometa_get_setting(PurpleAccount *account, const char *key);
+extern void gometa_set_setting(PurpleAccount *account, const char *key, const char *value);
+
+// The buddy-list group Facebook contacts and chats are put in.
+extern PurpleGroup *gometa_blist_group(void);

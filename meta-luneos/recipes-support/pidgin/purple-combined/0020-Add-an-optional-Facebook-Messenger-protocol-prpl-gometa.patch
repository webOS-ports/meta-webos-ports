+++ b/gometa_login_test.go
@@ -0,0 +1,50 @@
+//go:build gometa
+
+package main
+
+import (
+	"strings"
+	"testing"
+
+	"go.mau.fi/util/l10n"
+	"maunium.net/go/mautrix/bridgev2"
+)
+
+// gmMFAStep is messagix's 2FA method picker: one select field whose options carry the method as
+// their value and a label that may differ from it.
+func gmMFAStep(values ...string) *bridgev2.LoginStep {
+	options := make([]bridgev2.LoginInputOption, len(values))
+	for i, v := range values {
+		options[i] = bridgev2.LoginInputOption{Value: v, Label: l10n.Unlocalized("Use " + strings.ToLower(v))}
+	}
+	return &bridgev2.LoginStep{
+		Type: bridgev2.LoginStepTypeUserInput,
+		UserInputParams: &bridgev2.LoginUserInputParams{Fields: []bridgev2.LoginInputDataField{{
+			ID: "mfatype", Type: bridgev2.LoginInputFieldTypeSelect, Options: options,
+		}}},
+	}
+}
+
+func TestGometaLoginPicksTheCodeMethodByValue(t *testing.T) {
+	h := &gometaHandler{}
+	credsSent := true
+	out, err := h.fillLoginStep(gmMFAStep("Notification on another device", "Text message", "Authentication app"), "", "", &credsSent)
+	if err != nil {
+		t.Fatalf("fillLoginStep: %v", err)
+	}
+	if got := out["mfatype"]; got != "Authentication app" {
+		t.Fatalf("mfatype = %q, want the authentication app's value", got)
+	}
+}
+
+func TestGometaLoginRefusesWithoutACodeMethod(t *testing.T) {
+	h := &gometaHandler{}
+	credsSent := true
+	_, err := h.fillLoginStep(gmMFAStep("Notification on another device"), "", "", &credsSent)
+	if err == nil {
+		t.Fatal("fillLoginStep accepted a picker with no code method")
+	}
+	if !strings.Contains(err.Error(), "([Notification on another device])") {
+		t.Fatalf("error %q does not name the methods offered", err)
+	}
+}
diff --git a/gometa_media.go b/gometa_media.go
new file mode 100644
index 0000000..dcd4c58
--- /dev/null
+++ b/gometa_media.go
@@ -0,0 +1,443 @@
+//go:build gometa
+
+package main
+
+// Facebook picture/attachment SEND. Plaintext threads: upload to Facebook's Mercury media endpoint
+// and send a MEDIA task referencing the attachment fbid. Encrypted threads: upload+encrypt via
+// whatsmeow and send an armadillo ImageMessage over the E2EE transport. Mirrors mautrix-meta's
+// msgconv (SendMercuryUploadRequest / reuploadMediaToWhatsApp).
+
+/*
+#include <stdlib.h>
+#include "opusreader.h"
+*/
+import "C"
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"image"
+	_ "image/gif"
+	_ "image/jpeg"
+	_ "image/png"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/httpclient"
+	"go.mau.fi/mautrix-meta/pkg/messagix/methods"
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	"go.mau.fi/whatsmeow/proto/waMediaTransport"
+	"go.mau.fi/whatsmeow/proto/waMsgApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+// Send a local file to a thread. Returns "" on success or an error string (freed by the C caller).
+//
+//export gometa_go_send_file
+func gometa_go_send_file(account *PurpleAccount, who *C.char, filename *C.char) *C.char {
+	h, ok := gometaHandlers[account]
+	if !ok {
+		return C.CString("Facebook connection not found")
+	}
+	if err := h.sendFile(C.GoString(who), C.GoString(filename)); err != nil {
+		h.logger.Warn().Err(err).Msg("send file failed")
+		return C.CString(err.Error())
+	}
+	return C.CString("")
+}
+
+func (h *gometaHandler) sendFile(who, filename string) error {
+	threadID, err := strconv.ParseInt(who, 10, 64)
+	if err != nil {
+		return fmt.Errorf("invalid recipient %q", who)
+	}
+	if h.client == nil {
+		return fmt.Errorf("Facebook not connected")
+	}
+	data, err := os.ReadFile(filename)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", filename, err)
+	}
+	mime := http.DetectContentType(data)
+	isImage := strings.HasPrefix(mime, "image/")
+	// The transport transcodes recorded voice notes to Ogg/Opus; http.DetectContentType reports those
+	// as "application/ogg". Treat any ogg/audio as a voice note.
+	isAudio := mime == "application/ogg" || strings.HasPrefix(mime, "audio/")
+	isVideo := strings.HasPrefix(mime, "video/")
+
+	h.mu.Lock()
+	isE2EE := h.e2eeContacts[threadID]
+	h.mu.Unlock()
+	if isE2EE {
+		if h.e2ee == nil {
+			return fmt.Errorf("encrypted thread and E2EE isn't connected yet")
+		}
+		if isImage {
+			return h.sendImageE2EE(threadID, data, mime)
+		}
+		if isAudio {
+			return h.sendAudioE2EE(threadID, data)
+		}
+		if isVideo {
+			return h.sendVideoE2EE(threadID, data, mime)
+		}
+		// Anything else (pdf/docx/xlsx/zip/...) goes as an armadillo DocumentMessage.
+		return h.sendDocumentE2EE(threadID, data, filepath.Base(filename), mime)
+	}
+	return h.sendMediaPlaintext(threadID, data, filepath.Base(filename), mime)
+}
+
+// sendMediaPlaintext uploads to Facebook and sends a MEDIA task. If Facebook doesn't confirm the
+// send (the E2EE-thread rejection), it auto-retries the image over the encrypted transport.
+func (h *gometaHandler) sendMediaPlaintext(threadID int64, data []byte, filename, mime string) error {
+	ctx, cancel := context.WithTimeout(h.ctx, 120*time.Second)
+	defer cancel()
+	if err := h.client.WaitUntilCanSendMessages(ctx, 20*time.Second); err != nil {
+		return err
+	}
+	resp, err := h.client.GetHTTP().SendMercuryUploadRequest(ctx, threadID, &httpclient.MercuryUploadMedia{
+		Filename:  filename,
+		MimeType:  mime,
+		MediaData: data,
+	})
+	if err != nil {
+		return fmt.Errorf("upload: %w", err)
+	}
+	attachmentID := resp.Payload.RealMetadata.GetFbId()
+	if attachmentID == 0 {
+		return fmt.Errorf("upload returned no attachment id")
+	}
+	otid := methods.GenerateEpochID()
+	h.mu.Lock()
+	h.sentOtids[otid] = true
+	h.mu.Unlock()
+	task := &socket.SendMessageTask{
+		ThreadId:         threadID,
+		Otid:             otid,
+		Source:           table.MESSENGER_INBOX_IN_THREAD,
+		InitiatingSource: table.FACEBOOK_INBOX,
+		SendType:         table.MEDIA,
+		SyncGroup:        1,
+		AttachmentFBIds:  []int64{attachmentID},
+	}
+	sendResp, err := h.client.ExecuteTasks(ctx, task)
+	if err != nil {
+		return err
+	}
+	otidStr := strconv.FormatInt(otid, 10)
+	if sendResp != nil {
+		for _, r := range sendResp.LSReplaceOptimsiticMessage {
+			if r.OfflineThreadingId == otidStr {
+				h.logger.Info().Int64("thread", threadID).Msg("media sent")
+				return nil
+			}
+		}
+	}
+	// Not confirmed — likely an encrypted thread. Retry the media over E2EE and remember it.
+	h.mu.Lock()
+	delete(h.sentOtids, otid)
+	h.mu.Unlock()
+	isImg := strings.HasPrefix(mime, "image/")
+	isAud := mime == "application/ogg" || strings.HasPrefix(mime, "audio/")
+	isVid := strings.HasPrefix(mime, "video/")
+	if h.e2ee != nil {
+		h.mu.Lock()
+		h.e2eeContacts[threadID] = true
+		h.mu.Unlock()
+		h.logger.Warn().Int64("thread", threadID).Msg("media send not confirmed; retrying over E2EE")
+		if isAud {
+			return h.sendAudioE2EE(threadID, data)
+		}
+		if isVid {
+			return h.sendVideoE2EE(threadID, data, mime)
+		}
+		if isImg {
+			return h.sendImageE2EE(threadID, data, mime)
+		}
+		return h.sendDocumentE2EE(threadID, data, filename, mime)
+	}
+	return fmt.Errorf("send not confirmed (thread may be encrypted)")
+}
+
+// sendImageE2EE uploads+encrypts an image via whatsmeow and sends it over the E2EE transport.
+func (h *gometaHandler) sendImageE2EE(threadID int64, data []byte, mime string) error {
+	ctx, cancel := context.WithTimeout(h.ctx, 120*time.Second)
+	defer cancel()
+	uploaded, err := h.e2ee.Upload(ctx, data, whatsmeow.MediaImage)
+	if err != nil {
+		return fmt.Errorf("e2ee upload: %w", err)
+	}
+	w, ht := imageDims(data)
+	mediaTransport := &waMediaTransport.WAMediaTransport{
+		Integral: &waMediaTransport.WAMediaTransport_Integral{
+			FileSHA256:        uploaded.FileSHA256,
+			MediaKey:          uploaded.MediaKey,
+			FileEncSHA256:     uploaded.FileEncSHA256,
+			DirectPath:        &uploaded.DirectPath,
+			MediaKeyTimestamp: proto.Int64(time.Now().Unix()),
+		},
+		Ancillary: &waMediaTransport.WAMediaTransport_Ancillary{
+			FileLength: proto.Uint64(uint64(len(data))),
+			Mimetype:   &mime,
+			// Messenger iOS/Android refuse to render media without a thumbnail w/h.
+			Thumbnail: &waMediaTransport.WAMediaTransport_Ancillary_Thumbnail{
+				ThumbnailWidth:  proto.Uint32(uint32(w)),
+				ThumbnailHeight: proto.Uint32(uint32(ht)),
+			},
+			ObjectID: &uploaded.ObjectID,
+		},
+	}
+	imageMsg := &waConsumerApplication.ConsumerApplication_ImageMessage{}
+	if err := imageMsg.Set(&waMediaTransport.ImageTransport{
+		Integral: &waMediaTransport.ImageTransport_Integral{Transport: mediaTransport},
+		Ancillary: &waMediaTransport.ImageTransport_Ancillary{
+			Height: proto.Uint32(uint32(ht)),
+			Width:  proto.Uint32(uint32(w)),
+		},
+	}); err != nil {
+		return fmt.Errorf("build image message: %w", err)
+	}
+	msg := &waConsumerApplication.ConsumerApplication{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_Content{
+				Content: &waConsumerApplication.ConsumerApplication_Content{
+					Content: &waConsumerApplication.ConsumerApplication_Content_ImageMessage{ImageMessage: imageMsg},
+				},
+			},
+		},
+	}
+	otid := methods.GenerateEpochID()
+	otidStr := strconv.FormatInt(otid, 10)
+	h.mu.Lock()
+	h.sentOtids[otid] = true
+	// Record this as our own message so a later reaction over E2EE builds a FromMe=true MessageKey
+	// (mirrors sendE2EE for text).
+	h.e2eeMsgMeta[otidStr] = e2eeMsgInfo{fromMe: true, sender: strconv.FormatInt(h.selfID, 10)}
+	h.mu.Unlock()
+	to := waTypes.JID{User: strconv.FormatInt(threadID, 10), Server: waTypes.MessengerServer}
+	if _, err := h.e2ee.SendFBMessage(ctx, to, msg, &waMsgApplication.MessageApplication_Metadata{},
+		whatsmeow.SendRequestExtra{ID: waTypes.MessageID(otidStr)}); err != nil {
+		return fmt.Errorf("e2ee image send: %w", err)
+	}
+	h.logger.Info().Int64("thread", threadID).Msg("e2ee image sent")
+	return nil
+}
+
+// sendVideoE2EE uploads+encrypts a video via whatsmeow and sends it as an armadillo VideoMessage
+// over the E2EE transport. Mirrors sendImageE2EE; dimensions/duration come from the mp4 boxes so
+// Messenger clients render (and can scrub) the video instead of showing a broken tile.
+func (h *gometaHandler) sendVideoE2EE(threadID int64, data []byte, mime string) error {
+	ctx, cancel := context.WithTimeout(h.ctx, 120*time.Second)
+	defer cancel()
+	uploaded, err := h.e2ee.Upload(ctx, data, whatsmeow.MediaVideo)
+	if err != nil {
+		return fmt.Errorf("e2ee video upload: %w", err)
+	}
+	w, ht, secs := videoInfoMP4(data)
+	if w == 0 || ht == 0 {
+		// Messenger refuses media without non-zero dimensions; fall back to a 4:3 default.
+		w, ht = 640, 480
+	}
+	mediaTransport := &waMediaTransport.WAMediaTransport{
+		Integral: &waMediaTransport.WAMediaTransport_Integral{
+			FileSHA256:        uploaded.FileSHA256,
+			MediaKey:          uploaded.MediaKey,
+			FileEncSHA256:     uploaded.FileEncSHA256,
+			DirectPath:        &uploaded.DirectPath,
+			MediaKeyTimestamp: proto.Int64(time.Now().Unix()),
+		},
+		Ancillary: &waMediaTransport.WAMediaTransport_Ancillary{
+			FileLength: proto.Uint64(uint64(len(data))),
+			Mimetype:   &mime,
+			Thumbnail: &waMediaTransport.WAMediaTransport_Ancillary_Thumbnail{
+				ThumbnailWidth:  proto.Uint32(w),
+				ThumbnailHeight: proto.Uint32(ht),
+			},
+			ObjectID: &uploaded.ObjectID,
+		},
+	}
+	videoMsg := &waConsumerApplication.ConsumerApplication_VideoMessage{}
+	if err := videoMsg.Set(&waMediaTransport.VideoTransport{
+		Integral: &waMediaTransport.VideoTransport_Integral{Transport: mediaTransport},
+		Ancillary: &waMediaTransport.VideoTransport_Ancillary{
+			Height:      proto.Uint32(ht),
+			Width:       proto.Uint32(w),
+			Seconds:     proto.Uint32(secs),
+			GifPlayback: proto.Bool(false), // a real video, not a looping GIF
+		},
+	}); err != nil {
+		return fmt.Errorf("build video message: %w", err)
+	}
+	msg := &waConsumerApplication.ConsumerApplication{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_Content{
+				Content: &waConsumerApplication.ConsumerApplication_Content{
+					Content: &waConsumerApplication.ConsumerApplication_Content_VideoMessage{VideoMessage: videoMsg},
+				},
+			},
+		},
+	}
+	otid := methods.GenerateEpochID()
+	otidStr := strconv.FormatInt(otid, 10)
+	h.mu.Lock()
+	h.sentOtids[otid] = true
+	h.e2eeMsgMeta[otidStr] = e2eeMsgInfo{fromMe: true, sender: strconv.FormatInt(h.selfID, 10)}
+	h.mu.Unlock()
+	to := waTypes.JID{User: strconv.FormatInt(threadID, 10), Server: waTypes.MessengerServer}
+	if _, err := h.e2ee.SendFBMessage(ctx, to, msg, &waMsgApplication.MessageApplication_Metadata{},
+		whatsmeow.SendRequestExtra{ID: waTypes.MessageID(otidStr)}); err != nil {
+		return fmt.Errorf("e2ee video send: %w", err)
+	}
+	h.logger.Info().Int64("thread", threadID).Uint32("seconds", secs).Msg("e2ee video sent")
+	return nil
+}
+
+// sendDocumentE2EE uploads+encrypts a file via whatsmeow and sends it as an armadillo DocumentMessage
+// over the E2EE transport. Mirrors sendImageE2EE; the original filename rides on the DocumentMessage so
+// Messenger shows it (mirrors mautrix-meta's MsgFile path).
+func (h *gometaHandler) sendDocumentE2EE(threadID int64, data []byte, filename, mime string) error {
+	ctx, cancel := context.WithTimeout(h.ctx, 120*time.Second)
+	defer cancel()
+	uploaded, err := h.e2ee.Upload(ctx, data, whatsmeow.MediaDocument)
+	if err != nil {
+		return fmt.Errorf("e2ee document upload: %w", err)
+	}
+	mediaTransport := &waMediaTransport.WAMediaTransport{
+		Integral: &waMediaTransport.WAMediaTransport_Integral{
+			FileSHA256:        uploaded.FileSHA256,
+			MediaKey:          uploaded.MediaKey,
+			FileEncSHA256:     uploaded.FileEncSHA256,
+			DirectPath:        &uploaded.DirectPath,
+			MediaKeyTimestamp: proto.Int64(time.Now().Unix()),
+		},
+		Ancillary: &waMediaTransport.WAMediaTransport_Ancillary{
+			FileLength: proto.Uint64(uint64(len(data))),
+			Mimetype:   &mime,
+			ObjectID:   &uploaded.ObjectID,
+		},
+	}
+	docMsg := &waConsumerApplication.ConsumerApplication_DocumentMessage{FileName: &filename}
+	if err := docMsg.Set(&waMediaTransport.DocumentTransport{
+		Integral:  &waMediaTransport.DocumentTransport_Integral{Transport: mediaTransport},
+		Ancillary: &waMediaTransport.DocumentTransport_Ancillary{},
+	}); err != nil {
+		return fmt.Errorf("build document message: %w", err)
+	}
+	msg := &waConsumerApplication.ConsumerApplication{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_Content{
+				Content: &waConsumerApplication.ConsumerApplication_Content{
+					Content: &waConsumerApplication.ConsumerApplication_Content_DocumentMessage{DocumentMessage: docMsg},
+				},
+			},
+		},
+	}
+	otid := methods.GenerateEpochID()
+	otidStr := strconv.FormatInt(otid, 10)
+	h.mu.Lock()
+	h.sentOtids[otid] = true
+	h.e2eeMsgMeta[otidStr] = e2eeMsgInfo{fromMe: true, sender: strconv.FormatInt(h.selfID, 10)}
+	h.mu.Unlock()
+	to := waTypes.JID{User: strconv.FormatInt(threadID, 10), Server: waTypes.MessengerServer}
+	if _, err := h.e2ee.SendFBMessage(ctx, to, msg, &waMsgApplication.MessageApplication_Metadata{},
+		whatsmeow.SendRequestExtra{ID: waTypes.MessageID(otidStr)}); err != nil {
+		return fmt.Errorf("e2ee document send: %w", err)
+	}
+	h.logger.Info().Int64("thread", threadID).Str("filename", filename).Msg("e2ee document sent")
+	return nil
+}
+
+// sendAudioE2EE uploads+encrypts an Ogg/Opus voice note via whatsmeow and sends it as a PTT audio
+// message over the E2EE transport (armadillo AudioTransport, OPUS format). Mirrors sendImageE2EE.
+func (h *gometaHandler) sendAudioE2EE(threadID int64, data []byte) error {
+	ctx, cancel := context.WithTimeout(h.ctx, 120*time.Second)
+	defer cancel()
+
+	// Duration + waveform from the Opus stream (same reader WhatsApp uses in send_file.go).
+	cdata := C.CBytes(data)
+	info := C.opusfile_get_info(cdata, C.size_t(len(data)))
+	C.free(cdata)
+	seconds := int64(info.length_seconds)
+	if seconds < 0 {
+		return fmt.Errorf("invalid ogg/opus voice note")
+	}
+	waveform := make([]byte, C.WAVEFORM_SAMPLES_COUNT)
+	for i := range info.waveform {
+		waveform[i] = byte(info.waveform[i])
+	}
+
+	uploaded, err := h.e2ee.Upload(ctx, data, whatsmeow.MediaAudio)
+	if err != nil {
+		return fmt.Errorf("e2ee audio upload: %w", err)
+	}
+	mime := "audio/ogg; codecs=opus"
+	opusFmt := waMediaTransport.AudioTransport_Integral_OPUS
+	mediaTransport := &waMediaTransport.WAMediaTransport{
+		Integral: &waMediaTransport.WAMediaTransport_Integral{
+			FileSHA256:        uploaded.FileSHA256,
+			MediaKey:          uploaded.MediaKey,
+			FileEncSHA256:     uploaded.FileEncSHA256,
+			DirectPath:        &uploaded.DirectPath,
+			MediaKeyTimestamp: proto.Int64(time.Now().Unix()),
+		},
+		Ancillary: &waMediaTransport.WAMediaTransport_Ancillary{
+			FileLength: proto.Uint64(uint64(len(data))),
+			Mimetype:   &mime,
+			ObjectID:   &uploaded.ObjectID,
+		},
+	}
+	audioMsg := &waConsumerApplication.ConsumerApplication_AudioMessage{PTT: proto.Bool(true)}
+	if err := audioMsg.Set(&waMediaTransport.AudioTransport{
+		Integral: &waMediaTransport.AudioTransport_Integral{
+			Transport:   mediaTransport,
+			AudioFormat: &opusFmt,
+		},
+		Ancillary: &waMediaTransport.AudioTransport_Ancillary{
+			Seconds:  proto.Uint32(uint32(seconds)),
+			Waveform: waveform,
+		},
+	}); err != nil {
+		return fmt.Errorf("build audio message: %w", err)
+	}
+	msg := &waConsumerApplication.ConsumerApplication{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_Content{
+				Content: &waConsumerApplication.ConsumerApplication_Content{
+					Content: &waConsumerApplication.ConsumerApplication_Content_AudioMessage{AudioMessage: audioMsg},
+				},
+			},
+		},
+	}
+	otid := methods.GenerateEpochID()
+	otidStr := strconv.FormatInt(otid, 10)
+	h.mu.Lock()
+	h.sentOtids[otid] = true
+	h.e2eeMsgMeta[otidStr] = e2eeMsgInfo{fromMe: true, sender: strconv.FormatInt(h.selfID, 10)}
+	h.mu.Unlock()
+	to := waTypes.JID{User: strconv.FormatInt(threadID, 10), Server: waTypes.MessengerServer}
+	if _, err := h.e2ee.SendFBMessage(ctx, to, msg, &waMsgApplication.MessageApplication_Metadata{},
+		whatsmeow.SendRequestExtra{ID: waTypes.MessageID(otidStr)}); err != nil {
+		return fmt.Errorf("e2ee audio send: %w", err)
+	}
+	h.logger.Info().Int64("thread", threadID).Int64("seconds", seconds).Msg("e2ee voice note sent")
+	return nil
+}
+
+// imageDims returns the image dimensions, or 400x400 if they can't be decoded (Messenger requires
+// non-zero width/height on media).
+func imageDims(data []byte) (int, int) {
+	cfg, _, err := image.DecodeConfig(bytes.NewReader(data))
+	if err != nil || cfg.Width == 0 || cfg.Height == 0 {
+		return 400, 400
+	}
+	return cfg.Width, cfg.Height
+}
diff --git a/gometa_presence.go b/gometa_presence.go
new file mode 100644
index 0000000..57a6f5d
--- /dev/null
+++ b/gometa_presence.go
@@ -0,0 +1,304 @@
+//go:build gometa
+
+package main
+
+// Typing, both ways, and read receipts sent, for Facebook. Encrypted chats go over the
+// whatsmeow client, as mautrix-meta's HandleMatrixTyping and HandleMatrixReadReceipt do; plain
+// chats over messagix tasks (UpdatePresenceTask, ThreadMarkReadTask). Typing is for 1:1 chats only:
+// libpurple 2 has no typing state for a group chat.
+//
+// An encrypted chat is read on two networks: the whatsmeow receipt goes to the sender's devices,
+// and Messenger's own apps take a chat's read state from its Facebook ("hybrid") thread, which
+// gets a ThreadMarkReadTask in sync group 95 under its Facebook thread key, as mautrix-meta does
+// since its "mark hybrid threads as read on Lightspeed" (mautrix/meta#474).
+
+/*
+#include "gometabridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+// gometaMaxUnread bounds the encrypted messages kept per chat for its next read receipt.
+const gometaMaxUnread = 50
+
+// gometaUnread is an encrypted message not yet marked read: the receipt names its chat and sender.
+type gometaUnread struct {
+	id           waTypes.MessageID
+	chat, sender waTypes.JID
+}
+
+// gometaParity is the handler's state for typing and receipts, kept by thread key.
+type gometaParity struct {
+	threadType map[int64]table.ThreadType // from the thread rows, for the typing task
+	e2eeChat   map[int64]waTypes.JID      // an encrypted chat's JID, as its messages came from
+	unreadE2EE map[int64][]gometaUnread   // encrypted messages to mark read
+	unreadFB   map[int64]int64            // a plain chat's newest unread message time (ms)
+	// an encrypted chat's newest message time (ms), for its Facebook thread's read state
+	readE2EE map[int64]int64
+	// an encrypted chat's Facebook thread key, by the chat's WhatsApp-side id, where they differ
+	// (LSVerifyHybridThreadExists, LSUpdateThreadAuthorityAndMappingWithOTIDFromJID)
+	hybridKey map[int64]int64
+}
+
+// gometaHybridSyncGroup is the sync group of an encrypted chat's Facebook thread (mautrix-meta
+// marks such a thread read, accepts and deletes it there).
+const gometaHybridSyncGroup = 95
+
+func (h *gometaHandler) initParity() {
+	h.parity = gometaParity{
+		threadType: make(map[int64]table.ThreadType),
+		e2eeChat:   make(map[int64]waTypes.JID),
+		unreadE2EE: make(map[int64][]gometaUnread),
+		unreadFB:   make(map[int64]int64),
+		readE2EE:   make(map[int64]int64),
+		hybridKey:  make(map[int64]int64),
+	}
+}
+
+//export gometa_go_send_typing
+func gometa_go_send_typing(account *PurpleAccount, who *C.char, typing C.int) {
+	if h, ok := gometaHandlers[account]; ok {
+		go h.sendTyping(C.GoString(who), typing != 0)
+	}
+}
+
+// The UI has shown this chat (a thread key), so what came in it has been read. Raised through
+// libpurple's "conversation-updated" (glue/gometa_init.c).
+//
+//export gometa_go_mark_read
+func gometa_go_mark_read(account *PurpleAccount, who *C.char) {
+	if h, ok := gometaHandlers[account]; ok {
+		go h.markRead(C.GoString(who))
+	}
+}
+
+// e2eeJID is the JID an encrypted chat is reached at: the one its messages came from, else a 1:1
+// Messenger chat's.
+func (h *gometaHandler) e2eeJID(threadKey int64) waTypes.JID {
+	h.mu.Lock()
+	jid, ok := h.parity.e2eeChat[threadKey]
+	h.mu.Unlock()
+	if ok {
+		return jid
+	}
+	return waTypes.JID{User: strconv.FormatInt(threadKey, 10), Server: waTypes.MessengerServer}
+}
+
+// sendTyping tells a chat we are typing (on) or stopped. who is the thread key; anything else
+// (the "Facebook" sign-in chat) is left alone.
+func (h *gometaHandler) sendTyping(who string, on bool) {
+	threadKey, err := strconv.ParseInt(who, 10, 64)
+	if err != nil || threadKey == 0 {
+		return
+	}
+	h.mu.Lock()
+	isE2EE := h.e2eeContacts[threadKey]
+	isGroup := h.threadGroup[threadKey]
+	threadType := h.parity.threadType[threadKey]
+	h.mu.Unlock()
+	ctx, cancel := context.WithTimeout(h.ctx, 10*time.Second)
+	defer cancel()
+	if isE2EE {
+		err = h.net().chatPresence(ctx, h.e2eeJID(threadKey), on)
+	} else {
+		task := &socket.UpdatePresenceTask{ThreadKey: threadKey, SyncGroup: 1, ThreadType: int64(threadType)}
+		if isGroup {
+			task.IsGroupThread = 1
+		}
+		if threadType == 0 {
+			task.ThreadType = int64(table.ONE_TO_ONE)
+			if isGroup {
+				task.ThreadType = int64(table.GROUP_THREAD)
+			}
+		}
+		if on {
+			task.IsTyping = 1
+		}
+		err = h.net().fbTask(ctx, task, true)
+	}
+	if err != nil {
+		h.logger.Debug().Err(err).Bool("e2ee", isE2EE).Msg("typing not sent")
+	}
+}
+
+// gometaE2EEReadMs is how far an encrypted message's Facebook thread is read once it is: its time in
+// ms, to the end of its second when it has none finer (whatsmeow's come in whole seconds, and the
+// thread's own time for it may be later in that second), as mautrix-meta rounds it.
+func gometaE2EEReadMs(ts time.Time) int64 {
+	if ts.IsZero() {
+		return 0
+	}
+	if ts.Nanosecond() == 0 {
+		ts = ts.Add(999 * time.Millisecond)
+	}
+	return ts.UnixMilli()
+}
+
+// noteHybridThreads keeps which Facebook thread an encrypted chat is, where the keys differ.
+func (h *gometaHandler) noteHybridThreads(tbl *table.LSTable) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.parity.hybridKey == nil {
+		return
+	}
+	for _, m := range tbl.LSVerifyHybridThreadExists {
+		if m.ThreadKey != 0 && m.ThreadJID != 0 {
+			h.parity.hybridKey[m.ThreadJID] = m.ThreadKey
+		}
+	}
+	for _, m := range tbl.LSUpdateThreadAuthorityAndMappingWithOTIDFromJID {
+		if m.ThreadKey != 0 && m.ThreadJID != 0 {
+			h.parity.hybridKey[m.ThreadJID] = m.ThreadKey
+		}
+	}
+}
+
+// fbThreadOfE2EE is the Facebook thread key of an encrypted chat: the one Facebook named for it,
+// else, for a 1:1 chat, the chat's own (a 1:1 thread's key is the partner's fbid on both sides).
+// 0 for an encrypted group Facebook named none for.
+func (h *gometaHandler) fbThreadOfE2EE(threadKey int64, chat waTypes.JID) int64 {
+	h.mu.Lock()
+	key, ok := h.parity.hybridKey[threadKey]
+	h.mu.Unlock()
+	if ok {
+		return key
+	}
+	if chat.Server == waTypes.GroupServer {
+		return 0
+	}
+	return threadKey
+}
+
+// noteUnreadE2EE keeps a received encrypted message for the chat's next read receipt: the
+// message itself when someone else sent it, and its time for the Facebook thread either way (one
+// of ours from another device was read there too).
+func (h *gometaHandler) noteUnreadE2EE(threadKey int64, info waTypes.MessageInfo) {
+	if threadKey == 0 || info.ID == "" {
+		return
+	}
+	h.mu.Lock()
+	h.parity.e2eeChat[threadKey] = info.Chat.ToNonAD()
+	if ms := gometaE2EEReadMs(info.Timestamp); ms > h.parity.readE2EE[threadKey] {
+		h.parity.readE2EE[threadKey] = ms
+	}
+	if info.IsFromMe {
+		h.mu.Unlock()
+		return
+	}
+	list := append(h.parity.unreadE2EE[threadKey], gometaUnread{id: info.ID, chat: info.Chat.ToNonAD(), sender: info.Sender.ToNonAD()})
+	if len(list) > gometaMaxUnread {
+		list = list[len(list)-gometaMaxUnread:]
+	}
+	h.parity.unreadE2EE[threadKey] = list
+	h.mu.Unlock()
+}
+
+// noteUnreadFB keeps a received plain message's time for the chat's next read receipt.
+func (h *gometaHandler) noteUnreadFB(threadKey, tsMs int64) {
+	if threadKey == 0 || tsMs == 0 {
+		return
+	}
+	h.mu.Lock()
+	if tsMs > h.parity.unreadFB[threadKey] {
+		h.parity.unreadFB[threadKey] = tsMs
+	}
+	h.mu.Unlock()
+}
+
+// markRead sends read receipts for what came in a chat since its last ones: in an encrypted chat
+// for each message, one receipt per sender (a group's receipt names its sender); in a plain chat
+// one up to the newest message's time, as mautrix-meta's HandleMatrixReadReceipt does.
+func (h *gometaHandler) markRead(who string) {
+	threadKey, err := strconv.ParseInt(who, 10, 64)
+	if err != nil || threadKey == 0 {
+		return
+	}
+	h.mu.Lock()
+	unread := h.parity.unreadE2EE[threadKey]
+	delete(h.parity.unreadE2EE, threadKey)
+	watermark := h.parity.unreadFB[threadKey]
+	delete(h.parity.unreadFB, threadKey)
+	e2eeWatermark := h.parity.readE2EE[threadKey]
+	delete(h.parity.readE2EE, threadKey)
+	h.mu.Unlock()
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	type key struct{ chat, sender waTypes.JID }
+	var order []key
+	bySender := make(map[key][]waTypes.MessageID)
+	for _, u := range unread {
+		k := key{u.chat, u.sender}
+		if _, seen := bySender[k]; !seen {
+			order = append(order, k)
+		}
+		bySender[k] = append(bySender[k], u.id)
+	}
+	for _, k := range order {
+		if err := h.net().markRead(ctx, bySender[k], time.Now(), k.chat, k.sender); err != nil {
+			h.logger.Debug().Err(err).Msg("encrypted read receipt not sent")
+		}
+	}
+	if watermark != 0 {
+		task := &socket.ThreadMarkReadTask{ThreadId: threadKey, LastReadWatermarkTs: watermark, SyncGroup: 1}
+		if err := h.net().fbTask(ctx, task, false); err != nil {
+			h.logger.Debug().Err(err).Msg("read receipt not sent")
+		}
+	}
+	// The encrypted chat's Facebook thread, read up to its newest message.
+	if e2eeWatermark != 0 {
+		fbKey := h.fbThreadOfE2EE(threadKey, h.e2eeJID(threadKey))
+		if fbKey == 0 {
+			return
+		}
+		task := &socket.ThreadMarkReadTask{ThreadId: fbKey, LastReadWatermarkTs: e2eeWatermark, SyncGroup: gometaHybridSyncGroup}
+		if err := h.net().fbTask(ctx, task, false); err != nil {
+			h.logger.Debug().Err(err).Msg("encrypted chat's Facebook thread not marked read")
+		}
+	}
+}
+
+// handleTypingTable shows a plain 1:1 chat's partner typing (LSUpdateTypingIndicator).
+func (h *gometaHandler) handleTypingTable(rows []*table.LSUpdateTypingIndicator) {
+	for _, t := range rows {
+		if t.ThreadKey == 0 || t.SenderId == h.selfID {
+			continue
+		}
+		h.mu.Lock()
+		isGroup := h.threadGroup[t.ThreadKey]
+		h.mu.Unlock()
+		if isGroup {
+			continue
+		}
+		h.out().typing(strconv.FormatInt(t.ThreadKey, 10), t.IsTyping)
+	}
+}
+
+// handleChatPresence shows an encrypted 1:1 chat's partner typing.
+func (h *gometaHandler) handleChatPresence(evt *events.ChatPresence) {
+	if evt.IsFromMe || evt.Chat.Server != waTypes.MessengerServer || evt.Chat.User == "" {
+		return
+	}
+	h.out().typing(evt.Chat.User, evt.State == waTypes.ChatPresenceComposing)
+}
+
+// announceAvailable marks us online on the encrypted transport once it is connected: WhatsApp,
+// which carries Facebook's encrypted chats, sends typing only to a user who is online (as
+// mautrix-meta notes in HandleMatrixViewingChat).
+func (h *gometaHandler) announceAvailable(e2ee *whatsmeow.Client) {
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	if err := e2ee.SendPresence(ctx, waTypes.PresenceAvailable); err != nil {
+		h.logger.Debug().Err(err).Msg("E2EE presence not sent")
+	}
+}
diff --git a/gometa_presence_test.go b/gometa_presence_test.go
new file mode 100644
index 0000000..cdaf98f
--- /dev/null
+++ b/gometa_presence_test.go
@@ -0,0 +1,192 @@
+//go:build gometa
+
+package main
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func gmText(text string) *waConsumerApplication.ConsumerApplication_Content {
+	return &waConsumerApplication.ConsumerApplication_Content{Content: &waConsumerApplication.ConsumerApplication_Content_MessageText{
+		MessageText: &waCommon.MessageText{Text: proto.String(text)}}}
+}
+
+// ---- typing sent ----
+
+func TestGometaTypingInAnEncryptedChatGoesAsChatPresence(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendTyping(itoa(gmPeer), true)
+	h.sendTyping(itoa(gmPeer), false)
+	want := []gmPresence{{gmJID(gmPeer), true}, {gmJID(gmPeer), false}}
+	if !reflect.DeepEqual(r.presences, want) || len(r.tasks) != 0 {
+		t.Errorf("presences %+v tasks %+v, want %+v", r.presences, r.tasks, want)
+	}
+}
+
+func TestGometaTypingInAPlainChatIsAPresenceTask(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSDeleteThenInsertThread: []*table.LSDeleteThenInsertThread{{ThreadKey: gmPeer, ThreadType: table.ONE_TO_ONE}}})
+	h.sendTyping(itoa(gmPeer), true)
+	h.sendTyping(itoa(gmPeer), false)
+	if len(r.tasks) != 2 || len(r.presences) != 0 {
+		t.Fatalf("tasks %+v presences %+v", r.tasks, r.presences)
+	}
+	on, off := r.tasks[0], r.tasks[1]
+	want := &socket.UpdatePresenceTask{ThreadKey: gmPeer, IsTyping: 1, SyncGroup: 1, ThreadType: int64(table.ONE_TO_ONE)}
+	if !reflect.DeepEqual(on.task, want) || !on.stateless {
+		t.Errorf("typing: got %+v (stateless %v), want %+v", on.task, on.stateless, want)
+	}
+	if off.task.(*socket.UpdatePresenceTask).IsTyping != 0 {
+		t.Errorf("stopped: got %+v", off.task)
+	}
+}
+
+func TestGometaTypingIgnoresTheSignInChat(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendTyping("Facebook", true)
+	if len(r.tasks)+len(r.presences) != 0 {
+		t.Errorf("sent %+v %+v", r.tasks, r.presences)
+	}
+}
+
+// ---- typing received ----
+
+func TestGometaTypingFromAPlainChat(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	h.parseTable(&table.LSTable{LSUpdateTypingIndicator: []*table.LSUpdateTypingIndicator{
+		{ThreadKey: gmPeer, SenderId: gmPeer, IsTyping: true},
+		{ThreadKey: gmPeer, SenderId: gmSelf, IsTyping: true}, // ours, from another device
+		{ThreadKey: gmGroup, SenderId: gmPeer2, IsTyping: true},
+		{ThreadKey: gmPeer, SenderId: gmPeer, IsTyping: false},
+	}})
+	want := []gmTyping{{itoa(gmPeer), true}, {itoa(gmPeer), false}}
+	if !reflect.DeepEqual(r.typings, want) {
+		t.Errorf("got %+v, want %+v", r.typings, want)
+	}
+}
+
+func TestGometaTypingFromAnEncryptedChat(t *testing.T) {
+	h, r := newTestGometa(t)
+	src := waTypes.MessageSource{Chat: gmJID(gmPeer), Sender: gmJID(gmPeer)}
+	h.e2eeEventHandler(&events.ChatPresence{MessageSource: src, State: waTypes.ChatPresenceComposing})
+	h.e2eeEventHandler(&events.ChatPresence{MessageSource: src, State: waTypes.ChatPresencePaused})
+	group := waTypes.MessageSource{Chat: waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}, Sender: gmJID(gmPeer2), IsGroup: true}
+	h.e2eeEventHandler(&events.ChatPresence{MessageSource: group, State: waTypes.ChatPresenceComposing})
+	want := []gmTyping{{itoa(gmPeer), true}, {itoa(gmPeer), false}}
+	if !reflect.DeepEqual(r.typings, want) {
+		t.Errorf("got %+v, want %+v", r.typings, want)
+	}
+}
+
+// ---- read receipts sent ----
+
+func TestGometaShownEncryptedChatIsMarkedRead(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8001", gmText("one")))
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8002", gmText("two")))
+	h.markRead(itoa(gmPeer))
+	want := []gmMarkRead{{[]waTypes.MessageID{"8001", "8002"}, gmJID(gmPeer), gmJID(gmPeer)}}
+	if !reflect.DeepEqual(r.markReads, want) {
+		t.Fatalf("got %+v, want %+v", r.markReads, want)
+	}
+	// Messenger's apps read the chat's Facebook thread: a 1:1 one is under the partner's fbid.
+	wantTask := &socket.ThreadMarkReadTask{ThreadId: gmPeer, LastReadWatermarkTs: 1700000000999, SyncGroup: 95}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, wantTask) || r.tasks[0].stateless {
+		t.Fatalf("Facebook thread: got %+v, want %+v", r.tasks, wantTask)
+	}
+	h.markRead(itoa(gmPeer)) // nothing new: no second receipt
+	if len(r.markReads) != 1 || len(r.tasks) != 1 {
+		t.Errorf("again: %+v %+v", r.markReads, r.tasks)
+	}
+}
+
+func TestGometaEncryptedChatReadsTheFacebookThreadFacebookNamed(t *testing.T) {
+	h, r := newTestGometa(t)
+	const fbKey = int64(7000000000000007)
+	h.parseTable(&table.LSTable{LSVerifyHybridThreadExists: []*table.LSVerifyHybridThreadExists{
+		{ThreadKey: fbKey, ThreadJID: gmPeer, ThreadType: table.ENCRYPTED_OVER_WA_ONE_TO_ONE}}})
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8101", gmText("one")))
+	h.markRead(itoa(gmPeer))
+	want := &socket.ThreadMarkReadTask{ThreadId: fbKey, LastReadWatermarkTs: 1700000000999, SyncGroup: 95}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) {
+		t.Errorf("got %+v, want %+v", r.tasks, want)
+	}
+	// Facebook's other name for the mapping gives the same.
+	h2, r2 := newTestGometa(t)
+	h2.parseTable(&table.LSTable{LSUpdateThreadAuthorityAndMappingWithOTIDFromJID: []*table.LSUpdateThreadAuthorityAndMappingWithOTIDFromJID{
+		{ThreadJID: gmPeer, ThreadKey: fbKey}}})
+	h2.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8102", gmText("two")))
+	h2.markRead(itoa(gmPeer))
+	if len(r2.tasks) != 1 || r2.tasks[0].task.(*socket.ThreadMarkReadTask).ThreadId != fbKey {
+		t.Errorf("authority mapping: got %+v", r2.tasks)
+	}
+}
+
+func TestGometaOwnEncryptedMessageReadsOnlyTheFacebookThread(t *testing.T) {
+	h, r := newTestGometa(t)
+	mine := gmFBMessage(gmJID(gmPeer), gmJID(gmSelf), "8201", gmText("from my phone"))
+	mine.Info.IsFromMe = true
+	mine.Info.Timestamp = time.Unix(1700000100, 250*int64(time.Millisecond))
+	h.handleE2EEMessage(mine)
+	h.markRead(itoa(gmPeer))
+	if len(r.markReads) != 0 {
+		t.Errorf("a receipt for our own message: %+v", r.markReads)
+	}
+	want := &socket.ThreadMarkReadTask{ThreadId: gmPeer, LastReadWatermarkTs: 1700000100250, SyncGroup: 95}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) {
+		t.Errorf("got %+v, want %+v", r.tasks, want)
+	}
+}
+
+func TestGometaEncryptedGroupReceiptsGoPerSender(t *testing.T) {
+	h, r := newTestGometa(t)
+	group := waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "9001", gmText("a")))
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer2), "9002", gmText("b")))
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "9003", gmText("c")))
+	h.markRead(itoa(gmGroup))
+	want := []gmMarkRead{
+		{[]waTypes.MessageID{"9001", "9003"}, group, gmJID(gmPeer)},
+		{[]waTypes.MessageID{"9002"}, group, gmJID(gmPeer2)},
+	}
+	if !reflect.DeepEqual(r.markReads, want) {
+		t.Errorf("got %+v, want %+v", r.markReads, want)
+	}
+	// Facebook named no thread for the group: none is guessed.
+	if len(r.tasks) != 0 {
+		t.Errorf("a Facebook thread guessed for an encrypted group: %+v", r.tasks)
+	}
+}
+
+func TestGometaShownPlainChatIsMarkedRead(t *testing.T) {
+	h, r := newTestGometa(t)
+	older, newer := gmInsert("mid.a", "a", gmPeer), gmInsert("mid.b", "b", gmPeer)
+	newer.TimestampMs = older.TimestampMs + 5000
+	mine := gmInsert("mid.c", "c", gmSelf) // ours from another device: not a reason for a receipt
+	mine.TimestampMs = older.TimestampMs + 9000
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{newer, older, mine}})
+	h.markRead(itoa(gmPeer))
+	want := &socket.ThreadMarkReadTask{ThreadId: gmPeer, LastReadWatermarkTs: newer.TimestampMs, SyncGroup: 1}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) || r.tasks[0].stateless {
+		t.Fatalf("got %+v, want %+v", r.tasks, want)
+	}
+	if len(r.markReads) != 0 {
+		t.Errorf("encrypted receipts for a plain chat: %+v", r.markReads)
+	}
+	h.markRead(itoa(gmPeer))
+	if len(r.tasks) != 1 {
+		t.Errorf("a second receipt with nothing new: %+v", r.tasks)
+	}
+}
diff --git a/gometa_receive.go b/gometa_receive.go
new file mode 100644
index 0000000..d3d5182
--- /dev/null
+++ b/gometa_receive.go
@@ -0,0 +1,375 @@
+//go:build gometa
+
+package main
+
+// What a received Facebook message shows besides plain text: pictures, files, stickers, locations
+// and link previews, in encrypted chats (the whatsmeow client) and plain ones (messagix tables).
+// A file is downloaded when it comes and kept under the purple user directory
+// (gometa_attachment.go); a location is shown as the WhatsApp protocol shows one (format_location).
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"net/url"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waArmadilloXMA"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	"go.mau.fi/whatsmeow/proto/waMediaTransport"
+)
+
+// ---- encrypted chats ----
+
+// gometaE2EEText is the text an encrypted message's content shows, "" for one with none (media,
+// reactions, edits). An ExtendedTextMessage is a text with a link preview: its title and
+// description go above the text, as WhatsApp's link previews do (handle_message.go).
+func gometaE2EEText(content *waConsumerApplication.ConsumerApplication_Content) string {
+	if mt := content.GetMessageText(); mt != nil {
+		return mt.GetText()
+	}
+	if etm := content.GetExtendedTextMessage(); etm != nil {
+		var lines []string
+		for _, s := range []string{etm.GetTitle(), etm.GetDescription(), etm.GetText().GetText()} {
+			if s = strings.TrimSpace(s); s != "" {
+				lines = append(lines, s)
+			}
+		}
+		return strings.Join(lines, "\n")
+	}
+	if lm := content.GetLocationMessage(); lm != nil {
+		loc := lm.GetLocation()
+		return gometaLocationText(loc.GetDegreesLatitude(), loc.GetDegreesLongitude(), loc.GetName(), lm.GetAddress(), false)
+	}
+	if llm := content.GetLiveLocationMessage(); llm != nil {
+		loc := llm.GetLocation()
+		return gometaLocationText(loc.GetDegreesLatitude(), loc.GetDegreesLongitude(), "", "", true)
+	}
+	return ""
+}
+
+// gometaArmadilloText is the text of an encrypted "extended content" message (Armadillo XMA): a
+// shared location (a "messenger://location_share?lat=..&long=.." call to action, which is how
+// mautrix-meta's msgconv reads one) or a shared link.
+func gometaArmadilloText(ecm *waArmadilloXMA.ExtendedContentMessage) string {
+	if ecm == nil {
+		return ""
+	}
+	body := strings.TrimSpace(ecm.GetMessageText())
+	for _, cta := range ecm.GetCtas() {
+		native := cta.GetNativeURL()
+		if lat, lon, ok := gometaGeo(native); ok {
+			return gometaLocationText(lat, lon, ecm.GetTitleText(), ecm.GetSubtitleText(), false)
+		}
+		if strings.HasPrefix(native, "https://") && !strings.Contains(body, native) {
+			if body != "" {
+				body += "\n"
+			}
+			body += native
+		}
+	}
+	if body == "" {
+		body = strings.TrimSpace(ecm.GetTitleText())
+	}
+	return body
+}
+
+// gometaGeo reads a position from what Facebook names one with: "messenger://location_share?
+// lat=..&long=..", "geo:lat,lng", or a bare "lat,lng" (a live location's native URL, which
+// mautrix-meta turns into "geo:" + it).
+func gometaGeo(s string) (lat, lon float64, ok bool) {
+	s = strings.TrimSpace(s)
+	if u, err := url.Parse(s); err == nil && u.Scheme == "messenger" && u.Host == "location_share" {
+		return gometaLatLon(u.Query().Get("lat"), u.Query().Get("long"))
+	}
+	s = strings.TrimPrefix(s, "geo:")
+	if i := strings.IndexAny(s, ";?"); i >= 0 {
+		s = s[:i]
+	}
+	parts := strings.Split(s, ",")
+	if len(parts) != 2 {
+		return 0, 0, false
+	}
+	return gometaLatLon(parts[0], parts[1])
+}
+
+func gometaLatLon(a, b string) (float64, float64, bool) {
+	lat, err1 := strconv.ParseFloat(strings.TrimSpace(a), 64)
+	lon, err2 := strconv.ParseFloat(strings.TrimSpace(b), 64)
+	if err1 != nil || err2 != nil || lat < -90 || lat > 90 || lon < -180 || lon > 180 || (lat == 0 && lon == 0) {
+		return 0, 0, false
+	}
+	return lat, lon, true
+}
+
+// gometaE2EEMedia is an encrypted message's media, as far as it can be known before download.
+type gometaE2EEMedia struct {
+	transport *waMediaTransport.WAMediaTransport
+	mediaType whatsmeow.MediaType
+	mimetype  string
+	filename  string // a document's own name, without its extension
+	extension string
+	caption   string
+	sticker   bool
+}
+
+// gometaE2EEMediaOf finds the media in an encrypted message's content: a picture, video, voice
+// message, file or sticker. A sticker is fetched as an image, as mautrix-meta does, and kept as
+// .webp like a received WhatsApp sticker (sticker_file_type), unless it says it is something else.
+func gometaE2EEMediaOf(content *waConsumerApplication.ConsumerApplication_Content) (gometaE2EEMedia, bool) {
+	var m gometaE2EEMedia
+	if vm := content.GetVideoMessage(); vm != nil {
+		t, err := vm.Decode()
+		if err != nil {
+			return m, false
+		}
+		m.transport, m.mediaType = t.GetIntegral().GetTransport(), whatsmeow.MediaVideo
+		m.caption = vm.GetCaption().GetText()
+		if m.caption == "" {
+			m.caption = t.GetAncillary().GetCaption().GetText()
+		}
+	} else if im := content.GetImageMessage(); im != nil {
+		t, err := im.Decode()
+		if err != nil {
+			return m, false
+		}
+		m.transport, m.mediaType = t.GetIntegral().GetTransport(), whatsmeow.MediaImage
+		m.caption = im.GetCaption().GetText()
+	} else if am := content.GetAudioMessage(); am != nil {
+		t, err := am.Decode()
+		if err != nil {
+			return m, false
+		}
+		m.transport, m.mediaType = t.GetIntegral().GetTransport(), whatsmeow.MediaAudio
+	} else if dm := content.GetDocumentMessage(); dm != nil {
+		t, err := dm.Decode()
+		if err != nil {
+			return m, false
+		}
+		m.transport, m.mediaType = t.GetIntegral().GetTransport(), whatsmeow.MediaDocument
+		m.filename = dm.GetFileName()
+	} else if sm := content.GetStickerMessage(); sm != nil {
+		t, err := sm.Decode()
+		if err != nil {
+			return m, false
+		}
+		m.transport, m.mediaType, m.sticker = t.GetIntegral().GetTransport(), whatsmeow.MediaImage, true
+	} else {
+		return m, false
+	}
+	if m.transport.GetIntegral() == nil {
+		return m, false
+	}
+	m.mimetype = m.transport.GetAncillary().GetMimetype()
+	if m.filename != "" { // a document keeps its real name, shown on the chip
+		m.extension = filepath.Ext(m.filename)
+		m.filename = strings.TrimSuffix(m.filename, m.extension)
+	}
+	if m.sticker {
+		m.extension = gometaStickerExtension(m.mimetype)
+	} else if m.extension == "" {
+		m.extension = extension_from_mimetype(&m.mimetype)
+	}
+	return m, true
+}
+
+// gometaStickerExtension: a sticker is a WebP unless its type says otherwise.
+func gometaStickerExtension(mimetype string) string {
+	if mimetype == "" || mimetype == "image/webp" {
+		return ".webp"
+	}
+	return extension_from_mimetype(&mimetype)
+}
+
+// fileName is the name this media is kept under: its content hash, a document's own name in a
+// folder of that name.
+func (m gometaE2EEMedia) fileName() string {
+	return gometaFileName(hex.EncodeToString(m.transport.GetIntegral().GetFileSHA256()), m.filename, m.extension)
+}
+
+// ---- plain chats ----
+
+// gometaFBAttachment is one attachment of a plain chat's message: a file to fetch from url, or
+// (url "") a text to show, for a shared location or link.
+type gometaFBAttachment struct {
+	url, mime, filename, fbid string
+	sticker                   bool
+	text                      string
+}
+
+// gometaPlainAttachments gathers a table's attachments by the message they belong to, as
+// table.WrapMessages does. WrapMessages itself is not used: it returns an upserted message only
+// when the table also has its thread's message range, and parseTable shows every upsert.
+func gometaPlainAttachments(tbl *table.LSTable) map[string][]gometaFBAttachment {
+	out := make(map[string][]gometaFBAttachment)
+	seen := make(map[string]bool)
+	add := func(msgID string, a gometaFBAttachment) {
+		if msgID == "" || (a.url == "" && a.text == "") {
+			return
+		}
+		// Facebook sometimes sends the same blob row twice (mautrix-meta dedupes by fbid too).
+		if a.fbid != "" {
+			if seen[msgID+"\x00"+a.fbid] {
+				return
+			}
+			seen[msgID+"\x00"+a.fbid] = true
+		}
+		out[msgID] = append(out[msgID], a)
+	}
+	media := func(playable, playableMime, attMime, preview, previewMime string) (string, string) {
+		if playable != "" {
+			if playableMime == "" {
+				playableMime = attMime
+			}
+			return playable, playableMime
+		}
+		return preview, previewMime
+	}
+	for _, b := range tbl.LSInsertBlobAttachment {
+		u, mt := media(b.PlayableUrl, b.PlayableUrlMimeType, b.AttachmentMimeType, b.PreviewUrl, b.PreviewUrlMimeType)
+		add(b.MessageId, gometaFBAttachment{url: u, mime: mt, filename: b.Filename, fbid: b.AttachmentFbid})
+	}
+	for _, a := range tbl.LSInsertAttachment {
+		u, mt := media(a.PlayableUrl, a.PlayableUrlMimeType, a.AttachmentMimeType, a.PreviewUrl, a.PreviewUrlMimeType)
+		add(a.MessageId, gometaFBAttachment{url: u, mime: mt, filename: a.Filename, fbid: a.AttachmentFbid})
+	}
+	for _, s := range tbl.LSInsertStickerAttachment {
+		u, mt := media(s.PlayableUrl, s.PlayableUrlMimeType, "", s.PreviewUrl, s.PreviewUrlMimeType)
+		add(s.MessageId, gometaFBAttachment{url: u, mime: mt, fbid: s.AttachmentFbid, sticker: true})
+	}
+	ctas := make(map[string]*table.LSInsertAttachmentCta, len(tbl.LSInsertAttachmentCta))
+	for _, c := range tbl.LSInsertAttachmentCta {
+		ctas[c.AttachmentFbid] = c
+	}
+	for _, x := range tbl.LSInsertXmaAttachment {
+		add(x.MessageId, gometaXMAAttachment(x, ctas[x.AttachmentFbid]))
+	}
+	return out
+}
+
+// gometaXMAAttachment reads an "extended" attachment: a location when its call to action names a
+// position (a live location's native URL is "lat,lng", as mautrix-meta reads it), else a shared
+// link or post, shown as its title and link.
+func gometaXMAAttachment(x *table.LSInsertXmaAttachment, cta *table.LSInsertAttachmentCta) gometaFBAttachment {
+	a := gometaFBAttachment{fbid: x.AttachmentFbid}
+	if cta != nil {
+		for _, u := range []string{cta.NativeUrl, cta.ActionUrl} {
+			if lat, lon, ok := gometaGeo(u); ok {
+				a.text = gometaLocationText(lat, lon, x.TitleText, x.SubtitleText, strings.Contains(cta.Type_, "live_location"))
+				return a
+			}
+		}
+	}
+	link := x.ActionUrl
+	if cta != nil && cta.ActionUrl != "" {
+		link = cta.ActionUrl
+	}
+	link = gometaRemoveLPHP(link)
+	var lines []string
+	for _, s := range []string{x.TitleText, link} {
+		if s = strings.TrimSpace(s); s != "" {
+			lines = append(lines, s)
+		}
+	}
+	a.text = strings.Join(lines, "\n")
+	return a
+}
+
+// gometaRemoveLPHP unwraps Facebook's link redirector (l.php?u=...), as mautrix-meta does.
+func gometaRemoveLPHP(addr string) string {
+	if u, err := url.Parse(addr); err == nil && u.Path == "/l.php" && u.Query().Get("u") != "" {
+		return u.Query().Get("u")
+	}
+	return addr
+}
+
+// gometaThumbsUpStickers are Facebook's like button, which mautrix-meta shows as a 👍.
+var gometaThumbsUpStickers = map[int64]bool{369239263222822: true, 369239343222814: true, 369239383222810: true}
+
+// fileName is the name a plain chat's attachment is kept under: a hash of its fbid (or URL), so the
+// same attachment arriving again (each login's inbox table repeats the latest messages) is not
+// fetched twice; a document's own name in a folder of that name.
+func (a gometaFBAttachment) fileName() string {
+	key := a.fbid
+	if key == "" {
+		key = a.url
+	}
+	sum := sha256.Sum256([]byte(key))
+	var ext, name string
+	if a.sticker {
+		ext = gometaStickerExtension(a.mime)
+	} else if a.filename != "" {
+		ext = filepath.Ext(a.filename)
+		name = strings.TrimSuffix(a.filename, ext)
+	}
+	if ext == "" {
+		mt := a.mime
+		ext = extension_from_mimetype(&mt)
+	}
+	return gometaFileName(hex.EncodeToString(sum[:]), name, ext)
+}
+
+// gometaPlainBody is what a plain chat's message shows: the text of its location or link
+// attachments with the message's own text, and the attachments that are files to fetch.
+func gometaPlainBody(text string, stickerID int64, atts []gometaFBAttachment) (string, []gometaFBAttachment) {
+	var files []gometaFBAttachment
+	var lines []string
+	if gometaThumbsUpStickers[stickerID] && len(atts) == 1 && atts[0].sticker && text == "" {
+		return "\U0001F44D", nil
+	}
+	for _, a := range atts {
+		if a.url != "" {
+			files = append(files, a)
+		} else if a.text != "" && !strings.Contains(text, a.text) {
+			lines = append(lines, a.text)
+		}
+	}
+	if text != "" {
+		lines = append(lines, text)
+	}
+	return strings.Join(lines, "\n"), files
+}
+
+// gometaLocationText describes a shared location as the WhatsApp protocol does (format_location).
+func gometaLocationText(lat, lon float64, name, address string, live bool) string {
+	text := "[LOCATION]"
+	if live {
+		text = "[LIVE LOCATION]"
+	}
+	if name = strings.TrimSpace(name); name != "" {
+		text += " " + name
+	}
+	if address = strings.TrimSpace(address); address != "" {
+		text += "\n" + address
+	}
+	return text + fmt.Sprintf("\n%f, %f\nhttps://www.openstreetmap.org/?mlat=%f&mlon=%f", lat, lon, lat, lon)
+}
+
+// gometaE2EEContact is the text of a received contact card (or several), as the WhatsApp protocol
+// shows one (format_contact), and whether the content is one.
+func gometaE2EEContact(content *waConsumerApplication.ConsumerApplication_Content) (string, bool) {
+	text := func(cm *waConsumerApplication.ConsumerApplication_ContactMessage) string {
+		dec, err := cm.Decode()
+		if err != nil {
+			return ""
+		}
+		return format_contact(dec.GetAncillary().GetDisplayName(), dec.GetIntegral().GetVcard())
+	}
+	if cm := content.GetContactMessage(); cm != nil {
+		return text(cm), true
+	}
+	if ca := content.GetContactsArrayMessage(); ca != nil {
+		var cards []string
+		for _, cm := range ca.GetContacts() {
+			if t := text(cm); t != "" {
+				cards = append(cards, t)
+			}
+		}
+		return strings.Join(cards, "\n"), true
+	}
+	return "", false
+}

+// ---- login ----
+
+func gometaLogin(account *PurpleAccount, purpleUserDir, email, password, proxy string) {
+	if _, ok := gometaHandlers[account]; ok {
+		gometaReportError(account, "This connection already exists.", true)
+		return
+	}
+	logger := zerolog.New(zerolog.ConsoleWriter{Out: os.Stderr, TimeFormat: time.Kitchen}).
+		With().Str("account", email).Timestamp().Logger()
+	ctx, cancel := context.WithCancel(context.Background())
+	h := &gometaHandler{
+		account: account, username: email, logger: logger, ctx: ctx, cancel: cancel,
+		purpleUserDir: purpleUserDir,
+		threadGroup:   make(map[int64]bool), contactName: make(map[int64]string),
+		sentOtids:    make(map[int64]bool),
+		e2eeContacts: make(map[int64]bool),
+		e2eeMsgMeta:  make(map[string]e2eeMsgInfo),
+		members:      make(map[int64]map[int64]bool),
+	}
+	h.initParity()
+	gometaHandlers[account] = h
+
+	// A panic here, in messagix's login interpreter for one, would otherwise take the whole process
+	// down, WhatsApp accounts included (mautrix-meta v0.2607.0 dereferenced a nil argument of
+	// bk.action.f32.Eq during the login flow). Fail the login instead.
+	go gometaRecovered(func() { h.login(email, password) }, func(r any, stack []byte) {
+		h.logger.Error().Interface("panic", r).Str("stack", string(stack)).Msg("Facebook login panicked")
+		h.notifyError(fmt.Sprintf("Facebook login failed: internal error (%v)", r), true)
+	})
+}
+
+// login signs in, loads the inbox and connects; it runs on its own goroutine.
+func (h *gometaHandler) login(email, password string) {
+	ctx, logger, account := h.ctx, h.logger, h.account
+	ck, err := h.obtainCookies(email, password)
+	if err != nil {
+		h.notifyError(fmt.Sprintf("Facebook login failed: %v", err), true)
+		return
+	}
+	h.selfID = ck.GetUserID()
+	client := messagix.NewClient(ck, logger, &messagix.Config{})
+	h.client = client
+	client.SetEventHandler(h.eventHandler)
+
+	loadCtx, loadCancel := context.WithTimeout(ctx, 90*time.Second)
+	user, tbl, err := client.LoadMessagesPage(loadCtx)
+	loadCancel()
+	if err != nil {
+		// cached cookies may have expired — drop them so the next attempt re-does credentials
+		gometaSetSetting(account, gometaSessionSetting, "")
+		h.notifyError(fmt.Sprintf("Facebook load failed (session may have expired, try again): %v", err), true)
+		return
+	}
+	h.logger.Info().Str("name", user.GetName()).Msg("authenticated")
+	// Buddies come from the tables themselves (threads, participants, contact rows) — Messenger
+	// does not hand over a bulk friend list on login (the search task 452 times out), so we
+	// mirror mautrix-meta and create contacts lazily from every table we receive, here and in
+	// the realtime publish stream (see parseTable + eventHandler).
+	h.parseTable(tbl)
+	if err := client.Connect(ctx); err != nil {
+		h.notifyError(fmt.Sprintf("Facebook connect failed: %v", err), true)
+		return
+	}
+	// Bring up the E2EE (whatsmeow) transport so encrypted threads can send/receive.
+	// Non-fatal: plaintext threads keep working even if this fails.
+	if err := h.connectE2EE(ck.GetUserID()); err != nil {
+		h.logger.Warn().Err(err).Msg("E2EE setup failed (encrypted threads unavailable)")
+	}
+}
+
+// obtainCookies returns a usable messagix session: cached cookies if present, otherwise the
+// e-mail/password login. For two-factor it picks a method that takes a typed code
+// (gometaPreferredMFA) and asks for the code; a login approval on another device is waited for.
+// Anything else aborts with a clear message rather than looping.
+func (h *gometaHandler) obtainCookies(email, password string) (*cookies.Cookies, error) {
+	// 1) cached session
+	if blob := gometaGetSetting(h.account, gometaSessionSetting); blob != "" {
+		ck := &cookies.Cookies{Platform: types.Facebook}
+		if err := json.Unmarshal([]byte(blob), ck); err == nil && ck.IsLoggedIn() {
+			h.logger.Info().Msg("using cached Facebook session")
+			return ck, nil
+		}
+	}
+	if email == "" || password == "" {
+		return nil, fmt.Errorf("enter your Facebook email and password")
+	}
+	// Bound the whole login so an unapproved login-approval can't wait forever.
+	ctx, cancel := context.WithTimeout(h.ctx, 5*time.Minute)
+	defer cancel()
+
+	loginClient := messagix.NewClient(&cookies.Cookies{Platform: types.MessengerLiteIOS}, h.logger, &messagix.Config{})
+	var userInput map[string]string
+	credsSent := false
+	for iter := 0; iter < 40; iter++ { // hard loop guard
+		step, newCookies, err := loginClient.MessengerLite.DoLoginSteps(ctx, userInput)
+		if err != nil {
+			return nil, err
+		}
+		if step == nil { // login complete
+			if newCookies == nil {
+				return nil, fmt.Errorf("login returned no session")
+			}
+			ck := &cookies.Cookies{Platform: types.Facebook}
+			ck.UpdateValues(newCookies.GetAll())
+			if b, e := json.Marshal(ck); e == nil {
+				gometaSetSetting(h.account, gometaSessionSetting, string(b))
+			}
+			return ck, nil
+		}
+		switch step.Type {
+		case bridgev2.LoginStepTypeDisplayAndWait:
+			// Login approval: Facebook sent a notification to your other device. The next
+			// DoLoginSteps call blocks (polling on a timer) until you approve — not a busy loop.
+			h.logger.Info().Str("info", step.Instructions.String()).Msg("waiting for login approval on your other device")
+			userInput = nil
+		case bridgev2.LoginStepTypeUserInput:
+			ui, err := h.fillLoginStep(step, email, password, &credsSent)
+			if err != nil {
+				return nil, err // can't fill (code method / rejected creds) -> abort, do not loop
+			}
+			userInput = ui
+		default:
+			return nil, fmt.Errorf("unsupported Facebook login step %q", step.Type)
+		}
+	}
+	return nil, fmt.Errorf("Facebook login did not complete")
+}
+
+// fillLoginStep builds the submit map: e-mail/password from the account, the 2FA method, and the
+// 2FA code the user types. Returns an error (which aborts the login) for any other kind of input,
+// so we never spin on a prompt that can't be answered.
+func (h *gometaHandler) fillLoginStep(step *bridgev2.LoginStep, email, password string, credsSent *bool) (map[string]string, error) {
+	out := map[string]string{}
+	if step.UserInputParams == nil {
+		return out, nil
+	}
+	for _, f := range step.UserInputParams.Fields {
+		switch f.Type {
+		case bridgev2.LoginInputFieldTypeEmail, bridgev2.LoginInputFieldTypeUsername, bridgev2.LoginInputFieldTypePhoneNumber:
+			if *credsSent {
+				return nil, fmt.Errorf("Facebook rejected the email/password")
+			}
+			out[f.ID] = email
+		case bridgev2.LoginInputFieldTypePassword:
+			out[f.ID] = password
+			*credsSent = true
+		case bridgev2.LoginInputFieldTypeSelect:
+			// 2FA method picker: choose a code method (Authentication app / Text message);
+			// the code is then asked for (see the 2FACode case).
+			offered := make([]string, len(f.Options))
+			for i, o := range f.Options {
+				offered[i] = o.Value
+			}
+			choice := gometaPreferredMFA(offered)
+			if choice == "" {
+				return nil, fmt.Errorf("this Facebook account offers no code-based two-factor method we can use (%v) — enable Authentication app or Text message in Facebook Security settings", offered)
+			}
+			h.logger.Info().Str("mfa", choice).Msg("selecting 2FA method")
+			out[f.ID] = choice
+		case bridgev2.LoginInputFieldType2FACode:
+			// Facebook wants the login/2FA code; block until the user enters it (promptInput).
+			h.logger.Info().Str("prompt", step.Instructions.String()).Msg("waiting for the 2FA code")
+			code := strings.TrimSpace(h.promptInput(step.Instructions.String()))
+			if code == "" {
+				return nil, fmt.Errorf("no Facebook 2FA code was entered")
+			}
+			out[f.ID] = code
+		default:
+			return nil, fmt.Errorf("this Facebook login needs a typed %q, which isn't supported yet", f.Type)
+		}
+	}
+	return out, nil
+}
+
+// gometaPreferredMFA picks a 2FA method we can complete by typing a code. Code methods are preferred in this order. "Notification on another device" (AFAD)
+// is deliberately NOT selected: Meta rejects it in this messagix flow (the afad_state.async RPC
+// returns an error, which older mautrix-meta even crashes parsing), so it can never complete.
+func gometaPreferredMFA(options []string) string {
+	for _, want := range []string{"Authentication app", "Text message", "WhatsApp"} {
+		for _, o := range options {
+			if o == want {
+				return o
+			}
+		}
+	}
+	return ""
+}
diff --git a/gometa_attachment.go b/gometa_attachment.go
new file mode 100644
index 0000000..a399bf4
--- /dev/null
+++ b/gometa_attachment.go
@@ -0,0 +1,150 @@
+//go:build gometa
+
+package main
+
+// Received Facebook files: pictures, videos, voice messages, documents and stickers. Each is
+// downloaded when it comes, on its own goroutine, and kept under
+// <purple user dir>/gometa/attachments/<account>/; the chat then shows a picture inline and any
+// other file as a link to it, with the caption after it (gometabridge.c). A file already kept is
+// not downloaded again: it is named after its content hash (encrypted chats) or its Facebook id
+// (plain chats), and each login's inbox repeats the latest messages.
+//
+// This does not use the WhatsApp protocol's attachment handling (glue/handle_attachment.c), which
+// depends on that protocol's connection data and account options.
+
+/*
+#include "gometabridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+// gometaDownloads bounds how many files are downloaded at once (a login's inbox can name many).
+var gometaDownloads = make(chan struct{}, 3)
+
+// gometaGo runs an attachment's download (a variable so the tests can run it in line).
+var gometaGo = func(f func()) { go f() }
+
+// gometaFileName is the relative name a file is kept under: hash and extension, or for a document
+// with a name of its own, that name (made safe as a file name) in a folder named after the hash.
+func gometaFileName(hash, name, extension string) string {
+	if name != "" {
+		if safe := sanitize_file_name(name); safe != "" {
+			return filepath.Join(hash, safe+extension)
+		}
+	}
+	return hash + extension
+}
+
+// attachmentDir is where this account's files are kept.
+func (h *gometaHandler) attachmentDir() string {
+	return filepath.Join(h.purpleUserDir, "gometa", "attachments", sanitize_file_name(h.username))
+}
+
+// receiveAttachment keeps a file of message m, fetching it unless it is kept already, and then shows
+// it. When it cannot be had, the caption alone is shown, if there is one.
+func (h *gometaHandler) receiveAttachment(m gometaIncoming, name, mimetype string, fetch func(ctx context.Context) ([]byte, error)) {
+	gometaGo(func() {
+		path := filepath.Join(h.attachmentDir(), name)
+		if st, err := os.Stat(path); err != nil || st.Size() == 0 {
+			gometaDownloads <- struct{}{}
+			ctx, cancel := context.WithTimeout(h.ctx, 3*time.Minute)
+			data, err := fetch(ctx)
+			cancel()
+			<-gometaDownloads
+			if err == nil {
+				err = gometaWriteFile(path, data)
+			}
+			if err != nil {
+				h.logger.Warn().Err(err).Str("mime", mimetype).Msg("Facebook attachment not downloaded")
+				if m.text != "" {
+					h.out().message(m)
+				}
+				return
+			}
+		}
+		h.out().attachment(m, path, mimetype)
+	})
+}
+
+// handleE2EEMedia takes an encrypted message's picture, video, voice message, document or sticker.
+// It tells whether the content was one.
+func (h *gometaHandler) handleE2EEMedia(content *waConsumerApplication.ConsumerApplication_Content, evt *events.FBMessage, chatFbid, senderFbid int64, name string) bool {
+	media, ok := gometaE2EEMediaOf(content)
+	if !ok {
+		return false
+	}
+	id := string(evt.Info.ID)
+	if id != "" {
+		h.mu.Lock()
+		h.e2eeMsgMeta[id] = e2eeMsgInfo{fromMe: evt.Info.IsFromMe, sender: strconv.FormatInt(senderFbid, 10), text: media.caption}
+		h.mu.Unlock()
+	}
+	h.addContact(chatFbid, name)
+	m := gometaIncoming{conv: strconv.FormatInt(chatFbid, 10), who: strconv.FormatInt(senderFbid, 10), name: name,
+		text: media.caption, id: id, ts: evt.Info.Timestamp.Unix(), isOutgoing: evt.Info.IsFromMe}
+	integral := media.transport.GetIntegral()
+	h.receiveAttachment(m, media.fileName(), media.mimetype, func(ctx context.Context) ([]byte, error) {
+		return h.net().downloadFB(ctx, integral, media.mediaType)
+	})
+	h.noteUnreadE2EE(chatFbid, evt.Info) // for the read receipt when the chat is shown
+	return true
+}
+
+// postPlainMedia takes a plain chat's message with files: each is kept and shown, the message's text
+// with the first.
+func (h *gometaHandler) postPlainMedia(m gometaIncoming, files []gometaFBAttachment) {
+	for i, a := range files {
+		a := a
+		part := m
+		if i > 0 {
+			part.text, part.id = "", ""
+		}
+		h.receiveAttachment(part, a.fileName(), a.mime, func(ctx context.Context) ([]byte, error) {
+			return h.net().fetch(ctx, a.url, a.mime)
+		})
+	}
+}
+
+func gometaWriteFile(path string, data []byte) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return err
+	}
+	return os.WriteFile(path, data, 0o600)
+}
+
+// gometaNotifyAttachment shows a received file kept at path; m.text is its caption (markup).
+func gometaNotifyAttachment(account *PurpleAccount, m gometaIncoming, path, mimetype string) {
+	msg := C.gometa_message_t{account: account, msgtype: C.char(C.gometa_message_type_attachment), timestamp: C.time_t(m.ts)}
+	msg.conv = C.CString(m.conv)
+	msg.who = C.CString(m.who)
+	if m.name != "" {
+		msg.name = C.CString(m.name)
+	}
+	if m.text != "" {
+		msg.text = C.CString(m.text)
+	}
+	if m.id != "" {
+		msg.id = C.CString(m.id)
+	}
+	msg.path = C.CString(path)
+	if mimetype != "" {
+		msg.mimetype = C.CString(mimetype)
+	}
+	if m.isGroup {
+		msg.isGroup = 1
+	}
+	if m.isOutgoing {
+		msg.isOutgoing = 1
+	}
+	C.gometa_process_message(msg)
+}
diff --git a/gometa_e2ee.go b/gometa_e2ee.go
new file mode 100644
index 0000000..173d5c9
--- /dev/null
+++ b/gometa_e2ee.go
@@ -0,0 +1,260 @@
+//go:build gometa
+
+package main
+
+// Facebook Messenger E2EE (encrypted threads) support. Messenger's end-to-end encryption rides
+// WhatsApp's Signal transport ("encrypted over WA"), so messagix exposes a whatsmeow client for it
+// via RegisterE2EE + PrepareE2EEClient. Encrypted threads CANNOT use the plaintext SendMessageTask
+// (Facebook rejects it with HandleInvalidSendToOpen) — they must go through this whatsmeow client.
+//
+// The whatsmeow device (Signal identity + prekeys) is persisted in a per-account SQLite DB (pure-Go
+// modernc driver, registered by login.go) so the E2EE session survives restarts. This client is
+// entirely separate from the WhatsApp account's own whatsmeow client (different device + DB).
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"go.mau.fi/mautrix-meta/pkg/messagix/methods"
+	"go.mau.fi/whatsmeow/proto/waArmadilloApplication"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	"go.mau.fi/whatsmeow/proto/waMsgApplication"
+	"go.mau.fi/whatsmeow/store"
+	"go.mau.fi/whatsmeow/store/sqlstore"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	waLog "go.mau.fi/whatsmeow/util/log"
+	"google.golang.org/protobuf/proto"
+)
+
+const gometaWADeviceSetting = "gometa_wa_jid"
+
+// gometaE2EEStorePath is an account's E2EE store, in the purple user directory. The username is
+// made a single file name, as for the attachment folder.
+func gometaE2EEStorePath(purpleUserDir, username string) string {
+	return filepath.Join(purpleUserDir, "gometa-e2ee-"+sanitize_file_name(username)+".db")
+}
+
+// gometaE2EEStoreURI is the SQLite URI of a store path. SQLite decodes %HH in a URI's file name
+// and ends it at '#' (sanitize_file_name has already replaced '?'), so those are escaped.
+func gometaE2EEStoreURI(path string) string {
+	return "file:" + strings.NewReplacer("%", "%25", "#", "%23", "?", "%3f").Replace(path)
+}
+
+// connectE2EE registers (once) and connects the whatsmeow client that carries Messenger's
+// encrypted threads. Best-effort: a failure only disables encrypted threads, not plaintext ones.
+func (h *gometaHandler) connectE2EE(fbid int64) error {
+	dbLog := waLog.Zerolog(h.logger.With().Str("component", "e2ee-db").Logger())
+	addr := gometaE2EEStoreURI(gometaE2EEStorePath(h.purpleUserDir, h.username)) + "?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)"
+	db, err := sql.Open("sqlite", addr)
+	if err != nil {
+		return fmt.Errorf("open e2ee db: %w", err)
+	}
+	db.SetMaxOpenConns(1)
+	container := sqlstore.NewWithDB(db, "sqlite", dbLog)
+	if err := container.Upgrade(h.ctx); err != nil {
+		return fmt.Errorf("upgrade e2ee db: %w", err)
+	}
+
+	// Reuse the saved device if we have one, otherwise register a fresh one.
+	var device *store.Device
+	if jidStr := gometaGetSetting(h.account, gometaWADeviceSetting); jidStr != "" {
+		if jid, perr := waTypes.ParseJID(jidStr); perr == nil {
+			device, _ = container.GetDevice(h.ctx, jid)
+		}
+	}
+	isNew := device == nil
+	if isNew {
+		device = container.NewDevice()
+	}
+	if suggested := h.client.MessengerLite.GetSuggestedDeviceID(); suggested != uuid.Nil {
+		device.FacebookUUID = suggested
+	}
+	h.client.SetDevice(device)
+
+	if isNew {
+		h.logger.Info().Msg("registering new E2EE device")
+		if err := h.client.RegisterE2EE(h.ctx, fbid); err != nil {
+			return fmt.Errorf("register e2ee: %w", err)
+		}
+		if device.ID != nil {
+			gometaSetSetting(h.account, gometaWADeviceSetting, device.ID.String())
+		}
+		if err := device.Save(h.ctx); err != nil {
+			return fmt.Errorf("save e2ee device: %w", err)
+		}
+	}
+
+	e2ee, err := h.client.PrepareE2EEClient()
+	if err != nil {
+		return fmt.Errorf("prepare e2ee client: %w", err)
+	}
+	e2ee.AddEventHandler(func(evt any) {
+		// Online once connected, so typing comes to us (gometa_presence.go).
+		if _, ok := evt.(*events.Connected); ok {
+			go h.announceAvailable(e2ee)
+		}
+		h.e2eeEventHandler(evt)
+	})
+	if err := e2ee.Connect(); err != nil {
+		return fmt.Errorf("connect e2ee socket: %w", err)
+	}
+	h.e2ee = e2ee
+	h.logger.Info().Msg("E2EE (whatsmeow) client connected")
+	return nil
+}
+
+// e2eeEventHandler receives events from the encrypted (whatsmeow) socket.
+func (h *gometaHandler) e2eeEventHandler(rawEvt any) {
+	switch evt := rawEvt.(type) {
+	case *events.FBMessage:
+		h.handleE2EEMessage(evt)
+	case *events.Connected:
+		h.logger.Info().Msg("E2EE socket connected")
+	case *events.ChatPresence:
+		h.handleChatPresence(evt) // typing (gometa_presence.go)
+	case *events.LoggedOut:
+		h.logger.Warn().Msg("E2EE socket logged out")
+	default:
+		// Surface anything we don't handle (e.g. if reactions ever arrive as a distinct event type
+		// rather than an FBMessage) so it's visible in the log instead of silently dropped.
+		h.logger.Debug().Str("type", fmt.Sprintf("%T", rawEvt)).Msg("unhandled E2EE event")
+	}
+}
+
+// handleE2EEMessage turns an encrypted message into a buddy + incoming message, and records the
+// chat/sender as E2EE so future sends to them route over the encrypted transport.
+func (h *gometaHandler) handleE2EEMessage(evt *events.FBMessage) {
+	chatFbid, _ := strconv.ParseInt(evt.Info.Chat.User, 10, 64)
+	senderFbid, _ := strconv.ParseInt(evt.Info.Sender.User, 10, 64)
+	if chatFbid == 0 {
+		return
+	}
+	h.mu.Lock()
+	h.e2eeContacts[chatFbid] = true
+	if senderFbid != 0 {
+		h.e2eeContacts[senderFbid] = true
+	}
+	name := h.contactName[senderFbid]
+	// Drop the echo of a message we just sent from here (tracked by the id we passed to SendFBMessage).
+	var mine bool
+	if otid, err := strconv.ParseInt(string(evt.Info.ID), 10, 64); err == nil {
+		mine = h.sentOtids[otid]
+		delete(h.sentOtids, otid)
+	}
+	h.mu.Unlock()
+	if mine {
+		return
+	}
+
+	var text string
+	switch msg := evt.Message.(type) {
+	case *waArmadilloApplication.Armadillo:
+		// A shared location or link comes as "extended content" (gometa_receive.go).
+		text = gometaArmadilloText(msg.GetPayload().GetContent().GetExtendedContentMessage())
+	case *waConsumerApplication.ConsumerApplication:
+		// "Delete for everyone" comes as application data, an edit as content; both name the
+		// message they change by its id (gometa_edits.go).
+		if revoke := msg.GetPayload().GetApplicationData().GetRevoke(); revoke != nil {
+			h.handleE2EERevoke(evt, revoke.GetKey())
+			return
+		}
+		content := msg.GetPayload().GetContent()
+		if edit := content.GetEditMessage(); edit != nil {
+			h.handleE2EEEdit(evt, edit.GetKey(), edit.GetMessage().GetText())
+			return
+		}
+		// In an encrypted thread a reaction comes as a ConsumerApplication with a ReactionMessage,
+		// not as the LSUpsertReaction table of a plain thread. Key.ID is the message reacted to,
+		// Text the emoji ("" when the reaction was taken back).
+		if rm := content.GetReactionMessage(); rm != nil {
+			if targetID := rm.GetKey().GetID(); targetID != "" {
+				h.out().reaction(strconv.FormatInt(chatFbid, 10), targetID,
+					strconv.FormatInt(senderFbid, 10), rm.GetText())
+			}
+			return
+		}
+		// A picture, video, voice message, document or sticker (gometa_attachment.go).
+		if h.handleE2EEMedia(content, evt, chatFbid, senderFbid, name) {
+			return
+		}
+		// A contact card, a text with a link preview, and a location, are texts (gometa_receive.go).
+		if contact, ok := gometaE2EEContact(content); ok {
+			text = contact
+		} else {
+			text = gometaE2EEText(content)
+		}
+	}
+	if text == "" {
+		return
+	}
+	// Record who sent this message so a later reaction over E2EE can build a correct MessageKey
+	// (FromMe / sender). Keyed by the message id (matches the serviceMessageId we store below).
+	if id := string(evt.Info.ID); id != "" {
+		h.mu.Lock()
+		h.e2eeMsgMeta[id] = e2eeMsgInfo{fromMe: evt.Info.IsFromMe, sender: strconv.FormatInt(senderFbid, 10), text: text}
+		h.mu.Unlock()
+	}
+	// An encrypted reply names the message it answers in the MessageApplication metadata (its
+	// StanzaID is that message's id); its text and author come from the per-message cache.
+	var quotedText, quotedFrom string
+	if qm := evt.FBApplication.GetMetadata().GetQuotedMessage(); qm != nil {
+		if quotedID := qm.GetStanzaID(); quotedID != "" {
+			h.mu.Lock()
+			if meta, ok := h.e2eeMsgMeta[quotedID]; ok {
+				quotedText = meta.text
+				if sf, perr := strconv.ParseInt(meta.sender, 10, 64); perr == nil {
+					quotedFrom = h.contactName[sf]
+				}
+			}
+			h.mu.Unlock()
+		}
+	}
+	h.addContact(chatFbid, name)
+	h.notifyMessage(strconv.FormatInt(chatFbid, 10), strconv.FormatInt(senderFbid, 10),
+		name, text, evt.Info.ID, evt.Info.Timestamp.Unix(), false, evt.Info.IsFromMe, quotedText, quotedFrom)
+	h.noteUnreadE2EE(chatFbid, evt.Info) // for the read receipt when the chat is shown
+}
+
+// sendE2EE sends a message over the encrypted (whatsmeow) transport to a Messenger thread.
+func (h *gometaHandler) sendE2EE(threadID int64, text string) error {
+	to := waTypes.JID{User: strconv.FormatInt(threadID, 10), Server: waTypes.MessengerServer}
+	msg := &waConsumerApplication.ConsumerApplication{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_Content{
+				Content: &waConsumerApplication.ConsumerApplication_Content{
+					Content: &waConsumerApplication.ConsumerApplication_Content_MessageText{
+						MessageText: &waCommon.MessageText{Text: proto.String(text)},
+					},
+				},
+			},
+		},
+	}
+	otid := methods.GenerateEpochID()
+	otidStr := strconv.FormatInt(otid, 10)
+	h.mu.Lock()
+	h.sentOtids[otid] = true
+	// Our own message, so a later edit or reply over E2EE knows it is ours and can quote it.
+	h.e2eeMsgMeta[otidStr] = e2eeMsgInfo{fromMe: true, sender: strconv.FormatInt(h.selfID, 10), text: text}
+	h.mu.Unlock()
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	err := h.net().sendFB(ctx, to, msg, &waMsgApplication.MessageApplication_Metadata{}, waTypes.MessageID(otidStr))
+	if err != nil {
+		h.mu.Lock()
+		delete(h.sentOtids, otid) // nothing went, so nothing comes back
+		delete(h.e2eeMsgMeta, otidStr)
+		h.mu.Unlock()
+		return err
+	}
+	// The id we sent with is this message's id, which a reaction to it names.
+	h.index.add(gometaIncoming{conv: to.User, who: strconv.FormatInt(h.selfID, 10), text: text, id: otidStr, isOutgoing: true})
+	return nil
+}
diff --git a/gometa_edits.go b/gometa_edits.go
new file mode 100644
index 0000000..a1a1408
--- /dev/null
+++ b/gometa_edits.go
@@ -0,0 +1,103 @@
+//go:build gometa
+
+package main
+
+// A Facebook message edited or deleted for everyone after it was shown. Both name the message by
+// its id:
+//   encrypted chats: the whatsmeow message id (evt.Info.ID; for our own sends from here, the id we
+//                    sent with). An edit's or a revoke's MessageKey.ID names it.
+//   plain chats:     the Facebook MessageId ("mid.$..."; for our own sends from here, the one
+//                    LSReplaceOptimsiticMessage gives). The edit and delete tables name it.
+// The sink shows the change (gometa_sink.go).
+
+import (
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+// e2eeMayChange tells whether whoever sent evt may edit or delete the message stored under target.
+// The per-message cache (e2eeMsgMeta) knows who sent each encrypted message seen since the plugin
+// started, and an edit or delete from anyone else is dropped. A message from before that is not in
+// the cache: its sender cannot be checked here, and the change is passed on by id as it came.
+func (h *gometaHandler) e2eeMayChange(evt *events.FBMessage, target string) bool {
+	h.mu.Lock()
+	meta, known := h.e2eeMsgMeta[target]
+	h.mu.Unlock()
+	if !known {
+		return true
+	}
+	if meta.fromMe || evt.Info.IsFromMe {
+		return meta.fromMe && evt.Info.IsFromMe
+	}
+	return meta.sender == evt.Info.Sender.User
+}
+
+// handleE2EEEdit takes an encrypted edit: the message under its key's id now reads the new text.
+func (h *gometaHandler) handleE2EEEdit(evt *events.FBMessage, key *waCommon.MessageKey, text string) {
+	target := key.GetID()
+	if target == "" || text == "" || !h.e2eeMayChange(evt, target) {
+		return
+	}
+	h.mu.Lock()
+	if meta, ok := h.e2eeMsgMeta[target]; ok {
+		meta.text = text // a later reply quotes the new text
+		h.e2eeMsgMeta[target] = meta
+	}
+	h.mu.Unlock()
+	h.out().edit(target, text)
+}
+
+// handleE2EERevoke takes an encrypted "delete for everyone".
+func (h *gometaHandler) handleE2EERevoke(evt *events.FBMessage, key *waCommon.MessageKey) {
+	target := key.GetID()
+	if target == "" || !h.e2eeMayChange(evt, target) {
+		return
+	}
+	h.out().remove(target)
+}
+
+// handleEditTables takes a plain chat's edits and deletes. A message deleted and inserted again in
+// the same table was replaced, not deleted (mautrix-meta skips such a thread delete too), so only a
+// delete without an insert counts; LSDeleteThenInsertMessage is a delete only when it says the
+// message was unsent, as mautrix-meta reads it.
+func (h *gometaHandler) handleEditTables(tbl *table.LSTable) {
+	for _, e := range tbl.LSEditMessage {
+		if e.MessageID != "" && e.Text != "" {
+			h.out().edit(e.MessageID, e.Text)
+		}
+	}
+	inserted := make(map[string]bool, len(tbl.LSInsertMessage)+len(tbl.LSUpsertMessage))
+	for _, m := range tbl.LSInsertMessage {
+		inserted[m.MessageId] = !m.IsUnsent
+	}
+	for _, m := range tbl.LSUpsertMessage {
+		inserted[m.MessageId] = !m.IsUnsent
+	}
+	removed := make(map[string]bool)
+	remove := func(id string) {
+		if id != "" && !inserted[id] && !removed[id] {
+			removed[id] = true
+			h.out().remove(id)
+		}
+	}
+	for _, d := range tbl.LSDeleteMessage {
+		remove(d.MessageId)
+	}
+	for _, d := range tbl.LSDeleteThenInsertMessage {
+		if d.IsUnsent {
+			remove(d.MessageId)
+		}
+	}
+	// A message that arrives already unsent (a later sync of one that was shown) is a delete too.
+	for _, m := range tbl.LSInsertMessage {
+		if m.IsUnsent {
+			remove(m.MessageId)
+		}
+	}
+	for _, m := range tbl.LSUpsertMessage {
+		if m.IsUnsent {
+			remove(m.MessageId)
+		}
+	}
+}
diff --git a/gometa_edits_test.go b/gometa_edits_test.go
new file mode 100644
index 0000000..0d2ef15
--- /dev/null
+++ b/gometa_edits_test.go
@@ -0,0 +1,137 @@
+//go:build gometa
+
+package main
+
+import (
+	"reflect"
+	"testing"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func gmEditContent(target, text string) *waConsumerApplication.ConsumerApplication_Content {
+	return &waConsumerApplication.ConsumerApplication_Content{Content: &waConsumerApplication.ConsumerApplication_Content_EditMessage{
+		EditMessage: &waConsumerApplication.ConsumerApplication_EditMessage{
+			Key:     &waCommon.MessageKey{ID: proto.String(target)},
+			Message: &waCommon.MessageText{Text: proto.String(text)},
+		}}}
+}
+
+func gmRevoke(chat, sender waTypes.JID, id, target string, fromMe bool) *events.FBMessage {
+	evt := gmFBMessage(chat, sender, id, nil)
+	evt.Info.IsFromMe = fromMe
+	evt.Message = &waConsumerApplication.ConsumerApplication{Payload: &waConsumerApplication.ConsumerApplication_Payload{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload_ApplicationData{ApplicationData: &waConsumerApplication.ConsumerApplication_ApplicationData{
+			ApplicationContent: &waConsumerApplication.ConsumerApplication_ApplicationData_Revoke{Revoke: &waConsumerApplication.ConsumerApplication_RevokeMessage{
+				Key: &waCommon.MessageKey{ID: proto.String(target)}}},
+		}},
+	}}
+	return evt
+}
+
+// ---- encrypted chats ----
+
+func TestGometaE2EEEditChangesTheMessageByItsStoredID(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6001", gmText("helo")))
+	stored := onlyMessage(t, r).id
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6002", gmEditContent("6001", "hello")))
+	if want := []gmEdit{{stored, "hello"}}; !reflect.DeepEqual(r.edits, want) {
+		t.Errorf("edits %+v, want %+v", r.edits, want)
+	}
+	if len(r.messages) != 1 {
+		t.Errorf("the edit was shown as a message of its own: %+v", r.messages)
+	}
+	if h.e2eeMsgMeta["6001"].text != "hello" {
+		t.Errorf("a reply would still quote %q", h.e2eeMsgMeta["6001"].text)
+	}
+}
+
+func TestGometaE2EERevokeDeletesTheMessage(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6101", gmText("oops")))
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmPeer), "6102", "6101", false))
+	if want := []string{"6101"}; !reflect.DeepEqual(r.removes, want) || len(r.messages) != 1 {
+		t.Errorf("removes %+v messages %d", r.removes, len(r.messages))
+	}
+}
+
+// Someone else may not change a message they did not send; we may change our own.
+func TestGometaE2EEOnlyTheSenderMayChangeAMessage(t *testing.T) {
+	h, r := newTestGometa(t)
+	group := waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "6201", gmText("mine to change")))
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer2), "6202", gmEditContent("6201", "forged")))
+	h.handleE2EEMessage(gmRevoke(group, gmJID(gmPeer2), "6203", "6201", false))
+	if len(r.edits)+len(r.removes) != 0 {
+		t.Fatalf("a forged change went through: %+v %+v", r.edits, r.removes)
+	}
+	// our own message, sent from here, deleted from our other device
+	h.e2eeMsgMeta["6300"] = e2eeMsgInfo{fromMe: true, sender: itoa(gmSelf)}
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmSelf), "6301", "6300", true))
+	if want := []string{"6300"}; !reflect.DeepEqual(r.removes, want) {
+		t.Errorf("own delete: %+v", r.removes)
+	}
+	// the other side may not delete ours, and we may not delete theirs
+	h.e2eeMsgMeta["6310"] = e2eeMsgInfo{fromMe: true, sender: itoa(gmSelf)}
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmPeer), "6311", "6310", false))
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6320", gmText("theirs")))
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmSelf), "6321", "6320", true))
+	if want := []string{"6300"}; !reflect.DeepEqual(r.removes, want) {
+		t.Errorf("a delete crossed sides: %+v", r.removes)
+	}
+}
+
+// After a restart the cache is empty: the change still goes, by id.
+func TestGometaE2EEEditOfAMessageFromBeforeTheRestart(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6402", gmEditContent("6401", "new")))
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmPeer), "6403", "6400", false))
+	if !reflect.DeepEqual(r.edits, []gmEdit{{"6401", "new"}}) || !reflect.DeepEqual(r.removes, []string{"6400"}) {
+		t.Errorf("edits %+v removes %+v", r.edits, r.removes)
+	}
+}
+
+// ---- plain chats ----
+
+func TestGometaPlainEditAndDelete(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{gmInsert("mid.e", "helo", gmPeer)}})
+	stored := onlyMessage(t, r).id
+	h.parseTable(&table.LSTable{LSEditMessage: []*table.LSEditMessage{{MessageID: "mid.e", Text: "hello", EditCount: 1}}})
+	h.parseTable(&table.LSTable{LSDeleteMessage: []*table.LSDeleteMessage{{ThreadKey: gmPeer, MessageId: "mid.e"}}})
+	if !reflect.DeepEqual(r.edits, []gmEdit{{stored, "hello"}}) || !reflect.DeepEqual(r.removes, []string{stored}) {
+		t.Errorf("edits %+v removes %+v", r.edits, r.removes)
+	}
+}
+
+func TestGometaPlainUnsendIsADelete(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSDeleteThenInsertMessage: []*table.LSDeleteThenInsertMessage{
+		{ThreadKey: gmPeer, MessageId: "mid.u", IsUnsent: true},
+		{ThreadKey: gmPeer, MessageId: "mid.v", IsUnsent: false}, // not an unsend: left alone
+	}})
+	unsent := gmInsert("mid.w", "", gmPeer)
+	unsent.IsUnsent = true
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{unsent}})
+	if want := []string{"mid.u", "mid.w"}; !reflect.DeepEqual(r.removes, want) || len(r.messages) != 0 {
+		t.Errorf("removes %+v messages %+v, want %+v", r.removes, r.messages, want)
+	}
+}
+
+// Deleted and inserted again in one table: replaced, not deleted.
+func TestGometaPlainDeleteThenInsertIsNoDelete(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{
+		LSDeleteMessage: []*table.LSDeleteMessage{{ThreadKey: gmPeer, MessageId: "mid.r"}},
+		LSInsertMessage: []*table.LSInsertMessage{gmInsert("mid.r", "again", gmPeer)},
+	})
+	if len(r.removes) != 0 || len(r.messages) != 1 {
+		t.Errorf("removes %+v messages %+v", r.removes, r.messages)
+	}
+}
diff --git a/gometa_groups.go b/gometa_groups.go
new file mode 100644
index 0000000..5f6dc58
--- /dev/null
+++ b/gometa_groups.go
@@ -0,0 +1,135 @@
+//go:build gometa
+
+package main
+
+// Facebook group chats: who is in them, and their names.
+//
+// Who is in a group comes with the thread rows: LSAddParticipantIdToGroupThread for each member,
+// LSRemoveParticipantFromThread and LSRemoveAllParticipantsForThread when they go. The handler
+// keeps them by thread key, and puts them on the group's chat conversation (gometa_message_type_
+// members, gometabridge.c) whenever they change and when the chat is opened (gometa_go_chat_
+// joined). We are not in our own list. An encrypted group is not a group here yet (its messages
+// come as a 1:1 chat's, gometa_e2ee.go).
+
+/*
+#include "gometabridge.h"
+*/
+import "C"
+
+import (
+	"sort"
+	"strconv"
+	"strings"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+)
+
+// The group's chat conversation was opened (glue/gometa_init.c, gometabridge.c): put its members
+// on it.
+//
+//export gometa_go_chat_joined
+func gometa_go_chat_joined(account *PurpleAccount, chat *C.char) {
+	if h, ok := gometaHandlers[account]; ok {
+		if threadKey, err := strconv.ParseInt(C.GoString(chat), 10, 64); err == nil {
+			h.pushMembers(threadKey)
+		}
+	}
+}
+
+// ---- members ----
+
+// handleParticipantTables keeps who is in each group, and puts a changed group's members on its
+// chat. Removals come first: a table that empties a thread's list fills it again after.
+func (h *gometaHandler) handleParticipantTables(tbl *table.LSTable) {
+	changed := map[int64]bool{}
+	h.mu.Lock()
+	if h.members == nil {
+		h.members = make(map[int64]map[int64]bool)
+	}
+	for _, r := range tbl.LSRemoveAllParticipantsForThread {
+		if r.ThreadKey != 0 {
+			delete(h.members, r.ThreadKey)
+			changed[r.ThreadKey] = true
+		}
+	}
+	for _, r := range tbl.LSRemoveParticipantFromThread {
+		if r.ThreadKey != 0 && r.ParticipantId != 0 {
+			delete(h.members[r.ThreadKey], r.ParticipantId)
+			changed[r.ThreadKey] = true
+		}
+	}
+	for _, p := range tbl.LSAddParticipantIdToGroupThread {
+		if p.ThreadKey == 0 || p.ContactId == 0 {
+			continue
+		}
+		if h.members[p.ThreadKey] == nil {
+			h.members[p.ThreadKey] = make(map[int64]bool)
+		}
+		h.members[p.ThreadKey][p.ContactId] = true
+		changed[p.ThreadKey] = true
+	}
+	h.mu.Unlock()
+	keys := make([]int64, 0, len(changed))
+	for k := range changed {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })
+	for _, k := range keys {
+		h.pushMembers(k)
+	}
+}
+
+// groupMembers is who is in a group besides us, in fbid order.
+func (h *gometaHandler) groupMembers(threadKey int64) []int64 {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	var out []int64
+	for fbid := range h.members[threadKey] {
+		if fbid != h.selfID {
+			out = append(out, fbid)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+// pushMembers puts a group's members on its chat conversation, if it is a group.
+func (h *gometaHandler) pushMembers(threadKey int64) {
+	h.mu.Lock()
+	isGroup := h.threadGroup[threadKey]
+	h.mu.Unlock()
+	if !isGroup {
+		return
+	}
+	h.out().members(strconv.FormatInt(threadKey, 10), h.groupMembers(threadKey))
+}
+
+// gometaNotifyMembers hands a group's members ("\x1f"-joined fbids, "" for none) to the C bridge.
+func gometaNotifyMembers(account *PurpleAccount, conv string, fbids []int64) {
+	ids := make([]string, len(fbids))
+	for i, f := range fbids {
+		ids[i] = strconv.FormatInt(f, 10)
+	}
+	msg := C.gometa_message_t{account: account, msgtype: C.char(C.gometa_message_type_members)}
+	msg.conv = C.CString(conv)
+	if len(ids) > 0 {
+		msg.text = C.CString(strings.Join(ids, "\x1f"))
+	}
+	C.gometa_process_message(msg)
+}
+
+// handleThreadNames takes a group's new name (LSSyncUpdateThreadName): the chat is named again.
+func (h *gometaHandler) handleThreadNames(tbl *table.LSTable) {
+	for _, n := range tbl.LSSyncUpdateThreadName {
+		name := n.ThreadName
+		if name == "" {
+			name = n.ThreadName1
+		}
+		h.mu.Lock()
+		isGroup := h.threadGroup[n.ThreadKey]
+		h.mu.Unlock()
+		if n.ThreadKey != 0 && name != "" && isGroup {
+			h.notifyChat(n.ThreadKey, name)
+		}
+	}
+}
diff --git a/gometa_groups_test.go b/gometa_groups_test.go
new file mode 100644
index 0000000..5590e25

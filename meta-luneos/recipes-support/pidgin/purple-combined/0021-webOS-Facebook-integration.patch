+//go:build gometa
+
+package main
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+)
+
+// ---- own edits and deletes ----
+
+func TestGometaEditOfAPlainMessageIsAnEditTask(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendEdit(itoa(gmPeer), "mid.$abc", "fixed")
+	want := &socket.EditMessageTask{MessageID: "mid.$abc", Text: "fixed"}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) || r.tasks[0].stateless || len(r.sentFB) != 0 {
+		t.Fatalf("tasks %+v sentFB %+v, want %+v", r.tasks, r.sentFB, want)
+	}
+}
+
+func gmEditOf(t *testing.T, s gmSentFB) *waConsumerApplication.ConsumerApplication_EditMessage {
+	t.Helper()
+	ca, ok := s.msg.(*waConsumerApplication.ConsumerApplication)
+	if !ok {
+		t.Fatalf("not a ConsumerApplication: %T", s.msg)
+	}
+	return ca.GetPayload().GetContent().GetEditMessage()
+}
+
+func TestGometaEditOfAnEncryptedMessageGoesOverWhatsmeow(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeMsgMeta["7001"] = e2eeMsgInfo{fromMe: true, sender: itoa(gmSelf), text: "teh"}
+	h.sendEdit(itoa(gmPeer), "7001", "the")
+	if len(r.sentFB) != 1 || len(r.tasks) != 0 {
+		t.Fatalf("sentFB %+v tasks %+v", r.sentFB, r.tasks)
+	}
+	s := r.sentFB[0]
+	edit := gmEditOf(t, s)
+	key := edit.GetKey()
+	if s.to != gmJID(gmPeer) || key.GetID() != "7001" || !key.GetFromMe() || key.GetRemoteJID() != gmJID(gmPeer).String() ||
+		key.Participant != nil || edit.GetMessage().GetText() != "the" || edit.GetTimestampMS() == 0 {
+		t.Errorf("edit to %v: %+v", s.to, edit)
+	}
+	if s.id == "" || s.id == "7001" {
+		t.Errorf("the edit goes under its own id, got %q", s.id)
+	}
+	if h.e2eeMsgMeta["7001"].text != "the" {
+		t.Errorf("a reply would quote %q", h.e2eeMsgMeta["7001"].text)
+	}
+}
+
+func TestGometaEditInAnEncryptedGroupNamesUsAsSender(t *testing.T) {
+	h, r := newTestGometa(t)
+	group := waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "9001", gmText("hi")))
+	h.sendEdit(itoa(gmGroup), "9100", "edited")
+	if len(r.sentFB) != 1 {
+		t.Fatalf("sentFB %+v", r.sentFB)
+	}
+	key := gmEditOf(t, r.sentFB[0]).GetKey()
+	if r.sentFB[0].to != group || key.GetParticipant() != gmJID(gmSelf).String() || !key.GetFromMe() {
+		t.Errorf("to %v key %+v", r.sentFB[0].to, key)
+	}
+}
+
+func TestGometaDeleteOfAPlainMessageIsADeleteTask(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendDelete(itoa(gmPeer), "mid.$gone")
+	want := &socket.DeleteMessageTask{MessageId: "mid.$gone"}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) || len(r.sentFB) != 0 {
+		t.Fatalf("tasks %+v sentFB %+v", r.tasks, r.sentFB)
+	}
+}
+
+func TestGometaDeleteOfAnEncryptedMessageIsARevoke(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendDelete(itoa(gmPeer), "7002")
+	if len(r.sentFB) != 1 || len(r.tasks) != 0 {
+		t.Fatalf("sentFB %+v tasks %+v", r.sentFB, r.tasks)
+	}
+	ca := r.sentFB[0].msg.(*waConsumerApplication.ConsumerApplication)
+	key := ca.GetPayload().GetApplicationData().GetRevoke().GetKey()
+	if key.GetID() != "7002" || !key.GetFromMe() || key.GetRemoteJID() != gmJID(gmPeer).String() {
+		t.Errorf("revoke key %+v", key)
+	}
+}
+
+func TestGometaEditAndDeleteSayWhatFailed(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.sendErr = errors.New("offline")
+	h.sendEdit(itoa(gmPeer), "7003", "x")
+	h.sendDelete(itoa(gmPeer), "7003")
+	if len(r.failures) != 2 || !strings.Contains(r.failures[0], "edit") || !strings.Contains(r.failures[1], "delete") {
+		t.Errorf("failures %q", r.failures)
+	}
+}
+
+func TestGometaEditNeedsAChatAMessageAndText(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendEdit("Facebook", "mid.$x", "x")
+	h.sendEdit(itoa(gmPeer), "", "x")
+	h.sendEdit(itoa(gmPeer), "mid.$x", "  ")
+	h.sendDelete(itoa(gmPeer), "")
+	if len(r.tasks)+len(r.sentFB)+len(r.failures) != 0 {
+		t.Errorf("tasks %+v sentFB %+v failures %q", r.tasks, r.sentFB, r.failures)
+	}
+}
+
+// ---- mentions sent ----
+
+func TestGometaMentionsParse(t *testing.T) {
+	got := gometaParseMentions(itoa(gmPeer) + "\x1fAnna\x1e" + "x\x1fNobody\x1e" + itoa(gmPeer2) + "\x1fAnnabel\x1e\x1fEmpty\x1e" + itoa(gmPeer) + "\x1f")
+	want := []gometaMention{{gmPeer2, "Annabel"}, {gmPeer, "Anna"}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("got %+v, want %+v", got, want)
+	}
+	if gometaParseMentions("") != nil {
+		t.Error("mentions from nothing")
+	}
+}
+
+func TestGometaMentionDataCountsUTF16(t *testing.T) {
+	mentions := []gometaMention{{gmPeer2, "Annabel"}, {gmPeer, "Anna"}}
+	// "😀" is two UTF-16 units; "é" one, and two bytes.
+	got := gometaMentionData("😀 hé @Anna, @Annabel and @Annal", mentions)
+	want := &socket.MentionData{
+		MentionIDs: itoa(gmPeer) + "," + itoa(gmPeer2), MentionOffsets: "6,13", MentionLengths: "5,8", MentionTypes: "p,p",
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("got %+v, want %+v", got, want)
+	}
+	if gometaMentionData("@Anna", nil) != nil || gometaMentionData("no one", mentions) != nil {
+		t.Error("mention data without a mention")
+	}
+}
+
+func TestGometaPlainGroupMessageCarriesItsMentions(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.confirm = true
+	h.threadGroup[gmGroup] = true
+	h.sendMessage(itoa(gmGroup), "hi @Anna", "", gometaSendExtras{mentions: itoa(gmPeer) + "\x1fAnna"})
+	if len(r.sent) != 1 {
+		t.Fatalf("sent %+v", r.sent)
+	}
+	want := &socket.MentionData{MentionIDs: itoa(gmPeer), MentionOffsets: "3", MentionLengths: "5", MentionTypes: "p"}
+	if r.sent[0].Text != "hi @Anna" || !reflect.DeepEqual(r.sent[0].MentionData, want) {
+		t.Errorf("text %q mentions %+v", r.sent[0].Text, r.sent[0].MentionData)
+	}
+}
+
+func TestGometaEncryptedMessageKeepsItsMentionsAsText(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendMessage(itoa(gmPeer), "hi @Anna", "", gometaSendExtras{mentions: itoa(gmPeer) + "\x1fAnna"})
+	if len(r.sentFB) != 1 {
+		t.Fatalf("sentFB %+v", r.sentFB)
+	}
+	ca := r.sentFB[0].msg.(*waConsumerApplication.ConsumerApplication)
+	if got := ca.GetPayload().GetContent().GetMessageText().GetText(); got != "hi @Anna" {
+		t.Errorf("text %q", got)
+	}
+}
+
+// ---- a plain reply keeps its quote ----
+
+func TestGometaPlainReplyKeepsItsQuote(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.contactName[gmPeer2] = "Ben"
+	m := gmInsert("mid.r", "yes", gmPeer)
+	m.ReplySourceId, m.ReplyMessageText, m.ReplyToUserId = "mid.q", "coming?", gmPeer2
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{m}})
+	got := onlyMessage(t, r)
+	if got.quotedID != "mid.q" || got.quotedText != "coming?" || got.quotedFrom != "Ben" || got.text != "yes" {
+		t.Errorf("got %+v", got)
+	}
+}
+
+func TestGometaPlainReplyToAPictureQuotesItsSnippet(t *testing.T) {
+	h, r := newTestGometa(t)
+	m := gmInsert("mid.r2", "nice", gmPeer)
+	m.ReplySourceId, m.ReplySnippet, m.ReplyToUserId = "mid.p", "You sent a photo.", gmSelf
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{m}})
+	got := onlyMessage(t, r)
+	if got.quotedID != "mid.p" || got.quotedText != "You sent a photo." || got.quotedFrom != "" {
+		t.Errorf("got %+v", got)
+	}
+}
+
+func TestGometaPlainMessageWithoutReplyHasNoQuote(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{gmInsert("mid.n", "hi", gmPeer)}})
+	got := onlyMessage(t, r)
+	if got.quotedID != "" || got.quotedText != "" || got.quotedFrom != "" {
+		t.Errorf("got %+v", got)
+	}
+}
+
+// ---- a group's news as a notice ----
+
+func TestGometaGroupNewsIsANotice(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	news := gmInsert("mid.admin", "Anna named the group Friends.", gmPeer)
+	news.ThreadKey, news.IsAdminMessage = gmGroup, true
+	left := gmInsert("mid.left", "You left the group.", gmSelf)
+	left.ThreadKey, left.IsAdminMessage, left.TimestampMs = gmGroup, true, 1700000001000
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{news, left}})
+	want := []gmNotice{
+		{itoa(gmGroup), true, "Anna named the group Friends.", 1700000000},
+		{itoa(gmGroup), true, "You left the group.", 1700000001},
+	}
+	if !reflect.DeepEqual(r.notices, want) || len(r.messages) != 0 {
+		t.Errorf("notices %+v messages %+v, want %+v", r.notices, r.messages, want)
+	}
+	h.markRead(itoa(gmGroup))
+	if len(r.tasks) != 0 {
+		t.Errorf("a read receipt for news alone: %+v", r.tasks)
+	}
+}
+
+func TestGometaNewsInAOneToOneChatIsANoticeThere(t *testing.T) {
+	h, r := newTestGometa(t)
+	nick := gmInsert("mid.nick", "Anna set your nickname to Bear.", gmPeer)
+	nick.IsAdminMessage = true
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{nick}})
+	if len(r.notices) != 1 || r.notices[0].conv != itoa(gmPeer) || r.notices[0].isGroup || len(r.messages) != 0 {
+		t.Errorf("notices %+v messages %+v", r.notices, r.messages)
+	}
+}

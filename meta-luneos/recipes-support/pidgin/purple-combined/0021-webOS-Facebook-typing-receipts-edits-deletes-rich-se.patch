diff --git a/glue/tests/login_gate_test.cpp b/glue/tests/login_gate_test.cpp
new file mode 100644
index 0000000..8aa85c9
--- /dev/null
+++ b/glue/tests/login_gate_test.cpp
@@ -0,0 +1,192 @@
+// Tests glue/login.c's gate for the transport's webos-im-* signals: each goes to the Go half of
+// the account's own prpl - WhatsApp's or Facebook's (gometa) - and FALSE for any other account,
+// so the transport, which takes the first TRUE, tries the next plugin. libpurple and the Go
+// exports are faked below.
+#include <gtest/gtest.h>
+#include <map>
+#include <string>
+#include <vector>
+
+extern "C" {
+#include <purple.h>
+#include "gometabridge.h"
+void webos_connect_send_reaction_once(void);
+}
+// glue/gowhatsapp.h is C only
+#define GOWHATSAPP_PRPL_ID "prpl-hehoe-whatsmeow"
+
+namespace {
+
+struct Account {
+	PurpleAccount account;
+	const char *protocol;
+};
+Account facebook{{}, GOMETA_PLUGIN_ID}, whatsapp{{}, GOWHATSAPP_PRPL_ID}, other{{}, "prpl-telegram"};
+
+int handle;
+std::map<std::string, PurpleCallback> callbacks; // by signal
+std::vector<std::string> calls;                  // "<go export> <args>", in order
+int go_result = 1;                               // what the Go exports answer
+
+void record(const std::string &what) { calls.push_back(what); }
+
+// login.c connects once per process (a static guard), so the callbacks stay from the first call.
+void connect_all() {
+	calls.clear();
+	go_result = 1;
+	webos_connect_send_reaction_once();
+}
+
+typedef gboolean (*EditCb)(PurpleAccount *, const char *, const char *, const char *, void *);
+typedef gboolean (*DeleteCb)(PurpleAccount *, const char *, const char *, void *);
+
+gboolean edit(Account &a, const char *chat, const char *id, const char *text) {
+	return reinterpret_cast<EditCb>(callbacks.at("webos-im-send-edit"))(&a.account, chat, id, text, nullptr);
+}
+gboolean del(Account &a, const char *chat, const char *id) {
+	return reinterpret_cast<DeleteCb>(callbacks.at("webos-im-send-delete"))(&a.account, chat, id, nullptr);
+}
+
+typedef gboolean (*TwoCb)(PurpleAccount *, const char *, const char *, void *);
+typedef gboolean (*OneCb)(PurpleAccount *, const char *, void *);
+
+gboolean two(const char *signal, Account &a, const char *x, const char *y) {
+	return reinterpret_cast<TwoCb>(callbacks.at(signal))(&a.account, x, y, nullptr);
+}
+gboolean leave(Account &a, const char *chat) {
+	return reinterpret_cast<OneCb>(callbacks.at("webos-im-group-leave"))(&a.account, chat, nullptr);
+}
+
+} // namespace
+
+extern "C" {
+const char *purple_account_get_protocol_id(const PurpleAccount *a) {
+	return reinterpret_cast<const Account *>(a)->protocol;
+}
+void *purple_conversations_get_handle(void) { return &handle; }
+PurpleCore *purple_get_core(void) { return reinterpret_cast<PurpleCore *>(&handle); }
+gulong purple_signal_connect(void *, const char *signal, void *, PurpleCallback func, void *) {
+	callbacks[signal] = func;
+	return 1;
+}
+int gowhatsapp_go_send_edit(PurpleAccount *, char *chat, char *id, char *text) {
+	record(std::string("wa-edit ") + chat + " " + id + " " + text);
+	return go_result;
+}
+int gowhatsapp_go_send_delete(PurpleAccount *, char *chat, char *id) {
+	record(std::string("wa-delete ") + chat + " " + id);
+	return go_result;
+}
+#define GROUP_FAKE(prefix, tag, op) \
+	int prefix##_go_group_##op(PurpleAccount *, char *x, char *y) { \
+		record(std::string(tag " " #op " ") + x + " " + y); \
+		return go_result; \
+	}
+GROUP_FAKE(gowhatsapp, "wa", create)
+GROUP_FAKE(gowhatsapp, "wa", invite)
+GROUP_FAKE(gowhatsapp, "wa", remove)
+GROUP_FAKE(gowhatsapp, "wa", rename)
+GROUP_FAKE(gometa, "fb", create)
+GROUP_FAKE(gometa, "fb", invite)
+GROUP_FAKE(gometa, "fb", remove)
+GROUP_FAKE(gometa, "fb", rename)
+int gowhatsapp_go_group_leave(PurpleAccount *, char *chat) {
+	record(std::string("wa leave ") + chat);
+	return go_result;
+}
+int gometa_go_group_leave(PurpleAccount *, char *chat) {
+	record(std::string("fb leave ") + chat);
+	return go_result;
+}
+// WhatsApp's rename asks whether the group is known here: this one is
+PurpleChat *gowhatsapp_find_blist_chat(PurpleAccount *, const char *) { return reinterpret_cast<PurpleChat *>(&handle); }
+int gometa_go_send_edit(PurpleAccount *, char *chat, char *id, char *text) {
+	record(std::string("fb-edit ") + chat + " " + id + " " + text);
+	return go_result;
+}
+int gometa_go_send_delete(PurpleAccount *, char *chat, char *id) {
+	record(std::string("fb-delete ") + chat + " " + id);
+	return go_result;
+}

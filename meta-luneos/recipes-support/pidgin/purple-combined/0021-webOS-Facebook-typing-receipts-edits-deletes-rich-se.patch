+TEST(LoginGate, EditGoesToTheAccountsOwnPrpl) {
+	connect_all();
+	EXPECT_TRUE(edit(whatsapp, "1@s.whatsapp.net", "A1", "fixed"));
+	EXPECT_TRUE(edit(facebook, "100000000000002", "mid.$x", "fixed"));
+	EXPECT_FALSE(edit(other, "x", "y", "z"));
+	std::vector<std::string> want{"wa-edit 1@s.whatsapp.net A1 fixed", "fb-edit 100000000000002 mid.$x fixed"};
+	EXPECT_EQ(calls, want);
+}
+
+TEST(LoginGate, DeleteGoesToTheAccountsOwnPrpl) {
+	connect_all();
+	EXPECT_TRUE(del(whatsapp, "1@s.whatsapp.net", "A1"));
+	EXPECT_TRUE(del(facebook, "100000000000002", "7001"));
+	EXPECT_FALSE(del(other, "x", "y"));
+	std::vector<std::string> want{"wa-delete 1@s.whatsapp.net A1", "fb-delete 100000000000002 7001"};
+	EXPECT_EQ(calls, want);
+}
+
+// A Facebook account not signed in here: Go says so, and the transport hears FALSE.
+TEST(LoginGate, AnAccountGoDoesNotHaveIsFalse) {
+	connect_all();
+	go_result = 0;
+	EXPECT_FALSE(edit(facebook, "100000000000002", "mid.$x", "fixed"));
+	EXPECT_FALSE(del(facebook, "100000000000002", "mid.$x"));
+}
+
+TEST(LoginGate, MissingArgumentsAreFalse) {
+	connect_all();
+	EXPECT_FALSE(edit(facebook, nullptr, "mid.$x", "t"));
+	EXPECT_FALSE(edit(facebook, "1", nullptr, "t"));
+	EXPECT_FALSE(edit(facebook, "1", "mid.$x", nullptr));
+	EXPECT_FALSE(del(facebook, "1", nullptr));
+	EXPECT_FALSE(edit(whatsapp, nullptr, "A1", "t"));
+	EXPECT_TRUE(calls.empty());
+}
+
+// The group signals (new group, add, remove, rename, leave) go to the account's own prpl too.
+TEST(LoginGate, GroupChangesGoToTheAccountsOwnPrpl) {
+	connect_all();
+	const char *fb = "900000000000009", *people = "100000000000002\x1f" "100000000000003";
+	EXPECT_TRUE(two("webos-im-group-create", facebook, "Friends", people));
+	EXPECT_TRUE(two("webos-im-group-invite", facebook, fb, "100000000000004"));
+	EXPECT_TRUE(two("webos-im-group-remove", facebook, fb, "100000000000002"));
+	EXPECT_TRUE(two("webos-im-group-rename", facebook, fb, "Team"));
+	EXPECT_TRUE(leave(facebook, fb));
+	EXPECT_TRUE(two("webos-im-group-create", whatsapp, "Friends", "1@s.whatsapp.net"));
+	EXPECT_TRUE(two("webos-im-group-rename", whatsapp, "1-2@g.us", "Team"));
+	EXPECT_TRUE(leave(whatsapp, "1-2@g.us"));
+	EXPECT_FALSE(two("webos-im-group-create", other, "Friends", "x"));
+	EXPECT_FALSE(two("webos-im-group-invite", other, "x", "y"));
+	EXPECT_FALSE(two("webos-im-group-remove", other, "x", "y"));
+	EXPECT_FALSE(two("webos-im-group-rename", other, "x", "y"));
+	EXPECT_FALSE(leave(other, "x"));
+	std::vector<std::string> want{
+		std::string("fb create Friends ") + people,
+		"fb invite 900000000000009 100000000000004",
+		"fb remove 900000000000009 100000000000002",
+		"fb rename 900000000000009 Team",
+		"fb leave 900000000000009",
+		"wa create Friends 1@s.whatsapp.net",
+		"wa rename 1-2@g.us Team",
+		"wa leave 1-2@g.us",
+	};
+	EXPECT_EQ(calls, want);
+}
+
+TEST(LoginGate, GroupChangesGoDoesNotTakeOrWithoutArgumentsAreFalse) {
+	connect_all();
+	EXPECT_FALSE(two("webos-im-group-create", facebook, nullptr, "1"));
+	EXPECT_FALSE(two("webos-im-group-create", facebook, "Friends", nullptr));
+	EXPECT_FALSE(two("webos-im-group-invite", facebook, nullptr, "1"));
+	EXPECT_FALSE(two("webos-im-group-remove", facebook, "9", nullptr));
+	EXPECT_FALSE(two("webos-im-group-rename", facebook, "9", ""));
+	EXPECT_FALSE(two("webos-im-group-rename", facebook, "", "Team"));
+	EXPECT_FALSE(leave(facebook, nullptr));
+	EXPECT_TRUE(calls.empty());
+	go_result = 0;
+	EXPECT_FALSE(two("webos-im-group-rename", facebook, "9", "Team"));
+	EXPECT_FALSE(leave(facebook, "9"));
+}

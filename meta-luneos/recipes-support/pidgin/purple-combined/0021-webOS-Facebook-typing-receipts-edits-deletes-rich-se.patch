+package main
+
+// webOS: what the Messaging app does to a Facebook message besides sending it: our own message
+// edited or deleted for everyone, as the transport's webos-im-send-edit and -send-delete signals
+// bring it (glue/login.c), and who a message mentions. Each export says whether this account is
+// connected here, which is what the signal returns to the transport, and does the network call on
+// a goroutine, as a send does. What fails is said as the sends say it (notifyError).
+//
+// The message is named by the id it is stored under (gometa_edits.go): a plain chat's Facebook
+// MessageId ("mid.$..."), which an EditMessageTask or DeleteMessageTask takes, as mautrix-meta's
+// HandleMatrixEdit and HandleMatrixMessageRemove send them; anything else is an encrypted
+// message's whatsmeow id, edited or revoked over the whatsmeow client with a MessageKey naming
+// it, as mautrix-meta does there too.
+
+/*
+#include "gometabridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf16"
+	"unicode/utf8"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/methods"
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"google.golang.org/protobuf/proto"
+)
+
+// gometaActionHandler is the account's handler when it is signed in here.
+func gometaActionHandler(account *PurpleAccount) (*gometaHandler, bool) {
+	h, ok := gometaHandlers[account]
+	return h, ok && h != nil && h.client != nil
+}
+
+//export gometa_go_send_edit
+func gometa_go_send_edit(account *PurpleAccount, chat *C.char, id *C.char, text *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	go h.sendEdit(C.GoString(chat), C.GoString(id), C.GoString(text))
+	return 1
+}
+
+//export gometa_go_send_delete
+func gometa_go_send_delete(account *PurpleAccount, chat *C.char, id *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	go h.sendDelete(C.GoString(chat), C.GoString(id))
+	return 1
+}
+
+// gometaIsPlainID tells a plain chat's message id from an encrypted one's.
+func gometaIsPlainID(id string) bool {
+	return strings.HasPrefix(id, "mid.")
+}
+
+// ownE2EEKey is the MessageKey of an encrypted message we sent: a group's names us as its sender.
+func (h *gometaHandler) ownE2EEKey(chat waTypes.JID, id string) *waCommon.MessageKey {
+	key := &waCommon.MessageKey{RemoteJID: proto.String(chat.String()), FromMe: proto.Bool(true), ID: proto.String(id)}
+	if chat.Server != waTypes.MessengerServer && chat.Server != waTypes.DefaultUserServer {
+		key.Participant = proto.String(waTypes.JID{User: strconv.FormatInt(h.selfID, 10), Server: waTypes.MessengerServer}.String())
+	}
+	return key
+}
+
+// sendEdit edits a message we sent: chat is the thread key, id the message's, text the new text.
+func (h *gometaHandler) sendEdit(chat, id, text string) {
+	threadKey, err := strconv.ParseInt(chat, 10, 64)
+	if err != nil || threadKey == 0 || id == "" || strings.TrimSpace(text) == "" {
+		h.logger.Warn().Str("chat", chat).Msg("edit: no chat, message or text")
+		return
+	}
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	if gometaIsPlainID(id) {
+		err = h.net().fbTask(ctx, &socket.EditMessageTask{MessageID: id, Text: text}, false)
+	} else {
+		to := h.e2eeJID(threadKey)
+		msg := &waConsumerApplication.ConsumerApplication{Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_Content{Content: &waConsumerApplication.ConsumerApplication_Content{
+				Content: &waConsumerApplication.ConsumerApplication_Content_EditMessage{EditMessage: &waConsumerApplication.ConsumerApplication_EditMessage{
+					Key:         h.ownE2EEKey(to, id),
+					Message:     &waCommon.MessageText{Text: proto.String(text)},
+					TimestampMS: proto.Int64(time.Now().UnixMilli()),
+				}},
+			}},
+		}}
+		err = h.net().sendFB(ctx, to, msg, nil, waTypes.MessageID(strconv.FormatInt(methods.GenerateEpochID(), 10)))
+		if err == nil {
+			h.mu.Lock()
+			if meta, ok := h.e2eeMsgMeta[id]; ok {
+				meta.text = text // a later reply quotes the new text
+				h.e2eeMsgMeta[id] = meta
+			}
+			h.mu.Unlock()
+		}
+	}
+	if err != nil {
+		h.logger.Warn().Err(err).Int64("thread", threadKey).Msg("edit not sent")
+		h.notifyError(fmt.Sprintf("Could not edit the Facebook message: %v", err), false)
+	}
+}
+
+// sendDelete deletes a message we sent, for everyone.
+func (h *gometaHandler) sendDelete(chat, id string) {
+	threadKey, err := strconv.ParseInt(chat, 10, 64)
+	if err != nil || threadKey == 0 || id == "" {
+		h.logger.Warn().Str("chat", chat).Msg("delete: no chat or message")
+		return
+	}
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	if gometaIsPlainID(id) {
+		err = h.net().fbTask(ctx, &socket.DeleteMessageTask{MessageId: id}, false)
+	} else {
+		to := h.e2eeJID(threadKey)
+		msg := &waConsumerApplication.ConsumerApplication{Payload: &waConsumerApplication.ConsumerApplication_Payload{
+			Payload: &waConsumerApplication.ConsumerApplication_Payload_ApplicationData{ApplicationData: &waConsumerApplication.ConsumerApplication_ApplicationData{
+				ApplicationContent: &waConsumerApplication.ConsumerApplication_ApplicationData_Revoke{
+					Revoke: &waConsumerApplication.ConsumerApplication_RevokeMessage{Key: h.ownE2EEKey(to, id)},
+				},
+			}},
+		}}
+		err = h.net().sendFB(ctx, to, msg, nil, waTypes.MessageID(strconv.FormatInt(methods.GenerateEpochID(), 10)))
+	}
+	if err != nil {
+		h.logger.Warn().Err(err).Int64("thread", threadKey).Msg("delete not sent")
+		h.notifyError(fmt.Sprintf("Could not delete the Facebook message: %v", err), false)
+	}
+}
+
+// ---- mentions ----
+
+// gometaMention is one "@<name>" of a message and who it is (an fbid).
+type gometaMention struct {
+	fbid int64
+	name string
+}
+
+// gometaParseMentions reads the transport's mentions extra ("<id>\x1f<name>" records joined by
+// "\x1e", imlibpurpleservice SendExtras) for ids that are Facebook users, longest name first so
+// "@Annabel" is matched before "@Anna".
+func gometaParseMentions(s string) []gometaMention {
+	var out []gometaMention
+	for _, record := range strings.Split(s, "\x1e") {
+		fields := strings.Split(record, "\x1f")
+		if len(fields) != 2 || fields[1] == "" {
+			continue
+		}
+		fbid, err := strconv.ParseInt(strings.TrimSpace(fields[0]), 10, 64)
+		if err != nil || fbid <= 0 {
+			continue
+		}
+		out = append(out, gometaMention{fbid: fbid, name: fields[1]})
+	}
+	sort.SliceStable(out, func(i, j int) bool { return len(out[i].name) > len(out[j].name) })
+	return out
+}
+
+// gometaMentionData is a plain message's MentionData for each "@<name>" of the mentions in text,
+// which stays as it is: Messenger shows the name at the offset and links it to the user. Offsets
+// and lengths count UTF-16 units, as Messenger's do (mautrix-meta reads them so, parseMetaMentions).
+// nil for none.
+func gometaMentionData(text string, mentions []gometaMention) *socket.MentionData {
+	if len(mentions) == 0 {
+		return nil
+	}
+	var found socket.Mentions
+	units := 0 // UTF-16 units before byte i
+	for i := 0; i < len(text); {
+		if text[i] == '@' {
+			matched := false
+			for _, m := range mentions {
+				end := i + 1 + len(m.name)
+				if strings.HasPrefix(text[i+1:], m.name) && mention_ends_at(text, end) {
+					length := len(utf16.Encode([]rune(text[i:end])))
+					found = append(found, socket.Mention{ID: m.fbid, Offset: units, Length: length, Type: socket.MentionTypePerson})
+					units += length
+					i = end
+					matched = true
+					break
+				}
+			}
+			if matched {
+				continue
+			}
+		}
+		r, size := utf8.DecodeRuneInString(text[i:])
+		units += len(utf16.Encode([]rune{r}))
+		i += size
+	}
+	return found.ToData()
+}

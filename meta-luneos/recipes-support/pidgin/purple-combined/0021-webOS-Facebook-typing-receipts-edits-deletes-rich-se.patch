diff --git a/glue/gometa_init.c b/glue/gometa_init.c
index 9c9a6ca..c7b3c8f 100644
--- a/glue/gometa_init.c
+++ b/glue/gometa_init.c
@@ -24,6 +24,39 @@ static GList *gometa_status_types(PurpleAccount *account) {
     return types;
 }
 
+// webOS: the Messaging app shows a chat by clearing its unseen count, which libpurple tells as a
+// "conversation-updated" UNSEEN update, as Pidgin does (glue/matrix_init.c does the same for Matrix,
+// glue/receipt.c for WhatsApp). Read receipts for the chat go then: gometa_go_mark_read.
+static void gometa_conversation_updated(PurpleConversation *conv, PurpleConvUpdateType type) {
+    if (type != PURPLE_CONV_UPDATE_UNSEEN) return;
+    PurpleAccount *account = purple_conversation_get_account(conv);
+    if (account == NULL || g_strcmp0(purple_account_get_protocol_id(account), GOMETA_PLUGIN_ID) != 0) return;
+    int unseen = GPOINTER_TO_INT(purple_conversation_get_data(conv, "unseen-count"));
+    int previous = GPOINTER_TO_INT(purple_conversation_get_data(conv, "gometa-previous-unseen-count"));
+    const char *name = purple_conversation_get_name(conv);
+    if (unseen == 0 && previous > 0 && name != NULL && *name) {
+        gometa_go_mark_read(account, (char *)name);
+    }
+    purple_conversation_set_data(conv, "gometa-previous-unseen-count", GINT_TO_POINTER(unseen));
+}
+
+static void gometa_connect_conversation_updated_once(PurpleConnection *pc) {
+    static gulong handler = 0;
+    if (handler == 0) {
+        handler = purple_signal_connect(purple_conversations_get_handle(), "conversation-updated",
+                purple_connection_get_prpl(pc), PURPLE_CALLBACK(gometa_conversation_updated), NULL);
+    }
+}
+
+// webOS: our typing state in a 1:1 chat (the transport sends none to a group chat). PURPLE_TYPED,
+// a pause, is told as not typing, as Facebook has no paused state.
+static unsigned int gometa_send_typing(PurpleConnection *pc, const char *who, PurpleTypingState state) {
+    if (who != NULL && *who) {
+        gometa_go_send_typing(purple_connection_get_account(pc), (char *)who, state == PURPLE_TYPING ? 1 : 0);
+    }
+    return 0;
+}
+
 // login(): hand the account password (Facebook cookie JSON) to Go.
 static void gometa_login(PurpleAccount *account) {
     PurpleConnection *pc = purple_account_get_connection(account);
@@ -33,18 +66,31 @@ static void gometa_login(PurpleAccount *account) {
     char *user_dir = (char *)purple_user_dir();
     gometa_go_login(account, user_dir, username, (char *)(cookies ? cookies : ""), (char *)"");
     webos_connect_send_reaction_once();
+    gometa_connect_conversation_updated_once(pc);
 }
 
 static void gometa_close(PurpleConnection *pc) {
     gometa_go_close(purple_connection_get_account(pc));
 }
 
+// webOS: what the message carries besides its text, which the transport puts on the conversation
+// for the length of serv_send_im/serv_chat_send and frees after (imlibpurpleservice SendExtras.h),
+// as glue/send_message.c reads it for WhatsApp: "webos-send-location" ("<lat>\x1f<lon>\x1f<name>"),
+// "webos-send-contact" (a vCard) and "webos-send-mentions" ("<fbid>\x1f<name>" records joined by
+// "\x1e"). "" for none; Go copies them.
+static char *gometa_send_extra(PurpleConversation *conv, const char *key) {
+    const char *value = conv ? (const char *)purple_conversation_get_data(conv, key) : NULL;
+    return (char *)(value ? value : "");
+}
+
 static int gometa_send_im(PurpleConnection *pc, const char *who, const char *message, PurpleMessageFlags flags) {
     // webOS replies: the transport stashes the reply target's serviceMessageId as "webos-reply-to" on
     // the conversation before serv_send_im; read + clear it and pass it down so the reply threads.
     PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_IM, who, purple_connection_get_account(pc));
     gchar *reply_to = conv ? (gchar *)purple_conversation_get_data(conv, "webos-reply-to") : NULL;
-    int ret = gometa_go_send_message(purple_connection_get_account(pc), (char *)who, (char *)message, reply_to ? (char *)reply_to : (char *)"");
+    int ret = gometa_go_send_message(purple_connection_get_account(pc), (char *)who, (char *)message, reply_to ? (char *)reply_to : (char *)"",
+            gometa_send_extra(conv, "webos-send-location"), gometa_send_extra(conv, "webos-send-contact"),
+            gometa_send_extra(conv, "webos-send-mentions"));
     if (reply_to != NULL) {
         purple_conversation_set_data(conv, "webos-reply-to", NULL);
         g_free(reply_to);
@@ -93,6 +139,9 @@ static void gometa_join_chat(PurpleConnection *pc, GHashTable *components) {
     int chat_id = (int)g_str_hash(id);
     if (purple_find_chat(pc, chat_id) == NULL) {
         serv_got_joined_chat(pc, chat_id, id);
+        // webOS: Go puts the group's members on it (gometa_groups.go), for the transport's
+        // getChatMembers, which joins a Facebook group for them (ChatMembers::joinOpensMembers).
+        gometa_go_chat_joined(purple_connection_get_account(pc), (char *)id);
     }
 }
 
@@ -150,7 +199,9 @@ static int gometa_chat_send(PurpleConnection *pc, int id, const char *message, P
     if (threadKey == NULL || *threadKey == '\0') return -1;
     // webOS replies: read + clear the reply target the transport stashed on this chat conversation.
     gchar *reply_to = (gchar *)purple_conversation_get_data(conv, "webos-reply-to");
-    gometa_go_send_message(purple_connection_get_account(pc), (char *)threadKey, (char *)message, reply_to ? (char *)reply_to : (char *)"");
+    gometa_go_send_message(purple_connection_get_account(pc), (char *)threadKey, (char *)message, reply_to ? (char *)reply_to : (char *)"",
+            gometa_send_extra(conv, "webos-send-location"), gometa_send_extra(conv, "webos-send-contact"),
+            gometa_send_extra(conv, "webos-send-mentions"));
     if (reply_to != NULL) {
         purple_conversation_set_data(conv, "webos-reply-to", NULL);
         g_free(reply_to);
@@ -166,6 +217,7 @@ static PurplePluginProtocolInfo gometa_prpl_info = {
     .login = gometa_login,
     .close = gometa_close,
     .send_im = gometa_send_im,
+    .send_typing = gometa_send_typing,
     .new_xfer = gometa_new_xfer,
     .send_file = gometa_send_file,
     .chat_send_file = gometa_chat_send_file,

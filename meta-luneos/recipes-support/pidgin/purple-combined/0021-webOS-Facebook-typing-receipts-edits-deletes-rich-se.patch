diff --git a/glue/tests/gometa_init_test.cpp b/glue/tests/gometa_init_test.cpp
new file mode 100644
index 0000000..47a1997
--- /dev/null
+++ b/glue/tests/gometa_init_test.cpp
@@ -0,0 +1,277 @@
+// Tests glue/gometa_init.c's webOS parts for Facebook: read receipts go when the Messaging app has
+// shown a chat (libpurple's "conversation-updated" UNSEEN update taking the unseen count from some
+// to none, as glue/matrix_init.c does for Matrix), for a Facebook conversation only, once per
+// showing; the hook is connected once however often an account logs in; and the prpl's send_typing
+// hands "typing" or "not typing" to the Go half; send_im and chat_send hand Go the location and
+// contact card the transport put on the conversation. libpurple and the Go exports are faked below.
+#include <gtest/gtest.h>
+#include <map>
+#include <string>
+#include <vector>
+
+extern "C" {
+#include <purple.h>
+#include "gometabridge.h"
+
+void gometa_test_conversation_updated(PurpleConversation *conv, PurpleConvUpdateType type);
+void gometa_test_login(PurpleAccount *account);
+const PurplePluginProtocolInfo *gometa_test_prpl_info(void);
+}
+
+namespace {
+
+struct Account {
+	PurpleAccount account;
+	const char *protocol;
+};
+Account facebook{{}, GOMETA_PLUGIN_ID}, whatsapp{{}, "prpl-hehoe-whatsmeow"};
+PurpleConnection *const connection = reinterpret_cast<PurpleConnection *>(&facebook);
+
+struct Conv {
+	PurpleConversation conv;
+	Account *account;
+	std::string name;
+	std::map<std::string, gpointer> data;
+};
+
+Conv *conv_of(PurpleConversation *c) { return reinterpret_cast<Conv *>(c); }
+
+std::vector<std::string> marked; // gometa_go_mark_read's who, in order
+std::vector<std::pair<std::string, int>> typed;
+int signal_connects = 0;
+
+struct Sent {
+	std::string who, text, reply_to, location, contact, mentions;
+	bool operator==(const Sent &o) const {
+		return who == o.who && text == o.text && reply_to == o.reply_to && location == o.location && contact == o.contact &&
+			mentions == o.mentions;
+	}
+};
+std::vector<Sent> sent; // gometa_go_send_message's arguments, in order
+std::vector<std::string> joined;  // "<serv_got_joined_chat or gometa_go_chat_joined> <id>", in order
+std::map<std::string, Conv *> ims;  // purple_find_conversation_with_account, by name
+std::map<int, Conv *> chats;        // purple_find_chat, by id
+PurpleCallback connected_cb = nullptr;
+std::string connected_signal;
+
+void reset() {
+	marked.clear();
+	typed.clear();
+	sent.clear();
+	ims.clear();
+	chats.clear();
+	joined.clear();
+}
+
+// What the transport's markRead does (imlibpurpleservice LibpurpleAdapter::markRead): one unseen,
+// then none, each announced.
+void show(Conv *c) {
+	c->data["unseen-count"] = GINT_TO_POINTER(1);
+	gometa_test_conversation_updated(&c->conv, PURPLE_CONV_UPDATE_UNSEEN);
+	c->data["unseen-count"] = GINT_TO_POINTER(0);
+	gometa_test_conversation_updated(&c->conv, PURPLE_CONV_UPDATE_UNSEEN);
+}
+
+} // namespace
+
+extern "C" {
+// libpurple, as gometa_init.c uses it
+PurpleAccount *purple_conversation_get_account(const PurpleConversation *c) {
+	Conv *conv = conv_of(const_cast<PurpleConversation *>(c));
+	return conv->account ? &conv->account->account : nullptr;
+}
+const char *purple_account_get_protocol_id(const PurpleAccount *a) {
+	return reinterpret_cast<const Account *>(a)->protocol;
+}
+gpointer purple_conversation_get_data(PurpleConversation *c, const char *key) {
+	auto it = conv_of(c)->data.find(key);
+	return it == conv_of(c)->data.end() ? nullptr : it->second;
+}
+void purple_conversation_set_data(PurpleConversation *c, const char *key, gpointer data) {
+	conv_of(c)->data[key] = data;
+}
+const char *purple_conversation_get_name(const PurpleConversation *c) {
+	return conv_of(const_cast<PurpleConversation *>(c))->name.c_str();
+}
+PurpleAccount *purple_connection_get_account(const PurpleConnection *pc) {
+	return reinterpret_cast<PurpleAccount *>(const_cast<PurpleConnection *>(pc));
+}
+PurpleConnection *purple_account_get_connection(const PurpleAccount *) { return connection; }
+void purple_connection_set_state(PurpleConnection *, PurpleConnectionState) {}
+const char *purple_account_get_password(const PurpleAccount *) { return ""; }
+const char *purple_account_get_username(const PurpleAccount *) { return "user@example.org"; }
+const char *purple_user_dir(void) { return "/nonexistent"; }
+void *purple_conversations_get_handle(void) { return &signal_connects; }
+PurplePlugin *purple_connection_get_prpl(const PurpleConnection *) { return nullptr; }
+gulong purple_signal_connect(void *, const char *signal, void *, PurpleCallback func, void *) {
+	signal_connects++;
+	connected_signal = signal;
+	connected_cb = func;
+	return 7;
+}
+// the Go half and the rest of the glue
+void gometa_go_login(PurpleAccount *, char *, char *, char *, char *) {}
+void gometa_go_mark_read(PurpleAccount *, char *who) { marked.push_back(who); }
+void gometa_go_send_typing(PurpleAccount *, char *who, int typing) { typed.emplace_back(who, typing); }
+void webos_connect_send_reaction_once(void) {}
+int gometa_go_send_message(PurpleAccount *, char *who, char *text, char *reply_to, char *location, char *contact, char *mentions) {
+	sent.push_back({who, text, reply_to, location, contact, mentions});
+	return 1;
+}
+PurpleConversation *purple_find_conversation_with_account(PurpleConversationType type, const char *name, const PurpleAccount *) {
+	auto it = ims.find(name);
+	return type == PURPLE_CONV_TYPE_IM && it != ims.end() ? &it->second->conv : nullptr;
+}
+PurpleConversation *serv_got_joined_chat(PurpleConnection *, int id, const char *name) {
+	joined.push_back(std::string("joined ") + name);
+	static Conv opened{{}, &facebook, "", {}};
+	opened.name = name;
+	chats[id] = &opened;
+	return &opened.conv;
+}
+void gometa_go_chat_joined(PurpleAccount *a, char *chat) {
+	joined.push_back(std::string(a == &facebook.account ? "members " : "members(other account) ") + chat);
+}
+PurpleConversation *purple_find_chat(const PurpleConnection *, int id) {
+	auto it = chats.find(id);
+	return it == chats.end() ? nullptr : &it->second->conv;
+}
+}
+
+// Shown by the transport: one receipt for the chat, by its name (the thread key).
+TEST(GometaInit, AShownChatIsMarkedReadOnce) {
+	reset();
+	Conv c{{}, &facebook, "100000000000002", {}};
+	show(&c);
+	ASSERT_EQ(marked.size(), 1u);
+	EXPECT_EQ(marked[0], "100000000000002");
+	// Another update while nothing came in between: no second receipt.
+	gometa_test_conversation_updated(&c.conv, PURPLE_CONV_UPDATE_UNSEEN);
+	EXPECT_EQ(marked.size(), 1u);
+	show(&c);
+	EXPECT_EQ(marked.size(), 2u);
+}
+
+// A count that only grows (messages arriving unseen) is no showing.
+TEST(GometaInit, UnseenMessagesAreNoReceipt) {
+	reset();
+	Conv c{{}, &facebook, "100000000000002", {}};
+	for (int n = 1; n <= 3; n++) {
+		c.data["unseen-count"] = GINT_TO_POINTER(n);
+		gometa_test_conversation_updated(&c.conv, PURPLE_CONV_UPDATE_UNSEEN);
+	}
+	EXPECT_TRUE(marked.empty());
+}
+
+// Another prpl's chat, or another kind of update, is left alone.
+TEST(GometaInit, OnlyAFacebookChatsUnseenUpdateCounts) {
+	reset();
+	Conv wa{{}, &whatsapp, "31600000002@s.whatsapp.net", {}};
+	show(&wa);
+	Conv fb{{}, &facebook, "100000000000002", {}};
+	fb.data["unseen-count"] = GINT_TO_POINTER(1);
+	gometa_test_conversation_updated(&fb.conv, PURPLE_CONV_UPDATE_TITLE);
+	fb.data["unseen-count"] = GINT_TO_POINTER(0);
+	gometa_test_conversation_updated(&fb.conv, PURPLE_CONV_UPDATE_TITLE);
+	EXPECT_TRUE(marked.empty());
+	Conv none{{}, nullptr, "x", {}};
+	show(&none);
+	EXPECT_TRUE(marked.empty());
+}
+
+// The hook is connected at the first login, to "conversation-updated", and never again.
+TEST(GometaInit, TheHookIsConnectedOnce) {
+	gometa_test_login(&facebook.account);
+	gometa_test_login(&facebook.account);
+	EXPECT_EQ(signal_connects, 1);
+	EXPECT_EQ(connected_signal, "conversation-updated");
+	ASSERT_NE(connected_cb, nullptr);
+	// It is the read hook: through it a shown chat is marked read.
+	reset();
+	Conv c{{}, &facebook, "100000000000005", {}};
+	c.data["unseen-count"] = GINT_TO_POINTER(1);
+	reinterpret_cast<void (*)(PurpleConversation *, PurpleConvUpdateType)>(connected_cb)(&c.conv, PURPLE_CONV_UPDATE_UNSEEN);
+	c.data["unseen-count"] = GINT_TO_POINTER(0);
+	reinterpret_cast<void (*)(PurpleConversation *, PurpleConvUpdateType)>(connected_cb)(&c.conv, PURPLE_CONV_UPDATE_UNSEEN);
+	EXPECT_EQ(marked, std::vector<std::string>{"100000000000005"});
+}
+
+// send_typing: typing is 1, a pause and stopping are 0; no name, nothing.
+TEST(GometaInit, SendTypingTellsGo) {
+	reset();
+	const PurplePluginProtocolInfo *info = gometa_test_prpl_info();
+	ASSERT_NE(info->send_typing, nullptr);
+	info->send_typing(connection, "100000000000002", PURPLE_TYPING);
+	info->send_typing(connection, "100000000000002", PURPLE_TYPED);
+	info->send_typing(connection, "100000000000002", PURPLE_NOT_TYPING);
+	info->send_typing(connection, "", PURPLE_TYPING);
+	info->send_typing(connection, nullptr, PURPLE_TYPING);
+	std::vector<std::pair<std::string, int>> want{{"100000000000002", 1}, {"100000000000002", 0}, {"100000000000002", 0}};
+	EXPECT_EQ(typed, want);
+}
+
+// send_im: the location and the card the transport put on the chat go to Go with the text; the
+// reply target too, which is then taken off.
+TEST(GometaInit, SendImHandsGoTheLocationAndCard) {
+	reset();
+	const PurplePluginProtocolInfo *info = gometa_test_prpl_info();
+	Conv c{{}, &facebook, "100000000000002", {}};
+	ims[c.name] = &c;
+	c.data["webos-send-location"] = (gpointer) "52.3731000\x1f" "4.8926000\x1f" "Dam Square";
+	c.data["webos-send-contact"] = (gpointer) "BEGIN:VCARD\r\nEND:VCARD\r\n";
+	c.data["webos-reply-to"] = g_strdup("7001");
+	EXPECT_EQ(info->send_im(connection, "100000000000002", "Dam Square", PURPLE_MESSAGE_SEND), 1);
+	// Another chat, with nothing on it: "" for each.
+	EXPECT_EQ(info->send_im(connection, "100000000000003", "hi", PURPLE_MESSAGE_SEND), 1);
+	std::vector<Sent> want{
+		{"100000000000002", "Dam Square", "7001", "52.3731000\x1f" "4.8926000\x1f" "Dam Square", "BEGIN:VCARD\r\nEND:VCARD\r\n", ""},
+		{"100000000000003", "hi", "", "", "", ""}};
+	EXPECT_EQ(sent, want);
+	EXPECT_EQ(c.data["webos-reply-to"], nullptr);
+	// The transport frees the extras itself (SendExtras::clear): they are left where they were.
+	EXPECT_NE(c.data["webos-send-location"], nullptr);
+}
+
+// chat_send: the same for a group, by its thread key.
+TEST(GometaInit, ChatSendHandsGoTheLocationAndCard) {
+	reset();
+	const PurplePluginProtocolInfo *info = gometa_test_prpl_info();
+	Conv g{{}, &facebook, "900000000000009", {}};
+	chats[42] = &g;
+	g.data["webos-send-contact"] = (gpointer) "BEGIN:VCARD\r\nFN:Anna\r\nEND:VCARD\r\n";
+	EXPECT_EQ(info->chat_send(connection, 42, "Anna", PURPLE_MESSAGE_SEND), 0);
+	EXPECT_EQ(info->chat_send(connection, 43, "nowhere", PURPLE_MESSAGE_SEND), -1);
+	std::vector<Sent> want{{"900000000000009", "Anna", "", "", "BEGIN:VCARD\r\nFN:Anna\r\nEND:VCARD\r\n", ""}};
+	EXPECT_EQ(sent, want);
+}
+
+// chat_send: who "@Name" in the text is goes to Go too, as the transport put it on the chat.
+TEST(GometaInit, ChatSendHandsGoTheMentions) {
+	reset();
+	const PurplePluginProtocolInfo *info = gometa_test_prpl_info();
+	Conv g{{}, &facebook, "900000000000009", {}};
+	chats[42] = &g;
+	g.data["webos-send-mentions"] = (gpointer) "100000000000002\x1f" "Anna\x1e" "100000000000003\x1f" "Ben";
+	EXPECT_EQ(info->chat_send(connection, 42, "hi @Anna and @Ben", PURPLE_MESSAGE_SEND), 0);
+	std::vector<Sent> want{{"900000000000009", "hi @Anna and @Ben", "", "", "",
+		"100000000000002\x1f" "Anna\x1e" "100000000000003\x1f" "Ben"}};
+	EXPECT_EQ(sent, want);
+}
+
+// join_chat (the transport's getChatMembers joins a Facebook group for its members): the chat is
+// opened once, and Go asked to put its members on it then.
+TEST(GometaInit, JoiningAGroupPutsItsMembersOnIt) {
+	reset();
+	const PurplePluginProtocolInfo *info = gometa_test_prpl_info();
+	GHashTable *components = g_hash_table_new(g_str_hash, g_str_equal);
+	g_hash_table_insert(components, (gpointer) "id", (gpointer) "900000000000009");
+	info->join_chat(connection, components);
+	info->join_chat(connection, components); // open already: nothing again
+	std::vector<std::string> want{"joined 900000000000009", "members 900000000000009"};
+	EXPECT_EQ(joined, want);
+	reset();
+	g_hash_table_remove(components, "id");
+	info->join_chat(connection, components);
+	EXPECT_TRUE(joined.empty());
+	g_hash_table_destroy(components);
+}

@@ -0,0 +1,271 @@
+package main
+
+import (
+	"errors"
+	"net/url"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	"go.mau.fi/whatsmeow/proto/waMediaTransport"
+	"google.golang.org/protobuf/proto"
+)
+
+// What the app and the transport hand over (chatActions.locationText / contactCard / contactText,
+// SendExtras.cpp).
+const (
+	gmLocText  = "Dam Square\nhttps://maps.google.com/?q=52.3731,4.8926"
+	gmLocExtra = "52.3731000\x1f4.8926000\x1fDam Square"
+	gmCardText = "Anna de Vries\n+31600000004\nanna@example.org"
+	gmCard     = "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Anna de Vries\r\nN:;Anna de Vries;;;\r\n" +
+		"TEL;TYPE=CELL:+31600000004\r\nEMAIL:anna@example.org\r\nEND:VCARD\r\n"
+)
+
+// gmSentText is the text of the one encrypted message sent.
+func gmSentText(t *testing.T, r *gmRecorder) string {
+	t.Helper()
+	return gmSentConsumer(t, r).GetMessageText().GetText()
+}
+
+func gmSentConsumer(t *testing.T, r *gmRecorder) *waConsumerApplication.ConsumerApplication_Content {
+	t.Helper()
+	if len(r.sentFB) != 1 {
+		t.Fatalf("sent %d encrypted messages, want 1", len(r.sentFB))
+	}
+	c, ok := r.sentFB[0].msg.(*waConsumerApplication.ConsumerApplication)
+	if !ok {
+		t.Fatalf("sent %T, want a ConsumerApplication message", r.sentFB[0].msg)
+	}
+	return c.GetPayload().GetContent()
+}
+
+// ---- encrypted chats ----
+
+func TestGometaE2EELocationGoesAsReadableText(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendMessage(itoa(gmPeer), gmLocText, "", gometaSendExtras{location: gmLocExtra})
+	if want := "Location: Dam Square\nhttps://maps.google.com/?q=52.3731,4.8926"; gmSentText(t, r) != want {
+		t.Errorf("sent %q, want %q", gmSentText(t, r), want)
+	}
+	if r.sentFB[0].to != gmJID(gmPeer) {
+		t.Errorf("to %v", r.sentFB[0].to)
+	}
+	// The outbox row is found by the text the app sent; the id is the one we sent with.
+	if want := [][2]string{{string(r.sentFB[0].id), gmLocText}}; !reflect.DeepEqual(r.outbox, want) {
+		t.Errorf("outbox %v, want %v", r.outbox, want)
+	}
+	if len(r.failures) != 0 {
+		t.Errorf("failures %v", r.failures)
+	}
+}
+
+func TestGometaE2EELocationWithoutAName(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendMessage(itoa(gmPeer), "My location\nhttps://maps.google.com/?q=1,2", "", gometaSendExtras{location: "1.0000000\x1f2.0000000\x1f"})
+	if want := "Location\nhttps://maps.google.com/?q=1,2"; gmSentText(t, r) != want {
+		t.Errorf("sent %q, want %q", gmSentText(t, r), want)
+	}
+}
+
+func TestGometaE2EEContactGoesAsReadableText(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendMessage(itoa(gmPeer), gmCardText, "", gometaSendExtras{contact: gmCard})
+	if want := "Contact: Anna de Vries\n+31600000004\nanna@example.org"; gmSentText(t, r) != want {
+		t.Errorf("sent %q, want %q", gmSentText(t, r), want)
+	}
+	if len(r.outbox) != 1 || r.outbox[0][1] != gmCardText {
+		t.Errorf("outbox %v", r.outbox)
+	}
+}
+
+func TestGometaE2EETextStaysAText(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendMessage(itoa(gmPeer), "hello", "", gometaSendExtras{location: "not a place", contact: "not a card"})
+	if got := gmSentText(t, r); got != "hello" {
+		t.Errorf("sent %q", got)
+	}
+}
+
+// Ours comes back (on another of our devices, or here) under the id we sent it with: not shown again.
+func TestGometaE2EEEchoOfOurLocationIsNotShownAgain(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendMessage(itoa(gmPeer), gmLocText, "", gometaSendExtras{location: gmLocExtra})
+	echo := gmFBMessage(gmJID(gmPeer), gmJID(gmSelf), string(r.sentFB[0].id), nil)
+	echo.Info.IsFromMe = true
+	echo.Message = r.sentFB[0].msg.(*waConsumerApplication.ConsumerApplication)
+	h.handleE2EEMessage(echo)
+	if len(r.messages) != 0 {
+		t.Errorf("shown again: %+v", r.messages)
+	}
+	// A reply to it quotes it as it reads.
+	if meta := h.e2eeMsgMeta[string(r.sentFB[0].id)]; !meta.fromMe || !strings.HasPrefix(meta.text, "Location: Dam Square\n") {
+		t.Errorf("cached %+v", meta)
+	}
+}
+
+// A failed send is told, and nothing else goes in its place.
+func TestGometaE2EEFailedSendIsTold(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	r.sendErr = errors.New("socket closed")
+	h.sendMessage(itoa(gmPeer), gmCardText, "", gometaSendExtras{contact: gmCard})
+	if len(r.failures) != 1 || len(r.sentFB) != 0 || len(r.sent) != 0 || len(r.outbox) != 0 {
+		t.Errorf("failures %v sentFB %d sent %d outbox %v", r.failures, len(r.sentFB), len(r.sent), r.outbox)
+	}
+	if len(h.sentOtids) != 0 || len(h.e2eeMsgMeta) != 0 {
+		t.Errorf("kept for a send that did not go: %v %v", h.sentOtids, h.e2eeMsgMeta)
+	}
+	r.sendErr = errGometaE2EEDown
+	h.sendMessage(itoa(gmPeer), gmCardText, "", gometaSendExtras{contact: gmCard})
+	if len(r.failures) != 2 || !strings.Contains(r.failures[1], "isn't connected") {
+		t.Errorf("failures %v", r.failures)
+	}
+}
+
+// ---- plain chats ----
+
+func TestGometaPlainLocationGoesAsReadableText(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.confirm = true
+	h.sendMessage(itoa(gmPeer), gmLocText, "", gometaSendExtras{location: gmLocExtra})
+	if len(r.sent) != 1 || len(r.sentFB) != 0 {
+		t.Fatalf("sent %d plain, %d encrypted", len(r.sent), len(r.sentFB))
+	}
+	if want := "Location: Dam Square\nhttps://maps.google.com/?q=52.3731,4.8926"; r.sent[0].Text != want {
+		t.Errorf("text %q, want %q", r.sent[0].Text, want)
+	}
+	if want := [][2]string{{"mid.$sent", gmLocText}}; !reflect.DeepEqual(r.outbox, want) {
+		t.Errorf("outbox %v, want %v", r.outbox, want)
+	}
+	// Its echo (LSInsertMessage with our otid) is not shown.
+	echo := gmInsert("mid.$sent", r.sent[0].Text, gmSelf)
+	echo.OfflineThreadingId = strconv.FormatInt(r.sent[0].Otid, 10)
+	h.handleMessage(echo, nil)
+	if len(r.messages) != 0 {
+		t.Errorf("echo shown: %+v", r.messages)
+	}
+}
+
+func TestGometaPlainContactGoesAsReadableText(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.confirm = true
+	card := "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Smith\\, Anna\r\nTEL;TYPE=CELL:+31600000004\r\n" +
+		"TEL;TYPE=HOME:+31200000000\r\nEMAIL:anna@example.org\r\nEND:VCARD\r\n"
+	h.sendMessage(itoa(gmPeer), "Smith, Anna\n+31600000004", "", gometaSendExtras{contact: card})
+	if want := "Contact: Smith, Anna\n+31600000004\n+31200000000\nanna@example.org"; len(r.sent) != 1 || r.sent[0].Text != want {
+		t.Errorf("sent %+v, want %q", r.sent, want)
+	}
+}
+
+func TestGometaPlainTextIsSentAsItCame(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.confirm = true
+	h.sendMessage(itoa(gmPeer), "hello", "", gometaSendExtras{})
+	if len(r.sent) != 1 || r.sent[0].Text != "hello" {
+		t.Errorf("sent %+v", r.sent)
+	}
+}
+
+// A plain send Facebook does not confirm was to an encrypted chat: it goes again, encrypted, as text.
+func TestGometaPlainRejectedLocationGoesEncrypted(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendMessage(itoa(gmPeer), gmLocText, "", gometaSendExtras{location: gmLocExtra})
+	if len(r.sent) != 1 {
+		t.Fatalf("plain sends %d", len(r.sent))
+	}
+	if got := gmSentText(t, r); got != r.sent[0].Text {
+		t.Errorf("retry sent %q, plain was %q", got, r.sent[0].Text)
+	}
+	if !h.e2eeContacts[gmPeer] {
+		t.Errorf("chat not remembered as encrypted")
+	}
+}
+
+// ---- received contact cards ----
+
+func gmContactContent(t *testing.T, name, card string) *waConsumerApplication.ConsumerApplication_ContactMessage {
+	t.Helper()
+	cm := &waConsumerApplication.ConsumerApplication_ContactMessage{}
+	tr := &waMediaTransport.ContactTransport{Integral: &waMediaTransport.ContactTransport_Integral{
+		Contact: &waMediaTransport.ContactTransport_Integral_Vcard{Vcard: card}}}
+	if name != "" {
+		tr.Ancillary = &waMediaTransport.ContactTransport_Ancillary{DisplayName: proto.String(name)}
+	}
+	if err := cm.Set(tr); err != nil {
+		t.Fatal(err)
+	}
+	return cm
+}
+
+func gmCardFile(t *testing.T, text string) (string, string) {
+	t.Helper()
+	u, err := url.Parse(text)
+	if err != nil || u.Scheme != "file" || !strings.HasSuffix(u.Path, ".vcf") {
+		t.Fatalf("shown as %q", text)
+	}
+	data, err := os.ReadFile(u.Path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(data), u.Query().Get("name")
+}
+
+func TestGometaE2EEReceivedContactIsAContactChip(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "7001",
+		&waConsumerApplication.ConsumerApplication_Content{Content: &waConsumerApplication.ConsumerApplication_Content_ContactMessage{
+			ContactMessage: gmContactContent(t, "", gmCard)}}))
+	data, name := gmCardFile(t, onlyMessage(t, r).text)
+	if data != gmCard || name != "Anna de Vries" {
+		t.Errorf("kept %q as %q", data, name)
+	}
+}
+
+// One we sent from another of our devices shows the same way, as ours.
+func TestGometaE2EEOurContactFromAnotherDevice(t *testing.T) {
+	h, r := newTestGometa(t)
+	evt := gmFBMessage(gmJID(gmPeer), gmJID(gmSelf), "7101",
+		&waConsumerApplication.ConsumerApplication_Content{Content: &waConsumerApplication.ConsumerApplication_Content_ContactsArrayMessage{
+			ContactsArrayMessage: &waConsumerApplication.ConsumerApplication_ContactsArrayMessage{
+				Contacts: []*waConsumerApplication.ConsumerApplication_ContactMessage{
+					gmContactContent(t, "Anna", gmCard), gmContactContent(t, "Bob", "BEGIN:VCARD\nFN:Bob\nEND:VCARD\n")}}}})
+	evt.Info.IsFromMe = true
+	h.handleE2EEMessage(evt)
+	m := onlyMessage(t, r)
+	data, name := gmCardFile(t, m.text)
+	if !m.isOutgoing || name != "2 contacts" || !strings.Contains(data, "FN:Anna de Vries") || !strings.Contains(data, "FN:Bob") {
+		t.Errorf("shown %+v; kept %q as %q", m, data, name)
+	}
+}
+
+func TestGometaVCardIsACard(t *testing.T) {
+	for in, want := range map[string]bool{
+		gmCard: true, "begin:vcard\nend:vcard": true, "": false, "BEGIN:VCARD\nFN:x": false,
+		"FN:x\nEND:VCARD": false, "BEGIN:VCAR": false,
+	} {
+		if got := gometaVCard(in) != ""; got != want {
+			t.Errorf("%q: %v, want %v", in, got, want)
+		}
+	}
+}
+
+// Cards with no name beside them are named from their FN; several are counted.
+func TestGometaE2EEReceivedCardsWithoutNames(t *testing.T) {

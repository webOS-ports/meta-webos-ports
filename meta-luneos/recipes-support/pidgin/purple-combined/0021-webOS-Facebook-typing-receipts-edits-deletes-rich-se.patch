diff --git a/gometa_send.go b/gometa_send.go
new file mode 100644
index 0000000..60f144c
--- /dev/null
+++ b/gometa_send.go
@@ -0,0 +1,203 @@
+package main
+
+// webOS: a location or a contact card sent from the Messaging app to Facebook. The app sends each as
+// an ordinary message whose text is its plain form ("My location" and a maps link; the name, then
+// each number and address), and the transport puts the thing itself beside the text for the length
+// of the send (imlibpurpleservice SendExtras; glue/gometa_init.c hands both to Go):
+//
+//   location  "<lat>\x1f<lon>\x1f<name>" (parse_webos_location, webos_send.go)
+//   contact   a vCard 3.0
+//
+// Both kinds of chat send each as its text, written as WhatsApp's plugin writes one it cannot show
+// otherwise. A plain chat's SendMessageTask has no location or contact kind (its send types are
+// text, sticker, media, forward and external media; mautrix-meta's from-matrix.go leaves a location
+// "TODO implement"). In an encrypted chat, the "extended content" location share mautrix-meta's
+// msgconv sends (to-whatsapp.go, MsgLocation, without the map preview it says it should upload) and
+// a ConsumerApplication ContactMessage were each accepted by Facebook, yet shown by no Messenger
+// app, not even on our own Android phone (tried 2026-11-09). Until we have one
+// Messenger sent to copy, the text goes: it arrives, and the link opens a map.
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+)
+
+// gometaSendExtras is what an outgoing message carries besides its text; "" for none.
+type gometaSendExtras struct {
+	location string
+	contact  string
+	mentions string // "<fbid>\x1f<name>" records joined by "\x1e" (gometa_actions.go)
+}
+
+// gometaVCard is the card of a contact extra, or "" when it is none.
+func gometaVCard(s string) string {
+	t := strings.TrimSpace(s)
+	if len(t) < len("BEGIN:VCARD") || !strings.EqualFold(t[:len("BEGIN:VCARD")], "BEGIN:VCARD") ||
+		!strings.HasSuffix(strings.ToUpper(t), "END:VCARD") {
+		return ""
+	}
+	return s
+}
+
+// gometaPlainText is what a chat is sent: for a location "Location: <name>" (or "Location")
+// and a maps link any phone opens; for a contact card "Contact: <name>" and each number and
+// address, as WhatsApp's plugin writes a card it cannot keep (formatContactMessage); otherwise
+// the text as it came.
+func gometaPlainText(text string, x gometaSendExtras) string {
+	if loc, ok := parse_webos_location(x.location); ok {
+		head := "Location"
+		if name := strings.TrimSpace(loc.name); name != "" {
+			head += ": " + name
+		}
+		return head + "\nhttps://maps.google.com/?q=" +
+			strconv.FormatFloat(loc.latitude, 'f', -1, 64) + "," + strconv.FormatFloat(loc.longitude, 'f', -1, 64)
+	}
+	if card := gometaVCard(x.contact); card != "" {
+		name := gometaVCardName(card)
+		if name == "" {
+			return text
+		}
+		lines := append([]string{"Contact: " + name}, gometaVCardValues(card, "TEL")...)
+		return strings.Join(append(lines, gometaVCardValues(card, "EMAIL")...), "\n")
+	}
+	return text
+}
+
+// gometaVCardLines are a card's lines with folded ones joined (RFC 6350 3.2).
+func gometaVCardLines(card string) []string {
+	card = strings.ReplaceAll(card, "\r\n", "\n")
+	card = strings.ReplaceAll(card, "\n ", "")
+	card = strings.ReplaceAll(card, "\n\t", "")
+	return strings.Split(card, "\n")
+}
+
+// gometaVCardUnescape undoes a value's escapes (RFC 6350 3.4); a line break becomes a space.
+func gometaVCardUnescape(v string) string {
+	var b strings.Builder
+	for i := 0; i < len(v); i++ {
+		if v[i] == '\\' && i+1 < len(v) {
+			i++
+			switch v[i] {
+			case 'n', 'N':
+				b.WriteByte(' ')
+			default:
+				b.WriteByte(v[i])
+			}
+			continue
+		}
+		b.WriteByte(v[i])
+	}
+	return strings.TrimSpace(b.String())
+}
+
+// gometaVCardValues is each value of a property (TEL, EMAIL), once, in order.
+func gometaVCardValues(card, property string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, line := range gometaVCardLines(card) {
+		colon := strings.IndexByte(line, ':')
+		if colon < 0 {
+			continue
+		}
+		key := line[:colon]
+		if semi := strings.IndexByte(key, ';'); semi >= 0 {
+			key = key[:semi]
+		}
+		if !strings.EqualFold(key, property) {
+			continue
+		}
+		if v := gometaVCardUnescape(line[colon+1:]); v != "" && !seen[v] {
+			seen[v] = true
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// gometaVCardName is the name a card shows: its FN, else its N as "given family".
+func gometaVCardName(card string) string {
+	if fn := gometaVCardValues(card, "FN"); len(fn) > 0 {
+		return fn[0]
+	}
+	return vcard_display_name(card)
+}
+
+// gometaContactText is how a received encrypted contact card (or several) shows: the card kept as
+// a .vcf the Messaging app shows as a contact chip, its name in "?name=", as WhatsApp's plugin
+// keeps one (formatContactMessage); "Contact: <name>" when there is no card to keep.
+func gometaContactText(names []string, cards []string) string {
+	label := ""
+	if len(names) == 1 {
+		label = names[0]
+	} else if len(names) > 1 {
+		label = fmt.Sprintf("%d contacts", len(names))
+	}
+	var all strings.Builder
+	for _, c := range cards {
+		all.WriteString(c)
+		if !strings.HasSuffix(c, "\n") {
+			all.WriteString("\n")
+		}
+	}
+	if label == "" && len(cards) == 1 {
+		label = gometaVCardName(cards[0])
+	}
+	if label == "" {
+		label = "Contact"
+	}
+	if all.Len() == 0 {
+		return "Contact: " + label
+	}
+	sum := sha256.Sum256([]byte(all.String()))
+	path := filepath.Join(gometaAttachmentDir, fmt.Sprintf("contact_%x.vcf", sum[:16]))
+	if err := os.MkdirAll(gometaAttachmentDir, 0o755); err != nil {
+		return "Contact: " + label
+	}
+	if err := os.WriteFile(path, []byte(all.String()), 0o644); err != nil {
+		return "Contact: " + label
+	}
+	return "file://" + path + "?name=" + url.QueryEscape(label)
+}
+
+// gometaE2EEContact reads a received ContactMessage or ContactsArrayMessage: its names and cards,
+// and whether the content is one.
+func gometaE2EEContact(content *waConsumerApplication.ConsumerApplication_Content) (names, cards []string, ok bool) {
+	add := func(cm *waConsumerApplication.ConsumerApplication_ContactMessage) {
+		dec, err := cm.Decode()
+		if err != nil {
+			return
+		}
+		card := dec.GetIntegral().GetVcard()
+		name := dec.GetAncillary().GetDisplayName()
+		if name == "" && card != "" {
+			name = gometaVCardName(card)
+		}
+		if name != "" {
+			names = append(names, name)
+		}
+		if card != "" {
+			cards = append(cards, card)
+		}
+	}
+	if cm := content.GetContactMessage(); cm != nil {
+		add(cm)
+		return names, cards, true
+	}
+	if ca := content.GetContactsArrayMessage(); ca != nil {
+		for _, cm := range ca.GetContacts() {
+			add(cm)
+		}
+		if dn := ca.GetDisplayName(); dn != "" {
+			names = []string{dn}
+		}
+		return names, cards, true
+	}
+	return nil, nil, false
+}
diff --git a/gometa_send_test.go b/gometa_send_test.go

+# gometa_init_test: glue/gometa_init.c's read-receipt hook and send_typing, against fakes of what
+# they call of libpurple and of the Go half (in the test). Needs the libpurple headers and GOHDR.
+gometa_init_test: gometa_init_test.cpp gometa_init_expose.c gometa_init_stubs.c $(GLUE)/gometa_init.c
+	$(CC) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -I$(GOHDR) -DPURPLE_PLUGINS -D_DEFAULT_SOURCE $(CFLAGS) $(SAN) $(INC) -c gometa_init_expose.c -o gometa_init_expose.o
+	$(CC) $(CFLAGS) $(SAN) -c gometa_init_stubs.c -o gometa_init_stubs.o
+	$(CXX) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -DPURPLE_PLUGINS -D_DEFAULT_SOURCE $(CXXFLAGS) $(SAN) $(INC) gometa_init_test.cpp gometa_init_expose.o gometa_init_stubs.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
+# login_gate_test: glue/login.c's gate for the transport's webos-im-* signals, against fakes of
+# what it calls (in the test) and aborting stubs of what it only names (login_gate_stubs.c).
+login_gate_test: login_gate_test.cpp login_gate_expose.c login_gate_stubs.c $(GLUE)/login.c
+	$(CC) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -I$(GOHDR) -DPURPLE_PLUGINS -D_DEFAULT_SOURCE $(CFLAGS) $(SAN) $(INC) -c login_gate_expose.c -o login_gate_expose.o
+	$(CC) $(CFLAGS) $(SAN) -c login_gate_stubs.c -o login_gate_stubs.o
+	$(CXX) $(CPPFLAGS) $(PURPLE_CPPFLAGS) -I$(GLUE)/.. -I$(GOHDR) -DPURPLE_PLUGINS -D_DEFAULT_SOURCE $(CXXFLAGS) $(SAN) $(INC) login_gate_test.cpp login_gate_expose.o login_gate_stubs.o \
+		-o $@ $(LDFLAGS) $(LIBS)
+
 check: all
 	./playout_test
 	./call_playback_test
 	./call_video_test
 	./voipkit_rtcengine_test
 	./display_message_test
+	./gometa_init_test
+	./login_gate_test
 

diff --git a/gometa_edits.go b/gometa_edits.go
new file mode 100644
index 0000000..35f41e3
--- /dev/null
+++ b/gometa_edits.go
@@ -0,0 +1,104 @@
+package main
+
+// webOS: a Facebook message edited or deleted for everyone after it was shown. The transport finds
+// the stored message by the id it was stored under (serviceMessageId) and changes it in place
+// (purple_handle_message_edit / purple_handle_message_delete, bridge.go). That id is the one
+// gometa hands with each message:
+//   encrypted chats: the whatsmeow message id (evt.Info.ID; for our own sends from here, the id we
+//                    sent with, which purple_handle_outbox_id gives the outbox row). An edit's or a
+//                    revoke's MessageKey.ID names it.
+//   plain chats:     the Facebook MessageId ("mid.$..."; for our own sends from here, the one
+//                    LSReplaceOptimsiticMessage gives, also through purple_handle_outbox_id). The
+//                    edit and delete tables name it.
+
+import (
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+// e2eeMayChange tells whether whoever sent evt may edit or delete the message stored under target.
+// The per-message cache (e2eeMsgMeta) knows who sent each encrypted message seen since the plugin
+// started, and an edit or delete from anyone else is dropped. A message from before that is not in
+// the cache: its sender cannot be checked here, and the change is passed on by id as it came.
+func (h *gometaHandler) e2eeMayChange(evt *events.FBMessage, target string) bool {
+	h.mu.Lock()
+	meta, known := h.e2eeMsgMeta[target]
+	h.mu.Unlock()
+	if !known {
+		return true
+	}
+	if meta.fromMe || evt.Info.IsFromMe {
+		return meta.fromMe && evt.Info.IsFromMe
+	}
+	return meta.sender == evt.Info.Sender.User
+}
+
+// handleE2EEEdit takes an encrypted edit: the message under its key's id now reads the new text.
+func (h *gometaHandler) handleE2EEEdit(evt *events.FBMessage, key *waCommon.MessageKey, text string) {
+	target := key.GetID()
+	if target == "" || text == "" || !h.e2eeMayChange(evt, target) {
+		return
+	}
+	h.mu.Lock()
+	if meta, ok := h.e2eeMsgMeta[target]; ok {
+		meta.text = text // a later reply quotes the new text
+		h.e2eeMsgMeta[target] = meta
+	}
+	h.mu.Unlock()
+	h.out().edit(target, text)
+}
+
+// handleE2EERevoke takes an encrypted "delete for everyone".
+func (h *gometaHandler) handleE2EERevoke(evt *events.FBMessage, key *waCommon.MessageKey) {
+	target := key.GetID()
+	if target == "" || !h.e2eeMayChange(evt, target) {
+		return
+	}
+	h.out().remove(target)
+}
+
+// handleEditTables takes a plain chat's edits and deletes. A message deleted and inserted again in
+// the same table was replaced, not deleted (mautrix-meta skips such a thread delete too), so only a
+// delete without an insert counts; LSDeleteThenInsertMessage is a delete only when it says the
+// message was unsent, as mautrix-meta reads it.
+func (h *gometaHandler) handleEditTables(tbl *table.LSTable) {
+	for _, e := range tbl.LSEditMessage {
+		if e.MessageID != "" && e.Text != "" {
+			h.out().edit(e.MessageID, e.Text)
+		}
+	}
+	inserted := make(map[string]bool, len(tbl.LSInsertMessage)+len(tbl.LSUpsertMessage))
+	for _, m := range tbl.LSInsertMessage {
+		inserted[m.MessageId] = !m.IsUnsent
+	}
+	for _, m := range tbl.LSUpsertMessage {
+		inserted[m.MessageId] = !m.IsUnsent
+	}
+	removed := make(map[string]bool)
+	remove := func(id string) {
+		if id != "" && !inserted[id] && !removed[id] {
+			removed[id] = true
+			h.out().remove(id)
+		}
+	}
+	for _, d := range tbl.LSDeleteMessage {
+		remove(d.MessageId)
+	}
+	for _, d := range tbl.LSDeleteThenInsertMessage {
+		if d.IsUnsent {
+			remove(d.MessageId)
+		}
+	}
+	// A message that arrives already unsent (a later sync of one that was shown) is a delete too.
+	for _, m := range tbl.LSInsertMessage {
+		if m.IsUnsent {
+			remove(m.MessageId)
+		}
+	}
+	for _, m := range tbl.LSUpsertMessage {
+		if m.IsUnsent {
+			remove(m.MessageId)
+		}
+	}
+}
diff --git a/gometa_edits_test.go b/gometa_edits_test.go
new file mode 100644
index 0000000..34ba387
--- /dev/null
+++ b/gometa_edits_test.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func gmEditContent(target, text string) *waConsumerApplication.ConsumerApplication_Content {
+	return &waConsumerApplication.ConsumerApplication_Content{Content: &waConsumerApplication.ConsumerApplication_Content_EditMessage{
+		EditMessage: &waConsumerApplication.ConsumerApplication_EditMessage{
+			Key:     &waCommon.MessageKey{ID: proto.String(target)},
+			Message: &waCommon.MessageText{Text: proto.String(text)},
+		}}}
+}
+
+func gmRevoke(chat, sender waTypes.JID, id, target string, fromMe bool) *events.FBMessage {
+	evt := gmFBMessage(chat, sender, id, nil)
+	evt.Info.IsFromMe = fromMe
+	evt.Message = &waConsumerApplication.ConsumerApplication{Payload: &waConsumerApplication.ConsumerApplication_Payload{
+		Payload: &waConsumerApplication.ConsumerApplication_Payload_ApplicationData{ApplicationData: &waConsumerApplication.ConsumerApplication_ApplicationData{
+			ApplicationContent: &waConsumerApplication.ConsumerApplication_ApplicationData_Revoke{Revoke: &waConsumerApplication.ConsumerApplication_RevokeMessage{
+				Key: &waCommon.MessageKey{ID: proto.String(target)}}},
+		}},
+	}}
+	return evt
+}
+
+// ---- encrypted chats ----
+
+func TestGometaE2EEEditChangesTheMessageByItsStoredID(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6001", gmText("helo")))
+	stored := onlyMessage(t, r).id
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6002", gmEditContent("6001", "hello")))
+	if want := []gmEdit{{stored, "hello"}}; !reflect.DeepEqual(r.edits, want) {
+		t.Errorf("edits %+v, want %+v", r.edits, want)
+	}
+	if len(r.messages) != 1 {
+		t.Errorf("the edit was shown as a message of its own: %+v", r.messages)
+	}
+	if h.e2eeMsgMeta["6001"].text != "hello" {
+		t.Errorf("a reply would still quote %q", h.e2eeMsgMeta["6001"].text)
+	}
+}
+
+func TestGometaE2EERevokeDeletesTheMessage(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6101", gmText("oops")))
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmPeer), "6102", "6101", false))
+	if want := []string{"6101"}; !reflect.DeepEqual(r.removes, want) || len(r.messages) != 1 {
+		t.Errorf("removes %+v messages %d", r.removes, len(r.messages))
+	}
+}
+
+// Someone else may not change a message they did not send; we may change our own.
+func TestGometaE2EEOnlyTheSenderMayChangeAMessage(t *testing.T) {
+	h, r := newTestGometa(t)
+	group := waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "6201", gmText("mine to change")))
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer2), "6202", gmEditContent("6201", "forged")))
+	h.handleE2EEMessage(gmRevoke(group, gmJID(gmPeer2), "6203", "6201", false))
+	if len(r.edits)+len(r.removes) != 0 {
+		t.Fatalf("a forged change went through: %+v %+v", r.edits, r.removes)
+	}
+	// our own message, sent from here, deleted from our other device
+	h.e2eeMsgMeta["6300"] = e2eeMsgInfo{fromMe: true, sender: itoa(gmSelf)}
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmSelf), "6301", "6300", true))
+	if want := []string{"6300"}; !reflect.DeepEqual(r.removes, want) {
+		t.Errorf("own delete: %+v", r.removes)
+	}
+	// the other side may not delete ours, and we may not delete theirs
+	h.e2eeMsgMeta["6310"] = e2eeMsgInfo{fromMe: true, sender: itoa(gmSelf)}
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmPeer), "6311", "6310", false))
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6320", gmText("theirs")))
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmSelf), "6321", "6320", true))
+	if want := []string{"6300"}; !reflect.DeepEqual(r.removes, want) {
+		t.Errorf("a delete crossed sides: %+v", r.removes)
+	}
+}
+
+// After a restart the cache is empty: the change still goes, by id.
+func TestGometaE2EEEditOfAMessageFromBeforeTheRestart(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "6402", gmEditContent("6401", "new")))
+	h.handleE2EEMessage(gmRevoke(gmJID(gmPeer), gmJID(gmPeer), "6403", "6400", false))
+	if !reflect.DeepEqual(r.edits, []gmEdit{{"6401", "new"}}) || !reflect.DeepEqual(r.removes, []string{"6400"}) {
+		t.Errorf("edits %+v removes %+v", r.edits, r.removes)
+	}
+}
+
+// ---- plain chats ----
+
+func TestGometaPlainEditAndDelete(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{gmInsert("mid.e", "helo", gmPeer)}})
+	stored := onlyMessage(t, r).id
+	h.parseTable(&table.LSTable{LSEditMessage: []*table.LSEditMessage{{MessageID: "mid.e", Text: "hello", EditCount: 1}}})
+	h.parseTable(&table.LSTable{LSDeleteMessage: []*table.LSDeleteMessage{{ThreadKey: gmPeer, MessageId: "mid.e"}}})
+	if !reflect.DeepEqual(r.edits, []gmEdit{{stored, "hello"}}) || !reflect.DeepEqual(r.removes, []string{stored}) {
+		t.Errorf("edits %+v removes %+v", r.edits, r.removes)
+	}
+}
+
+func TestGometaPlainUnsendIsADelete(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSDeleteThenInsertMessage: []*table.LSDeleteThenInsertMessage{
+		{ThreadKey: gmPeer, MessageId: "mid.u", IsUnsent: true},
+		{ThreadKey: gmPeer, MessageId: "mid.v", IsUnsent: false}, // not an unsend: left alone
+	}})
+	unsent := gmInsert("mid.w", "", gmPeer)
+	unsent.IsUnsent = true
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{unsent}})
+	if want := []string{"mid.u", "mid.w"}; !reflect.DeepEqual(r.removes, want) || len(r.messages) != 0 {
+		t.Errorf("removes %+v messages %+v, want %+v", r.removes, r.messages, want)
+	}
+}
+
+// Deleted and inserted again in one table: replaced, not deleted.
+func TestGometaPlainDeleteThenInsertIsNoDelete(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{
+		LSDeleteMessage: []*table.LSDeleteMessage{{ThreadKey: gmPeer, MessageId: "mid.r"}},
+		LSInsertMessage: []*table.LSInsertMessage{gmInsert("mid.r", "again", gmPeer)},
+	})
+	if len(r.removes) != 0 || len(r.messages) != 1 {
+		t.Errorf("removes %+v messages %+v", r.removes, r.messages)
+	}
+}
diff --git a/gometa_groups.go b/gometa_groups.go
new file mode 100644
index 0000000..461a5f5
--- /dev/null
+++ b/gometa_groups.go
@@ -0,0 +1,422 @@
+package main
+
+// webOS: Facebook group chats - who is in them, and making one, adding and removing people,
+// leaving and renaming, as the transport's webos-im-group-* signals bring them (glue/login.c).
+//
+// Who is in a group comes with the thread rows: LSAddParticipantIdToGroupThread for each member,
+// LSRemoveParticipantFromThread and LSRemoveAllParticipantsForThread when they go. The handler
+// keeps them by thread key, and puts them on the group's chat conversation (gometa_message_type_
+// members, gometabridge.c) whenever they change and when the chat is opened (gometa_go_chat_
+// joined), where the transport's getChatMembers reads them for the app's Group Info and mentions.
+// We are not in our own list: the transport leaves out the account's own name, which for Facebook
+// is the email, not our fbid.
+//
+// The changes are messagix tasks, as mautrix-meta sends them: CreateGroupTask (then
+// RenameThreadTask for its name), AddParticipantsTask, RemoveParticipantTask (with our own fbid
+// to leave) and RenameThreadTask. Facebook says what happened in the group itself, as an admin
+// message the chat shows as a notice (gometa.go). An encrypted group is not a group here yet (its
+// messages come as a 1:1 chat's, gometa_e2ee.go), so none of this is offered for one.
+
+/*
+#include "gometabridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/methods"
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+)
+
+//export gometa_go_group_create
+func gometa_go_group_create(account *PurpleAccount, name *C.char, members *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	title, people := strings.TrimSpace(C.GoString(name)), gometaParseMembers(C.GoString(members))
+	if title == "" || len(people) == 0 {
+		return 0
+	}
+	go h.groupCreate(title, people)
+	return 1
+}
+
+//export gometa_go_group_invite
+func gometa_go_group_invite(account *PurpleAccount, chat *C.char, members *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	threadKey, people := h.plainGroup(C.GoString(chat)), gometaParseMembers(C.GoString(members))
+	if threadKey == 0 || len(people) == 0 {
+		return 0
+	}
+	go h.groupInvite(threadKey, people)
+	return 1
+}
+
+//export gometa_go_group_remove
+func gometa_go_group_remove(account *PurpleAccount, chat *C.char, members *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	threadKey, people := h.plainGroup(C.GoString(chat)), gometaParseMembers(C.GoString(members))
+	if threadKey == 0 || len(people) == 0 {
+		return 0
+	}
+	go h.groupRemove(threadKey, people)
+	return 1
+}
+
+//export gometa_go_group_rename
+func gometa_go_group_rename(account *PurpleAccount, chat *C.char, name *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	threadKey, title := h.plainGroup(C.GoString(chat)), strings.TrimSpace(C.GoString(name))
+	if threadKey == 0 || title == "" {
+		return 0
+	}
+	go h.groupRename(threadKey, title)
+	return 1
+}
+
+//export gometa_go_group_leave
+func gometa_go_group_leave(account *PurpleAccount, chat *C.char) C.int {
+	h, ok := gometaActionHandler(account)
+	if !ok {
+		return 0
+	}
+	threadKey := h.plainGroup(C.GoString(chat))
+	if threadKey == 0 {
+		return 0
+	}
+	go h.groupLeave(threadKey)
+	return 1
+}
+
+// webOS: the group's chat conversation was opened (glue/gometa_init.c, gometabridge.c): put its
+// members on it.
+//
+//export gometa_go_chat_joined
+func gometa_go_chat_joined(account *PurpleAccount, chat *C.char) {
+	if h, ok := gometaHandlers[account]; ok {
+		if threadKey, err := strconv.ParseInt(C.GoString(chat), 10, 64); err == nil {
+			h.pushMembers(threadKey)
+		}
+	}
+}
+
+// gometaParseMembers reads "\x1f"-joined fbids, each once, leaving out what is no fbid.
+func gometaParseMembers(joined string) []int64 {
+	var out []int64
+	seen := map[int64]bool{}
+	for _, s := range strings.Split(joined, "\x1f") {
+		fbid, err := strconv.ParseInt(strings.TrimSpace(s), 10, 64)
+		if err != nil || fbid <= 0 || seen[fbid] {
+			continue
+		}
+		seen[fbid] = true
+		out = append(out, fbid)
+	}
+	return out
+}
+
+// plainGroup is the thread key of chat when it is a plain group chat this account knows, else 0.
+func (h *gometaHandler) plainGroup(chat string) int64 {
+	threadKey, err := strconv.ParseInt(chat, 10, 64)
+	if err != nil || threadKey <= 0 {
+		return 0
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if !h.threadGroup[threadKey] || h.e2eeContacts[threadKey] {
+		return 0
+	}
+	return threadKey
+}
+
+// ---- members ----
+
+// handleParticipantTables keeps who is in each group, and puts a changed group's members on its
+// chat. Removals come first: a table that empties a thread's list fills it again after.
+func (h *gometaHandler) handleParticipantTables(tbl *table.LSTable) {
+	changed := map[int64]bool{}
+	h.mu.Lock()
+	if h.members == nil {
+		h.members = make(map[int64]map[int64]bool)
+	}
+	for _, r := range tbl.LSRemoveAllParticipantsForThread {
+		if r.ThreadKey != 0 {
+			delete(h.members, r.ThreadKey)
+			changed[r.ThreadKey] = true
+		}
+	}
+	for _, r := range tbl.LSRemoveParticipantFromThread {
+		if r.ThreadKey != 0 && r.ParticipantId != 0 {
+			delete(h.members[r.ThreadKey], r.ParticipantId)
+			changed[r.ThreadKey] = true
+		}
+	}
+	for _, p := range tbl.LSAddParticipantIdToGroupThread {
+		if p.ThreadKey == 0 || p.ContactId == 0 {
+			continue
+		}
+		if h.members[p.ThreadKey] == nil {
+			h.members[p.ThreadKey] = make(map[int64]bool)
+		}
+		h.members[p.ThreadKey][p.ContactId] = true
+		changed[p.ThreadKey] = true
+	}
+	h.mu.Unlock()
+	keys := make([]int64, 0, len(changed))
+	for k := range changed {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })
+	for _, k := range keys {
+		h.pushMembers(k)
+	}
+}
+
+// groupMembers is who is in a group besides us, in fbid order.
+func (h *gometaHandler) groupMembers(threadKey int64) []int64 {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	var out []int64
+	for fbid := range h.members[threadKey] {
+		if fbid != h.selfID {
+			out = append(out, fbid)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i] < out[j] })
+	return out
+}
+
+// pushMembers puts a group's members on its chat conversation, if it is a group.
+func (h *gometaHandler) pushMembers(threadKey int64) {
+	h.mu.Lock()
+	isGroup := h.threadGroup[threadKey]
+	h.mu.Unlock()
+	if !isGroup {
+		return
+	}
+	h.out().members(strconv.FormatInt(threadKey, 10), h.groupMembers(threadKey))
+}
+
+// gometaNotifyMembers hands a group's members ("\x1f"-joined fbids, "" for none) to the C bridge.
+func gometaNotifyMembers(account *PurpleAccount, conv string, fbids []int64) {
+	ids := make([]string, len(fbids))
+	for i, f := range fbids {
+		ids[i] = strconv.FormatInt(f, 10)
+	}
+	msg := C.gometa_message_t{account: account, msgtype: C.char(C.gometa_message_type_members)}
+	msg.conv = C.CString(conv)
+	if len(ids) > 0 {
+		msg.text = C.CString(strings.Join(ids, "\x1f"))
+	}
+	C.gometa_process_message(msg)
+}
+
+// handleThreadNames takes a group's new name (LSSyncUpdateThreadName): the chat is named again.
+func (h *gometaHandler) handleThreadNames(tbl *table.LSTable) {
+	for _, n := range tbl.LSSyncUpdateThreadName {
+		name := n.ThreadName
+		if name == "" {
+			name = n.ThreadName1
+		}
+		h.mu.Lock()
+		isGroup := h.threadGroup[n.ThreadKey]
+		h.mu.Unlock()
+		if n.ThreadKey != 0 && name != "" && isGroup {
+			h.notifyChat(n.ThreadKey, name)
+		}
+	}
+}
+
+// ---- changes ----
+
+// groupFailed says in the group what it did not take.
+func (h *gometaHandler) groupFailed(threadKey int64, what string, err error) {
+	h.logger.Warn().Err(err).Int64("thread", threadKey).Str("change", what).Msg("group change failed")
+	h.out().notice(strconv.FormatInt(threadKey, 10), true, fmt.Sprintf("Could not %s: %v", what, err), time.Now().Unix())
+}
+
+// gometaTaskError is the error Facebook answered a task with (LSIssueNewError), else nil.
+func gometaTaskError(resp *table.LSTable) error {
+	if resp == nil || len(resp.LSIssueNewError) == 0 {
+		return nil
+	}
+	e := resp.LSIssueNewError[0]
+	msg := e.ErrorMessage
+	if msg == "" {
+		msg = e.ErrorTitle
+	}
+	if msg == "" {
+		msg = fmt.Sprintf("error %d", e.ErrorCode)
+	}
+	return fmt.Errorf("%s", msg)
+}
+
+// groupTask sends one task and says how it went, Facebook's refusal included.
+func (h *gometaHandler) groupTask(task socket.Task) (*table.LSTable, error) {
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	if err := h.net().waitSend(ctx); err != nil {
+		return nil, err
+	}
+	resp, err := h.net().sendTask(ctx, task)
+	if err != nil {
+		return nil, err
+	}
+	return resp, gometaTaskError(resp)
+}
+
+// groupCreate makes a group of people and names it. It shows up as a chat when Facebook's answer
+// names its thread; a line says it was made unless Facebook's own news already does.
+func (h *gometaHandler) groupCreate(name string, people []int64) {
+	requested := methods.GenerateEpochID()
+	resp, err := h.groupTask(&socket.CreateGroupTask{
+		Participants: people,
+		SendPayload: socket.CreateGroupPayload{
+			ThreadID: requested, OTID: strconv.FormatInt(methods.GenerateEpochID(), 10), Source: 0, SendType: 8,
+		},
+	})
+	var threadKey int64
+	if err == nil {
+		for _, r := range resp.LSReplaceOptimisticThread {
+			if r.ThreadKey1 == requested {
+				threadKey = r.ThreadKey2
+			}
+		}
+		if threadKey == 0 {
+			err = fmt.Errorf("no group in the answer")
+		}
+	}
+	if err != nil {
+		h.logger.Warn().Err(err).Msg("group not created")
+		h.notifyError(fmt.Sprintf("Could not create the Facebook group %q: %v", name, err), false)
+		return
+	}
+	h.mu.Lock()
+	h.threadGroup[threadKey] = true
+	if h.members == nil {
+		h.members = make(map[int64]map[int64]bool)
+	}
+	if h.members[threadKey] == nil {
+		h.members[threadKey] = make(map[int64]bool)
+	}
+	for _, p := range people {
+		h.members[threadKey][p] = true
+	}
+	h.mu.Unlock()
+	h.notifyChat(threadKey, name)
+	if _, err := h.groupTask(&socket.RenameThreadTask{ThreadKey: threadKey, ThreadName: name, SyncGroup: 1}); err != nil {
+		h.groupFailed(threadKey, "name the group", err)
+	}
+	h.pushMembers(threadKey)
+	if !gometaHasNews(resp, threadKey) {
+		h.out().notice(strconv.FormatInt(threadKey, 10), true, fmt.Sprintf("You created the group %q.", name), time.Now().Unix())
+	}
+}
+
+// gometaHasNews tells whether a table has an admin message for the thread.
+func gometaHasNews(tbl *table.LSTable, threadKey int64) bool {
+	if tbl == nil {
+		return false
+	}
+	for _, m := range tbl.LSInsertMessage {
+		if m.ThreadKey == threadKey && m.IsAdminMessage && m.Text != "" {
+			return true
+		}
+	}
+	for _, m := range tbl.LSUpsertMessage {
+		if m.ThreadKey == threadKey && m.IsAdminMessage && m.Text != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// groupInvite adds people to a group.
+func (h *gometaHandler) groupInvite(threadKey int64, people []int64) {
+	_, err := h.groupTask(&socket.AddParticipantsTask{ThreadKey: threadKey, ContactIDs: people, SyncGroup: 1})
+	if err != nil {
+		h.groupFailed(threadKey, "add to the group", err)
+		return
+	}
+	h.mu.Lock()
+	if h.members == nil {
+		h.members = make(map[int64]map[int64]bool)
+	}
+	if h.members[threadKey] == nil {
+		h.members[threadKey] = make(map[int64]bool)
+	}
+	for _, p := range people {
+		h.members[threadKey][p] = true
+	}
+	h.mu.Unlock()
+	h.pushMembers(threadKey)
+}
+
+// groupRemove takes people out of a group, one task each; who went is out of its member list at
+// once. What a change's answer carries besides (Facebook's news of it, the participant rows) comes
+// over the socket too, as for a change made elsewhere, and is taken from there only, so nothing
+// is shown twice.
+func (h *gometaHandler) groupRemove(threadKey int64, people []int64) {
+	removed := false
+	for _, p := range people {
+		if _, err := h.groupTask(&socket.RemoveParticipantTask{ThreadID: threadKey, ContactID: p}); err != nil {
+			h.groupFailed(threadKey, "remove "+h.nameOf(p)+" from the group", err)
+			continue
+		}
+		h.mu.Lock()
+		delete(h.members[threadKey], p)
+		h.mu.Unlock()
+		removed = true
+	}
+	if removed {
+		h.pushMembers(threadKey)
+	}
+}
+
+// nameOf is a person's name, else their fbid.
+func (h *gometaHandler) nameOf(fbid int64) string {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if name := h.contactName[fbid]; name != "" {
+		return name
+	}
+	return strconv.FormatInt(fbid, 10)
+}
+
+// groupRename gives a group a new name; the chat takes it once Facebook has.
+func (h *gometaHandler) groupRename(threadKey int64, name string) {
+	if _, err := h.groupTask(&socket.RenameThreadTask{ThreadKey: threadKey, ThreadName: name, SyncGroup: 1}); err != nil {
+		h.groupFailed(threadKey, "rename the group", err)
+		return
+	}
+	h.notifyChat(threadKey, name)
+}
+
+// groupLeave takes us out of a group.
+func (h *gometaHandler) groupLeave(threadKey int64) {
+	resp, err := h.groupTask(&socket.RemoveParticipantTask{ThreadID: threadKey, ContactID: h.selfID})
+	if err != nil {
+		h.groupFailed(threadKey, "leave the group", err)
+		return
+	}
+	if !gometaHasNews(resp, threadKey) {
+		h.out().notice(strconv.FormatInt(threadKey, 10), true, "You left the group.", time.Now().Unix())
+	}
+}
diff --git a/gometa_groups_test.go b/gometa_groups_test.go
new file mode 100644
index 0000000..d13ce8d
--- /dev/null
+++ b/gometa_groups_test.go
@@ -0,0 +1,279 @@
+package main
+
+import (
+	"errors"
+	"reflect"
+	"strings"
+	"testing"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+)
+
+const gmPeer3 = int64(100000000000004)
+
+func gmGroupOf(h *gometaHandler, members ...int64) {
+	h.threadGroup[gmGroup] = true
+	rows := make([]*table.LSAddParticipantIdToGroupThread, 0, len(members))
+	for _, m := range members {
+		rows = append(rows, &table.LSAddParticipantIdToGroupThread{ThreadKey: gmGroup, ContactId: m})
+	}
+	h.parseTable(&table.LSTable{LSAddParticipantIdToGroupThread: rows})
+}
+
+// ---- members ----
+
+func TestGometaGroupMembersAreOnItsChatWithoutUs(t *testing.T) {
+	h, r := newTestGometa(t)
+	gmGroupOf(h, gmPeer2, gmSelf, gmPeer)
+	if got, want := r.lists[itoa(gmGroup)], []int64{gmPeer, gmPeer2}; !reflect.DeepEqual(got, want) {
+		t.Errorf("members %v, want %v", got, want)
+	}
+}
+
+func TestGometaOneToOneThreadHasNoMemberList(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSAddParticipantIdToGroupThread: []*table.LSAddParticipantIdToGroupThread{
+		{ThreadKey: gmPeer, ContactId: gmPeer}, {ThreadKey: gmPeer, ContactId: gmSelf},
+	}})
+	if len(r.lists) != 0 {
+		t.Errorf("members %v", r.lists)
+	}
+}
+
+func TestGometaRemovedMembersLeaveTheList(t *testing.T) {
+	h, r := newTestGometa(t)
+	gmGroupOf(h, gmPeer, gmPeer2, gmPeer3)
+	h.parseTable(&table.LSTable{LSRemoveParticipantFromThread: []*table.LSRemoveParticipantFromThread{{ThreadKey: gmGroup, ParticipantId: gmPeer2}}})
+	if got, want := r.lists[itoa(gmGroup)], []int64{gmPeer, gmPeer3}; !reflect.DeepEqual(got, want) {
+		t.Errorf("after a removal %v, want %v", got, want)
+	}
+	// a full list again: the old one is dropped first, whatever order the table has them in
+	h.parseTable(&table.LSTable{
+		LSAddParticipantIdToGroupThread:  []*table.LSAddParticipantIdToGroupThread{{ThreadKey: gmGroup, ContactId: gmPeer2}},
+		LSRemoveAllParticipantsForThread: []*table.LSRemoveAllParticipantsForThread{{ThreadKey: gmGroup}},
+	})
+	if got, want := r.lists[itoa(gmGroup)], []int64{gmPeer2}; !reflect.DeepEqual(got, want) {
+		t.Errorf("after a new list %v, want %v", got, want)
+	}
+	h.parseTable(&table.LSTable{LSRemoveAllParticipantsForThread: []*table.LSRemoveAllParticipantsForThread{{ThreadKey: gmGroup}}})
+	if got, ok := r.lists[itoa(gmGroup)]; !ok || len(got) != 0 {
+		t.Errorf("after all left %v (%v)", got, ok)
+	}
+}
+
+func TestGometaOpenedGroupGetsItsMembers(t *testing.T) {
+	h, r := newTestGometa(t)
+	gmGroupOf(h, gmPeer)
+	r.lists = nil
+	h.pushMembers(gmGroup)
+	if got := r.lists[itoa(gmGroup)]; !reflect.DeepEqual(got, []int64{gmPeer}) {
+		t.Errorf("members %v", got)
+	}
+}
+
+func TestGometaGroupRenamedElsewhereIsNamedHere(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	h.parseTable(&table.LSTable{LSSyncUpdateThreadName: []*table.LSSyncUpdateThreadName{
+		{ThreadKey: gmGroup, ThreadName: "Friends"},
+		{ThreadKey: gmGroup, ThreadName1: "Old friends"},
+		{ThreadKey: gmPeer, ThreadName: "not a group"},
+		{ThreadKey: gmGroup},
+	}})
+	want := []gmChat{{gmGroup, "Friends"}, {gmGroup, "Old friends"}}
+	if !reflect.DeepEqual(r.chats, want) {
+		t.Errorf("chats %+v, want %+v", r.chats, want)
+	}
+}
+
+// ---- what the app may change ----
+
+func TestGometaOnlyAPlainKnownGroupIsChanged(t *testing.T) {
+	h, _ := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	if h.plainGroup(itoa(gmGroup)) != gmGroup {
+		t.Error("a plain group refused")
+	}
+	for _, chat := range []string{itoa(gmPeer), "Facebook", "", "-5"} {
+		if h.plainGroup(chat) != 0 {
+			t.Errorf("%q taken as a group", chat)
+		}
+	}
+	h.e2eeContacts[gmGroup] = true
+	if h.plainGroup(itoa(gmGroup)) != 0 {
+		t.Error("an encrypted thread taken as a plain group")
+	}
+}
+
+func TestGometaMembersParse(t *testing.T) {
+	got := gometaParseMembers(itoa(gmPeer) + "\x1f x\x1f" + itoa(gmPeer2) + "\x1f\x1f-3\x1f" + itoa(gmPeer) + "\x1f 0")
+	if want := []int64{gmPeer, gmPeer2}; !reflect.DeepEqual(got, want) {
+		t.Errorf("got %v, want %v", got, want)
+	}
+	if gometaParseMembers("") != nil {
+		t.Error("members from nothing")
+	}
+}
+
+// ---- making a group ----
+
+// gmCreated answers a CreateGroupTask as Facebook does, with the thread it made for the asked id.
+func gmCreated(news bool) func(socket.Task) *table.LSTable {
+	return func(task socket.Task) *table.LSTable {
+		c, ok := task.(*socket.CreateGroupTask)
+		if !ok {
+			return &table.LSTable{}
+		}
+		tbl := &table.LSTable{LSReplaceOptimisticThread: []*table.LSReplaceOptimisticThread{
+			{ThreadKey1: c.SendPayload.ThreadID, ThreadKey2: gmGroup},
+			{ThreadKey1: c.SendPayload.ThreadID + 1, ThreadKey2: 1}, // another thread's
+		}}
+		if news {
+			m := gmInsert("mid.created", "You created the group.", gmSelf)
+			m.ThreadKey, m.IsAdminMessage = gmGroup, true
+			tbl.LSInsertMessage = []*table.LSInsertMessage{m}
+		}
+		return tbl
+	}
+}
+
+func TestGometaNewGroupIsMadeNamedAndShown(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.answer = gmCreated(false)
+	h.groupCreate("Friends", []int64{gmPeer, gmPeer2})
+	if len(r.tasks) != 2 {
+		t.Fatalf("tasks %+v", r.tasks)
+	}
+	c, ok := r.tasks[0].task.(*socket.CreateGroupTask)
+	if !ok || !reflect.DeepEqual(c.Participants, []int64{gmPeer, gmPeer2}) || c.SendPayload.ThreadID == 0 || c.SendPayload.SendType != 8 {
+		t.Errorf("create %+v", r.tasks[0].task)
+	}
+	if want := (&socket.RenameThreadTask{ThreadKey: gmGroup, ThreadName: "Friends", SyncGroup: 1}); !reflect.DeepEqual(r.tasks[1].task, want) {
+		t.Errorf("rename %+v, want %+v", r.tasks[1].task, want)
+	}
+	if !reflect.DeepEqual(r.chats, []gmChat{{gmGroup, "Friends"}}) || !h.threadGroup[gmGroup] {
+		t.Errorf("chats %+v group %v", r.chats, h.threadGroup[gmGroup])
+	}
+	if got := r.lists[itoa(gmGroup)]; !reflect.DeepEqual(got, []int64{gmPeer, gmPeer2}) {
+		t.Errorf("members %v", got)
+	}
+	if len(r.notices) != 1 || r.notices[0].conv != itoa(gmGroup) || !strings.Contains(r.notices[0].text, `"Friends"`) {
+		t.Errorf("notices %+v", r.notices)
+	}
+	if len(r.failures) != 0 {
+		t.Errorf("failures %q", r.failures)
+	}
+}
+
+func TestGometaNewGroupWithFacebooksNewsSaysItOnce(t *testing.T) {
+	h, r := newTestGometa(t)
+	r.answer = gmCreated(true)
+	h.groupCreate("Friends", []int64{gmPeer})
+	if len(r.notices) != 0 {
+		t.Errorf("notices %+v", r.notices)
+	}
+}
+
+func TestGometaNewGroupThatFacebookDidNotMakeSaysSo(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.groupCreate("Friends", []int64{gmPeer}) // answered without a thread
+	if len(r.failures) != 1 || !strings.Contains(r.failures[0], "Friends") || len(r.chats) != 0 || len(r.tasks) != 1 {
+		t.Errorf("failures %q chats %+v tasks %+v", r.failures, r.chats, r.tasks)
+	}
+	r.failures, r.tasks = nil, nil
+	r.answer = func(socket.Task) *table.LSTable {
+		return &table.LSTable{LSIssueNewError: []*table.LSIssueNewError{{ErrorMessage: "not allowed"}}}
+	}
+	h.groupCreate("Friends", []int64{gmPeer})
+	if len(r.failures) != 1 || !strings.Contains(r.failures[0], "not allowed") || len(r.chats) != 0 {
+		t.Errorf("failures %q chats %+v", r.failures, r.chats)
+	}
+}
+
+// ---- changing a group ----
+
+func TestGometaAddingToAGroup(t *testing.T) {
+	h, r := newTestGometa(t)
+	gmGroupOf(h, gmPeer)
+	h.groupInvite(gmGroup, []int64{gmPeer2, gmPeer3})
+	want := &socket.AddParticipantsTask{ThreadKey: gmGroup, ContactIDs: []int64{gmPeer2, gmPeer3}, SyncGroup: 1}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) {
+		t.Fatalf("tasks %+v, want %+v", r.tasks, want)
+	}
+	if got := r.lists[itoa(gmGroup)]; !reflect.DeepEqual(got, []int64{gmPeer, gmPeer2, gmPeer3}) {
+		t.Errorf("members %v", got)
+	}
+}
+
+func TestGometaRemovingFromAGroup(t *testing.T) {
+	h, r := newTestGometa(t)
+	gmGroupOf(h, gmPeer, gmPeer2, gmPeer3)
+	h.groupRemove(gmGroup, []int64{gmPeer, gmPeer3})
+	want := []gmTask{
+		{&socket.RemoveParticipantTask{ThreadID: gmGroup, ContactID: gmPeer}, false},
+		{&socket.RemoveParticipantTask{ThreadID: gmGroup, ContactID: gmPeer3}, false},
+	}
+	if !reflect.DeepEqual(r.tasks, want) {
+		t.Fatalf("tasks %+v, want %+v", r.tasks, want)
+	}
+	if got := r.lists[itoa(gmGroup)]; !reflect.DeepEqual(got, []int64{gmPeer2}) {
+		t.Errorf("members %v", got)
+	}
+}
+
+func TestGometaRemovalFacebookRefusesKeepsTheMemberAndSaysSo(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.contactName[gmPeer] = "Anna"
+	gmGroupOf(h, gmPeer, gmPeer2)
+	r.taskErr = errors.New("not an admin")
+	h.groupRemove(gmGroup, []int64{gmPeer})
+	if got := r.lists[itoa(gmGroup)]; !reflect.DeepEqual(got, []int64{gmPeer, gmPeer2}) {
+		t.Errorf("members %v", got)
+	}
+	if len(r.notices) != 1 || r.notices[0].text != "Could not remove Anna from the group: not an admin" || !r.notices[0].isGroup {
+		t.Errorf("notices %+v", r.notices)
+	}
+}
+
+func TestGometaRenamingAGroup(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	h.groupRename(gmGroup, "Team")
+	want := &socket.RenameThreadTask{ThreadKey: gmGroup, ThreadName: "Team", SyncGroup: 1}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) || !reflect.DeepEqual(r.chats, []gmChat{{gmGroup, "Team"}}) {
+		t.Errorf("tasks %+v chats %+v", r.tasks, r.chats)
+	}
+	r.tasks, r.chats = nil, nil
+	r.answer = func(socket.Task) *table.LSTable {
+		return &table.LSTable{LSIssueNewError: []*table.LSIssueNewError{{ErrorTitle: "Too long"}}}
+	}
+	h.groupRename(gmGroup, "Team!")
+	if len(r.chats) != 0 || len(r.notices) != 1 || r.notices[0].text != "Could not rename the group: Too long" {
+		t.Errorf("chats %+v notices %+v", r.chats, r.notices)
+	}
+}
+
+func TestGometaLeavingAGroup(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	h.groupLeave(gmGroup)
+	want := &socket.RemoveParticipantTask{ThreadID: gmGroup, ContactID: gmSelf}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) {
+		t.Fatalf("tasks %+v, want %+v", r.tasks, want)
+	}
+	if len(r.notices) != 1 || r.notices[0].text != "You left the group." {
+		t.Errorf("notices %+v", r.notices)
+	}
+	// Facebook's own line in the answer is shown when it comes over the socket; ours is not added
+	r.notices = nil
+	r.answer = func(socket.Task) *table.LSTable {
+		m := gmInsert("mid.left", "You left the group.", gmSelf)
+		m.ThreadKey, m.IsAdminMessage = gmGroup, true
+		return &table.LSTable{LSInsertMessage: []*table.LSInsertMessage{m}}
+	}
+	h.groupLeave(gmGroup)
+	if len(r.notices) != 0 {
+		t.Errorf("notices %+v", r.notices)
+	}
+}
diff --git a/gometa_presence.go b/gometa_presence.go
new file mode 100644
index 0000000..f356f34
--- /dev/null
+++ b/gometa_presence.go
@@ -0,0 +1,302 @@
+package main
+
+// webOS: typing, both ways, and read receipts sent, for Facebook. Encrypted chats go over the
+// whatsmeow client, as mautrix-meta's HandleMatrixTyping and HandleMatrixReadReceipt do; plain
+// chats over messagix tasks (UpdatePresenceTask, ThreadMarkReadTask). Typing is for 1:1 chats only:
+// libpurple 2 has no typing state for a group chat.
+//
+// An encrypted chat is read on two networks: the whatsmeow receipt goes to the sender's devices,
+// and Messenger's own apps take a chat's read state from its Facebook ("hybrid") thread, which
+// gets a ThreadMarkReadTask in sync group 95 under its Facebook thread key, as mautrix-meta does
+// since its "mark hybrid threads as read on Lightspeed" (mautrix/meta#474).
+
+/*
+#include "gometabridge.h"
+*/
+import "C"
+
+import (
+	"context"
+	"strconv"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+// gometaMaxUnread bounds the encrypted messages kept per chat for its next read receipt.
+const gometaMaxUnread = 50
+
+// gometaUnread is an encrypted message not yet marked read: the receipt names its chat and sender.
+type gometaUnread struct {
+	id           waTypes.MessageID
+	chat, sender waTypes.JID
+}
+
+// gometaParity is the handler's state for typing and receipts, kept by thread key.
+type gometaParity struct {
+	threadType map[int64]table.ThreadType // from the thread rows, for the typing task
+	e2eeChat   map[int64]waTypes.JID      // an encrypted chat's JID, as its messages came from
+	unreadE2EE map[int64][]gometaUnread   // encrypted messages to mark read
+	unreadFB   map[int64]int64            // a plain chat's newest unread message time (ms)
+	// an encrypted chat's newest message time (ms), for its Facebook thread's read state
+	readE2EE map[int64]int64
+	// an encrypted chat's Facebook thread key, by the chat's WhatsApp-side id, where they differ
+	// (LSVerifyHybridThreadExists, LSUpdateThreadAuthorityAndMappingWithOTIDFromJID)
+	hybridKey map[int64]int64
+}
+
+// gometaHybridSyncGroup is the sync group of an encrypted chat's Facebook thread (mautrix-meta
+// marks such a thread read, accepts and deletes it there).
+const gometaHybridSyncGroup = 95
+
+func (h *gometaHandler) initParity() {
+	h.parity = gometaParity{
+		threadType: make(map[int64]table.ThreadType),
+		e2eeChat:   make(map[int64]waTypes.JID),
+		unreadE2EE: make(map[int64][]gometaUnread),
+		unreadFB:   make(map[int64]int64),
+		readE2EE:   make(map[int64]int64),
+		hybridKey:  make(map[int64]int64),
+	}
+}
+
+//export gometa_go_send_typing
+func gometa_go_send_typing(account *PurpleAccount, who *C.char, typing C.int) {
+	if h, ok := gometaHandlers[account]; ok {
+		go h.sendTyping(C.GoString(who), typing != 0)
+	}
+}
+
+// webOS: the Messaging app has shown this chat (a thread key), so what came in it has been read.
+// Raised through libpurple's "conversation-updated" (glue/gometa_init.c).
+//
+//export gometa_go_mark_read
+func gometa_go_mark_read(account *PurpleAccount, who *C.char) {
+	if h, ok := gometaHandlers[account]; ok {
+		go h.markRead(C.GoString(who))
+	}
+}
+
+// e2eeJID is the JID an encrypted chat is reached at: the one its messages came from, else a 1:1
+// Messenger chat's.
+func (h *gometaHandler) e2eeJID(threadKey int64) waTypes.JID {
+	h.mu.Lock()
+	jid, ok := h.parity.e2eeChat[threadKey]
+	h.mu.Unlock()
+	if ok {
+		return jid
+	}
+	return waTypes.JID{User: strconv.FormatInt(threadKey, 10), Server: waTypes.MessengerServer}
+}
+
+// sendTyping tells a chat we are typing (on) or stopped. who is the thread key; anything else
+// (the "Facebook" sign-in chat) is left alone.
+func (h *gometaHandler) sendTyping(who string, on bool) {
+	threadKey, err := strconv.ParseInt(who, 10, 64)
+	if err != nil || threadKey == 0 {
+		return
+	}
+	h.mu.Lock()
+	isE2EE := h.e2eeContacts[threadKey]
+	isGroup := h.threadGroup[threadKey]
+	threadType := h.parity.threadType[threadKey]
+	h.mu.Unlock()
+	ctx, cancel := context.WithTimeout(h.ctx, 10*time.Second)
+	defer cancel()
+	if isE2EE {
+		err = h.net().chatPresence(ctx, h.e2eeJID(threadKey), on)
+	} else {
+		task := &socket.UpdatePresenceTask{ThreadKey: threadKey, SyncGroup: 1, ThreadType: int64(threadType)}
+		if isGroup {
+			task.IsGroupThread = 1
+		}
+		if threadType == 0 {
+			task.ThreadType = int64(table.ONE_TO_ONE)
+			if isGroup {
+				task.ThreadType = int64(table.GROUP_THREAD)
+			}
+		}
+		if on {
+			task.IsTyping = 1
+		}
+		err = h.net().fbTask(ctx, task, true)
+	}
+	if err != nil {
+		h.logger.Debug().Err(err).Bool("e2ee", isE2EE).Msg("typing not sent")
+	}
+}
+
+// gometaE2EEReadMs is how far an encrypted message's Facebook thread is read once it is: its time in
+// ms, to the end of its second when it has none finer (whatsmeow's come in whole seconds, and the
+// thread's own time for it may be later in that second), as mautrix-meta rounds it.
+func gometaE2EEReadMs(ts time.Time) int64 {
+	if ts.IsZero() {
+		return 0
+	}
+	if ts.Nanosecond() == 0 {
+		ts = ts.Add(999 * time.Millisecond)
+	}
+	return ts.UnixMilli()
+}
+
+// noteHybridThreads keeps which Facebook thread an encrypted chat is, where the keys differ.
+func (h *gometaHandler) noteHybridThreads(tbl *table.LSTable) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.parity.hybridKey == nil {
+		return
+	}
+	for _, m := range tbl.LSVerifyHybridThreadExists {
+		if m.ThreadKey != 0 && m.ThreadJID != 0 {
+			h.parity.hybridKey[m.ThreadJID] = m.ThreadKey
+		}
+	}
+	for _, m := range tbl.LSUpdateThreadAuthorityAndMappingWithOTIDFromJID {
+		if m.ThreadKey != 0 && m.ThreadJID != 0 {
+			h.parity.hybridKey[m.ThreadJID] = m.ThreadKey
+		}
+	}
+}
+
+// fbThreadOfE2EE is the Facebook thread key of an encrypted chat: the one Facebook named for it,
+// else, for a 1:1 chat, the chat's own (a 1:1 thread's key is the partner's fbid on both sides).
+// 0 for an encrypted group Facebook named none for.
+func (h *gometaHandler) fbThreadOfE2EE(threadKey int64, chat waTypes.JID) int64 {
+	h.mu.Lock()
+	key, ok := h.parity.hybridKey[threadKey]
+	h.mu.Unlock()
+	if ok {
+		return key
+	}
+	if chat.Server == waTypes.GroupServer {
+		return 0
+	}
+	return threadKey
+}
+
+// noteUnreadE2EE keeps a received encrypted message for the chat's next read receipt: the
+// message itself when someone else sent it, and its time for the Facebook thread either way (one
+// of ours from another device was read there too).
+func (h *gometaHandler) noteUnreadE2EE(threadKey int64, info waTypes.MessageInfo) {
+	if threadKey == 0 || info.ID == "" {
+		return
+	}
+	h.mu.Lock()
+	h.parity.e2eeChat[threadKey] = info.Chat.ToNonAD()
+	if ms := gometaE2EEReadMs(info.Timestamp); ms > h.parity.readE2EE[threadKey] {
+		h.parity.readE2EE[threadKey] = ms
+	}
+	if info.IsFromMe {
+		h.mu.Unlock()
+		return
+	}
+	list := append(h.parity.unreadE2EE[threadKey], gometaUnread{id: info.ID, chat: info.Chat.ToNonAD(), sender: info.Sender.ToNonAD()})
+	if len(list) > gometaMaxUnread {
+		list = list[len(list)-gometaMaxUnread:]
+	}
+	h.parity.unreadE2EE[threadKey] = list
+	h.mu.Unlock()
+}
+
+// noteUnreadFB keeps a received plain message's time for the chat's next read receipt.
+func (h *gometaHandler) noteUnreadFB(threadKey, tsMs int64) {
+	if threadKey == 0 || tsMs == 0 {
+		return
+	}
+	h.mu.Lock()
+	if tsMs > h.parity.unreadFB[threadKey] {
+		h.parity.unreadFB[threadKey] = tsMs
+	}
+	h.mu.Unlock()
+}
+
+// markRead sends read receipts for what came in a chat since its last ones: in an encrypted chat
+// for each message, one receipt per sender (a group's receipt names its sender); in a plain chat
+// one up to the newest message's time, as mautrix-meta's HandleMatrixReadReceipt does.
+func (h *gometaHandler) markRead(who string) {
+	threadKey, err := strconv.ParseInt(who, 10, 64)
+	if err != nil || threadKey == 0 {
+		return
+	}
+	h.mu.Lock()
+	unread := h.parity.unreadE2EE[threadKey]
+	delete(h.parity.unreadE2EE, threadKey)
+	watermark := h.parity.unreadFB[threadKey]
+	delete(h.parity.unreadFB, threadKey)
+	e2eeWatermark := h.parity.readE2EE[threadKey]
+	delete(h.parity.readE2EE, threadKey)
+	h.mu.Unlock()
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	type key struct{ chat, sender waTypes.JID }
+	var order []key
+	bySender := make(map[key][]waTypes.MessageID)
+	for _, u := range unread {
+		k := key{u.chat, u.sender}
+		if _, seen := bySender[k]; !seen {
+			order = append(order, k)
+		}
+		bySender[k] = append(bySender[k], u.id)
+	}
+	for _, k := range order {
+		if err := h.net().markRead(ctx, bySender[k], time.Now(), k.chat, k.sender); err != nil {
+			h.logger.Debug().Err(err).Msg("encrypted read receipt not sent")
+		}
+	}
+	if watermark != 0 {
+		task := &socket.ThreadMarkReadTask{ThreadId: threadKey, LastReadWatermarkTs: watermark, SyncGroup: 1}
+		if err := h.net().fbTask(ctx, task, false); err != nil {
+			h.logger.Debug().Err(err).Msg("read receipt not sent")
+		}
+	}
+	// The encrypted chat's Facebook thread, read up to its newest message.
+	if e2eeWatermark != 0 {
+		fbKey := h.fbThreadOfE2EE(threadKey, h.e2eeJID(threadKey))
+		if fbKey == 0 {
+			return
+		}
+		task := &socket.ThreadMarkReadTask{ThreadId: fbKey, LastReadWatermarkTs: e2eeWatermark, SyncGroup: gometaHybridSyncGroup}
+		if err := h.net().fbTask(ctx, task, false); err != nil {
+			h.logger.Debug().Err(err).Msg("encrypted chat's Facebook thread not marked read")
+		}
+	}
+}
+
+// handleTypingTable shows a plain 1:1 chat's partner typing (LSUpdateTypingIndicator).
+func (h *gometaHandler) handleTypingTable(rows []*table.LSUpdateTypingIndicator) {
+	for _, t := range rows {
+		if t.ThreadKey == 0 || t.SenderId == h.selfID {
+			continue
+		}
+		h.mu.Lock()
+		isGroup := h.threadGroup[t.ThreadKey]
+		h.mu.Unlock()
+		if isGroup {
+			continue
+		}
+		h.out().typing(strconv.FormatInt(t.ThreadKey, 10), t.IsTyping)
+	}
+}
+
+// handleChatPresence shows an encrypted 1:1 chat's partner typing.
+func (h *gometaHandler) handleChatPresence(evt *events.ChatPresence) {
+	if evt.IsFromMe || evt.Chat.Server != waTypes.MessengerServer || evt.Chat.User == "" {
+		return
+	}
+	h.out().typing(evt.Chat.User, evt.State == waTypes.ChatPresenceComposing)
+}
+
+// announceAvailable marks us online on the encrypted transport once it is connected: WhatsApp,
+// which carries Facebook's encrypted chats, sends typing only to a user who is online (as
+// mautrix-meta notes in HandleMatrixViewingChat).
+func (h *gometaHandler) announceAvailable(e2ee *whatsmeow.Client) {
+	ctx, cancel := context.WithTimeout(h.ctx, 30*time.Second)
+	defer cancel()
+	if err := e2ee.SendPresence(ctx, waTypes.PresenceAvailable); err != nil {
+		h.logger.Debug().Err(err).Msg("E2EE presence not sent")
+	}
+}
diff --git a/gometa_presence_test.go b/gometa_presence_test.go
new file mode 100644
index 0000000..c6148c1
--- /dev/null
+++ b/gometa_presence_test.go
@@ -0,0 +1,190 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"go.mau.fi/mautrix-meta/pkg/messagix/socket"
+	"go.mau.fi/mautrix-meta/pkg/messagix/table"
+	"go.mau.fi/whatsmeow/proto/waCommon"
+	"go.mau.fi/whatsmeow/proto/waConsumerApplication"
+	waTypes "go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func gmText(text string) *waConsumerApplication.ConsumerApplication_Content {
+	return &waConsumerApplication.ConsumerApplication_Content{Content: &waConsumerApplication.ConsumerApplication_Content_MessageText{
+		MessageText: &waCommon.MessageText{Text: proto.String(text)}}}
+}
+
+// ---- typing sent ----
+
+func TestGometaTypingInAnEncryptedChatGoesAsChatPresence(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.e2eeContacts[gmPeer] = true
+	h.sendTyping(itoa(gmPeer), true)
+	h.sendTyping(itoa(gmPeer), false)
+	want := []gmPresence{{gmJID(gmPeer), true}, {gmJID(gmPeer), false}}
+	if !reflect.DeepEqual(r.presences, want) || len(r.tasks) != 0 {
+		t.Errorf("presences %+v tasks %+v, want %+v", r.presences, r.tasks, want)
+	}
+}
+
+func TestGometaTypingInAPlainChatIsAPresenceTask(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.parseTable(&table.LSTable{LSDeleteThenInsertThread: []*table.LSDeleteThenInsertThread{{ThreadKey: gmPeer, ThreadType: table.ONE_TO_ONE}}})
+	h.sendTyping(itoa(gmPeer), true)
+	h.sendTyping(itoa(gmPeer), false)
+	if len(r.tasks) != 2 || len(r.presences) != 0 {
+		t.Fatalf("tasks %+v presences %+v", r.tasks, r.presences)
+	}
+	on, off := r.tasks[0], r.tasks[1]
+	want := &socket.UpdatePresenceTask{ThreadKey: gmPeer, IsTyping: 1, SyncGroup: 1, ThreadType: int64(table.ONE_TO_ONE)}
+	if !reflect.DeepEqual(on.task, want) || !on.stateless {
+		t.Errorf("typing: got %+v (stateless %v), want %+v", on.task, on.stateless, want)
+	}
+	if off.task.(*socket.UpdatePresenceTask).IsTyping != 0 {
+		t.Errorf("stopped: got %+v", off.task)
+	}
+}
+
+func TestGometaTypingIgnoresTheSignInChat(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.sendTyping("Facebook", true)
+	if len(r.tasks)+len(r.presences) != 0 {
+		t.Errorf("sent %+v %+v", r.tasks, r.presences)
+	}
+}
+
+// ---- typing received ----
+
+func TestGometaTypingFromAPlainChat(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.threadGroup[gmGroup] = true
+	h.parseTable(&table.LSTable{LSUpdateTypingIndicator: []*table.LSUpdateTypingIndicator{
+		{ThreadKey: gmPeer, SenderId: gmPeer, IsTyping: true},
+		{ThreadKey: gmPeer, SenderId: gmSelf, IsTyping: true}, // ours, from another device
+		{ThreadKey: gmGroup, SenderId: gmPeer2, IsTyping: true},
+		{ThreadKey: gmPeer, SenderId: gmPeer, IsTyping: false},
+	}})
+	want := []gmTyping{{itoa(gmPeer), true}, {itoa(gmPeer), false}}
+	if !reflect.DeepEqual(r.typings, want) {
+		t.Errorf("got %+v, want %+v", r.typings, want)
+	}
+}
+
+func TestGometaTypingFromAnEncryptedChat(t *testing.T) {
+	h, r := newTestGometa(t)
+	src := waTypes.MessageSource{Chat: gmJID(gmPeer), Sender: gmJID(gmPeer)}
+	h.e2eeEventHandler(&events.ChatPresence{MessageSource: src, State: waTypes.ChatPresenceComposing})
+	h.e2eeEventHandler(&events.ChatPresence{MessageSource: src, State: waTypes.ChatPresencePaused})
+	group := waTypes.MessageSource{Chat: waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}, Sender: gmJID(gmPeer2), IsGroup: true}
+	h.e2eeEventHandler(&events.ChatPresence{MessageSource: group, State: waTypes.ChatPresenceComposing})
+	want := []gmTyping{{itoa(gmPeer), true}, {itoa(gmPeer), false}}
+	if !reflect.DeepEqual(r.typings, want) {
+		t.Errorf("got %+v, want %+v", r.typings, want)
+	}
+}
+
+// ---- read receipts sent ----
+
+func TestGometaShownEncryptedChatIsMarkedRead(t *testing.T) {
+	h, r := newTestGometa(t)
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8001", gmText("one")))
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8002", gmText("two")))
+	h.markRead(itoa(gmPeer))
+	want := []gmMarkRead{{[]waTypes.MessageID{"8001", "8002"}, gmJID(gmPeer), gmJID(gmPeer)}}
+	if !reflect.DeepEqual(r.markReads, want) {
+		t.Fatalf("got %+v, want %+v", r.markReads, want)
+	}
+	// Messenger's apps read the chat's Facebook thread: a 1:1 one is under the partner's fbid.
+	wantTask := &socket.ThreadMarkReadTask{ThreadId: gmPeer, LastReadWatermarkTs: 1700000000999, SyncGroup: 95}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, wantTask) || r.tasks[0].stateless {
+		t.Fatalf("Facebook thread: got %+v, want %+v", r.tasks, wantTask)
+	}
+	h.markRead(itoa(gmPeer)) // nothing new: no second receipt
+	if len(r.markReads) != 1 || len(r.tasks) != 1 {
+		t.Errorf("again: %+v %+v", r.markReads, r.tasks)
+	}
+}
+
+func TestGometaEncryptedChatReadsTheFacebookThreadFacebookNamed(t *testing.T) {
+	h, r := newTestGometa(t)
+	const fbKey = int64(7000000000000007)
+	h.parseTable(&table.LSTable{LSVerifyHybridThreadExists: []*table.LSVerifyHybridThreadExists{
+		{ThreadKey: fbKey, ThreadJID: gmPeer, ThreadType: table.ENCRYPTED_OVER_WA_ONE_TO_ONE}}})
+	h.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8101", gmText("one")))
+	h.markRead(itoa(gmPeer))
+	want := &socket.ThreadMarkReadTask{ThreadId: fbKey, LastReadWatermarkTs: 1700000000999, SyncGroup: 95}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) {
+		t.Errorf("got %+v, want %+v", r.tasks, want)
+	}
+	// Facebook's other name for the mapping gives the same.
+	h2, r2 := newTestGometa(t)
+	h2.parseTable(&table.LSTable{LSUpdateThreadAuthorityAndMappingWithOTIDFromJID: []*table.LSUpdateThreadAuthorityAndMappingWithOTIDFromJID{
+		{ThreadJID: gmPeer, ThreadKey: fbKey}}})
+	h2.handleE2EEMessage(gmFBMessage(gmJID(gmPeer), gmJID(gmPeer), "8102", gmText("two")))
+	h2.markRead(itoa(gmPeer))
+	if len(r2.tasks) != 1 || r2.tasks[0].task.(*socket.ThreadMarkReadTask).ThreadId != fbKey {
+		t.Errorf("authority mapping: got %+v", r2.tasks)
+	}
+}
+
+func TestGometaOwnEncryptedMessageReadsOnlyTheFacebookThread(t *testing.T) {
+	h, r := newTestGometa(t)
+	mine := gmFBMessage(gmJID(gmPeer), gmJID(gmSelf), "8201", gmText("from my phone"))
+	mine.Info.IsFromMe = true
+	mine.Info.Timestamp = time.Unix(1700000100, 250*int64(time.Millisecond))
+	h.handleE2EEMessage(mine)
+	h.markRead(itoa(gmPeer))
+	if len(r.markReads) != 0 {
+		t.Errorf("a receipt for our own message: %+v", r.markReads)
+	}
+	want := &socket.ThreadMarkReadTask{ThreadId: gmPeer, LastReadWatermarkTs: 1700000100250, SyncGroup: 95}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) {
+		t.Errorf("got %+v, want %+v", r.tasks, want)
+	}
+}
+
+func TestGometaEncryptedGroupReceiptsGoPerSender(t *testing.T) {
+	h, r := newTestGometa(t)
+	group := waTypes.JID{User: itoa(gmGroup), Server: waTypes.GroupServer}
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "9001", gmText("a")))
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer2), "9002", gmText("b")))
+	h.handleE2EEMessage(gmFBMessage(group, gmJID(gmPeer), "9003", gmText("c")))
+	h.markRead(itoa(gmGroup))
+	want := []gmMarkRead{
+		{[]waTypes.MessageID{"9001", "9003"}, group, gmJID(gmPeer)},
+		{[]waTypes.MessageID{"9002"}, group, gmJID(gmPeer2)},
+	}
+	if !reflect.DeepEqual(r.markReads, want) {
+		t.Errorf("got %+v, want %+v", r.markReads, want)
+	}
+	// Facebook named no thread for the group: none is guessed.
+	if len(r.tasks) != 0 {
+		t.Errorf("a Facebook thread guessed for an encrypted group: %+v", r.tasks)
+	}
+}
+
+func TestGometaShownPlainChatIsMarkedRead(t *testing.T) {
+	h, r := newTestGometa(t)
+	older, newer := gmInsert("mid.a", "a", gmPeer), gmInsert("mid.b", "b", gmPeer)
+	newer.TimestampMs = older.TimestampMs + 5000
+	mine := gmInsert("mid.c", "c", gmSelf) // ours from another device: not a reason for a receipt
+	mine.TimestampMs = older.TimestampMs + 9000
+	h.parseTable(&table.LSTable{LSInsertMessage: []*table.LSInsertMessage{newer, older, mine}})
+	h.markRead(itoa(gmPeer))
+	want := &socket.ThreadMarkReadTask{ThreadId: gmPeer, LastReadWatermarkTs: newer.TimestampMs, SyncGroup: 1}
+	if len(r.tasks) != 1 || !reflect.DeepEqual(r.tasks[0].task, want) || r.tasks[0].stateless {
+		t.Fatalf("got %+v, want %+v", r.tasks, want)
+	}
+	if len(r.markReads) != 0 {
+		t.Errorf("encrypted receipts for a plain chat: %+v", r.markReads)
+	}
+	h.markRead(itoa(gmPeer))
+	if len(r.tasks) != 1 {
+		t.Errorf("a second receipt with nothing new: %+v", r.tasks)
+	}
+}

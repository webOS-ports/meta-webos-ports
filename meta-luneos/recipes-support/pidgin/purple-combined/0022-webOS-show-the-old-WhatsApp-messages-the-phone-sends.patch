diff --git a/disappearing.go b/disappearing.go
new file mode 100644
index 0000000..03d76d0
--- /dev/null
+++ b/disappearing.go
@@ -0,0 +1,131 @@
+package main
+
+import (
+	"fmt"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+/*
+ * webOS: disappearing messages and view-once media.
+ *
+ * Turning disappearing messages on or off, or changing their timer, said nothing: in a chat it
+ * comes as a ProtocolMessage (EPHEMERAL_SETTING) with no text, which handle_message dropped, and in a
+ * group as a group change (events.GroupInfo.Ephemeral) group_event_notices did not tell. It is now
+ * a notice line, in the WhatsApp app's words: "Ann turned on disappearing messages. New messages
+ * will disappear from this chat 7 days after they're sent." / "You turned off disappearing
+ * messages." The messages themselves are kept here as any other: this device does not delete them
+ * when their time is up.
+ *
+ * A view-once photo, video or voice message is not given to a linked device: the phone keeps it,
+ * and this device gets an "unavailable" message of type view_once (events.UndecryptableMessage),
+ * which used to read "sent an undecryptable view_once message". Should one come with its media all
+ * the same (an older sender's ViewOnceMessage, or our own phone's copy), it is not downloaded and
+ * kept either. Both are now said as what they are, under the message's id: "📷 View once photo.
+ * Open it on your phone."
+ */
+
+/*
+ * The line for a disappearing-messages timer set to seconds (0: off), by who (people.subject:
+ * "You" for us); without a who, "Disappearing messages were turned on ...".
+ */
+func disappearing_text(seconds uint32, who types.JID, hasWho bool, people groupPeople) string {
+	if seconds == 0 {
+		if !hasWho {
+			return "Disappearing messages were turned off."
+		}
+		return people.subject(who) + " turned off disappearing messages."
+	}
+	rest := fmt.Sprintf("New messages will disappear from this chat %s after they're sent.", timer_duration(seconds))
+	if !hasWho {
+		return "Disappearing messages were turned on. " + rest
+	}
+	return people.subject(who) + " turned on disappearing messages. " + rest
+}
+
+// "24 hours", "7 days", "90 days", "1 hour", "5 minutes", "30 seconds": the largest whole unit.
+func timer_duration(seconds uint32) string {
+	units := []struct {
+		size uint32
+		name string
+	}{{86400, "day"}, {3600, "hour"}, {60, "minute"}, {1, "second"}}
+	for _, unit := range units {
+		if seconds%unit.size == 0 {
+			n := seconds / unit.size
+			if unit.size == 86400 && n == 1 {
+				return "24 hours" // as WhatsApp says its shortest timer
+			}
+			if n == 1 {
+				return "1 " + unit.name
+			}
+			return fmt.Sprintf("%d %ss", n, unit.name)
+		}
+	}
+	return fmt.Sprintf("%d seconds", seconds) // not reached: every number is whole seconds
+}
+
+// The new timer a ProtocolMessage sets, and whether it is such a message.
+func disappearing_setting(message *waE2E.Message) (uint32, bool) {
+	pm := message.GetProtocolMessage()
+	if pm == nil || pm.Type == nil || pm.GetType() != waE2E.ProtocolMessage_EPHEMERAL_SETTING {
+		return 0, false
+	}
+	return pm.GetEphemeralExpiration(), true
+}
+
+/*
+ * What a view-once message is said as: "📷 View once photo. Open it on your phone." (video, voice
+ * message; "View once message" when what it is is not known). "" when message is not view-once.
+ * evt may be nil.
+ */
+func view_once_text(message *waE2E.Message, evt *events.Message) string {
+	kind := ""
+	switch {
+	case message.GetImageMessage() != nil:
+		if message.GetImageMessage().GetViewOnce() {
+			kind = "📷 View once photo"
+		}
+	case message.GetVideoMessage() != nil:
+		if message.GetVideoMessage().GetViewOnce() {
+			kind = "🎥 View once video"
+		}
+	case message.GetAudioMessage() != nil:
+		if message.GetAudioMessage().GetViewOnce() {
+			kind = "🎤 View once voice message"
+		}
+	}
+	if kind == "" && evt != nil && evt.IsViewOnce {
+		switch {
+		case message.GetImageMessage() != nil:
+			kind = "📷 View once photo"
+		case message.GetVideoMessage() != nil:
+			kind = "🎥 View once video"
+		case message.GetAudioMessage() != nil:
+			kind = "🎤 View once voice message"
+		default:
+			kind = "View once message"
+		}
+	}
+	if kind == "" {
+		return ""
+	}
+	return kind + ". Open it on your phone."
+}
+
+// What an unavailable message (events.UndecryptableMessage) is said as.
+func undecryptable_text(evt *events.UndecryptableMessage) string {
+	if evt.IsUnavailable && evt.UnavailableType == events.UnavailableTypeViewOnce {
+		return "View once message. Open it on your phone."
+	}
+	// Otherwise as upstream says it.
+	if evt.UnavailableType == "sender_drop" {
+		return "sent a message which was not available when requested. Wake up your main device, then the message will be displayed here. Probably."
+	}
+	unavailable_type := ""
+	if evt.UnavailableType != "" {
+		unavailable_type = fmt.Sprintf(" %s", evt.UnavailableType)
+	}
+	return fmt.Sprintf("sent an undecryptable%s message. The message might arrive here later.", unavailable_type)
+}
diff --git a/disappearing_test.go b/disappearing_test.go
new file mode 100644
index 0000000..915b348
--- /dev/null
+++ b/disappearing_test.go
@@ -0,0 +1,139 @@
+package main
+
+import (
+	"testing"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestTimerDuration(t *testing.T) {
+	cases := map[uint32]string{
+		86400:   "24 hours",
+		604800:  "7 days",
+		7776000: "90 days",
+		3600:    "1 hour",
+		7200:    "2 hours",
+		300:     "5 minutes",
+		60:      "1 minute",
+		30:      "30 seconds",
+		1:       "1 second",
+		90061:   "90061 seconds",
+	}
+	for seconds, want := range cases {
+		if got := timer_duration(seconds); got != want {
+			t.Errorf("%d: got %q, want %q", seconds, got, want)
+		}
+	}
+}
+
+// In WhatsApp's words, by who turned it on or off: us, someone, or nobody named.
+func TestDisappearingText(t *testing.T) {
+	people := testGroupPeople()
+	cases := []struct {
+		seconds uint32
+		who     types.JID
+		hasWho  bool
+		want    string
+	}{
+		{604800, gAnn, true, "Ann turned on disappearing messages. New messages will disappear from this chat 7 days after they're sent."},
+		{86400, gMe, true, "You turned on disappearing messages. New messages will disappear from this chat 24 hours after they're sent."},
+		{86400, gMeLid, true, "You turned on disappearing messages. New messages will disappear from this chat 24 hours after they're sent."},
+		{0, gBen, true, "Ben turned off disappearing messages."},
+		{0, gMe, true, "You turned off disappearing messages."},
+		{7776000, types.EmptyJID, false, "Disappearing messages were turned on. New messages will disappear from this chat 90 days after they're sent."},
+		{0, types.EmptyJID, false, "Disappearing messages were turned off."},
+	}
+	for _, c := range cases {
+		if got := disappearing_text(c.seconds, c.who, c.hasWho, people); got != c.want {
+			t.Errorf("got %q, want %q", got, c.want)
+		}
+	}
+}
+
+// Only a ProtocolMessage of type EPHEMERAL_SETTING sets the timer; a revoke (type 0, the zero
+// value) and a message without a protocol part do not.
+func TestDisappearingSetting(t *testing.T) {
+	set := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		Type: waE2E.ProtocolMessage_EPHEMERAL_SETTING.Enum(), EphemeralExpiration: proto.Uint32(604800)}}
+	if seconds, ok := disappearing_setting(set); !ok || seconds != 604800 {
+		t.Errorf("setting: got %d %v", seconds, ok)
+	}
+	off := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{Type: waE2E.ProtocolMessage_EPHEMERAL_SETTING.Enum()}}
+	if seconds, ok := disappearing_setting(off); !ok || seconds != 0 {
+		t.Errorf("off: got %d %v", seconds, ok)
+	}
+	for _, m := range []*waE2E.Message{
+		{ProtocolMessage: &waE2E.ProtocolMessage{Type: waE2E.ProtocolMessage_REVOKE.Enum()}},
+		{ProtocolMessage: &waE2E.ProtocolMessage{EphemeralExpiration: proto.Uint32(86400)}},
+		{Conversation: proto.String("hi")},
+	} {
+		if _, ok := disappearing_setting(m); ok {
+			t.Errorf("%v taken as a timer setting", m)
+		}
+	}
+}
+
+// A group's timer change is told among its news.
+func TestGroupDisappearingNotices(t *testing.T) {
+	notices(t, events.GroupInfo{Sender: &gAnn, Ephemeral: &types.GroupEphemeral{IsEphemeral: true, DisappearingTimer: 86400}},
+		"Ann turned on disappearing messages. New messages will disappear from this chat 24 hours after they're sent.")
+	notices(t, events.GroupInfo{Sender: &gMe, Ephemeral: &types.GroupEphemeral{IsEphemeral: false}},
+		"You turned off disappearing messages.")
+	notices(t, events.GroupInfo{Sender: &gBen, Ephemeral: &types.GroupEphemeral{IsEphemeral: false, DisappearingTimer: 86400}},
+		"Ben turned off disappearing messages.")
+	notices(t, events.GroupInfo{Ephemeral: &types.GroupEphemeral{IsEphemeral: true, DisappearingTimer: 0}},
+		"Disappearing messages were turned off.")
+	notices(t, events.GroupInfo{Ephemeral: &types.GroupEphemeral{IsEphemeral: true, DisappearingTimer: 604800}},
+		"Disappearing messages were turned on. New messages will disappear from this chat 7 days after they're sent.")
+}
+
+// A view-once photo, video or voice message is said as one, whether it is marked view-once
+// itself or came out of a ViewOnceMessage; anything else is not.
+func TestViewOnceText(t *testing.T) {
+	cases := []struct {
+		message  *waE2E.Message
+		viewOnce bool // came out of a ViewOnceMessage
+		want     string
+	}{
+		{&waE2E.Message{ImageMessage: &waE2E.ImageMessage{ViewOnce: proto.Bool(true)}}, false, "📷 View once photo. Open it on your phone."},
+		{&waE2E.Message{VideoMessage: &waE2E.VideoMessage{ViewOnce: proto.Bool(true)}}, false, "🎥 View once video. Open it on your phone."},
+		{&waE2E.Message{AudioMessage: &waE2E.AudioMessage{ViewOnce: proto.Bool(true)}}, false, "🎤 View once voice message. Open it on your phone."},
+		{&waE2E.Message{ImageMessage: &waE2E.ImageMessage{}}, true, "📷 View once photo. Open it on your phone."},
+		{&waE2E.Message{VideoMessage: &waE2E.VideoMessage{}}, true, "🎥 View once video. Open it on your phone."},
+		{&waE2E.Message{AudioMessage: &waE2E.AudioMessage{}}, true, "🎤 View once voice message. Open it on your phone."},
+		{&waE2E.Message{Conversation: proto.String("hi")}, true, "View once message. Open it on your phone."},
+		{&waE2E.Message{ImageMessage: &waE2E.ImageMessage{}}, false, ""},
+		{&waE2E.Message{Conversation: proto.String("hi")}, false, ""},
+	}
+	for i, c := range cases {
+		if got := view_once_text(c.message, &events.Message{IsViewOnce: c.viewOnce}); got != c.want {
+			t.Errorf("%d: got %q, want %q", i, got, c.want)
+		}
+	}
+	if got := view_once_text(&waE2E.Message{ImageMessage: &waE2E.ImageMessage{}}, nil); got != "" {
+		t.Errorf("without an event: got %q", got)
+	}
+}
+
+// The view-once stand-in a linked device gets reads as what it is; other unavailable messages as
+// before, without an empty type.
+func TestUndecryptableText(t *testing.T) {
+	cases := []struct {
+		evt  events.UndecryptableMessage
+		want string
+	}{
+		{events.UndecryptableMessage{IsUnavailable: true, UnavailableType: events.UnavailableTypeViewOnce}, "View once message. Open it on your phone."},
+		{events.UndecryptableMessage{IsUnavailable: true}, "sent an undecryptable message. The message might arrive here later."},
+		{events.UndecryptableMessage{}, "sent an undecryptable message. The message might arrive here later."},
+		{events.UndecryptableMessage{UnavailableType: "hosted_unavailable_fanout"}, "sent an undecryptable hosted_unavailable_fanout message. The message might arrive here later."},
+		{events.UndecryptableMessage{UnavailableType: "sender_drop"}, "sent a message which was not available when requested. Wake up your main device, then the message will be displayed here. Probably."},
+	}
+	for _, c := range cases {
+		if got := undecryptable_text(&c.evt); got != c.want {
+			t.Errorf("got %q, want %q", got, c.want)
+		}
+	}
+}
diff --git a/glue/display_message.c b/glue/display_message.c
index b6d6403..d9a878d 100644
--- a/glue/display_message.c
+++ b/glue/display_message.c
@@ -17,6 +17,19 @@ static void gowhatsapp_stash_webos_quote(PurpleConversation *conv, const gchar *
     }
 }
 
+/* webOS: a message from the history the phone sent (flags has PURPLE_MESSAGE_DELAYED) is marked on
+ * its conversation for just as long as libpurple hands it on: "webos-msg-history" is set right before
+ * serv_got_* and cleared right after it, so it cannot stick to a later message. The transport
+ * (imlibpurpleservice incoming_message_cb) reads it and stores the message as read and without a
+ * banner. A pointer that owns nothing: there is nothing to free. */
+#define WEBOS_HISTORY_KEY "webos-msg-history"
+
+static void gowhatsapp_mark_webos_history(PurpleConversation *conv, PurpleMessageFlags flags, gboolean on) {
+    if (conv != NULL && (flags & PURPLE_MESSAGE_DELAYED)) {
+        purple_conversation_set_data(conv, WEBOS_HISTORY_KEY, on ? GINT_TO_POINTER(1) : NULL);
+    }
+}
+
 void gowhatsapp_display_text_message(
     PurpleAccount *account,
     const gchar * senderJid,
@@ -89,7 +102,9 @@ void gowhatsapp_display_text_message(
         if (stash) {
             gowhatsapp_stash_webos_quote(gconv, quotedText, quotedFrom, quotedId);
         }
+        gowhatsapp_mark_webos_history(gconv, flags, TRUE);
         purple_serv_got_chat_in(connection, g_str_hash(remoteJid), senderJid, flags, text_with_id, timestamp);
+        gowhatsapp_mark_webos_history(gconv, flags, FALSE);
     } else {
         if (flags & PURPLE_MESSAGE_SEND) {
             // display message sent from own account (other device as well as local echo)
@@ -106,7 +121,9 @@ void gowhatsapp_display_text_message(
                 purple_conversation_set_data(conv, "webos-msg-id", g_strdup(messageId));
             }
             gowhatsapp_stash_webos_quote(conv, quotedText, quotedFrom, quotedId);
+            gowhatsapp_mark_webos_history(conv, flags, TRUE);
             purple_conv_im_write(purple_conversation_get_im_data(conv), remoteJid, text_with_id, flags, timestamp);
+            gowhatsapp_mark_webos_history(conv, flags, FALSE);
         } else {
             if (purple_account_get_bool(account, GOWHATSAPP_UPDATE_BUDDY_ON_MESSAGE_OPTION, TRUE)) {
                 gowhatsapp_ensure_buddy_in_blist(account, remoteJid, name);
@@ -119,7 +136,9 @@ void gowhatsapp_display_text_message(
                 purple_conversation_set_data(conv, "webos-msg-id", g_strdup(messageId));
             }
             gowhatsapp_stash_webos_quote(conv, quotedText, quotedFrom, quotedId);
+            gowhatsapp_mark_webos_history(conv, flags, TRUE);
             purple_serv_got_im(connection, remoteJid, text_with_id, flags, timestamp);
+            gowhatsapp_mark_webos_history(conv, flags, FALSE);
         }
     }
     

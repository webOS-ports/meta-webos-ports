+package main
+
+import (
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waHistorySync"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+	"google.golang.org/protobuf/proto"
+)
+
+func historyMsg(id string, at int64, text string) *events.Message {
+	msg := &events.Message{Info: types.MessageInfo{ID: types.MessageID(id), Timestamp: time.Unix(at, 0)}}
+	if text != "" {
+		msg.Message = &waE2E.Message{Conversation: proto.String(text)}
+	}
+	return msg
+}
+
+func pickedIDs(msgs []*events.Message) []string {
+	var ids []string
+	for _, msg := range msgs {
+		ids = append(ids, string(msg.Info.ID))
+	}
+	return ids
+}
+
+// A chat's messages come newest first; they are given oldest first, the newest perChat of them,
+// without the stubs (no message), the ones without an id, and those older than since.
+func TestHistoryPick(t *testing.T) {
+	msgs := []*events.Message{
+		historyMsg("E", 500, "e"),
+		historyMsg("STUB", 450, ""),
+		historyMsg("D", 400, "d"),
+		historyMsg("", 350, "no id"),
+		historyMsg("C", 300, "c"),
+		nil,
+		historyMsg("B", 200, "b"),
+		historyMsg("A", 100, "a"),
+	}
+	cases := []struct {
+		perChat int
+		since   int64
+		want    []string
+	}{
+		{0, 0, []string{"A", "B", "C", "D", "E"}},
+		{3, 0, []string{"C", "D", "E"}},
+		{50, 0, []string{"A", "B", "C", "D", "E"}},
+		{50, 250, []string{"C", "D", "E"}},
+		{2, 250, []string{"D", "E"}},
+		{1, 600, nil},
+	}
+	for _, c := range cases {
+		since := time.Time{}
+		if c.since > 0 {
+			since = time.Unix(c.since, 0)
+		}
+		got := pickedIDs(history_pick(msgs, c.perChat, since))
+		if len(got) != len(c.want) {
+			t.Errorf("perChat %d since %d: got %v, want %v", c.perChat, c.since, got, c.want)
+			continue
+		}
+		for i := range got {
+			if got[i] != c.want[i] {
+				t.Errorf("perChat %d since %d: got %v, want %v", c.perChat, c.since, got, c.want)
+				break
+			}
+		}
+	}
+}
+
+// The syncs the phone sends by itself take the account's number of messages (none for 0); an
+// answer to our own request takes up to historyOnDemandMax whatever the account says; a sync of
+// names or status carries no messages to give.
+func TestHistoryBound(t *testing.T) {
+	cases := []struct {
+		syncType waHistorySync.HistorySync_HistorySyncType
+		perChat  int
+		want     int
+		ok       bool
+	}{
+		{waHistorySync.HistorySync_INITIAL_BOOTSTRAP, 50, 50, true},
+		{waHistorySync.HistorySync_RECENT, 20, 20, true},
+		{waHistorySync.HistorySync_FULL, 50, 50, true},
+		{waHistorySync.HistorySync_INITIAL_BOOTSTRAP, 0, 0, false},
+		{waHistorySync.HistorySync_RECENT, -1, 0, false},
+		{waHistorySync.HistorySync_ON_DEMAND, 0, historyOnDemandMax, true},
+		{waHistorySync.HistorySync_ON_DEMAND, 50, historyOnDemandMax, true},
+		{waHistorySync.HistorySync_PUSH_NAME, 50, 0, false},
+		{waHistorySync.HistorySync_NON_BLOCKING_DATA, 50, 0, false},
+		{waHistorySync.HistorySync_INITIAL_STATUS_V3, 50, 0, false},
+	}
+	for _, c := range cases {
+		got, ok := history_bound(c.syncType, c.perChat)
+		if got != c.want || ok != c.ok {
+			t.Errorf("%s with %d: got %d %v, want %d %v", c.syncType, c.perChat, got, ok, c.want, c.ok)
+		}
+	}
+}
+
+// People's chats and groups have their history given; channels, status updates and other
+// broadcasts do not.
+func TestHistoryChatWanted(t *testing.T) {
+	cases := map[string]bool{
+		"31611111111@s.whatsapp.net":    true,
+		"900000000000011@lid":           true,
+		"120363000000000001@g.us":       true,
+		"120363000000000002@newsletter": false,
+		"status@broadcast":              false,
+		"1234567890@broadcast":          false,
+	}
+	for s, want := range cases {
+		jid, err := types.ParseJID(s)
+		if err != nil {
+			t.Fatalf("%s: %v", s, err)
+		}
+		if got := history_chat_wanted(jid); got != want {
+			t.Errorf("%s: got %v, want %v", s, got, want)
+		}
+	}
+	if history_chat_wanted(types.JID{Server: types.DefaultUserServer}) {
+		t.Errorf("a JID without a user is wanted")
+	}
+}
+
+// An old message's media is named, with its caption below it.
+func TestHistoryMediaText(t *testing.T) {
+	cases := []struct {
+		message *waE2E.Message
+		want    string
+	}{
+		{&waE2E.Message{ImageMessage: &waE2E.ImageMessage{}}, "📷 Photo"},
+		{&waE2E.Message{ImageMessage: &waE2E.ImageMessage{Caption: proto.String("At the beach")}}, "📷 Photo\nAt the beach"},
+		{&waE2E.Message{VideoMessage: &waE2E.VideoMessage{Caption: proto.String("Look")}}, "🎥 Video\nLook"},
+		{&waE2E.Message{VideoMessage: &waE2E.VideoMessage{GifPlayback: proto.Bool(true)}}, "GIF"},
+		{&waE2E.Message{PtvMessage: &waE2E.VideoMessage{}}, "🎥 Video message"},
+		{&waE2E.Message{AudioMessage: &waE2E.AudioMessage{PTT: proto.Bool(true)}}, "🎤 Voice message"},
+		{&waE2E.Message{AudioMessage: &waE2E.AudioMessage{}}, "🎵 Audio"},
+		{&waE2E.Message{StickerMessage: &waE2E.StickerMessage{}}, "Sticker"},
+		{&waE2E.Message{DocumentMessage: &waE2E.DocumentMessage{FileName: proto.String("Q3.pdf"), Caption: proto.String("the report")}}, "📄 Q3.pdf\nthe report"},
+		{&waE2E.Message{DocumentMessage: &waE2E.DocumentMessage{Title: proto.String("Old.doc")}}, "📄 Old.doc"},
+		{&waE2E.Message{DocumentMessage: &waE2E.DocumentMessage{}}, "📄 Document"},
+		{&waE2E.Message{Conversation: proto.String("just text")}, ""},
+	}
+	for _, c := range cases {
+		if got := history_media_text(c.message); got != c.want {
+			t.Errorf("got %q, want %q", got, c.want)
+		}
+	}
+}
+
+// The time history is asked before: seconds, or milliseconds as db8 keeps it; nothing else.
+func TestHistoryAnchorTime(t *testing.T) {
+	if at, ok := history_anchor_time("1700000000"); !ok || at.Unix() != 1700000000 {
+		t.Errorf("seconds: got %v %v", at, ok)
+	}
+	if at, ok := history_anchor_time("1700000000123"); !ok || at.UnixMilli() != 1700000000123 {
+		t.Errorf("milliseconds: got %v %v", at, ok)
+	}
+	for _, bad := range []string{"", "0", "-5", "soon", "17e8"} {
+		if _, ok := history_anchor_time(bad); ok {
+			t.Errorf("%q taken as a time", bad)
+		}
+	}
+}

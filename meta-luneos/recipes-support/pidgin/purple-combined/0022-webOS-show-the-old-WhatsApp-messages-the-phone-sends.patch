diff --git a/history_sync.go b/history_sync.go
new file mode 100644
index 0000000..c12206b
--- /dev/null
+++ b/history_sync.go
@@ -0,0 +1,258 @@
+package main
+
+/*
+#include "constants.h"
+*/
+import "C"
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strconv"
+	"time"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/proto/waHistorySync"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+/*
+ * webOS: old messages, as the phone sends them to this device. It does so on its own once, right
+ * after linking (INITIAL_BOOTSTRAP, then RECENT and perhaps FULL), and again whenever this device
+ * asks it for the messages before one it has (ON_DEMAND, request_history below). Only the names in
+ * it were read before, so a newly linked device showed no chat until someone wrote, and nothing
+ * older than that.
+ *
+ * Each message goes the way a live one does (handle_message_from), with its own id, time, sender
+ * and direction, so the transport keeps it under its id: one it has already is not stored again
+ * (IncomingIMHandler's serviceMessageId dedup). It is marked as history (purple_display_text_message
+ * with history), which the transport stores as read and without a banner. Its picture, video,
+ * voice note, sticker or document is named in words, not downloaded: a sync can name thousands, the
+ * phone keeps old media only so long, and the download would hold up the libpurple main loop.
+ *
+ * How much: from a sync the phone sends by itself, at most "history-messages-per-chat" (default
+ * 50, 0 for none) of each chat's newest messages that are less than historyMaxAge old. What this
+ * device asked for comes as asked (request_history asks for historyRequestCount), up to
+ * historyOnDemandMax. The channels (newsletters) and status updates in a sync are left alone: the
+ * channels have their own history (fetch_newsletter_history) and status updates last a day.
+ */
+
+// Messages older than this are left out of a sync the phone sends by itself.
+const historyMaxAge = 90 * 24 * time.Hour
+
+// Each chat's newest messages taken from a sync the phone sends by itself, unless the account says.
+const historyDefaultPerChat = 50
+
+// How many messages request_history asks for (whatsmeow recommends 50 at a time).
+const historyRequestCount = 50
+
+// At most this many of a chat's messages are taken from an answer to request_history.
+const historyOnDemandMax = 200
+
+func (handler *Handler) handle_history_sync(evt *events.HistorySync) {
+	data := evt.Data
+	if purple_get_bool(handler.account, C.GOWHATSAPP_FETCH_CONTACTS_AFTER_LINKING_OPTION, true) {
+		for _, p := range data.GetPushnames() {
+			if p.ID != nil && p.Pushname != nil {
+				handler.log.Debugf("HistorySync push name for %s", p.GetID())
+				purple_update_name(handler.account, p.GetID(), p.GetPushname())
+			}
+		}
+	}
+	perChat, ok := history_bound(data.GetSyncType(), purple_get_int(handler.account, C.GOWHATSAPP_HISTORY_MESSAGES_OPTION, historyDefaultPerChat))
+	handler.log.Infof("HistorySync %s chunk %d: %d chats, taking up to %d messages of each",
+		data.GetSyncType(), data.GetChunkOrder(), len(data.GetConversations()), perChat)
+	if !ok {
+		return
+	}
+	since := time.Time{}
+	if data.GetSyncType() != waHistorySync.HistorySync_ON_DEMAND {
+		since = time.Now().Add(-historyMaxAge)
+	}
+	shown := 0
+	for _, conv := range data.GetConversations() {
+		chat, err := types.ParseJID(conv.GetID())
+		if err != nil || !history_chat_wanted(chat) {
+			continue
+		}
+		var parsed []*events.Message
+		for _, hm := range conv.GetMessages() {
+			msg, err := handler.client.ParseWebMessage(chat, hm.GetMessage())
+			if err != nil {
+				handler.log.Debugf("HistorySync: a message in %s could not be read: %v", chat, err)
+				continue
+			}
+			parsed = append(parsed, msg)
+		}
+		for _, msg := range history_pick(parsed, perChat, since) {
+			handler.handle_message_from(msg.Message, msg.Info, msg, true)
+			shown++
+		}
+	}
+	handler.log.Infof("HistorySync %s chunk %d: gave %d messages", data.GetSyncType(), data.GetChunkOrder(), shown)
+}
+
+/*
+ * How many of each chat's messages a sync of this type gives (perChat is the account's
+ * "history-messages-per-chat"), and whether it gives any: none from the syncs that carry no
+ * messages (names, status), and none when the account says 0, but an answer to request_history is
+ * given whatever the account says, up to historyOnDemandMax.
+ */
+func history_bound(syncType waHistorySync.HistorySync_HistorySyncType, perChat int) (int, bool) {
+	switch syncType {
+	case waHistorySync.HistorySync_ON_DEMAND:
+		return historyOnDemandMax, true
+	case waHistorySync.HistorySync_INITIAL_BOOTSTRAP, waHistorySync.HistorySync_RECENT, waHistorySync.HistorySync_FULL:
+		if perChat <= 0 {
+			return 0, false
+		}
+		return perChat, true
+	}
+	return 0, false
+}
+
+// Whether a chat's history is given: not a channel's, nor status updates or another broadcast.
+func history_chat_wanted(chat types.JID) bool {
+	switch chat.Server {
+	case types.DefaultUserServer, types.HiddenUserServer, types.GroupServer:
+		return chat.User != ""
+	}
+	return false
+}
+
+/*
+ * The messages of one chat to give, oldest first: those with something in them, at least as new
+ * as since (when set), the newest perChat of them.
+ */
+func history_pick(msgs []*events.Message, perChat int, since time.Time) []*events.Message {
+	var picked []*events.Message
+	for _, msg := range msgs {
+		if msg == nil || msg.Message == nil || msg.Info.ID == "" {
+			continue // a stub: "missed call", "security code changed", a group change
+		}
+		if !since.IsZero() && msg.Info.Timestamp.Before(since) {
+			continue
+		}
+		picked = append(picked, msg)
+	}
+	sort.SliceStable(picked, func(i, j int) bool {
+		return picked[i].Info.Timestamp.Before(picked[j].Info.Timestamp)
+	})
+	if perChat > 0 && len(picked) > perChat {
+		picked = picked[len(picked)-perChat:]
+	}
+	return picked
+}
+
+/*
+ * What an old message's picture, video, voice note, sticker or document is said as, since it is
+ * not downloaded: "📷 Photo", "🎥 Video", "🎤 Voice message", "🎵 Audio", "Sticker", "📄 name.pdf",
+ * with its caption on the next line. "" when it has none of these.
+ */
+func history_media_text(message *waE2E.Message) string {
+	label, caption := "", ""
+	switch {
+	case message.GetImageMessage() != nil:
+		label, caption = "📷 Photo", message.GetImageMessage().GetCaption()
+	case message.GetVideoMessage() != nil:
+		label, caption = "🎥 Video", message.GetVideoMessage().GetCaption()
+		if message.GetVideoMessage().GetGifPlayback() {
+			label = "GIF"
+		}
+	case message.GetPtvMessage() != nil:
+		label, caption = "🎥 Video message", message.GetPtvMessage().GetCaption()
+	case message.GetAudioMessage() != nil:
+		label = "🎵 Audio"
+		if message.GetAudioMessage().GetPTT() {
+			label = "🎤 Voice message"
+		}
+	case message.GetStickerMessage() != nil:
+		label = "Sticker"
+	case message.GetDocumentMessage() != nil:
+		dm := message.GetDocumentMessage()
+		name := dm.GetFileName()
+		if name == "" {
+			name = dm.GetTitle()
+		}
+		if name == "" {
+			name = "Document"
+		}
+		label, caption = "📄 "+name, dm.GetCaption()
+	default:
+		return ""
+	}
+	if caption != "" {
+		return label + "\n" + caption
+	}
+	return label
+}
+
+/*
+ * Ask the phone for the historyRequestCount messages of chat before the one this device has as the
+ * oldest: its id, whether we sent it, and its time. The answer comes as a HistorySync of type
+ * ON_DEMAND (handle_history_sync). The phone must be online. It is asked for the chat by its
+ * phone number and, when the store knows the LID it is addressed by, by that too: which of the two
+ * the phone keeps the chat under is not known here, and the one it does not know it does not answer.
+ * What it sends twice is stored once (by its id).
+ */
+func (handler *Handler) request_history(chat string, oldestID string, fromMe bool, oldest time.Time) {
+	jid, isGroup, err := handler.webos_chat(chat)
+	if err != nil || oldestID == "" || oldest.IsZero() {
+		handler.log.Warnf("request_history: %s / %s at %v: %v", chat, oldestID, oldest, err)
+		return
+	}
+	jids := []types.JID{jid}
+	if lid := handler.pnToLid(jid); lid != jid {
+		jids = append(jids, lid)
+	}
+	for _, chatJID := range jids {
+		info := &types.MessageInfo{
+			MessageSource: types.MessageSource{Chat: chatJID, IsFromMe: fromMe, IsGroup: isGroup},
+			ID:            types.MessageID(oldestID),
+			Timestamp:     oldest,
+		}
+		request := handler.client.BuildHistorySyncRequest(info, historyRequestCount)
+		if _, err := handler.client.SendPeerMessage(context.Background(), request); err != nil {
+			purple_display_system_message(handler.account, jid.String(), isGroup, fmt.Sprintf("Could not ask the phone for older messages: %v", err))
+			return
+		}
+		handler.log.Infof("Asked the phone for %d messages of %s before %s", historyRequestCount, chatJID, oldestID)
+	}
+}
+
+/*
+ * webOS: the transport's "webos-im-load-history" (glue/login.c): the Messaging app wants the
+ * messages of chat before the oldest it has, id, sent by us when fromMe is "1", at timestamp
+ * (seconds since 1970, decimal). Says whether this account is connected here; the request goes out
+ * on a goroutine.
+ */
+//export gowhatsapp_go_request_history
+func gowhatsapp_go_request_history(account *PurpleAccount, chat *C.char, id *C.char, timestamp *C.char, fromMe *C.char) C.int {
+	handler, ok := webos_handler(account)
+	if !ok {
+		return 0
+	}
+	at, ok := history_anchor_time(C.GoString(timestamp))
+	if !ok {
+		return 0
+	}
+	go handler.request_history(C.GoString(chat), C.GoString(id), C.GoString(fromMe) == "1", at)
+	return 1
+}
+
+/*
+ * The time of the message history is asked before, as the transport gives it: seconds since 1970,
+ * or milliseconds (a number too large to be seconds), as db8 keeps a message's time.
+ */
+func history_anchor_time(s string) (time.Time, bool) {
+	n, err := strconv.ParseInt(s, 10, 64)
+	if err != nil || n <= 0 {
+		return time.Time{}, false
+	}
+	if n > 100000000000 { // later than 5138 in seconds: this is milliseconds
+		return time.UnixMilli(n), true
+	}
+	return time.Unix(n, 0), true
+}

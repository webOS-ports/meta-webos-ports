From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 20 Oct 2026 16:29:05 +0200
Subject: [PATCH] webOS: name received documents by their file name

The webOS attachment path template names files by $hash. For a
document, put its file name there, under a folder named after the
content hash, so the app's attachment chip shows the real name. The
folder keeps two different documents with the same name apart: without
it the second one overwrote the first on disk, and the first message
then showed the second file. The same document received twice still
lands in one place.

The name is reduced to characters that are safe in a path and in the
app's media URL matching; the hash alone is kept when nothing is left.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS specific]
---
 handle_attachment.go | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/handle_attachment.go b/handle_attachment.go
index baf8906..c204567 100644
--- a/handle_attachment.go
+++ b/handle_attachment.go
@@ -161,6 +161,13 @@ func (handler *Handler) handle_attachment(message *waE2E.Message, id string, sou
 			mimetype = dm.GetMimetype()
 			length = dm.GetFileLength()
 			caption = dm.GetCaption()
+			// webOS: name the downloaded document by its real file name, so the Messaging app's
+			// attachment chip shows e.g. "Q3-Report.pdf". The path template uses $hash, so put
+			// "<content hash>/<name>" there: two different documents with the same name do not
+			// overwrite each other. Keep the hash alone when the document has no file name.
+			if safe := sanitize_attachment_name(filename); safe != "" {
+				hash = attachment_path_name(hash, safe)
+			}
 		}
 	}
 	if data_type != C.gowhatsapp_attachment_type_none {
@@ -172,6 +179,27 @@ func (handler *Handler) handle_attachment(message *waE2E.Message, id string, sou
 	}
 }
 
+// sanitize_attachment_name makes a document's real filename safe to use as a single path component AND
+// to survive the Messaging app's media-URL regex (which stops at whitespace): directory separators,
+// control chars, spaces and characters that break a URL/path all map to "_".
+func sanitize_attachment_name(name string) string {
+	name = strings.TrimSpace(name)
+	return strings.Map(func(r rune) rune {
+		if r <= 0x20 || strings.ContainsRune("/\\?#\"'<>|:*&", r) {
+			return '_'
+		}
+		return r
+	}, name)
+}
+
+// attachment_path_name puts a document's name in a folder named after its content hash.
+func attachment_path_name(hash string, name string) string {
+	if hash == "" {
+		return name
+	}
+	return hash + "/" + name
+}
+
 // unpreallocated_file hides the *os.File from whatsmeow, so DownloadToFile does not try to
 // preallocate it. The media is still written to disk as it arrives.
 type unpreallocated_file struct {
-- 

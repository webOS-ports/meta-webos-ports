From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 20 Oct 2026 16:29:05 +0200
Subject: [PATCH] webOS: deliver a picture and its caption as one message

The media link and its caption are sent as one message ("url<br>
caption") instead of two with the same id, so the app shows one bubble
with the picture and its caption.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS specific]
---
 glue/handle_attachment.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/glue/handle_attachment.c b/glue/handle_attachment.c
index 1285e1c..a6c0584 100644
--- a/glue/handle_attachment.c
+++ b/glue/handle_attachment.c
@@ -261,10 +261,21 @@ void download_to_templated_destination(gowhatsapp_message_t *gwamsg, const char
         if (url_template && url_template[0]) {
             url = gowhatsapp_attachment_fill_template(url_template, gwamsg->timestamp, gwamsg->hash_hex, gwamsg->filename, gwamsg->extension, gwamsg->remoteJid, gwamsg->senderJid, chat_alias, buddy_alias, gwamsg->messageId, flags);
         }
-        gowhatsapp_display_text_message(gwamsg->account, gwamsg->senderJid, gwamsg->remoteJid, url, gwamsg->timestamp, gwamsg->isGroup, gwamsg->isOutgoing, gwamsg->name, 0, gwamsg->messageId, NULL, NULL, NULL);
+        // webOS: deliver the media URL and its caption as ONE message, not two. The Messaging app
+        // strips the media URL from the body, renders it inline as an image/chip, and shows the
+        // remaining caption text - so a "url<br>caption" body is a single picture+caption bubble.
+        // Upstream posts the caption as a separate message with the SAME messageId, which the app
+        // renders as a second stand-alone bubble. The caption arrives HTML-escaped from the Go side.
+        if (gwamsg->text && gwamsg->text[0]) {
+            char *combined = g_strdup_printf("%s<br>%s", url, gwamsg->text);
+            gowhatsapp_display_text_message(gwamsg->account, gwamsg->senderJid, gwamsg->remoteJid, combined, gwamsg->timestamp, gwamsg->isGroup, gwamsg->isOutgoing, gwamsg->name, 0, gwamsg->messageId, NULL, NULL, NULL);
+            g_free(combined);
+        } else {
+            gowhatsapp_display_text_message(gwamsg->account, gwamsg->senderJid, gwamsg->remoteJid, url, gwamsg->timestamp, gwamsg->isGroup, gwamsg->isOutgoing, gwamsg->name, 0, gwamsg->messageId, NULL, NULL, NULL);
+        }
         g_free(url);
         gowhatsapp_display_image_inline(gwamsg, local_path);
-        gowhatsapp_display_caption(gwamsg);
+        // caption folded into the URL message above (was: gowhatsapp_display_caption(gwamsg))
     }
     g_free(error);
     g_free(local_path);
-- 
2.53.0


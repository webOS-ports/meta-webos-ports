+// Tests glue/call.c's luneos-rtc-engine session (tests/fakes.c records the LS2 calls and the
+// video bridge): the engine runs only while the call carries video and the user asked to see it,
+// it is asked what the device can send first, late replies of a closed session are cleaned up,
+// the Phone app learns where the picture is, and audiod hears of the video.
+#include <gtest/gtest.h>
+#include <glib.h>
+#include <cstring>
+#include <string>
+
+#include "fakes.h"
+
+namespace {
+
+const char *kCallState =
+	"{\"allowVideoCalls\":true,\"lines\":[{\"calls\":[{\"id\":\"A1\",\"address\":\"x\","
+	"\"origin\":\"incoming\"}],\"state\":\"active\"}],\"returnValue\":true,\"videoURI\":\"\"}";
+
+void pump() {
+	while (g_main_context_iteration(NULL, FALSE)) {
+	}
+}
+
+int ncalls() {
+	fake_lock();
+	int n = fake.ncalls;
+	fake_unlock();
+	return n;
+}
+
+std::string uri_of(int i) { return fake.calls[i].uri; }
+std::string payload_of(int i) { return fake.calls[i].payload; }
+
+// Index of the first call to `method` of the engine at or after `from`, or -1.
+int find_engine_call(const char *method, int from = 0) {
+	std::string want = std::string("luna://org.webosports.rtcengine/") + method;
+	for (int i = from; i < ncalls(); i++)
+		if (uri_of(i) == want) return i;
+	return -1;
+}
+int count_engine_calls(const char *method) {
+	int n = 0;
+	for (int i = find_engine_call(method); i >= 0; i = find_engine_call(method, i + 1)) n++;
+	return n;
+}
+int last_audiod_call() {
+	int found = -1;
+	for (int i = 0; i < ncalls(); i++)
+		if (uri_of(i) == "palm://com.palm.audio/phone/CallStatusUpdate") found = i;
+	return found;
+}
+
+bool has(const std::string &s, const char *needle) { return s.find(needle) != std::string::npos; }
+
+class CallVideo : public ::testing::Test {
+protected:
+	void SetUp() override {
+		fake_reset();
+		fake.ls_registered = 1;
+		whatsapp_call_luna_init();
+		gowhatsapp_call_on_state(kCallState);
+		pump();
+		fake_reset();
+	}
+	void TearDown() override {
+		fake_invoke("testStopInjectVideo", "{}");
+		fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":false}");
+		gowhatsapp_call_video_active(0);
+		pump();
+		gowhatsapp_call_audio_active(0);
+		pump();
+	}
+
+	// The call carries video and the user accepted it.
+	void want_video() {
+		gowhatsapp_call_video_active(1);
+		pump();
+		fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":true}");
+		pump();
+	}
+
+	// Answers capabilities and start; returns the start call's index.
+	int bring_up(bool capable) {
+		int caps = find_engine_call("capabilities");
+		EXPECT_GE(caps, 0);
+		fake_reply(caps, capable ? "{\"returnValue\":true,\"videoCallCapable\":true}"
+		                         : "{\"returnValue\":true,\"videoCallCapable\":false}");
+		int start = find_engine_call("start");
+		EXPECT_GE(start, 0);
+		fake_reply(start, "{\"returnValue\":true,\"txSocket\":\"/tmp/wa-rtc-tx.sock\","
+		                  "\"rxSocket\":\"/tmp/wa-rtc-rx.sock\"}");
+		pump();
+		return start;
+	}
+};
+
+TEST_F(CallVideo, VideoOnTheCallAloneStartsNothing) {
+	gowhatsapp_call_video_active(1);
+	pump();
+	EXPECT_EQ(find_engine_call("capabilities"), -1) << "nothing is decoded before the user asks";
+	EXPECT_EQ(find_engine_call("start"), -1);
+}
+
+TEST_F(CallVideo, TheUsersWishAloneStartsNothing) {
+	fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":true}");
+	pump();
+	EXPECT_EQ(find_engine_call("capabilities"), -1) << "no video on the call";
+}
+
+TEST_F(CallVideo, ReceiveOnlyWithoutACamera) {
+	want_video();
+	int start = bring_up(false);
+	std::string p = payload_of(start);
+	EXPECT_TRUE(has(p, "\"txEnabled\":false")) << p;
+	EXPECT_TRUE(has(p, "\"rxEnabled\":true")) << p;
+	EXPECT_TRUE(has(p, "\"shmPath\":\"/tmp/wa-rtc-video\"")) << p;
+	EXPECT_TRUE(has(p, "\"width\":480")) << p;
+	EXPECT_TRUE(has(p, "\"height\":640")) << p;
+	EXPECT_EQ(fake.video_starts, 1);
+	EXPECT_STREQ(fake.tx_socket, "") << "no TX thread without a camera";
+	EXPECT_STREQ(fake.rx_socket, "/tmp/wa-rtc-rx.sock");
+	EXPECT_EQ(fake.peer_keyframe_requests, 1) << "the decoder joins mid-stream";
+}
+
+TEST_F(CallVideo, SendsTooWithACamera) {
+	want_video();
+	int start = bring_up(true);
+	std::string p = payload_of(start);
+	EXPECT_TRUE(has(p, "\"txEnabled\":true")) << p;
+	EXPECT_TRUE(has(p, "\"width\":640")) << p;
+	EXPECT_TRUE(has(p, "\"height\":480")) << p;
+	EXPECT_STREQ(fake.tx_socket, "/tmp/wa-rtc-tx.sock");
+}
+
+TEST_F(CallVideo, ThePhoneAppLearnsWhereThePictureIs) {
+	want_video();
+	bring_up(false);
+	std::string r = fake.last_subscription_reply;
+	EXPECT_TRUE(has(r, "\"videoURI\":\"/tmp/wa-rtc-video\",\"videoWidth\":480,\"videoHeight\":640"))
+		<< r;
+	fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":false}");
+	pump();
+	r = fake.last_subscription_reply;

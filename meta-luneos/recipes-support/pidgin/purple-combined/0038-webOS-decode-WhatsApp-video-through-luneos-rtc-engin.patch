+// gowhatsapp_go_call_request_peer_keyframe asks the peer of every live call for an IDR.
+// glue/voipkit_rtcengine.c calls it when the decoder joins mid-stream or had to drop an
+// access unit, so it has a keyframe to (re)start from.
+//
+//export gowhatsapp_go_call_request_peer_keyframe
+func gowhatsapp_go_call_request_peer_keyframe() {
+	callMu.Lock()
+	var live []*callInfo
+	for _, c := range calls {
+		if c.state != "disconnected" {
+			live = append(live, c)
+		}
+	}
+	callMu.Unlock()
+	for _, ci := range live {
+		ci.c.RequestPeerKeyframe()
+	}
+}

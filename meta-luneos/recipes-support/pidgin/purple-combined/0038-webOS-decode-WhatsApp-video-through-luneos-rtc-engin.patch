+}
+
+// The view went off and on again before the first start answered: that answer belongs to
+// the closed session, not to the one now starting.
+TEST_F(CallVideo, AnOldStartAnswerIsNotTakenForTheNewSession) {
+	want_video();
+	fake_reply(find_engine_call("capabilities"), "{\"returnValue\":true,\"videoCallCapable\":false}");
+	int old_start = find_engine_call("start");

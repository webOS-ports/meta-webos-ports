+	ASSERT_GE(a, 0);
+	std::string p = payload_of(a);
+	EXPECT_TRUE(has(p, "\"origin\":\"incoming\"")) << p;
+	EXPECT_TRUE(has(p, "\"incomingVideo\":false")) << p;
+	EXPECT_TRUE(has(p, "\"video\":false")) << p;
+	want_video();
+	bring_up(false);
+	p = payload_of(last_audiod_call());
+	EXPECT_TRUE(has(p, "\"incomingVideo\":true")) << p;
+	EXPECT_TRUE(has(p, "\"outgoingVideo\":false")) << p << " (no camera)";
+	EXPECT_TRUE(has(p, "\"video\":true")) << p;
+	fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":false}");
+	pump();
+	p = payload_of(last_audiod_call());
+	EXPECT_TRUE(has(p, "\"incomingVideo\":false")) << p;
+}
+
+TEST_F(CallVideo, TheTestInjectorIsRefusedDuringACall) {
+	gowhatsapp_call_video_active(1);
+	pump();
+	fake_invoke("testInjectVideo", "{}");
+	EXPECT_TRUE(has(fake.last_method_reply, "a call is up")) << fake.last_method_reply;
+	EXPECT_EQ(find_engine_call("capabilities"), -1);
+}
+
+TEST_F(CallVideo, TheTestInjectorBringsTheEngineUpAndDown) {
+	fake_invoke("testInjectVideo", "{\"realStream\":\"1\"}");
+	pump();
+	bring_up(false);
+	EXPECT_EQ(fake.video_starts, 1);
+	fake_invoke("testStopInjectVideo", "{}");
+	pump();
+	EXPECT_EQ(fake.video_stops, 1);
+	EXPECT_EQ(count_engine_calls("stop"), 1);
+}
+
+// A failed first run (e.g. the bus refused the engine) leaves the injector
+// on; a second inject must say so, not claim a real call is up.
+TEST_F(CallVideo, ASecondInjectAsksToStopTheFirst) {
+	fake_invoke("testInjectVideo", "{}");
+	pump();
+	fake_invoke("testInjectVideo", "{}");
+	EXPECT_TRUE(has(fake.last_method_reply, "already injecting")) << fake.last_method_reply;
+	EXPECT_EQ(count_engine_calls("capabilities"), 1);
+	fake_invoke("testStopInjectVideo", "{}");
+	pump();
+	fake_invoke("testInjectVideo", "{}");
+	EXPECT_TRUE(has(fake.last_method_reply, "\"returnValue\":true")) << fake.last_method_reply;
+}
+
+} // namespace

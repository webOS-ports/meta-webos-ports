+/* ---------- video: a luneos-rtc-engine session behind the call's video ----------
+ * The engine (org.webosports.rtcengine; luneos-rtc-engine docs/API.md) decodes the peer's
+ * H.264 and publishes the frames on a gst-shm socket, which the Phone app renders with
+ * LuneOS.Foreign's RtcVideoFactory. On a device with a usable camera it also encodes ours.
+ * glue/voipkit_rtcengine.c moves the access units over the engine's sockets.
+ *
+ * The session runs while the call carries video (Go: gowhatsapp_call_video_active) AND the
+ * user asked to see it (the Phone app's changeMedia {incomingVideo:true} -- legacy webOS's
+ * "Switch to video?" accept). Until then nothing is decoded and audiod keeps treating the
+ * call as a voice call.
+ *
+ * Everything here runs on the GLib mainloop: LS2 calls are not made from Go's threads.
+ * Replies of a session that was closed in the meantime are recognised by g_vid_gen. */
+#define RTC_SERVICE "luna://org.webosports.rtcengine/"
+// Device-side paths the engine binds; its own defaults are in /tmp as well.
+#define RTC_RX_SOCKET "/tmp/wa-rtc-rx.sock"
+#define RTC_TX_SOCKET "/tmp/wa-rtc-tx.sock"
+#define RTC_SHM_PATH "/tmp/wa-rtc-video"
+// The frame size the engine renders to (and encodes at, with a camera). Receive-only is
+// portrait, as phones send; the engine letterboxes other shapes.
+#define RTC_RX_ONLY_W 480
+#define RTC_RX_ONLY_H 640
+#define RTC_TX_W 640
+#define RTC_TX_H 480
+#define RTC_TX_BITRATE 500000
+// Peer keyframe requests (PLI/FIR) are passed to the encoder at most this often.
+#define RTC_KEYFRAME_MIN_INTERVAL_US (500 * 1000)
 

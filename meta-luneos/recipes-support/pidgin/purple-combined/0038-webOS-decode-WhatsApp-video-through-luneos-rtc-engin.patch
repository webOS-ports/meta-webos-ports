+	EXPECT_FALSE(has(r, "videoWidth")) << r;
+}
+
+TEST_F(CallVideo, TurningTheViewOffStopsTheEngine) {
+	want_video();
+	bring_up(false);
+	int before = ncalls();
+	fake_invoke("changeMedia", "{\"id\":\"A1\",\"incomingVideo\":false}");
+	pump();
+	EXPECT_EQ(fake.video_stops, 1);
+	EXPECT_GE(find_engine_call("stop", before), 0);
+}
+
+TEST_F(CallVideo, TheCallEndingStopsTheEngineAndForgetsTheWish) {
+	want_video();
+	bring_up(false);
+	gowhatsapp_call_video_active(0);
+	pump();
+	EXPECT_EQ(fake.video_stops, 1);
+	EXPECT_EQ(count_engine_calls("stop"), 1);
+	int before = ncalls();
+	gowhatsapp_call_video_active(1); // the next call

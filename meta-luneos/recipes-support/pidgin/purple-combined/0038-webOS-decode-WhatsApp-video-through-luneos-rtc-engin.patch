+	fake_reply(caps, "{\"returnValue\":true,\"videoCallCapable\":false}");
+	int new_start = find_engine_call("start", old_start + 1);
+	ASSERT_GE(new_start, 0);
+	fake_reply(old_start, "{\"returnValue\":true,\"rxSocket\":\"/tmp/wa-rtc-rx.sock\"}");
+	pump();
+	EXPECT_EQ(fake.video_starts, 0) << "the old answer must not bring the bridge up";
+	EXPECT_EQ(count_engine_calls("stop"), 1) << "what the old start brought up is stopped";
+	fake_reply(new_start, "{\"returnValue\":true,\"rxSocket\":\"/tmp/wa-rtc-rx.sock\"}");
+	pump();

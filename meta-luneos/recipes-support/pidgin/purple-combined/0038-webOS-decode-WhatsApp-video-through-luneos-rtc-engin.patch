+
+TEST_F(CallVideo, AStartThatAnswersAfterTheCloseIsStopped) {
+	want_video();
+	fake_reply(find_engine_call("capabilities"), "{\"returnValue\":true,\"videoCallCapable\":false}");
+	int start = find_engine_call("start");
+	ASSERT_GE(start, 0);
+	gowhatsapp_call_video_active(0); // closed while starting
+	pump();
+	EXPECT_EQ(count_engine_calls("stop"), 0) << "nothing to stop yet";
+	fake_reply(start, "{\"returnValue\":true,\"rxSocket\":\"/tmp/wa-rtc-rx.sock\"}");

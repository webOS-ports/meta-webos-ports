diff --git a/glue/tests/voipkit_rtcengine_test.cpp b/glue/tests/voipkit_rtcengine_test.cpp
new file mode 100644
index 0000000..d6df40f
--- /dev/null
+++ b/glue/tests/voipkit_rtcengine_test.cpp
@@ -0,0 +1,330 @@
+// Tests glue/voipkit_rtcengine.c against real AF_UNIX SOCK_SEQPACKET listeners standing in for
+// luneos-rtc-engine: whole access units in order, nothing passed on before an IDR, drops and
+// reconnects recover at the next IDR and ask the peer for one (rate-limited), the TX thread hands
+// every unit to Go and stops promptly, and the caller is never blocked.
+#include <gtest/gtest.h>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "voipkit.h"
+#include "voipkit_rtcengine.h"
+
+namespace {
+
+std::mutex g_mx;
+std::vector<std::vector<unsigned char>> g_out; // what reached Go from the TX socket
+std::atomic<int> g_keyframe_requests{0};
+
+} // namespace
+
+extern "C" void gowhatsapp_call_video_frame_out(char *data, int length) {
+	std::lock_guard<std::mutex> l(g_mx);
+	g_out.emplace_back(reinterpret_cast<unsigned char *>(data),
+	                   reinterpret_cast<unsigned char *>(data) + length);
+}
+extern "C" void gowhatsapp_go_call_request_peer_keyframe(void) { g_keyframe_requests++; }
+
+namespace {
+
+using namespace std::chrono;
+
+std::vector<unsigned char> au(int nal_type, int tag, size_t size = 64) {
+	std::vector<unsigned char> v(size, static_cast<unsigned char>(tag));
+	v[0] = 0; v[1] = 0; v[2] = 0; v[3] = 1;
+	v[4] = static_cast<unsigned char>(0x60 | nal_type);
+	return v;
+}
+std::vector<unsigned char> idr(int tag, size_t size = 64) {
+	// SPS, PPS, then the IDR slice, as an encoder's first unit.
+	std::vector<unsigned char> v = {0, 0, 0, 1, 0x67, 0x42, 0, 0, 1, 0x68, 0xce};
+	auto s = au(5, tag, size);
+	v.insert(v.end(), s.begin(), s.end());
+	return v;
+}
+std::vector<unsigned char> pframe(int tag, size_t size = 64) { return au(1, tag, size); }
+
+struct Listener {
+	std::string path;
+	int fd = -1;
+	explicit Listener(const std::string &p) : path(p) {
+		unlink(path.c_str());
+		fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+		sockaddr_un sa{};
+		sa.sun_family = AF_UNIX;
+		std::snprintf(sa.sun_path, sizeof sa.sun_path, "%s", path.c_str());
+		EXPECT_EQ(bind(fd, reinterpret_cast<sockaddr *>(&sa), sizeof sa), 0);
+		EXPECT_EQ(listen(fd, 1), 0);
+	}
+	~Listener() {
+		if (fd >= 0) close(fd);
+		unlink(path.c_str());
+	}
+	int accept_within(int ms) {
+		pollfd p{fd, POLLIN, 0};
+		if (poll(&p, 1, ms) <= 0) return -1;
+		return accept4(fd, nullptr, nullptr, SOCK_CLOEXEC);
+	}
+};
+
+std::vector<unsigned char> recv_within(int fd, int ms) {
+	pollfd p{fd, POLLIN, 0};
+	if (poll(&p, 1, ms) <= 0) return {};
+	std::vector<unsigned char> buf(1 << 20);
+	ssize_t n = recv(fd, buf.data(), buf.size(), 0);
+	if (n <= 0) return {};
+	buf.resize(static_cast<size_t>(n));
+	return buf;
+}
+
+void send_au(const std::vector<unsigned char> &v) {
+	voipkit_video_receive_frame(v.data(), static_cast<unsigned int>(v.size()));
+}
+
+std::string tmpdir() {
+	char t[] = "/tmp/wa-rtc-test-XXXXXX"; // the test's own sockets; removed in TearDown
+	return mkdtemp(t);
+}
+
+class Bridge : public ::testing::Test {
+protected:
+	std::string dir;
+	void SetUp() override {
+		dir = tmpdir();
+		std::lock_guard<std::mutex> l(g_mx);
+		g_out.clear();
+		g_keyframe_requests = 0;
+	}
+	void TearDown() override {
+		voipkit_video_stop();
+		voipkit_rtcengine_set_sockets(nullptr, nullptr);
+		rmdir(dir.c_str());
+	}
+};
+
+TEST(BridgeIdr, FindsTheIdrSlice) {
+	auto a = idr(1);
+	EXPECT_TRUE(voipkit_rtcengine_au_has_idr(a.data(), a.size()));
+	auto p = pframe(1);
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(p.data(), p.size()));
+	const unsigned char three[] = {0, 0, 1, 0x65, 0x88};
+	EXPECT_TRUE(voipkit_rtcengine_au_has_idr(three, sizeof three));
+	const unsigned char sps_pps[] = {0, 0, 0, 1, 0x67, 0x42, 0, 0, 1, 0x68, 0xce};
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(sps_pps, sizeof sps_pps));
+	const unsigned char cut[] = {0, 0, 1};
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(cut, sizeof cut));
+	EXPECT_FALSE(voipkit_rtcengine_au_has_idr(nullptr, 0));
+}
+
+TEST_F(Bridge, RejectsPathsThatDoNotFit) {
+	std::string longp(200, 'x');
+	EXPECT_FALSE(voipkit_rtcengine_set_sockets(nullptr, longp.c_str()));
+	EXPECT_TRUE(voipkit_rtcengine_set_sockets(nullptr, (dir + "/rx").c_str()));
+}
+
+TEST_F(Bridge, PathsCannotChangeWhileRunning) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	EXPECT_FALSE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+}
+
+TEST_F(Bridge, NothingPassesBeforeStart) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	send_au(idr(1));
+	EXPECT_EQ(rx.accept_within(100), -1) << "not running: no connection made";
+}
+
+TEST_F(Bridge, StartsAtAnIdrAndKeepsUnitsWholeAndInOrder) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	EXPECT_TRUE(voipkit_video_wait_thread_b(100));
+	send_au(pframe(1));
+	send_au(pframe(2));
+	EXPECT_EQ(g_keyframe_requests.load(), 1) << "asked once, rate-limited";
+	auto i = idr(3, 30000); // a keyframe-sized unit
+	send_au(i);
+	auto p = pframe(4, 900);
+	send_au(p);
+	EXPECT_EQ(recv_within(c, 500), i);
+	EXPECT_EQ(recv_within(c, 500), p);
+	EXPECT_TRUE(recv_within(c, 100).empty()) << "the P-frames before the IDR were held back";
+	unsigned long long sent = 0, dropped = 0;
+	voipkit_rtcengine_stats(&sent, &dropped);
+	EXPECT_EQ(sent, 2u);
+	EXPECT_EQ(dropped, 2u);
+	close(c);
+}
+
+TEST_F(Bridge, AFullSocketDropsWithoutBlockingAndRecoversAtTheNextIdr) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	send_au(idr(1, 4000));
+	// The engine stops reading: keep sending until the socket is full.
+	auto t0 = steady_clock::now();
+	unsigned long long dropped = 0;
+	for (int k = 0; k < 5000 && dropped == 0; k++) {
+		send_au(pframe(2, 4000));
+		voipkit_rtcengine_stats(nullptr, &dropped);
+	}
+	EXPECT_LT(duration_cast<milliseconds>(steady_clock::now() - t0).count(), 2000)
+		<< "the caller is never blocked";
+	ASSERT_GT(dropped, 0u);
+	int asked = g_keyframe_requests.load();
+	EXPECT_GE(asked, 1);
+	// Drain everything that made it.
+	while (!recv_within(c, 50).empty()) {
+	}
+	send_au(pframe(3));
+	EXPECT_TRUE(recv_within(c, 100).empty()) << "after a drop, nothing until an IDR";
+	auto i = idr(4);
+	send_au(i);
+	EXPECT_EQ(recv_within(c, 500), i);
+	close(c);
+}
+
+TEST_F(Bridge, ReconnectsWhenTheEngineGoesAway) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	send_au(idr(1));
+	ASSERT_FALSE(recv_within(c, 500).empty());
+	close(c); // the engine restarted its RX side
+	send_au(pframe(2)); // fails: the bridge lets go of the socket
+	std::this_thread::sleep_for(milliseconds(250)); // past the reconnect spacing
+	send_au(pframe(3));
+	int c2 = rx.accept_within(1000);
+	ASSERT_GE(c2, 0) << "reconnected";
+	send_au(pframe(4));
+	auto i = idr(5);
+	send_au(i);
+	EXPECT_EQ(recv_within(c2, 500), i) << "resumes at an IDR";
+	close(c2);
+}
+
+TEST_F(Bridge, KeyframeRequestsAreRateLimited) {
+	Listener rx(dir + "/rx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(nullptr, rx.path.c_str()));
+	voipkit_video_start();
+	int c = rx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	for (int k = 0; k < 50; k++) send_au(pframe(k));
+	EXPECT_EQ(g_keyframe_requests.load(), 1);
+	std::this_thread::sleep_for(milliseconds(1050));
+	send_au(pframe(99));
+	EXPECT_EQ(g_keyframe_requests.load(), 2);
+	close(c);
+}
+
+TEST_F(Bridge, TxHandsEveryUnitToGoInOrder) {
+	Listener rx(dir + "/rx"), tx(dir + "/tx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(tx.path.c_str(), rx.path.c_str()));
+	voipkit_video_start();
+	int c = tx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	std::vector<std::vector<unsigned char>> sent;
+	for (int k = 0; k < 20; k++) {
+		sent.push_back(k == 0 ? idr(k, 50000) : pframe(k, 100 + static_cast<size_t>(k)));
+		ASSERT_EQ(send(c, sent.back().data(), sent.back().size(), MSG_NOSIGNAL),
+		          static_cast<ssize_t>(sent.back().size()));
+	}
+	for (int w = 0; w < 100; w++) {
+		{
+			std::lock_guard<std::mutex> l(g_mx);
+			if (g_out.size() >= sent.size()) break;
+		}
+		std::this_thread::sleep_for(milliseconds(10));
+	}
+	std::lock_guard<std::mutex> l(g_mx);
+	EXPECT_EQ(g_out, sent);
+	close(c);
+	int r = rx.accept_within(10);
+	if (r >= 0) close(r);
+}
+
+TEST_F(Bridge, TxReconnectsAfterTheEngineCloses) {
+	Listener tx(dir + "/tx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(tx.path.c_str(), nullptr));
+	voipkit_video_start();
+	int c = tx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	close(c);
+	int c2 = tx.accept_within(2000);
+	ASSERT_GE(c2, 0);
+	auto i = idr(7);
+	ASSERT_EQ(send(c2, i.data(), i.size(), MSG_NOSIGNAL), static_cast<ssize_t>(i.size()));
+	for (int w = 0; w < 100; w++) {
+		{
+			std::lock_guard<std::mutex> l(g_mx);
+			if (!g_out.empty()) break;
+		}
+		std::this_thread::sleep_for(milliseconds(10));
+	}
+	std::lock_guard<std::mutex> l(g_mx);
+	ASSERT_EQ(g_out.size(), 1u);
+	EXPECT_EQ(g_out[0], i);
+	close(c2);
+}
+
+TEST_F(Bridge, StopIsPromptAndIdempotentEvenWithNoEngine) {
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets((dir + "/nobody-tx").c_str(),
+	                                          (dir + "/nobody-rx").c_str()));
+	voipkit_video_start();
+	voipkit_video_start(); // no second TX thread
+	send_au(idr(1));       // nothing listens: dropped quietly
+	EXPECT_FALSE(voipkit_video_wait_thread_b(100));
+	auto t0 = steady_clock::now();
+	voipkit_video_stop();
+	EXPECT_LT(duration_cast<milliseconds>(steady_clock::now() - t0).count(), 1000);
+	voipkit_video_stop();
+}
+
+TEST_F(Bridge, AnOversizedTxUnitIsDroppedNotTruncated) {
+	Listener tx(dir + "/tx");
+	ASSERT_TRUE(voipkit_rtcengine_set_sockets(tx.path.c_str(), nullptr));
+	voipkit_video_start();
+	int c = tx.accept_within(1000);
+	ASSERT_GE(c, 0);
+	int sz = 4 << 20;
+	setsockopt(c, SOL_SOCKET, SO_SNDBUFFORCE, &sz, sizeof sz);
+	setsockopt(c, SOL_SOCKET, SO_SNDBUF, &sz, sizeof sz);
+	auto big = idr(1, (1 << 20) + 100);
+	ssize_t n = send(c, big.data(), big.size(), MSG_NOSIGNAL);
+	auto small = pframe(2);
+	ASSERT_EQ(send(c, small.data(), small.size(), MSG_NOSIGNAL), static_cast<ssize_t>(small.size()));
+	for (int w = 0; w < 100; w++) {
+		{
+			std::lock_guard<std::mutex> l(g_mx);
+			if (!g_out.empty()) break;
+		}
+		std::this_thread::sleep_for(milliseconds(10));
+	}
+	std::lock_guard<std::mutex> l(g_mx);
+	ASSERT_FALSE(g_out.empty());
+	if (n == static_cast<ssize_t>(big.size())) {
+		EXPECT_EQ(g_out.size(), 1u) << "the oversized unit never reaches Go";
+	}
+	EXPECT_EQ(g_out.back(), small);
+	close(c);
+}
+
+} // namespace
diff --git a/glue/voipkit_rtcengine.c b/glue/voipkit_rtcengine.c
new file mode 100644
index 0000000..59667e0
--- /dev/null
+++ b/glue/voipkit_rtcengine.c
@@ -0,0 +1,322 @@
+// voipkit_rtcengine.c -- video bridge to luneos-rtc-engine (org.webosports.rtcengine).
+//
+// The engine owns the camera, the H.264 encoder and decoder, and the rendering. It binds two
+// AF_UNIX SOCK_SEQPACKET sockets and carries one complete Annex-B access unit per datagram
+// (luneos-rtc-engine docs/API.md, "AU socket wire contract"):
+//
+//   RX socket  connector -> engine   the peer's access units, as meowcaller's ReceiveVideo
+//                                    delivers them; the engine decodes and renders them.
+//   TX socket  engine -> connector   our encoded camera, handed to Call.SendVideo through
+//                                    gowhatsapp_call_video_frame_out.
+//
+// glue/call.c starts and stops the engine session over LS2 and tells this file the socket
+// paths (voipkit_rtcengine_set_sockets) before voipkit_video_start(). This file only moves
+// bytes; it never blocks the caller:
+//
+// - The RX side sends from the caller's thread (a Go goroutine) with MSG_DONTWAIT. A full
+//   socket drops the access unit instead of stalling meowcaller's receive loop. A dropped
+//   unit breaks the decoder's reference chain, so after any drop -- and when the bridge
+//   first connects, mid-stream -- units are held back until the next IDR, and the peer is
+//   asked for one (gowhatsapp_go_call_request_peer_keyframe, rate-limited).
+// - The TX side is one thread reading the TX socket and passing each unit to Go. Without a
+//   TX path (no usable camera on the device) the thread is not started.
+#include <errno.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "voipkit.h"
+#include "voipkit_rtcengine.h"
+
+// Exported by call.go (cgo //export); declared here rather than through the generated
+// header so this file builds without the Go half (the unit tests link stubs instead).
+extern void gowhatsapp_call_video_frame_out(char *data, int length);
+extern void gowhatsapp_go_call_request_peer_keyframe(void);
+
+// Largest access unit read from the TX socket. The engine's keyframes at 1280x720 are
+// hundreds of KB (docs/API.md); a larger datagram is truncated by recv() and dropped.
+#define TX_AU_MAX (1024 * 1024)
+// Receive-side socket buffer asked for. A SOCK_SEQPACKET datagram must fit in the send
+// buffer whole, so this bounds the largest peer keyframe the RX side can pass on.
+#define RX_SNDBUF (1024 * 1024)
+// Minimum spacing of reconnect attempts and of keyframe requests to the peer.
+#define RECONNECT_INTERVAL_MS 200
+#define KEYFRAME_REQUEST_INTERVAL_MS 1000
+
+static pthread_mutex_t s_mx = PTHREAD_MUTEX_INITIALIZER;
+static char s_rx_path[sizeof(((struct sockaddr_un *)0)->sun_path)];
+static char s_tx_path[sizeof(((struct sockaddr_un *)0)->sun_path)];
+static int s_running;            // between voipkit_video_start and voipkit_video_stop
+static int s_rx_fd = -1;
+static int s_rx_wait_idr = 1;    // hold units back until the next IDR
+static long long s_rx_last_connect_ms;
+static long long s_last_keyframe_req_ms = -KEYFRAME_REQUEST_INTERVAL_MS;
+static unsigned long long s_rx_sent, s_rx_dropped;
+
+static pthread_t s_tx_thread;
+static int s_tx_started;
+static atomic_int s_tx_stop;
+
+static long long now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+int voipkit_rtcengine_au_has_idr(const unsigned char *au, size_t len)
+{
+	// Annex-B: NAL units follow 00 00 01 (or 00 00 00 01) start codes; the NAL type is
+	// the low five bits of the byte after the start code. 5 = IDR slice.
+	for (size_t i = 0; i + 3 < len; i++) {
+		if (au[i] == 0 && au[i + 1] == 0 && au[i + 2] == 1) {
+			if ((au[i + 3] & 0x1f) == 5)
+				return 1;
+			i += 2;
+		}
+	}
+	return 0;
+}
+
+static int set_path(char *dst, size_t dstsz, const char *path)
+{
+	if (!path || !path[0]) {
+		dst[0] = 0;
+		return 1;
+	}
+	size_t n = strlen(path);
+	if (n >= dstsz)
+		return 0;
+	memcpy(dst, path, n + 1);
+	return 1;
+}
+
+int voipkit_rtcengine_set_sockets(const char *tx_path, const char *rx_path)
+{
+	pthread_mutex_lock(&s_mx);
+	int ok = !s_running && set_path(s_tx_path, sizeof s_tx_path, tx_path) &&
+	         set_path(s_rx_path, sizeof s_rx_path, rx_path);
+	if (!ok) {
+		s_tx_path[0] = 0;
+		s_rx_path[0] = 0;
+	}
+	pthread_mutex_unlock(&s_mx);
+	return ok;
+}
+
+static int connect_seqpacket(const char *path)
+{
+	struct sockaddr_un sa;
+	memset(&sa, 0, sizeof sa);
+	sa.sun_family = AF_UNIX;
+	memcpy(sa.sun_path, path, strlen(path) + 1);  // fits: checked in set_path
+	int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return -1;
+	if (connect(fd, (struct sockaddr *)&sa, sizeof sa) < 0) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+// Called with s_mx held.
+static void rx_connect_locked(void)
+{
+	long long t = now_ms();
+	if (s_rx_fd >= 0 || !s_rx_path[0] || t - s_rx_last_connect_ms < RECONNECT_INTERVAL_MS)
+		return;
+	s_rx_last_connect_ms = t;
+	int fd = connect_seqpacket(s_rx_path);
+	if (fd < 0)
+		return;
+	int sz = RX_SNDBUF;
+	// SO_SNDBUFFORCE passes net.core.wmem_max when we may (the service runs as root).
+	if (setsockopt(fd, SOL_SOCKET, SO_SNDBUFFORCE, &sz, sizeof sz) < 0)
+		(void)setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &sz, sizeof sz);
+	s_rx_fd = fd;
+	s_rx_wait_idr = 1;  // joining mid-stream
+	fprintf(stderr, "wa-video: rx connected to %s\n", s_rx_path);
+}
+
+// Called with s_mx held. Returns 1 when the caller should ask the peer for a keyframe.
+static int keyframe_due_locked(void)
+{
+	long long t = now_ms();
+	if (t - s_last_keyframe_req_ms < KEYFRAME_REQUEST_INTERVAL_MS)
+		return 0;
+	s_last_keyframe_req_ms = t;
+	return 1;
+}
+
+void voipkit_video_receive_frame(const unsigned char *access_unit, unsigned int len)
+{
+	int want_keyframe = 0;
+	if (!access_unit || len == 0)
+		return;
+	pthread_mutex_lock(&s_mx);
+	if (!s_running) {
+		pthread_mutex_unlock(&s_mx);
+		return;
+	}
+	rx_connect_locked();
+	if (s_rx_fd < 0) {
+		pthread_mutex_unlock(&s_mx);
+		return;
+	}
+	if (s_rx_wait_idr) {
+		if (!voipkit_rtcengine_au_has_idr(access_unit, len)) {
+			s_rx_dropped++;
+			want_keyframe = keyframe_due_locked();
+			pthread_mutex_unlock(&s_mx);
+			if (want_keyframe)
+				gowhatsapp_go_call_request_peer_keyframe();
+			return;
+		}
+		s_rx_wait_idr = 0;
+	}
+	ssize_t n = send(s_rx_fd, access_unit, len, MSG_DONTWAIT | MSG_NOSIGNAL);
+	if (n == (ssize_t)len) {
+		s_rx_sent++;
+	} else {
+		int err = n < 0 ? errno : EMSGSIZE;
+		s_rx_dropped++;
+		s_rx_wait_idr = 1;
+		if (err != EAGAIN && err != EWOULDBLOCK && err != EMSGSIZE && err != ENOBUFS) {
+			// The engine went away (session stopped or restarted): reconnect later.
+			close(s_rx_fd);
+			s_rx_fd = -1;
+		}
+		want_keyframe = keyframe_due_locked();
+	}
+	pthread_mutex_unlock(&s_mx);
+	if (want_keyframe)
+		gowhatsapp_go_call_request_peer_keyframe();
+}
+
+static void *tx_thread_main(void *arg)
+{
+	char path[sizeof s_tx_path];
+	memcpy(path, arg, sizeof path);
+	free(arg);
+	unsigned char *buf = malloc(TX_AU_MAX);
+	if (!buf)
+		return NULL;
+	int fd = -1;
+	while (!atomic_load(&s_tx_stop)) {
+		if (fd < 0) {
+			fd = connect_seqpacket(path);
+			if (fd < 0) {
+				poll(NULL, 0, RECONNECT_INTERVAL_MS);
+				continue;
+			}
+			fprintf(stderr, "wa-video: tx connected to %s\n", path);
+		}
+		struct pollfd p = {.fd = fd, .events = POLLIN};
+		int r = poll(&p, 1, RECONNECT_INTERVAL_MS);
+		if (r < 0 && errno != EINTR)
+			break;
+		if (r <= 0)
+			continue;
+		ssize_t n = recv(fd, buf, TX_AU_MAX, MSG_TRUNC);
+		if (n <= 0) {
+			// 0: the engine closed the socket. Reconnect; the session may be restarting.
+			close(fd);
+			fd = -1;
+			continue;
+		}
+		if (n > TX_AU_MAX) {
+			fprintf(stderr, "wa-video: tx access unit of %zd bytes dropped (max %d)\n", n,
+			        TX_AU_MAX);
+			continue;
+		}
+		gowhatsapp_call_video_frame_out((char *)buf, (int)n);
+	}
+	if (fd >= 0)
+		close(fd);
+	free(buf);
+	return NULL;
+}
+
+void voipkit_video_start(void)
+{
+	pthread_mutex_lock(&s_mx);
+	if (s_running) {
+		pthread_mutex_unlock(&s_mx);
+		return;
+	}
+	s_running = 1;
+	s_rx_wait_idr = 1;
+	s_rx_sent = s_rx_dropped = 0;
+	s_rx_last_connect_ms = -RECONNECT_INTERVAL_MS;
+	// A new session may ask the peer for a keyframe at once, however recently the last did.
+	s_last_keyframe_req_ms = now_ms() - KEYFRAME_REQUEST_INTERVAL_MS;
+	rx_connect_locked();
+	if (s_tx_path[0]) {
+		char *path = malloc(sizeof s_tx_path);
+		if (path) {
+			memcpy(path, s_tx_path, sizeof s_tx_path);
+			atomic_store(&s_tx_stop, 0);
+			if (pthread_create(&s_tx_thread, NULL, tx_thread_main, path) == 0) {
+				s_tx_started = 1;
+			} else {
+				free(path);
+				fprintf(stderr, "wa-video: could not start the tx thread\n");
+			}
+		}
+	}
+	pthread_mutex_unlock(&s_mx);
+}
+
+int voipkit_video_wait_thread_b(int timeoutMs)
+{
+	long long deadline = now_ms() + (timeoutMs > 0 ? timeoutMs : 0);
+	for (;;) {
+		pthread_mutex_lock(&s_mx);
+		if (s_running)
+			rx_connect_locked();
+		int connected = s_rx_fd >= 0;
+		int running = s_running;
+		pthread_mutex_unlock(&s_mx);
+		if (connected || !running || now_ms() >= deadline)
+			return connected;
+		poll(NULL, 0, RECONNECT_INTERVAL_MS / 4);
+	}
+}
+
+void voipkit_video_stop(void)
+{
+	pthread_mutex_lock(&s_mx);
+	int join = s_tx_started;
+	s_tx_started = 0;
+	if (s_running)
+		fprintf(stderr, "wa-video: bridge stopped (rx sent %llu, dropped %llu)\n", s_rx_sent,
+		        s_rx_dropped);
+	s_running = 0;
+	if (s_rx_fd >= 0) {
+		close(s_rx_fd);
+		s_rx_fd = -1;
+	}
+	atomic_store(&s_tx_stop, 1);
+	pthread_mutex_unlock(&s_mx);
+	// Join outside the lock: the tx thread never takes it, but Go's frame_out might be slow.
+	if (join)
+		pthread_join(s_tx_thread, NULL);
+}
+
+void voipkit_rtcengine_stats(unsigned long long *sent, unsigned long long *dropped)
+{
+	pthread_mutex_lock(&s_mx);
+	if (sent)
+		*sent = s_rx_sent;
+	if (dropped)
+		*dropped = s_rx_dropped;
+	pthread_mutex_unlock(&s_mx);
+}

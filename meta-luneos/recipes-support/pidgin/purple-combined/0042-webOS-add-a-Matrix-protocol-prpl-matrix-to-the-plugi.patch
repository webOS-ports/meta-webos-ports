+#pragma once
+// Matrix (mautrix-go) part of the combined plugin. All identifiers are matrix_-prefixed so they
+// stay clear of the whatsmeow (gowhatsapp_) and Facebook (gometa_) parts in the same .so.
+#include <purple.h>
+#include <time.h>
+
+#define MATRIX_PLUGIN_ID      "prpl-matrix"
+#define MATRIX_PLUGIN_NAME    "Matrix"
+#define MATRIX_PLUGIN_SUMMARY "Matrix via mautrix-go (with end-to-end encryption)"
+#define MATRIX_AUTHOR         "webOS Synergy Revival"
+
+// The conversation the plugin uses for login and encryption prompts. Matrix user IDs always start
+// with '@', so no real contact can have this name.
+#define MATRIX_AUTH_BUDDY     "Matrix"
+
+enum matrix_message_type {
+    matrix_message_type_error,        // text = error; fatal: 0 = log only, 1 = network (reconnect), 2 = auth (stay offline)
+    matrix_message_type_connected,
+    matrix_message_type_text,         // a message (see the fields below)
+    matrix_message_type_buddy,        // add/update a contact: who = user ID, name = display name
+    matrix_message_type_chat,         // register a group room: conv = room ID, name = room name
+    matrix_message_type_prompt,       // text = shown in the auth conversation
+    matrix_message_type_typing,       // who = user ID, isOutgoing = 1 typing, 0 stopped
+    matrix_message_type_setting,      // name = setting key, text = value (written on the main thread)
+};
+
+typedef struct matrix_message {
+    PurpleAccount *account;
+    char *who;        // text: sender user ID
+    char *conv;       // text: 1:1 = the other user's ID, group = room ID
+    char *name;       // display name (sender, contact or room)
+    char *text;       // body; plain text unless isHtml
+    char *id;         // event ID
+    char *quotedText; // webOS replies: the replied-to message's text (NULL if not a reply)
+    char *quotedFrom; // webOS replies: its author's display name
+    char *quotedId;   // webOS replies: its event ID
+    time_t timestamp;
+    char msgtype;
+    char isGroup;
+    char isOutgoing;  // text: sent by us from another client; typing: 1 = started
+    char isHtml;      // text is already HTML (media links); otherwise it is escaped here
+    char fatal;
+} matrix_message_t;
+
+// Go -> purple. The C side takes ownership of the strings (free()) and runs on the glib main thread.
+extern void matrix_process_message(matrix_message_t msg);
+// The buddy-list chat for a room, by its "id" component (the room ID); NULL when there is none.
+extern PurpleChat *matrix_find_blist_chat(PurpleAccount *account, const char *room_id);
+
+// Account settings. Reads are made from the main thread (login); writes go through
+// matrix_message_type_setting. The returned string is malloc'd; the Go caller frees it.
+extern char *matrix_get_setting(PurpleAccount *account, const char *key);
+
+// webOS reactions (SEND): defined in glue/login.c, connected once per process.
+extern void webos_connect_send_reaction_once(void);

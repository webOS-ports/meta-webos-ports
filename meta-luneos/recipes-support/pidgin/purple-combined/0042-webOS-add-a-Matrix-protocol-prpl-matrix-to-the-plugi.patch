diff --git a/glue/matrix_init.c b/glue/matrix_init.c
new file mode 100644
index 0000000..036779e
--- /dev/null
+++ b/glue/matrix_init.c
@@ -0,0 +1,206 @@
+// matrix_init.c - registers Matrix (mautrix-go) as a further prpl inside the combined whatsmeow
+// .so, next to WhatsApp and Facebook (one .so, one Go runtime). plugin_init() in init.c calls
+// matrix_register_prpl(). Same manual registration as gometa_init.c.
+#include <purple.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../matrixbridge.h"
+#include "libwhatsmeow.h" // matrix_go_* (cgo exports)
+
+#ifndef PLUGIN_VERSION
+#define PLUGIN_VERSION 0.0.0
+#endif
+#define MX_STR(x) _MX_STR(x)
+#define _MX_STR(x) #x
+
+static const char *matrix_list_icon(PurpleAccount *account, PurpleBuddy *buddy) {
+    (void)account;
+    (void)buddy;
+    return "matrix";
+}
+
+static GList *matrix_status_types(PurpleAccount *account) {
+    (void)account;
+    GList *types = NULL;
+    types = g_list_append(types, purple_status_type_new_full(PURPLE_STATUS_AVAILABLE, NULL, NULL, TRUE, TRUE, FALSE));
+    types = g_list_append(types, purple_status_type_new_full(PURPLE_STATUS_OFFLINE, NULL, NULL, TRUE, TRUE, FALSE));
+    return types;
+}
+
+static void matrix_login(PurpleAccount *account) {
+    PurpleConnection *pc = purple_account_get_connection(account);
+    purple_connection_set_state(pc, PURPLE_CONNECTING);
+    const char *password = purple_account_get_password(account);
+    matrix_go_login(account, (char *)purple_user_dir(), (char *)purple_account_get_username(account),
+            (char *)(password ? password : ""));
+    webos_connect_send_reaction_once();
+}
+
+static void matrix_close(PurpleConnection *pc) {
+    matrix_go_close(purple_connection_get_account(pc));
+}
+
+// webOS replies: the transport puts the reply target's serviceMessageId on the conversation as
+// "webos-reply-to" before serv_send_im. Read and clear it.
+static gchar *matrix_take_reply_to(PurpleConversation *conv) {
+    if (conv == NULL) return NULL;
+    gchar *reply_to = (gchar *)purple_conversation_get_data(conv, "webos-reply-to");
+    if (reply_to != NULL) purple_conversation_set_data(conv, "webos-reply-to", NULL);
+    return reply_to;
+}
+
+static int matrix_send_im(PurpleConnection *pc, const char *who, const char *message, PurpleMessageFlags flags) {
+    (void)flags;
+    PurpleAccount *account = purple_connection_get_account(pc);
+    PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_IM, who, account);
+    gchar *reply_to = matrix_take_reply_to(conv);
+    // The message arrives as HTML from the conversation view; Matrix gets the plain text.
+    gchar *plain = purple_markup_strip_html(message);
+    int ret = matrix_go_send_message(account, (char *)who, plain ? plain : (char *)"", 0,
+            reply_to ? reply_to : (char *)"");
+    g_free(plain);
+    g_free(reply_to);
+    return ret;
+}
+
+static GList *matrix_chat_info(PurpleConnection *pc) {
+    (void)pc;
+    struct proto_chat_entry *pce = g_new0(struct proto_chat_entry, 1);
+    pce->label = "Room ID";
+    pce->identifier = "id";
+    pce->required = TRUE;
+    return g_list_append(NULL, pce);
+}
+
+static GHashTable *matrix_chat_info_defaults(PurpleConnection *pc, const char *chat_name) {
+    (void)pc;
+    GHashTable *defaults = g_hash_table_new_full(g_str_hash, g_str_equal, NULL, g_free);
+    if (chat_name) g_hash_table_insert(defaults, (gpointer)"id", g_strdup(chat_name));
+    return defaults;
+}
+
+static char *matrix_get_chat_name(GHashTable *components) {
+    const char *id = (const char *)g_hash_table_lookup(components, "id");
+    return g_strdup(id ? id : "");
+}
+
+static PurpleChat *matrix_find_chat_cb(PurpleAccount *account, const char *id) {
+    return matrix_find_blist_chat(account, id);
+}
+
+static void matrix_join_chat(PurpleConnection *pc, GHashTable *components) {
+    const char *id = (const char *)g_hash_table_lookup(components, "id");
+    if (!id || !*id) return;
+    int chat_id = (int)g_str_hash(id);
+    if (purple_find_chat(pc, chat_id) == NULL) {
+        serv_got_joined_chat(pc, chat_id, id);
+    }
+}
+
+// A room's conversation is named after its room ID (serv_got_joined_chat above), so the ID is
+// recovered from the conversation and the same send path as 1:1 is used.
+static int matrix_chat_send(PurpleConnection *pc, int id, const char *message, PurpleMessageFlags flags) {
+    (void)flags;
+    PurpleConversation *conv = purple_find_chat(pc, id);
+    if (conv == NULL) return -1;
+    const char *room_id = purple_conversation_get_name(conv);
+    if (room_id == NULL || *room_id == '\0') return -1;
+    gchar *reply_to = matrix_take_reply_to(conv);
+    gchar *plain = purple_markup_strip_html(message);
+    int ret = matrix_go_send_message(purple_connection_get_account(pc), (char *)room_id,
+            plain ? plain : (char *)"", 1, reply_to ? reply_to : (char *)"");
+    g_free(plain);
+    g_free(reply_to);
+    return ret > 0 ? 0 : -1;
+}
+
+static unsigned int matrix_send_typing(PurpleConnection *pc, const char *who, PurpleTypingState state) {
+    matrix_go_send_typing(purple_connection_get_account(pc), (char *)who, state == PURPLE_TYPING ? 1 : 0);
+    return 0;
+}
+
+static void matrix_xfer_send_init(PurpleXfer *xfer) {
+    PurpleAccount *account = purple_xfer_get_account(xfer);
+    const char *who = purple_xfer_get_remote_user(xfer);
+    const char *filename = purple_xfer_get_local_filename(xfer);
+    char *error = matrix_go_send_file(account, (char *)who, (char *)filename);
+    if (error && error[0]) {
+        purple_xfer_error(purple_xfer_get_type(xfer), account, who, error);
+        purple_xfer_cancel_local(xfer);
+    } else {
+        purple_xfer_set_bytes_sent(xfer, purple_xfer_get_size(xfer));
+        purple_xfer_set_completed(xfer, TRUE);
+    }
+    free(error);
+}
+
+static PurpleXfer *matrix_new_xfer(PurpleConnection *pc, const char *who) {
+    PurpleXfer *xfer = purple_xfer_new(purple_connection_get_account(pc), PURPLE_XFER_SEND, who);
+    purple_xfer_set_init_fnc(xfer, matrix_xfer_send_init);
+    return xfer;
+}
+
+static void matrix_send_file(PurpleConnection *pc, const char *who, const char *filename) {
+    PurpleXfer *xfer = matrix_new_xfer(pc, who);
+    if (filename && *filename) {
+        purple_xfer_request_accepted(xfer, filename);
+    } else {
+        purple_xfer_request(xfer);
+    }
+}
+
+// A room's file send: the conversation name is the room ID, which the Go side accepts as "who".
+static void matrix_chat_send_file(PurpleConnection *pc, int id, const char *filename) {
+    PurpleConversation *conv = purple_find_chat(pc, id);
+    if (conv == NULL) return;
+    const char *room_id = purple_conversation_get_name(conv);
+    if (room_id != NULL && *room_id) matrix_send_file(pc, room_id, filename);
+}
+
+static PurplePluginProtocolInfo matrix_prpl_info = {
+    .struct_size = sizeof(PurplePluginProtocolInfo),
+    .options = OPT_PROTO_IM_IMAGE | OPT_PROTO_PASSWORD_OPTIONAL,
+    .list_icon = matrix_list_icon,
+    .status_types = matrix_status_types,
+    .login = matrix_login,
+    .close = matrix_close,
+    .send_im = matrix_send_im,
+    .send_typing = matrix_send_typing,
+    .new_xfer = matrix_new_xfer,
+    .send_file = matrix_send_file,
+    .chat_send_file = matrix_chat_send_file,
+    .chat_info = matrix_chat_info,
+    .chat_info_defaults = matrix_chat_info_defaults,
+    .join_chat = matrix_join_chat,
+    .get_chat_name = matrix_get_chat_name,
+    .find_blist_chat = matrix_find_chat_cb,
+    .chat_send = matrix_chat_send,
+};
+
+static PurplePluginInfo matrix_info = {
+    .magic = PURPLE_PLUGIN_MAGIC,
+    .major_version = PURPLE_MAJOR_VERSION,
+    .minor_version = PURPLE_MINOR_VERSION,
+    .type = PURPLE_PLUGIN_PROTOCOL,
+    .priority = PURPLE_PRIORITY_DEFAULT,
+    .id = MATRIX_PLUGIN_ID,
+    .name = MATRIX_PLUGIN_NAME,
+    .version = MX_STR(PLUGIN_VERSION),
+    .summary = MATRIX_PLUGIN_SUMMARY,
+    .description = MATRIX_PLUGIN_SUMMARY,
+    .author = MATRIX_AUTHOR,
+    .homepage = "https://github.com/mautrix/go",
+    .extra_info = &matrix_prpl_info,
+};
+
+void matrix_register_prpl(void) {
+    PurplePlugin *p = purple_plugin_new(TRUE, NULL);
+    p->info = &matrix_info;
+    purple_plugin_load(p);
+    if (purple_plugin_register(p)) {
+        purple_debug_info("matrix", "registered prpl %s\n", MATRIX_PLUGIN_ID);
+    } else {
+        // purple-matrix (matrix-org) also registers prpl-matrix; whichever loads first wins.
+        purple_debug_error("matrix", "FAILED to register %s (is purple-matrix still installed?)\n", MATRIX_PLUGIN_ID);
+    }
+}

+func neonCfft(input, out []cpx, sign float32) bool {
+	n := len(input)
+	if n == 0 || len(out) < n {
+		return false
+	}
+	C.wa_neon_cfft(
+		(*C.float)(unsafe.Pointer(&input[0])),
+		(*C.float)(unsafe.Pointer(&out[0])),
+		C.int(n), C.float(sign))
+	return true
+}

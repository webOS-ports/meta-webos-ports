diff --git a/relay_endpoint_test.go b/relay_endpoint_test.go
new file mode 100644
index 0000000..453d08d
--- /dev/null
+++ b/relay_endpoint_test.go
@@ -0,0 +1,115 @@
+package meowcaller
+
+import (
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+)
+
+func te2(relayID, tokenID, authTokenID, isFNA, name string, addr []byte) waBinary.Node {
+	attrs := waBinary.Attrs{
+		"relay_id": relayID, "relay_name": name, "token_id": tokenID,
+		"auth_token_id": authTokenID,
+	}
+	if isFNA != "" {
+		attrs["is_fna"] = isFNA
+	}
+	return waBinary.Node{Tag: "te2", Attrs: attrs, Content: addr}
+}
+
+func relayNode(endpoints ...waBinary.Node) *waBinary.Node {
+	return &waBinary.Node{Tag: "relay", Content: endpoints}
+}
+
+// TestGetMediaRelayEndpoint pins which relay a call allocates on. The caller's
+// uplink lands on the relay it marked is_fna=1, so an inbound call has to
+// allocate there, or the relay never bridges the caller's media and the callee
+// hears nothing. Outbound calls keep the non-FNA preference.
+func TestGetMediaRelayEndpoint(t *testing.T) {
+	ams := []byte{57, 144, 223, 57, 0x0d, 0x96}
+	dus := []byte{157, 240, 27, 129, 0x0d, 0x96}
+	fra := []byte{157, 240, 1, 1, 0x0d, 0x96}
+	cases := []struct {
+		name    string
+		relay   *waBinary.Node
+		inbound bool
+		want    string
+	}{
+		{
+			name: "inbound picks the caller's FNA relay",
+			relay: relayNode(
+				te2("0", "1", "1", "", "ams2c01", ams),
+				te2("1", "0", "0", "1", "dus1c01", dus),
+			),
+			inbound: true,
+			want:    "dus1c01",
+		},
+		{
+			name: "outbound keeps the authenticated non-FNA relay",
+			relay: relayNode(
+				te2("0", "1", "1", "", "ams2c01", ams),
+				te2("1", "0", "0", "1", "dus1c01", dus),
+			),
+			inbound: false,
+			want:    "ams2c01",
+		},
+		{
+			name: "outbound falls back to any non-FNA relay",
+			relay: relayNode(
+				te2("0", "0", "0", "1", "dus1c01", dus),
+				te2("1", "1", "0", "", "fra3c01", fra),
+			),
+			inbound: false,
+			want:    "fra3c01",
+		},
+		{
+			name: "inbound takes the first FNA relay when there are several",
+			relay: relayNode(
+				te2("0", "1", "1", "", "ams2c01", ams),
+				te2("1", "0", "0", "1", "dus1c01", dus),
+				te2("2", "0", "0", "1", "fra3c01", fra),
+			),
+			inbound: true,
+			want:    "dus1c01",
+		},
+		{
+			// The incoming offer of 30 October 2026 (call 001C6133...) marks no relay
+			// is_fna and gives none an auth token: both directions take the first.
+			name: "inbound without an FNA relay takes the first non-FNA one",
+			relay: relayNode(
+				te2("0", "1", "0", "", "ams2c01", ams),
+				te2("1", "0", "0", "", "dus1c01", dus),
+			),
+			inbound: true,
+			want:    "ams2c01",
+		},
+		{
+			name: "is_fna other than 1 is not FNA",
+			relay: relayNode(
+				te2("0", "1", "0", "0", "ams2c01", ams),
+				te2("1", "0", "0", "", "dus1c01", dus),
+			),
+			inbound: true,
+			want:    "ams2c01",
+		},
+	}
+	for _, c := range cases {
+		rd := parseRelayData(c.relay)
+		ep := getMediaRelayEndpoint(rd, c.inbound)
+		if ep == nil {
+			t.Errorf("%s: no endpoint picked", c.name)
+			continue
+		}
+		if ep.relayName != c.want {
+			t.Errorf("%s: picked %s, want %s", c.name, ep.relayName, c.want)
+		}
+	}
+}
+
+func TestGetMediaRelayEndpointEmpty(t *testing.T) {
+	for _, inbound := range []bool{false, true} {
+		if ep := getMediaRelayEndpoint(&relayData{}, inbound); ep != nil {
+			t.Errorf("inbound=%v: picked %s from a relay with no endpoints", inbound, ep.relayName)
+		}
+	}
+}

 		var firstVideoTick uint64
 		var haveFirstVideo bool
+		// PLI then FIR at the peer's video SSRC; reports which of the two could be built.
+		sendKeyframeRequest := func(inGrace bool) (pliOK, firOK bool) {
+			pliPacket, err := videoRtcp.pli(peerVideoSsrc)
+			if err == nil {
+				_, _ = ch.Send(pliPacket)
+				e.c.diag.Emit("rtcp", map[string]any{
+					"event": "pli_sent", "peer_video_ssrc": peerVideoSsrc, "in_grace": inGrace,
+				})
+			}
+			firSeqNr++
+			firPacket, ferr := videoRtcp.fir(peerVideoSsrc, firSeqNr)
+			if ferr == nil {
+				_, _ = ch.Send(firPacket)
+			}
+			return err == nil, ferr == nil
+		}
+		keyframeRequests := call.peerKeyframeRequests()
 		doTick := func(now time.Time) bool {
 			audioPacket, err := audioRtcp.senderReport(txPipe.SenderStats(), uint64(now.UnixMilli()))
 			if err != nil {
@@ -584,21 +601,10 @@ func (e *engine) runMedia(ctx context.Context, callID string, call *Call, callKe
 			// survive the clonk-display-startup drop window (see the pliGraceTicks comment above).
 			inGraceWindow := haveFirstVideo && sent < firstVideoTick+pliGraceTicks
 			if !gv || inGraceWindow {
-				pliPacket, err := videoRtcp.pli(peerVideoSsrc)
-				if err == nil {
-					_, _ = ch.Send(pliPacket)
-					e.c.diag.Emit("rtcp", map[string]any{
-						"event": "pli_sent", "peer_video_ssrc": peerVideoSsrc, "in_grace": inGraceWindow,
-					})
-				}
-				firSeqNr++
-				firPacket, ferr := videoRtcp.fir(peerVideoSsrc, firSeqNr)
-				if ferr == nil {
-					_, _ = ch.Send(firPacket)
-				}
+				pliOK, firOK := sendKeyframeRequest(inGraceWindow)
 				if sent%4 == 0 || inGraceWindow {
 					log.Info().Uint32("peer_video_ssrc", peerVideoSsrc).Uint8("fir_seq", firSeqNr).
-						Bool("pli_ok", err == nil).Bool("fir_ok", ferr == nil).Bool("post_video_grace", inGraceWindow).
+						Bool("pli_ok", pliOK).Bool("fir_ok", firOK).Bool("post_video_grace", inGraceWindow).
 						Msg("sent PLI+FIR keyframe request")
 				}
 			}
@@ -633,6 +639,11 @@ func (e *engine) runMedia(ctx context.Context, callID string, call *Call, callKe
 				if !doTick(now) {
 					return
 				}
+			case <-keyframeRequests:
+				pliOK, firOK := sendKeyframeRequest(false)
+				log.Info().Uint32("peer_video_ssrc", peerVideoSsrc).Uint8("fir_seq", firSeqNr).
+					Bool("pli_ok", pliOK).Bool("fir_ok", firOK).
+					Msg("sent requested PLI+FIR keyframe request")

 // CallReaction is a transient emoji reaction received over the call's RTC app-data stream.
@@ -199,6 +200,27 @@ func (c *Call) requestVideoKeyframe() {
 	}
 }
 
+// RequestPeerKeyframe asks the peer's encoder for a fresh IDR by sending an RTCP PLI and
+// FIR at the peer's video SSRC. A receiver that starts decoding mid-stream (a renderer
+// attached after the call's first keyframe went past) needs this: WhatsApp encoders send
+// IDRs on request, not on a short fixed cadence. Requests coalesce; one is served per
+// media-loop wakeup, and a request made before the relay allocation is served right after it.
+func (c *Call) RequestPeerKeyframe() {
+	select {
+	case c.peerKeyframeRequests() <- struct{}{}:
+	default: // one is already pending
+	}
+}
+
+func (c *Call) peerKeyframeRequests() chan struct{} {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.peerKeyframeReq == nil {
+		c.peerKeyframeReq = make(chan struct{}, 1)
+	}
+	return c.peerKeyframeReq
+}
+
 // onVideoStateFn returns the Call's video-state callback under its lock.
 func (c *Call) onVideoStateFn() func(VideoState) {
 	c.mu.Lock()

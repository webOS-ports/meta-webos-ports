+		keyframeRequests := call.peerKeyframeRequests()
 		doTick := func(now time.Time) bool {
 			nowMs := uint64(now.UnixMilli())
 			e.mu.Lock()
@@ -897,21 +914,10 @@ func (e *engine) runMedia(ctx context.Context, callID string, call *Call, callKe

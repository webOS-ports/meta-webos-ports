@@ -0,0 +1,36 @@
+package meowcaller
+
+import "testing"
+
+// After a mid-call upgrade the peer's <video state=1 device_orientation=1> comes
+// before its first video packet; the "video is live" state announced on that
+// packet must not turn the picture back to 0.
+func TestFirstFrameCarriesThePacketOrientation(t *testing.T) {
+	var o rtpOrientation
+	if _, changed, announce := o.packet(1); !changed || announce {
+		t.Fatalf("first packet: changed=%v announce=%v, want a change not yet announced", changed, announce)
+	}
+	if st := o.firstFrame(); st != (VideoState{Active: true, Raw: 1, Orientation: 1}) {
+		t.Fatalf("first frame state = %+v, want active with orientation 1", st)
+	}
+}
+
+func TestOrientationChangeIsAnnouncedOnceVideoIsLive(t *testing.T) {
+	var o rtpOrientation
+	o.packet(1)
+	o.firstFrame()
+	if _, changed, _ := o.packet(1); changed {
+		t.Fatal("the same bits again reported as a change")
+	}
+	st, changed, announce := o.packet(2)
+	if !changed || !announce || st != (VideoState{Active: true, Raw: 1, Orientation: 2}) {
+		t.Fatalf("turned phone: %+v changed=%v announce=%v", st, changed, announce)
+	}
+}
+
+func TestFirstFrameWithoutOrientationBitsIsUpright(t *testing.T) {
+	var o rtpOrientation
+	if st := o.firstFrame(); st.Orientation != 0 || !st.Active {
+		t.Fatalf("state = %+v", st)
+	}
+}

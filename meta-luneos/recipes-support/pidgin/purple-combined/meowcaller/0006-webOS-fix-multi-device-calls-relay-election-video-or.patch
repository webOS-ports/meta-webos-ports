+// parseRelayLatencyProbes reads the <te> children of the <relaylatency> under data, nil
+// when there is no <relaylatency>.
+func parseRelayLatencyProbes(data *waBinary.Node) []rlProbe {
+	rl := findChild(data, "relaylatency")
+	if rl == nil {
+		return nil
+	}
+	probes := []rlProbe{}
+	kids := rl.GetChildren()
+	for i := range kids {
+		te := &kids[i]
+		if te.Tag != "te" {
+			continue
+		}
+		ag := te.AttrGetter()
+		probes = append(probes, rlProbe{
+			latency:   decodeLatency(ag.String("latency")),
+			relayName: ag.String("relay_name"),
+			addr:      nodeBytes(te),
 		})
 	}
+	return probes
+}

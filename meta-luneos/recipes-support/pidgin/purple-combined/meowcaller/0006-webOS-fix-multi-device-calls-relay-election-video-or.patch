+// A callee with WhatsApp on two devices: the outgoing offer rang both.
+func testEngineRingingTwoDevices() (*engine, *Call, types.JID, types.JID, *[]waBinary.Node) {
+	eng, call := testEngineWithOutgoingCall()
+	primary := peerJID()
+	companion := peerJID()
+	companion.Device = 61
+	eng.calls[call.ID()].ringDevices = []types.JID{primary, companion}
+	sent := &[]waBinary.Node{}
+	eng.sendCallNode = func(_ context.Context, node waBinary.Node) error {

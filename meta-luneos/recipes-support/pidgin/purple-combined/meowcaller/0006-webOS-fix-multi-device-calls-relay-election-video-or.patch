+// acceptWithoutMute sends the deferred <accept> when the caller's <mute_v2> has not
+// come by acceptFallback after the answer. sendAccept sends it once either way.
+func (e *engine) acceptWithoutMute(callID string) {
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil || !m.acceptPending {
+		e.mu.Unlock()
+		return
+	}
+	to, creator := m.from, m.creator
+	e.mu.Unlock()
+	e.c.log.Info().Str("call_id", callID).Msg("no mute_v2 from the caller; accepting without it")
+	e.sendAccept(callID, to, creator)

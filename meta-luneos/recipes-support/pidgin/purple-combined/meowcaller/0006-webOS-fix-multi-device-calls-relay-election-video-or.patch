+// Latencies reported to steer the 1:1 relay election (see onRelayLatency): the relay our
+// media runs on is near, every other relay far.
+const (
+	steeredLatency uint32 = 20
+	avoidedLatency uint32 = 1500
+)
+
+// relayLatencyReplies decides the latency to report for each probe, settling the call's
+// electedRelay on the way. ok is false when nothing should be sent: an outbound call
+// whose media has not chosen a relay yet.
+//
+// Inbound, the target is the offer's is_fna relay, else the relay of our relay block (one
+// we hold a token for) that the caller measured closest in the first stanza naming one.
+// Android sends one <te> per <relaylatency> stanza, so in practice that is the first such
+// relay in arrival order. Until a target is known a
+// relay outside our relay block is reported far, never echoed: echoing is what endorsed
+// the caller's local relay. A relay of our block probed before the target is settled
+// cannot happen, since such a probe settles it.
+func (e *engine) relayLatencyReplies(callID string, probes []rlProbe) (target string, reported []uint32, ok bool) {
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil {
+		e.mu.Unlock()
+		return "", nil, false
+	}
+	outbound := m.direction != CallDirectionIncoming
+	if !outbound && m.electedRelay == "" && m.relay != nil {
+		m.electedRelay = steerInboundRelay(m.relay, probes)
+	}
+	target = m.electedRelay
+	e.mu.Unlock()
+	if outbound && target == "" {
+		return "", nil, false
+	}
+	reported = make([]uint32, len(probes))
+	for i, p := range probes {
+		if p.relayName == target {
+			reported[i] = steeredLatency
+		} else {
+			reported[i] = avoidedLatency
+		}
+	}
+	return target, reported, true
+}
+
+// steerInboundRelay picks the relay an inbound call should run on from the offer's relay
+// block and the caller's probes: the is_fna relay, else, among the probed relays that are
+// in our relay block and have a token, the one with the lowest measured latency (the
+// first of them if none carries a latency). Empty when the probes name none of our relays.
+func steerInboundRelay(rd *relayData, probes []rlProbe) string {
+	offered := map[string]bool{}
+	for _, ep := range rd.endpoints {
+		if ep.isFNA {
+			return ep.relayName
+		}
+		if int(ep.tokenID) < len(rd.relayTokens) && len(rd.relayTokens[ep.tokenID]) > 0 {
+			offered[ep.relayName] = true
+		}
+	}
+	best, bestLatency := "", uint32(0)
+	for _, p := range probes {
+		if !offered[p.relayName] {
+			continue
+		}
+		switch {
+		case best == "":
+			best, bestLatency = p.relayName, p.latency
+		case p.latency != 0 && (bestLatency == 0 || p.latency < bestLatency):
+			best, bestLatency = p.relayName, p.latency
+		}
+	}
+	return best
 }
 

+	}
+	if len(compound) != 108 {
+		t.Fatalf("compound length = %d, want 108", len(compound))
+	}
+}
diff --git a/rtp_orientation_test.go b/rtp_orientation_test.go
new file mode 100644
index 0000000..36b04bc

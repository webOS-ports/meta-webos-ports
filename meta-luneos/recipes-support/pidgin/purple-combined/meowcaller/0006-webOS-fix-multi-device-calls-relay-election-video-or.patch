+// nodeLog records the call nodes the engine sends, from any goroutine.
+type nodeLog struct {
+	mu    sync.Mutex
+	nodes []waBinary.Node
+}
+
+func (l *nodeLog) send(_ context.Context, node waBinary.Node) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.nodes = append(l.nodes, node)
+	return nil
+}
+
+// tagged returns the sent nodes whose action is tag.
+func (l *nodeLog) tagged(tag string) []waBinary.Node {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	var out []waBinary.Node
+	for _, n := range l.nodes {
+		if kids := n.GetChildren(); len(kids) == 1 && kids[0].Tag == tag {
+			out = append(out, n)
+		}
+	}
+	return out
+}
+
+// waitFor polls until cond holds or a second has gone by.
+func waitFor(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out waiting for %s", what)
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+}
+
+func sentTo(nodes []waBinary.Node, to types.JID) int {
+	n := 0
+	for _, node := range nodes {
+		if node.AttrGetter().JID("to") == to {
+			n++
+		}
+	}
+	return n
+}
+
+func preaccept(eng *engine, from types.JID) {
+	eng.onPreAccept(&events.CallPreAccept{
+		BasicCallMeta: types.BasicCallMeta{CallID: "CID", From: from},
+		Data:          &waBinary.Node{Tag: "preaccept"},
+	})
+}

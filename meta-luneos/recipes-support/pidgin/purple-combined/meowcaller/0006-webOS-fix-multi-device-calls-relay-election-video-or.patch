+// sameDevice reports whether two JIDs name the same device of the same account.
+func sameDevice(a, b types.JID) bool {
+	return a.User == b.User && a.Server == b.Server && a.Device == b.Device
+}
+
+// dropRingDevice removes a device that cannot take an outgoing call from its rung
+// set, and reports whether another rung device is still ringing.
+func (e *engine) dropRingDevice(callID string, device types.JID) bool {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	m := e.calls[callID]
+	if m == nil || m.direction != CallDirectionOutgoing {
+		return false
+	}
+	kept := m.ringDevices[:0]
+	for _, d := range m.ringDevices {
+		if !sameDevice(d, device) {
+			kept = append(kept, d)
+		}
+	}
+	m.ringDevices = kept
+	return len(kept) > 0
+}
+
+// dismissOtherDevices tells every device an outgoing call rang, except the one
+// that answered or declined it, that the call was taken care of elsewhere: one
+// <call to=DEVICE id=…><terminate reason=…/></call> per device, without a
+// <destination> block (whatsapp-rust accept_dismisses_other_callee_device). It
+// runs once per call. Without it a callee with WhatsApp on two devices kept
+// ringing on the one that was not used (sargo, 2026-11-03). Nothing is sent when
+// the answering device is not one the offer rang, so a terminate can never reach
+// the device that took the call.
+func (e *engine) dismissOtherDevices(callID string, answerer types.JID, reason string) {
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil || m.direction != CallDirectionOutgoing || len(m.ringDevices) == 0 {
+		e.mu.Unlock()
+		return
+	}
+	known := false
+	targets := make([]types.JID, 0, len(m.ringDevices))
+	for _, d := range m.ringDevices {
+		if sameDevice(d, answerer) {
+			known = true
+			continue
+		}
+		targets = append(targets, d)
+	}
+	creator := m.creator
+	if known {
+		m.ringDevices = nil
+	}
+	e.mu.Unlock()
+	if !known {
+		e.c.log.Warn().Str("call_id", callID).Str("from", answerer.String()).
+			Msg("answering device is not one the offer rang; not dismissing the others")
+		return
+	}
+	for _, device := range targets {
+		node := signaling.BuildDeviceTerminate(callID, device, e.nextCallNodeID(), creator, reason)
+		if err := e.transmitCallNode(context.Background(), node); err != nil {
+			e.c.log.Warn().Err(err).Str("call_id", callID).Str("device", device.String()).
+				Str("reason", reason).Msg("could not dismiss a callee device")
+			continue
+		}
+		e.c.log.Info().Str("call_id", callID).Str("device", device.String()).
+			Str("reason", reason).Msg("dismissed a callee device that did not take the call")
+	}
+}

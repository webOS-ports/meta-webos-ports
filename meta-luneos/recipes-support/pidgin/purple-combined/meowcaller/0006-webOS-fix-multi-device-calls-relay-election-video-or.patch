+// BuildDeviceTerminate builds the caller's per-device dismiss:
+// <call to=DEVICE id=ID><terminate call-id call-creator reason/></call>.
+// WhatsApp routes call signaling per device, so each device gets its own
+// stanza, with no <destination> block, and the wrapper needs an id.
+// Source: whatsapp-rust wacore/src/stanza/call.rs build_terminate and
+// src/handlers/call.rs accept_dismisses_other_callee_device.
+func BuildDeviceTerminate(callID string, device types.JID, id string, callCreator types.JID, reason string) waBinary.Node {
+	action := waBinary.Node{Tag: "terminate", Attrs: waBinary.Attrs{
+		"call-id": callID, "call-creator": callCreator, "reason": reason,
+	}}
+	return callWrap(device, &id, action)
+}

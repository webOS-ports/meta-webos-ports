+// notePreaccept remembers a callee device that preaccepted an outgoing call and starts
+// telling the preaccepted devices our microphone state while the call rings.
+func (e *engine) notePreaccept(callID string, device types.JID) {
+	if device.IsEmpty() {
+		return
+	}
+	e.mu.Lock()
+	m := e.calls[callID]
+	if m == nil || m.direction != CallDirectionOutgoing || m.answered {
+		e.mu.Unlock()
+		return
+	}
+	known := false
+	for _, d := range m.preaccepted {
+		if sameDevice(d, device) {
+			known = true
+			break
+		}
+	}
+	if !known {
+		m.preaccepted = append(m.preaccepted, device)
+	}
+	start := !m.announcing
+	m.announcing = true
+	interval := e.ringAnnounceInterval
+	e.mu.Unlock()
+	if start {
+		go e.announceWhileRinging(callID, interval)
+	}
+}
+
+// announceWhileRinging sends <mute_v2 mute-state="0"> to every device that preaccepted
+// an outgoing call, every interval, until the call is answered or gone. An Android
+// caller does the same; a meowcaller callee sends its <accept> only on the first
+// <mute_v2> after its user answered, so without this a call from here to a LuneOS
+// device never got accepted.
+func (e *engine) announceWhileRinging(callID string, interval time.Duration) {
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for i := 0; i < ringAnnounceLimit; i++ {
+		<-ticker.C
+		e.mu.Lock()
+		m := e.calls[callID]
+		if m == nil || m.answered {
+			e.mu.Unlock()
+			return
+		}
+		devices := append([]types.JID(nil), m.preaccepted...)
+		creator := m.creator
+		e.mu.Unlock()
+		for _, device := range devices {
+			node := signaling.BuildMuteV2(callID, device, creator, "0")
+			node.Attrs["id"] = e.nextCallNodeID()
+			if err := e.transmitCallNode(context.Background(), node); err != nil {
+				e.c.log.Warn().Err(err).Str("call_id", callID).Str("device", device.String()).
+					Msg("could not send mute_v2 to a ringing device")
+			}
+		}
+	}
+}
+
 // onAccept records that the peer answered an outgoing call. Media may already be running

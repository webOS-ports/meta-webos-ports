+// Ported from whatsapp-rust's
+// reception_stats_report_the_bytes_received_and_the_rate_since_the_last_report
+// and native_video_sender_report_matches_profile_structure.
+func TestRtcpReceptionStatsReportBytesAndRate(t *testing.T) {
+	var reception RtcpReceptionStats
+	reception.CountPayload(0x1111, 500) // before the stream is known: not counted
+	reception.Observe(0x1111, 1, 0, 1000, 90000)
+	reception.CountPayload(0x1111, 800)
+	first := reception.Report(1000)
+	if first.BytesReceived != 800 || first.ReceiveRateBps != 0 {
+		t.Fatalf("first report bytes/rate = (%d, %d), want (800, 0): no interval yet", first.BytesReceived, first.ReceiveRateBps)
+	}
+	for seq := uint16(2); seq <= 101; seq++ {
+		reception.Observe(0x1111, seq, 0, 1000, 90000)
+		reception.CountPayload(0x1111, 1000)
+	}
+	reception.CountPayload(0x2222, 50000) // another stream's packets are not this one's
+	second := reception.Report(2000)
+	if second.BytesReceived != 100800 || second.ReceiveRateBps != 800000 {
+		t.Fatalf("second report bytes/rate = (%d, %d), want (100800, 800000)", second.BytesReceived, second.ReceiveRateBps)
+	}
+	// A new stream starts its counts afresh.
+	reception.Observe(0x3333, 7, 0, 2500, 90000)
+	reception.CountPayload(0x3333, 10)
+	third := reception.Report(3000)
+	if third.Ssrc != 0x3333 || third.BytesReceived != 10 || third.ReceiveRateBps != 0 {
+		t.Fatalf("new stream report = (%#x, %d, %d), want (0x3333, 10, 0)", third.Ssrc, third.BytesReceived, third.ReceiveRateBps)
+	}
+}

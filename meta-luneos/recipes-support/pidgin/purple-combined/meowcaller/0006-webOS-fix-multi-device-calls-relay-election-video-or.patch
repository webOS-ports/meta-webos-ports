+func checkDismiss(t *testing.T, sent []waBinary.Node, to types.JID, reason string) {
+	t.Helper()
+	if len(sent) != 1 {
+		t.Fatalf("sent %d stanzas, want one dismiss: %#v", len(sent), sent)
+	}
+	ag := sent[0].AttrGetter()
+	if got := ag.JID("to"); got != to {
+		t.Fatalf("dismiss addressed to %s, want the other device %s", got, to)
+	}
+	if ag.OptionalString("id") == "" {
+		t.Fatal("dismiss wrapper has no id")
+	}
+	kids := sent[0].GetChildren()
+	if len(kids) != 1 || kids[0].Tag != "terminate" {
+		t.Fatalf("dismiss content = %#v, want one <terminate>", kids)
+	}
+	tg := kids[0].AttrGetter()
+	if tg.OptionalString("reason") != reason || tg.String("call-id") != "CID" {
+		t.Fatalf("terminate attrs = %v, want call-id CID reason %s", kids[0].Attrs, reason)
+	}
+	if len(kids[0].GetChildren()) != 0 {
+		t.Fatal("dismiss must not carry a <destination> block")
+	}
+}

+// The loss fraction is per interval, in 256ths (RFC 3550 6.4.1): one of four
+// packets lost is 64, and the next interval with no loss reports 0 again.
+func TestRtcpReceptionStatsIntervalLossFraction(t *testing.T) {
+	var reception RtcpReceptionStats
+	for _, seq := range []uint16{10, 11, 13} {
+		reception.Observe(0x0badcafe, seq, uint32(seq)*3000, uint64(seq)*33, 90000)
+	}
+	reception.Observe(0x0badcafe, 13, 13*3000, 13*33, 90000) // a duplicate
+	first := reception.Report(1000)
+	if first == nil {
+		t.Fatal("missing reception report")
+	}
+	// Expected 10..13 = 4, received 4 counting the duplicate: no loss shows.
+	if first.FractionLost != 0 || first.CumulativeLost != 0 {
+		t.Fatalf("with a duplicate: fraction/cumulative = (%d, %d), want (0, 0)", first.FractionLost, first.CumulativeLost)
+	}
+	reception.Observe(0x0badcafe, 14, 14*3000, 14*33, 90000)
+	reception.Observe(0x0badcafe, 17, 17*3000, 17*33, 90000)
+	second := reception.Report(2000)
+	// Expected 14..17 = 4, received 2: half lost.
+	if second.FractionLost != 128 || second.CumulativeLost != 2 {
+		t.Fatalf("interval loss: fraction/cumulative = (%d, %d), want (128, 2)", second.FractionLost, second.CumulativeLost)
+	}
+	reception.Observe(0x0badcafe, 18, 18*3000, 18*33, 90000)
+	reception.Observe(0x0badcafe, 19, 19*3000, 19*33, 90000)
+	reception.Observe(0x0badcafe, 21, 21*3000, 21*33, 90000)
+	reception.Observe(0x0badcafe, 22, 22*3000, 22*33, 90000)
+	reception.Observe(0x0badcafe, 23, 23*3000, 23*33, 90000)
+	reception.Observe(0x0badcafe, 24, 24*3000, 24*33, 90000)
+	reception.Observe(0x0badcafe, 25, 25*3000, 25*33, 90000)
+	third := reception.Report(3000)
+	// Expected 18..25 = 8, received 7: one in eight is 32.
+	if third.FractionLost != 32 || third.CumulativeLost != 3 {
+		t.Fatalf("one in eight: fraction/cumulative = (%d, %d), want (32, 3)", third.FractionLost, third.CumulativeLost)
+	}
+}

 // testRtcpCname is the one CNAME a call's audio and video RTCP senders share.
 var testRtcpCname = rtp.BuildWhatsappRtcpCname([12]byte{})
+
+func TestVideoSenderCarriesDeviceOrientationInFrameInfo(t *testing.T) {
+	pipe, err := NewMediaPipeline(iota32(), "111111111111111:0@lid", "222222222222222:0@lid", 0x55667788, FrameSamples)
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	sender := &videoSender{pipe: pipe, stream: rtp.NewVideoRtpStream(0x55667788, 4500), active: true}
+	idr := []byte{0, 0, 0, 1, 0x65, 1, 2, 3}
+	delta := []byte{0, 0, 0, 1, 0x41, 1, 2, 3}
+	frameInfo := func(au []byte) uint8 {
+		t.Helper()
+		packets := sender.protectAccessUnit(au, 50*time.Millisecond)
+		if len(packets) == 0 {
+			t.Fatal("no packets")
+		}
+		header, ok := rtp.ParseRtpHeader(packets[0])
+		if !ok || header.VideoExtension == nil {
+			t.Fatal("no video extension")
+		}
+		return header.VideoExtension.MediaFrameInfo
+	}
+	if got := frameInfo(idr); got != rtp.VideoMediaFrameInfoIDR {
+		t.Fatalf("upright IDR frame info = %#x", got)
+	}
+	sender.setOrientation(1)
+	if got := frameInfo(idr); got != rtp.VideoMediaFrameInfoIDR|1 {
+		t.Fatalf("IDR frame info = %#x, want %#x", got, rtp.VideoMediaFrameInfoIDR|1)
+	}
+	if got := frameInfo(delta); got != rtp.VideoMediaFrameInfoDelta|1 {
+		t.Fatalf("delta frame info = %#x, want %#x", got, rtp.VideoMediaFrameInfoDelta|1)
+	}
+	sender.setOrientation(7)
+	if got := frameInfo(delta); got != rtp.VideoMediaFrameInfoDelta|3 {
+		t.Fatalf("out-of-range orientation leaked into frame info: %#x", got)
+	}
+}
diff --git a/relay_election_test.go b/relay_election_test.go
new file mode 100644
index 0000000..3430d4d
--- /dev/null
+++ b/relay_election_test.go
@@ -0,0 +1,342 @@
+package meowcaller
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"testing"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+	"go.mau.fi/whatsmeow/types/events"
+)
+
+func mustHex(t *testing.T, s string) []byte {
+	t.Helper()
+	b, err := hex.DecodeString(s)
+	if err != nil {
+		t.Fatalf("bad hex %q: %v", s, err)
+	}
+	return b
+}
+
+// capturedRelay rebuilds the <relay> block of an offer received on mindphone on
+// 30 October 2026 (imlibpurpleservice TRC log). Attributes and addresses are copied from
+// the log; the log prints only the length of the two relay tokens, so they are stand-ins
+// of that length. IPv6 <te2> entries are kept: parseRelayData has to skip them.
+func capturedRelay(t *testing.T, first, firstV4, firstV6 string) *waBinary.Node {
+	t.Helper()
+	te := func(relayID, tokenID, rtt, name, addr string) waBinary.Node {
+		return waBinary.Node{Tag: "te2", Attrs: waBinary.Attrs{
+			"auth_token_id": "0", "c2r_rtt": rtt, "relay_id": relayID, "relay_name": name, "token_id": tokenID,
+		}, Content: mustHex(t, addr)}
+	}
+	return &waBinary.Node{
+		Tag:   "relay",
+		Attrs: waBinary.Attrs{"attribute_padding": "1", "peer_pid": "1", "self_pid": "3"},
+		Content: []waBinary.Node{
+			{Tag: "participant", Attrs: waBinary.Attrs{"jid": "100000000000001@lid", "pid": "1"}},
+			{Tag: "token", Attrs: waBinary.Attrs{"id": "0"}, Content: bytes.Repeat([]byte{0xa0}, 192)},
+			{Tag: "token", Attrs: waBinary.Attrs{"id": "1"}, Content: bytes.Repeat([]byte{0xa1}, 192)},
+			{Tag: "key", Content: []byte("X9YKry03PTPMA66iSsj68w==")},
+			te("0", "0", "10", first, firstV4),
+			te("0", "0", "10", first, firstV6),
+			te("1", "1", "13", "dus1c01", "9df01b810d96"),
+			te("1", "1", "13", "dus1c01", "2a032880f23f00dbfaceb00c000067490d96"),
+		},
+	}
+}
+
+// relayLatencyStanza is one <call><relaylatency> as the caller sends it: one <te> each.
+func relayLatencyStanza(t *testing.T, latency, name, addr string) *waBinary.Node {
+	t.Helper()
+	return &waBinary.Node{Tag: "call", Content: []waBinary.Node{{
+		Tag: "relaylatency",
+		Attrs: waBinary.Attrs{
+			"call-creator": "100000000000001@lid", "call-id": "CID",
+		},
+		Content: []waBinary.Node{{
+			Tag:     "te",
+			Attrs:   waBinary.Attrs{"latency": latency, "relay_name": name},
+			Content: mustHex(t, addr),
+		}},
+	}}}
+}
+
+func testEngineWithIncomingCall(rd *relayData) (*engine, *engineCall) {
+	c := &Client{}
+	c.eng = newEngine(c)
+	m := &engineCall{direction: CallDirectionIncoming, relay: rd}
+	c.eng.calls["CID"] = m
+	return c.eng, m
+}
+
+type probeStep struct {
+	latency, name, addr string
+	wantReported        uint32
+	wantElected         string
+}
+
+func runProbeSteps(t *testing.T, eng *engine, steps []probeStep) {
+	t.Helper()
+	for i, s := range steps {
+		probes := parseRelayLatencyProbes(relayLatencyStanza(t, s.latency, s.name, s.addr))
+		if len(probes) != 1 || probes[0].relayName != s.name {
+			t.Fatalf("step %d: parsed %+v", i, probes)
+		}
+		target, reported, ok := eng.relayLatencyReplies("CID", probes)
+		if !ok {
+			t.Fatalf("step %d (%s): probe left unanswered", i, s.name)
+		}
+		if reported[0] != s.wantReported {
+			t.Errorf("step %d (%s, peer %d ms): reported %d ms, want %d", i, s.name, probes[0].latency, reported[0], s.wantReported)
+		}
+		if target != s.wantElected {
+			t.Errorf("step %d (%s): target %q, want %q", i, s.name, target, s.wantElected)
+		}
+	}
+}
+
+// TestRelayElectionIncomingCall1 replays call 00D7D841... (19:16:54): the caller probed its
+// own fgrq1c02 (not in our relay block) at the same 33 ms as ams4c01. The old code echoed
+// 33 ms for both. Now fgrq1c02 is reported far, ams4c01 near, and media allocates there.
+func TestRelayElectionIncomingCall1(t *testing.T) {
+	rd := parseRelayData(capturedRelay(t, "ams4c01", "399105390d96", "2a032880f3820139faceb00c000067490d96"))
+	eng, m := testEngineWithIncomingCall(rd)
+	runProbeSteps(t, eng, []probeStep{
+		// Arrival order as logged; latencies 0x2000021 = 33 ms etc.
+		{"33554465", "fgrq1c02", "258f51e10d96", avoidedLatency, ""},
+		{"33554465", "ams4c01", "399105360d96", steeredLatency, "ams4c01"},
+		{"33554475", "dus1c01", "9df01b340d96", avoidedLatency, "ams4c01"},
+		// Second round, after the accept.
+		{"33554440", "fgrq1c02", "258f51e10d96", avoidedLatency, "ams4c01"},
+		{"33554439", "ams4c01", "399105360d96", steeredLatency, "ams4c01"},
+		{"33554442", "dus1c01", "9df01b340d96", avoidedLatency, "ams4c01"},
+	})
+	eng.mu.Lock()
+	mrd := settleMediaRelay(m)
+	eng.mu.Unlock()
+	ep := getMediaRelayEndpoint(mrd, true)
+	if ep == nil || ep.relayName != "ams4c01" || ep.addresses[0].ipv4 != "57.145.5.57" || ep.addresses[0].port != 3478 {
+		t.Fatalf("media endpoint = %+v, want ams4c01 57.145.5.57:3478", ep)
+	}
+}
+
+// TestRelayElectionIncomingCall2 replays call 00E7EF5C... (19:18:28). The caller measured
+// dus1c01 at 11 ms and ams2c01 at 18 ms; the old code allocated on ams2c01, the first
+// relay of the block, whatever the caller measured. Now both sides go to dus1c01.
+func TestRelayElectionIncomingCall2(t *testing.T) {
+	rd := parseRelayData(capturedRelay(t, "ams2c01", "3990df390d96", "2a032880f36f0139faceb00c000067490d96"))
+	if old := getMediaRelayEndpoint(rd, true); old == nil || old.relayName != "ams2c01" {
+		t.Fatalf("without an elected relay the pick is %+v, want ams2c01 (lowest c2r_rtt)", old)
+	}
+	eng, m := testEngineWithIncomingCall(rd)
+	runProbeSteps(t, eng, []probeStep{
+		{"33554443", "dus1c01", "9df01b340d96", steeredLatency, "dus1c01"},
+		{"33554450", "ams2c01", "3990df360d96", avoidedLatency, "dus1c01"},
+		{"33554450", "fgrq1c02", "258f51e10d96", avoidedLatency, "dus1c01"},
+	})
+	eng.mu.Lock()
+	mrd := settleMediaRelay(m)
+	eng.mu.Unlock()
+	ep := getMediaRelayEndpoint(mrd, true)
+	if ep == nil || ep.relayName != "dus1c01" || ep.addresses[0].ipv4 != "157.240.27.129" {
+		t.Fatalf("media endpoint = %+v, want dus1c01 157.240.27.129:3478", ep)
+	}
+	if m.electedRelay != "dus1c01" {
+		t.Fatalf("electedRelay = %q, want dus1c01", m.electedRelay)
+	}
+}
+
+// TestRelayElectionAnswerBeforeProbes: media that starts before any probe settles the
+// relay from the offer, and later probes are steered to that relay.
+func TestRelayElectionAnswerBeforeProbes(t *testing.T) {
+	rd := parseRelayData(capturedRelay(t, "ams2c01", "3990df390d96", "2a032880f36f0139faceb00c000067490d96"))
+	eng, m := testEngineWithIncomingCall(rd)
+	eng.mu.Lock()
+	mrd := settleMediaRelay(m)
+	eng.mu.Unlock()
+	if mrd.electedRelay != "ams2c01" || m.electedRelay != "ams2c01" {
+		t.Fatalf("settled %q/%q, want ams2c01", mrd.electedRelay, m.electedRelay)
+	}
+	if rd.electedRelay != "" {
+		t.Fatalf("settleMediaRelay changed the call's relay data in place")
+	}
+	runProbeSteps(t, eng, []probeStep{
+		{"33554443", "dus1c01", "9df01b340d96", avoidedLatency, "ams2c01"},
+		{"33554450", "ams2c01", "3990df360d96", steeredLatency, "ams2c01"},
+	})
+}
+
+// TestRelayElectionOutbound: outbound probes are not answered before media has picked a
+// relay, and are steered to that relay afterwards.
+func TestRelayElectionOutbound(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	m := eng.calls[call.ID()]
+	m.relay = &relayData{
+		relayTokens: [][]byte{{1}, {2}},
+		endpoints: []relayEndpoint{
+			{relayName: "ams2c01", tokenID: 0, authTokenID: 1, addresses: []relayAddress{{ipv4: "1.1.1.1", port: 3478}}},
+			{relayName: "dus1c01", tokenID: 1, authTokenID: 0, addresses: []relayAddress{{ipv4: "2.2.2.2", port: 3478}}},
+		},
+	}
+	probes := []rlProbe{{relayName: "dus1c01", latency: 5}, {relayName: "ams2c01", latency: 9}}
+	if _, _, ok := eng.relayLatencyReplies(call.ID(), probes); ok {
+		t.Fatalf("outbound probes answered before media picked a relay")
+	}
+	eng.mu.Lock()
+	settleMediaRelay(m)
+	eng.mu.Unlock()
+	target, reported, ok := eng.relayLatencyReplies(call.ID(), probes)
+	if !ok || target != "ams2c01" || reported[0] != avoidedLatency || reported[1] != steeredLatency {
+		t.Fatalf("outbound replies = %q %v %v, want ams2c01 [%d %d]", target, reported, ok, avoidedLatency, steeredLatency)
+	}
+}
+
+func TestRelayElectionUnknownCall(t *testing.T) {
+	eng, _ := testEngineWithIncomingCall(&relayData{})
+	if _, _, ok := eng.relayLatencyReplies("OTHER", []rlProbe{{relayName: "x"}}); ok {
+		t.Fatalf("answered probes for an unknown call")
+	}
+}
+
+func TestSteerInboundRelay(t *testing.T) {
+	rd := &relayData{
+		relayTokens: [][]byte{{1}, {2}},
+		endpoints: []relayEndpoint{
+			{relayName: "waw2c02", tokenID: 1},
+			{relayName: "hel3c01", tokenID: 0},
+		},
+	}
+	probes := []rlProbe{{relayName: "fala3c03", latency: 5}, {relayName: "hel3c01", latency: 83}, {relayName: "waw2c02", latency: 75}}
+	if got := steerInboundRelay(rd, probes); got != "waw2c02" {
+		t.Fatalf("steer = %q, want waw2c02 (closest relay of our block)", got)
+	}
+	rd.relayTokens[1] = nil
+	if got := steerInboundRelay(rd, probes); got != "hel3c01" {
+		t.Fatalf("steer without a waw2c02 token = %q, want hel3c01", got)
+	}
+	rd.relayTokens[1] = []byte{2}
+	if got := steerInboundRelay(rd, []rlProbe{{relayName: "hel3c01"}, {relayName: "waw2c02"}}); got != "hel3c01" {
+		t.Fatalf("steer without latencies = %q, want the first, hel3c01", got)
+	}
+	if got := steerInboundRelay(rd, []rlProbe{{relayName: "fala3c03", latency: 5}}); got != "" {
+		t.Fatalf("steer = %q, want none for probes naming no relay of ours", got)
+	}
+	rd.endpoints = append(rd.endpoints, relayEndpoint{relayName: "fna1", isFNA: true})
+	if got := steerInboundRelay(rd, probes); got != "fna1" {
+		t.Fatalf("steer with an is_fna relay = %q, want fna1", got)
+	}
+	if got := steerInboundRelay(rd, nil); got != "fna1" {
+		t.Fatalf("steer without probes = %q, want fna1", got)
+	}
+}
+
+// TestInboundMediaRelaySelection covers getMediaRelayEndpoint's inbound order:
+// is_fna, then the elected relay, then the foreign relay with the lowest c2r_rtt.
+func TestInboundMediaRelaySelection(t *testing.T) {
+	rd := &relayData{endpoints: []relayEndpoint{
+		{relayName: "own", authTokenID: 1, c2rRTT: 5, addresses: []relayAddress{{ipv4: "1.1.1.1", port: 3478}}},
+		{relayName: "far", authTokenID: 0, c2rRTT: 150, addresses: []relayAddress{{ipv4: "2.2.2.2", port: 3478}}},
+		{relayName: "near", authTokenID: 0, c2rRTT: 40, addresses: []relayAddress{{ipv4: "3.3.3.3", port: 3478}}},
+	}}
+	if got := getMediaRelayEndpoint(rd, true).relayName; got != "near" {
+		t.Fatalf("inbound without is_fna or election: got %s, want near", got)
+	}
+	rd.electedRelay = "far"
+	if got := getMediaRelayEndpoint(rd, true).relayName; got != "far" {
+		t.Fatalf("inbound with far elected: got %s, want far", got)
+	}
+	rd.electedRelay = "gone"
+	if got := getMediaRelayEndpoint(rd, true).relayName; got != "near" {
+		t.Fatalf("inbound with an elected relay not in the block: got %s, want near", got)
+	}
+	rd.endpoints[1].isFNA = true
+	if got := getMediaRelayEndpoint(rd, true).relayName; got != "far" {
+		t.Fatalf("inbound with is_fna: got %s, want far", got)
+	}
+	if got := getMediaRelayEndpoint(rd, false).relayName; got != "own" {
+		t.Fatalf("outbound: got %s, want own", got)
+	}
+}
+
+func TestParseRelayDataC2rRTT(t *testing.T) {
+	rd := parseRelayData(capturedRelay(t, "ams4c01", "399105390d96", "2a032880f3820139faceb00c000067490d96"))
+	if len(rd.endpoints) != 2 {
+		t.Fatalf("parsed %d IPv4 endpoints, want 2", len(rd.endpoints))
+	}
+	if rd.endpoints[0].c2rRTT != 10 || rd.endpoints[1].c2rRTT != 13 {
+		t.Fatalf("c2r_rtt = %d/%d, want 10/13", rd.endpoints[0].c2rRTT, rd.endpoints[1].c2rRTT)
+	}
+}
+
+func TestParseRelayLatencyProbes(t *testing.T) {
+	if p := parseRelayLatencyProbes(&waBinary.Node{Tag: "call"}); p != nil {
+		t.Fatalf("probes from a stanza without <relaylatency>: %+v", p)
+	}
+	p := parseRelayLatencyProbes(relayLatencyStanza(t, "33554465", "fgrq1c02", "258f51e10d96"))
+	if len(p) != 1 || p[0].latency != 33 || p[0].relayName != "fgrq1c02" || hex.EncodeToString(p[0].addr) != "258f51e10d96" {
+		t.Fatalf("parsed %+v", p)
+	}
+}
+
+func TestDecodeLatencyTags(t *testing.T) {
+	cases := map[string]uint32{
+		"33554465":  33,  // Android, call 00D7D841
+		"33554439":  7,   // Android, call 00D7D841, second round
+		"100663423": 127, // 0x0600007F, the iPhone tag
+		"12":        0,
+		"x":         0,
+		"":          0,
+	}
+	for in, want := range cases {
+		if got := decodeLatency(in); got != want {
+			t.Errorf("decodeLatency(%q) = %d, want %d", in, got, want)
+		}
+	}
+}
+
+// TestOnRelayLatencySendsSteeredLatency drives onRelayLatency end to end with the first
+// probes of call 00D7D841 and checks the <te latency> that goes out.
+func TestOnRelayLatencySendsSteeredLatency(t *testing.T) {
+	rd := parseRelayData(capturedRelay(t, "ams4c01", "399105390d96", "2a032880f3820139faceb00c000067490d96"))
+	eng, _ := testEngineWithIncomingCall(rd)
+	var sent []waBinary.Node
+	eng.sendCallNode = func(_ context.Context, node waBinary.Node) error {
+		sent = append(sent, node)
+		return nil
+	}
+	for _, p := range []struct{ latency, name, addr string }{
+		{"33554465", "fgrq1c02", "258f51e10d96"},
+		{"33554465", "ams4c01", "399105360d96"},
+	} {
+		eng.onRelayLatency(&events.CallRelayLatency{
+			BasicCallMeta: types.BasicCallMeta{CallID: "CID", From: peerJID(), CallCreator: creatorJID()},
+			Data:          relayLatencyStanza(t, p.latency, p.name, p.addr),
+		})
+	}
+	if len(sent) != 2 {
+		t.Fatalf("sent %d stanzas, want 2", len(sent))
+	}
+	want := []struct {
+		name    string
+		latency uint32
+		addr    string
+	}{{"fgrq1c02", avoidedLatency, "258f51e10d96"}, {"ams4c01", steeredLatency, "399105360d96"}}
+	for i, node := range sent {
+		te := findChild(&node, "te")
+		if te == nil {
+			t.Fatalf("stanza %d has no <te>: %s", i, node.String())
+		}
+		ag := te.AttrGetter()
+		if got := ag.String("relay_name"); got != want[i].name {
+			t.Errorf("stanza %d relay_name = %s, want %s", i, got, want[i].name)
+		}
+		if got := decodeLatency(ag.String("latency")); got != want[i].latency {
+			t.Errorf("stanza %d (%s) latency = %d ms, want %d", i, want[i].name, got, want[i].latency)
+		}
+		if got := hex.EncodeToString(nodeBytes(te)); got != want[i].addr {
+			t.Errorf("stanza %d address = %s, want %s (the caller's own, echoed)", i, got, want[i].addr)
+		}
+	}
+}
diff --git a/rtp/h264_reorder.go b/rtp/h264_reorder.go
new file mode 100644
index 0000000..7ffdeae
--- /dev/null
+++ b/rtp/h264_reorder.go
@@ -0,0 +1,103 @@
+package rtp
+
+// H264ReorderWindow is how many packets the reordering assembler holds back behind a
+// missing one before it calls that packet lost. Live WhatsApp video over the relay
+// (2026-11-03) arrived with single packets up to 22 places late and nothing lost; the
+// plain assembler took each of those for a loss and froze the picture until the next IDR.
+const H264ReorderWindow = 32
+
+// h264SequenceJump is a forward jump past which the stream is treated as restarted
+// rather than reordered: whatever is held back is dropped and the new sequence taken.
+const h264SequenceJump = 1024
+
+type heldPacket struct {
+	marker  bool
+	payload []byte
+}
+
+// H264ReorderingAssembler puts video RTP packets back in sequence order before handing
+// them to an H264AccessUnitAssembler, so reordering on the path is not mistaken for loss.
+// A packet that is still missing once H264ReorderWindow later packets are held is given
+// up on; the inner assembler then sees the gap and waits for an IDR as before.
+type H264ReorderingAssembler struct {
+	inner   H264AccessUnitAssembler
+	next    uint16
+	started bool
+	held    map[uint16]heldPacket
+}
+
+// Push takes one RTP packet in arrival order. It returns every access unit completed by
+// it (none while a gap is being waited out, several when a late packet fills one), and
+// whether the stream broke so that the decoder needs an IDR.
+func (r *H264ReorderingAssembler) Push(sequence uint16, marker bool, payload []byte) ([][]byte, bool) {
+	if !r.started {
+		r.started = true
+		r.next = sequence
+	}
+	ahead := sequence - r.next
+	if ahead >= 0x8000 {
+		return nil, false // older than what was already handed on: a duplicate or given up on
+	}
+	if ahead >= h264SequenceJump {
+		r.held = nil
+		r.next = sequence
+		ahead = 0
+	}
+	if ahead == 0 {
+		var frames [][]byte
+		recovery := r.feed(sequence, marker, payload, &frames)
+		r.next++
+		return frames, r.drain(&frames) || recovery
+	}
+	if r.held == nil {
+		r.held = make(map[uint16]heldPacket)
+	}
+	if _, dup := r.held[sequence]; !dup {
+		r.held[sequence] = heldPacket{marker: marker, payload: append([]byte(nil), payload...)}
+	}
+	var frames [][]byte
+	recovery := false
+	for len(r.held) >= H264ReorderWindow {
+		r.next = r.oldestHeld() // give up on everything before it
+		recovery = r.drain(&frames) || recovery
+	}
+	return frames, recovery
+}
+
+// KeyframeNeeded reports whether frames are being withheld until the next IDR.
+func (r *H264ReorderingAssembler) KeyframeNeeded() bool {
+	return r.inner.keyframeNeeded
+}
+
+func (r *H264ReorderingAssembler) feed(sequence uint16, marker bool, payload []byte, frames *[][]byte) bool {
+	frame, complete, recovery := r.inner.Push(sequence, marker, payload)
+	if complete && len(frame) > 0 {
+		*frames = append(*frames, frame)
+	}
+	return recovery
+}
+
+// drain hands on held packets for as long as they continue the sequence.
+func (r *H264ReorderingAssembler) drain(frames *[][]byte) bool {
+	recovery := false
+	for {
+		p, ok := r.held[r.next]
+		if !ok {
+			return recovery
+		}
+		delete(r.held, r.next)
+		recovery = r.feed(r.next, p.marker, p.payload, frames) || recovery
+		r.next++
+	}
+}
+
+func (r *H264ReorderingAssembler) oldestHeld() uint16 {
+	first := true
+	var oldest, best uint16
+	for s := range r.held {
+		if d := s - r.next; first || d < best {
+			first, oldest, best = false, s, d
+		}
+	}
+	return oldest
+}
diff --git a/rtp/h264_reorder_test.go b/rtp/h264_reorder_test.go
new file mode 100644
index 0000000..320bffe
--- /dev/null
+++ b/rtp/h264_reorder_test.go
@@ -0,0 +1,167 @@
+package rtp
+
+import "testing"
+
+// One single-NAL frame per packet: an IDR (type 5) or a P slice (type 1), tagged so a
+// frame can be told apart after reassembly.
+func idrPacket(tag byte) []byte { return []byte{0x65, tag} }
+func pPacket(tag byte) []byte   { return []byte{0x41, tag} }
+
+func frameTag(t *testing.T, au []byte) byte {
+	t.Helper()
+	if len(au) < 6 {
+		t.Fatalf("access unit too short: %x", au)
+	}
+	return au[len(au)-1]
+}
+
+type reorderPkt struct {
+	seq     uint16
+	payload []byte
+}
+
+func pushAll(t *testing.T, r *H264ReorderingAssembler, pkts []reorderPkt) (tags []byte, recovery bool) {
+	t.Helper()
+	for _, p := range pkts {
+		frames, rec := r.Push(p.seq, true, p.payload)
+		recovery = recovery || rec
+		for _, f := range frames {
+			tags = append(tags, frameTag(t, f))
+		}
+	}
+	return tags, recovery
+}
+
+func TestReorderedPacketsAreNotALoss(t *testing.T) {
+	var r H264ReorderingAssembler
+	// Seen live: 250, 252, 251, 253 -- nothing missing, one packet late.
+	tags, recovery := pushAll(t, &r, []reorderPkt{
+		{250, idrPacket(0)}, {252, pPacket(2)}, {251, pPacket(1)}, {253, pPacket(3)},
+	})
+	if recovery || r.KeyframeNeeded() {
+		t.Fatalf("a late packet was taken for a loss (recovery=%v, keyframeNeeded=%v)", recovery, r.KeyframeNeeded())
+	}
+	if string(tags) != string([]byte{0, 1, 2, 3}) {
+		t.Fatalf("frames %v, want 0 1 2 3 in order", tags)
+	}
+}
+
+func TestAPacketLateByMostOfTheWindowStillFits(t *testing.T) {
+	var r H264ReorderingAssembler
+	pkts := []reorderPkt{{100, idrPacket(0)}}
+	for i := 2; i < H264ReorderWindow; i++ { // 101 missing; 102.. held
+		pkts = append(pkts, reorderPkt{uint16(100 + i), pPacket(byte(i))})
+	}
+	pkts = append(pkts, reorderPkt{101, pPacket(1)})
+	tags, recovery := pushAll(t, &r, pkts)
+	if recovery || len(tags) != H264ReorderWindow {
+		t.Fatalf("got %d frames (recovery=%v), want all %d", len(tags), recovery, H264ReorderWindow)
+	}
+	for i, tag := range tags {
+		if int(tag) != i {
+			t.Fatalf("frame %d has tag %d: out of order", i, tag)
+		}
+	}
+}
+
+func TestARealLossWaitsForAnIDR(t *testing.T) {
+	var r H264ReorderingAssembler
+	pkts := []reorderPkt{{10, idrPacket(0)}}
+	for i := 0; i < H264ReorderWindow; i++ { // 11 never comes
+		pkts = append(pkts, reorderPkt{uint16(12 + i), pPacket(byte(i + 1))})
+	}
+	tags, recovery := pushAll(t, &r, pkts)
+	if !recovery || !r.KeyframeNeeded() {
+		t.Fatalf("a lost packet was not reported (recovery=%v, keyframeNeeded=%v)", recovery, r.KeyframeNeeded())
+	}
+	if len(tags) != 1 {
+		t.Fatalf("P frames after the loss reached the decoder: %v", tags)
+	}
+	frames, _ := r.Push(uint16(12+H264ReorderWindow), true, pPacket(0x70))
+	if len(frames) != 0 {
+		t.Fatal("a P frame got through while waiting for the IDR")
+	}
+	frames, _ = r.Push(uint16(13+H264ReorderWindow), true, idrPacket(0x71))
+	if len(frames) != 1 || frameTag(t, frames[0]) != 0x71 || r.KeyframeNeeded() {
+		t.Fatalf("the IDR did not restart the picture: %d frames, keyframeNeeded=%v", len(frames), r.KeyframeNeeded())
+	}
+}
+
+func TestAfterALossEverythingHeldFromTheNextIDROnIsKept(t *testing.T) {
+	var r H264ReorderingAssembler
+	// 11 is lost; 12 is an IDR (the peer answering a keyframe request) and is followed by P frames.
+	pkts := []reorderPkt{{10, idrPacket(0)}, {12, idrPacket(1)}}
+	for i := 1; i < H264ReorderWindow; i++ {
+		pkts = append(pkts, reorderPkt{uint16(12 + i), pPacket(byte(1 + i))})
+	}
+	tags, _ := pushAll(t, &r, pkts)
+	if len(tags) != H264ReorderWindow+1 || tags[1] != 1 || tags[len(tags)-1] != byte(H264ReorderWindow) {
+		t.Fatalf("frames after the loss were thrown away: got %v", tags)
+	}
+}
+
+func TestDuplicatesAndStragglersAreIgnored(t *testing.T) {
+	var r H264ReorderingAssembler
+	tags, recovery := pushAll(t, &r, []reorderPkt{
+		{500, idrPacket(0)}, {501, pPacket(1)}, {501, pPacket(1)}, {500, idrPacket(0)},
+		{503, pPacket(3)}, {503, pPacket(3)}, {502, pPacket(2)},
+	})
+	if recovery || string(tags) != string([]byte{0, 1, 2, 3}) {
+		t.Fatalf("frames %v recovery=%v, want 0 1 2 3 once each", tags, recovery)
+	}
+}
+
+func TestSequenceWrapsAround(t *testing.T) {
+	var r H264ReorderingAssembler
+	tags, recovery := pushAll(t, &r, []reorderPkt{
+		{65534, idrPacket(0)}, {0, pPacket(2)}, {65535, pPacket(1)}, {1, pPacket(3)},
+	})
+	if recovery || string(tags) != string([]byte{0, 1, 2, 3}) {
+		t.Fatalf("frames %v recovery=%v across the wrap", tags, recovery)
+	}
+}
+
+func TestARestartedSequenceIsTakenAsNew(t *testing.T) {
+	var r H264ReorderingAssembler
+	tags, _ := pushAll(t, &r, []reorderPkt{{100, idrPacket(0)}, {30000, idrPacket(1)}, {30001, pPacket(2)}})
+	if string(tags) != string([]byte{0, 1, 2}) {
+		t.Fatalf("frames %v after a sequence restart, want 0 1 2", tags)
+	}
+}
+
+func TestHeldPayloadIsCopied(t *testing.T) {
+	var r H264ReorderingAssembler
+	r.Push(1, true, idrPacket(0))
+	buf := pPacket(3)
+	r.Push(3, true, buf)
+	buf[1] = 0xEE // the receive loop reuses its buffer
+	frames, _ := r.Push(2, true, pPacket(2))
+	if len(frames) != 2 || frameTag(t, frames[1]) != 3 {
+		t.Fatalf("held packet changed with the caller's buffer: %d frames", len(frames))
+	}
+}
+
+func TestFragmentedFramesSurviveReordering(t *testing.T) {
+	var r H264ReorderingAssembler
+	// One P frame in three FU-A fragments, the middle one late.
+	start := []byte{0x5C, 0x81, 0xA0} // FU indicator (type 28), start bit, type 1
+	mid := []byte{0x5C, 0x01, 0xA1}
+	end := []byte{0x5C, 0x41, 0xA2} // end bit
+	if f, _ := r.Push(1, true, idrPacket(0)); len(f) != 1 {
+		t.Fatal("IDR not passed")
+	}
+	if f, _ := r.Push(2, false, start); len(f) != 0 {
+		t.Fatal("frame closed early")
+	}
+	if f, _ := r.Push(4, true, end); len(f) != 0 {
+		t.Fatal("frame closed with a fragment missing")
+	}
+	f, rec := r.Push(3, false, mid)
+	if rec || len(f) != 1 {
+		t.Fatalf("late middle fragment: %d frames, recovery=%v", len(f), rec)
+	}
+	want := []byte{0, 0, 0, 1, 0x41, 0xA0, 0xA1, 0xA2}
+	if string(f[0]) != string(want) {
+		t.Fatalf("reassembled %x, want %x", f[0], want)
+	}
+}

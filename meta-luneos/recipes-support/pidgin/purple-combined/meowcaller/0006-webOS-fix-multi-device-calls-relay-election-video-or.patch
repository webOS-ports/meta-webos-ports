+// so getMediaRelayEndpoint picks the same relay again in connectAndAllocate.
+func settleMediaRelay(m *engineCall) *relayData {
+	rd := m.relay
+	inbound := m.direction == CallDirectionIncoming
+	if m.electedRelay == "" {
+		if inbound {
+			m.electedRelay = steerInboundRelay(rd, nil)
+		}
+		if m.electedRelay == "" {
+			if ep := getMediaRelayEndpoint(rd, inbound); ep != nil {

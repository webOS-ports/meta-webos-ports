+// rtpOrientation follows the orientation the peer stamps on its video packets (the
+// low two bits of MediaFrameInfo), which is what WhatsApp clients rotate by.
+//
+// The "video is live" state announced on the first video frame carries it: that
+// state used to say orientation 0, and after a mid-call upgrade it arrives after
+// the peer's <video state=1 device_orientation=1>, so it turned the picture back
+// on its side. Once video is live, a change of the bits (the peer turning its
+// phone) is announced as well.
+type rtpOrientation struct {
+	bits int // the last video packet's, valid once seen
+	live bool
+	seen bool
+}
+
+// packet records one video packet's bits. changed: they differ from the last
+// packet's; announce: video is live, so the change should be reported as st.
+func (o *rtpOrientation) packet(bits int) (st VideoState, changed, announce bool) {
+	if o.seen && bits == o.bits {
+		return VideoState{}, false, false
+	}
+	o.seen = true
+	o.bits = bits
+	return VideoState{Active: true, Raw: 1, Orientation: bits}, true, o.live
+}
+
+// firstFrame marks video live and returns the state to announce for it.
+func (o *rtpOrientation) firstFrame() VideoState {
+	o.live = true
+	bits := 0
+	if o.seen {
+		bits = o.bits
+	}
+	return VideoState{Active: true, Raw: 1, Orientation: bits}
+}

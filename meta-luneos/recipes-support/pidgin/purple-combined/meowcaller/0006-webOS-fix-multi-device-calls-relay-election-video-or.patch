+				Data:          &waBinary.Node{Tag: "reject", Attrs: waBinary.Attrs{"reason": reason}},
+			})
+		}
+		if got := call2.State(); got != CallPhaseEnded {
+			t.Fatalf("%s from every device left the call in phase %d", reason, got)
+		}

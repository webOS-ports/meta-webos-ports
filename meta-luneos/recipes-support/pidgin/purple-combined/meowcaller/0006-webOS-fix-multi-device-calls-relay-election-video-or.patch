+func TestRingingCallKeepsAnnouncingUntilAnswered(t *testing.T) {
+	eng, call, _, companion, _ := testEngineRingingTwoDevices()
+	sent := &nodeLog{}
+	eng.sendCallNode = sent.send
+	eng.ringAnnounceInterval = 5 * time.Millisecond
+	preaccept(eng, companion)
+	preaccept(eng, companion) // a repeated preaccept adds no second target
+	// The callee's user answers some time after its preaccept: it needs a mute_v2
+	// that arrives after that, not only the first one.
+	waitFor(t, "repeated mute_v2", func() bool { return len(sent.tagged("mute_v2")) >= 3 })
+	for _, n := range sent.tagged("mute_v2") {
+		if n.AttrGetter().JID("to") != companion {
+			t.Fatalf("mute_v2 to %s, want only the preaccepted device", n.AttrGetter().JID("to"))
+		}
+	}
+	eng.onAccept(&events.CallAccept{
+		BasicCallMeta: types.BasicCallMeta{CallID: call.ID(), From: companion},
+		Data:          &waBinary.Node{Tag: "accept"},
+	})
+	time.Sleep(15 * time.Millisecond) // a tick already under way may still send
+	before := len(sent.tagged("mute_v2"))
+	time.Sleep(30 * time.Millisecond)
+	if after := len(sent.tagged("mute_v2")); after != before {
+		t.Fatalf("still announcing after the answer: %d -> %d", before, after)
+	}
+}
+
+func TestRingingCallStopsAnnouncingWhenItEnds(t *testing.T) {
+	eng, _, _, companion, _ := testEngineRingingTwoDevices()
+	sent := &nodeLog{}
+	eng.sendCallNode = sent.send
+	eng.ringAnnounceInterval = 5 * time.Millisecond
+	preaccept(eng, companion)
+	waitFor(t, "a mute_v2", func() bool { return len(sent.tagged("mute_v2")) > 0 })
+	eng.finishCall("CID", "timeout")
+	time.Sleep(15 * time.Millisecond)
+	before := len(sent.tagged("mute_v2"))
+	time.Sleep(30 * time.Millisecond)
+	if after := len(sent.tagged("mute_v2")); after != before {
+		t.Fatalf("still announcing after the call ended: %d -> %d", before, after)
+	}
+}
+
+// testEngineAnswering is an incoming call from a caller device, with sent nodes recorded.
+func testEngineAnswering(fallback time.Duration) (*engine, *Call, types.JID, *nodeLog) {
+	c := &Client{}
+	c.eng = newEngine(c)
+	caller := creatorJID()
+	call := &Call{eng: c.eng, id: "CID", peer: caller, phase: CallPhaseRinging}
+	c.eng.calls["CID"] = &engineCall{call: call, direction: CallDirectionIncoming, from: caller, creator: caller}
+	sent := &nodeLog{}
+	c.eng.sendCallNode = sent.send
+	c.eng.acceptFallback = fallback
+	return c.eng, call, caller, sent
+}
+
+func muteV2Node(caller types.JID) *waBinary.Node {
+	return &waBinary.Node{Tag: "call", Attrs: waBinary.Attrs{"from": caller}, Content: []waBinary.Node{{
+		Tag: "mute_v2", Attrs: waBinary.Attrs{"call-id": "CID", "call-creator": caller, "mute-state": "0"},
+	}}}
+}
+
+// A caller that never sends <mute_v2> (another meowcaller) still gets the accept.
+func TestAnswerAcceptsWithoutTheCallersMuteState(t *testing.T) {
+	eng, call, caller, sent := testEngineAnswering(10 * time.Millisecond)
+	if err := eng.answer(call); err != nil {
+		t.Fatal(err)
+	}
+	if n := len(sent.tagged("accept")); n != 0 {
+		t.Fatalf("accepted at once (%d), the fallback should wait for a mute_v2 first", n)
+	}
+	waitFor(t, "the accept", func() bool { return len(sent.tagged("accept")) == 1 })
+	a := sent.tagged("accept")[0]
+	if a.AttrGetter().JID("to") != caller || a.AttrGetter().OptionalString("id") == "" {
+		t.Fatalf("accept wrapper attrs = %v", a.Attrs)
+	}
+	if got := a.GetChildren()[0].AttrGetter().String("call-id"); got != "CID" {
+		t.Fatalf("accept call-id = %q", got)
+	}
+}
+
+// An Android caller's <mute_v2> still triggers the accept, and only one is sent.
+func TestAnswerAcceptsOnceWhenTheCallerSendsItsMuteState(t *testing.T) {
+	eng, call, caller, sent := testEngineAnswering(20 * time.Millisecond)
+	if err := eng.answer(call); err != nil {
+		t.Fatal(err)
+	}
+	eng.onCallRaw(muteV2Node(caller))
+	if n := len(sent.tagged("accept")); n != 1 {
+		t.Fatalf("sent %d accepts on the mute_v2, want 1", n)
+	}
+	time.Sleep(60 * time.Millisecond)
+	if n := len(sent.tagged("accept")); n != 1 {
+		t.Fatalf("the fallback sent a second accept: %d", n)
+	}
+}
+
+// Without an answer there is nothing to accept, however long the call rings.
+func TestNoAcceptWithoutAnAnswer(t *testing.T) {
+	eng, _, caller, sent := testEngineAnswering(5 * time.Millisecond)
+	eng.onCallRaw(muteV2Node(caller))
+	time.Sleep(30 * time.Millisecond)
+	if n := len(sent.tagged("accept")); n != 0 {
+		t.Fatalf("accepted a call nobody answered: %d", n)
+	}
+}
+
+// enabledOrientation returns the device_orientation of the last state=1 stanza sent,
+// or -1 when that stanza has none.
+func enabledOrientation(t *testing.T, sent []waBinary.Node) int {
+	t.Helper()
+	for i := len(sent) - 1; i >= 0; i-- {
+		kids := sent[i].GetChildren()
+		if len(kids) == 1 && kids[0].Tag == "video" && kids[0].AttrGetter().Int("state") == signaling.VideoStateEnabled {
+			v, ok := kids[0].Attrs["device_orientation"]
+			if !ok {
+				return -1
+			}
+			n, err := strconv.Atoi(v.(string))
+			if err != nil {
+				t.Fatalf("device_orientation %v", v)
+			}
+			return n
+		}
+	}
+	t.Fatalf("no state=1 stanza in %#v", sent)
+	return -1
+}
+
+func recordNodes(eng *engine) *[]waBinary.Node {
+	sent := &[]waBinary.Node{}
+	eng.sendCallNode = func(_ context.Context, node waBinary.Node) error {
+		*sent = append(*sent, node)
+		return nil
+	}
+	return sent
+}
+
+// Turning the camera back on announced orientation 0, and a peer that takes it from
+// the stanza showed the picture on its side.
+func TestCameraBackOnAnnouncesItsOrientation(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	eng.calls[call.ID()].videoTx = &videoSender{}
+	sent := recordNodes(eng)
+	if err := call.SetVideoOrientation(1); err != nil {
+		t.Fatal(err)
+	}
+	if err := call.SetVideoEnabled(false); err != nil {
+		t.Fatal(err)
+	}
+	if err := call.SetVideoEnabled(true); err != nil {
+		t.Fatal(err)
+	}
+	if got := enabledOrientation(t, *sent); got != 1 {
+		t.Fatalf("camera back on announced orientation %d, want 1", got)
+	}
+}
+
+// The plugin sets the orientation when the engine starts, which can be while our
+// camera is off; it must still be what the camera announces when it comes on.
+func TestOrientationSetWithTheCameraOffIsUsedWhenItComesOn(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	m := eng.calls[call.ID()]
+	m.videoTx = &videoSender{}
+	m.localVideo = false
+	sent := recordNodes(eng)
+	if err := call.SetVideoOrientation(3); err != nil {
+		t.Fatalf("SetVideoOrientation with the camera off: %v", err)
+	}
+	if len(*sent) != 0 {
+		t.Fatalf("announced an orientation for a camera that is off: %#v", *sent)
+	}
+	if err := call.SetVideoEnabled(true); err != nil {
+		t.Fatal(err)
+	}
+	if got := enabledOrientation(t, *sent); got != 3 {
+		t.Fatalf("camera on announced orientation %d, want 3", got)
+	}
+}
+
+func TestUpgradeAnnouncementsCarryTheOrientation(t *testing.T) {
+	// We asked; the peer accepted (state 4) and we announce state 1.
+	eng, call := testEngineWithOutgoingCall()
+	m := eng.calls[call.ID()]
+	m.videoTx = &videoSender{}
+	m.localVideo = false
+	m.txOrient = 1
+	sent := recordNodes(eng)
+	if err := call.StartVideo(); err != nil {
+		t.Fatal(err)
+	}
+	eng.onVideoStanza(videoStateNode(signaling.VideoStateUpgradeAccept))
+	if got := enabledOrientation(t, *sent); got != 1 {
+		t.Fatalf("state 1 after the peer's accept says %d, want 1", got)
+	}
+}
+
+// The peer's packets say how to turn its picture; a camera-on stanza saying 0 must
+// not override them.
+func TestPacketOrientationWinsOverTheStanza(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	eng.calls[call.ID()].rxOrient, eng.calls[call.ID()].rxOrientKnown = 1, true
+	recordNodes(eng)
+	var got VideoState
+	call.OnVideoState(func(state VideoState) { got = state })
+	eng.onVideoStanza(videoStateNode(signaling.VideoStateEnabled)) // no device_orientation: 0
+	if !got.Active || got.Orientation != 1 {
+		t.Fatalf("video state = %+v, want active with the packets' orientation 1", got)
+	}
+}
+
+// Before any packet, the stanza's orientation is all there is.
+func TestStanzaOrientationBeforeAnyPacket(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	recordNodes(eng)
+	var got VideoState
+	call.OnVideoState(func(state VideoState) { got = state })
+	node := videoStateNode(signaling.VideoStateEnabled)
+	node.Attrs["device_orientation"] = "1"
+	eng.onVideoStanza(node)
+	if got.Orientation != 1 {
+		t.Fatalf("video state = %+v, want the stanza's orientation 1", got)
+	}
+}
+
+// Camera off is state 6 with our orientation, as WhatsApp's clients send it.
+func TestCameraOffKeepsTheOrientation(t *testing.T) {
+	eng, call := testEngineWithOutgoingCall()
+	eng.calls[call.ID()].videoTx = &videoSender{}
+	eng.calls[call.ID()].txOrient = 1
+	sent := recordNodes(eng)
+	if err := call.StopVideo(); err != nil {
+		t.Fatal(err)
+	}
+	if len(*sent) != 1 {
+		t.Fatalf("sent %d stanzas, want one", len(*sent))
+	}
+	v := (*sent)[0].GetChildren()[0].AttrGetter()
+	if v.Int("state") != signaling.VideoStateStopped || v.OptionalString("device_orientation") != "1" {
+		t.Fatalf("camera off = %v, want state 6 with orientation 1", (*sent)[0].GetChildren()[0].Attrs)
+	}
+}

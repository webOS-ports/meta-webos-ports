From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 20 Oct 2026 16:23:33 +0200
Subject: [PATCH] webOS: Add gateway and channel list diagnostics

Debug logging used to chase missing real-time messages and missing
channels on webOS:

- log when the zlib stream fails to inflate and a gateway event is
  dropped;
- log which guild channels discord_buddy_guild hides and the totals.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS debugging aid]
---
 libdiscord.c | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/libdiscord.c b/libdiscord.c
index eee829f..e173623 100644
--- a/libdiscord.c
+++ b/libdiscord.c
@@ -6302,11 +6302,18 @@ discord_buddy_guild(DiscordAccount *da, DiscordGuild *guild)
 
 	g_hash_table_iter_init(&iter, guild->channels);
 
+	int dbg_total = 0, dbg_added = 0, dbg_hidden = 0;
 	while (g_hash_table_iter_next(&iter, &key, &value)) {
 		DiscordChannel *channel = value;
+		dbg_total++;
 
-		if (!discord_is_channel_visible(da, user, channel))
+		if (!discord_is_channel_visible(da, user, channel)) {
+			dbg_hidden++;
+			purple_debug_info("discord", "buddy_guild: guild '%s' HIDE channel '%s' (type %d)\n",
+			                  guild->name ? guild->name : "?", channel->name ? channel->name : "?", (int)channel->type);
 			continue;
+		}
+		dbg_added++;
 
 		/* Find/make a group */
 		gchar *category_id = from_int(channel->parent_id);
@@ -6332,6 +6339,9 @@ discord_buddy_guild(DiscordAccount *da, DiscordGuild *guild)
 
 		discord_add_channel_to_blist(da, channel, group);
 	}
+
+	purple_debug_info("discord", "buddy_guild: guild '%s' (id %" G_GUINT64_FORMAT ") channels=%d added=%d hidden=%d\n",
+	                  guild->name ? guild->name : "?", guild->id, dbg_total, dbg_added, dbg_hidden);
 }
 
 void discord_guild_member_screening(DiscordAccount *da, JsonNode *node, gpointer user_data);
@@ -7834,6 +7844,12 @@ discord_inflate(DiscordAccount *da, gchar *frame, gsize frame_len)
 	}
 
 	if (gzres != Z_OK && gzres != Z_STREAM_END) {
+		/* WEBOS-DIAG (issue #1): a persistent zlib-stream desync. Once this happens EVERY subsequent
+		 * gateway frame fails to inflate, so real-time events are lost until a full reconnect resets
+		 * the stream. Fragmented messages are reassembled and split frame headers are read in full, so
+		 * this now points at a real protocol error rather than at the frame reader. */
+		purple_debug_error("discord", "WEBOS-DIAG inflate FAILED gzres=%d avail_in=%u frame_len=%" G_GSIZE_FORMAT " -- zlib-stream desynced; real-time events lost until reconnect\n",
+			gzres, zs->avail_in, frame_len);
 		g_string_free(ret, TRUE);
 		return NULL;
 	}
@@ -8018,6 +8034,12 @@ discord_socket_got_frame(DiscordAccount *ya, PurpleSslConnection *conn)
 		gchar *temp = discord_inflate(ya, message, message_len);
 		g_free(message);
 		message = temp;
+		if (temp == NULL) {
+			/* WEBOS-DIAG (issue #1): the inflate failed, so discord_process_frame is about to be
+			 * handed NULL, fail to parse, and return TRUE (success) - the gateway event vanishes
+			 * with no error and no reconnect. This is why new messages only show after re-login. */
+			purple_debug_error("discord", "WEBOS-DIAG inflate returned NULL for a %" G_GSIZE_FORMAT "-byte compressed frame -> gateway event SILENTLY DROPPED (no reconnect)\n", message_len);
+		}
 	}
 
 #ifdef USE_QRCODE_AUTH

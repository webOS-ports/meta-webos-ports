+
+/* Pure helpers for the webOS Messaging bridge: they only use GLib, take no
+ * connection, and are unit tested in tests/. */
+
+#ifndef DISCORD_WEBOS_HELPERS_H
+#define DISCORD_WEBOS_HELPERS_H
+
+#include <glib.h>
+
+/* TRUE if s is a non-empty string of at most 20 ASCII digits, the form of a
+ * Discord snowflake. */
+gboolean discord_webos_is_snowflake(const gchar *s);
+
+/* <api_base>/channels/<channel_id>, or NULL for channel 0. */
+gchar *discord_webos_channel_url(const gchar *api_base, guint64 channel_id);
+
+/* <api_base>/channels/<channel_id>/messages/<message_id>, or NULL for channel
+ * 0 or a message_id that is not a snowflake (so nothing else can end up in the
+ * path). */
+gchar *discord_webos_message_url(const gchar *api_base, guint64 channel_id, const gchar *message_id);
+
+#endif /* DISCORD_WEBOS_HELPERS_H */

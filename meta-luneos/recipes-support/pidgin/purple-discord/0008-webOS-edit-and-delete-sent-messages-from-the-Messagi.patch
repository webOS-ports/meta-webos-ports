index 0000000..55cadee
--- /dev/null
+++ b/tests/Makefile
@@ -0,0 +1,21 @@
+# Unit tests for the pure webOS helpers (webos_helpers.c). They need GLib only, no libpurple:
+#   make -C tests check
+# Cross builds pass CC, PKG_CONFIG and a sysroot the usual way; extra flags go in CFLAGS (for
+# example -fsanitize=address,undefined).
+CC ?= cc
+PKG_CONFIG ?= pkg-config
+CFLAGS ?= -O2 -g
+CFLAGS += -std=c99 -Wall -Wextra
+GLIB_CFLAGS := $(shell $(PKG_CONFIG) --cflags glib-2.0)
+GLIB_LIBS := $(shell $(PKG_CONFIG) --libs glib-2.0)
+
+test_webos_helpers: test_webos_helpers.c ../webos_helpers.c ../webos_helpers.h
+	$(CC) $(CFLAGS) -I.. $(GLIB_CFLAGS) -o $@ test_webos_helpers.c ../webos_helpers.c $(LDFLAGS) $(GLIB_LIBS)
+
+check: test_webos_helpers
+	./test_webos_helpers
+
+clean:
+	rm -f test_webos_helpers
+
+.PHONY: check clean
diff --git a/tests/test_webos_helpers.c b/tests/test_webos_helpers.c
new file mode 100644
index 0000000..656fd8e
--- /dev/null
+++ b/tests/test_webos_helpers.c
@@ -0,0 +1,81 @@
+/*
+ *   Unit tests for webos_helpers.c
+ *
+ *   This program is free software: you can redistribute it and/or modify
+ *   it under the terms of the GNU General Public License as published by
+ *   the Free Software Foundation, either version 3 of the License, or
+ *   (at your option) any later version.
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "webos_helpers.h"
+
+static int failures;
+
+#define CHECK(cond) do { \
+	if (!(cond)) { \
+		fprintf(stderr, "%s:%d: CHECK failed: %s\n", __FILE__, __LINE__, #cond); \
+		failures++; \
+	} \
+} while (0)
+
+/* Compares and frees got; expected NULL means got must be NULL. */
+static void
+check_str(const char *file, int line, gchar *got, const gchar *expected)
+{
+	if (g_strcmp0(got, expected) != 0) {
+		fprintf(stderr, "%s:%d: got \"%s\", expected \"%s\"\n", file, line,
+				got ? got : "(null)", expected ? expected : "(null)");
+		failures++;
+	}
+	g_free(got);
+}
+#define CHECK_STR(got, expected) check_str(__FILE__, __LINE__, (got), (expected))
+
+#define BASE "https://discord.com/api/v10"
+
+static void
+test_snowflake(void)
+{
+	CHECK(discord_webos_is_snowflake("1"));
+	CHECK(discord_webos_is_snowflake("1234567890123456789"));
+	CHECK(discord_webos_is_snowflake("18446744073709551615"));     /* 20 digits, G_MAXUINT64 */
+	CHECK(!discord_webos_is_snowflake("123456789012345678901"));  /* 21 digits */
+	CHECK(!discord_webos_is_snowflake(NULL));
+	CHECK(!discord_webos_is_snowflake(""));
+	CHECK(!discord_webos_is_snowflake("12a"));
+	CHECK(!discord_webos_is_snowflake("12/../34"));
+	CHECK(!discord_webos_is_snowflake(" 12"));
+	CHECK(!discord_webos_is_snowflake("-12"));
+}
+
+static void
+test_urls(void)
+{
+	CHECK_STR(discord_webos_channel_url(BASE, 42), BASE "/channels/42");
+	CHECK_STR(discord_webos_channel_url(BASE, G_MAXUINT64), BASE "/channels/18446744073709551615");
+	CHECK_STR(discord_webos_channel_url(BASE, 0), NULL);
+	CHECK_STR(discord_webos_channel_url(NULL, 42), NULL);
+
+	CHECK_STR(discord_webos_message_url(BASE, 42, "1234"), BASE "/channels/42/messages/1234");
+	CHECK_STR(discord_webos_message_url(BASE, 0, "1234"), NULL);
+	CHECK_STR(discord_webos_message_url(BASE, 42, NULL), NULL);
+	CHECK_STR(discord_webos_message_url(BASE, 42, ""), NULL);
+	CHECK_STR(discord_webos_message_url(BASE, 42, "12/reactions"), NULL);
+}
+
+int
+main(void)
+{
+	test_snowflake();
+	test_urls();
+
+	if (failures) {
+		fprintf(stderr, "%d check(s) failed\n", failures);
+		return 1;
+	}
+	printf("all webos_helpers tests passed\n");
+	return 0;
+}

+ */
+
+#include "webos_helpers.h"
+
+gboolean
+discord_webos_is_snowflake(const gchar *s)
+{
+	gsize n = 0;
+
+	if (s == NULL || *s == '\0')
+		return FALSE;
+
+	for (; s[n] != '\0'; n++) {
+		if (!g_ascii_isdigit(s[n]) || n >= 20)
+			return FALSE;
+	}
+
+	return TRUE;
+}
+
+gchar *
+discord_webos_channel_url(const gchar *api_base, guint64 channel_id)
+{
+	if (api_base == NULL || channel_id == 0)
+		return NULL;
+
+	return g_strdup_printf("%s/channels/%" G_GUINT64_FORMAT, api_base, channel_id);
+}
+
+gchar *
+discord_webos_message_url(const gchar *api_base, guint64 channel_id, const gchar *message_id)
+{
+	if (api_base == NULL || channel_id == 0 || !discord_webos_is_snowflake(message_id))
+		return NULL;
+
+	return g_strdup_printf("%s/channels/%" G_GUINT64_FORMAT "/messages/%s", api_base, channel_id, message_id);
+}

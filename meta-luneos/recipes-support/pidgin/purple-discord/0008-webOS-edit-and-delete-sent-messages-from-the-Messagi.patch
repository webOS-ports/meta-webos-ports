 }
 
+/* webOS edit (SEND): "webos-im-send-edit" (account, chat, serviceMessageId, text) - the user edited
+ * one of their own messages in the Messaging app. serviceMessageId is the message snowflake (what
+ * "webos-im-outbox-id" reported from the gateway echo of our send). text is the new body, in the form
+ * a send hands send_im/chat_send, so it gets the same markdown conversion. PATCH replaces the
+ * message's content; Discord only lets the author do that. Returns TRUE when the request went out. */
+static gboolean
+discord_webos_send_edit_cb(PurpleAccount *account, const char *chat, const char *msg_id,
+		const char *text, void *data)
+{
+	(void) data;
+	DiscordAccount *da = discord_webos_account(account);
+	if (da == NULL || text == NULL)
+		return FALSE;
+
+	gchar *url = discord_webos_message_url(DISCORD_API_BASE, discord_webos_channel_for(da, chat, msg_id), msg_id);
+	if (url == NULL) {
+		purple_debug_warning("discord", "webos edit: no channel for message %s in %s\n",
+				msg_id ? msg_id : "(null)", chat ? chat : "(null)");
+		return FALSE;
+	}
+
+	gchar *content = discord_outgoing_content(text);
+	gsize content_len = strlen(content);
+	gboolean sent = FALSE;
+
+	/* The same bounds discord_conversation_send_message applies to a new message. */
+	if (content_len > 0 && content_len <= 2000) {
+		JsonObject *body = json_object_new();
+		json_object_set_string_member(body, "content", content);
+		gchar *postdata = json_object_to_string(body);
+
+		discord_fetch_url_with_method(da, "PATCH", url, postdata, NULL, NULL);
+		sent = TRUE;
+
+		g_free(postdata);
+		json_object_unref(body);
+	} else {
+		purple_debug_warning("discord", "webos edit: content of %" G_GSIZE_FORMAT " bytes not sent\n", content_len);
+	}
+
+	g_free(content);
+	g_free(url);
+	return sent;
+}
+
+/* webOS delete (SEND): "webos-im-send-delete" (account, chat, serviceMessageId) - the user deleted a
+ * message in the Messaging app. DELETE removes it for everyone; Discord allows that for the author's
+ * own messages, and for others' in a server channel where the user may manage messages. Returns TRUE
+ * when the request went out. */
+static gboolean
+discord_webos_send_delete_cb(PurpleAccount *account, const char *chat, const char *msg_id, void *data)
+{
+	(void) data;
+	DiscordAccount *da = discord_webos_account(account);
+	if (da == NULL)
+		return FALSE;
+
+	gchar *url = discord_webos_message_url(DISCORD_API_BASE, discord_webos_channel_for(da, chat, msg_id), msg_id);
+	if (url == NULL) {
+		purple_debug_warning("discord", "webos delete: no channel for message %s in %s\n",
+				msg_id ? msg_id : "(null)", chat ? chat : "(null)");
+		return FALSE;
+	}
+
+	discord_fetch_url_with_method(da, "DELETE", url, NULL, NULL, NULL);
+	g_free(url);
+	return TRUE;
+}
+
 /* Connect once (process-wide) to the transport's send-reaction signal. The signal lives on
  * purple_conversations_get_handle(), so a single connect covers every Discord account in this process.
  * Guarded so repeated logins don't double-connect. */
@@ -7090,6 +7188,10 @@ discord_connect_send_reaction_once(void)
 	s_connected = TRUE;
 	purple_signal_connect(purple_conversations_get_handle(), "webos-im-send-reaction",
 			purple_get_core(), PURPLE_CALLBACK(discord_webos_send_reaction_cb), NULL);
+	purple_signal_connect(purple_conversations_get_handle(), "webos-im-send-edit",
+			purple_get_core(), PURPLE_CALLBACK(discord_webos_send_edit_cb), NULL);
+	purple_signal_connect(purple_conversations_get_handle(), "webos-im-send-delete",
+			purple_get_core(), PURPLE_CALLBACK(discord_webos_send_delete_cb), NULL);
 }
 
 void
@@ -9765,19 +9867,14 @@ discord_conversation_check_message_for_images(DiscordAccount *da, guint64 room_i
 	}
 }
 

+static gchar *discord_outgoing_content(const gchar *message);
+
+/* webOS: the DiscordAccount behind a PurpleAccount the transport names in one of its process-wide
+ * signals, or NULL when the account is not one of ours or is not connected. The signals fire for
+ * every account of every prpl. */
+static DiscordAccount *
+discord_webos_account(PurpleAccount *account)
+{
+	if (account == NULL || !purple_strequal(purple_account_get_protocol_id(account), DISCORD_PLUGIN_ID))
+		return NULL;
+
+	PurpleConnection *pc = purple_account_get_connection(account);
+	if (pc == NULL)
+		return NULL;
+
+	return purple_connection_get_protocol_data(pc);
+}
+
+/* webOS: the channel snowflake for a chat the transport names (its "peer": a buddy name for a 1:1 DM,
+ * the channel snowflake for a group DM or guild channel), or 0. When msg_id is given, the channel
+ * that message was delivered to (msgid_to_channel) wins: it is always right, while the app's peer can
+ * be the sender's username or the channel's display name. */
+static guint64
+discord_webos_channel_for(DiscordAccount *da, const gchar *peer, const gchar *msg_id)
+{
+	const gchar *bymsg = (msg_id != NULL && da->msgid_to_channel != NULL) ?
+			g_hash_table_lookup(da->msgid_to_channel, msg_id) : NULL;
+
+	if (bymsg != NULL)
+		return to_int(bymsg);                    /* the message's real channel - always correct */
+
+	if (peer == NULL || *peer == '\0')
+		return 0;
+
+	const gchar *dm = g_hash_table_lookup(da->one_to_ones_rev, peer);
+	if (dm != NULL)
+		return to_int(dm);                       /* DM buddy tracked in one_to_ones_rev */
+
+	if (*peer >= '0' && *peer <= '9')
+		return to_int(peer);                     /* peer is already a channel snowflake */
+
+	PurpleIMConversation *im = purple_conversations_find_im_with_account(peer, da->account);
+	if (im != NULL)
+		return discord_get_channel_id_from_conv(da, PURPLE_CONVERSATION(im));
+
+	return 0;
+}
+
 /* webOS reactions (SEND): the transport emits "webos-im-send-reaction" (registered process-wide) when
  * the user reacts, or removes a reaction, from the TouchPad. It fires for EVERY account, so we filter

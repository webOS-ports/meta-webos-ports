+typedef struct {
+	DiscordAccount *da;
+	DiscordGuild *guild;
+	DiscordChannel *channel;
+} DiscordWebosMentionCtx;
+
+/* webOS: the user a "webos-send-mentions" record names. The id is the buddy name on the service, but
+ * in a chat the app knows people by the names the chat shows, which can be a guild nickname, a buddy
+ * alias or, in a group DM, a display name; so try the id and then the shown name each way
+ * discord_make_mention resolves a typed "@name", then a group DM member's display name, then the id
+ * as a user snowflake. */
+static guint64
+discord_webos_resolve_mention(const gchar *id, const gchar *name, gpointer user_data)
+{
+	DiscordWebosMentionCtx *ctx = user_data;
+	DiscordUser *user = discord_find_mention_user(ctx->da, ctx->guild, id);
+
+	if (user == NULL)
+		user = discord_find_mention_user(ctx->da, ctx->guild, name);
+
+	if (user == NULL && ctx->channel != NULL && ctx->channel->type == CHANNEL_GROUP_DM) {
+		for (GList *l = ctx->channel->recipients; l != NULL && user == NULL; l = l->next) {
+			DiscordUser *u = discord_get_user(ctx->da, *(guint64 *) l->data);
+
+			if (u != NULL && u->global_name != NULL &&
+					(purple_strequal(u->global_name, id) || purple_strequal(u->global_name, name)))
+				user = u;
+		}
+	}
+
+	if (user == NULL && discord_webos_is_snowflake(id))
+		user = discord_get_user(ctx->da, to_int(id));
+
+	return user ? user->id : 0;
+}
+
+/* webOS: message with the mentions the transport put on conv as "webos-send-mentions" made into
+ * Discord mentions (see discord_webos_apply_mentions). The value belongs to the transport, which
+ * removes it once send_im/chat_send returns: it is only read, here, before anything asynchronous.
+ * Returns a new string: a copy of message when there are none. */
+static gchar *
+discord_webos_send_mentions(DiscordAccount *da, PurpleConversation *conv, DiscordGuild *guild,
+		DiscordChannel *channel, const gchar *message)
+{
+	const gchar *records = conv ? purple_conversation_get_data(conv, "webos-send-mentions") : NULL;
+
+	if (message == NULL)
+		message = "";
+
+	if (records == NULL || *records == '\0')
+		return g_strdup(message);
+
+	DiscordWebosMentionCtx ctx = { .da = da, .guild = guild, .channel = channel };
+	return discord_webos_apply_mentions(message, records, discord_webos_resolve_mention, &ctx);
+}
+

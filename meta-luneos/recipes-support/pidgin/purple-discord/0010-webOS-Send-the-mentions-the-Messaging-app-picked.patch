diff --git a/tests/test_webos_helpers.c b/tests/test_webos_helpers.c
index cb24c3f..157e482 100644
--- a/tests/test_webos_helpers.c
+++ b/tests/test_webos_helpers.c
@@ -113,6 +113,85 @@ test_group_create_body(void)
 	CHECK_STR(discord_webos_group_create_body(NULL, 1), NULL);
 }
 
+/* Fake resolver: "alice" -> 1, "anna" -> 2, "ann" -> 3, "tom" -> 4, "ae" -> 5, "t" -> 6, "zero" -> 0
+ * (unknown); also counts its calls. */
+static int resolve_calls;
+
+static guint64
+fake_resolve(const gchar *id, const gchar *name, gpointer user_data)
+{
+	(void) name;
+	CHECK(user_data == &resolve_calls);
+	resolve_calls++;
+	if (g_strcmp0(id, "alice") == 0) return 1;
+	if (g_strcmp0(id, "anna") == 0) return 2;
+	if (g_strcmp0(id, "ann") == 0) return 3;
+	if (g_strcmp0(id, "tom") == 0) return 4;
+	if (g_strcmp0(id, "ae") == 0) return 5;
+	if (g_strcmp0(id, "t") == 0) return 6;
+	return 0;
+}
+
+#define M(text, records) discord_webos_apply_mentions((text), (records), fake_resolve, &resolve_calls)
+
+static void
+test_mentions(void)
+{
+	/* nothing to do */
+	CHECK_STR(M(NULL, "alice\x1f" "Alice"), NULL);
+	CHECK_STR(M("hi @Alice", NULL), "hi @Alice");
+	CHECK_STR(M("hi @Alice", ""), "hi @Alice");
+	CHECK_STR(discord_webos_apply_mentions("hi @Alice", "alice\x1f" "Alice", NULL, NULL), "hi @Alice");
+
+	/* one mention, at the start, middle and end, and repeated */
+	CHECK_STR(M("@Alice hi", "alice\x1f" "Alice"), "&lt;@1&gt; hi");
+	CHECK_STR(M("hi @Alice, how", "alice\x1f" "Alice"), "hi &lt;@1&gt;, how");
+	CHECK_STR(M("hi @Alice", "alice\x1f" "Alice"), "hi &lt;@1&gt;");
+	CHECK_STR(M("@Alice @Alice", "alice\x1f" "Alice"), "&lt;@1&gt; &lt;@1&gt;");
+
+	/* a name with spaces, and two records */
+	CHECK_STR(M("@Tom Riddle and @Alice", "tom\x1f" "Tom Riddle\x1e" "alice\x1f" "Alice"),
+			"&lt;@4&gt; and &lt;@1&gt;");
+
+	/* longest name first: "@Anna" is not "@Ann" + "a", whatever the record order */
+	CHECK_STR(M("@Ann @Anna", "ann\x1f" "Ann\x1e" "anna\x1f" "Anna"), "&lt;@3&gt; &lt;@2&gt;");
+	CHECK_STR(M("@Anna @Ann", "anna\x1f" "Anna\x1e" "ann\x1f" "Ann"), "&lt;@2&gt; &lt;@3&gt;");
+	/* ... also where the shorter name ends on a word boundary inside the longer one */
+	CHECK_STR(M("@Tom Riddle, @Tom", "t\x1f" "Tom\x1e" "tom\x1f" "Tom Riddle"), "&lt;@4&gt;, &lt;@6&gt;");
+
+	/* word boundaries */
+	CHECK_STR(M("@Annabel", "ann\x1f" "Ann"), "@Annabel");
+	CHECK_STR(M("@Ann_", "ann\x1f" "Ann"), "@Ann_");
+	CHECK_STR(M("me@Ann.example", "ann\x1f" "Ann"), "me@Ann.example");
+	CHECK_STR(M("\xc3\xa9@Ann", "ann\x1f" "Ann"), "\xc3\xa9@Ann");          /* "é@Ann" */
+	CHECK_STR(M("@Ann\xc3\xa9", "ann\x1f" "Ann"), "@Ann\xc3\xa9");          /* "@Anné" */
+	CHECK_STR(M("(@Ann)", "ann\x1f" "Ann"), "(&lt;@3&gt;)");
+	CHECK_STR(M("@Ann's", "ann\x1f" "Ann"), "&lt;@3&gt;'s");
+	CHECK_STR(M("@@Ann", "ann\x1f" "Ann"), "@&lt;@3&gt;");
+
+	/* a name the HTML of the text escaped */
+	CHECK_STR(M("hi @A&amp;E!", "ae\x1f" "A&E"), "hi &lt;@5&gt;!");
+	CHECK_STR(M("hi @A&E!", "ae\x1f" "A&E"), "hi &lt;@5&gt;!");
+
+	/* non-ASCII names */
+	CHECK_STR(M("hey @J\xc3\xbcrgen", "alice\x1f" "J\xc3\xbcrgen"), "hey &lt;@1&gt;");
+
+	/* records left alone: unknown, empty name, no name, empty records */
+	CHECK_STR(M("@Zero @Alice", "zero\x1f" "Zero\x1e" "alice\x1f" "Alice"), "@Zero &lt;@1&gt;");
+	CHECK_STR(M("@ hi", "alice\x1f"), "@ hi");
+	CHECK_STR(M("@Alice", "alice"), "@Alice");
+	CHECK_STR(M("@Alice", "\x1e\x1e" "alice\x1f" "Alice\x1e"), "&lt;@1&gt;");
+	CHECK_STR(M("@Alice", "\x1f" "Alice"), "@Alice");
+
+	/* a name not in the text */
+	CHECK_STR(M("hello", "alice\x1f" "Alice"), "hello");
+
+	/* the resolver sees each usable record once */
+	resolve_calls = 0;
+	g_free(M("@Alice @Tom Riddle", "alice\x1f" "Alice\x1e" "tom\x1f" "Tom Riddle\x1e\x1f" "x"));
+	CHECK(resolve_calls == 3);
+}
+
 int
 main(void)
 {
@@ -120,6 +199,7 @@ main(void)
 	test_urls();
 	test_split_members();
 	test_group_create_body();
+	test_mentions();
 
 	if (failures) {
 		fprintf(stderr, "%d check(s) failed\n", failures);
diff --git a/webos_helpers.c b/webos_helpers.c
index 49b2bd0..7720f4b 100644
--- a/webos_helpers.c
+++ b/webos_helpers.c
@@ -15,6 +15,8 @@
  *   along with this program.  If not, see <https://www.gnu.org/licenses/>.
  */
 
+#include <string.h>
+
 #include "webos_helpers.h"
 
 gboolean
@@ -100,3 +102,134 @@ discord_webos_group_create_body(const guint64 *user_ids, gsize n_ids)
 	g_string_append(body, "]}");
 	return g_string_free(body, FALSE);
 }
+
+typedef struct {
+	gchar *needle;          /* "@name", plain or HTML-escaped */
+	gsize len;
+	guint64 user_id;
+} DiscordWebosMention;
+
+static void
+discord_webos_mention_free(gpointer data)
+{
+	DiscordWebosMention *m = data;
+
+	g_free(m->needle);
+	g_free(m);
+}
+
+static gint
+discord_webos_mention_longest_first(gconstpointer a, gconstpointer b)
+{
+	const DiscordWebosMention *ma = *(const DiscordWebosMention * const *) a;
+	const DiscordWebosMention *mb = *(const DiscordWebosMention * const *) b;
+
+	return (ma->len < mb->len) - (ma->len > mb->len);
+}
+
+/* The characters the HTML of a message would have escaped in a name. */
+static gchar *
+discord_webos_html_escape(const gchar *s)
+{
+	GString *out = g_string_new(NULL);
+
+	for (; *s != '\0'; s++) {
+		switch (*s) {
+			case '&': g_string_append(out, "&amp;"); break;
+			case '<': g_string_append(out, "&lt;"); break;
+			case '>': g_string_append(out, "&gt;"); break;
+			case '"': g_string_append(out, "&quot;"); break;
+			default: g_string_append_c(out, *s); break;
+		}
+	}
+
+	return g_string_free(out, FALSE);
+}
+
+static void
+discord_webos_mention_add(GPtrArray *mentions, gchar *needle, guint64 user_id)
+{
+	DiscordWebosMention *m = g_new0(DiscordWebosMention, 1);
+
+	m->needle = needle;
+	m->len = strlen(needle);
+	m->user_id = user_id;
+	g_ptr_array_add(mentions, m);
+}
+
+/* TRUE if the character at p (inside a NUL-terminated string) is a letter, digit or '_'. */
+static gboolean
+discord_webos_is_word_char(const gchar *p)
+{
+	gunichar c = g_utf8_get_char_validated(p, -1);
+
+	if (c == (gunichar) -1 || c == (gunichar) -2)
+		return FALSE;
+
+	return c == '_' || g_unichar_isalnum(c);
+}
+
+gchar *
+discord_webos_apply_mentions(const gchar *text, const gchar *records,
+		DiscordWebosMentionResolver resolve, gpointer user_data)
+{
+	if (text == NULL)
+		return NULL;
+
+	if (records == NULL || *records == '\0' || resolve == NULL)
+		return g_strdup(text);
+
+	GPtrArray *mentions = g_ptr_array_new_with_free_func(discord_webos_mention_free);
+	gchar **recs = g_strsplit(records, "\x1e", -1);
+
+	for (gchar **r = recs; *r != NULL; r++) {
+		gchar **fields = g_strsplit(*r, "\x1f", 2);
+
+		if (fields[0] != NULL && fields[1] != NULL && *fields[1] != '\0') {
+			guint64 user_id = resolve(fields[0], fields[1], user_data);
+
+			if (user_id != 0) {
+				gchar *escaped = discord_webos_html_escape(fields[1]);
+
+				discord_webos_mention_add(mentions, g_strconcat("@", fields[1], NULL), user_id);
+				if (strcmp(escaped, fields[1]) != 0)
+					discord_webos_mention_add(mentions, g_strconcat("@", escaped, NULL), user_id);
+				g_free(escaped);
+			}
+		}
+
+		g_strfreev(fields);
+	}
+
+	g_strfreev(recs);
+	g_ptr_array_sort(mentions, discord_webos_mention_longest_first);
+
+	GString *out = g_string_sized_new(strlen(text));
+	const gchar *p = text;
+
+	while (*p != '\0') {
+		const DiscordWebosMention *hit = NULL;
+
+		if (*p == '@' && (p == text || !discord_webos_is_word_char(g_utf8_find_prev_char(text, p)))) {
+			for (guint i = 0; i < mentions->len; i++) {
+				const DiscordWebosMention *m = g_ptr_array_index(mentions, i);
+
+				if (strncmp(p, m->needle, m->len) == 0 && !discord_webos_is_word_char(p + m->len)) {
+					hit = m;
+					break;
+				}
+			}
+		}
+
+		if (hit != NULL) {
+			g_string_append_printf(out, "&lt;@%" G_GUINT64_FORMAT "&gt;", hit->user_id);
+			p += hit->len;
+		} else {
+			g_string_append_c(out, *p);
+			p++;
+		}
+	}
+
+	g_ptr_array_free(mentions, TRUE);
+	return g_string_free(out, FALSE);
+}
diff --git a/webos_helpers.h b/webos_helpers.h
index 547f007..efc00f8 100644
--- a/webos_helpers.h
+++ b/webos_helpers.h
@@ -47,4 +47,17 @@ gchar **discord_webos_split_members(const gchar *joined);
  * id. */
 gchar *discord_webos_group_create_body(const guint64 *user_ids, gsize n_ids);
 
+/* Maps a mention record (the id and name the app sent) to a Discord user id, 0 if unknown. */
+typedef guint64 (*DiscordWebosMentionResolver)(const gchar *id, const gchar *name, gpointer user_data);
+
+/* text with each "@<name>" of the mention records turned into a Discord user mention. records is
+ * the "webos-send-mentions" value: "<id>\x1f<name>" records joined by "\x1e". The text is HTML,
+ * as the plug-in's send path takes it, so the mention is written "&lt;@<user id>&gt;", and a name
+ * is also found in its HTML-escaped form. "@<name>" only counts with no letter or digit right
+ * before the "@" or right after the name, and the longest name wins, so "@Ann" is not taken out
+ * of "@Anna" or "me@Ann.example". A record that is malformed or that resolve maps to 0 leaves its
+ * text alone. Returns a new string, or NULL for NULL text. */
+gchar *discord_webos_apply_mentions(const gchar *text, const gchar *records,
+		DiscordWebosMentionResolver resolve, gpointer user_data);
+
 #endif /* DISCORD_WEBOS_HELPERS_H */

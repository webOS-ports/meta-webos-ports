 	/* Create DM if there isn't one */
 	if (room_id == NULL) {
 #if !PURPLE_VERSION_CHECK(3, 0, 0)
-		PurpleMessage *msg = purple_message_new_outgoing(who, message, flags);
+		PurpleMessage *msg = purple_message_new_outgoing(who, mentioned, flags);
+#else

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Thu, 26 Nov 2026 18:12:36 +0100
Subject: [PATCH] webOS: Ask the gateway for fewer events nobody shows

A Q25 with a Discord account hardly slept: the Wi-Fi woke it within
a second of every suspend, and the Discord gateway connection
received about 130 packets a minute, more than any other.

The guild subscriptions (op 14) ask for typing and activities, and
for the first 200 members of each guild's member list, whose status
changes come as GUILD_MEMBER_LIST_UPDATE. The webOS transport shows
none of it: it has no chat typing, and a guild's member list is not a
buddy list.

Ask for no typing and no activities, and by default for one range of
100 members, which is what marks a channel as viewed so that its
messages still come live. "max-guild-presences" still asks for more;
0 or more than 200 behaves as before.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS: the transport shows no guild typing, activities or member lists]
---
 libdiscord.c | 33 ++++++++++++++++++++++++---------
 1 file changed, 24 insertions(+), 9 deletions(-)

diff --git a/libdiscord.c b/libdiscord.c
index 26b9ded..14d5ba6 100644
--- a/libdiscord.c
+++ b/libdiscord.c
@@ -117,6 +117,7 @@
 #define DISCORD_EPOCH_MS 1420070400000
 
 #define DISCORD_MAX_LARGE_THRESHOLD 250
+#define DISCORD_DEFAULT_GUILD_PRESENCES 100
 
 #define DISCORD_MESSAGE_NORMAL (0)
 #define DISCORD_MESSAGE_EDITED (1)
@@ -5049,8 +5050,8 @@ discord_process_dispatch(DiscordAccount *da, const gchar *type, JsonObject *data
 		if (max_synced >= guild->next_mem_to_sync) { // Should always be true for max_synced != 0, but just in case
 			guint member_count = json_object_get_int_member(data, "member_count");
 			guint online_count = json_object_get_int_member(data, "online_count");
-			guint max_count = purple_account_get_int(da->account, "max-guild-presences", 200) > 0 ?
-				(guint)(purple_account_get_int(da->account, "max-guild-presences", 200)-1) :
+			guint max_count = purple_account_get_int(da->account, "max-guild-presences", DISCORD_DEFAULT_GUILD_PRESENCES) > 0 ?
+				(guint)(purple_account_get_int(da->account, "max-guild-presences", DISCORD_DEFAULT_GUILD_PRESENCES)-1) :
 				G_MAXUINT;
 			guint head_count = member_count > DISCORD_MAX_LARGE_THRESHOLD ? MIN(max_count, online_count) : MIN(max_count, member_count);
 			if (guild && (head_count > guild->next_mem_to_sync)) {
@@ -6611,6 +6612,20 @@ discord_populate_guild(DiscordAccount *da, JsonObject *guild)
 	}
 }
 
+/* webOS: every member in a guild's subscribed member list sends an update each time its
+ * status changes, and each update wakes a suspended phone. One range of 100 is what marks the
+ * channel as viewed, so that is the default; "max-guild-presences" still asks for more. */
+static guint
+discord_member_list_size(DiscordAccount *da)
+{
+	gint max = purple_account_get_int(da->account, "max-guild-presences", DISCORD_DEFAULT_GUILD_PRESENCES);
+
+	if (max <= 0 || max > 200) {
+		return 200;
+	}
+	return MAX(100, (guint) (max + 99) / 100 * 100);
+}
+
 static void
 discord_send_lazy_guild_request(DiscordAccount *da, DiscordGuild *guild)
 {
@@ -6623,8 +6638,8 @@ discord_send_lazy_guild_request(DiscordAccount *da, DiscordGuild *guild)
 
 	d = json_object_new();
 	json_object_set_string_member(d, "guild_id", guild_id);
-	json_object_set_boolean_member(d, "typing", TRUE);
-	json_object_set_boolean_member(d, "activities", TRUE);
+	json_object_set_boolean_member(d, "typing", FALSE);
+	json_object_set_boolean_member(d, "activities", FALSE);
 	json_object_set_boolean_member(d, "threads", TRUE);
 	json_object_set_array_member(d, "members", json_array_new());
 
@@ -6668,7 +6683,7 @@ discord_send_lazy_guild_request(DiscordAccount *da, DiscordGuild *guild)
 			json_array_add_int_element(user_range, 99);
 			json_array_add_array_element(user_ranges, user_range);
 		}
-		for (guint i = last_synced; i < 200 + last_synced; i += 100) {
+		for (guint i = last_synced; i < discord_member_list_size(da) + last_synced; i += 100) {
 			JsonArray *user_range = json_array_new();
 			json_array_add_int_element(user_range, i);
 			json_array_add_int_element(user_range, i + 99);
@@ -6690,7 +6705,7 @@ discord_send_lazy_guild_request(DiscordAccount *da, DiscordGuild *guild)
 
 	json_object_unref(obj);
 
-	guild->next_mem_to_sync = 200 + last_synced;
+	guild->next_mem_to_sync = discord_member_list_size(da) + last_synced;
 
 	g_free(guild_id);
 }
@@ -6710,9 +6725,9 @@ discord_subscribe_channel(DiscordAccount *da, DiscordGuild *guild, guint64 chann
 	gchar *channel_id_s = from_int(channel_id);
 
 	json_object_set_string_member(d, "guild_id", guild_id_s);
-	json_object_set_boolean_member(d, "typing", TRUE);
+	json_object_set_boolean_member(d, "typing", FALSE);
 	json_object_set_boolean_member(d, "threads", TRUE);
-	json_object_set_boolean_member(d, "activities", TRUE);
+	json_object_set_boolean_member(d, "activities", FALSE);
 	json_object_set_array_member(d, "members", json_array_new());
 
 	/* one member range (0-99) is enough to register the channel as "viewed" */
@@ -11736,7 +11751,7 @@ discord_add_account_options(GList *account_options)
 	option = purple_account_option_bool_new(_("Display stickers in conversations"), "display-stickers", purple_strequal(purple_core_get_ui(), "gtk-gaim"));
 	account_options = g_list_append(account_options, option);
 
-	option = purple_account_option_int_new(_("Approximate max number of users to keep track of, per server (0 disables)"), "max-guild-presences", 200);
+	option = purple_account_option_int_new(_("Approximate max number of users to keep track of, per server (0 disables)"), "max-guild-presences", DISCORD_DEFAULT_GUILD_PRESENCES);
 	account_options = g_list_append(account_options, option);
 
 	option = purple_account_option_bool_new(_("Fetch names for reactors to backlogged messages (can be spammy)"), "fetch-react-backlog", FALSE);
-- 

 					purple_conversation_write_message(conv, msg);
@@ -3498,6 +3634,13 @@ discord_process_message(DiscordAccount *da, JsonObject *data, unsigned special_t
 			}
 
 			if (escaped_content && *escaped_content && msg_type != MESSAGE_CALL) {

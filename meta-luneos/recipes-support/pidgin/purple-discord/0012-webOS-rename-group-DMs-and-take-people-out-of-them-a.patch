+{
+	DiscordWebosGroupAdd *add = user_data;
+	JsonObject *result = (node != NULL && JSON_NODE_HOLDS_OBJECT(node)) ? json_node_get_object(node) : NULL;
+	const gchar *message = result ? json_object_get_string_member(result, "message") : NULL;
+	gint64 code = result ? json_object_get_int_member(result, "code") : 0;
+	gchar *notice = discord_webos_add_refused_notice(add->who, code, message);
+
+	if (notice != NULL) {
+		purple_debug_error("discord", "webos group add to %" G_GUINT64_FORMAT " refused: %lld %s\n",
+				add->room_id, (long long) code, message ? message : "(no message)");
+		if (purple_account_is_connected(da->account))
+			discord_webos_group_notice(da, add->room_id, notice);
+		g_free(notice);
+	}
+	g_free(add);
+}

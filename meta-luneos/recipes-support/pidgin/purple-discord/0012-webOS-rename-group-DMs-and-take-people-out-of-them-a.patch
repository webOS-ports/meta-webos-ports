+/* ---- running ---- */
+
+static void
+setup(const char *name)
+{
+	current_test = name;
+	debug_log = g_string_new(NULL);
+	notices = g_string_new(NULL);
+	open_convs = g_ptr_array_new_with_free_func(free_conv);
+	made_users = g_ptr_array_new_with_free_func(free_made_user);
+	joined = 0;
+	refuse_join = 0;
+	group.recipients = NULL;
+	stashed = g_string_new(NULL);
+	account.received_message_ids = NULL;
+	opened = 0;
+	memset(&fetch, 0, sizeof(fetch));
+	fetch.all = g_string_new(NULL);
+	fetch.pending = g_ptr_array_new();
+	renamed_to = NULL;
+	ours.connected = 1;
+	account.account = &ours;
+	account.pc = &connection;
+	account.group_dms = g_hash_table_new(g_int64_hash, g_int64_equal);
+	account.self_user_id = 99;
+	account.new_users = g_hash_table_new(g_int64_hash, g_int64_equal);
+	g_hash_table_insert(account.group_dms, &group.id, &group);
+}
+
+static void
+teardown(void)
+{
+	g_free(fetch.method);
+	g_free(fetch.url);
+	g_free(fetch.postdata);
+	/* what the test did not answer (the callbacks own what they were given) */
+	g_ptr_array_set_free_func(fetch.pending, g_free);
+	g_ptr_array_free(fetch.pending, TRUE);
+	g_string_free(fetch.all, TRUE);
+	g_free(renamed_to);
+	g_hash_table_destroy(account.group_dms);
+	g_hash_table_destroy(account.new_users);
+	g_list_free_full(group.recipients, g_free);
+	group.recipients = NULL;
+	g_ptr_array_free(made_users, TRUE);
+	g_string_free(stashed, TRUE);
+	if (account.received_message_ids != NULL)
+		g_hash_table_destroy(account.received_message_ids);
+	g_ptr_array_free(open_convs, TRUE);
+	g_string_free(debug_log, TRUE);
+	g_string_free(notices, TRUE);
+}
+
+/* Answers the request made, with a JSON body */
+static void
+answer(const gchar *json)
+{
+	JsonParser *parser = json_parser_new();
+	JsonNode *root = NULL;
+
+	if (json != NULL) {
+		g_assert(json_parser_load_from_data(parser, json, -1, NULL));
+		root = json_parser_get_root(parser);
+	}
+	g_assert(g_ptr_array_remove(fetch.pending, fetch.user_data));	/* the callback owns it */
+	fetch.callback(&account, root, fetch.user_data);
+	fetch.user_data = NULL;
+	g_object_unref(parser);
+}

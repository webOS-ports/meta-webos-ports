+/* webOS: Discord's error code for adding someone to a group DM who is not one of the user's friends
+ * (its message says "Cannot send messages to this user"). */
+#define DISCORD_WEBOS_NOT_A_FRIEND 50007
+
+/* webOS: one person being added to a group DM, for discord_webos_group_member_added_cb: the group
+ * and the person as the user picked them. One allocation, freed with g_free. */
+typedef struct {
+	guint64 room_id;
+	gchar who[];
+} DiscordWebosGroupAdd;
+
+/* webOS: the line written in a group DM when who (as the user picked them) could not be added
+ * because the plug-in does not know them: Discord adds people by their id, and the plug-in knows
+ * the ids of its friends and of the people in its servers and chats only. HTML, as the chat's lines
+ * are. */
+static gchar *
+discord_webos_add_unknown_notice(const gchar *who)
+{
+	gchar *name = purple_markup_escape_text(who ? who : "", -1);
+	gchar *notice = g_strdup_printf(_("Could not add %s: Discord does not know them here. Only your Discord friends can be added to a group."), name);
+
+	g_free(name);
+	return notice;
+}
+
+/* webOS: the line written in a group DM when Discord refused to add who, from its answer's error
+ * code and message; NULL when the answer is no refusal (Discord adds with 204 No Content). 50007 is
+ * Discord's refusal for someone who is not a friend; any other is told in Discord's own words. HTML,
+ * as the chat's lines are. */
+static gchar *
+discord_webos_add_refused_notice(const gchar *who, gint64 code, const gchar *message)
+{
+	if (code == 0 && message == NULL)
+		return NULL;
+
+	gchar *name = purple_markup_escape_text(who ? who : "", -1);
+	gchar *notice;
+
+	if (code == DISCORD_WEBOS_NOT_A_FRIEND) {
+		notice = g_strdup_printf(_("Could not add %s: Discord lets you add only your friends to a group."), name);
+	} else if (message != NULL && *message != '\0') {
+		gchar *why = purple_markup_escape_text(message, -1);
+		notice = g_strdup_printf(_("Could not add %s: %s"), name, why);
+		g_free(why);
+	} else {
+		notice = g_strdup_printf(_("Could not add %s: Discord refused it (error %lld)."), name, (long long) code);
+	}
+
+	g_free(name);
+	return notice;
+}

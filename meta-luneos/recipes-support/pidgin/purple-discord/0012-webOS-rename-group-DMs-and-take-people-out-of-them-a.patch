+	/* quotes and the like go out as JSON */
+	setup("rename with quotes");
+	CHECK(discord_webos_group_rename_cb(&ours, "1001", "\"Ann's\" \\ group", NULL));
+	CHECK(g_strcmp0(fetch.postdata, "{\"name\":\"\\\"Ann's\\\" \\\\ group\"}") == 0);
+	teardown();
+}

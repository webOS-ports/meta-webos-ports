+static void
+free_conv(gpointer p)
+{
+	PurpleChatConversation *c = p;
+	g_free(c->title);
+	g_free(c->nick);
+	g_free(c->data_id);
+	if (c->users != NULL)
+		g_string_free(c->users, TRUE);
+	g_free(c);
+}
+
+static DiscordUser *
+discord_get_user_fullname(DiscordAccount *da, const gchar *name)
+{
+	(void) da;
+	for (guint i = 0; i < G_N_ELEMENTS(users); i++) {
+		if (g_strcmp0(users[i].name, name) == 0)
+			return &users[i];
+	}
+	return NULL;
+}

+/* nothing but the conversation: no request, no line, no log */
+#define CHECK_QUIET() do { \
+	CHECK(notices->len == 0); \
+	CHECK(opened == 0); \
+} while (0)
+
+static void
+test_chat_open_known(void)
+{
+	setup("chat open, people known");
+	group.recipients = ids(11, 12);
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	CHECK(joined == 1);
+	PurpleChatConversation *c = conv(1001);
+	CHECK(c != NULL);
+	CHECK(c != NULL && c->data_id != NULL && *c->data_id == 1001);
+	CHECK(c != NULL && g_strcmp0(c->title, "ann, bob") == 0);
+	CHECK(c != NULL && g_strcmp0(c->nick, "me") == 0);
+	CHECK(c != NULL && c->users != NULL && strcmp(c->users->str, "me,ann,bob,") == 0);
+	CHECK(fetch.count == 0);	/* no history, no channel info, nothing at all */
+	CHECK(debug_log->len == 0);
+	CHECK_QUIET();
+
+	/* asked again: it is open, so nothing more is done */
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	CHECK(joined == 1);
+	CHECK(c != NULL && c->cleared == 1);
+	CHECK(fetch.count == 0);
+	teardown();
+
+	/* left: opened again */
+	setup("chat open, left");
+	group.recipients = ids(11, 0);
+	g_ptr_array_add(open_convs, g_memdup2(&(PurpleChatConversation) { .id = 1001, .left = 1 }, sizeof(PurpleChatConversation)));
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	CHECK(joined == 1);
+	teardown();
+}

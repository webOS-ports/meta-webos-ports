+static void
+test_remove(void)
+{
+	setup("remove");
+	CHECK(discord_webos_group_remove_cb(&ours, "1001", "ann\x1f" "bob", NULL));
+	CHECK(fetch.count == 2);
+	CHECK(g_strcmp0(fetch.all->str,
+			"DELETE https://discord.com/api/v9/channels/1001/recipients/11\n"
+			"DELETE https://discord.com/api/v9/channels/1001/recipients/12\n") == 0);
+	CHECK(fetch.postdata == NULL);
+	CHECK(fetch.callback == discord_webos_group_member_removed_cb);
+	CHECK(fetch.pending->len == 2);
+	for (guint i = 0; i < fetch.pending->len; i++)
+		CHECK(*(guint64 *) g_ptr_array_index(fetch.pending, i) == 1001);
+
+	/* done: Discord answers with nothing, and the gateway's CHANNEL_RECIPIENT_REMOVE follows */
+	answer(NULL);
+	CHECK(notices->len == 0);
+	CHECK(debug_log->len == 0);
+	teardown();
+
+	/* a member the plug-in does not know is skipped, the others are taken out */
+	setup("remove with an unknown member");
+	CHECK(discord_webos_group_remove_cb(&ours, "1001", "nobody\x1f" "\x1f" "bob", NULL));
+	CHECK(g_strcmp0(fetch.all->str, "DELETE https://discord.com/api/v9/channels/1001/recipients/12\n") == 0);
+	CHECK(strstr(debug_log->str, "unknown member nobody") != NULL);
+	teardown();
+
+	/* the user is not taken out: leaving is "webos-im-group-leave" */
+	setup("remove the user");
+	CHECK(!discord_webos_group_remove_cb(&ours, "1001", "me", NULL));
+	CHECK(discord_webos_group_remove_cb(&ours, "1001", "me\x1f" "ann", NULL));
+	CHECK(g_strcmp0(fetch.all->str, "DELETE https://discord.com/api/v9/channels/1001/recipients/11\n") == 0);
+	teardown();
+}

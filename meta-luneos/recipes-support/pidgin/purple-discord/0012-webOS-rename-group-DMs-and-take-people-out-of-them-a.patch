+	group.recipients = ids(11, 55);	/* 55 is not known */
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	PurpleChatConversation *c = conv(1001);
+	CHECK(c != NULL && c->users == NULL);	/* no one put on it yet */
+	CHECK(fetch.count == 1);
+	CHECK(g_strcmp0(fetch.method, "GET") == 0);
+	CHECK(g_strcmp0(fetch.url, "https://discord.com/api/v9/channels/1001") == 0);
+	CHECK(fetch.postdata == NULL);
+	CHECK(fetch.callback == discord_webos_chat_open_members_cb);
+
+	answer("{\"id\":\"1001\",\"type\":3,\"last_pin_timestamp\":\"2030-01-01T00:00:00+00:00\",\"topic\":\"t\","
+			"\"recipients\":[{\"id\":\"11\",\"username\":\"ann\"},{\"id\":\"55\",\"username\":\"cat\"},{\"username\":\"noid\"}]}");
+	CHECK(c != NULL && c->users != NULL && strcmp(c->users->str, "me,ann,cat,") == 0);
+	CHECK(c != NULL && g_strcmp0(c->nick, "me") == 0);
+	CHECK(fetch.count == 1);
+	CHECK_QUIET();	/* no pins line, though the channel has pins newer than anything shown */
+	teardown();
+
+	/* nothing kept: asked of Discord too */
+	setup("chat open, no recipients kept");
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	CHECK(fetch.count == 1);
+	CHECK(g_strcmp0(fetch.url, "https://discord.com/api/v9/channels/1001") == 0);
+	teardown();
+
+	setup("chat open, refused");
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	answer("{\"message\":\"Missing Access\",\"code\":50001}");
+	CHECK(conv(1001) != NULL && conv(1001)->users == NULL);
+	CHECK(strstr(debug_log->str, "no members for 1001: Missing Access") != NULL);
+	CHECK_QUIET();
+	teardown();
+
+	/* the conversation went away before the answer: nothing to put them on */
+	setup("chat open, closed meanwhile");
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	g_ptr_array_set_size(open_convs, 0);
+	answer("{\"id\":\"1001\",\"recipients\":[{\"id\":\"55\",\"username\":\"cat\"}]}");
+	CHECK(open_convs->len == 0);
+	teardown();
+}
+
+static void
+test_chat_open_not_taken(void)
+{
+	setup("chat open not taken");
+	group.recipients = ids(11, 12);
+	CHECK(!discord_webos_chat_open_cb(&theirs, "1001", NULL));	/* not our account */
+	CHECK(!discord_webos_chat_open_cb(NULL, "1001", NULL));
+	CHECK(!discord_webos_chat_open_cb(&ours, "2002", NULL));	/* a server channel */
+	CHECK(!discord_webos_chat_open_cb(&ours, "not-a-chat", NULL));
+	CHECK(!discord_webos_chat_open_cb(&ours, NULL, NULL));
+	refuse_join = 1;	/* libpurple makes no conversation: not opened */
+	CHECK(!discord_webos_chat_open_cb(&ours, "1001", NULL));
+	refuse_join = 0;
+	CHECK(joined == 0);
+	CHECK(open_convs->len == 0);
+	CHECK(fetch.count == 0);
+	CHECK_QUIET();
+	teardown();
+}
+
+/* A message from Discord as discord_process_message takes it: dedup by id, then the event line */
+static gboolean
+deliver(DiscordChannel *channel, const gchar *json)
+{
+	JsonParser *parser = json_parser_new();
+	g_assert(json_parser_load_from_data(parser, json, -1, NULL));
+	JsonObject *data = json_node_get_object(json_parser_get_root(parser));
+	guint64 msg_id = to_int(json_object_get_string_member(data, "id"));
+	gboolean event = FALSE;
+
+	if (!discord_webos_message_seen(&account, msg_id))
+		event = discord_webos_group_event(&account, channel, (PurpleConversation *) conv(channel->id),
+				(guint64) json_object_get_int_member(data, "type"), msg_id, data, 1700000000);
+	g_object_unref(parser);
+	return event;
+}
+
+static void
+open_group(void)
+{
+	g_ptr_array_add(open_convs, g_memdup2(&(PurpleChatConversation) { .id = 1001 }, sizeof(PurpleChatConversation)));
+}
+
+#define ANN "{\"id\":\"11\",\"username\":\"ann\"}"
+#define BOB "{\"id\":\"12\",\"username\":\"bob\"}"
+#define ME "{\"id\":\"99\",\"username\":\"me\"}"
+#define MSG(id, type, author, rest) "{\"id\":\"" id "\",\"type\":" #type ",\"channel_id\":\"1001\",\"author\":" author rest "}"
+
+static void
+test_event_rename(void)
+{
+	setup("event: renamed by someone else");
+	open_group();
+	CHECK(deliver(&group, MSG("2001", 4, ANN, ",\"content\":\"Trip <to> Rome & co\"")));
+	CHECK(g_strcmp0(notices->str, "1001: ann changed the group name to \"Trip &lt;to&gt; Rome &amp; co\"\n") == 0);
+	CHECK(g_strcmp0(stashed->str, "2001,") == 0);
+	teardown();
+
+	setup("event: renamed by us");
+	open_group();
+	CHECK(deliver(&group, MSG("2002", 4, ME, ",\"content\":\"Trip\"")));
+	CHECK(g_strcmp0(notices->str, "1001: You changed the group name to \"Trip\"\n") == 0);
+	teardown();
+}
+
+static void
+test_event_add_remove(void)
+{
+	setup("event: added");
+	open_group();
+	CHECK(deliver(&group, MSG("2101", 1, ANN, ",\"content\":\"\",\"mentions\":[" BOB "]")));
+	CHECK(deliver(&group, MSG("2102", 1, ME, ",\"content\":\"\",\"mentions\":[" BOB "]")));
+	CHECK(deliver(&group, MSG("2103", 1, ANN, ",\"content\":\"\",\"mentions\":[" ME "]")));
+	CHECK(deliver(&group, MSG("2104", 1, ANN, ",\"mentions\":[{\"id\":\"13\",\"username\":\"<i>cat</i>\"}]")));
+	/* the one added is the first named */
+	CHECK(deliver(&group, MSG("2105", 1, ANN, ",\"mentions\":[" BOB "," ME "]")));
+	CHECK(g_strcmp0(notices->str,
+			"1001: ann added bob\n"
+			"1001: You added bob\n"
+			"1001: ann added you\n"
+			"1001: ann added &lt;i&gt;cat&lt;/i&gt;\n"
+			"1001: ann added bob\n") == 0);
+	CHECK(g_strcmp0(stashed->str, "2101,2102,2103,2104,2105,") == 0);
+	teardown();
+
+	setup("event: removed");
+	open_group();
+	CHECK(deliver(&group, MSG("2201", 2, ANN, ",\"content\":\"\",\"mentions\":[" BOB "]")));
+	CHECK(deliver(&group, MSG("2202", 2, ME, ",\"content\":\"\",\"mentions\":[" BOB "]")));
+	CHECK(deliver(&group, MSG("2203", 2, ANN, ",\"content\":\"\",\"mentions\":[" ME "]")));
+	CHECK(g_strcmp0(notices->str,
+			"1001: ann removed bob\n"
+			"1001: You removed bob\n"
+			"1001: ann removed you\n") == 0);
+	teardown();
+
+	setup("event: left");
+	open_group();
+	CHECK(deliver(&group, MSG("2301", 2, BOB, ",\"content\":\"\",\"mentions\":[" BOB "]")));
+	CHECK(deliver(&group, MSG("2302", 2, ME, ",\"content\":\"\",\"mentions\":[" ME "]")));
+	CHECK(g_strcmp0(notices->str, "1001: bob left the group\n1001: You left the group\n") == 0);
+	teardown();
+}
+
+static void
+test_event_once(void)
+{
+	/* history replayed: the same message again writes nothing */
+	setup("event: replayed");
+	open_group();
+	CHECK(deliver(&group, MSG("2401", 1, ANN, ",\"mentions\":[" BOB "]")));
+	CHECK(!deliver(&group, MSG("2401", 1, ANN, ",\"mentions\":[" BOB "]")));
+	CHECK(g_strcmp0(notices->str, "1001: ann added bob\n") == 0);
+	teardown();
+
+	/* the group not open: nothing written, and the message is not marked, so it is written when
+	 * the group's history brings it once it is open */
+	/* the group not open: opened for its people alone and the line written at once */
+	setup("event: group not open");
+	group.recipients = ids(11, 12);
+	CHECK(deliver(&group, MSG("2501", 1, ANN, ",\"mentions\":[" BOB "]")));
+	CHECK(joined == 1);
+	CHECK(conv(1001) != NULL && conv(1001)->users != NULL && strcmp(conv(1001)->users->str, "me,ann,bob,") == 0);
+	CHECK(g_strcmp0(notices->str, "1001: ann added bob\n") == 0);
+	CHECK(g_strcmp0(stashed->str, "2501,") == 0);
+	CHECK(fetch.count == 0);	/* no history, nothing asked of Discord */
+	CHECK(opened == 0);	/* not discord_open_chat */
+	/* the history's copy later writes nothing more, nor does a second event open it again */
+	CHECK(!deliver(&group, MSG("2501", 1, ANN, ",\"mentions\":[" BOB "]")));
+	CHECK(deliver(&group, MSG("2502", 2, ANN, ",\"mentions\":[" BOB "]")));
+	CHECK(joined == 1);
+	CHECK(g_strcmp0(notices->str, "1001: ann added bob\n1001: ann removed bob\n") == 0);
+	teardown();
+
+	/* someone not known: their names are asked of Discord (the channel, never its messages) */
+	setup("event: group not open, someone not known");
+	CHECK(deliver(&group, MSG("2511", 4, ANN, ",\"content\":\"Trip\"")));
+	CHECK(g_strcmp0(notices->str, "1001: ann changed the group name to \"Trip\"\n") == 0);
+	CHECK(fetch.count == 1);
+	CHECK(g_strcmp0(fetch.method, "GET") == 0);
+	CHECK(g_strcmp0(fetch.url, "https://discord.com/api/v9/channels/1001") == 0);
+	teardown();
+
+	/* libpurple made no conversation: not written, and not marked, so a later delivery writes it */
+	setup("event: no conversation made");
+	group.recipients = ids(11, 12);
+	refuse_join = 1;
+	CHECK(deliver(&group, MSG("2521", 4, ANN, ",\"content\":\"Trip\"")));
+	CHECK(notices->len == 0);
+	CHECK(stashed->len == 0);
+	refuse_join = 0;
+	CHECK(deliver(&group, MSG("2521", 4, ANN, ",\"content\":\"Trip\"")));
+	CHECK(g_strcmp0(notices->str, "1001: ann changed the group name to \"Trip\"\n") == 0);
+	teardown();
+}
+
+static void
+test_recipients_kept(void)
+{
+	setup("recipients kept");
+	group.recipients = ids(11, 0);
+	discord_webos_group_dm_recipient(&group, 12, TRUE);
+	discord_webos_group_dm_recipient(&group, 12, TRUE);	/* twice: once */
+	CHECK(g_list_length(group.recipients) == 2);
+	discord_webos_group_dm_recipient(&group, 11, FALSE);
+	discord_webos_group_dm_recipient(&group, 13, FALSE);	/* not there: nothing */
+	CHECK(g_list_length(group.recipients) == 1);
+	CHECK(group.recipients != NULL && *(guint64 *) group.recipients->data == 12);
+
+	/* the group opened afterwards has who is in it now */
+	CHECK(discord_webos_chat_open_cb(&ours, "1001", NULL));
+	CHECK(conv(1001) != NULL && conv(1001)->users != NULL && strcmp(conv(1001)->users->str, "me,bob,") == 0);
+	CHECK(fetch.count == 0);
+	discord_webos_group_dm_recipient(&group, 12, FALSE);
+	CHECK(group.recipients == NULL);
+	teardown();
+}
+
+static void
+test_event_not(void)
+{
+	setup("event: not one");
+	open_group();
+	g_ptr_array_add(open_convs, g_memdup2(&(PurpleChatConversation) { .id = 3003 }, sizeof(PurpleChatConversation)));
+	CHECK(!deliver(&group, MSG("2601", 0, ANN, ",\"content\":\"hello\"")));	/* a message */
+	CHECK(!deliver(&group, MSG("2602", 3, ANN, ",\"content\":\"\"")));	/* a call */
+	CHECK(!deliver(&server_channel, MSG("2603", 4, ANN, ",\"content\":\"general-2\"")));	/* a server channel */
+	CHECK(!deliver(&server_channel, MSG("2604", 1, ANN, ",\"mentions\":[" BOB "]")));
+	CHECK(!deliver(&group, MSG("2605", 1, ANN, ",\"mentions\":[]")));	/* no one named */
+	CHECK(!deliver(&group, MSG("2606", 2, ANN, "")));
+	/* a message or a reply that mentions someone is no event */
+	CHECK(!deliver(&group, MSG("2607", 0, ANN, ",\"content\":\"hi <@12>\",\"mentions\":[" BOB "]")));
+	CHECK(!deliver(&group, MSG("2608", 19, ANN, ",\"content\":\"yes\",\"mentions\":[" BOB "]")));
+	CHECK(notices->len == 0);
+	CHECK(stashed->len == 0);
+	teardown();
+}
+
+int
+main(void)
+{
+	test_rename();
+	test_not_taken();
+	test_too_long();
+	test_refused();
+	test_remove();
+	test_remove_not_taken();
+	test_remove_refused();
+	test_add();
+	test_add_unknown();
+	test_add_refused();
+	test_add_notices();
+	test_chat_open_known();
+	test_chat_open_fetched();
+	test_chat_open_not_taken();
+	test_event_rename();
+	test_event_add_remove();
+	test_event_once();
+	test_event_not();
+	test_recipients_kept();
+
+	if (failures) {
+		fprintf(stderr, "%d failure(s)\n", failures);
+		return 1;
+	}
+	printf("all group rename, remove, add, chat open and event line tests passed\n");
+	return 0;
+}
diff --git a/tests/test_user_flags.c b/tests/test_user_flags.c
new file mode 100644
index 0000000..eb4d197
--- /dev/null
+++ b/tests/test_user_flags.c
@@ -0,0 +1,250 @@
+/*
+ *   Unit tests for a user's flags in a chat (discord_get_user_flags): the part of libdiscord.c
+ *   between its BEGIN and END user flags lines, which the Makefile copies into user_flags.inc.
+ *   This file stands in for the plug-in's types around it. A group DM has no guild, so someone
+ *   added to an open group DM (CHANNEL_RECIPIENT_ADD) is looked up with a NULL one.
+ *
+ *   This program is free software: you can redistribute it and/or modify
+ *   it under the terms of the GNU General Public License as published by
+ *   the Free Software Foundation, either version 3 of the License, or
+ *   (at your option) any later version.
+ */
+
+#include <stdio.h>
+
+#include <glib.h>
+
+static int failures;
+static const char *current_test = "";
+
+#define CHECK(cond) do { \
+	if (!(cond)) { \
+		fprintf(stderr, "%s:%d: %s: CHECK failed: %s\n", __FILE__, __LINE__, current_test, #cond); \
+		failures++; \
+	} \
+} while (0)
+
+/* ---- what the user flags part needs from libpurple and the rest of the plug-in ---- */
+
+typedef enum {
+	PURPLE_CHAT_USER_NONE = 0x0000,
+	PURPLE_CHAT_USER_VOICE = 0x0001,
+	PURPLE_CHAT_USER_HALFOP = 0x0002,
+	PURPLE_CHAT_USER_OP = 0x0004,
+} PurpleChatUserFlags;
+
+enum {
+	PERM_KICK_MEMBERS = 0x2,
+	PERM_BAN_MEMBERS = 0x4,
+	PERM_ADMINISTRATOR = 0x8,
+};
+
+/* as json_compat.h has them */
+#define g_hash_table_replace_int64(a, b, c) g_hash_table_replace((a), &(b), (c))
+#define g_hash_table_lookup_int64(a, b) g_hash_table_lookup((a), &(b))
+
+/* The fields of libdiscord.c's types that the part uses */
+typedef struct { int unused; } DiscordAccount;
+
+typedef struct {
+	guint64 id;
+	gint64 permissions;
+} DiscordGuildRole;
+
+typedef struct {
+	guint64 id;
+	GHashTable *roles;	/* id -> DiscordGuildRole */
+} DiscordGuild;
+
+typedef struct {
+	guint64 id;
+	GArray *roles;	/* guint64 role ids */
+} DiscordGuildMembership;
+
+typedef struct {
+	guint64 id;
+	GHashTable *guild_memberships;	/* guild id -> DiscordGuildMembership */
+	gboolean bot;
+} DiscordUser;
+
+PurpleChatUserFlags discord_get_user_flags(DiscordAccount *da, DiscordGuild *guild, DiscordUser *user);
+
+/* the part takes the account, as its callers pass it, and does not use it */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+#include "user_flags.inc"
+#pragma GCC diagnostic pop
+
+/* ---- fixtures ---- */
+
+static DiscordAccount account;
+
+static void
+free_membership(gpointer p)
+{
+	DiscordGuildMembership *m = p;
+
+	g_array_unref(m->roles);
+	g_free(m);
+}
+
+static DiscordUser *
+user_new(guint64 id, gboolean bot)
+{
+	DiscordUser *user = g_new0(DiscordUser, 1);
+
+	user->id = id;
+	user->bot = bot;
+	user->guild_memberships = g_hash_table_new_full(g_int64_hash, g_int64_equal, NULL, free_membership);
+	return user;
+}
+
+static void
+user_free(DiscordUser *user)
+{
+	g_hash_table_unref(user->guild_memberships);
+	g_free(user);
+}
+
+static DiscordGuild *
+guild_new(guint64 id)
+{
+	DiscordGuild *guild = g_new0(DiscordGuild, 1);
+
+	guild->id = id;
+	guild->roles = g_hash_table_new_full(g_int64_hash, g_int64_equal, NULL, g_free);
+	return guild;
+}
+
+static void
+guild_free(DiscordGuild *guild)
+{
+	g_hash_table_unref(guild->roles);
+	g_free(guild);
+}
+
+static void
+guild_add_role(DiscordGuild *guild, guint64 id, gint64 permissions)
+{
+	DiscordGuildRole *role = g_new0(DiscordGuildRole, 1);
+
+	role->id = id;
+	role->permissions = permissions;
+	g_hash_table_replace_int64(guild->roles, role->id, role);
+}
+
+/* user is in guild with the given roles */
+static void
+user_join(DiscordUser *user, const DiscordGuild *guild, const guint64 *roles, guint n)
+{
+	DiscordGuildMembership *m = g_new0(DiscordGuildMembership, 1);
+
+	m->id = guild->id;
+	m->roles = g_array_new(TRUE, TRUE, sizeof(guint64));
+	g_array_append_vals(m->roles, roles, n);
+	g_hash_table_replace_int64(user->guild_memberships, m->id, m);
+}
+
+/* ---- tests ---- */
+
+/* someone added to an open group DM: CHANNEL_RECIPIENT_ADD has no guild for it */
+static void
+test_group_dm(void)
+{
+	current_test = "group DM";
+	DiscordUser *person = user_new(1001, FALSE);
+	DiscordUser *bot = user_new(1002, TRUE);
+
+	CHECK(discord_get_user_flags(&account, NULL, person) == PURPLE_CHAT_USER_NONE);
+	CHECK(discord_get_user_flags(&account, NULL, bot) == PURPLE_CHAT_USER_VOICE);
+
+	/* a user who is in a server still gets no role flags without one */
+	DiscordGuild *guild = guild_new(2001);
+	guild_add_role(guild, 3001, PERM_ADMINISTRATOR);
+	const guint64 admin[] = { 3001 };
+	user_join(person, guild, admin, G_N_ELEMENTS(admin));
+	CHECK(discord_get_user_flags(&account, NULL, person) == PURPLE_CHAT_USER_NONE);
+
+	guild_free(guild);
+	user_free(bot);
+	user_free(person);
+}
+
+static void
+test_no_user(void)
+{
+	current_test = "no user";
+	DiscordGuild *guild = guild_new(2001);
+
+	CHECK(discord_get_user_flags(&account, guild, NULL) == PURPLE_CHAT_USER_NONE);
+	CHECK(discord_get_user_flags(&account, NULL, NULL) == PURPLE_CHAT_USER_NONE);
+	guild_free(guild);
+}
+
+/* in a server, the best of the user's roles; a role the server does not know counts for nothing */
+static void
+test_guild_roles(void)
+{
+	current_test = "guild roles";
+	DiscordGuild *guild = guild_new(2001);
+	DiscordGuild *other = guild_new(2002);
+	guild_add_role(guild, 3001, PERM_ADMINISTRATOR);
+	guild_add_role(guild, 3002, PERM_KICK_MEMBERS);
+	guild_add_role(guild, 3003, PERM_BAN_MEMBERS);
+	guild_add_role(guild, 3004, 0x1);
+
+	DiscordUser *stranger = user_new(1001, FALSE);
+	DiscordUser *bot = user_new(1002, TRUE);
+	DiscordUser *member = user_new(1003, FALSE);
+	DiscordUser *kicker = user_new(1004, FALSE);
+	DiscordUser *banner = user_new(1005, FALSE);
+	DiscordUser *admin = user_new(1006, FALSE);
+	DiscordUser *bot_admin = user_new(1007, TRUE);
+
+	const guint64 plain[] = { 3004, 9999 };
+	const guint64 kick[] = { 3004, 3002 };
+	const guint64 ban[] = { 3003 };
+	const guint64 all[] = { 3002, 3001, 3003 };
+	const guint64 none[] = { 0 };
+
+	user_join(bot, guild, none, 0);
+	user_join(member, guild, plain, G_N_ELEMENTS(plain));
+	user_join(kicker, guild, kick, G_N_ELEMENTS(kick));
+	user_join(banner, guild, ban, G_N_ELEMENTS(ban));
+	user_join(admin, guild, all, G_N_ELEMENTS(all));
+	user_join(bot_admin, guild, all, G_N_ELEMENTS(all));
+	user_join(stranger, other, all, G_N_ELEMENTS(all));
+
+	CHECK(discord_get_user_flags(&account, guild, stranger) == PURPLE_CHAT_USER_NONE);
+	CHECK(discord_get_user_flags(&account, guild, bot) == PURPLE_CHAT_USER_VOICE);
+	CHECK(discord_get_user_flags(&account, guild, member) == PURPLE_CHAT_USER_NONE);
+	CHECK(discord_get_user_flags(&account, guild, kicker) == PURPLE_CHAT_USER_HALFOP);
+	CHECK(discord_get_user_flags(&account, guild, banner) == PURPLE_CHAT_USER_HALFOP);
+	CHECK(discord_get_user_flags(&account, guild, admin) == PURPLE_CHAT_USER_OP);
+	CHECK(discord_get_user_flags(&account, guild, bot_admin) == PURPLE_CHAT_USER_OP);
+
+	user_free(bot_admin);
+	user_free(admin);
+	user_free(banner);
+	user_free(kicker);
+	user_free(member);
+	user_free(bot);
+	user_free(stranger);
+	guild_free(other);
+	guild_free(guild);
+}
+
+int
+main(void)
+{
+	test_group_dm();
+	test_no_user();
+	test_guild_roles();
+
+	if (failures) {
+		fprintf(stderr, "%d failure(s)\n", failures);
+		return 1;
+	}
+	printf("all user flags tests passed\n");
+	return 0;
+}
diff --git a/tests/test_webos_helpers.c b/tests/test_webos_helpers.c
index 3fd58ac..e217ed2 100644
--- a/tests/test_webos_helpers.c
+++ b/tests/test_webos_helpers.c
@@ -222,6 +222,36 @@ test_deleted_ids(void)
 	g_strfreev(got);
 }
 
+static void
+test_group_name(void)
+{
+	gboolean too_long = TRUE;
+
+	CHECK_STR(discord_webos_group_name("  Trip to Rome \t\n", &too_long), "Trip to Rome");
+	CHECK(!too_long);

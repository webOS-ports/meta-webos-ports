+/* BEGIN group event lines: tests/test_group_rename.c builds the code from here to the END line as well */
+
+/* webOS: whether the message msg_id was already written to a conversation this session, marking it
+ * written when it was not. Overlapping history fetches (the fast newest batch and the forward
+ * catch-up) and re-opened channels would otherwise write it twice. */
+static gboolean
+discord_webos_message_seen(DiscordAccount *da, guint64 msg_id)
+{
+	/* webOS: da->received_message_ids can be NULL here if discord_close() tore it down
+	 * while a backlog of queued/in-flight messages was still being delivered (seen live:
+	 * a burst of these calls with a NULL table froze the whole imtransport process, since
+	 * g_hash_table_contains/insert on NULL just logs a GLib-CRITICAL and returns without
+	 * ever making progress, spinning the caller). Lazily recreate it, matching the same
+	 * guard already used elsewhere in this file for the other da->*_ids tables. */
+	if (da->received_message_ids == NULL) {
+		da->received_message_ids = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);
+	}
+	gchar *id_key = from_int(msg_id);
+	if (g_hash_table_contains(da->received_message_ids, id_key)) {
+		g_free(id_key);
+		return TRUE;
+	}
+	g_hash_table_insert(da->received_message_ids, id_key, id_key); /* table owns id_key */
+	return FALSE;
+}
+
+/* webOS: forget that msg_id was written, so a later delivery of it (the channel's history once it
+ * is opened) writes it. */
+static void
+discord_webos_message_unsee(DiscordAccount *da, guint64 msg_id)
+{
+	if (da->received_message_ids != NULL) {
+		gchar *unkey = from_int(msg_id);
+		g_hash_table_remove(da->received_message_ids, unkey);
+		g_free(unkey);
+	}
+}
+
+/* webOS: the line for a group DM's own event message, or NULL for any other message. Discord sends
+ * a rename as MESSAGE_CHANNEL_NAME_CHANGE, its content the new name, and someone added or removed
+ * as MESSAGE_RECIPIENT_ADD / _REMOVE, with no content and the person in mentions[0]; written as
+ * they come, a rename was a message saying only the new name and the others nothing at all. The
+ * line is HTML: the names in it are escaped. */
+static gchar *
+discord_webos_group_event_text(DiscordAccount *da, DiscordChannel *channel, guint64 msg_type, JsonObject *data)
+{
+	if (channel == NULL || channel->type != CHANNEL_GROUP_DM)
+		return NULL;
+	if (msg_type != MESSAGE_CHANNEL_NAME_CHANGE && msg_type != MESSAGE_RECIPIENT_ADD &&
+			msg_type != MESSAGE_RECIPIENT_REMOVE)
+		return NULL;
+
+	JsonObject *author_obj = json_object_get_object_member(data, "author");
+	guint64 author_id = author_obj ? to_int(json_object_get_string_member(author_obj, "id")) : 0;
+	gboolean by_us = author_id != 0 && author_id == da->self_user_id;
+	gchar *text = NULL;
+
+	if (msg_type == MESSAGE_CHANNEL_NAME_CHANGE) {
+		const gchar *content = json_object_get_string_member(data, "content");
+		gchar *name = purple_markup_escape_text(content ? content : "", -1);
+
+		if (by_us) {
+			text = g_strdup_printf(_("You changed the group name to \"%s\""), name);
+		} else {
+			gchar *author = discord_get_display_name_or_unk(da, NULL, channel,
+					author_obj ? discord_upsert_user(da->new_users, author_obj) : NULL, author_obj);
+			text = g_strdup_printf(_("%s changed the group name to \"%s\""), author, name);
+			g_free(author);
+		}
+		g_free(name);
+		return text;
+	}
+
+	JsonArray *mentions = json_object_get_array_member(data, "mentions");
+	JsonObject *whom_obj = (mentions != NULL && json_array_get_length(mentions) > 0) ?
+			json_array_get_object_element(mentions, 0) : NULL;
+	guint64 whom_id = whom_obj ? to_int(json_object_get_string_member(whom_obj, "id")) : 0;
+
+	if (whom_id == 0)
+		return NULL;
+
+	gboolean to_us = whom_id == da->self_user_id;
+	gchar *author = by_us ? NULL : discord_get_display_name_or_unk(da, NULL, channel,
+			author_obj ? discord_upsert_user(da->new_users, author_obj) : NULL, author_obj);
+	gchar *whom = to_us ? NULL : discord_get_display_name_or_unk(da, NULL, channel,
+			discord_upsert_user(da->new_users, whom_obj), whom_obj);
+
+	if (msg_type == MESSAGE_RECIPIENT_REMOVE && whom_id == author_id) {
+		text = by_us ? g_strdup(_("You left the group")) : g_strdup_printf(_("%s left the group"), whom);
+	} else if (msg_type == MESSAGE_RECIPIENT_ADD) {
+		if (by_us)
+			text = g_strdup_printf(_("You added %s"), whom);
+		else if (to_us)
+			text = g_strdup_printf(_("%s added you"), author);
+		else
+			text = g_strdup_printf(_("%s added %s"), author, whom);
+	} else {
+		if (by_us)
+			text = g_strdup_printf(_("You removed %s"), whom);
+		else if (to_us)
+			text = g_strdup_printf(_("%s removed you"), author);
+		else
+			text = g_strdup_printf(_("%s removed %s"), author, whom);
+	}
+
+	g_free(author);
+	g_free(whom);
+	return text;
+}
+
+/* webOS: write a group DM's event message msg_id as a line in its conversation, conv (NULL when it
+ * is not open), when it is one (discord_webos_group_event_text). The line is a system line with no
+ * sender (" ", as tdlib-purple writes its chat notices), which imlibpurpleservice stores with no
+ * notification, and carries the message id, by which the transport keeps it once. A group that is
+ * not open is opened for its people alone (discord_webos_open_group_dm: no history, nothing acked)
+ * and the line written at once; only when libpurple makes no conversation is msg_id forgotten, so
+ * the channel's history writes it later. Returns TRUE when the message was such an event (written
+ * or not). */
+static gboolean
+discord_webos_group_event(DiscordAccount *da, DiscordChannel *channel, PurpleConversation *conv,
+		guint64 msg_type, guint64 msg_id, JsonObject *data, time_t timestamp)
+{
+	gchar *text = discord_webos_group_event_text(da, channel, msg_type, data);
+
+	if (text == NULL)
+		return FALSE;
+
+	if (conv == NULL)
+		conv = PURPLE_CONVERSATION(discord_webos_open_group_dm(da, channel));
+
+	if (conv == NULL) {
+		if (msg_id != 0)
+			discord_webos_message_unsee(da, msg_id);
+	} else {
+		discord_stash_webos_msgid(conv, msg_id);
+		purple_serv_got_chat_in(da->pc, discord_chat_hash(channel->id), " ", PURPLE_MESSAGE_SYSTEM, text, timestamp);
+	}
+
+	g_free(text);
+	return TRUE;
+}
+
+/* END group event lines */

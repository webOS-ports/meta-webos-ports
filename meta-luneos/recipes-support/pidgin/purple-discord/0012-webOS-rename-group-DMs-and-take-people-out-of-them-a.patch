+	CHECK(g_strcmp0(fetch.url, "https://discord.com/api/v9/channels/1001") == 0);
+	CHECK(g_strcmp0(fetch.postdata, "{\"name\":\"Trip to Rome\"}") == 0);
+	CHECK(notices->len == 0);
+
+	answer("{\"id\":\"1001\",\"type\":3,\"name\":\"Trip to Rome\"}");
+	CHECK(g_strcmp0(renamed_to, "Trip to Rome") == 0);
+	CHECK(notices->len == 0);
+	CHECK(strstr(debug_log->str, "Trip") == NULL);
+	teardown();

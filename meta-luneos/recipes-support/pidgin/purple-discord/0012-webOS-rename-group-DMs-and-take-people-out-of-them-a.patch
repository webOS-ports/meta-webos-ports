+/*
+ *   Unit tests for renaming a group DM from the Messaging app ("webos-im-group-rename"), for
+ *   taking people out of one ("webos-im-group-remove") and adding people to one
+ *   ("webos-im-group-invite"), and for opening one for its members
+ *   ("webos-im-chat-open"), and for the lines a group DM's rename and people added or removed
+ *   are written as: the parts of libdiscord.c between its BEGIN and END group rename, group
+ *   remove, group add, chat open and group event lines lines, which the Makefile copies into
+ *   group_rename.inc, group_remove.inc, group_add.inc, chat_open.inc and group_event_lines.inc. This file stands
+ *   in for libpurple and the rest of the plug-in around them and records the requests, notices,
+ *   lines and debug lines they make.
+ *
+ *   This program is free software: you can redistribute it and/or modify
+ *   it under the terms of the GNU General Public License as published by
+ *   the Free Software Foundation, either version 3 of the License, or
+ *   (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <glib.h>
+
+#include "json_compat.h"
+#include "webos_helpers.h"
+
+static int failures;
+static const char *current_test = "";
+
+#define CHECK(cond) do { \
+	if (!(cond)) { \
+		fprintf(stderr, "%s:%d: %s: CHECK failed: %s\n", __FILE__, __LINE__, current_test, #cond); \
+		failures++; \
+	} \
+} while (0)
+
+/* ---- what the group rename and remove parts need from libpurple and the rest of the plug-in ---- */
+
+#define _(s) (s)
+#define DISCORD_API_BASE "https://discord.com/api/v9"
+#define PURPLE_MESSAGE_SYSTEM 0x0004
+#define PURPLE_CHAT_USER_NONE 0
+
+enum { CHANNEL_GUILD_TEXT = 0, CHANNEL_GROUP_DM = 3 };
+enum { MESSAGE_DEFAULT = 0, MESSAGE_RECIPIENT_ADD = 1, MESSAGE_RECIPIENT_REMOVE = 2, MESSAGE_CALL = 3,
+	MESSAGE_CHANNEL_NAME_CHANGE = 4 };
+#define PURPLE_CONVERSATION(c) ((PurpleConversation *) (c))
+
+typedef struct { int connected; } PurpleAccount;
+typedef struct { int unused; } PurpleConnection;
+typedef struct {
+	guint64 id;
+	int left;
+	gchar *title, *nick;
+	GString *users;	/* "<name>," per user on it, in order */
+	guint64 *data_id;	/* the "id" data */
+	guint cleared;
+} PurpleChatConversation;
+typedef PurpleChatConversation PurpleConversation;
+
+typedef struct {
+	guint64 id;
+	gchar *name;
+	GList *recipients;	/* guint64 * each, the people but the user */
+	int type;
+} DiscordChannel;
+
+typedef struct { int unused; } DiscordGuild;
+
+typedef struct {
+	guint64 id;
+	gchar *name;
+} DiscordUser;
+
+typedef struct {
+	PurpleAccount *account;
+	PurpleConnection *pc;
+	GHashTable *group_dms;	/* id -> DiscordChannel, as libdiscord.c keeps them */
+	guint64 self_user_id;
+	GHashTable *new_users;
+	GHashTable *received_message_ids;
+} DiscordAccount;
+
+typedef void (*DiscordProxyCallbackFunc)(DiscordAccount *ya, JsonNode *node, gpointer user_data);
+
+static PurpleAccount ours = { 1 }, theirs = { 1 };
+static PurpleConnection connection;
+static DiscordAccount account;
+static DiscordChannel group = { .id = 1001, .type = CHANNEL_GROUP_DM };
+static DiscordChannel server_channel = { .id = 3003, .type = CHANNEL_GUILD_TEXT };	/* 2002 stands for a server channel: not in group_dms */
+
+static GString *debug_log;
+static GString *notices;	/* "<channel id>: <text>\n" per notice written */
+static GPtrArray *open_convs;	/* the chat conversations open, by id */
+static guint opened;	/* how often discord_open_chat opened one */
+
+static struct {
+	guint count;
+	gchar *method, *url, *postdata;
+	DiscordProxyCallbackFunc callback;
+	gpointer user_data;
+	GString *all;	/* "<method> <url>\n" per request, in order */
+	GPtrArray *pending;	/* the user_data of each request not answered yet */
+} fetch;
+
+/* the buddies the plug-in knows, by the name the app uses: "ann", "bob" and the user, "me" */
+static DiscordUser users[] = { { 11, "ann" }, { 12, "bob" }, { 99, "me" } };
+
+static gchar *renamed_to;	/* what discord_set_channel_name was given */
+
+#define DEBUG_STUB(name) \
+static void \
+name(const char *category, const char *format, ...) \
+{ \
+	va_list args; \
+	(void) category; \
+	va_start(args, format); \
+	gchar *line = g_strdup_vprintf(format, args); \
+	va_end(args); \
+	g_string_append(debug_log, line); \
+	g_free(line); \
+}
+DEBUG_STUB(purple_debug_warning)
+DEBUG_STUB(purple_debug_error)
+
+static DiscordAccount *
+discord_webos_account(PurpleAccount *a)
+{
+	return a == &ours ? &account : NULL;
+}
+
+/* chats are named by their channel id here */
+static guint64
+discord_webos_channel_for(DiscordAccount *da, const gchar *peer, const gchar *msg_id)
+{
+	(void) da;
+	(void) msg_id;
+	return (peer != NULL && discord_webos_is_snowflake(peer)) ? g_ascii_strtoull(peer, NULL, 10) : 0;
+}
+
+static gboolean
+purple_account_is_connected(PurpleAccount *a)
+{
+	return a->connected;
+}
+
+static int
+discord_chat_hash(guint64 id)
+{
+	return (int) (id & 0x7fffffff);
+}
+
+static PurpleChatConversation *
+purple_conversations_find_chat(PurpleConnection *pc, int hash)
+{
+	(void) pc;
+	for (guint i = 0; i < open_convs->len; i++) {
+		PurpleChatConversation *c = g_ptr_array_index(open_convs, i);
+
+		if (discord_chat_hash(c->id) == hash)
+			return c;
+	}
+	return NULL;
+}
+
+static DiscordChannel *
+discord_open_chat(DiscordAccount *da, guint64 id, gboolean present)
+{
+	(void) da;
+	(void) present;
+	PurpleChatConversation *c = g_new0(PurpleChatConversation, 1);
+
+	c->id = id;
+	g_ptr_array_add(open_convs, c);
+	opened++;
+	return NULL;
+}
+
+static GString *stashed;	/* "<msg id>," per webos-msg-id stashed */
+
+/* a line in a chat: "<channel id>: <text>\n" in notices */
+static void
+purple_serv_got_chat_in(PurpleConnection *pc, int hash, const gchar *who, int flags, const gchar *text, time_t when)
+{
+	CHECK(pc == &connection);
+	CHECK(g_strcmp0(who, " ") == 0);	/* no one's message */
+	CHECK(flags == PURPLE_MESSAGE_SYSTEM);
+	CHECK(when > 0);
+	PurpleChatConversation *conv = purple_conversations_find_chat(pc, hash);
+	CHECK(conv != NULL);	/* serv_got_chat_in writes only in an open conversation */
+	if (conv != NULL)
+		g_string_append_printf(notices, "%" G_GUINT64_FORMAT ": %s\n", conv->id, text);
+}
+
+static void
+discord_stash_webos_msgid(PurpleConversation *conv, guint64 msg_id)
+{
+	CHECK(conv != NULL);
+	if (msg_id != 0)
+		g_string_append_printf(stashed, "%" G_GUINT64_FORMAT ",", msg_id);
+}
+
+static guint64
+to_int(const gchar *s)
+{
+	return s ? g_ascii_strtoull(s, NULL, 10) : 0;
+}
+
+static gchar *
+purple_markup_escape_text(const gchar *text, gssize len)
+{
+	return g_markup_escape_text(text, len);
+}
+
+static void
+discord_fetch_url_with_method(DiscordAccount *da, const gchar *method, const gchar *url, const gchar *postdata,
+		DiscordProxyCallbackFunc callback, gpointer user_data)
+{
+	(void) da;
+	fetch.count++;
+	g_string_append_printf(fetch.all, "%s %s\n", method, url);
+	g_ptr_array_add(fetch.pending, user_data);
+	g_free(fetch.method);
+	g_free(fetch.url);
+	g_free(fetch.postdata);
+	fetch.method = g_strdup(method);
+	fetch.url = g_strdup(url);
+	fetch.postdata = g_strdup(postdata);
+	fetch.callback = callback;
+	fetch.user_data = user_data;
+}
+
+static void
+discord_set_channel_name(DiscordAccount *da, DiscordChannel *channel, const gchar *new_name)
+{
+	(void) da;
+	CHECK(channel == &group);
+	g_free(renamed_to);
+	renamed_to = g_strdup(new_name);
+}
+
+static GPtrArray *made_users;	/* what discord_upsert_user made */
+
+static DiscordUser *
+discord_get_user(DiscordAccount *da, guint64 id)
+{
+	(void) da;
+	for (guint i = 0; i < G_N_ELEMENTS(users); i++) {
+		if (users[i].id == id)
+			return &users[i];
+	}
+	for (guint i = 0; i < made_users->len; i++) {
+		DiscordUser *u = g_ptr_array_index(made_users, i);
+		if (u->id == id)
+			return u;
+	}
+	return NULL;
+}
+
+/* as libdiscord.c's: the known user with the JSON's id, else a new one from it */
+static DiscordUser *
+discord_upsert_user(GHashTable *table, JsonObject *json)
+{
+	CHECK(table == account.new_users);
+	guint64 id = g_ascii_strtoull(json_object_get_string_member(json, "id"), NULL, 10);
+	DiscordUser *user = discord_get_user(&account, id);
+
+	if (user == NULL) {
+		user = g_new0(DiscordUser, 1);
+		user->id = id;
+		user->name = g_strdup(json_object_get_string_member(json, "username"));
+		g_ptr_array_add(made_users, user);
+	}
+	return user;
+}
+
+static void
+free_made_user(gpointer p)
+{
+	DiscordUser *u = p;
+	g_free(u->name);
+	g_free(u);
+}
+
+static gchar *
+discord_create_nickname(DiscordUser *user, DiscordGuild *guild, DiscordChannel *channel)
+{
+	CHECK(guild == NULL);
+	CHECK(channel == &group);
+	return g_strdup(user->name);
+}
+
+static gchar *
+from_int(guint64 id)
+{
+	return g_strdup_printf("%" G_GUINT64_FORMAT, id);
+}
+
+/* as libdiscord.c's: the person's name, HTML-escaped, from the user or else the JSON */
+static gchar *
+discord_get_display_name_or_unk(DiscordAccount *da, DiscordGuild *guild, DiscordChannel *channel, DiscordUser *user,
+		JsonObject *json)
+{
+	(void) da;
+	CHECK(guild == NULL);
+	CHECK(channel == &group);
+	const gchar *name = user ? user->name : (json ? json_object_get_string_member(json, "username") : NULL);
+	return name ? g_markup_escape_text(name, -1) : g_strdup("Unknown user");
+}
+
+static const gchar *
+discord_get_chat_display_name(DiscordAccount *da, guint64 id)
+{
+	(void) da;
+	return id == 1001 ? "ann, bob" : NULL;
+}
+
+static int
+purple_chat_conversation_has_left(PurpleChatConversation *c)
+{
+	return c->left;
+}
+
+static guint joined;	/* how often purple_serv_got_joined_chat made a conversation */
+static int refuse_join;	/* purple_serv_got_joined_chat makes none */
+
+static PurpleChatConversation *
+purple_serv_got_joined_chat(PurpleConnection *pc, int hash, const gchar *name)
+{
+	CHECK(pc == &connection);
+	if (refuse_join)
+		return NULL;
+	PurpleChatConversation *c = g_new0(PurpleChatConversation, 1);
+
+	c->id = g_ascii_strtoull(name, NULL, 10);
+	CHECK(hash == (int) (c->id & 0x7fffffff));
+	g_ptr_array_add(open_convs, c);
+	joined++;
+	return c;
+}
+
+static void
+purple_conversation_set_data(PurpleConversation *c, const gchar *key, gpointer value)
+{
+	if (strcmp(key, "id") == 0) {
+		g_free(c->data_id);
+		c->data_id = value;
+	} else {
+		CHECK(strcmp(key, "msg_timestamp_map") == 0);
+		CHECK(value == NULL);
+	}
+}
+
+static void
+purple_conversation_set_title(PurpleConversation *c, const gchar *title)
+{
+	g_free(c->title);
+	c->title = g_strdup(title);
+}
+
+static void
+purple_chat_conversation_set_nick(PurpleChatConversation *c, const gchar *nick)
+{
+	g_free(c->nick);
+	c->nick = g_strdup(nick);
+}
+
+static void
+purple_chat_conversation_clear_users(PurpleChatConversation *c)

+gchar *
+discord_webos_group_name(const gchar *name, gboolean *too_long)
+{
+	if (too_long != NULL)
+		*too_long = FALSE;
+	if (name == NULL || !g_utf8_validate(name, -1, NULL))
+		return NULL;
+
+	gchar *trimmed = g_strstrip(g_strdup(name));
+
+	if (*trimmed == '\0') {
+		g_free(trimmed);
+		return NULL;
+	}
+	if (g_utf8_strlen(trimmed, -1) > DISCORD_WEBOS_GROUP_NAME_MAX) {
+		if (too_long != NULL)
+			*too_long = TRUE;
+		g_free(trimmed);
+		return NULL;
+	}
+
+	return trimmed;
+}

+static void
+test_add_refused(void)
+{
+	/* not a friend: Discord's 50007 says so plainly */
+	setup("add refused, not a friend");
+	g_ptr_array_add(open_convs, g_memdup2(&(PurpleChatConversation) { .id = 1001 }, sizeof(PurpleChatConversation)));
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann\x1f" "bob", NULL));
+	DiscordProxyCallbackFunc cb = fetch.callback;
+	gpointer first = g_ptr_array_index(fetch.pending, 0), second = g_ptr_array_index(fetch.pending, 1);
+
+	answer_nth(NULL, cb, first);	/* ann: done */
+	CHECK(notices->len == 0);
+	answer_nth("{\"message\":\"Cannot send messages to this user\",\"code\":50007}", cb, second);	/* bob: refused */
+	CHECK(opened == 0);
+	CHECK(g_strcmp0(notices->str, "1001: Could not add bob: Discord lets you add only your friends to a group.\n") == 0);
+	CHECK(strstr(debug_log->str, "webos group add to 1001 refused: 50007 Cannot send messages to this user") != NULL);
+	CHECK(strstr(debug_log->str, "bob") == NULL);	/* the person is not logged */
+	teardown();
+
+	/* any other refusal in Discord's own words, the group opened for it */
+	setup("add refused, other");
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann", NULL));
+	answer("{\"message\":\"Maximum number of group DM recipients reached (10)\",\"code\":30018}");
+	CHECK(opened == 1);
+	CHECK(g_strcmp0(notices->str, "1001: Could not add ann: Maximum number of group DM recipients reached (10)\n") == 0);
+	teardown();
+
+	setup("add refused, message escaped");
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann", NULL));
+	answer("{\"message\":\"<b>No</b> & no\",\"code\":50001}");
+	CHECK(g_strcmp0(notices->str, "1001: Could not add ann: &lt;b&gt;No&lt;/b&gt; &amp; no\n") == 0);
+	teardown();
+
+	/* a code with no message, and a message with no code */
+	setup("add refused, code only");
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann", NULL));
+	answer("{\"code\":50013}");
+	CHECK(g_strcmp0(notices->str, "1001: Could not add ann: Discord refused it (error 50013).\n") == 0);
+	CHECK(strstr(debug_log->str, "refused: 50013 (no message)") != NULL);
+	teardown();
+
+	setup("add refused, message only");
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann", NULL));
+	answer("{\"message\":\"401: Unauthorized\"}");
+	CHECK(g_strcmp0(notices->str, "1001: Could not add ann: 401: Unauthorized\n") == 0);
+	teardown();
+
+	setup("add refused, empty message");
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann", NULL));
+	answer("{\"message\":\"\",\"code\":40001}");
+	CHECK(g_strcmp0(notices->str, "1001: Could not add ann: Discord refused it (error 40001).\n") == 0);
+	teardown();
+
+	/* signed off meanwhile: logged, nothing written */
+	setup("add refused, signed off");
+	CHECK(discord_webos_group_invite_cb(&ours, "1001", "ann", NULL));
+	ours.connected = 0;
+	answer("{\"message\":\"Cannot send messages to this user\",\"code\":50007}");
+	CHECK(notices->len == 0);
+	CHECK(opened == 0);
+	CHECK(strstr(debug_log->str, "refused: 50007") != NULL);
+	teardown();
+}

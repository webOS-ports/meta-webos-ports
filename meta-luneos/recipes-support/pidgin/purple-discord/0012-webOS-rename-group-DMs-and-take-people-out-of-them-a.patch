+static GList *
+ids(guint64 a, guint64 b)
+{
+	GList *l = g_list_append(NULL, g_memdup2(&a, sizeof(a)));
+	return b ? g_list_append(l, g_memdup2(&b, sizeof(b))) : l;
+}
+
+static PurpleChatConversation *
+conv(guint64 id)
+{
+	for (guint i = 0; i < open_convs->len; i++) {
+		PurpleChatConversation *c = g_ptr_array_index(open_convs, i);
+		if (c->id == id)
+			return c;
+	}
+	return NULL;
+}

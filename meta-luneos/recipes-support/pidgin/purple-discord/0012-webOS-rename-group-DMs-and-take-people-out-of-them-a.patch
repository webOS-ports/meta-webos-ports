+static void
+test_refused(void)
+{
+	setup("refused");
+	g_ptr_array_add(open_convs, g_memdup2(&(PurpleChatConversation) { .id = 1001 }, sizeof(PurpleChatConversation)));
+	CHECK(discord_webos_group_rename_cb(&ours, "1001", "Secret plans", NULL));
+	answer("{\"message\":\"Missing Access\",\"code\":50001}");
+	CHECK(renamed_to == NULL);
+	CHECK(opened == 0);	/* written where the group already was */
+	CHECK(strstr(notices->str, "1001: The group could not be renamed: Missing Access") != NULL);
+	CHECK(strstr(debug_log->str, "Missing Access") != NULL);
+	CHECK(strstr(debug_log->str, "Secret") == NULL);
+	CHECK(strstr(notices->str, "Secret") == NULL);
+	teardown();
+
+	setup("no answer");
+	CHECK(discord_webos_group_rename_cb(&ours, "1001", "Secret plans", NULL));
+	answer(NULL);
+	CHECK(strstr(notices->str, "1001: The group could not be renamed: Discord did not answer") != NULL);
+	CHECK(strstr(debug_log->str, "Secret") == NULL);
+	teardown();
+
+	/* signed off meanwhile: logged, nothing written */
+	setup("signed off");
+	CHECK(discord_webos_group_rename_cb(&ours, "1001", "Secret plans", NULL));
+	ours.connected = 0;
+	answer(NULL);
+	CHECK(notices->len == 0);
+	CHECK(opened == 0);
+	teardown();
+}
+
+/* Answers one of the requests made (its callback and user_data) with a JSON body, or with nothing
+ * (NULL) as Discord does with 204 No Content */
+static void
+answer_nth(const gchar *json, DiscordProxyCallbackFunc callback, gpointer user_data)
+{
+	JsonParser *parser = json_parser_new();
+	JsonNode *root = NULL;
+
+	if (json != NULL) {
+		g_assert(json_parser_load_from_data(parser, json, -1, NULL));
+		root = json_parser_get_root(parser);
+	}
+	g_assert(g_ptr_array_remove(fetch.pending, user_data));
+	callback(&account, root, user_data);
+	g_object_unref(parser);
+}

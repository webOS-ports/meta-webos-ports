 static GString *stashed;	/* "<msg id>," per webos-msg-id stashed */
+static GString *quoted;	/* "<msg id>><pinned id>," per quote stashed, the message being the last stashed */
+
+/* as libdiscord.c's, of which only the quoted message's id is checked here: the referenced message's, else
+ * the message_reference's */
+static void
+discord_stash_webos_quote(PurpleConversation *conv, DiscordAccount *da, DiscordGuild *guild, DiscordChannel *channel,
+		JsonObject *data)
+{
+	CHECK(conv != NULL);
+	CHECK(da == &account);
+	CHECK(channel == &group ? guild == NULL : guild == &server);
+	JsonObject *ref = json_object_get_object_member(data, "referenced_message");
+	const gchar *id = ref ? json_object_get_string_member(ref, "id") : NULL;
+	if (id == NULL) {
+		ref = json_object_get_object_member(data, "message_reference");
+		id = ref ? json_object_get_string_member(ref, "message_id") : NULL;
+	}
+	if (id == NULL)
+		return;
+	const gchar *last = strrchr(stashed->str, ',');
+	const gchar *start = last;
+	while (start != NULL && start > stashed->str && start[-1] != ',')
+		start--;
+	g_string_append_printf(quoted, "%.*s>%s,", start ? (int) (last - start) : 0, start ? start : "", id);
+}
 
 /* a line in a chat: "<channel id>: <text>\n" in notices */
 static void
@@ -302,10 +329,14 @@ discord_get_display_name_or_unk(DiscordAccount *da, DiscordGuild *guild, Discord
 		JsonObject *json)

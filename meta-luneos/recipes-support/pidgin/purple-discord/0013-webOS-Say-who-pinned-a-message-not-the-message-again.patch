+static void
+test_event_pin(void)
+{
+	setup("pin: in a group");
+	open_group();
+	CHECK(deliver(&group, PIN("2701", ANN, "1900")));
+	CHECK(deliver(&group, PIN("2702", ME, "1901")));
+	CHECK(deliver(&group, PIN("2703", "{\"id\":\"13\",\"username\":\"<b>cat</b> & co\"}", "1902")));
+	/* the pinned message given whole: that is the one quoted */
+	CHECK(deliver(&group, MSG("2704", 6, BOB, ",\"content\":\"\",\"referenced_message\":{\"id\":\"1903\","
+			"\"content\":\"x\",\"author\":" ANN "}")));
+	CHECK(g_strcmp0(notices->str,
+			"1001: ann pinned a message\n"
+			"1001: You pinned a message\n"
+			"1001: &lt;b&gt;cat&lt;/b&gt; &amp; co pinned a message\n"
+			"1001: bob pinned a message\n") == 0);
+	CHECK(g_strcmp0(stashed->str, "2701,2702,2703,2704,") == 0);
+	/* each line quotes its pinned message, stashed with the line's own id */
+	CHECK(g_strcmp0(quoted->str, "2701>1900,2702>1901,2703>1902,2704>1903,") == 0);
+	teardown();
+
+	setup("pin: in a server channel");
+	open_server_channel();
+	CHECK(deliver(&server_channel, PIN("2711", ANN, "1910")));
+	CHECK(deliver(&server_channel, PIN("2712", ME, "1911")));
+	/* the server's name for them */
+	CHECK(g_strcmp0(notices->str, "3003: srv-ann pinned a message\n3003: You pinned a message\n") == 0);
+	CHECK(g_strcmp0(stashed->str, "2711,2712,") == 0);
+	CHECK(g_strcmp0(quoted->str, "2711>1910,2712>1911,") == 0);
+	teardown();
+
+	/* replayed by the history: once */
+	setup("pin: replayed");
+	open_group();
+	CHECK(deliver(&group, PIN("2721", ANN, "1920")));
+	CHECK(!deliver(&group, PIN("2721", ANN, "1920")));
+	CHECK(g_strcmp0(notices->str, "1001: ann pinned a message\n") == 0);
+	CHECK(g_strcmp0(quoted->str, "2721>1920,") == 0);
+	teardown();
+
+	/* a group not open is opened for it, as for its other news */
+	setup("pin: group not open");
+	group.recipients = ids(11, 12);
+	CHECK(deliver(&group, PIN("2731", ANN, "1930")));
+	CHECK(joined == 1);
+	CHECK(g_strcmp0(notices->str, "1001: ann pinned a message\n") == 0);
+	CHECK(g_strcmp0(quoted->str, "2731>1930,") == 0);
+	CHECK(fetch.count == 0);
+	teardown();
+
+	/* a server channel not open is not opened: nothing written, nothing marked, so its history writes
+	 * the line once the channel is open */
+	setup("pin: server channel not open");
+	CHECK(deliver(&server_channel, PIN("2741", ANN, "1940")));
+	CHECK(joined == 0);
+	CHECK(opened == 0);
+	CHECK(fetch.count == 0);
+	CHECK(notices->len == 0);
+	CHECK(stashed->len == 0);
+	CHECK(quoted->len == 0);
+	open_server_channel();
+	CHECK(deliver(&server_channel, PIN("2741", ANN, "1940")));
+	CHECK(g_strcmp0(notices->str, "3003: srv-ann pinned a message\n") == 0);
+	CHECK(g_strcmp0(quoted->str, "2741>1940,") == 0);
+	teardown();
+
+	/* a one-to-one DM's pin is not one of these lines */
+	setup("pin: not in a DM");
+	g_ptr_array_add(open_convs, g_memdup2(&(PurpleChatConversation) { .id = 4004 }, sizeof(PurpleChatConversation)));
+	CHECK(!deliver(&dm_channel, PIN("2751", ANN, "1950")));
+	CHECK(notices->len == 0);
+	CHECK(stashed->len == 0);
+	CHECK(quoted->len == 0);
+	teardown();
+}

 {
diff --git a/libdiscord.c b/libdiscord.c
index f892969..2baccd7 100644
--- a/libdiscord.c
+++ b/libdiscord.c
@@ -6872,6 +6872,19 @@ discord_login(PurpleAccount *account)
 
 	discord_connect_send_reaction_once();
 
+	/* webOS: the '@' check used to live here, and it rejected every QR sign-in.
+	 *
+	 * It belongs to upstream's email+password login. On webOS the account key is whatever the
+	 * customUI used as a label - a Discord username, not an email - and the real credential is
+	 * a token, or nothing at all when signing in by QR. Refusing a username without '@' meant
+	 * the QR flow never even started: purple_connection_error here fires before da is
+	 * allocated and before purple_connection_set_protocol_data, so the transport's close ran
+	 * against a connection with no protocol data and discord_close logged
+	 * "assertion 'da != NULL' failed" - which is what a MindPhone showed on every attempt,
+	 * with no QR code and no account created.
+	 *
+	 * The check is now made where it is actually true: just before posting to /auth/login,
+	 * the one path that really does send an email address. */
 
 	pc_flags = purple_connection_get_flags(pc);
 	pc_flags |= PURPLE_CONNECTION_FLAG_HTML;
@@ -6930,10 +6943,27 @@ discord_login(PurpleAccount *account)
 	da->token = g_strdup(purple_account_get_string(account, "token", NULL));
 
 	const gchar *account_password = purple_connection_get_password(da->pc);
-	if (da->token) {
+	/* webOS Synergy: the legacy imlibpurple config-kind path is disabled, so the
+	 * "token" account option can't be pre-seeded. The customUI stores the Discord
+	 * auth token as the account PASSWORD (the universal credentials path). If no
+	 * token option was set, use that password as the token. Discord blocks
+	 * third-party email/password (captcha) anyway, so this is the working path.
+	 * A special "QRLOGIN" sentinel password selects the QR / remote-auth flow. */
+	gboolean discord_qr_login = purple_strequal(account_password, "QRLOGIN");
+	/* webOS: da->token above is loaded from the persisted "token" account setting
+	 * (accounts.xml). A QR approval saves it via purple_account_set_string, so on
+	 * later reconnects we already have it here -> use it and skip QR (the original
+	 * code went straight to QR whenever the password was the "QRLOGIN" sentinel,
+	 * re-prompting every time). If the token is revoked, the 4004 handler clears
+	 * it and the next connect falls back to QR. */
+	if (!discord_qr_login && (!da->token || !*da->token) && account_password && *account_password) {
+		g_free(da->token);
+		da->token = g_strdup(account_password);
+	}
+	if (da->token && *da->token) {
 		discord_start_socket(da);
 
-	} else if (account_password && *account_password) {
+	} else if (!discord_qr_login && account_password && *account_password) {
 		/* The email+password path, and the only one that needs an address. */
 		if (!strchr(purple_account_get_username(account), '@')) {
 			purple_connection_error(pc, PURPLE_CONNECTION_ERROR_INVALID_USERNAME, _("Username needs to be an email address"));
@@ -7094,6 +7124,7 @@ discord_fetch_token_and_start_socket(DiscordAccount *da, JsonNode *node,
 	}
 
 	gchar *token = (gchar *) discord_qrauth_decrypt(da, encrypted_token, NULL);
+	/* Persisted in accounts.xml; reused on reconnect so QR is one-time (see discord_login) */
 	purple_account_set_string(da->account, "token", token);
 	discord_qrauth_free_keys(da);
 
@@ -7187,7 +7218,12 @@ discord_process_qrcode_auth_frame(DiscordAccount *da, const gchar *frame)
 
 			QRcode *qrcode = QRcode_encodeString(qrcode_url, 0, QR_ECLEVEL_L, QR_MODE_8, 1);
 			qrcode_utf8 = qrcode_utf8_output(qrcode);
-			qrcode_image = qrcode_tga_output(qrcode, &qrcode_image_len);
+			// webOS: emit a PNG (8px/module, 4-module quiet zone) rather than TGA -- the
+			// transport forwards it (via request_fields) to the accounts UI's inline QR
+			// <img>, which needs a web-renderable format. The old flow (write a PNG to
+			// Photos + shell-launch the full-screen com.palm.app.discordqr card) is
+			// superseded by the inline QR in the Discord account validator.
+			qrcode_image = qrcode_png_output(qrcode, 8, 4, &qrcode_image_len);
 
 			discord_display_qrcode(da->pc, qrcode_url, qrcode_utf8, qrcode_image, qrcode_image_len);
 
@@ -7597,7 +7633,8 @@ discord_socket_got_data(gpointer userdata, PurpleSslConnection *conn, PurpleInpu
 							purple_debug_error("discord", "error code %d\n", error_code);
 
 							if (error_code == 4004) {
-								/* bad auth token, clear and reset */
+								/* bad auth token, clear and reset (accounts.xml persists
+								 * the cleared value, so the next connect re-QRs) */
 								purple_account_set_string(ya->account, "token", NULL);
 
 								purple_connection_error(ya->pc, PURPLE_CONNECTION_ERROR_NETWORK_ERROR, _("Reauthentication required"));

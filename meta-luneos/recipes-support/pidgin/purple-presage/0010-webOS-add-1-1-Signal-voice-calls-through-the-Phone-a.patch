-        presage::libsignal_service::content::ContentBody::CallMessage(_) => Some("is calling!".to_string()),
+        presage::libsignal_service::content::ContentBody::CallMessage(call_message) => {
+            // Ring the Phone app on an Offer, show the line active on the peer's Answer to our call, end
+            // it on Hangup/Busy, and put a "Missed voice call" line in the chat for an incoming call
+            // nobody answered. The media engine is driven below.
+            let call_id = call_message

+++ b/src/c/call.c
@@ -0,0 +1,394 @@
+/* Signal 1:1 voice calls for the webOS Phone app.
+ *
+ * The luna-service2 service com.palm.signal.call, which the Phone app's CallSynergizer talks to with
+ * the same contract as the Telegram and WhatsApp call services: callStateQuery (subscribable) for
+ * the call card, and dial/answer/disconnect. Incoming and outgoing calls are signalled by the Rust
+ * half (receive.rs, core.rs), which also runs the media engine (call_bridge.rs); this file holds the
+ * call state the Phone app sees and reports the call to audiod.
+ *
+ * Registered from inside imlibpurpletransport, on the GMainContext libpurple runs. LuneOS has one
+ * bus, so it is one handle; the transport's role must allow the name com.palm.signal.call.
+ */
+
+#include "presage.h"
+#include <luna-service2/lunaservice.h>
+#include <glib.h>
+#include <string.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+/* call states pushed from the Rust receive loop (must match bridge.rs constants) */
+#define SIG_CALL_INCOMING 0u
+#define SIG_CALL_ENDED    1u
+#define SIG_CALL_DECLINED 2u
+#define SIG_CALL_BUSY     3u
+#define SIG_CALL_ACTIVE   4u   /* peer answered OUR outgoing call -> connected */
+#define SIG_CALL_DIALING  5u   /* we placed an outgoing call (Offer sent) -> ringing peer */
+#define SIG_CALL_ANSWERED 6u   /* LOCAL-only: user tapped Answer on an INCOMING call (cb_answer);
+                                * flip the line to active, keep origin=incoming. Not sent from
+                                * Rust, so it need not match a bridge.rs constant. */
+
+static LSHandle      *g_sh      = NULL;   /* com.palm.signal.call                     */
+static PurpleAccount *g_account = NULL;   /* the bound Signal account                  */
+
+/* last state we pushed, so a late subscriber gets the current picture immediately */
+static char *g_state    = NULL;   /* "incoming" | "dialing" | "active" | "disconnected" | NULL (idle) */
+static char *g_cause    = NULL;   /* only meaningful for "disconnected"        */
+static char *g_addr     = NULL;
+static char *g_name     = NULL;
+static uint64_t g_call_id = 0;
+static bool g_outgoing = false;   /* true while an OUTGOING call is up (origin=outgoing in the card) */
+
+static const char *SUBKEY = "callState";
+
+static void set_str(char **slot, const char *v)
+{
+    g_free(*slot);
+    *slot = v ? g_strdup(v) : NULL;
+}
+
+static gchar *json_escape(const char *s)
+{
+    if (!s) return g_strdup("");
+    GString *o = g_string_new(NULL);
+    for (const char *p = s; *p; ++p) {
+        switch (*p) {
+            case '"':  g_string_append(o, "\\\""); break;
+            case '\\': g_string_append(o, "\\\\"); break;
+            case '\n': g_string_append(o, "\\n");  break;
+            case '\r': g_string_append(o, "\\r");  break;
+            case '\t': g_string_append(o, "\\t");  break;
+            default:   g_string_append_c(o, *p);   break;
+        }
+    }
+    return g_string_free(o, FALSE);
+}
+
+/* Build the CallSynergizer callStateQuery payload. Dispatch is on the LINE-level "state"; an empty
+ * state => idle (no lines). Voice only: the line reports no video either way. */
+static gchar *build_payload(void)
+{
+    if (!g_state) {
+        return g_strdup("{\"returnValue\":true,\"lines\":[]}");
+    }
+    gchar *st   = json_escape(g_state);
+    gchar *addr = json_escape(g_addr);
+    gchar *nm   = json_escape((g_name && *g_name) ? g_name : g_addr);
+    gchar *disc = g_strcmp0(g_state, "disconnected") == 0
+        ? g_strdup_printf("\"disconnectDetails\":{\"cause\":\"%s\"},", g_cause ? g_cause : "normal")
+        : g_strdup("");
+    /* CallSynergizer reads call.address / call.displayName directly off each call and
+     * CallSynergyContact.create() throws if address is missing, so the fields are flat, as the
+     * Telegram and WhatsApp services send them. transport is this connector's own PHONE account
+     * template id: without it the call is taken for a cellular one and the Signal UUID is shown
+     * formatted as a phone number. */
+    gchar *p = g_strdup_printf(
+        "{\"returnValue\":true,\"lines\":["
+        "{\"state\":\"%s\",%s\"incomingVideo\":false,\"outgoingVideo\":false,"
+        "\"calls\":[{\"id\":\"sig\",\"origin\":\"%s\",\"transport\":\"com.palm.signal\","
+        "\"address\":\"%s\",\"displayName\":\"%s\"}]}]}",
+        st, disc, g_outgoing ? "outgoing" : "incoming", addr, nm);
+    g_free(st); g_free(addr); g_free(nm); g_free(disc);
+    return p;
+}
+
+/* Minimal JSON string-field extractor for the flat LS2 dial payload (e.g. {"address":"<uuid>"}).
+ * Returns a newly-allocated unescaped value, or NULL if absent. Good enough for the dialer's simple,
+ * machine-generated payloads (no nested objects with the same key, no unicode escapes expected). */
+static gchar *json_get_string(const char *payload, const char *key)
+{
+    if (!payload || !key) return NULL;
+    gchar *needle = g_strdup_printf("\"%s\"", key);
+    const char *k = strstr(payload, needle);
+    g_free(needle);
+    if (!k) return NULL;
+    const char *c = strchr(k, ':');
+    if (!c) return NULL;
+    c++;
+    while (*c == ' ' || *c == '\t') c++;
+    if (*c != '"') return NULL;   /* only string values */
+    c++;
+    GString *o = g_string_new(NULL);
+    for (; *c && *c != '"'; ++c) {
+        if (*c == '\\' && c[1]) { c++; g_string_append_c(o, *c); }
+        else g_string_append_c(o, *c);
+    }
+    return g_string_free(o, FALSE);
+}
+
+static void reply(LSHandle *sh, LSMessage *msg, const char *payload)
+{
+    LSError err; LSErrorInit(&err);
+    if (!LSMessageReply(sh, msg, payload, &err)) LSErrorFree(&err);
+}
+
+/* The account's Rust command channel, or NULL while it is not connected. */
+static Presage *bound_presage(void)
+{
+    PurpleConnection *pc = g_account ? purple_account_get_connection(g_account) : NULL;
+    Presage *presage = pc ? (Presage *)purple_connection_get_protocol_data(pc) : NULL;
+    return (presage && presage->tx_ptr) ? presage : NULL;
+}
+
+static bool cb_call_state_query(LSHandle *sh, LSMessage *msg, void *ctx)
+{
+    (void)ctx;
+    LSError err; LSErrorInit(&err);
+    bool subscribed = false;
+    LSSubscriptionProcess(sh, msg, &subscribed, &err);   /* honours {"subscribe":true} */
+    if (subscribed) LSSubscriptionAdd(sh, SUBKEY, msg, &err);
+    gchar *payload = build_payload();
+    LSMessageReply(sh, msg, payload, &err);
+    g_free(payload);
+    if (LSErrorIsSet(&err)) { purple_debug_warning(PLUGIN_NAME, "callStateQuery: %s\n", err.message); LSErrorFree(&err); }
+    return true;
+}
+
+/* Place an OUTGOING Signal call. The dialer POSTs {"address":"<signal-uuid or +E.164>"}. The Rust
+ * command loop resolves the address, generates our media keys and sends the RingRTC Offer; the
+ * peer's Answer then starts the media engine in caller role (call_bridge.rs on_answer). The card is
+ * driven by the real call events: "dialing" once the Offer is out, with the real call_id, then
+ * "active" or "disconnected" - one call_id, so the dialer logs one call. If the call cannot be
+ * placed, the command loop reports it ended, which clears the dialer's card. */
+static bool cb_dial(LSHandle *sh, LSMessage *msg, void *ctx)
+{
+    (void)ctx;
+    gchar *addr = json_get_string(LSMessageGetPayload(msg), "address");
+    Presage *presage = bound_presage();
+
+    if (!addr || !*addr) {
+        reply(sh, msg, "{\"returnValue\":false,\"errorText\":\"dial: missing address\"}");
+    } else if (!presage) {
+        reply(sh, msg, "{\"returnValue\":false,\"errorText\":\"Signal account not connected\"}");
+    } else {
+        purple_debug_info(PLUGIN_NAME, "call: dialling\n");
+        presage_rust_place_call(g_account, rust_runtime, presage->tx_ptr, addr);
+        reply(sh, msg, "{\"returnValue\":true}");
+    }
+    g_free(addr);
+    return true;
+}
+
+/* User tapped Answer on an incoming Signal call. The media engine started on the offer, so ICE is
+ * ready; answering tells it to send RingRTC's rtp-data Accepted - without which the caller keeps
+ * ringing with media gated - and to open the microphone. Locally the line turns active, which
+ * reports the call to audiod. If there is no engine for the call, the command loop ends it. */
+static bool cb_answer(LSHandle *sh, LSMessage *msg, void *ctx)
+{
+    (void)ctx;
+    Presage *presage = bound_presage();
+    if (presage && g_call_id && g_strcmp0(g_state, "incoming") == 0) {
+        presage_rust_accept_call(g_account, rust_runtime, presage->tx_ptr, g_call_id);
+        presage_handle_call_state(g_account, g_addr, g_name, SIG_CALL_ANSWERED, g_call_id);
+        reply(sh, msg, "{\"returnValue\":true}");
+    } else {
+        reply(sh, msg, "{\"returnValue\":false,\"errorText\":\"no incoming Signal call\"}");
+    }
+    return true;
+}
+
+/* Decline or hang up: send the peer a Signal Hangup and stop our media engine, so their phone stops
+ * ringing and the audio stops, then clear the line. */
+static bool cb_disconnect(LSHandle *sh, LSMessage *msg, void *ctx)
+{
+    (void)ctx;
+    Presage *presage = bound_presage();
+    if (presage && g_addr && *g_addr && g_call_id)
+        presage_rust_hangup_call(g_account, rust_runtime, presage->tx_ptr, g_addr, g_call_id);
+    if (g_state)
+        presage_handle_call_state(g_account, g_addr, g_name, SIG_CALL_DECLINED, g_call_id);
+    reply(sh, msg, "{\"returnValue\":true}");
+    return true;
+}
+
+static bool cb_noop(LSHandle *sh, LSMessage *msg, void *ctx)
+{
+    (void)ctx;
+    reply(sh, msg, "{\"returnValue\":true}");
+    return true;
+}
+
+static LSMethod g_methods[] = {
+    { "callStateQuery", cb_call_state_query, LUNA_METHOD_FLAGS_NONE },
+    { "dial",           cb_dial,             LUNA_METHOD_FLAGS_NONE },
+    { "answer",         cb_answer,           LUNA_METHOD_FLAGS_NONE },
+    { "disconnect",     cb_disconnect,       LUNA_METHOD_FLAGS_NONE },
+    { "hangupAll",      cb_disconnect,       LUNA_METHOD_FLAGS_NONE },
+    { "hangupAllActive",cb_disconnect,       LUNA_METHOD_FLAGS_NONE },
+    { "hold",           cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { "swap",           cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { "merge",          cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { "extract",        cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { "dtmf",           cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { "dtmfEnd",        cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { "changeMedia",    cb_noop,             LUNA_METHOD_FLAGS_NONE },
+    { NULL, NULL, LUNA_METHOD_FLAGS_NONE }
+};
+
+void callLunaInit(PurpleAccount *account)
+{
+    if (account) g_account = account;
+    if (g_sh) return;   /* already registered (one service, whichever account connects first) */
+
+    LSError err; LSErrorInit(&err);
+    if (!LSRegister("com.palm.signal.call", &g_sh, &err)) {
+        purple_debug_error(PLUGIN_NAME, "registering com.palm.signal.call: %s\n", err.message);
+        LSErrorFree(&err);
+        g_sh = NULL;
+        return;
+    }
+    /* attach to the context libpurple already services (its glib eventloop runs the default context) */
+    if (!LSRegisterCategory(g_sh, "/", g_methods, NULL, NULL, &err) ||
+        !LSGmainContextAttach(g_sh, g_main_context_default(), &err)) {
+        purple_debug_error(PLUGIN_NAME, "registering com.palm.signal.call: %s\n", err.message);
+        LSErrorFree(&err);
+        LSErrorInit(&err);
+        if (!LSUnregister(g_sh, &err)) LSErrorFree(&err);
+        g_sh = NULL;
+        return;
+    }
+    purple_debug_info(PLUGIN_NAME, "com.palm.signal.call registered\n");
+}
+
+/* The account is going offline (presage_close, before the command channel is dropped): hang up a
+ * call it still had, so the peer is not left in it, then forget the account so a later dial cannot
+ * reach a connection that is gone. The service stays registered for the process lifetime. */
+void callLunaShutdown(PurpleAccount *account)
+{
+    if (!account || g_account != account) return;
+    Presage *presage = bound_presage();
+    if (presage && g_addr && *g_addr && g_call_id)
+        presage_rust_hangup_call(account, rust_runtime, presage->tx_ptr, g_addr, g_call_id);
+    if (g_state)
+        presage_handle_call_state(account, g_addr, g_name, SIG_CALL_ENDED, g_call_id);
+    g_account = NULL;
+}
+
+/* Tell audiod about the call: an active VoIP line, so it routes the call audio (voipcall/webcall)
+ * to the call's output and input, the earpiece first; no lines when it ends. The transport is the
+ * connector's own, never com.palm.telephony, which would switch the modem's voice call path in.
+ * The call "id" must be a string: PmBtEngine's HFG reads it as one for Bluetooth call audio. */
+static bool audiod_reply(LSHandle *sh, LSMessage *m, void *ctx) { (void)sh; (void)m; (void)ctx; return true; }
+static void audiod_send(const char *uri, const char *payload)
+{
+    if (!g_sh) return;
+    LSError err; LSErrorInit(&err);
+    LSMessageToken tok;
+    if (!LSCallOneReply(g_sh, uri, payload, audiod_reply, NULL, &tok, &err)) {
+        purple_debug_warning(PLUGIN_NAME, "audiod %s: %s\n", uri, err.message);
+        LSErrorFree(&err);
+    }
+}
+
+/* heap-marshalled call event: the Rust receive loop runs on a worker pthread, so (like
+ * presage_append_message) we copy the data and hop to the main thread before touching LS2. */
+typedef struct {
+    uint32_t state;
+    uint64_t call_id;
+    char    *who;
+    char    *name;
+} CallEvt;
+
+/* runs on the MAIN thread: apply the new state and push it to callStateQuery subscribers */
+static gboolean call_state_apply(gpointer data)
+{
+    CallEvt *e = (CallEvt *)data;
+    bool was_active = g_strcmp0(g_state, "active") == 0;
+
+    /* An event for another call than the one on the card (a second caller while busy) must not
+     * overwrite it, and the end of a call that is no longer on the card (the peer's hangup after we
+     * declined) must not push a second "disconnected". call_id 0 is a call that never got one (a
+     * dial that could not be placed), which is still reported. */
+    bool is_end = e->state == SIG_CALL_ENDED || e->state == SIG_CALL_DECLINED || e->state == SIG_CALL_BUSY;
+    bool other_call = (g_state && e->call_id && g_call_id && e->call_id != g_call_id) ||
+                      (!g_state && e->call_id && is_end);
+    if (other_call) {
+        purple_debug_info(PLUGIN_NAME, "call: ignoring state %u of another call\n", e->state);
+        g_free(e->who); g_free(e->name); g_free(e);
+        return FALSE;
+    }
+
+    switch (e->state) {
+        case SIG_CALL_INCOMING:
+            g_outgoing = false;
+            set_str(&g_state, "incoming"); set_str(&g_cause, NULL);
+            set_str(&g_addr, e->who); set_str(&g_name, e->name); g_call_id = e->call_id;
+            break;
+        case SIG_CALL_DIALING:
+            /* We placed an outgoing call (Offer sent). Show the outgoing "dialing" card with the
+             * real call_id so the whole call (dialing -> active -> disconnected) is one entry. */
+            g_outgoing = true;
+            set_str(&g_state, "dialing"); set_str(&g_cause, NULL);
+            set_str(&g_addr, e->who); set_str(&g_name, e->name); g_call_id = e->call_id;
+            break;
+        case SIG_CALL_ACTIVE:
+            /* Peer answered our outgoing call. Keep addr/name/origin; flip the line to active so the
+             * dialer shows a connected call. call_id may arrive here for the first time. */
+            g_outgoing = true;
+            set_str(&g_state, "active"); set_str(&g_cause, NULL);
+            if (e->call_id) g_call_id = e->call_id;
+            break;
+        case SIG_CALL_ANSWERED:
+            /* User tapped Answer on an INCOMING call: keep g_outgoing=false and the caller's
+             * addr/name from SIG_CALL_INCOMING. */
+            set_str(&g_state, "active"); set_str(&g_cause, NULL);
+            break;
+        case SIG_CALL_DECLINED:
+            set_str(&g_state, "disconnected"); set_str(&g_cause, "rejected");
+            break;
+        case SIG_CALL_BUSY:
+            set_str(&g_state, "disconnected"); set_str(&g_cause, "busy");
+            break;
+        case SIG_CALL_ENDED:
+        default:
+            /* A dial that could not be placed has no card of its own yet: report it under the
+             * address the user dialled, so the dialer clears its "Connecting" card. */
+            if (!g_state) { set_str(&g_addr, e->who); set_str(&g_name, e->name); g_outgoing = true; }
+            set_str(&g_state, "disconnected"); set_str(&g_cause, "normal");
+            break;
+    }
+
+    if (g_sh) {
+        gchar *payload = build_payload();
+        LSError err; LSErrorInit(&err);
+        if (!LSSubscriptionReply(g_sh, SUBKEY, payload, &err)) {
+            purple_debug_warning(PLUGIN_NAME, "call pushState: %s\n", err.message);
+            LSErrorFree(&err);
+        }
+        g_free(payload);
+    }
+
+    /* audiod: report the active call once, and clear it when a call that was active ends. Must run
+     * before the idle reset below (which clears g_state). */
+    if (!was_active && g_strcmp0(g_state, "active") == 0) {
+        audiod_send("palm://com.palm.audio/phone/CallStatusUpdate",
+                    "{\"lines\":[{\"state\":\"active\",\"calls\":[{\"id\":\"sig\",\"video\":false,"
+                    "\"transport\":\"com.palm.signal\"}]}]}");
+    } else if (was_active && g_strcmp0(g_state, "disconnected") == 0) {
+        audiod_send("palm://com.palm.audio/phone/CallStatusUpdate", "{\"lines\":[]}");
+    }
+
+    /* after a terminal state, return to idle so the next call starts clean */
+    if (g_strcmp0(g_state, "disconnected") == 0) {
+        set_str(&g_state, NULL); set_str(&g_cause, NULL);
+        set_str(&g_addr, NULL);  set_str(&g_name, NULL); g_call_id = 0;
+        g_outgoing = false;
+    }
+
+    g_free(e->who); g_free(e->name); g_free(e);
+    return FALSE;   /* one-shot */
+}
+
+/* Called from the Rust receive and command loops (worker threads) when a call changes state, and
+ * from the LS2 handlers above (main thread). Marshals to the main thread before touching LS2. */
+void presage_handle_call_state(PurpleAccount *account, const char *who, const char *name,
+                               uint32_t state, uint64_t call_id)
+{
+    (void)account;
+    CallEvt *e = g_new0(CallEvt, 1);
+    e->state = state;
+    e->call_id = call_id;
+    e->who = g_strdup(who);
+    e->name = g_strdup(name);
+    purple_timeout_add(0, call_state_apply, e);   /* thread-safe; runs on the main thread */
+}

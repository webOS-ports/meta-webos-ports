+/* webOS: a message edited, or deleted for everyone, changes where the transport keeps it, by its
+ * serviceMessageId (sent timestamp): "webos-im-edit" (account, id, text), "webos-im-delete"
+ * (account, id). Like presage_emit_reaction this runs on the Rust worker thread, so copy the strings
+ * and hop to the libpurple main thread before touching purple_signal_emit. text is NULL for a
+ * deletion. */
+typedef struct {
+    PurpleAccount *account;
+    char *target_id;
+    char *text;
+} PresageChangeEvt;
+
+static gboolean presage_change_apply(gpointer data) {
+    PresageChangeEvt *e = (PresageChangeEvt *)data;
+    if (e->text != NULL) {
+        purple_signal_emit(purple_conversations_get_handle(), "webos-im-edit",
+            e->account, e->target_id, e->text);
+    } else {
+        purple_signal_emit(purple_conversations_get_handle(), "webos-im-delete",
+            e->account, e->target_id);
+    }
+    g_free(e->target_id); g_free(e->text); g_free(e);
+    return FALSE; /* one-shot */
+}
+
+static void presage_emit_change(PurpleAccount *account, const char *target_id, const char *text) {
+    if (account == NULL || target_id == NULL || *target_id == '\0') {
+        return;
+    }
+    PresageChangeEvt *e = g_new0(PresageChangeEvt, 1);
+    e->account = account;
+    e->target_id = g_strdup(target_id);
+    e->text = g_strdup(text); /* NULL stays NULL */
+    purple_timeout_add(0, presage_change_apply, e); /* thread-safe; runs on the main thread */
+}
+
+void presage_emit_edit(PurpleAccount *account, const char *target_id, const char *text) {
+    presage_emit_change(account, target_id, text ? text : "");
+}
+
+void presage_emit_delete(PurpleAccount *account, const char *target_id) {
+    presage_emit_change(account, target_id, NULL);
+}

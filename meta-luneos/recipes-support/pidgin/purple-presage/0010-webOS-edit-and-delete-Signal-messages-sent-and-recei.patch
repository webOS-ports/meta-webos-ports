+// The store thread of a resolved recipient (a phone recipient is resolved before any send).
+fn thread_of(recipient: &crate::structs::Recipient) -> presage::store::Thread {
+    match recipient {
+        crate::structs::Recipient::Contact(uuid) => presage::store::Thread::Contact(presage::libsignal_service::protocol::ServiceId::Aci((*uuid).into())),
+        crate::structs::Recipient::ContactByPhone(_) => unreachable!("phone recipient is resolved to a UUID before sending"),
+        crate::structs::Recipient::Group(key) => presage::store::Thread::Group(*key),
+    }
+}
+
+// The group context a DataMessage into group `master_key` carries, as send() sets it.
+fn group_context(master_key: &presage::libsignal_service::zkgroup::GroupMasterKeyBytes) -> presage::proto::GroupContextV2 {
+    presage::proto::GroupContextV2 {
+        master_key: Some(master_key.to_vec()),
+        revision: Some(0),
+        ..Default::default()
+    }
+}
+
+// Sends `body` to a resolved recipient: to the contact, or to every member of the group.
+async fn deliver<C: presage::store::Store + 'static>(
+    manager: &mut presage::Manager<C, presage::manager::Registered>,
+    recipient: crate::structs::Recipient,
+    body: presage::libsignal_service::content::ContentBody,
+    timestamp: u64,
+) -> Result<(), anyhow::Error> {
+    match recipient {
+        crate::structs::Recipient::Contact(uuid) => {
+            manager.send_message(presage::libsignal_service::protocol::ServiceId::Aci(uuid.into()), body, timestamp).await?;
+        }
+        crate::structs::Recipient::ContactByPhone(_) => unreachable!("phone recipient is resolved to a UUID before sending"),
+        crate::structs::Recipient::Group(master_key) => {
+            manager.send_message_to_group(&master_key, body, timestamp).await?;
+        }
+    }
+    Ok(())
+}
+
+// The DataMessage of a stored message: one we sent from here (DataMessage), one we sent from another
+// device (the Sent transcript of a SyncMessage), or the latest edit of either.
+fn stored_data_message(content: &presage::libsignal_service::content::Content) -> Option<&presage::libsignal_service::content::DataMessage> {
+    match &content.body {
+        presage::libsignal_service::content::ContentBody::DataMessage(dm) => Some(dm),
+        presage::libsignal_service::content::ContentBody::EditMessage(em) => em.data_message.as_ref(),
+        presage::libsignal_service::content::ContentBody::SynchronizeMessage(sm) => match &sm.content {
+            Some(presage::proto::sync_message::Content::Sent(sent)) => {
+                sent.message.as_ref().or(sent.edit_message.as_ref().and_then(|em| em.data_message.as_ref()))
+            }
+            _ => None,
+        },
+        _ => None,
+    }
+}
+
+/*
+ * webOS edit: replaces the text of one of the user's own messages, sent at `target_ts`.
+ *
+ * Signal sends an edit as an EditMessage: the original's sent timestamp and a whole new DataMessage,
+ * which the recipients show in place of the original. The new DataMessage keeps the original's
+ * attachments and quote (when the original is in the store) so that only the text changes.
+ */
+pub async fn send_edit<C: presage::store::Store + 'static>(
+    manager: &mut presage::Manager<C, presage::manager::Registered>,
+    recipient: crate::structs::Recipient,
+    target_ts: u64,
+    text: String,
+) -> Result<(), anyhow::Error> {
+    if text.len() > 2048 {
+        // the same limit send() has
+        return Err(anyhow::anyhow!("Cannot send a message longer than 2048 bytes."));
+    }
+    let timestamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_millis() as u64;
+    let mut data_message = presage::libsignal_service::content::DataMessage {
+        timestamp: Some(timestamp),
+        body: Some(text),
+        ..Default::default()
+    };
+    if let Ok(Some(original)) = manager.store().message(&thread_of(&recipient), target_ts).await {
+        if let Some(original) = stored_data_message(&original) {
+            data_message.attachments = original.attachments.clone();
+            data_message.quote = original.quote.clone();
+            // presage fills in the chat's disappearing-message timer for a DataMessage only, not for
+            // the one inside an EditMessage: keep the original's
+            data_message.expire_timer = original.expire_timer;
+            data_message.expire_timer_version = original.expire_timer_version;
+        }
+    }
+    if let crate::structs::Recipient::Group(master_key) = &recipient {
+        data_message.group_v2 = Some(group_context(master_key));
+    }
+    let edit = presage::proto::EditMessage {
+        target_sent_timestamp: Some(target_ts),
+        data_message: Some(data_message),
+    };
+    deliver(manager, recipient, presage::libsignal_service::content::ContentBody::EditMessage(edit), timestamp).await
+}
+
+/*
+ * webOS delete: deletes one of the user's own messages, sent at `target_ts`, for everyone (Signal's
+ * remote delete: a DataMessage with `delete` naming the message's sent timestamp).
+ */
+pub async fn send_delete<C: presage::store::Store + 'static>(
+    manager: &mut presage::Manager<C, presage::manager::Registered>,
+    recipient: crate::structs::Recipient,
+    target_ts: u64,
+) -> Result<(), anyhow::Error> {
+    let timestamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_millis() as u64;
+    let mut data_message = presage::libsignal_service::content::DataMessage {
+        timestamp: Some(timestamp),
+        delete: Some(presage::proto::data_message::Delete {
+            target_sent_timestamp: Some(target_ts),
+        }),
+        ..Default::default()
+    };
+    if let crate::structs::Recipient::Group(master_key) = &recipient {
+        data_message.group_v2 = Some(group_context(master_key));
+    }
+    deliver(manager, recipient, presage::libsignal_service::content::ContentBody::DataMessage(data_message), timestamp).await
+}

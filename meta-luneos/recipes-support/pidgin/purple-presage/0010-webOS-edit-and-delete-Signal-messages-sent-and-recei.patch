+/// webOS edit (SEND): replace the text of one of the user's own messages. Called by
+/// presage_send_edit_cb (connection.c) for the "webos-im-send-edit" signal. `c_peer` is the
+/// conversation (contact UUID / E.164 / group hex), classified like a send; `target_ts` is the edited
+/// message's sent timestamp; `c_text` the new text. Returns 1 when the edit was queued, 0 when it
+/// could not be (unrecognised peer, text not UTF-8).
+#[no_mangle]
+pub unsafe extern "C" fn presage_rust_send_edit(
+    account: *mut crate::bridge_structs::PurpleAccount,
+    tx: *mut tokio::sync::mpsc::Sender<crate::structs::Cmd>,
+    c_peer: *const std::os::raw::c_char,
+    target_ts: u64,
+    c_text: *const std::os::raw::c_char,
+) -> std::os::raw::c_int {
+    if c_peer.is_null() || c_text.is_null() || target_ts == 0 {
+        return 0;
+    }
+    let (peer, text) = match (std::ffi::CStr::from_ptr(c_peer).to_str(), std::ffi::CStr::from_ptr(c_text).to_str()) {
+        (Ok(peer), Ok(text)) => (peer, text.to_owned()),
+        _ => return 0,
+    };
+    match classify_recipient(peer) {
+        Ok(recipient) => {
+            send_cmd(account, tx, crate::structs::Cmd::SendEdit { recipient, target_ts, text }) as std::os::raw::c_int
+        }
+        Err(err) => {
+            crate::bridge::purple_debug(
+                account,
+                crate::bridge_structs::PURPLE_DEBUG_ERROR,
+                format!("Cannot edit: unrecognized peer \"{peer}\": {err}\n"),
+            );
+            0
+        }
+    }
+}
+
+/// webOS delete (SEND): delete one of the user's own messages for everyone. Called by
+/// presage_send_delete_cb (connection.c) for the "webos-im-send-delete" signal; arguments as for
+/// presage_rust_send_edit. Returns 1 when the delete was queued, 0 when it could not be.
+#[no_mangle]
+pub unsafe extern "C" fn presage_rust_send_delete(
+    account: *mut crate::bridge_structs::PurpleAccount,
+    tx: *mut tokio::sync::mpsc::Sender<crate::structs::Cmd>,
+    c_peer: *const std::os::raw::c_char,
+    target_ts: u64,
+) -> std::os::raw::c_int {
+    if c_peer.is_null() || target_ts == 0 {
+        return 0;
+    }
+    let peer = match std::ffi::CStr::from_ptr(c_peer).to_str() {
+        Ok(peer) => peer,
+        Err(_) => return 0,
+    };
+    match classify_recipient(peer) {
+        Ok(recipient) => {
+            send_cmd(account, tx, crate::structs::Cmd::SendDelete { recipient, target_ts }) as std::os::raw::c_int
+        }
+        Err(err) => {
+            crate::bridge::purple_debug(
+                account,
+                crate::bridge_structs::PURPLE_DEBUG_ERROR,
+                format!("Cannot delete: unrecognized peer \"{peer}\": {err}\n"),
+            );
+            0
+        }
+    }
+}

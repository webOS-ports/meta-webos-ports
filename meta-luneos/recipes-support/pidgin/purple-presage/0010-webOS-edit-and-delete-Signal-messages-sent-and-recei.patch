+/* The command channel of `account` when it is a connected Signal account, else NULL. The webos-im-*
+ * signals reach every prpl's handler, so this is also the "is it ours" test. */
+static RustChannelPtr presage_signal_account_tx(PurpleAccount *account) {
+    if (account == NULL || g_strcmp0(purple_account_get_protocol_id(account), "prpl-hehoe-presage") != 0) {
+        return NULL;
+    }
+    PurpleConnection *connection = purple_account_get_connection(account);
+    if (connection == NULL) {
+        return NULL;
+    }
+    Presage *presage = purple_connection_get_protocol_data(connection);
+    return presage != NULL ? presage->tx_ptr : NULL;
+}
+
+/* A serviceMessageId as this plug-in hands them out: the message's sent timestamp in ms, decimal.
+ * 0 when it is not one. */
+static uint64_t presage_parse_service_message_id(const char *id) {
+    if (id == NULL || !g_ascii_isdigit(id[0])) {
+        return 0;
+    }
+    char *end = NULL;
+    guint64 ts = g_ascii_strtoull(id, &end, 10);
+    return (end != NULL && *end == '\0') ? ts : 0;
+}
+
+/* webOS edit (SEND): "webos-im-send-edit" (account, chat, serviceMessageId, text), emitted when the user
+ * edits one of their own messages in the app. chat is the conversation (contact UUID / E.164 / group
+ * key), serviceMessageId the message's sent timestamp, text the new text in the form send_im gets it.
+ * TRUE when this plug-in owns the account and queued the edit. */
+static gboolean presage_send_edit_cb(PurpleAccount *account, const char *chat, const char *service_message_id, const char *text, void *unused) {
+    (void)unused;
+    RustChannelPtr tx = presage_signal_account_tx(account);
+    if (tx == NULL || chat == NULL || text == NULL) {
+        return FALSE;
+    }
+    uint64_t target_ts = presage_parse_service_message_id(service_message_id);
+    if (target_ts == 0) {
+        purple_debug_error(PLUGIN_NAME, "webos-im-send-edit: unparseable target id \"%s\"\n", service_message_id ? service_message_id : "(null)");
+        return FALSE;
+    }
+    // the same conversion as presage_send_im
+    char *msg = purple_markup_strip_html(text);
+    gboolean queued = presage_rust_send_edit(account, tx, chat, target_ts, msg) ? TRUE : FALSE;
+    g_free(msg);
+    return queued;
+}
+
+/* webOS delete (SEND): "webos-im-send-delete" (account, chat, serviceMessageId): delete one of the
+ * user's own messages for everyone. TRUE when this plug-in owns the account and queued the delete. */
+static gboolean presage_send_delete_cb(PurpleAccount *account, const char *chat, const char *service_message_id, void *unused) {
+    (void)unused;
+    RustChannelPtr tx = presage_signal_account_tx(account);
+    if (tx == NULL || chat == NULL) {
+        return FALSE;
+    }
+    uint64_t target_ts = presage_parse_service_message_id(service_message_id);
+    if (target_ts == 0) {
+        purple_debug_error(PLUGIN_NAME, "webos-im-send-delete: unparseable target id \"%s\"\n", service_message_id ? service_message_id : "(null)");
+        return FALSE;
+    }
+    return presage_rust_send_delete(account, tx, chat, target_ts) ? TRUE : FALSE;
+}

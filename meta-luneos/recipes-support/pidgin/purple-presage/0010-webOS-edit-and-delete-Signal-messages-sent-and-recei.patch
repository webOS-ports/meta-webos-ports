+// A recipient with a phone number resolved to the contact's UUID (see resolve_phone_to_uuid), or None,
+// logged, when no stored contact has that number. `what` names the command for the log.
+async fn resolve_recipient<C: presage::store::Store>(
+    manager: &mut presage::Manager<C, presage::manager::Registered>,
+    recipient: crate::structs::Recipient,
+    account: *mut crate::bridge_structs::PurpleAccount,
+    what: &str,
+) -> Option<crate::structs::Recipient> {
+    match recipient {
+        crate::structs::Recipient::ContactByPhone(phone) => match resolve_phone_to_uuid(manager, &phone).await {
+            Some(uuid) => Some(crate::structs::Recipient::Contact(uuid)),
+            None => {
+                crate::bridge::purple_debug(
+                    account,
+                    crate::bridge_structs::PURPLE_DEBUG_ERROR,
+                    format!("Cannot send {what}: no Signal contact found for {phone}\n"),
+                );
+                None
+            }
+        },
+        other => Some(other),
+    }
+}

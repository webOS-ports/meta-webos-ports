new file mode 100644
index 0000000..e057c99
--- /dev/null
+++ b/src/rust/src/changes.rs
@@ -0,0 +1,55 @@
+// webOS: a message changed after it came - edited, or deleted for everyone - is changed where the
+// Messaging transport keeps it, by its serviceMessageId (the sent timestamp, in ms), through the
+// "webos-im-edit" (account, id, text) and "webos-im-delete" (account, id) signals, rather than shown
+// as a new message. Depends on std only: `rustc --test changes.rs` runs the tests.
+
+/// The text an edit gives the stored message. A reply comes from the receive layer with its quote
+/// sentinel-encoded in front, "\x01<id>\x1f<from>\x1f<text>\x02<reply body>", and the stored
+/// message holds the reply body alone, so that is what it becomes.
+pub fn edited_text(body: &str) -> &str {
+    if body.starts_with('\u{1}') {
+        if let Some(end) = body.find('\u{2}') {
+            return &body[end + '\u{2}'.len_utf8()..];
+        }
+    }
+    body
+}
+
+/// The serviceMessageId of the message an edit or deletion is of; None for no target, which
+/// Signal never sends but a timestamp of 0 would be.
+pub fn target_id(target_sent_timestamp: Option<u64>) -> Option<String> {
+    match target_sent_timestamp {
+        Some(ts) if ts != 0 => Some(ts.to_string()),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn plain_text_is_kept() {
+        assert_eq!(edited_text("fixed typo"), "fixed typo");
+        assert_eq!(edited_text(""), "");
+        assert_eq!(edited_text("a \u{2} b"), "a \u{2} b");
+    }
+
+    #[test]
+    fn quote_is_left_off() {
+        assert_eq!(edited_text("\u{1}1700000000000\u{1f}Anna\u{1f}hi\u{2}hello <b>you</b>"), "hello <b>you</b>");
+        assert_eq!(edited_text("\u{1}\u{1f}\u{1f}\u{2}"), "");
+        // Only the first end marker ends the quote
+        assert_eq!(edited_text("\u{1}1\u{1f}A\u{1f}q\u{2}x\u{2}y"), "x\u{2}y");
+        // An opening without its end is not a quote
+        assert_eq!(edited_text("\u{1}no end"), "\u{1}no end");
+    }
+
+    #[test]
+    fn target() {
+        assert_eq!(target_id(Some(1700000000123)), Some("1700000000123".to_string()));
+        assert_eq!(target_id(Some(u64::MAX)), Some("18446744073709551615".to_string()));
+        assert_eq!(target_id(Some(0)), None);
+        assert_eq!(target_id(None), None);
+    }
+}

+// webOS: @-mentions in a message the user sends from the Messaging app.
+//
+// The transport hands them over as the conversation data "webos-send-mentions": records
+// "<id>\x1f<name>" joined by "\x1e", where id is the mentioned contact's buddy name here (the ACI
+// UUID, or an E.164 number from cross-service contact linking) and the text holds "@<name>" for
+// each. Signal sends a mention as U+FFFC in the body and a BodyRange over it (start and length in
+// UTF-16 code units) naming the ACI. Depends on std only: `rustc --test mentions.rs` runs the tests.
+
+/// The placeholder Signal puts in the body where a mention goes.
+pub const MENTION_PLACEHOLDER: char = '\u{FFFC}';
+
+/// A mention in the sent body: the placeholder at `start`, `length` long (both UTF-16 code units),
+/// naming `aci`.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MentionRange {
+    pub start: u32,
+    pub length: u32,
+    pub aci: String,
+}
+
+/// The (id, name) records of a "webos-send-mentions" value. Records with an empty id or name are
+/// left out.
+pub fn parse(raw: &str) -> Vec<(String, String)> {
+    raw.split('\x1e')
+        .filter_map(|record| {
+            let (id, name) = record.split_once('\x1f')?;
+            let (id, name) = (id.trim(), name);
+            if id.is_empty() || name.is_empty() {
+                None
+            } else {
+                Some((id.to_owned(), name.to_owned()))
+            }
+        })
+        .collect()
+}
+
+/// `text` with "@<name>" of each (aci, name) mention replaced by the placeholder, and the ranges
+/// over them, in body order.
+///
+/// Each mention takes one "@<name>" of its own. Longer names take theirs first, so "@Anna" stays
+/// Anna's when Ann is mentioned too; among equally long names the earlier record goes first and
+/// takes the earliest free occurrence. A mention whose "@<name>" is not (or no more) in the text
+/// is left out and the text keeps it as written.
+pub fn apply(text: &str, mentions: &[(String, String)]) -> (String, Vec<MentionRange>) {
+    let mut order: Vec<usize> = (0..mentions.len()).filter(|&i| !mentions[i].1.is_empty()).collect();
+    order.sort_by(|&a, &b| mentions[b].1.len().cmp(&mentions[a].1.len()));
+
+    // byte spans of the text, each with its mention
+    let mut taken: Vec<(usize, usize, usize)> = Vec::new();
+    for i in order {
+        let needle = format!("@{}", mentions[i].1);
+        let mut from = 0;
+        while let Some(found) = text[from..].find(&needle) {
+            let start = from + found;
+            let end = start + needle.len();
+            if taken.iter().all(|&(s, e, _)| end <= s || start >= e) {
+                taken.push((start, end, i));
+                break;
+            }
+            // '@' is one byte, so the next byte starts a character
+            from = start + 1;
+        }
+    }
+    taken.sort_unstable();
+
+    let mut body = String::with_capacity(text.len());
+    let mut ranges = Vec::with_capacity(taken.len());
+    let mut units: usize = 0; // UTF-16 length of `body`
+    let mut last = 0;
+    for (start, end, i) in taken {
+        let before = &text[last..start];
+        units += before.encode_utf16().count();
+        body.push_str(before);
+        ranges.push(MentionRange {
+            start: u32::try_from(units).unwrap_or(u32::MAX),
+            length: MENTION_PLACEHOLDER.len_utf16() as u32,
+            aci: mentions[i].0.clone(),
+        });
+        body.push(MENTION_PLACEHOLDER);
+        units += MENTION_PLACEHOLDER.len_utf16();
+        last = end;
+    }
+    body.push_str(&text[last..]);
+    (body, ranges)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn m(list: &[(&str, &str)]) -> Vec<(String, String)> {
+        list.iter().map(|(a, b)| (a.to_string(), b.to_string())).collect()
+    }
+
+    fn r(start: u32, aci: &str) -> MentionRange {
+        MentionRange { start, length: 1, aci: aci.to_string() }
+    }
+
+    #[test]
+    fn parses_records() {
+        assert_eq!(parse("u1\x1fAnn\x1eu2\x1fBob Smith"), m(&[("u1", "Ann"), ("u2", "Bob Smith")]));
+        assert_eq!(parse(""), m(&[]));
+        assert_eq!(parse("u1\x1f\x1e\x1fBob\x1enoseparator\x1eu3\x1fCy"), m(&[("u3", "Cy")]));
+    }
+
+    #[test]
+    fn replaces_one_mention() {
+        let (body, ranges) = apply("hi @Ann!", &m(&[("u1", "Ann")]));
+        assert_eq!(body, "hi \u{FFFC}!");
+        assert_eq!(ranges, vec![r(3, "u1")]);
+    }
+
+    #[test]
+    fn offsets_count_utf16_units() {
+        // "é" is one UTF-16 unit (two UTF-8 bytes), "😀" two units (four bytes)
+        let (body, ranges) = apply("é😀 @Ann and @Bob", &m(&[("u2", "Bob"), ("u1", "Ann")]));
+        assert_eq!(body, "é😀 \u{FFFC} and \u{FFFC}");
+        assert_eq!(ranges, vec![r(4, "u1"), r(10, "u2")]);
+    }
+
+    #[test]
+    fn the_longer_name_keeps_its_own() {
+        let (body, ranges) = apply("@Anna and @Ann", &m(&[("u1", "Ann"), ("u2", "Anna")]));
+        assert_eq!(body, "\u{FFFC} and \u{FFFC}");
+        assert_eq!(ranges, vec![r(0, "u2"), r(6, "u1")]);
+    }
+
+    #[test]
+    fn the_same_name_twice_takes_two_places() {
+        let (body, ranges) = apply("@Ann @Ann", &m(&[("u1", "Ann"), ("u1", "Ann")]));
+        assert_eq!(body, "\u{FFFC} \u{FFFC}");
+        assert_eq!(ranges, vec![r(0, "u1"), r(2, "u1")]);
+    }
+
+    #[test]
+    fn a_name_not_in_the_text_is_left_out() {
+        let (body, ranges) = apply("hello @Ann", &m(&[("u9", "Zed"), ("u1", "Ann")]));
+        assert_eq!(body, "hello \u{FFFC}");
+        assert_eq!(ranges, vec![r(6, "u1")]);
+        let (body, ranges) = apply("plain", &m(&[]));
+        assert_eq!(body, "plain");
+        assert!(ranges.is_empty());
+    }
+
+    #[test]
+    fn names_with_multibyte_characters() {
+        let (body, ranges) = apply("😀@Zoë 😀 @Łukasz", &m(&[("u1", "Zoë"), ("u2", "Łukasz")]));
+        assert_eq!(body, "😀\u{FFFC} 😀 \u{FFFC}");
+        assert_eq!(ranges, vec![r(2, "u1"), r(7, "u2")]);
+    }
+}

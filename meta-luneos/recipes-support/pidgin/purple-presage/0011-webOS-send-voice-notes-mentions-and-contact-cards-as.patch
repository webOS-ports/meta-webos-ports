diff --git a/src/rust/src/vcard.rs b/src/rust/src/vcard.rs
new file mode 100644
index 0000000..631ea49
--- /dev/null
+++ b/src/rust/src/vcard.rs
@@ -0,0 +1,197 @@
+// webOS: a contact card the user shares from the Messaging app.
+//
+// The transport hands it over as the conversation data "webos-send-contact": a vCard 3.0 with FN
+// and TEL lines. This reads the name and the numbers out of it, for a Signal shared contact
+// (DataMessage.contact). Depends on std only: `rustc --test vcard.rs` runs the tests.
+
+/// The kind of a number, as Signal's Contact.Phone.Type has them.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PhoneKind {
+    Home,
+    Mobile,
+    Work,
+    /// Any other TYPE, with that type as the label.
+    Custom(String),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Phone {
+    pub value: String,
+    pub kind: PhoneKind,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Card {
+    /// FN; empty when the card has none.
+    pub name: String,
+    pub phones: Vec<Phone>,
+}
+
+// The logical lines of a vCard: a line starting with a space or a tab continues the one before
+// (RFC 6350 3.2 / RFC 2425 5.8.1), and both CRLF and LF end a line.
+fn unfold(text: &str) -> Vec<String> {
+    let mut lines: Vec<String> = Vec::new();
+    for raw in text.split('\n') {
+        let raw = raw.strip_suffix('\r').unwrap_or(raw);
+        if let Some(rest) = raw.strip_prefix(' ').or_else(|| raw.strip_prefix('\t')) {
+            if let Some(last) = lines.last_mut() {
+                last.push_str(rest);
+                continue;
+            }
+        }
+        lines.push(raw.to_owned());
+    }
+    lines
+}
+
+// A text value with its backslash escapes undone (\\, \, \; \n \N).
+fn unescape(value: &str) -> String {
+    let mut out = String::with_capacity(value.len());
+    let mut chars = value.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            out.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('n') | Some('N') => out.push('\n'),
+            Some(other) => out.push(other),
+            None => out.push('\\'),
+        }
+    }
+    out
+}
+
+// The kind of a TEL line from its parameters: TYPE=cell,voice, TYPE=cell;TYPE=voice, or the bare
+// "CELL" of vCard 2.1. "pref", "voice" and the like say nothing about the kind.
+fn phone_kind(params: &[&str]) -> PhoneKind {
+    let mut other: Option<String> = None;
+    for param in params {
+        let types = match param.split_once('=') {
+            Some((key, value)) if key.trim().eq_ignore_ascii_case("type") => value,
+            Some(_) => continue,
+            None => param,
+        };
+        for t in types.split(',') {
+            let t = t.trim().trim_matches('"');
+            match t.to_ascii_lowercase().as_str() {
+                "cell" | "mobile" | "iphone" => return PhoneKind::Mobile,
+                "home" => return PhoneKind::Home,
+                "work" => return PhoneKind::Work,
+                "" | "pref" | "voice" | "msg" | "text" | "internet" => {}
+                _ => {
+                    if other.is_none() {
+                        other = Some(t.to_owned());
+                    }
+                }
+            }
+        }
+    }
+    // a number without a kind is taken for a mobile one
+    other.map_or(PhoneKind::Mobile, PhoneKind::Custom)
+}
+
+/// The name and numbers of a vCard; None when it is none (no BEGIN:VCARD) or holds neither.
+pub fn parse(text: &str) -> Option<Card> {
+    let mut in_card = false;
+    let mut name = String::new();
+    let mut phones = Vec::new();
+    for line in unfold(text) {
+        let Some((head, value)) = line.split_once(':') else { continue };
+        let mut parts = head.split(';');
+        let property = parts.next().unwrap_or("").trim();
+        // "item1.TEL": a group prefix
+        let property = property.rsplit('.').next().unwrap_or(property);
+        let params: Vec<&str> = parts.collect();
+        if property.eq_ignore_ascii_case("begin") && value.trim().eq_ignore_ascii_case("vcard") {
+            in_card = true;
+        } else if property.eq_ignore_ascii_case("end") && value.trim().eq_ignore_ascii_case("vcard") {
+            break;
+        } else if !in_card {
+            continue;
+        } else if property.eq_ignore_ascii_case("fn") && name.is_empty() {
+            name = unescape(value).trim().to_owned();
+        } else if property.eq_ignore_ascii_case("tel") {
+            let number = value.trim();
+            // vCard 4 writes the number as a tel: URI
+            let number = number.strip_prefix("tel:").or_else(|| number.strip_prefix("TEL:")).unwrap_or(number);
+            let number = unescape(number).trim().to_owned();
+            if !number.is_empty() {
+                phones.push(Phone { value: number, kind: phone_kind(&params) });
+            }
+        }
+    }
+    if !in_card || (name.is_empty() && phones.is_empty()) {
+        return None;
+    }
+    Some(Card { name, phones })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn phone(value: &str, kind: PhoneKind) -> Phone {
+        Phone { value: value.to_owned(), kind }
+    }
+
+    #[test]
+    fn reads_name_and_numbers() {
+        let card = parse("BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Ann Example\r\nN:Example;Ann;;;\r\nTEL;TYPE=CELL:+31 6 1234 5678\r\nTEL;TYPE=HOME,VOICE:020 123 4567\r\nTEL;TYPE=work:+1-555-0100\r\nEND:VCARD\r\n").unwrap();
+        assert_eq!(card.name, "Ann Example");
+        assert_eq!(
+            card.phones,
+            vec![
+                phone("+31 6 1234 5678", PhoneKind::Mobile),
+                phone("020 123 4567", PhoneKind::Home),
+                phone("+1-555-0100", PhoneKind::Work),
+            ]
+        );
+    }
+
+    #[test]
+    fn kinds_from_other_forms() {
+        let card = parse("BEGIN:VCARD\nFN:B\nTEL;CELL:1\nTEL;TYPE=voice;TYPE=home:2\nTEL:3\nTEL;TYPE=fax:4\nTEL;TYPE=pref:5\nitem1.TEL;type=WORK:6\nTEL;HOME:7\nEND:VCARD").unwrap();
+        assert_eq!(
+            card.phones,
+            vec![
+                phone("1", PhoneKind::Mobile),
+                phone("2", PhoneKind::Home),
+                phone("3", PhoneKind::Mobile),
+                phone("4", PhoneKind::Custom("fax".to_owned())),
+                phone("5", PhoneKind::Mobile),
+                phone("6", PhoneKind::Work),
+                phone("7", PhoneKind::Home),
+            ]
+        );
+    }
+
+    #[test]
+    fn folded_and_escaped_values() {
+        let card = parse("BEGIN:VCARD\r\nFN:Smith\\, John\r\n  Jr.\r\nTEL;VALUE=uri;TYPE=cell:tel:+15550100\r\nEND:VCARD").unwrap();
+        assert_eq!(card.name, "Smith, John Jr.");
+        assert_eq!(card.phones, vec![phone("+15550100", PhoneKind::Mobile)]);
+    }
+
+    #[test]
+    fn only_the_first_card_and_only_inside_it() {
+        let card = parse("FN:Outside\nBEGIN:VCARD\nFN:Inside\nFN:Second name\nEND:VCARD\nBEGIN:VCARD\nTEL:9\nEND:VCARD").unwrap();
+        assert_eq!(card.name, "Inside");
+        assert!(card.phones.is_empty());
+    }
+
+    #[test]
+    fn no_card() {
+        assert_eq!(parse(""), None);
+        assert_eq!(parse("FN:Ann\nTEL:1"), None);
+        assert_eq!(parse("BEGIN:VCARD\nVERSION:3.0\nEND:VCARD"), None);
+        assert_eq!(parse("BEGIN:VCARD\nTEL:   \nEND:VCARD"), None);
+    }
+
+    #[test]
+    fn a_card_with_numbers_but_no_name() {
+        let card = parse("BEGIN:VCARD\nTEL:+15550100\nEND:VCARD").unwrap();
+        assert_eq!(card.name, "");
+        assert_eq!(card.phones, vec![phone("+15550100", PhoneKind::Mobile)]);
+    }
+}

new file mode 100644
index 0000000..2c338c4
--- /dev/null
+++ b/src/rust/src/voice_note.rs
@@ -0,0 +1,60 @@
+/*
+ * webOS voice messages.
+ *
+ * The Messaging app records a voice message with com.webos.service.mediarecorder, which writes an
+ * M4A (AAC in an MP4 container) into the app's attachment folder. Sniffing the bytes calls any
+ * MP4 container video/mp4, so Signal showed these as videos. A recording goes out as audio/mp4
+ * with the voice-note flag; any other .m4a as audio/mp4.
+ */
+
+/// The folder the Messaging app records voice messages into (VOICENOTE_RECORDING_DIR in
+/// imlibpurpleservice).
+const RECORDING_DIR: &str = "/media/internal/.im-attachments/";
+
+fn is_m4a(name: &str) -> bool {
+    name.len() > 4 && name.to_ascii_lowercase().ends_with(".m4a")
+}
+
+/// A voice message the Messaging app recorded: an .m4a straight in its recording folder. Files the
+/// transports saved there sit in subfolders, and a song picked to send comes from elsewhere.
+pub fn is_recorded(path: &str) -> bool {
+    path.strip_prefix(RECORDING_DIR)
+        .map_or(false, |name| !name.contains('/') && is_m4a(name))
+}
+
+/// The content type to send a file as: audio/mp4 for an .m4a, otherwise what the bytes say.
+pub fn content_type<'a>(path: &str, sniffed: &'a str) -> &'a str {
+    let name = path.rsplit('/').next().unwrap_or(path);
+    if is_m4a(name) { "audio/mp4" } else { sniffed }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_recording_is_an_m4a_straight_in_the_folder() {
+        assert!(is_recorded("/media/internal/.im-attachments/Audio04112026-07285605.m4a"));
+        assert!(is_recorded("/media/internal/.im-attachments/Audio.M4A"));
+    }
+
+    #[test]
+    fn everything_else_is_not_a_recording() {
+        assert!(!is_recorded("/media/internal/music/song.m4a"));
+        assert!(!is_recorded("/media/internal/.im-attachments/signal/in.m4a"));
+        assert!(!is_recorded("/media/internal/.im-attachments/../music/song.m4a"));
+        assert!(!is_recorded("/media/internal/.im-attachments/Audio.ogg"));
+        assert!(!is_recorded("/media/internal/.im-attachments/.m4a"));
+        assert!(!is_recorded("/media/internal/.im-attachments/"));
+        assert!(!is_recorded(""));
+    }
+
+    #[test]
+    fn an_m4a_goes_as_audio_and_the_rest_as_sniffed() {
+        assert_eq!(content_type("/media/internal/.im-attachments/Audio.m4a", "video/mp4"), "audio/mp4");
+        assert_eq!(content_type("/media/internal/music/song.M4A", "video/mp4"), "audio/mp4");
+        assert_eq!(content_type("/media/internal/DCIM/clip.mp4", "video/mp4"), "video/mp4");
+        assert_eq!(content_type("/media/internal/a.m4a/clip.mp4", "video/mp4"), "video/mp4");
+        assert_eq!(content_type("/media/internal/pic.jpg", "image/jpeg"), "image/jpeg");
+    }
+}

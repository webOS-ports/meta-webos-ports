diff --git a/src/rust/src/bridge_commands.rs b/src/rust/src/bridge_commands.rs
index a341d87..0cd8da1 100755
--- a/src/rust/src/bridge_commands.rs
+++ b/src/rust/src/bridge_commands.rs
@@ -91,6 +91,22 @@ pub unsafe extern "C" fn presage_rust_set_call_video(
     send_cmd(account, tx, cmd);
 }
 
+/// How the phone is held in call `call_id` (call.c's changeMedia handler): the shell's quarter
+/// turns, 0..3; anything else is ignored.
+#[no_mangle]
+pub unsafe extern "C" fn presage_rust_set_call_turn(
+    account: *mut crate::bridge_structs::PurpleAccount,
+    tx: *mut tokio::sync::mpsc::Sender<crate::structs::Cmd>,
+    call_id: u64,
+    turns: std::os::raw::c_int,
+) {
+    if !(0..=3).contains(&turns) {
+        return;
+    }
+    let cmd = crate::structs::Cmd::SetCallTurn { call_id, turns: turns as u8 };
+    send_cmd(account, tx, cmd);
+}
+
 /// The user tapped Answer on an incoming call: tell the media engine to emit the RingRTC rtp-data
 /// `Accepted` so the caller connects (stops ringing + ungates audio). Local only, no callee needed.
 #[no_mangle]
diff --git a/src/rust/src/call_bridge.rs b/src/rust/src/call_bridge.rs
index f6378e7..d8d14c9 100644
--- a/src/rust/src/call_bridge.rs
+++ b/src/rust/src/call_bridge.rs
@@ -374,6 +374,24 @@ pub fn set_video(call_id: u64, on: bool) {
     }
 }
 
+/// How the phone is held, per call (the shell's quarter turns): set when the Phone app says
+/// (changeMedia deviceOrientation), and handed to the engine when it starts.
+static TURNS: OnceLock<Mutex<HashMap<u64, u8>>> = OnceLock::new();
+fn turns() -> &'static Mutex<HashMap<u64, u8>> {
+    TURNS.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// The phone is held `n` quarter turns round in `call_id`: the engine sends that with our picture.
+/// Before the engine runs it is remembered and given to the engine when it starts.
+pub fn set_turn(call_id: u64, n: u8) {
+    turns().lock().unwrap().insert(call_id, n);
+    let mut guard = calls().lock().unwrap();
+    if let Some(cp) = guard.get_mut(&call_id) {
+        let _ = cp.stdin.write_all(crate::call_video::turn_command(n).as_bytes());
+        let _ = cp.stdin.flush();
+    }
+}
+
 /// call_ids the user has ACCEPTED on THIS (linked) device. LuneOS is a secondary Signal device; an
 /// incoming call rings this device AND the user's primary phone. When we accept, the caller broadcasts
 /// `Hangup{type=ACCEPTED, device_id=<us>}` to the account so the OTHER devices stop ringing - but Signal
@@ -499,6 +517,9 @@ pub fn on_answer(call_id: u64, answer_opaque: &[u8]) -> Result<bool, String> {
     if video_wanted().lock().unwrap().get(&call_id).copied().unwrap_or(false) {
         let _ = stdin.write_all(crate::call_video::video_command(true).as_bytes());
     }
+    if let Some(n) = turns().lock().unwrap().get(&call_id).copied() {
+        let _ = stdin.write_all(crate::call_video::turn_command(n).as_bytes());
+    }
 
     // Flush any remote ICE that arrived between our Offer and this Answer.
     for op in &p.buffered_ice {
@@ -556,6 +577,7 @@ pub fn stop(call_id: u64) {
     outgoing().lock().unwrap().remove(&call_id);
     accepted().lock().unwrap().remove(&call_id);
     video_wanted().lock().unwrap().remove(&call_id);
+    turns().lock().unwrap().remove(&call_id);
     dialed().lock().unwrap().remove(&call_id);
     peers().lock().unwrap().remove(&call_id);
     let cp = calls().lock().unwrap().remove(&call_id);

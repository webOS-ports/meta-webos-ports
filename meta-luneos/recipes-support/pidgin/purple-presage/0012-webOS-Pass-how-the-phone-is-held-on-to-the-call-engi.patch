+static void test_json_turns(void)
+{
+    CHECK(call_video_json_turns("{\"id\":\"sig-1\",\"deviceOrientation\":0}") == 0);
+    CHECK(call_video_json_turns("{\"deviceOrientation\" : 3}") == 3);
+    CHECK(call_video_json_turns("{\"deviceOrientation\":2,\"id\":\"sig-1\"}") == 2);
+    CHECK(call_video_json_turns("{\"deviceOrientation\":4}") == -1);
+    CHECK(call_video_json_turns("{\"deviceOrientation\":10}") == -1);
+    CHECK(call_video_json_turns("{\"deviceOrientation\":1.5}") == -1);
+    CHECK(call_video_json_turns("{\"deviceOrientation\":\"1\"}") == -1);
+    CHECK(call_video_json_turns("{\"outgoingVideo\":true}") == -1);
+    CHECK(call_video_json_turns(NULL) == -1);
+}

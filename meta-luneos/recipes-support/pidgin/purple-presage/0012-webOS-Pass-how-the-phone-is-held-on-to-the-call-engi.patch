diff --git a/src/c/call_video.c b/src/c/call_video.c
index 4deec75..393ff8e 100644
--- a/src/c/call_video.c
+++ b/src/c/call_video.c
@@ -146,3 +146,21 @@ int call_video_json_bool(const char *payload, const char *key)
         return 0;
     return -1;
 }
+
+int call_video_json_turns(const char *payload)
+{
+    const char *k = payload ? strstr(payload, "\"deviceOrientation\"") : NULL;
+    if (!k)
+        return -1;
+    const char *c = k + strlen("\"deviceOrientation\"");
+    while (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r')
+        c++;
+    if (*c != ':')
+        return -1;
+    c++;
+    while (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r')
+        c++;
+    if (*c < '0' || *c > '3' || (c[1] >= '0' && c[1] <= '9') || c[1] == '.')
+        return -1;
+    return *c - '0';
+}

     (void)ctx;
@@ -246,8 +248,11 @@ static bool cb_change_media(LSHandle *sh, LSMessage *msg, void *ctx)
     }
     int out = call_video_json_bool(payload, "outgoingVideo");
     int in = call_video_json_bool(payload, "incomingVideo");
+    int turns = call_video_json_turns(payload);
     if (out >= 0 && presage)
         presage_rust_set_call_video(g_account, presage->tx_ptr, g_call_id, out);
+    if (turns >= 0 && presage)
+        presage_rust_set_call_turn(g_account, presage->tx_ptr, g_call_id, turns);

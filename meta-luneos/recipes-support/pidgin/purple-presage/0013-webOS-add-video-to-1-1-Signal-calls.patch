index 0000000..f45e5fa
--- /dev/null
+++ b/src/rust/src/call_video.rs
@@ -0,0 +1,227 @@
+//! Video in a 1:1 Signal call: what the media engine says about it, and the Offer's call type.
+//!
+//! The engine (luneos-synergy-connectors im/signal/calling/media) receives and sends the video
+//! itself; it reports on stdout where the pictures are and what each side's camera does:
+//!
+//!   VSHM <path> <w> <h>              the far side's decoded picture is on this gst-shm socket
+//!   VPREVIEW <path> <w> <h> <q> <m>  our camera's picture (q quarter turns, m mirrored 0/1)
+//!   VTX <0|1>                        our camera is sending / stopped
+//!   PEERVIDEO <0|1>                  the far side says its camera is on / off
+//!   PEERROT <q>                      the far side's picture needs q quarter turns
+//!   VIDEOERR <what>                  something could not be set up
+//!
+//! and it takes `VIDEO <0|1>` (our camera) and `CALLID <id>` (our outgoing call's id). call.c turns
+//! the events into the Phone app's line and payload video fields. No dependencies beyond std, so
+//! `rustc --test call_video.rs` runs these tests on their own.
+
+/// RingRTC's CallMessage.Offer.Type (SignalService.proto).
+pub const OFFER_AUDIO_CALL: i32 = 0;
+pub const OFFER_VIDEO_CALL: i32 = 1;
+
+/// The Offer type for a call placed with or without video.
+pub fn offer_type(video: bool) -> i32 {
+    if video { OFFER_VIDEO_CALL } else { OFFER_AUDIO_CALL }
+}
+
+/// True if an Offer of this type is a video call. A missing type is an audio call (the proto's
+/// default).
+pub fn offer_is_video(t: Option<i32>) -> bool {
+    t == Some(OFFER_VIDEO_CALL)
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum VideoEvent {
+    /// An incoming Offer was a video call (from receive.rs, not the engine).
+    Offered,
+    Shm { path: String, width: u32, height: u32 },
+    Preview { path: String, width: u32, height: u32, quarter_turns: u8, mirrored: bool },
+    Sending(bool),
+    PeerCamera(bool),
+    PeerRotation(u8),
+    Error(String),
+}
+
+/// The kinds call.c's presage_handle_call_video takes (must match call_video.h).
+pub const KIND_OFFERED: u32 = 0;
+pub const KIND_SHM: u32 = 1;
+pub const KIND_PREVIEW: u32 = 2;
+pub const KIND_SENDING: u32 = 3;
+pub const KIND_PEER_CAMERA: u32 = 4;
+pub const KIND_PEER_ROTATION: u32 = 5;
+pub const KIND_ERROR: u32 = 6;
+
+/// The event as call.c's arguments: (kind, a, b, c, d, text). For Shm a/b are the size; for Preview
+/// a/b the size, c the quarter turns, d mirrored; for the on/off kinds a is 0 or 1; for
+/// PeerRotation a is the quarter turns. text is the path or the error, else empty.
+pub fn ffi_args(ev: &VideoEvent) -> (u32, i32, i32, i32, i32, String) {
+    match ev {
+        VideoEvent::Offered => (KIND_OFFERED, 0, 0, 0, 0, String::new()),
+        VideoEvent::Shm { path, width, height } => {
+            (KIND_SHM, *width as i32, *height as i32, 0, 0, path.clone())
+        }
+        VideoEvent::Preview { path, width, height, quarter_turns, mirrored } => (
+            KIND_PREVIEW,
+            *width as i32,
+            *height as i32,
+            *quarter_turns as i32,
+            *mirrored as i32,
+            path.clone(),
+        ),
+        VideoEvent::Sending(on) => (KIND_SENDING, *on as i32, 0, 0, 0, String::new()),
+        VideoEvent::PeerCamera(on) => (KIND_PEER_CAMERA, *on as i32, 0, 0, 0, String::new()),
+        VideoEvent::PeerRotation(q) => (KIND_PEER_ROTATION, *q as i32, 0, 0, 0, String::new()),
+        VideoEvent::Error(what) => (KIND_ERROR, 0, 0, 0, 0, what.clone()),
+    }
+}
+
+fn flag(s: &str) -> Option<bool> {
+    match s {
+        "0" => Some(false),
+        "1" => Some(true),
+        _ => None,
+    }
+}
+
+/// A picture size the Phone app can take: 1..=4096 each way.
+fn dim(s: &str) -> Option<u32> {
+    s.parse::<u32>().ok().filter(|v| (1..=4096).contains(v))
+}
+
+fn quarter(s: &str) -> Option<u8> {
+    s.parse::<u8>().ok().filter(|q| *q < 4)
+}
+
+/// A socket path the engine may name: absolute, no "..", no quote or backslash (it goes into
+/// JSON) and no control characters.
+fn shm_path(s: &str) -> Option<String> {
+    let ok = s.starts_with('/')
+        && s.len() < 108 // sun_path
+        && !s.split('/').any(|c| c == "..")
+        && !s.chars().any(|c| c == '"' || c == '\\' || c.is_control());
+    ok.then(|| s.to_string())
+}
+
+/// Parse one line of the engine's stdout. None for lines that are not about video, or are malformed.
+pub fn parse_engine_line(line: &str) -> Option<VideoEvent> {
+    let mut it = line.split_ascii_whitespace();
+    let word = it.next()?;
+    let rest: Vec<&str> = it.collect();
+    let ev = match (word, rest.as_slice()) {
+        ("VSHM", [p, w, h]) => VideoEvent::Shm { path: shm_path(p)?, width: dim(w)?, height: dim(h)? },
+        ("VPREVIEW", [p, w, h, q, m]) => VideoEvent::Preview {
+            path: shm_path(p)?,
+            width: dim(w)?,
+            height: dim(h)?,
+            quarter_turns: quarter(q)?,
+            mirrored: flag(m)?,
+        },
+        ("VTX", [v]) => VideoEvent::Sending(flag(v)?),
+        ("PEERVIDEO", [v]) => VideoEvent::PeerCamera(flag(v)?),
+        ("PEERROT", [q]) => VideoEvent::PeerRotation(quarter(q)?),
+        ("VIDEOERR", [what]) if what.chars().all(|c| c.is_ascii_alphanumeric() || c == '-') => {
+            VideoEvent::Error(what.to_string())
+        }
+        _ => return None,
+    };
+    Some(ev)
+}
+
+/// The engine's command for our camera.
+pub fn video_command(on: bool) -> String {
+    format!("VIDEO {}\n", on as u8)
+}
+
+/// The engine's command naming our outgoing call (it goes into SenderStatus).
+pub fn call_id_command(call_id: u64) -> String {
+    format!("CALLID {call_id}\n")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn offer_types() {
+        assert_eq!(offer_type(false), 0);
+        assert_eq!(offer_type(true), 1);
+        assert!(offer_is_video(Some(1)));
+        assert!(!offer_is_video(Some(0)));
+        assert!(!offer_is_video(None));
+        assert!(!offer_is_video(Some(2)));
+    }
+
+    #[test]
+    fn engine_lines() {
+        assert_eq!(
+            parse_engine_line("VSHM /tmp/signal-video 640 480"),
+            Some(VideoEvent::Shm { path: "/tmp/signal-video".into(), width: 640, height: 480 })
+        );
+        assert_eq!(
+            parse_engine_line("VPREVIEW /tmp/signal-preview 320 240 1 1"),
+            Some(VideoEvent::Preview {
+                path: "/tmp/signal-preview".into(),
+                width: 320,
+                height: 240,
+                quarter_turns: 1,
+                mirrored: true
+            })
+        );
+        assert_eq!(parse_engine_line("VTX 1"), Some(VideoEvent::Sending(true)));
+        assert_eq!(parse_engine_line("VTX 0"), Some(VideoEvent::Sending(false)));
+        assert_eq!(parse_engine_line("PEERVIDEO 0"), Some(VideoEvent::PeerCamera(false)));
+        assert_eq!(parse_engine_line("PEERVIDEO 1"), Some(VideoEvent::PeerCamera(true)));
+        assert_eq!(parse_engine_line("PEERROT 3"), Some(VideoEvent::PeerRotation(3)));
+        assert_eq!(parse_engine_line("VIDEOERR tx-encoder"), Some(VideoEvent::Error("tx-encoder".into())));
+    }
+
+    #[test]
+    fn other_and_bad_lines() {
+        for l in [
+            "",
+            "PUB 00",
+            "CAND candidate:1 1 udp 1 1.2.3.4 5 typ host",
+            "READY",
+            "VSHM /tmp/x 640",              // missing a field
+            "VSHM /tmp/x 640 480 1",        // one too many
+            "VSHM tmp/x 640 480",           // relative
+            "VSHM /tmp/../etc/x 640 480",   // ..
+            "VSHM /tmp/a\"b 640 480",       // a quote would break the JSON
+            "VSHM /tmp/x 0 480",
+            "VSHM /tmp/x 640 99999",
+            "VSHM /tmp/x -1 480",
+            "VPREVIEW /tmp/p 320 240 4 0",  // quarter turns 0..3
+            "VPREVIEW /tmp/p 320 240 1 2",
+            "VTX 2",
+            "VTX",
+            "PEERROT 4",
+            "PEERROT -1",
+            "VIDEOERR",
+            "VIDEOERR bad\"thing",
+            "vtx 1",
+        ] {
+            assert_eq!(parse_engine_line(l), None, "{l:?}");
+        }
+        let long = format!("VSHM /{} 640 480", "a".repeat(120));
+        assert_eq!(parse_engine_line(&long), None);
+    }
+
+    #[test]
+    fn ffi() {
+        let p = VideoEvent::Preview { path: "/p".into(), width: 320, height: 240, quarter_turns: 3, mirrored: true };
+        assert_eq!(ffi_args(&p), (KIND_PREVIEW, 320, 240, 3, 1, "/p".to_string()));
+        let s = VideoEvent::Shm { path: "/v".into(), width: 640, height: 480 };
+        assert_eq!(ffi_args(&s), (KIND_SHM, 640, 480, 0, 0, "/v".to_string()));
+        assert_eq!(ffi_args(&VideoEvent::PeerCamera(true)).1, 1);
+        assert_eq!(ffi_args(&VideoEvent::Sending(false)), (KIND_SENDING, 0, 0, 0, 0, String::new()));
+        assert_eq!(ffi_args(&VideoEvent::PeerRotation(2)).0, KIND_PEER_ROTATION);
+        assert_eq!(ffi_args(&VideoEvent::Offered).0, KIND_OFFERED);
+        assert_eq!(ffi_args(&VideoEvent::Error("x".into())), (KIND_ERROR, 0, 0, 0, 0, "x".to_string()));
+    }
+
+    #[test]
+    fn commands() {
+        assert_eq!(video_command(true), "VIDEO 1\n");
+        assert_eq!(video_command(false), "VIDEO 0\n");
+        assert_eq!(call_id_command(18446744073709551615), "CALLID 18446744073709551615\n");
+    }
+}

+/* heap-marshalled video event (see call_video.h for the kinds) */
+typedef struct {
+    uint64_t call_id;
+    guint    kind;
+    int      a, b, c, d;
+    char    *text;
+} VideoEvt;
+
+/* runs on the MAIN thread: apply a video event of the call on the card and push it */
+static gboolean call_video_event_apply(gpointer data)
+{
+    VideoEvt *e = (VideoEvt *)data;
+    if (!g_state || !e->call_id || e->call_id != g_call_id) {
+        purple_debug_info(PLUGIN_NAME, "call: ignoring video event %u of another call\n", e->kind);
+    } else if (e->kind == CALL_VIDEO_ERROR) {
+        purple_debug_warning(PLUGIN_NAME, "call: video: %s\n", e->text ? e->text : "error");
+    } else {
+        gboolean was_video = call_video_active(&g_video);
+        if (call_video_apply(&g_video, e->kind, e->a, e->b, e->c, e->d, e->text)) {
+            push_state();
+            /* A voice call that turned into a video call: tell audiod again. */
+            if (g_strcmp0(g_state, "active") == 0 && was_video != call_video_active(&g_video))
+                audiod_report_active();
+        }
+    }
+    g_free(e->text);
+    g_free(e);
+    return FALSE;
+}
+
+/* Called from the Rust side (the engine's reader threads, the receive and command loops) with the
+ * engine's video events. Marshals to the main thread like presage_handle_call_state. */
+void presage_handle_call_video(uint64_t call_id, uint32_t kind, int32_t a, int32_t b, int32_t c, int32_t d,
+                               const char *text)
+{
+    VideoEvt *e = g_new0(VideoEvt, 1);
+    e->call_id = call_id;
+    e->kind = kind;
+    e->a = a; e->b = b; e->c = c; e->d = d;
+    e->text = g_strdup(text);
+    purple_timeout_add(0, call_video_event_apply, e);
+}
diff --git a/src/c/call_video.c b/src/c/call_video.c
new file mode 100644
index 0000000..4deec75
--- /dev/null
+++ b/src/c/call_video.c
@@ -0,0 +1,148 @@
+/* Video in a 1:1 Signal call, as the Phone app sees it (see call_video.h).
+ *
+ * The Phone app (SynergyTransport._applyVideo) reads, per line, incomingVideo, outgoingVideo,
+ * incomingVideoState ("unavailable", "available" or "streaming") and incomingVideoOrientation
+ * (quarter turns counter-clockwise), and from the payload videoURI with its size (the gst-shm
+ * socket its RemoteVideo reads) and the self-view's videoPreviewURI, size, orientation and
+ * mirroring. The preview is only read when there is a videoURI. */
+
+#include "call_video.h"
+#include <string.h>
+
+void call_video_reset(CallVideo *v)
+{
+    g_free(v->uri);
+    g_free(v->preview);
+    memset(v, 0, sizeof *v);
+    v->show_incoming = TRUE;
+}
+
+/* Socket paths go into JSON unescaped: the Rust side passes only absolute paths without quotes,
+ * backslashes or control characters; anything else is refused here too. */
+static gboolean path_ok(const char *p)
+{
+    if (!p || p[0] != '/' || strlen(p) >= 108)
+        return FALSE;
+    for (const char *c = p; *c; c++)
+        if (*c == '"' || *c == '\\' || (unsigned char)*c < 0x20)
+            return FALSE;
+    return TRUE;
+}
+
+static gboolean dims_ok(int w, int h)
+{
+    return w > 0 && w <= 4096 && h > 0 && h <= 4096;
+}
+
+static gboolean set_flag(gboolean *slot, int a)
+{
+    gboolean on = a != 0;
+    if (*slot == on)
+        return FALSE;
+    *slot = on;
+    return TRUE;
+}
+
+gboolean call_video_apply(CallVideo *v, guint kind, int a, int b, int c, int d, const char *text)
+{
+    switch (kind) {
+    case CALL_VIDEO_OFFERED:
+        return set_flag(&v->offered, 1);
+    case CALL_VIDEO_SHM:
+        if (!path_ok(text) || !dims_ok(a, b))
+            return FALSE;
+        if (!g_strcmp0(v->uri, text) && v->width == a && v->height == b)
+            return FALSE;
+        g_free(v->uri);
+        v->uri = g_strdup(text);
+        v->width = a;
+        v->height = b;
+        return TRUE;
+    case CALL_VIDEO_PREVIEW:
+        if (!path_ok(text) || !dims_ok(a, b) || c < 0 || c > 3)
+            return FALSE;
+        g_free(v->preview);
+        v->preview = g_strdup(text);
+        v->preview_width = a;
+        v->preview_height = b;
+        v->preview_turns = c;
+        v->preview_mirrored = d != 0;
+        return TRUE;
+    case CALL_VIDEO_SENDING:
+        return set_flag(&v->sending, a);
+    case CALL_VIDEO_PEER_CAMERA:
+        return set_flag(&v->peer_camera, a);
+    case CALL_VIDEO_PEER_ROTATION:
+        if (a < 0 || a > 3 || v->peer_rotation == a)
+            return FALSE;
+        v->peer_rotation = a;
+        return TRUE;
+    case CALL_VIDEO_ERROR:
+    default:
+        return FALSE;
+    }
+}
+
+gboolean call_video_active(const CallVideo *v)
+{
+    return v->offered || v->peer_camera || v->sending;
+}
+
+static const char *incoming_state(const CallVideo *v)
+{
+    if (v->show_incoming && v->peer_camera && v->uri)
+        return "streaming";
+    if (v->offered || v->peer_camera)
+        return "available";
+    return "unavailable";
+}
+
+gchar *call_video_line_fields(const CallVideo *v)
+{
+    return g_strdup_printf("\"incomingVideo\":%s,\"outgoingVideo\":%s,"
+                           "\"incomingVideoState\":\"%s\",\"incomingVideoOrientation\":%d",
+                           v->show_incoming && v->peer_camera ? "true" : "false",
+                           v->sending ? "true" : "false",
+                           incoming_state(v), v->peer_rotation);
+}
+
+gchar *call_video_payload_fields(const CallVideo *v)
+{
+    if (!v->uri || !v->show_incoming)
+        return g_strdup("");
+    GString *s = g_string_new(NULL);
+    g_string_append_printf(s, ",\"videoURI\":\"%s\",\"videoWidth\":%d,\"videoHeight\":%d",
+                           v->uri, v->width, v->height);
+    if (v->preview && v->sending)
+        g_string_append_printf(s, ",\"videoPreviewURI\":\"%s\",\"videoPreviewWidth\":%d,"
+                                  "\"videoPreviewHeight\":%d,\"videoPreviewOrientation\":%d,"
+                                  "\"videoPreviewMirrored\":%s",
+                               v->preview, v->preview_width, v->preview_height, v->preview_turns,
+                               v->preview_mirrored ? "true" : "false");
+    return g_string_free(s, FALSE);
+}
+
+int call_video_json_bool(const char *payload, const char *key)
+{
+    if (!payload || !key)
+        return -1;
+    gchar *needle = g_strdup_printf("\"%s\"", key);
+    const char *k = strstr(payload, needle);
+    gsize nl = strlen(needle);
+    g_free(needle);
+    if (!k)
+        return -1;
+    const char *c = k + nl;
+    while (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r')
+        c++;
+    if (*c != ':')
+        return -1;
+    c++;
+    while (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r')
+        c++;
+    if (!strncmp(c, "true", 4))
+        return 1;
+    if (!strncmp(c, "false", 5))
+        return 0;
+    return -1;
+}
diff --git a/src/c/call_video.h b/src/c/call_video.h
new file mode 100644
index 0000000..c78ecbc
--- /dev/null
+++ b/src/c/call_video.h
@@ -0,0 +1,51 @@
+/* Video in a 1:1 Signal call, as the Phone app sees it: the state call.c keeps from the media
+ * engine's video lines (call_video.rs) and the JSON fields it adds to callStateQuery. GLib only, so
+ * tests/test_call_video.c runs it on its own. */
+#ifndef PRESAGE_CALL_VIDEO_H
+#define PRESAGE_CALL_VIDEO_H
+
+#include <glib.h>
+
+/* The kinds presage_handle_call_video takes (must match call_video.rs). */
+#define CALL_VIDEO_OFFERED        0u  /* an incoming Offer was a video call, or we dialled one */
+#define CALL_VIDEO_SHM            1u  /* a, b: size; text: the far side's picture socket */
+#define CALL_VIDEO_PREVIEW        2u  /* a, b: size; c: quarter turns; d: mirrored; text: socket */
+#define CALL_VIDEO_SENDING        3u  /* a: our camera sends (1) or stopped (0) */
+#define CALL_VIDEO_PEER_CAMERA    4u  /* a: the far side's camera on (1) or off (0) */
+#define CALL_VIDEO_PEER_ROTATION  5u  /* a: quarter turns for the far side's picture */
+#define CALL_VIDEO_ERROR          6u  /* text: what failed */
+
+typedef struct {
+    gboolean offered;        /* a video call from the start */
+    gboolean show_incoming;  /* the user wants the far side's picture (changeMedia incomingVideo) */
+    gboolean peer_camera;    /* the far side says its camera is on */
+    gboolean sending;        /* our camera is sending */
+    int      peer_rotation;  /* 0..3 */
+    gchar   *uri;            /* the far side's picture: gst-shm socket path, or NULL */
+    int      width, height;
+    gchar   *preview;        /* our camera's self-view socket, or NULL */
+    int      preview_width, preview_height, preview_turns;
+    gboolean preview_mirrored;
+} CallVideo;
+
+/* Back to a voice call with nothing known (frees the strings). */
+void call_video_reset(CallVideo *v);
+
+/* Apply one event. Returns TRUE if what the Phone app sees changed. */
+gboolean call_video_apply(CallVideo *v, guint kind, int a, int b, int c, int d, const char *text);
+
+/* True if the call is a video call in either direction (for audiod's "video"). */
+gboolean call_video_active(const CallVideo *v);
+
+/* The line's fields, without braces: "incomingVideo":..,"outgoingVideo":..,
+ * "incomingVideoState":"..","incomingVideoOrientation":n */
+gchar *call_video_line_fields(const CallVideo *v);
+
+/* The payload's fields, each preceded by a comma, or "" when there is no picture to show:
+ * ,"videoURI":"..","videoWidth":w,"videoHeight":h[,"videoPreviewURI":.. ...] */
+gchar *call_video_payload_fields(const CallVideo *v);
+
+/* A boolean field of a flat JSON object: 1 true, 0 false, -1 absent or not a boolean. */
+int call_video_json_bool(const char *payload, const char *key);
+
+#endif

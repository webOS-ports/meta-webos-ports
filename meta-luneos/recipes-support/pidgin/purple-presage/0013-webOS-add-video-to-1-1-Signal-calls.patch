new file mode 100644
index 0000000..40e7311
--- /dev/null
+++ b/src/c/tests/test_call_video.c
@@ -0,0 +1,129 @@
+/* Unit test for call_video.c: build with glib-2.0 only, e.g.
+ *   cc -I.. test_call_video.c ../call_video.c $(pkg-config --cflags --libs glib-2.0) */
+#include "call_video.h"
+#include <stdio.h>
+#include <string.h>
+
+static int failures;
+#define CHECK(c) do { if (!(c)) { failures++; fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+static gboolean has(const gchar *s, const char *sub) { return s && strstr(s, sub) != NULL; }
+
+static void test_voice_call(void)
+{
+    CallVideo v = {0};
+    call_video_reset(&v);
+    CHECK(!call_video_active(&v));
+    gchar *l = call_video_line_fields(&v), *p = call_video_payload_fields(&v);
+    CHECK(!strcmp(l, "\"incomingVideo\":false,\"outgoingVideo\":false,"
+                     "\"incomingVideoState\":\"unavailable\",\"incomingVideoOrientation\":0"));
+    CHECK(!strcmp(p, ""));
+    g_free(l); g_free(p);
+    call_video_reset(&v);
+}
+
+static void test_video_call(void)
+{
+    CallVideo v = {0};
+    call_video_reset(&v);
+    CHECK(call_video_apply(&v, CALL_VIDEO_OFFERED, 0, 0, 0, 0, NULL));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_OFFERED, 0, 0, 0, 0, NULL));   /* no change */
+    CHECK(call_video_active(&v));
+    gchar *l = call_video_line_fields(&v);
+    CHECK(has(l, "\"incomingVideoState\":\"available\""));   /* rings as a video call */
+    CHECK(has(l, "\"incomingVideo\":false"));
+    g_free(l);
+
+    /* The picture's socket alone is not streaming: the far side has not said its camera is on. */
+    CHECK(call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, "/tmp/signal-video"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, "/tmp/signal-video"));
+    l = call_video_line_fields(&v);
+    CHECK(has(l, "\"incomingVideoState\":\"available\""));
+    g_free(l);
+    CHECK(call_video_apply(&v, CALL_VIDEO_PEER_CAMERA, 1, 0, 0, 0, NULL));
+    CHECK(call_video_apply(&v, CALL_VIDEO_PEER_ROTATION, 3, 0, 0, 0, NULL));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_PEER_ROTATION, 3, 0, 0, 0, NULL));
+    l = call_video_line_fields(&v);
+    CHECK(!strcmp(l, "\"incomingVideo\":true,\"outgoingVideo\":false,"
+                     "\"incomingVideoState\":\"streaming\",\"incomingVideoOrientation\":3"));
+    g_free(l);
+    gchar *p = call_video_payload_fields(&v);
+    CHECK(!strcmp(p, ",\"videoURI\":\"/tmp/signal-video\",\"videoWidth\":640,\"videoHeight\":480"));
+    g_free(p);
+
+    /* Our camera: the self-view only while it sends. */
+    CHECK(call_video_apply(&v, CALL_VIDEO_PREVIEW, 320, 240, 1, 1, "/tmp/signal-preview"));
+    p = call_video_payload_fields(&v);
+    CHECK(!has(p, "videoPreviewURI"));
+    g_free(p);
+    CHECK(call_video_apply(&v, CALL_VIDEO_SENDING, 1, 0, 0, 0, NULL));
+    l = call_video_line_fields(&v);
+    CHECK(has(l, "\"outgoingVideo\":true"));
+    g_free(l);
+    p = call_video_payload_fields(&v);
+    CHECK(has(p, ",\"videoPreviewURI\":\"/tmp/signal-preview\",\"videoPreviewWidth\":320,"
+                 "\"videoPreviewHeight\":240,\"videoPreviewOrientation\":1,\"videoPreviewMirrored\":true"));
+    g_free(p);
+
+    /* The user turns the far side's picture away: nothing to show, no streaming. */
+    v.show_incoming = FALSE;
+    l = call_video_line_fields(&v);
+    p = call_video_payload_fields(&v);
+    CHECK(has(l, "\"incomingVideo\":false") && has(l, "\"incomingVideoState\":\"available\""));
+    CHECK(!strcmp(p, ""));
+    g_free(l); g_free(p);
+    v.show_incoming = TRUE;
+
+    /* The far side turns its camera off. */
+    CHECK(call_video_apply(&v, CALL_VIDEO_PEER_CAMERA, 0, 0, 0, 0, NULL));
+    l = call_video_line_fields(&v);
+    CHECK(has(l, "\"incomingVideo\":false") && has(l, "\"incomingVideoState\":\"available\""));
+    g_free(l);
+
+    call_video_reset(&v);
+    CHECK(!v.uri && !v.preview && !v.offered && v.show_incoming);
+}
+
+static void test_bad_input(void)
+{
+    CallVideo v = {0};
+    call_video_reset(&v);
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, NULL));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, "relative"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, "/tmp/a\"b"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, "/tmp/a\\b"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, "/tmp/a\nb"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 0, 480, 0, 0, "/tmp/x"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 5000, 0, 0, "/tmp/x"));
+    char longp[120]; memset(longp, 'a', sizeof longp); longp[0] = '/'; longp[119] = 0;
+    CHECK(!call_video_apply(&v, CALL_VIDEO_SHM, 640, 480, 0, 0, longp));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_PREVIEW, 320, 240, 4, 0, "/tmp/p"));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_PEER_ROTATION, 4, 0, 0, 0, NULL));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_PEER_ROTATION, -1, 0, 0, 0, NULL));
+    CHECK(!call_video_apply(&v, CALL_VIDEO_ERROR, 0, 0, 0, 0, "tx-encoder"));
+    CHECK(!call_video_apply(&v, 99, 0, 0, 0, 0, NULL));
+    CHECK(!v.uri && !v.preview && v.peer_rotation == 0);
+    call_video_reset(&v);
+}
+
+static void test_json_bool(void)
+{
+    CHECK(call_video_json_bool("{\"id\":\"sig-1\",\"outgoingVideo\":true}", "outgoingVideo") == 1);
+    CHECK(call_video_json_bool("{\"outgoingVideo\" : false}", "outgoingVideo") == 0);
+    CHECK(call_video_json_bool("{\"incomingVideo\":true}", "outgoingVideo") == -1);
+    CHECK(call_video_json_bool("{\"outgoingVideo\":\"true\"}", "outgoingVideo") == -1);
+    CHECK(call_video_json_bool("{\"video\":true,\"audio\":true}", "video") == 1);
+    CHECK(call_video_json_bool("{\"address\":\"x\"}", "video") == -1);
+    CHECK(call_video_json_bool(NULL, "video") == -1);
+}
+
+int main(void)
+{
+    test_voice_call();
+    test_video_call();
+    test_bad_input();
+    test_json_bool();
+    if (failures) { fprintf(stderr, "FAIL test_call_video (%d)\n", failures); return 1; }
+    printf("PASS test_call_video\n");
+    return 0;
+}

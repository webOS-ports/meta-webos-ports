+/* Streaming thread: a caps query on its way from our camera head into Farstream's encoder.
+ * Once droidvenc runs it answers them so that nothing in front of it can be negotiated again:
+ * the phone turning (pmdevflip) changed the size into videoconvert, and the camera stopped with
+ * not-negotiated (teams_media on sargo, 10 Nov 2026). What we send never changes size, so the
+ * size filter answers for what is behind it with what it lets through. */
+static GstPadProbeReturn
+pm_probe_answer_caps(GstPad *pad, GstPadProbeInfo *info, gpointer u)
+{
+	GstQuery *q = GST_PAD_PROBE_INFO_QUERY(info);
+	GstCaps *fixed = NULL;
+	(void) pad;
+	if (GST_QUERY_TYPE(q) != GST_QUERY_CAPS && GST_QUERY_TYPE(q) != GST_QUERY_ACCEPT_CAPS)
+		return GST_PAD_PROBE_OK;
+	g_object_get(u, "caps", &fixed, NULL);
+	if (!fixed) return GST_PAD_PROBE_OK;
+	if (GST_QUERY_TYPE(q) == GST_QUERY_CAPS) {
+		GstCaps *filter = NULL, *res;
+		gst_query_parse_caps(q, &filter);
+		res = filter ? gst_caps_intersect_full(filter, fixed, GST_CAPS_INTERSECT_FIRST) : gst_caps_ref(fixed);
+		gst_query_set_caps_result(q, res);
+		gst_caps_unref(res);
+	} else {
+		GstCaps *c = NULL;
+		gst_query_parse_accept_caps(q, &c);
+		gst_query_set_accept_caps_result(q, c && gst_caps_can_intersect(c, fixed));
+	}
+	gst_caps_unref(fixed);
+	return GST_PAD_PROBE_HANDLED;
+}
+
 static GstElement *
 pm_make_vcam(PurpleMedia *media, const gchar *sid, const gchar *who)
 {
@@ -1232,6 +1267,7 @@ pm_make_vcam(PurpleMedia *media, const gchar *sid, const gchar *who)
 	gboolean test = g_getenv("TEAMS_PMEDIA_VSRC") != NULL;
 	const char *pv = g_getenv("TEAMS_PMEDIA_PREVIEW_SHM");
 	gint cw = test ? 0 : pm_camera_cw(), w = PM_VIDEO_W, h = PM_VIDEO_H, pw = PM_PREVIEW_W, ph = PM_PREVIEW_H;
+	gint pm_dev_turns = vx ? g_atomic_int_get(&vx->dev_turns) : 0;
 	gchar *desc, *head;
 	GstElement *bin, *e, *outer;
 	GError *err = NULL;
@@ -1248,13 +1284,19 @@ pm_make_vcam(PurpleMedia *media, const gchar *sid, const gchar *who)
 	                      "pixel-aspect-ratio=1/1 ! queue leaky=downstream max-size-buffers=2 ! "
 	                      "videoflip video-direction=%s ! videoconvert ! videoscale",
 	                      PM_VIDEO_W, PM_VIDEO_H, direction[cw & 3]);
-	desc = g_strdup_printf("%s ! capsfilter name=pmsendcaps caps=video/x-raw,format=NV12,width=%d,height=%d,"
-	                       "pixel-aspect-ratio=1/1 ! tee name=pmvt "
-	                       "pmvt. ! queue name=pmvout leaky=downstream max-size-buffers=2 "
+	/* What we send is turned once more with the phone (pmdevflip, TURN): Teams carries no
+	 * rotation, and the size we send stays (pm_camera_set), so a picture turned sideways comes
+	 * upright with borders. The self-view stays as the camera is held: the Phone app turns that
+	 * one with the screen. */
+	desc = g_strdup_printf("%s ! tee name=pmvt "
+	                       "pmvt. ! queue leaky=downstream max-size-buffers=2 ! "
+	                       "videoflip name=pmdevflip video-direction=%s ! videoconvert ! videoscale add-borders=true ! "
+	                       "capsfilter name=pmsendcaps caps=video/x-raw,format=NV12,width=%d,height=%d,"
+	                       "pixel-aspect-ratio=1/1 ! queue name=pmvout leaky=downstream max-size-buffers=2 "
 	                       "pmvt. ! queue leaky=downstream max-size-buffers=2 ! videoconvert ! videoscale ! "
 	                       "video/x-raw,format=I420,width=%d,height=%d,pixel-aspect-ratio=1/1 ! "
 	                       "queue leaky=downstream max-size-buffers=2 ! shmsink name=pmpreview",
-	                       head, w, h, pw, ph);
+	                       head, teams_video_send_direction(pm_dev_turns), w, h, pw, ph);
 	g_free(head);
 	bin = gst_parse_bin_from_description(desc, FALSE, &err);
 	if (!bin) {
@@ -1276,9 +1318,21 @@ pm_make_vcam(PurpleMedia *media, const gchar *sid, const gchar *who)
 			if (vx->cam) gst_object_unref(vx->cam);
 			vx->cam = e;
 		}
-		if (vx && (e = gst_bin_get_by_name(GST_BIN(bin), "pmsendcaps"))) {
-			if (vx->send_caps) gst_object_unref(vx->send_caps);
-			vx->send_caps = e;
+		if (vx && (e = gst_bin_get_by_name(GST_BIN(bin), "pmdevflip"))) {
+			if (vx->dev_flip) gst_object_unref(vx->dev_flip);
+			vx->dev_flip = e;
+		}
+		if ((e = gst_bin_get_by_name(GST_BIN(bin), "pmsendcaps"))) {
+			/* the probe holds the element: the head owns it for as long as the probe can run */
+			p = gst_element_get_static_pad(e, "src");
+			gst_pad_add_probe(p, GST_PAD_PROBE_TYPE_QUERY_DOWNSTREAM, pm_probe_answer_caps, e, NULL);
+			gst_object_unref(p);
+			if (vx) {
+				if (vx->send_caps) gst_object_unref(vx->send_caps);
+				vx->send_caps = e;
+			} else {
+				gst_object_unref(e);
+			}
 		}
 		if ((e = gst_bin_get_by_name(GST_BIN(bin), "pmpreview"))) {
 			g_object_set(e, "socket-path", pv && *pv ? pv : PM_PREVIEW_SHM, "shm-size", (guint) PM_SHM_SIZE,
@@ -1878,6 +1932,27 @@ pm_camera_set(TeamsPMedia *pm, gboolean on)
 	return TRUE;
 }
 
+/* TURN: how the phone is held now (the shell's quarter turns). What we send follows it from the
+ * camera head's next frame; a head made later (a new video session) starts turned so. */
+static void
+pm_set_device_turns(TeamsPMedia *pm, gint turns)
+{
+	if (turns < 0 || turns > 3) {
+		pm_log("TURN %d: not a quarter turn", turns);
+		return;
+	}
+	if (turns == pm->dev_turns) return;
+	pm->dev_turns = turns;
+	if (pm->vx) {
+		g_atomic_int_set(&pm->vx->dev_turns, turns);
+		if (pm->vx->dev_flip)
+			gst_util_set_object_arg(G_OBJECT(pm->vx->dev_flip), "video-direction",
+			                        teams_video_send_direction(turns));
+	}
+	pm_log("the phone is held %d quarter turn(s) round: what we send is turned %s", turns,
+	       teams_video_send_direction(turns));
+}
+
 /* ---- media signals ------------------------------------------------------------------------- */
 
 static const char *
@@ -2214,6 +2289,7 @@ pm_video_build(TeamsPMedia *pm, const char *rxkey, const char *ruf, const char *
 	pm->vx = g_new0(PmVideo, 1);
 	pm->vx->refs = 1;
 	pm->vx->tx_bps = (pm->cam_kbps > 0 ? pm->cam_kbps : PM_VIDEO_KBPS) * 1000;
+	pm->vx->dev_turns = pm->dev_turns;
 	g_mutex_init(&pm->vx->lock);
 	pm->peer_video = -1;
 	pm_use_video_elements(manager, send);
@@ -2571,6 +2647,8 @@ pm_handle_line(TeamsPMedia *pm, gchar *line)
 			pm->cam_on = FALSE;
 			pm_camera_set(pm, FALSE);
 		}
+	} else if (!strcmp(t[0], "TURN") && n > 1) {
+		pm_set_device_turns(pm, (gint) g_ascii_strtoll(t[1], NULL, 10));
 	} else if (!strcmp(t[0], "STOP")) {
 		pm_stop_input(pm);
 		pm_end_media(pm);

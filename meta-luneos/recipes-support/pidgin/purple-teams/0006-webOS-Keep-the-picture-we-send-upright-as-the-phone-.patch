+const char *
+teams_video_send_direction(int device_turns)
+{
+	static const char *const direction[] = { "identity", "90r", "180", "90l" };
+	return direction[(4 - (device_turns & 3)) & 3];
+}
diff --git a/teams_call_sdp.h b/teams_call_sdp.h
index 9eabe3b..d00cd20 100644
--- a/teams_call_sdp.h
+++ b/teams_call_sdp.h
@@ -11,6 +11,15 @@
  * (port 0). */
 const char *teams_sdp_video_direction(const char *sdp);
 
+/* Teams carries no rotation with the video (its SDP has no urn:3gpp:video-orientation): the
+ * far side shows the picture as it comes. The videoflip direction that keeps our front camera's
+ * picture upright with the phone held device_turns quarter turns away from upright (the shell's
+ * 0 top up, 1 left edge up, 2 upside down, 3 right edge up), on top of the turn that makes it
+ * upright held upright. The front camera's picture is not mirrored, so it turns the opposite way
+ * to the phone: one quarter turn counter-clockwise for each the phone is turned (checked on a
+ * call to Android with teams_media, which turns it the same way). */
+const char *teams_video_send_direction(int device_turns);
+
 /* Our answer's direction for the video m-line (RFC 3264 6.1), from the offer's direction, whether
  * the engine has video at all and whether our camera is to send. */
 const char *teams_video_answer_direction(const char *offer_dir, gboolean engine_video, gboolean camera);
diff --git a/teams_call_video.c b/teams_call_video.c
index 7841f65..a824014 100644
--- a/teams_call_video.c
+++ b/teams_call_video.c
@@ -204,3 +204,20 @@ teams_call_video_json_bool(const char *payload, const char *key)
 		return 0;
 	return -1;
 }
+
+int
+teams_call_video_json_turns(const char *payload)
+{
+	const char *k, *c;
+	if (!payload || !(k = strstr(payload, "\"deviceOrientation\"")))
+		return -1;
+	c = k + strlen("\"deviceOrientation\"");
+	while (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r') c++;
+	if (*c != ':')
+		return -1;
+	c++;
+	while (*c == ' ' || *c == '\t' || *c == '\n' || *c == '\r') c++;
+	if (*c < '0' || *c > '3' || (c[1] >= '0' && c[1] <= '9') || c[1] == '.')
+		return -1;
+	return *c - '0';
+}

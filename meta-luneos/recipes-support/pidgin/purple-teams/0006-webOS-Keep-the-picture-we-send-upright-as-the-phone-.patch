+{
+	CHECK(!strcmp(teams_video_send_direction(0), "identity"));
+	CHECK(!strcmp(teams_video_send_direction(1), "90l"));
+	CHECK(!strcmp(teams_video_send_direction(2), "180"));
+	CHECK(!strcmp(teams_video_send_direction(3), "90r"));
+	CHECK(!strcmp(teams_video_send_direction(5), "90l"));
+	CHECK(!strcmp(teams_video_send_direction(-1), "90r"));
+}

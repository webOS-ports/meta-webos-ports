+		result = g_strdup(m4a);
+
+out:
+	if (aac != NULL)
+		g_unlink(aac); // drop the intermediate raw-AAC
+	g_free(stem);
+	g_free(wav);
+	g_free(aac);
+	g_free(m4a);
+	return result;

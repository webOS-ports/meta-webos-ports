+		gchar *envp[] = { (gchar *) "PATH=/usr/bin:/bin", NULL };
+		gchar *argv[] = { (gchar *) "/usr/bin/faac", (gchar *) "-o", aac, wav, NULL };
+		ok = g_spawn_sync(NULL, argv, envp, G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL,

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 28 Oct 2026 11:57:41 +0100
Subject: [PATCH] Report a rejected sign-in code as an authentication failure

An authorization code from the browser sign-in is single-use and only
valid for a few minutes. When the token endpoint rejects it with
invalid_grant (for example AADSTS70000, "The code has expired"), the
plug-in reported PURPLE_CONNECTION_ERROR_NETWORK_ERROR. A UI treats that
as temporary and reconnects, which sends the same dead code again, so the
account never gets past sign-in. On webOS the transport retried every
30 seconds without end.

Give the authorization-code exchange its own callback and report every
error the token endpoint returns for it, invalid_grant included, as
PURPLE_CONNECTION_ERROR_AUTHENTICATION_FAILED, so the UI asks for a new
sign-in instead. A refresh token that is rejected is unchanged: it is
cleared and the error stays a network error, so the reconnect falls back
to the next sign-in method.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 teams_login.c | 29 +++++++++++++++++++++++++----
 1 file changed, 25 insertions(+), 4 deletions(-)

diff --git a/teams_login.c b/teams_login.c
index 285b13a..bcf0aec 100644
--- a/teams_login.c
+++ b/teams_login.c
@@ -324,10 +324,11 @@ teams_oauth_refreshed_skypetoken_access(PurpleHttpConnection *http_conn, PurpleH
 	}
 }
 
+/* Handles the token endpoint's answer to both a refresh_token grant and an
+ * authorization_code grant. from_auth_code says which one was sent. */
 static void
-teams_oauth_with_code_cb(PurpleHttpConnection *http_conn, PurpleHttpResponse *response, gpointer user_data)
+teams_oauth_token_response(PurpleHttpResponse *response, TeamsAccount *sa, gboolean from_auth_code)
 {
-	TeamsAccount *sa = user_data;
 	JsonObject *obj;
 	const gchar *raw_response;
 	gsize response_len;
@@ -357,7 +358,13 @@ teams_oauth_with_code_cb(PurpleHttpConnection *http_conn, PurpleHttpResponse *re
 		if (obj != NULL) {
 			if (json_object_has_member(obj, "error")) {
 				const gchar *error = json_object_get_string_member(obj, "error");
-				if (g_strcmp0(error, "invalid_grant") == 0 || g_strcmp0(error, "interaction_required") == 0) {
+				/* An authorization code is single-use and short-lived: once the token
+				 * endpoint has rejected it (expired, already redeemed, AADSTS70000 and
+				 * the like), sending it again can never work. A network error would make
+				 * the UI reconnect and replay the same code for ever, so only a rejected
+				 * refresh token is reported as one. */
+				if (!from_auth_code &&
+				    (g_strcmp0(error, "invalid_grant") == 0 || g_strcmp0(error, "interaction_required") == 0)) {
 					teams_save_refresh_token_password(sa->account, NULL);
 					purple_connection_error(sa->pc, PURPLE_CONNECTION_ERROR_NETWORK_ERROR,
 						json_object_get_string_member(obj, "error_description"));
@@ -377,6 +384,20 @@ teams_oauth_with_code_cb(PurpleHttpConnection *http_conn, PurpleHttpResponse *re
 	json_object_unref(obj);
 }
 
+static void
+teams_oauth_with_code_cb(PurpleHttpConnection *http_conn, PurpleHttpResponse *response, gpointer user_data)
+{
+	(void) http_conn;
+	teams_oauth_token_response(response, user_data, FALSE);
+}
+
+static void
+teams_oauth_with_authcode_cb(PurpleHttpConnection *http_conn, PurpleHttpResponse *response, gpointer user_data)
+{
+	(void) http_conn;
+	teams_oauth_token_response(response, user_data, TRUE);
+}
+
 static void
 teams_presence_oauth_cb(PurpleHttpConnection *http_conn, PurpleHttpResponse *response, gpointer user_data)
 {
@@ -612,7 +633,7 @@ teams_oauth_with_code(TeamsAccount *sa, const gchar *auth_code)
 	purple_http_request_header_set(request, "Content-Type", "application/x-www-form-urlencoded");
 	purple_http_request_set_contents(request, postdata->str, postdata->len);
 
-	purple_http_request(pc, request, teams_oauth_with_code_cb, sa);
+	purple_http_request(pc, request, teams_oauth_with_authcode_cb, sa);
 	purple_http_request_unref(request);
 
 	g_string_free(postdata, TRUE);
-- 
2.53.0


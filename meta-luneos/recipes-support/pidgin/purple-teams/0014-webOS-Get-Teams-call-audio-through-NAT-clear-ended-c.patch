From caba454554ce83ff322db4dd5c282a623533a637 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 4 Nov 2026 07:36:37 +0100
Subject: [PATCH] webOS: Get Teams call audio through NAT, clear ended call
 cards

An incoming call on sargo played the caller's audio, but nothing went
back, and after half a minute Teams ended it with MediaError 410. Our
answer carried host candidates only. The engine was pointed at the
call's media relay (links.udpTransport) for STUN, but that relay does
not answer a plain Binding request, and it was given by name, which
libnice cannot use. With only a private address to go on, the peer and
its relay had no way back to us, and ICE failed on our side.

Point STUN at world.relay.skype.com, the relay service the Teams web
client is given as its TURN server, which answers Binding requests
without credentials. Outgoing calls had no STUN server at all; they get
the same one. The offer or answer now goes out once the engine reports
its candidates complete (GATHERED), so the server-reflexive one is in
it, and after 4 s with what there is if gathering does not finish.

The call card also stayed up after a call. Every call went out as call
id "teams", and the Phone app ignores a "disconnected" for a call id it
has already seen end, so only the first call after the Phone app
started closed its card. Each call now gets an id of its own, from the
clock. And after "disconnected" nothing followed, while the Phone app
removes a card only when a push stops listing the call: the empty line
list now follows 1.5 s later, as the WhatsApp connector does.

Needs teams_media with GATHERED (luneos-synergy-connectors d4b8832).

The Teams call signalling in this patch is part of upstream pull request
#99. The webOS Phone app front end here (luna-service, card pushes) is
not, and stays webOS-only.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/EionRobb/purple-teams/pull/99]
---
 teams_call_luna.c | 58 ++++++++++++++++++++++++++++---------
 teams_calling.c   | 74 +++++++++++++++++++++++++++++++++++------------
 2 files changed, 100 insertions(+), 32 deletions(-)

diff --git a/teams_call_luna.c b/teams_call_luna.c
index 95b2f33..049bf7a 100644
--- a/teams_call_luna.c
+++ b/teams_call_luna.c
@@ -21,6 +21,10 @@ static gchar   *g_peerAddr = NULL;
 static gchar   *g_peerName = NULL;
 static gchar   *g_cause    = NULL;
 static gboolean g_outgoing = FALSE;
+/* The call's id on the card. The Phone app remembers every call id it has seen end and ignores a
+ * later "disconnected" for it, so each call needs an id of its own, or the card of every call after
+ * the first stays up. From the clock, so a restarted service does not hand out an old one again. */
+static gint64   g_cardId   = 0;
 
 /* Whether audiod has been told about an active call, so it is told once each way. */
 static gboolean g_audioOn  = FALSE;
@@ -54,9 +58,9 @@ build_payload(void)
 			g_string_append_printf(p, "\"disconnectDetails\":{\"cause\":%s},", cause);
 		g_string_append(p, "\"incomingVideo\":false,\"outgoingVideo\":false,");
 		g_string_append_printf(p,
-			"\"calls\":[{\"id\":\"teams\",\"origin\":\"%s\","
+			"\"calls\":[{\"id\":\"teams-%" G_GINT64_FORMAT "\",\"origin\":\"%s\","
 			"\"transport\":\"com.palm.teams\",\"address\":%s,\"displayName\":%s}]}",
-			g_outgoing ? "outgoing" : "incoming", addr, name);
+			g_cardId, g_outgoing ? "outgoing" : "incoming", addr, name);
 		g_free(state); g_free(addr); g_free(name); g_free(cause);
 	}
 	g_string_append(p, "]}");
@@ -169,15 +173,47 @@ static LSMethod g_methods[] = {
 
 /* ------------------------------------------------------------- state push in */
 
+static void push_payload(void)
+{
+	gchar *payload;
+	LSError err;
+	if (!g_sh) return;
+	payload = build_payload();
+	LSErrorInit(&err);
+	if (!LSSubscriptionReply(g_sh, SUBKEY, payload, &err)) {
+		purple_debug_warning("teams", "pushState: %s\n", err.message);
+		LSErrorFree(&err);
+	}
+	g_free(payload);
+}
+
+/* The Phone app drops a call card only when a push stops listing that call. So an ended call is
+ * shown as "disconnected" for a moment and then the empty line list follows, as the WhatsApp
+ * connector does. A call that starts in the meantime has replaced the line, so the empty list is
+ * then not sent. */
+#define ENDED_CALL_HOLD_MS 1500
+static guint g_idlePush = 0;
+
+static gboolean
+push_idle(gpointer data)
+{
+	(void) data;
+	g_idlePush = 0;
+	if (!g_state || !*g_state)
+		push_payload();
+	return G_SOURCE_REMOVE;
+}
+
 /* teams_calling state callback: cache, push to the subscribers, and tell audiod when the call
  * goes active or ends. */
 static void
 on_call_state(TeamsAccount *sa, const char *state, const char *peerAddress,
               const char *peerName, gboolean isOutgoing, const char *cause)
 {
-	gchar *payload;
-	LSError err;
 	(void) sa;
+	/* Every call starts from idle: the state is cleared as soon as one ends. */
+	if ((!g_state || !*g_state) && state && *state)
+		g_cardId = g_get_real_time();
 	setstr(&g_state, state);
 	setstr(&g_peerAddr, peerAddress);
 	setstr(&g_peerName, peerName);
@@ -188,21 +224,17 @@ on_call_state(TeamsAccount *sa, const char *state, const char *peerAddress,
 	if (g_strcmp0(g_state, "active") == 0)      teams_call_luna_set_audio(TRUE);
 	else if (!*g_state || g_strcmp0(g_state, "disconnected") == 0) teams_call_luna_set_audio(FALSE);
 
-	if (!g_sh) return;
-	payload = build_payload();
-	LSErrorInit(&err);
-	if (!LSSubscriptionReply(g_sh, SUBKEY, payload, &err)) {
-		purple_debug_warning("teams", "pushState: %s\n", err.message);
-		LSErrorFree(&err);
-	}
-	g_free(payload);
+	push_payload();
 
-	/* The subscribers have seen the call end; a later callStateQuery gets no call, not this one. */
+	/* The subscribers have seen the call end; a later callStateQuery gets no call, not this one,
+	 * and the card is cleared once the Phone app has shown it as ended. */
 	if (g_strcmp0(g_state, "disconnected") == 0) {
 		setstr(&g_state, NULL);
 		setstr(&g_peerAddr, NULL);
 		setstr(&g_peerName, NULL);
 		setstr(&g_cause, NULL);
+		if (!g_idlePush)
+			g_idlePush = g_timeout_add(ENDED_CALL_HOLD_MS, push_idle, NULL);
 	}
 }
 
diff --git a/teams_calling.c b/teams_calling.c
index c689e94..07d3fc2 100644
--- a/teams_calling.c
+++ b/teams_calling.c
@@ -117,6 +117,8 @@ typedef struct {
 	GString     *our_cands;    /* accumulated "candidate:..." lines, one per line */
 	gboolean     answered;
 	guint        answer_timer;
+	gboolean     gathered;
+	gboolean     sent_sdp;     /* our offer or answer has gone out */     /* the engine reported GATHERED: our candidates are complete */
 	gboolean     is_caller;    /* TRUE = outgoing (we build+POST the offer via cpconv) */
 
 	/* Set by teams_calling_handle_renegotiation() right after it sends a RESTART to the engine;
@@ -662,16 +664,46 @@ media_send_offer(TeamsMediaProc *mp)
 	g_free(epid_q); g_free(to_q); g_free(loc_q); g_free(lang_q); g_free(pid); g_free(to_pid);
 }
 
+/* Longest wait for our ICE candidates before the offer or answer goes out without them all. */
+#define MEDIA_GATHER_LIMIT_MS 4000
+
+/* Build + POST our offer (outgoing: places the call) or answer (incoming). Once per call. */
+static void
+media_send_now(TeamsMediaProc *mp)
+{
+	if (mp->sent_sdp) return;
+	mp->sent_sdp = TRUE;
+	if (mp->is_caller) media_send_offer(mp);
+	else               media_send_answer(mp);
+}
+
 static gboolean
 media_answer_timeout(gpointer user)
 {
 	TeamsMediaProc *mp = user;
 	mp->answer_timer = 0;
-	if (mp->is_caller) media_send_offer(mp);   /* outgoing: build+POST the offer (place the call) */
-	else               media_send_answer(mp);  /* incoming: build+POST the answer */
+	teams_call_log("media: candidates still gathering after %d ms; sending the %s anyway",
+	               MEDIA_GATHER_LIMIT_MS, mp->is_caller ? "offer" : "answer");
+	media_send_now(mp);
 	return G_SOURCE_REMOVE;
 }
 
+/* Teams' media relay of the call (links.udpTransport) does not answer a plain STUN Binding
+ * request: it wants MS-TURN credentials. Without a server that does, libnice gathers host
+ * candidates only, the peer has no address to reach us through the NAT, and only the peer's audio
+ * gets through (sargo, 2026-11-04: ICE connecting -> failed, then MediaError 410). Teams' own
+ * relay service answers Binding requests without credentials; the web client is given it as its
+ * TURN server. Must precede START. */
+#define TEAMS_STUN_HOST "world.relay.skype.com"
+#define TEAMS_STUN_PORT 3478
+
+static void
+media_send_stun(TeamsMediaProc *mp)
+{
+	media_send(mp, "RELAY stun %s %d\n", TEAMS_STUN_HOST, TEAMS_STUN_PORT);
+	teams_call_log("media: STUN server %s:%d", TEAMS_STUN_HOST, TEAMS_STUN_PORT);
+}
+
 /* Build + POST a mid-call renegotiation answer using WHATEVER local ufrag/pwd/cands mp currently
  * holds. Shared by teams_calling_handle_renegotiation() (the no-restart-needed fallback, answered
  * immediately) and media_on_output()'s RESTARTED handler (answered only once the engine's fresh
@@ -728,9 +760,25 @@ media_on_output(GIOChannel *ch, GIOCondition cond, gpointer user)
 			}
 		}
 		else if (!strcmp(line, "READY")) {
-			teams_call_log("media engine READY; gathering candidates before answer");
-			/* give ICE ~1.5s to gather candidates, then build + POST the answer */
-			if (!mp->answer_timer) mp->answer_timer = g_timeout_add(1500, media_answer_timeout, mp);
+			/* The offer or answer goes out once our candidates are complete (GATHERED), so it
+			 * carries the server-reflexive one; without that the peer has no address to reach us
+			 * through the NAT, and the call has audio one way only. If gathering hangs - the STUN
+			 * server does not answer - it goes out with what there is after a while. */
+			teams_call_log("media engine READY; gathering candidates before %s",
+			               mp->is_caller ? "offer" : "answer");
+			if (mp->gathered)
+				media_send_now(mp);
+			else if (!mp->answer_timer)
+				mp->answer_timer = g_timeout_add(MEDIA_GATHER_LIMIT_MS, media_answer_timeout, mp);
+		}
+		else if (!strcmp(line, "GATHERED")) {
+			mp->gathered = TRUE;
+			if (mp->answer_timer) {
+				g_source_remove(mp->answer_timer);
+				mp->answer_timer = 0;
+				teams_call_log("media engine GATHERED; sending the %s", mp->is_caller ? "offer" : "answer");
+				media_send_now(mp);
+			}
 		}
 		else if (g_str_has_prefix(line, "AUDIOD ")) teams_call_log("media audiod %s", line + 7);
 		g_free(line); line = NULL;
@@ -848,20 +896,7 @@ teams_media_start(TeamsCall *call)
 	mp = media_spawn(call, FALSE);
 	if (!mp) { g_free(ruf); g_free(rpw); g_free(rxkey); return FALSE; }
 
-	/* Give the engine a STUN server so it gathers server-reflexive (srflx) candidates - host-only
-	 * ICE can't traverse NAT to Teams' relay. Teams' media relay (udpTransport, :3478) also answers
-	 * STUN binding requests, so point STUN at it. Must precede START. */
-	if (call->udp_transport) {
-		const gchar *h = call->udp_transport;
-		gchar *hc, *slash, *colon; int rport = 3478;
-		if (g_str_has_prefix(h, "udp://")) h += 6;
-		hc = g_strdup(h);
-		if ((slash = strchr(hc, '/'))) *slash = '\0';
-		if ((colon = strrchr(hc, ':'))) { rport = atoi(colon + 1); *colon = '\0'; }
-		media_send(mp, "RELAY stun %s %d\n", hc, rport);
-		teams_call_log("media_start: RELAY stun %s %d", hc, rport);
-		g_free(hc);
-	}
+	media_send_stun(mp);
 
 	/* START <rx_master_b64> <remote_ufrag> <remote_pwd> <pt> */
 	ok = media_send(mp, "START %s %s %s %d\n", rxkey, ruf, rpw, pt);
@@ -1493,6 +1528,7 @@ teams_calling_dial(TeamsAccount *sa, const gchar *peer_mri)
 	set_current(sa, call);
 
 	mp = media_spawn(call, TRUE);
+	if (mp) media_send_stun(mp);
 	/* CALLER START: no rx key (we produce the offer). pt=102 for opus. */
 	if (!mp || !media_send(mp, "START 102\n")) {
 		set_current(sa, NULL);
-- 

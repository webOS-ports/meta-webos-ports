From 4537dc6179a765b6dac99f46205d9f51a97d0825 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 4 Nov 2026 18:04:44 +0100
Subject: [PATCH] webOS: Teams calls - video inactive, declare our audio SSRC,
 wait longer for a leave

Answering a call from the Teams Android app with video a=sendrecv makes
the app say that we are trying to send video. The teams.live.com web
client answers video a=inactive in its accept and in every
renegotiation answer; do the same.

Declare our audio SSRC (from the media engine's SSRC line) with
a=x-ssrc-range, as the web client declares the SSRC of each stream it
sends. Android->LuneOS audio works but LuneOS->Android stays silent
while we do send, and the app sent no RTCP report about our SSRC.

A leave went unanswered for the 30 s default twice, through flightproxy
and on new connections. Give it 120 s, to see whether the backend
answers at all.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Submitted [https://github.com/EionRobb/purple-teams/pull/99]
---
 teams_calling.c | 43 +++++++++++++++++++++++++++----------------
 1 file changed, 27 insertions(+), 16 deletions(-)

diff --git a/teams_calling.c b/teams_calling.c
index ae1d76b..3c6d471 100644
--- a/teams_calling.c
+++ b/teams_calling.c
@@ -119,6 +119,7 @@ typedef struct {
 	GIOChannel  *out_ch;       /* <- child stdout */
 	guint        out_watch;
 	gchar       *our_ufrag, *our_pwd, *our_txkey;
+	guint32      our_ssrc;     /* the engine's audio RTP SSRC (its SSRC line); 0 = not known */
 	GString     *our_cands;    /* accumulated "candidate:..." lines, one per line */
 	gboolean     answered;
 	guint        answer_timer;
@@ -204,6 +205,10 @@ flightproxy_resp_cb(PurpleHttpConnection *hc, PurpleHttpResponse *resp, gpointer
 /* POST JSON to a flightproxy/calling URL WITH the x-skypetoken auth header (teams_post_or_get does
  * not add it for api.flightproxy.skype.com -> "Anonymous access is not allowed" 403), the calling
  * headers and a caller-supplied response callback (NULL: flightproxy_resp_cb, which just logs). */
+/* How long a leave may take. Live (2026-11-04) a leave went unanswered for the 30 s default twice,
+ * through flightproxy and on new connections; give the backend longer, to see whether it answers. */
+#define TEAMS_LEAVE_TIMEOUT_S 120
+
 static void
 flightproxy_post_full(TeamsAccount *sa, const gchar *url, const gchar *body,
                       PurpleHttpCallback cb, gpointer user, gboolean fresh_connection)
@@ -216,6 +221,8 @@ flightproxy_post_full(TeamsAccount *sa, const gchar *url, const gchar *body,
 	 * answered and fails only at the 30 s request timeout. */
 	if (!fresh_connection)
 		purple_http_request_set_keepalive_pool(req, sa->keepalive_pool);
+	else
+		purple_http_request_set_timeout(req, TEAMS_LEAVE_TIMEOUT_S);
 	purple_http_request_header_set(req, "Content-Type", "application/json");
 	purple_http_request_header_set(req, "X-Skypetoken", sa->skype_token);
 	/* calling backend rejects requests without a client identity as 400 Bad Request */
@@ -571,20 +578,6 @@ our_host_address(TeamsMediaProc *mp, int *port)
 	return ip;
 }
 
-/* Build the SDP answer from our media params + the offer (SDES-GCM path; the offer supports both
- * SDES a=crypto and DTLS, and our engine keys via SDES). Shape mirrors the web client's accepted
- * answer: BUNDLE + mid:audio_0/video_1 + rtcp-mux + label, a=crypto instead of DTLS fingerprint.
- * Calls are voice only, but the video m-line still has to be there: the offer/answer m-line
- * mirroring requirement means leaving it out makes the peer reject the whole answer
- * (FinalAnswerError 406/4122). CAPTURED LIVE (2026-08-01, rtcstats_dump from a real teams.live.com
- * call): the video m-line's direction is ALWAYS a=sendrecv in every one of a real client's
- * answers, even before video is ever "on"; real video flow is controlled at the track level, not
- * by the m-line direction, and Teams' backend did not take anything else. We send no video RTP.
- * Codec/fmtp/rtcp-fb values are the real ones from a captured live Teams video call (H264/90000
- * PT 107, rtx PT 99, packetization-mode=1, profile-level-id=42e01f). Shared by the initial answer
- * (media_send_answer, below) and any later mid-call renegotiation
- * (teams_calling_handle_renegotiation) - both reuse the SAME bundled ICE/crypto. Caller owns the
- * returned GString. */
 /* The m-lines of offer other than audio and video, each declined as RFC 3264 has it (port 0, the
  * first format) with its mid. CAPTURED LIVE (2026-11-04, a call from the Teams Android app): its
  * renegotiation offers add "m=x-data ... a=mid:data_2" (SCTP data), and an answer has to carry as
@@ -617,6 +610,22 @@ sdp_declined_mlines(const gchar *offer)
 	return g_string_free(out, FALSE);
 }
 
+/* Build the SDP answer from our media params + the offer (SDES-GCM path; the offer supports both
+ * SDES a=crypto and DTLS, and our engine keys via SDES). Shape mirrors the web client's accepted
+ * answer: BUNDLE + mid:audio_0/video_1 + rtcp-mux + label, a=crypto instead of DTLS fingerprint.
+ * Calls are voice only, but the video m-line still has to be there: the offer/answer m-line
+ * mirroring requirement means leaving it out makes the peer reject the whole answer
+ * (FinalAnswerError 406/4122). Its direction is a=inactive: CAPTURED (teams.live.com answering a
+ * call from the Teams Android app, 2026-11-04) the web client's accept and every renegotiation
+ * answer have video a=inactive, and with a=sendrecv the Android app shows that we are trying to
+ * send video. (An rtcstats_dump of 2026-08-01 had a=sendrecv in a real client's answers.) We send
+ * no video RTP. Our audio SSRC is declared with a=x-ssrc-range, as the web client declares the
+ * SSRC of each stream it sends (its data stream in that capture).
+ * Codec/fmtp/rtcp-fb values are the real ones from a captured live Teams video call (H264/90000
+ * PT 107, rtx PT 99, packetization-mode=1, profile-level-id=42e01f). Shared by the initial answer
+ * (media_send_answer, below) and any later mid-call renegotiation
+ * (teams_calling_handle_renegotiation) - both reuse the SAME bundled ICE/crypto. Caller owns the
+ * returned GString. */
 static GString *
 build_answer_sdp(TeamsMediaProc *mp)
 {
@@ -642,6 +651,7 @@ build_answer_sdp(TeamsMediaProc *mp)
 	g_string_append(a, "a=fmtp:102 minptime=10;useinbandfec=1\r\n");
 	g_string_append(a, "a=mid:audio_0\r\n");
 	g_string_append(a, "a=sendrecv\r\n");
+	if (mp->our_ssrc) g_string_append_printf(a, "a=x-ssrc-range:%u-%u\r\n", mp->our_ssrc, mp->our_ssrc);
 	g_string_append_printf(a, "a=ice-ufrag:%s\r\n", mp->our_ufrag);
 	g_string_append_printf(a, "a=ice-pwd:%s\r\n", mp->our_pwd);
 	g_string_append_printf(a, "a=crypto:4 AEAD_AES_256_GCM inline:%s|2^31\r\n", mp->our_txkey);
@@ -668,7 +678,7 @@ build_answer_sdp(TeamsMediaProc *mp)
 	g_string_append(a, "a=rtcp-fb:107 nack\r\n");
 	g_string_append(a, "a=rtcp-fb:107 nack pli\r\n");
 	g_string_append(a, "a=mid:video_1\r\n");
-	g_string_append(a, "a=sendrecv\r\n");   /* always - see this function's header comment */
+	g_string_append(a, "a=inactive\r\n");   /* see this function's header comment */
 	g_string_append_printf(a, "a=ice-ufrag:%s\r\n", mp->our_ufrag);
 	g_string_append_printf(a, "a=ice-pwd:%s\r\n", mp->our_pwd);
 	g_string_append_printf(a, "a=crypto:4 AEAD_AES_256_GCM inline:%s|2^31\r\n", mp->our_txkey);
@@ -931,7 +941,7 @@ send_reneg_answer(TeamsMediaProc *mp, const gchar *answer_link)
 	g_free(body); g_free(blob_q); g_string_free(a, TRUE);
 }
 
-/* read UFRAG/PWD/TXKEY/CAND/READY/ANSWERED/RESTARTED/AUDIOD/ERR from teams_media's stdout */
+/* read UFRAG/PWD/TXKEY/SSRC/CAND/READY/ANSWERED/RESTARTED/AUDIOD/ERR from teams_media's stdout */
 static gboolean
 media_on_output(GIOChannel *ch, GIOCondition cond, gpointer user)
 {
@@ -947,6 +957,7 @@ media_on_output(GIOChannel *ch, GIOCondition cond, gpointer user)
 			g_free(mp->our_txkey); mp->our_txkey = g_strdup(line + 6);
 			explicit_bzero(line, strlen(line));
 		}
+		else if (g_str_has_prefix(line, "SSRC ")) mp->our_ssrc = (guint32) g_ascii_strtoull(line + 5, NULL, 10);
 		else if (g_str_has_prefix(line, "CAND ")) g_string_append_printf(mp->our_cands, "%s\n", line + 5);
 		else if (!strcmp(line, "RESTARTED")) {
 			/* The RESTART's fresh UFRAG/PWD lines are always emitted BEFORE this marker (see
-- 
2.53.0


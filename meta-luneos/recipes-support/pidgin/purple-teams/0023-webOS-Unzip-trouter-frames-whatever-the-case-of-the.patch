From 885f607a950466b2ac4bb0e521288de4a3bcbb99 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 4 Nov 2026 19:19:20 +0100
Subject: [PATCH] webOS: Unzip trouter frames whatever the case of their
 encoding header

The call controller's trouter frames name their gzip body with
"X-Microsoft-Skype-Content-Encoding", the conversation's (rosterUpdate)
with "x-microsoft-skype-content-encoding" (teams.live.com, 2026-11-04).
Only the first was matched: the conversation's bodies were left as
base64, did not decode, and the frames were dropped without a trace -
which is why sargo never saw a rosterUpdate. Match the header without
case, and log a frame whose body still does not decode.

A frame without a body (or one that did not unzip) no longer reaches
strlen(NULL). Conversation frames on the links our join gave are logged
by member names only.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending

---
 teams_calling.c |  9 +++++++++
 teams_trouter.c | 11 +++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/teams_calling.c b/teams_calling.c
index ea913c2..499eed8 100644
--- a/teams_calling.c
+++ b/teams_calling.c
@@ -1889,6 +1889,15 @@ teams_calling_handle_trouter(TeamsAccount *sa, JsonObject *body_obj, const gchar
 		return;
 	}
 
+	/* The conversation's own frames (rosterUpdate, conversationEnd, ...) on the links our join
+	 * gave: not modeled; logged by name and shape (never values) to see what the conversation says. */
+	if (request_url && strstr(request_url, "/conversation/")) {
+		gchar *what = g_strdup_printf("conversation frame %s", strstr(request_url, "/conversation/"));
+		log_member_names(what, body_obj);
+		g_free(what);
+		return;
+	}
+
 	/* Roster update mid-call - not modeled. */
 	if (request_url && g_str_has_suffix(request_url, "/rosterUpdate"))
 		return;
diff --git a/teams_trouter.c b/teams_trouter.c
index a59747e..af8e89d 100644
--- a/teams_trouter.c
+++ b/teams_trouter.c
@@ -315,7 +315,11 @@ teams_trouter_websocket_cb(PurpleWebsocket *ws, gpointer user_data, PurpleWebsoc
 			 * object_member + hash_table NULL flood otherwise). */
 			JsonObject *headers = json_object_get_object_member(request, "headers");
 			gchar *body = g_strdup(json_object_get_string_member(request, "body"));
-			if (headers != NULL && purple_strequal(json_object_get_string_member(headers, "X-Microsoft-Skype-Content-Encoding"), "gzip")) {
+			/* webOS: header names are not always capitalised the same way. CAPTURED (teams.live.com,
+			 * 2026-11-04): the call controller's frames say "X-Microsoft-Skype-Content-Encoding",
+			 * the conversation's (rosterUpdate) "x-microsoft-skype-content-encoding" - their gzip
+			 * bodies were left undecoded and the frames dropped. */
+			if (body != NULL && purple_strequal(trouter_header(headers, "X-Microsoft-Skype-Content-Encoding"), "gzip")) {
 				gsize body_len;
 				guchar *body_base64_decoded = g_base64_decode(body, &body_len);
 				gchar *body_unzipped = teams_gunzip(body_base64_decoded, &body_len);
@@ -324,13 +328,16 @@ teams_trouter_websocket_cb(PurpleWebsocket *ws, gpointer user_data, PurpleWebsoc
 				body = body_unzipped;
 			}
 
-			JsonObject *body_obj = json_decode_object(body, strlen(body));
+			/* webOS: no body, or one that did not unzip, is NULL here */
+			JsonObject *body_obj = body ? json_decode_object(body, strlen(body)) : NULL;
 			JsonObject *orig_body;
 
 			/* webOS: an empty/unparseable frame body decodes to NULL - clean up and stop, don't
 			 * ref/deref NULL (part of the json_decode 'root' + 'object != NULL' flood). */
 			if (body_obj == NULL) {
 				purple_debug_info("teams", "Trouter 3: frame body did not decode, ignoring\n");
+				teams_call_log("TROUTER frame url=%s: body did not decode - ignored",
+				               json_object_get_string_member(request, "url") ? json_object_get_string_member(request, "url") : "(null)");
 				g_free(body);
 				json_object_unref(request);
 				return;
-- 

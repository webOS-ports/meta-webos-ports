+/* teams_calling video callback: the engine's video lines and the offers' video direction. */
+static void
+on_call_video(TeamsAccount *sa, const char *line)
+{
+	gboolean was_video = teams_call_video_active(&g_video), changed;
+	(void) sa;
+	if (!line || !*line) {
+		/* The engine stopped: no picture any more, the user's choice to show it stays. */
+		gboolean show = g_video.show_incoming;
+		changed = was_video || g_video.uri || g_video.preview;
+		teams_call_video_reset(&g_video);
+		g_video.show_incoming = show;
+	} else if (g_str_has_prefix(line, "OFFERED ")) {
+		changed = teams_call_video_set_offered(&g_video, !strcmp(line + 8, "1"));
+	} else {
+		changed = teams_call_video_engine_line(&g_video, line, NULL);
+	}
+	if (!changed || !g_state || !*g_state) return;
+	push_payload();
+	/* A voice call that turned into a video call (or back): tell audiod again. */
+	if (g_audioOn && was_video != teams_call_video_active(&g_video))
+		audiod_report_active();
+}

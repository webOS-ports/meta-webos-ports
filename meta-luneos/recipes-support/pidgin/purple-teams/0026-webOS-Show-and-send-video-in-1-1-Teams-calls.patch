+
+/* Our m=video direction for the answer being built. */
+static const char *
+media_video_answer(TeamsMediaProc *mp)
+{
+	mp->video_answer = teams_video_answer_direction(mp->video_offer, mp->our_vssrc != 0, mp->camera_wanted);
+	return mp->video_answer;

@@ -586,6 +605,28 @@ void updatePrivateChat(TdAccountData &account, const td::td_api::chat *chat, con
             purple_buddy_icons_set_for_user(account.purpleAccount, purpleUserName.c_str(), NULL, 0, NULL);
         }

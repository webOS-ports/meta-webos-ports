                                // TRANSLATOR: Authentication dialog, title.
                                _("Login code"),
                                message.c_str(),
@@ -548,7 +612,11 @@ void PurpleTdClient::requestAuthCode(const td::td_api::authenticationCodeInfo *c
                                m_account,

+    case CallEndReason::Missed:             return "missed";
+    case CallEndReason::Declined:           return "declined";
+    case CallEndReason::Disconnected:       return "disconnected";
+    case CallEndReason::HungUp:             return "hungUp";
+    case CallEndReason::UpgradeToGroupCall: return "upgradeToGroupCall";

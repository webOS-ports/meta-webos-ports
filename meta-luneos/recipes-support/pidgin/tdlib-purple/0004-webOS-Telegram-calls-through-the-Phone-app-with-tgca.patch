diff --git a/call-end.h b/call-end.h
new file mode 100644
index 0000000..9f9c52e
--- /dev/null
+++ b/call-end.h
@@ -0,0 +1,27 @@
+#ifndef _CALL_END_H
+#define _CALL_END_H
+
+// Which cause the Phone app is told when TDLib discards a call. Kept free of TDLib types so the
+// rule can be tested on its own (test/call-end-test.cpp).
+
+enum class CallEndReason { None, Empty, Missed, Declined, Disconnected, HungUp, UpgradeToGroupCall, Other };
+
+// answeredHere: the call was accepted on this device (the user tapped answer, or it became ready).
+//
+// Answered elsewhere: when another device of the same account takes an incoming call, the server
+// discards it here with no reason (TDLib callDiscardReasonEmpty), seen on sargo 2026-11-05. A caller
+// who gives up while it rings gives "missed" instead, and our own decline gives "declined".
+inline const char *callEndCause(CallEndReason reason, bool outgoing, bool answeredHere)
+{
+    switch (reason) {
+    case CallEndReason::Declined: return "rejected";
+    case CallEndReason::Missed:   return "missed";
+    case CallEndReason::None:
+    case CallEndReason::Empty:
+        if (!outgoing && !answeredHere) return "answeredElsewhere";
+        return "normal";
+    default:                      return "normal";
+    }
+}
+
+#endif
diff --git a/call-luna.cpp b/call-luna.cpp
new file mode 100644
index 0000000..b585251
--- /dev/null
+++ b/call-luna.cpp
@@ -0,0 +1,414 @@
+/* webOS Synergy Revival - Telegram calling M2 (Path C): the LS2 call service.
+ * See call-luna.h. Serves com.palm.telegram.call to the stock Phone app (CallSynergizer),
+ * mirroring the com.palm.whatsapp / wacallm contract:
+ *   - callStateQuery  (subscription) : streams line/call state to the dialer
+ *   - dial {address}                 : place an outgoing call
+ *   - answer {id}                    : accept the pending incoming call
+ *   - disconnect {id} / hangupAll    : end the current call
+ * The heavy lifting (TDLib signaling + libtgvoip media) already lives in call.cpp; this only
+ * translates the webOS call contract to/from the small bridge functions below.
+ */
+
+#include "call-luna.h"
+#include "config.h"
+#include <luna-service2/lunaservice.h>
+#include <glib.h>
+#include <string>
+#include <cstring>
+#include <cstdarg>
+#include <memory>
+
+/* Implemented in call.cpp - drive the active account's TDLib call via the existing prpl logic. */
+extern bool callBridgeDial(PurpleAccount *account, const char *who, bool video);
+extern void callBridgeAnswer(PurpleAccount *account);
+extern void callBridgeHangup(PurpleAccount *account);
+extern void callBridgeChangeMedia(PurpleAccount *account, bool hasView, bool view, bool hasCamera, bool camera,
+                                  int deviceTurns);
+
+/* Call life-cycle trace, through libpurple's debug log like the rest of the plug-in. */
+void tgcLog(const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    char *msg = g_strdup_vprintf(fmt, ap);
+    va_end(ap);
+    purple_debug_info(config::pluginId, "call: %s\n", msg);
+    g_free(msg);
+}
+
+namespace {
+
+LSHandle      *g_sh       = NULL;   // com.palm.telegram.call on the (single) bus
+PurpleAccount *g_account  = NULL;   // the bound Telegram account
+
+// Last state we pushed, so a late subscriber gets the current picture immediately.
+std::string    g_state, g_peerAddr, g_peerName, g_cause;
+bool           g_outgoing = false;
+// The call's id on the card. The Phone app remembers every call id it has seen end and ignores a
+// later "disconnected" for it, so each call needs an id of its own, or the card of every call after
+// the first stays up. From the clock, so a restarted service does not hand out an old one again.
+std::string    g_cardId;
+bool           g_isVideo = false;   // call.is_video_
+// The video members while the call has a video session (tgcalls-call.cpp), else empty.
+std::string    g_videoLine, g_videoPayload;
+
+const char *SUBKEY = "callState";
+
+std::string jsonEscape(const char *s)
+{
+    std::string o;
+    for (const char *p = s ? s : ""; *p; ++p) {
+        switch (*p) {
+            case '"':  o += "\\\""; break;
+            case '\\': o += "\\\\"; break;
+            case '\n': o += "\\n";  break;
+            case '\r': o += "\\r";  break;
+            case '\t': o += "\\t";  break;
+            default:   o += *p;     break;
+        }
+    }
+    return o;
+}
+
+// Build the callStateQuery payload the Phone app's SynergyTransport reads: one line with a
+// line-level "state" (incoming/dialing/active/disconnected), or no lines when idle, and the
+// video members the WhatsApp connector sends too (line: incomingVideo, outgoingVideo,
+// incomingVideoState; top level: videoURI and the preview).
+std::string buildPayload()
+{
+    std::string p = "{\"returnValue\":true";
+    p += g_videoPayload.empty() ? std::string(",\"allowVideoCalls\":true,\"videoURI\":\"\"") : g_videoPayload;
+    p += ",\"lines\":[";
+    if (!g_state.empty()) {
+        p += "{\"state\":\"" + jsonEscape(g_state.c_str()) + "\",";
+        if (g_state == "disconnected")
+            p += "\"disconnectDetails\":{\"cause\":\"" + jsonEscape(g_cause.c_str()) + "\"},";
+        // lineFields() start with ','; without a session, a video call still shows as one.
+        std::string video = g_videoLine.empty()
+            ? std::string(",\"incomingVideo\":false,\"outgoingVideo\":false,\"incomingVideoState\":\"") +
+                  (g_isVideo && g_state != "disconnected" ? "available" : "unavailable") + "\""
+            : g_videoLine;
+        p += video.substr(1) + ",";
+        // address and displayName sit flat on each call, as the WhatsApp connector sends them.
+        // transport is this connector's own PHONE account template id: without it the call is
+        // taken for a cellular one and the id is shown formatted as a phone number.
+        p += "\"calls\":[{\"id\":\"" + g_cardId + "\",\"origin\":\"" + std::string(g_outgoing ? "outgoing" : "incoming") + "\","
+             "\"transport\":\"com.palm.telegram\","
+             "\"address\":\"" + jsonEscape(g_peerAddr.c_str()) + "\","
+             "\"displayName\":\"" + jsonEscape(g_peerName.empty() ? g_peerAddr.c_str() : g_peerName.c_str()) + "\"}]}";
+    }
+    p += "]}";
+    return p;
+}
+
+bool cbCallStateQuery(LSHandle *sh, LSMessage *msg, void *)
+{
+    LSError err; LSErrorInit(&err);
+    bool subscribed = false;
+    LSSubscriptionProcess(sh, msg, &subscribed, &err);   // honours {"subscribe":true}
+    if (subscribed)
+        LSSubscriptionAdd(sh, SUBKEY, msg, &err);
+    std::string payload = buildPayload();
+    LSMessageReply(sh, msg, payload.c_str(), &err);
+    if (LSErrorIsSet(&err)) { purple_debug_warning(config::pluginId, "callStateQuery: %s\n", err.message); LSErrorFree(&err); }
+    return true;
+}
+
+// tiny extractor for a top-level boolean: 1 true, 0 false, -1 absent or not a boolean
+int getBool(const char *json, const char *key)
+{
+    if (!json) return -1;
+    std::string needle = std::string("\"") + key + "\"";
+    const char *k = strstr(json, needle.c_str());
+    if (!k) return -1;
+    const char *c = strchr(k + needle.size(), ':');
+    if (!c) return -1;
+    while (*++c == ' ') ;
+    if (!strncmp(c, "true", 4)) return 1;
+    if (!strncmp(c, "false", 5)) return 0;
+    return -1;
+}
+
+// tiny extractor for a top-level small non-negative integer: -1 when absent or not one
+int getSmallUint(const char *json, const char *key)
+{
+    if (!json) return -1;
+    std::string needle = std::string("\"") + key + "\"";
+    const char *k = strstr(json, needle.c_str());
+    if (!k) return -1;
+    const char *c = strchr(k + needle.size(), ':');
+    if (!c) return -1;
+    while (*++c == ' ') ;
+    int v = -1;
+    for (; *c >= '0' && *c <= '9' && v < 10000; c++)
+        v = (v < 0 ? 0 : v * 10) + (*c - '0');
+    return v;
+}
+
+// tiny extractor for a top-level string field (avoids pulling a JSON lib into the prpl)
+std::string getField(const char *json, const char *key)
+{
+    if (!json) return "";
+    std::string needle = std::string("\"") + key + "\"";
+    const char *k = strstr(json, needle.c_str());
+    if (!k) return "";
+    const char *c = strchr(k + needle.size(), ':');
+    if (!c) return "";
+    while (*++c == ' ') ;
+    if (*c != '"') return "";
+    const char *e = strchr(++c, '"');
+    return e ? std::string(c, e - c) : "";
+}
+
+bool cbDial(LSHandle *sh, LSMessage *msg, void *)
+{
+    LSError err; LSErrorInit(&err);
+    const char *payload = LSMessageGetPayload(msg);
+    std::string addr = getField(payload, "address");
+    // A video call, when the peer speaks tgcalls V2 (tgcalls-lite); libtgvoip carries its audio.
+    bool video = getBool(payload, "video") == 1;
+    bool ok = g_account && !addr.empty() && callBridgeDial(g_account, addr.c_str(), video);
+    tgcLog("dial %s%s: %s", addr.c_str(), video ? " (video)" : "", ok ? "placed" : "failed");
+    LSMessageReply(sh, msg, ok ? "{\"returnValue\":true}" : "{\"returnValue\":false}", &err);
+    if (LSErrorIsSet(&err)) LSErrorFree(&err);
+    return true;
+}
+
+bool cbAnswer(LSHandle *sh, LSMessage *msg, void *)
+{
+    LSError err; LSErrorInit(&err);
+    if (g_account) callBridgeAnswer(g_account);
+    LSMessageReply(sh, msg, "{\"returnValue\":true}", &err);
+    if (LSErrorIsSet(&err)) LSErrorFree(&err);
+    return true;
+}
+
+bool cbDisconnect(LSHandle *sh, LSMessage *msg, void *)
+{
+    LSError err; LSErrorInit(&err);
+    if (g_account) callBridgeHangup(g_account);
+    LSMessageReply(sh, msg, "{\"returnValue\":true}", &err);
+    if (LSErrorIsSet(&err)) LSErrorFree(&err);
+    return true;
+}
+
+// changeMedia {id, incomingVideo?, outgoingVideo?, deviceOrientation?} - the Phone app's video toggles (legacy
+// VideoCall.js/AbstractCall.js). A member left out leaves that direction as it is. incomingVideo:
+// the user wants to see the peer's video; outgoingVideo: our camera. The state change comes back
+// through callStateQuery.
+bool cbChangeMedia(LSHandle *sh, LSMessage *msg, void *)
+{
+    LSError err; LSErrorInit(&err);
+    const char *payload = LSMessageGetPayload(msg);
+    int in = getBool(payload, "incomingVideo"), out = getBool(payload, "outgoingVideo");
+    // Which way the phone is held, the shell's quarter turns: our picture's turn follows it.
+    int turns = getSmallUint(payload, "deviceOrientation");
+    tgcLog("changeMedia incoming=%d outgoing=%d orientation=%d", in, out, turns);
+    if (g_account)
+        callBridgeChangeMedia(g_account, in >= 0, in == 1, out >= 0, out == 1, turns);
+    LSMessageReply(sh, msg, "{\"returnValue\":true}", &err);
+    if (LSErrorIsSet(&err)) LSErrorFree(&err);
+    return true;
+}
+
+// The Phone app's manual-dial call contract methods (spec Part 3). We implement the ones a 1:1
+// VoIP call needs; the rest ack so CallSynergizer doesn't error.
+bool cbNoop(LSHandle *sh, LSMessage *msg, void *)
+{
+    LSError err; LSErrorInit(&err);
+    LSMessageReply(sh, msg, "{\"returnValue\":true}", &err);
+    if (LSErrorIsSet(&err)) LSErrorFree(&err);
+    return true;
+}
+
+LSMethod g_methods[] = {
+    { "callStateQuery", cbCallStateQuery, LUNA_METHOD_FLAGS_NONE },
+    { "dial",           cbDial,           LUNA_METHOD_FLAGS_NONE },
+    { "answer",         cbAnswer,         LUNA_METHOD_FLAGS_NONE },
+    { "disconnect",     cbDisconnect,     LUNA_METHOD_FLAGS_NONE },
+    { "hangupAll",      cbDisconnect,     LUNA_METHOD_FLAGS_NONE },
+    { "hangupAllActive",cbDisconnect,     LUNA_METHOD_FLAGS_NONE },
+    { "hold",           cbNoop,           LUNA_METHOD_FLAGS_NONE },
+    { "swap",           cbNoop,           LUNA_METHOD_FLAGS_NONE },
+    { "merge",          cbNoop,           LUNA_METHOD_FLAGS_NONE },
+    { "extract",        cbNoop,           LUNA_METHOD_FLAGS_NONE },
+    { "dtmf",           cbNoop,           LUNA_METHOD_FLAGS_NONE },
+    { "dtmfEnd",        cbNoop,           LUNA_METHOD_FLAGS_NONE },
+    { "changeMedia",    cbChangeMedia,    LUNA_METHOD_FLAGS_NONE },
+    { NULL, NULL, LUNA_METHOD_FLAGS_NONE }
+};
+
+} // namespace
+
+bool callLunaInit(PurpleAccount *account)
+{
+    g_account = account;
+    if (g_sh) return true;   // already registered (one service, whichever account connects first)
+
+    LSError err; LSErrorInit(&err);
+    if (!LSRegister("com.palm.telegram.call", &g_sh, &err)) {
+        purple_debug_error(config::pluginId, "LSRegister com.palm.telegram.call: %s\n", err.message);
+        LSErrorFree(&err); return false;
+    }
+    // libpurple runs the default main context, so the service is attached to that.
+    if (!LSRegisterCategory(g_sh, "/", g_methods, NULL, NULL, &err) ||
+        !LSGmainContextAttach(g_sh, g_main_context_default(), &err)) {
+        purple_debug_error(config::pluginId, "com.palm.telegram.call: %s\n", err.message);
+        LSErrorFree(&err);
+        LSErrorInit(&err);
+        if (!LSUnregister(g_sh, &err))
+            LSErrorFree(&err);
+        g_sh = NULL;
+        return false;
+    }
+    purple_debug_info(config::pluginId, "com.palm.telegram.call registered\n");
+    return true;
+}
+
+void callLunaShutdown(PurpleAccount *account)
+{
+    if (g_account == account) g_account = NULL;
+    // Keep the service registered for the process lifetime (cheap, and other accounts may use it).
+}
+
+// The Phone app drops a call card only when a push stops listing that call. So an ended call is
+// shown as "disconnected" for a moment and then the empty line list follows, as the WhatsApp
+// connector does. Any newer push cancels the pending one.
+constexpr guint kEndedCallHoldMs = 1500;
+static guint g_idlePush = 0;
+
+static gboolean pushIdle(gpointer)
+{
+    g_idlePush = 0;
+    callLunaPushState(NULL, NULL, NULL, false, NULL, false);
+    return G_SOURCE_REMOVE;
+}
+
+void callLunaPushState(const char *state, const char *peerAddress, const char *peerName,
+                       bool isOutgoing, const char *cause, bool isVideo)
+{
+    if (g_idlePush) {
+        g_source_remove(g_idlePush);
+        g_idlePush = 0;
+    }
+    if (state && !strcmp(state, "disconnected"))
+        g_idlePush = g_timeout_add(kEndedCallHoldMs, pushIdle, NULL);
+
+    // A call starts when a line appears where there was none, or replaces an ended one. A repeated
+    // "disconnected" still belongs to the call that ended.
+    bool newCall = state && *state &&
+                   (g_state.empty() || (g_state == "disconnected" && strcmp(state, "disconnected") != 0));
+    if (newCall)
+        g_cardId = "tg-" + std::to_string(g_get_real_time());
+
+    g_state    = state       ? state       : "";
+    g_peerAddr = peerAddress  ? peerAddress : "";
+    g_peerName = peerName     ? peerName    : "";
+    g_cause    = cause        ? cause       : "";
+    g_outgoing = isOutgoing;
+    g_isVideo  = isVideo;
+    tgcLog("state %s, peer %s", g_state.empty() ? "idle" : g_state.c_str(), g_peerAddr.c_str());
+    if (!g_sh) return;
+    std::string payload = buildPayload();
+    LSError err; LSErrorInit(&err);
+    if (!LSSubscriptionReply(g_sh, SUBKEY, payload.c_str(), &err)) {
+        purple_debug_warning(config::pluginId, "callStateQuery push: %s\n", err.message);
+        LSErrorFree(&err);
+    }
+}
+
+// --- call audio -------------------------------------------------------------------------------
+// audiod has to be told a VoIP call is up: only then does it put the call devices -- the voipcall
+// sink and webcall source libtgvoip plays to and records from (call.cpp) -- on the earpiece or
+// the headset and the microphone. The transport names this connector and must not be
+// com.palm.telephony, which would make audiod switch the modem's voice-call path on. audiod keeps
+// the calls of each sender apart, so the update goes out on this service's own handle, and the
+// empty list on hangup only clears our own call. No scenario is forced: the call starts wherever
+// audiod routes calls (earpiece, or a connected headset), and the Phone app's speaker button
+// moves it.
+static bool audiodReply(LSHandle *sh, LSMessage *m, void *ctx) { (void)sh; (void)m; (void)ctx; return true; }
+static bool g_audioOn = false, g_audioVideo = false;
+static void audiodSend(const char *uri, const char *payload)
+{
+    if (!g_sh) return;
+    LSError err; LSErrorInit(&err);
+    LSMessageToken tok;
+    if (!LSCallOneReply(g_sh, uri, payload, audiodReply, NULL, &tok, &err)) {
+        purple_debug_warning(config::pluginId, "audiod %s: %s\n", uri, err.message);
+        LSErrorFree(&err);
+    }
+}
+void callLunaSetCallAudio(bool active)
+{
+    tgcLog("call audio %s", active ? "on" : "off");
+    g_audioOn = active;
+    if (!active)
+        g_audioVideo = false;
+    if (active)
+        audiodSend("palm://com.palm.audio/phone/CallStatusUpdate",
+                   g_audioVideo ? "{\"lines\":[{\"state\":\"active\",\"calls\":[{\"id\":\"tg\",\"video\":true,"
+                                  "\"transport\":\"com.palm.telegram\"}]}]}"
+                                : "{\"lines\":[{\"state\":\"active\",\"calls\":[{\"id\":\"tg\",\"video\":false,"
+                                  "\"transport\":\"com.palm.telegram\"}]}]}");
+    else
+        audiodSend("palm://com.palm.audio/phone/CallStatusUpdate", "{\"lines\":[]}");
+}
+
+void callLunaSetCallVideo(bool video)
+{
+    if (video == g_audioVideo)
+        return;
+    g_audioVideo = video;
+    if (g_audioOn)
+        callLunaSetCallAudio(true);
+}
+
+// --- video: org.webosports.rtcengine ------------------------------------------------------------
+namespace {
+using RtcReply = std::function<void(const std::string &)>;
+
+bool rtcReply(LSHandle *, LSMessage *msg, void *ctx)
+{
+    std::unique_ptr<RtcReply> cb(static_cast<RtcReply *>(ctx));
+    const char *payload = LSMessageGetPayload(msg);
+    if (*cb)
+        (*cb)(payload ? payload : "");
+    return true;
+}
+} // namespace
+
+bool callLunaRtcCall(const std::string &method, const std::string &payload, std::function<void(const std::string &reply)> onReply)
+{
+    if (!g_sh) return false;
+    const std::string uri = "luna://org.webosports.rtcengine/" + method;
+    // One reply: the callback object is freed in rtcReply. Replies without a callback are logged.
+    if (!onReply)
+        onReply = [method](const std::string &reply) {
+            tgcLog("rtcengine %s: %s", method.c_str(), reply.c_str());
+        };
+    RtcReply *ctx = new RtcReply(std::move(onReply));
+    LSError err; LSErrorInit(&err);
+    LSMessageToken tok;
+    if (!LSCallOneReply(g_sh, uri.c_str(), payload.c_str(), rtcReply, ctx, &tok, &err)) {
+        purple_debug_warning(config::pluginId, "rtcengine %s: %s\n", method.c_str(), err.message);
+        LSErrorFree(&err);
+        delete ctx;
+        return false;
+    }
+    return true;
+}
+
+void callLunaSetVideo(const std::string &lineFields, const std::string &payloadFields)
+{
+    if (lineFields == g_videoLine && payloadFields == g_videoPayload)
+        return;
+    g_videoLine = lineFields;
+    g_videoPayload = payloadFields;
+    if (!g_sh || g_state.empty()) return;
+    std::string payload = buildPayload();
+    LSError err; LSErrorInit(&err);
+    if (!LSSubscriptionReply(g_sh, SUBKEY, payload.c_str(), &err)) {
+        purple_debug_warning(config::pluginId, "callStateQuery push: %s\n", err.message);
+        LSErrorFree(&err);
+    }
+}

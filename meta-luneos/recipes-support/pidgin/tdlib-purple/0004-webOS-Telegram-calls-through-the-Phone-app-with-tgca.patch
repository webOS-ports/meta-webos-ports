+void TdAccountData::addPendingCallSignaling(const std::string &data)
+{
+    // Only the first few messages can arrive before the engine starts; a peer flooding us is
+    // not worth queueing.
+    if (m_pendingCallSignaling.size() < 64)
+        m_pendingCallSignaling.push_back(data);
+}
+
+std::vector<std::string> TdAccountData::takePendingCallSignaling()
+{
+    std::vector<std::string> result;
+    result.swap(m_pendingCallSignaling);
+    return result;
+}
+
 void TdAccountData::removeActiveCall()
 {
+    m_callEngine.reset();
+    m_pendingCallSignaling.clear();
     m_callData.reset();
     m_callId = 0;
+    m_callInitiating = false;   // failed/ended: allow a fresh dial
+    m_callDialedAddress.clear();
 }
 

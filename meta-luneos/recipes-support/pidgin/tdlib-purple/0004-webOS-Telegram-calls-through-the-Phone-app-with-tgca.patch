+{
+    // Taken on another device: the server discards it here with no reason.
+    expect("incoming, empty, not answered here",
+           callEndCause(CallEndReason::Empty, false, false), "answeredElsewhere");
+    expect("incoming, no reason, not answered here",
+           callEndCause(CallEndReason::None, false, false), "answeredElsewhere");
+
+    // The caller gave up while it rang: still a missed call.
+    expect("incoming, missed", callEndCause(CallEndReason::Missed, false, false), "missed");
+    // Declined (here, or by the peer): rejected.
+    expect("incoming, declined", callEndCause(CallEndReason::Declined, false, false), "rejected");
+    expect("outgoing, declined", callEndCause(CallEndReason::Declined, true, false), "rejected");
+
+    // An empty reason on a call taken here, or on our own outgoing call, is a normal end.
+    expect("incoming, empty, answered here",
+           callEndCause(CallEndReason::Empty, false, true), "normal");
+    expect("outgoing, empty", callEndCause(CallEndReason::Empty, true, false), "normal");
+    expect("outgoing, no reason", callEndCause(CallEndReason::None, true, false), "normal");
+
+    // Every other reason is a normal end, whoever answered.
+    expect("incoming, hung up", callEndCause(CallEndReason::HungUp, false, true), "normal");
+    expect("incoming, hung up, not answered here",
+           callEndCause(CallEndReason::HungUp, false, false), "normal");
+    expect("incoming, disconnected", callEndCause(CallEndReason::Disconnected, false, false), "normal");
+    expect("incoming, upgrade", callEndCause(CallEndReason::UpgradeToGroupCall, false, false), "normal");
+    expect("incoming, other", callEndCause(CallEndReason::Other, false, false), "normal");
+
+    if (failures) return 1;
+    std::printf("call-end-test: all passed\n");
+    return 0;
+}

+    case td::td_api::callDiscardReasonEmpty::ID:              return CallEndReason::Empty;
+    case td::td_api::callDiscardReasonMissed::ID:             return CallEndReason::Missed;
+    case td::td_api::callDiscardReasonDeclined::ID:           return CallEndReason::Declined;
+    case td::td_api::callDiscardReasonDisconnected::ID:       return CallEndReason::Disconnected;
+    case td::td_api::callDiscardReasonHungUp::ID:             return CallEndReason::HungUp;
+    case td::td_api::callDiscardReasonUpgradeToGroupCall::ID: return CallEndReason::UpgradeToGroupCall;

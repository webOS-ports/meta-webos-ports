@@ -0,0 +1,187 @@
+#ifndef _TGCALLS_VIDEO_H
+#define _TGCALLS_VIDEO_H
+
+// Telegram video for tgcalls-lite calls, through luneos-rtc-engine (org.webosports.rtcengine),
+// which WhatsApp calls use too: the engine owns the camera, the H.264 encoder and decoder and the
+// gst-shm frames the Phone app shows. This file only decides when an engine session runs, moves
+// access units over the engine's two sockets, and describes the video to the Phone app. Nothing
+// here depends on TDLib or luna-service2 (the LS2 calls are a function the caller passes in), so
+// it is tested on its own (test/tgcalls-video-test.cpp).
+//
+// Everything except the TX socket reader runs on libpurple's main loop, like the call engine.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace tgvideo {
+
+// How far a Telegram receiver turns our camera's picture clockwise for the phone held upright.
+// A call to Android showed 90 arriving upside down, so three quarter turns (WhatsApp's
+// <video device_orientation> counts the other way and says one).
+constexpr int kTxRotationDegrees = 270;
+
+// The same for the phone as it is held now. deviceTurns is the Phone app's changeMedia
+// {deviceOrientation}, the shell's quarter turns: 0 top up, 1 left edge up, 2 upside down, 3 right
+// edge up. The camera turns with the phone, so its picture's turn changes by as much, against
+// the phone's turn for the front camera (HAL id 1; sargo, 10 Nov: with it, it arrived upside
+// down held sideways); the back one looks away from the user, so there it counts the other way.
+constexpr int txRotationDegrees(int camera, int deviceTurns)
+{
+    return ((kTxRotationDegrees / 90 + (camera == 1 ? -deviceTurns : deviceTurns)) % 4 + 4) % 4 * 90;
+}
+
+// The engine's AU sockets (luneos-rtc-engine docs/API.md, "AU socket wire contract"): AF_UNIX
+// SOCK_SEQPACKET, one Annex-B access unit per datagram, the engine listening on both.
+//   RX: we send the peer's access units; the engine decodes them for the Phone app.
+//   TX: the engine sends our encoded camera; a thread reads it and hands each unit to a sink.
+class AuBridge {
+public:
+    // Called on the TX thread with each encoded camera access unit.
+    using TxSink = std::function<void(const uint8_t *au, size_t len)>;
+
+    AuBridge() = default;
+    ~AuBridge() { stop(); }
+    AuBridge(const AuBridge &) = delete;
+    AuBridge &operator=(const AuBridge &) = delete;
+
+    // The paths the engine's start reply named; "" for none (no TX: no camera). False if the
+    // bridge is running (its paths stay), or, with both cleared, if a path does not fit a
+    // sockaddr_un.
+    bool setSockets(const std::string &txPath, const std::string &rxPath);
+    // Starts passing units (and the TX thread if there is a TX path). Idempotent.
+    void start(TxSink sink);
+    // Stops the TX thread (joined) and closes the RX socket. Idempotent.
+    void stop();
+    bool running() const { return m_running; }
+
+    // One of the peer's access units, as the call engine delivers them. Never blocks: a unit the
+    // socket has no room for is dropped. After a drop, and when the socket (re)connects, units
+    // are held back until the next IDR. Returns true when the peer should be asked for one.
+    bool receive(const uint8_t *au, size_t len);
+
+    struct Stats {
+        unsigned long long rxSent = 0, rxDropped = 0, txUnits = 0;
+    };
+    Stats stats() const;
+
+private:
+    void rxConnect();
+    void txMain(std::string path, TxSink sink);
+
+    std::string m_txPath, m_rxPath;
+    bool m_running = false;
+    int m_rxFd = -1;
+    bool m_rxWaitIdr = true;
+    int64_t m_rxLastConnectUs = 0;
+    unsigned long long m_rxSent = 0, m_rxDropped = 0;
+    std::atomic<unsigned long long> m_txUnits{0};
+    std::thread m_txThread;
+    std::atomic<bool> m_txStop{false};
+};
+
+// True if the Annex-B access unit holds an IDR slice (NAL type 5).
+bool auHasIdr(const uint8_t *au, size_t len);
+
+// Engine paths on the device. The engine binds them, like its own defaults, in /tmp.
+struct EnginePaths {
+    std::string rxSocket = "/tmp/tg-rtc-rx.sock";
+    std::string txSocket = "/tmp/tg-rtc-tx.sock";
+    std::string shm = "/tmp/tg-rtc-video";
+    std::string preview = "/tmp/tg-rtc-preview";
+};
+
+// When the engine session runs, and what the Phone app is told. Inputs come from the Phone app
+// (changeMedia), the call engine (the peer's camera, frames) and the call (active or not).
+//
+// A session runs while the call is up and either our camera should be on and the device can send
+// (the engine's capabilities, and no failed TX start), or the peer sends video and the user chose
+// to see it. It encodes our camera when that should be on and can be; otherwise it only decodes.
+class Controller {
+public:
+    // Calls method of org.webosports.rtcengine with payload. onReply (may be empty) gets the
+    // reply payload on the main loop. Returns false if the call could not be sent.
+    using RtcCall = std::function<bool(const std::string &method, const std::string &payload,
+                                       std::function<void(const std::string &reply)> onReply)>;
+
+    explicit Controller(RtcCall rtc, EnginePaths paths = EnginePaths());
+    ~Controller();
+    Controller(const Controller &) = delete;
+    Controller &operator=(const Controller &) = delete;
+
+    void setCallActive(bool on);
+    void setOurCamera(bool on);   // what the user wants: our camera on or off
+    void setPeerVideo(bool on);   // the peer's offer has video
+    void setView(bool on);        // the user chose to see the peer's video
+
+    // The peer asked for a keyframe of our video: passed to the encoder at most once a second.
+    void requestKeyframe(int64_t nowUs);
+    // One of the peer's access units arrived (for incomingVideoState "streaming").
+    void noteFrame(int64_t nowUs) { m_lastFrameUs = nowUs; }
+    // Call about once a second: notices the peer's frames stopping or starting. Returns true
+    // (and fires onChanged) when what the Phone app is told changed.
+    bool tick(int64_t nowUs);
+
+    // Where our encoded camera goes (called on the TX thread): the call engine's
+    // postVideoAccessUnit(). Set before the session starts.
+    AuBridge::TxSink txSink;
+    // Our camera's picture is sent: the call engine should offer video.
+    std::function<void(bool sending)> onSendingChanged;
+    // What the Phone app is told changed (republish the call state, tell audiod).
+    std::function<void()> onChanged;
+    // A session started decoding mid-stream: ask the peer for an IDR.
+    std::function<void()> onPeerKeyframeWanted;
+
+    AuBridge &bridge() { return m_bridge; }
+    bool running() const { return m_state == State::Running; }
+    bool sending() const { return running() && m_tx; }
+    bool streaming() const { return m_streaming; }
+
+    // JSON members (each starting with ',') for the call state the Phone app reads.
+    std::string lineFields() const;     // on the line
+    std::string payloadFields() const;  // at the top level
+
+    // The camera the session opens (HAL id; 1 is the front one where there are two).
+    int camera() const { return m_camera; }
+
+private:
+    enum class State { Idle, Probing, Starting, Running };
+    void reconcile();
+    void close();
+    void startSession(bool tx);
+    void onCaps(unsigned gen, const std::string &reply);
+    void onStart(unsigned gen, const std::string &reply);
+    bool wanted() const;
+    bool wantTx() const;
+    void changed();
+
+    RtcCall m_rtc;
+    EnginePaths m_paths;
+    AuBridge m_bridge;
+    State m_state = State::Idle;
+    unsigned m_gen = 0;         // bumped on every close: replies of an older session are ignored
+    bool m_callActive = false, m_ourCamera = false, m_peerVideo = false, m_view = false;
+    bool m_failed = false;      // a start failed: no retry until the wish changes
+    bool m_retried = false;     // one stop-and-retry after "already running"
+    bool m_canSend = true;      // capabilities: videoCallCapable
+    bool m_tx = false;          // the running (or starting) session encodes our camera
+    int m_camera = 0;
+    int m_width = 0, m_height = 0;
+    int64_t m_lastKeyframeUs = 0;
+    bool m_keyframeAsked = false;
+    int64_t m_lastFrameUs = 0;
+    bool m_streaming = false;
+};
+
+// Tiny readers for the engine's flat JSON replies.
+bool jsonBool(const std::string &json, const char *key);
+std::string jsonString(const std::string &json, const char *key);
+long jsonInt(const std::string &json, const char *key, long fallback);
+
+} // namespace tgvideo
+
+#endif

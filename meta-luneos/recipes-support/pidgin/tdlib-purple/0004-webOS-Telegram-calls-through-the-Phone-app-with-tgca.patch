+static void test_json()
+{
+    CHECK(jsonBool("{\"a\":true}", "a") && !jsonBool("{\"a\":false}", "a") && !jsonBool("{\"a\":1}", "a"), "bool");
+    CHECK(!jsonBool("not json", "a") && !jsonBool("[true]", "a") && !jsonBool("{}", "a"), "bool fallbacks");
+    CHECK(jsonString("{\"s\":\"x\\\"y\"}", "s") == "x\"y" && jsonString("{\"s\":3}", "s").empty(), "string");
+    CHECK(jsonInt("{\"n\":2}", "n", -1) == 2 && jsonInt("{\"n\":2.0}", "n", -1) == 2 && jsonInt("{\"n\":\"2\"}", "n", -1) == -1 &&
+          jsonInt("{}", "n", 7) == 7, "int");
+    const uint8_t three[] = {0, 0, 1, 0x65};
+    CHECK(auHasIdr(three, 4) && !auHasIdr(three, 3) && !auHasIdr(nullptr, 4), "auHasIdr");
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s <directory for the test sockets>\n", argv[0]);
+        return 2;
+    }
+    const std::string dir = argv[1];
+    test_json();
+    test_bridge_rx(dir);
+    test_bridge_tx(dir);
+    test_controller();
+    test_controller_failures();
+    if (failures) {
+        fprintf(stderr, "%d failure(s)\n", failures);
+        return 1;
+    }
+    fprintf(stderr, "ALL OK -- tgcalls-video\n");
+    return 0;
+}
diff --git a/test/video-rotation-test.cpp b/test/video-rotation-test.cpp
new file mode 100644
index 0000000..39ca82a
--- /dev/null
+++ b/test/video-rotation-test.cpp
@@ -0,0 +1,45 @@
+// The turn a Telegram receiver gives our camera's picture as the phone is turned
+// (tgvideo::txRotationDegrees). Header only: tgcalls-video.cpp itself needs tgcalls-lite.
+#include "tgcalls-video.h"
+#include <gtest/gtest.h>
+
+namespace {
+
+constexpr int kFront = 1, kBack = 0;
+
+TEST(VideoRotation, HeldUprightIsTheUsualTurn)
+{
+    EXPECT_EQ(tgvideo::txRotationDegrees(kFront, 0), tgvideo::kTxRotationDegrees);
+    EXPECT_EQ(tgvideo::txRotationDegrees(kBack, 0), tgvideo::kTxRotationDegrees);
+}
+
+// The front camera faces the user: the turn goes down a quarter for every quarter the phone is
+// turned left edge up (the shell's 1), and wraps.
+TEST(VideoRotation, TheFrontCameraFollowsThePhone)
+{
+    EXPECT_EQ(tgvideo::txRotationDegrees(kFront, 1), 180);
+    EXPECT_EQ(tgvideo::txRotationDegrees(kFront, 2), 90);
+    EXPECT_EQ(tgvideo::txRotationDegrees(kFront, 3), 0);
+}
+
+// The back camera looks away: the phone's turn counts the other way.
+TEST(VideoRotation, TheBackCameraCountsTheOtherWay)
+{
+    EXPECT_EQ(tgvideo::txRotationDegrees(kBack, 1), 0);
+    EXPECT_EQ(tgvideo::txRotationDegrees(kBack, 2), 90);
+    EXPECT_EQ(tgvideo::txRotationDegrees(kBack, 3), 180);
+}
+
+// Always a whole quarter turn in [0, 360), as the engine's MediaState needs.
+TEST(VideoRotation, AlwaysAQuarterTurnInRange)
+{
+    for (int camera : {kBack, kFront})
+        for (int turns = 0; turns < 4; turns++) {
+            int d = tgvideo::txRotationDegrees(camera, turns);
+            EXPECT_GE(d, 0);
+            EXPECT_LT(d, 360);
+            EXPECT_EQ(d % 90, 0);
+        }
+}
+
+} // namespace
diff --git a/tgcalls-call.cpp b/tgcalls-call.cpp
new file mode 100644
index 0000000..9211633
--- /dev/null
+++ b/tgcalls-call.cpp
@@ -0,0 +1,285 @@
+#include "tgcalls-call.h"
+
+#ifdef HAVE_TGCALLS_LITE
+
+#include "call-luna.h"
+#include "config.h"
+#include "tgcalls-video.h"
+#include "transceiver.h"
+
+#include <call_engine.h>
+
+#include <glib.h>
+#include <purple.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace {
+
+constexpr char kVersion[] = "7.0.0";
+constexpr size_t kKeySize = 256;
+constexpr guint kTickMs = 500;
+
+// One running call: the engine, its video (luneos-rtc-engine session, tgcalls-video.h) and the
+// timer that drives the engine's DTLS retransmissions.
+struct LiteCall {
+    std::unique_ptr<tgcalls_lite::CallEngine> engine;
+    // After engine: destroyed first, which joins the thread that feeds the engine our camera.
+    std::unique_ptr<tgvideo::Controller> video;
+    guint tickSource = 0;
+
+    ~LiteCall();
+};
+
+// The call in progress, for the Phone app's changeMedia; one call at a time, as in call-luna.cpp.
+LiteCall *g_current = nullptr;
+
+// What the Phone app asked for before the engine started (while ringing).
+struct MediaWish {
+    bool haveView = false, view = false, haveCamera = false, camera = false;
+} g_wish;
+
+// Which way the phone is held (the Phone app's changeMedia {deviceOrientation}); kept across
+// calls, since it is the phone's state and not a wish for this one.
+int g_deviceTurns = 0;
+
+void applyRotation(LiteCall &lite)
+{
+    if (lite.video && lite.video->sending())
+        lite.engine->setVideoRotation(tgvideo::txRotationDegrees(lite.video->camera(), g_deviceTurns));
+}
+
+LiteCall::~LiteCall()
+{
+    if (tickSource)
+        g_source_remove(tickSource);
+    if (g_current == this)
+        g_current = nullptr;
+    video.reset();
+    callLunaSetVideo(std::string(), std::string());
+}
+
+gboolean tick(gpointer data)
+{
+    LiteCall *lite = static_cast<LiteCall *>(data);
+    lite->engine->tick();
+    if (lite->video)
+        lite->video->tick(g_get_monotonic_time());
+    return G_SOURCE_CONTINUE;
+}
+
+void publishVideo(LiteCall &lite)
+{
+    callLunaSetVideo(lite.video->lineFields(), lite.video->payloadFields());
+    callLunaSetCallVideo(lite.video->running());
+}
+
+// Video through luneos-rtc-engine: the session follows our camera wish, the peer's camera and
+// whether the user chose to see it; the engine sends what the session encodes and the session
+// decodes what the engine receives.
+void wireVideo(LiteCall &lite, bool isVideoCall)
+{
+    lite.video.reset(new tgvideo::Controller(callLunaRtcCall));
+    tgvideo::Controller &video = *lite.video;
+    tgcalls_lite::CallEngine *engine = lite.engine.get();
+    LiteCall *call = &lite;
+
+    video.txSink = [engine](const uint8_t *au, size_t len) { engine->postVideoAccessUnit(au, len); };
+    video.onSendingChanged = [engine, call](bool on) {
+        if (on)
+            engine->setVideoRotation(tgvideo::txRotationDegrees(call->video->camera(), g_deviceTurns));
+        engine->setVideoSending(on);
+    };
+    video.onChanged = [call]() { publishVideo(*call); };
+    video.onPeerKeyframeWanted = [engine]() { engine->requestPeerKeyframe(); };
+
+    engine->onVideoAccessUnit = [call, engine](const uint8_t *au, unsigned int len) {
+        if (!call->video)
+            return;
+        call->video->noteFrame(g_get_monotonic_time());
+        if (call->video->bridge().receive(au, len))
+            engine->requestPeerKeyframe();
+    };
+    engine->onKeyframeRequested = [call]() {
+        if (call->video)
+            call->video->requestKeyframe(g_get_monotonic_time());
+    };
+    engine->onIncomingVideoChanged = [call](bool on) {
+        tgcLog("tgcalls-lite: peer camera %s", on ? "on" : "off");
+        if (call->video)
+            call->video->setPeerVideo(on);
+    };
+
+    // A video call starts with our camera on; the Phone app may have said otherwise meanwhile.
+    video.setOurCamera(g_wish.haveCamera ? g_wish.camera : isVideoCall);
+    if (g_wish.haveView)
+        video.setView(g_wish.view);
+    g_wish = MediaWish();
+    video.setCallActive(true);
+    publishVideo(lite);
+}
+
+LiteCall *liteCall(TdAccountData &account)
+{
+    return static_cast<LiteCall *>(account.getCallEngine());
+}
+
+void addServer(std::vector<tgcalls_lite::RtcServer> &list, const std::string &host, int32_t port,
+               const td::td_api::callServerTypeWebrtc &webrtc, bool turn)
+{
+    if (host.empty() || port <= 0 || port > 65535)
+        return;
+    tgcalls_lite::RtcServer server;
+    server.host = host;
+    server.port = (uint16_t)port;
+    server.isTurn = turn;
+    if (turn) {
+        server.login = webrtc.username_;
+        server.password = webrtc.password_;
+    }
+    list.push_back(std::move(server));
+}
+
+// STUN and TURN from callServerTypeWebrtc, both address families, as tdesktop's AppendServer()
+// does. Telegram reflectors (callServerTypeTelegramReflector) speak tgcalls' own ReflectorPort
+// protocol, which tgcalls-lite does not implement.
+std::vector<tgcalls_lite::RtcServer> rtcServers(const td::td_api::callStateReady &state)
+{
+    std::vector<tgcalls_lite::RtcServer> list;
+    for (const auto &server : state.servers_) {
+        if (!server || !server->type_ || server->type_->get_id() != td::td_api::callServerTypeWebrtc::ID)
+            continue;
+        const auto &webrtc = static_cast<const td::td_api::callServerTypeWebrtc &>(*server->type_);
+        if (webrtc.supports_stun_) {
+            addServer(list, server->ip_address_, server->port_, webrtc, false);
+            addServer(list, server->ipv6_address_, server->port_, webrtc, false);
+        }
+        if (webrtc.supports_turn_ && !webrtc.username_.empty() && !webrtc.password_.empty()) {
+            addServer(list, server->ip_address_, server->port_, webrtc, true);
+            addServer(list, server->ipv6_address_, server->port_, webrtc, true);
+        }
+    }
+    return list;
+}
+
+} // namespace
+
+const char *tgcallsLiteVersion()
+{
+    return kVersion;
+}
+
+bool tgcallsLiteEnabled()
+{
+    const char *engine = getenv("LUNEOS_TELEGRAM_CALL_ENGINE");
+    return !(engine && strcmp(engine, "tgvoip") == 0);
+}
+
+bool tgcallsLiteAgreed(const td::td_api::callStateReady &state)
+{
+    if (!state.protocol_)
+        return false;
+    for (const auto &version : state.protocol_->library_versions_)
+        if (version == kVersion)
+            return true;
+    return false;
+}
+
+bool tgcallsLiteStart(const td::td_api::call &call, const td::td_api::callStateReady &state,
+                      TdAccountData &account, TdTransceiver &transceiver)
+{
+    if (liteCall(account))
+        return true;
+    if (state.encryption_key_.size() != kKeySize) {
+        tgcLog("tgcalls-lite: encryption key is %zu bytes, not %zu", state.encryption_key_.size(), kKeySize);
+        return false;
+    }
+
+    auto lite = std::make_shared<LiteCall>();
+    // Our camera joins once its session runs (wireVideo): the engine starts without video.
+    lite->engine = std::make_unique<tgcalls_lite::CallEngine>(
+        g_main_context_default(), reinterpret_cast<const uint8_t *>(state.encryption_key_.data()),
+        call.is_outgoing_, false);
+    tgcalls_lite::CallEngine &engine = *lite->engine;
+
+    const auto servers = rtcServers(state);
+    const size_t applied = engine.setServers(servers);
+    tgcLog("tgcalls-lite: call %d, outgoing=%d, %zu of %zu STUN/TURN servers applied, p2p=%d",
+           (int)call.id_, (int)call.is_outgoing_, applied, servers.size(), (int)state.allow_p2p_);
+
+    const int32_t callId = call.id_;
+    engine.onOutgoingSignalingData = [callId, &transceiver](const std::vector<uint8_t> &data) {
+        auto request = td::td_api::make_object<td::td_api::sendCallSignalingData>();
+        request->call_id_ = callId;
+        request->data_.assign(reinterpret_cast<const char *>(data.data()), data.size());
+        transceiver.sendQuery(std::move(request), nullptr);
+    };
+    engine.onMediaReady = [callId]() {
+        tgcLog("tgcalls-lite: call %d media connected", (int)callId);
+    };
+
+    lite->tickSource = g_timeout_add(kTickMs, tick, lite.get());
+    g_current = lite.get();
+    wireVideo(*lite, call.is_video_);
+    account.setCallEngine(lite);
+
+    // audiod routes the voipcall sink and webcall source once it knows a VoIP call is up.
+    callLunaSetCallAudio(true);
+    if (!engine.startAudio("voipcall", "webcall"))
+        tgcLog("tgcalls-lite: call %d has no audio", (int)callId);
+    engine.start();
+
+    // Signalling that arrived before callStateReady.
+    for (const std::string &data : account.takePendingCallSignaling())
+        engine.handleIncomingSignalingData(std::vector<uint8_t>(data.begin(), data.end()));
+    return true;
+}
+
+void tgcallsLiteSignalingData(int32_t callId, const std::string &data, TdAccountData &account)
+{
+    if (!account.hasActiveCall() || account.getActiveCallId() != callId)
+        return;
+    if (LiteCall *lite = liteCall(account))
+        lite->engine->handleIncomingSignalingData(std::vector<uint8_t>(data.begin(), data.end()));
+    else
+        account.addPendingCallSignaling(data);
+}
+
+void tgcallsLiteChangeMedia(bool hasView, bool view, bool hasCamera, bool camera, int deviceTurns)
+{
+    if (deviceTurns >= 0 && deviceTurns <= 3 && deviceTurns != g_deviceTurns) {
+        g_deviceTurns = deviceTurns;
+        if (g_current)
+            applyRotation(*g_current);
+    }
+    if (!g_current || !g_current->video) {
+        // Not started yet (ringing): applied when it starts.
+        if (hasView) {
+            g_wish.haveView = true;
+            g_wish.view = view;
+        }
+        if (hasCamera) {
+            g_wish.haveCamera = true;
+            g_wish.camera = camera;
+        }
+        return;
+    }
+    if (hasView)
+        g_current->video->setView(view);
+    if (hasCamera)
+        g_current->video->setOurCamera(camera);
+}
+
+void tgcallsLiteStop(TdAccountData &account)
+{
+    g_wish = MediaWish();
+    if (!liteCall(account))
+        return;
+    tgcLog("tgcalls-lite: call %d stopped", (int)account.getActiveCallId());
+    account.setCallEngine(nullptr);
+}
+
+#endif
diff --git a/tgcalls-call.h b/tgcalls-call.h
new file mode 100644
index 0000000..258c097
--- /dev/null
+++ b/tgcalls-call.h
@@ -0,0 +1,43 @@
+#ifndef _TGCALLS_CALL_H
+#define _TGCALLS_CALL_H
+
+// Telegram calls through tgcalls-lite: tgcalls V2 with signalling version 7.0.0 (raw encrypted
+// signalling packets relayed by TDLib, ICE through libnice, DTLS-SRTP, Opus, H.264 video through
+// luneos-rtc-engine, see tgcalls-video.h). Current clients
+// register that version (tgcalls InstanceV2Impl); libtgvoip carries a call only when the peer
+// agrees on no version at all.
+
+#include "account-data.h"
+#include <string>
+
+#ifdef HAVE_TGCALLS_LITE
+
+// The library version tgcalls-lite speaks, for callProtocol.library_versions.
+const char *tgcallsLiteVersion();
+
+// False when LUNEOS_TELEGRAM_CALL_ENGINE=tgvoip is set, to fall back to libtgvoip for testing.
+bool tgcallsLiteEnabled();
+
+// True if the agreed protocol in callStateReady names tgcallsLiteVersion().
+bool tgcallsLiteAgreed(const td::td_api::callStateReady &state);
+
+// Starts the engine for a call that reached callStateReady. Returns false if it could not start
+// (bad key, engine error); the caller then discards the call.
+bool tgcallsLiteStart(const td::td_api::call &call, const td::td_api::callStateReady &state,
+                      TdAccountData &account, TdTransceiver &transceiver);
+
+// updateNewCallSignalingData for the active call. Kept until the engine starts if it is early.
+void tgcallsLiteSignalingData(int32_t callId, const std::string &data, TdAccountData &account);
+
+// Stops the engine and its audio and video, if one is running.
+void tgcallsLiteStop(TdAccountData &account);
+
+// The Phone app's changeMedia: whether the user wants to see the peer's video (view) and to send
+// our camera. A field the Phone app left out is not changed. Before the call's engine starts, the
+// wish is kept for it.
+// deviceTurns: which way the phone is held, the shell's quarter turns; -1 when not given.
+void tgcallsLiteChangeMedia(bool hasView, bool view, bool hasCamera, bool camera, int deviceTurns = -1);
+
+#endif
+
+#endif
diff --git a/tgcalls-video.cpp b/tgcalls-video.cpp
new file mode 100644
index 0000000..e8d57d0
--- /dev/null
+++ b/tgcalls-video.cpp
@@ -0,0 +1,579 @@
+#include "tgcalls-video.h"
+
+#ifdef HAVE_TGCALLS_LITE
+
+#include <glib.h>
+#include <json-glib/json-glib.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace tgvideo {
+
+namespace {
+
+// Largest access unit read from the TX socket: keyframes at 640x480 are tens of KB, at 1280x720
+// hundreds (luneos-rtc-engine docs/API.md). A larger datagram is truncated by recv() and dropped.
+constexpr size_t kTxAuMax = 1024 * 1024;
+// Send buffer asked for on the RX socket: a SOCK_SEQPACKET datagram must fit whole, so this
+// bounds the largest peer keyframe passed on.
+constexpr int kRxSndBuf = 1024 * 1024;
+constexpr int kReconnectIntervalMs = 200;
+constexpr int64_t kKeyframeMinIntervalUs = G_USEC_PER_SEC;
+// The peer's video counts as streaming while a frame came within this.
+constexpr int64_t kStreamingTimeoutUs = 2 * G_USEC_PER_SEC;
+
+// Sizes, as for WhatsApp (glue/call.c of purple-combined): what the engine renders to (and
+// encodes at, with a camera). Receive-only is portrait, as phones send; the engine letterboxes
+// other shapes.
+constexpr int kTxWidth = 640, kTxHeight = 480;
+constexpr int kRxOnlyWidth = 480, kRxOnlyHeight = 640;
+constexpr int kTxBitrate = 1200000;
+constexpr int kPreviewWidth = 320, kPreviewHeight = 240;
+// Our own inset is turned by the video app, not by a tgcalls receiver, and sargo's camera held
+// upright needs one quarter turn there (as for WhatsApp); it is not tied to kTxRotationDegrees.
+// The Phone app adds its own screen's turn to it.
+constexpr int kPreviewQuarterTurns = 1;
+
+int connectSeqpacket(const std::string &path)
+{
+    struct sockaddr_un sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sun_family = AF_UNIX;
+    if (path.size() >= sizeof sa.sun_path)
+        return -1;
+    memcpy(sa.sun_path, path.c_str(), path.size() + 1);
+    int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return -1;
+    if (connect(fd, reinterpret_cast<struct sockaddr *>(&sa), sizeof sa) < 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+bool fitsSunPath(const std::string &path)
+{
+    return path.size() < sizeof(sockaddr_un::sun_path);
+}
+
+std::string jsonQuote(const std::string &s)
+{
+    std::string o = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') {
+            o += '\\';
+            o += c;
+        } else if ((unsigned char)c < 0x20) {
+            char buf[8];
+            snprintf(buf, sizeof buf, "\\u%04x", (unsigned)(unsigned char)c);
+            o += buf;
+        } else {
+            o += c;
+        }
+    }
+    return o + "\"";
+}
+
+// The reply's root object, or nullptr; unref the parser.
+JsonObject *parseObject(const std::string &json, JsonParser **parser)
+{
+    *parser = json_parser_new();
+    if (!json_parser_load_from_data(*parser, json.c_str(), (gssize)json.size(), nullptr))
+        return nullptr;
+    JsonNode *root = json_parser_get_root(*parser);
+    return root && JSON_NODE_HOLDS_OBJECT(root) ? json_node_get_object(root) : nullptr;
+}
+
+JsonNode *member(JsonObject *obj, const char *key)
+{
+    return obj && json_object_has_member(obj, key) ? json_object_get_member(obj, key) : nullptr;
+}
+
+} // namespace
+
+bool jsonBool(const std::string &json, const char *key)
+{
+    JsonParser *parser;
+    JsonNode *n = member(parseObject(json, &parser), key);
+    bool v = n && JSON_NODE_HOLDS_VALUE(n) && json_node_get_value_type(n) == G_TYPE_BOOLEAN &&
+             json_node_get_boolean(n);
+    g_object_unref(parser);
+    return v;
+}
+
+std::string jsonString(const std::string &json, const char *key)
+{
+    JsonParser *parser;
+    JsonNode *n = member(parseObject(json, &parser), key);
+    std::string v;
+    if (n && JSON_NODE_HOLDS_VALUE(n) && json_node_get_value_type(n) == G_TYPE_STRING)
+        v = json_node_get_string(n);
+    g_object_unref(parser);
+    return v;
+}
+
+long jsonInt(const std::string &json, const char *key, long fallback)
+{
+    JsonParser *parser;
+    JsonNode *n = member(parseObject(json, &parser), key);
+    long v = fallback;
+    if (n && JSON_NODE_HOLDS_VALUE(n)) {
+        GType t = json_node_get_value_type(n);
+        if (t == G_TYPE_INT64)
+            v = (long)json_node_get_int(n);
+        else if (t == G_TYPE_DOUBLE)
+            v = (long)json_node_get_double(n);
+    }
+    g_object_unref(parser);
+    return v;
+}
+
+bool auHasIdr(const uint8_t *au, size_t len)
+{
+    if (!au)
+        return false;
+    // NAL units follow 00 00 01 (a 4-byte start code ends the same way); the NAL type is the
+    // low five bits of the byte after it.
+    for (size_t i = 0; i + 3 < len; i++) {
+        if (au[i] == 0 && au[i + 1] == 0 && au[i + 2] == 1) {
+            if ((au[i + 3] & 0x1f) == 5)
+                return true;
+            i += 2;
+        }
+    }
+    return false;
+}
+
+// --- AuBridge ---------------------------------------------------------------------------------
+
+bool AuBridge::setSockets(const std::string &txPath, const std::string &rxPath)
+{
+    if (m_running)
+        return false; // the running bridge keeps its paths
+    if (!fitsSunPath(txPath) || !fitsSunPath(rxPath)) {
+        m_txPath.clear();
+        m_rxPath.clear();
+        return false;
+    }
+    m_txPath = txPath;
+    m_rxPath = rxPath;
+    return true;
+}
+
+void AuBridge::start(TxSink sink)
+{
+    if (m_running)
+        return;
+    m_running = true;
+    m_rxWaitIdr = true;
+    m_rxSent = m_rxDropped = 0;
+    m_txUnits = 0;
+    m_rxLastConnectUs = 0;
+    rxConnect();
+    if (!m_txPath.empty() && sink) {
+        m_txStop = false;
+        m_txThread = std::thread(&AuBridge::txMain, this, m_txPath, std::move(sink));
+    }
+}
+
+void AuBridge::stop()
+{
+    if (m_running)
+        fprintf(stderr, "tg-video: bridge stopped (rx sent %llu, dropped %llu, tx %llu)\n", m_rxSent,
+                m_rxDropped, (unsigned long long)m_txUnits);
+    m_running = false;
+    if (m_rxFd >= 0) {
+        close(m_rxFd);
+        m_rxFd = -1;
+    }
+    m_txStop = true;
+    if (m_txThread.joinable())
+        m_txThread.join();
+}
+
+AuBridge::Stats AuBridge::stats() const
+{
+    Stats s;
+    s.rxSent = m_rxSent;
+    s.rxDropped = m_rxDropped;
+    s.txUnits = m_txUnits;
+    return s;
+}
+
+void AuBridge::rxConnect()
+{
+    const int64_t now = g_get_monotonic_time();
+    if (m_rxFd >= 0 || m_rxPath.empty() ||
+        (m_rxLastConnectUs && now - m_rxLastConnectUs < kReconnectIntervalMs * 1000))
+        return;
+    m_rxLastConnectUs = now;
+    int fd = connectSeqpacket(m_rxPath);
+    if (fd < 0)
+        return;
+    int size = kRxSndBuf;
+    // SO_SNDBUFFORCE passes net.core.wmem_max when we may (the service runs as root).
+    if (setsockopt(fd, SOL_SOCKET, SO_SNDBUFFORCE, &size, sizeof size) < 0 &&
+        setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &size, sizeof size) < 0)
+        fprintf(stderr, "tg-video: rx send buffer stays at the default\n");
+    m_rxFd = fd;
+    m_rxWaitIdr = true; // joining mid-stream
+    fprintf(stderr, "tg-video: rx connected\n");
+}
+
+bool AuBridge::receive(const uint8_t *au, size_t len)
+{
+    if (!m_running || !au || len == 0)
+        return false;
+    rxConnect();
+    if (m_rxFd < 0)
+        return false;
+    if (m_rxWaitIdr) {
+        if (!auHasIdr(au, len)) {
+            m_rxDropped++;
+            return true;
+        }
+        m_rxWaitIdr = false;
+    }
+    ssize_t n = send(m_rxFd, au, len, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (n == (ssize_t)len) {
+        m_rxSent++;
+        return false;
+    }
+    int err = n < 0 ? errno : EMSGSIZE;
+    m_rxDropped++;
+    m_rxWaitIdr = true;
+    if (err != EAGAIN && err != EWOULDBLOCK && err != EMSGSIZE && err != ENOBUFS) {
+        // The engine went away (session stopped or restarted): connect again later.
+        close(m_rxFd);
+        m_rxFd = -1;
+    }
+    return true;
+}
+
+void AuBridge::txMain(std::string path, TxSink sink)
+{
+    std::unique_ptr<uint8_t[]> buf(new (std::nothrow) uint8_t[kTxAuMax]);
+    if (!buf)
+        return;
+    int fd = -1;
+    while (!m_txStop) {
+        if (fd < 0) {
+            fd = connectSeqpacket(path);
+            if (fd < 0) {
+                poll(nullptr, 0, kReconnectIntervalMs);
+                continue;
+            }
+            fprintf(stderr, "tg-video: tx connected\n");
+        }
+        struct pollfd p;
+        p.fd = fd;
+        p.events = POLLIN;
+        p.revents = 0;
+        int r = poll(&p, 1, kReconnectIntervalMs);
+        if (r < 0 && errno != EINTR)
+            break;
+        if (r <= 0)
+            continue;
+        ssize_t n = recv(fd, buf.get(), kTxAuMax, MSG_TRUNC);
+        if (n <= 0) {
+            // 0: the engine closed the socket. Connect again; the session may be restarting.
+            close(fd);
+            fd = -1;
+            continue;
+        }
+        if ((size_t)n > kTxAuMax) {
+            fprintf(stderr, "tg-video: tx access unit of %zd bytes dropped\n", n);
+            continue;
+        }
+        m_txUnits++;
+        sink(buf.get(), (size_t)n);
+    }
+    if (fd >= 0)
+        close(fd);
+}
+
+// --- Controller -------------------------------------------------------------------------------
+
+Controller::Controller(RtcCall rtc, EnginePaths paths) : m_rtc(std::move(rtc)), m_paths(std::move(paths)) {}
+
+Controller::~Controller()
+{
+    // No callbacks into a call that is going away.
+    onSendingChanged = nullptr;
+    onChanged = nullptr;
+    onPeerKeyframeWanted = nullptr;
+    close();
+    txSink = nullptr;
+}
+
+bool Controller::wanted() const
+{
+    return m_callActive && (wantTx() || (m_peerVideo && m_view));
+}
+
+bool Controller::wantTx() const
+{
+    return m_ourCamera && m_canSend;
+}
+
+void Controller::changed()
+{
+    if (onChanged)
+        onChanged();
+}
+
+void Controller::setCallActive(bool on)
+{
+    if (on == m_callActive)
+        return;
+    m_callActive = on;
+    if (!on)
+        m_view = false; // a new call asks again
+    reconcile();
+}
+
+void Controller::setOurCamera(bool on)
+{
+    if (on == m_ourCamera)
+        return;
+    m_ourCamera = on;
+    m_failed = false; // a new wish may start what failed before
+    reconcile();
+    changed();
+}
+
+void Controller::setPeerVideo(bool on)
+{
+    if (on == m_peerVideo)
+        return;
+    m_peerVideo = on;
+    if (!on)
+        m_streaming = false;
+    reconcile();
+    changed();
+}
+
+void Controller::setView(bool on)
+{
+    if (on == m_view)
+        return;
+    m_view = on;
+    m_failed = false;
+    reconcile();
+}
+
+void Controller::reconcile()
+{
+    if (!wanted()) {
+        m_failed = false;
+        m_retried = false;
+        close();
+        return;
+    }
+    if (m_state == State::Running && m_tx != wantTx()) {
+        // Camera on or off: the engine takes the TX chain only at start.
+        close();
+    }
+    if (m_state != State::Idle || m_failed)
+        return; // a reply on its way reconciles again
+    m_state = State::Probing;
+    const unsigned gen = m_gen;
+    if (!m_rtc("capabilities", "{}", [this, gen](const std::string &reply) { onCaps(gen, reply); })) {
+        m_state = State::Idle;
+        m_failed = true;
+    }
+}
+
+void Controller::onCaps(unsigned gen, const std::string &reply)
+{
+    if (gen != m_gen || m_state != State::Probing)
+        return;
+    if (!jsonBool(reply, "returnValue")) {
+        fprintf(stderr, "tg-video: engine capabilities failed\n");
+        m_state = State::Idle;
+        m_failed = true;
+        return;
+    }
+    // videoCallCapable honours the device's own policy (deviceinfo_video_call): a device without a
+    // usable camera still shows the peer, it just sends nothing. With two cameras take the front
+    // one: the droid backend passes the index to droidcamsrc as the HAL id, front = 1.
+    // Only ever lowered: a TX start that failed outweighs a later "capable".
+    m_canSend = m_canSend && jsonBool(reply, "videoCallCapable");
+    m_camera = jsonInt(reply, "cameraCount", 0) >= 2 ? 1 : 0;
+    m_state = State::Idle;
+    if (!wanted()) {
+        changed(); // our camera cannot be sent after all
+        return;
+    }
+    startSession(wantTx());
+}
+
+void Controller::startSession(bool tx)
+{
+    m_tx = tx;
+    m_width = tx ? kTxWidth : kRxOnlyWidth;
+    m_height = tx ? kTxHeight : kRxOnlyHeight;
+    char payload[640];
+    snprintf(payload, sizeof payload,
+             "{\"rxSocket\":%s,\"txSocket\":%s,\"rxEnabled\":true,\"txEnabled\":%s,\"shmPath\":%s,"
+             "\"width\":%d,\"height\":%d,\"bitrate\":%d,\"camera\":%d,\"previewShmPath\":%s,"
+             "\"previewWidth\":%d,\"previewHeight\":%d}",
+             jsonQuote(m_paths.rxSocket).c_str(), jsonQuote(m_paths.txSocket).c_str(), tx ? "true" : "false",
+             jsonQuote(m_paths.shm).c_str(), m_width, m_height, kTxBitrate, m_camera,
+             jsonQuote(tx ? m_paths.preview : std::string()).c_str(), kPreviewWidth, kPreviewHeight);
+    m_state = State::Starting;
+    const unsigned gen = m_gen;
+    if (!m_rtc("start", payload, [this, gen](const std::string &reply) { onStart(gen, reply); })) {
+        m_state = State::Idle;
+        m_failed = true;
+    }
+}
+
+void Controller::onStart(unsigned gen, const std::string &reply)
+{
+    const bool ok = jsonBool(reply, "returnValue");
+    if (gen != m_gen || m_state != State::Starting) {
+        // Closed while starting: stop what this start brought up.
+        if (ok)
+            m_rtc("stop", "{}", nullptr);
+        return;
+    }
+    if (!ok) {
+        const std::string err = jsonString(reply, "errorText");
+        m_state = State::Idle;
+        if (!m_retried && err == "already running") {
+            // A session we lost track of (the service restarted during a call): stop it, start ours.
+            fprintf(stderr, "tg-video: engine already running, stopping it and retrying\n");
+            m_retried = true;
+            m_rtc("stop", "{}", nullptr);
+            reconcile();
+            return;
+        }
+        if (m_tx && err == "tx start failed") {
+            // No usable camera or encoder after all: still show the peer.
+            fprintf(stderr, "tg-video: engine cannot send video, receiving only\n");
+            m_canSend = false;
+            changed();
+            reconcile(); // receive only, if the user wants to see the peer
+            return;
+        }
+        fprintf(stderr, "tg-video: engine start failed: %s\n", err.c_str());
+        m_failed = true;
+        return;
+    }
+    std::string rx = jsonString(reply, "rxSocket"), tx = jsonString(reply, "txSocket");
+    if (rx.empty())
+        rx = m_paths.rxSocket;
+    if (tx.empty())
+        tx = m_paths.txSocket;
+    if (!m_bridge.setSockets(m_tx ? tx : std::string(), rx)) {
+        fprintf(stderr, "tg-video: unusable engine socket paths\n");
+        m_rtc("stop", "{}", nullptr);
+        m_state = State::Idle;
+        m_failed = true;
+        return;
+    }
+    m_bridge.start(m_tx ? txSink : AuBridge::TxSink());
+    m_state = State::Running;
+    m_keyframeAsked = false;
+    fprintf(stderr, "tg-video: engine running (%dx%d, tx %s)\n", m_width, m_height, m_tx ? "on" : "off");
+    if (m_tx && onSendingChanged)
+        onSendingChanged(true);
+    // The decoder joins mid-stream: it needs an IDR to start from.
+    if (onPeerKeyframeWanted)
+        onPeerKeyframeWanted();
+    changed();
+    // The wish may have changed while starting.
+    if (!wanted() || m_tx != wantTx())
+        reconcile();
+}
+
+void Controller::close()
+{
+    const State was = m_state;
+    m_gen++;
+    m_state = State::Idle;
+    if (was == State::Idle || was == State::Probing)
+        return;
+    // Starting: onStart sees the old generation and stops what it started.
+    if (was == State::Running) {
+        m_bridge.stop();
+        m_rtc("stop", "{}", nullptr);
+        if (m_tx && onSendingChanged)
+            onSendingChanged(false);
+        fprintf(stderr, "tg-video: engine session closed\n");
+        changed();
+    }
+}
+
+void Controller::requestKeyframe(int64_t nowUs)
+{
+    if (!sending())
+        return;
+    if (m_keyframeAsked && nowUs - m_lastKeyframeUs < kKeyframeMinIntervalUs)
+        return;
+    m_keyframeAsked = true;
+    m_lastKeyframeUs = nowUs;
+    m_rtc("requestKeyframe", "{}", nullptr);
+}
+
+bool Controller::tick(int64_t nowUs)
+{
+    const bool frames = m_peerVideo && m_lastFrameUs && nowUs - m_lastFrameUs < kStreamingTimeoutUs;
+    if (frames == m_streaming)
+        return false;
+    m_streaming = frames;
+    changed();
+    return true;
+}
+
+std::string Controller::lineFields() const
+{
+    const char *ivs = !m_peerVideo ? "unavailable" : m_streaming ? "streaming" : "available";
+    std::string s = ",\"incomingVideo\":";
+    s += m_peerVideo ? "true" : "false";
+    s += ",\"outgoingVideo\":";
+    s += sending() ? "true" : "false";
+    s += ",\"incomingVideoState\":\"";
+    s += ivs;
+    // A WebRTC sender turns its frames upright itself when, as here, the orientation
+    // extension is not negotiated.
+    s += "\",\"incomingVideoOrientation\":0";
+    return s;
+}
+
+std::string Controller::payloadFields() const
+{
+    std::string s = ",\"allowVideoCalls\":true,\"videoURI\":";
+    if (!running())
+        return s + "\"\"";
+    char buf[96];
+    s += jsonQuote(m_paths.shm);
+    snprintf(buf, sizeof buf, ",\"videoWidth\":%d,\"videoHeight\":%d", m_width, m_height);
+    s += buf;
+    if (m_tx) {
+        // Our own picture for the inset, mirrored for the front camera
+        // as a mirror shows the user.
+        s += ",\"videoPreviewURI\":" + jsonQuote(m_paths.preview);
+        snprintf(buf, sizeof buf, ",\"videoPreviewWidth\":%d,\"videoPreviewHeight\":%d,\"videoPreviewOrientation\":%d",
+                 kPreviewWidth, kPreviewHeight, kPreviewQuarterTurns);
+        s += buf;
+        s += ",\"videoPreviewMirrored\":";
+        s += m_camera == 1 ? "true" : "false";
+    }
+    return s;
+}
+
+} // namespace tgvideo
+
+#endif

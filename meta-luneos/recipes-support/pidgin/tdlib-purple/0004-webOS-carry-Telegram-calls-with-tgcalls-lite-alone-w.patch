diff --git a/call.cpp b/call.cpp
index 206e1f2..66e7e7b 100644
--- a/call.cpp
+++ b/call.cpp
@@ -90,6 +90,7 @@ static bool activateCall(const td::td_api::call &call, const std::string &buddyN
         return false;
     const td::td_api::callStateReady &state = static_cast<const td::td_api::callStateReady &>(*call.state_);
 
+#ifndef NoTgvoip
     if (state.protocol_->max_layer_ < 74) {
         // libtgvoip crashes with openssl assertion failure if it goes into if(!useMTProto2) branch
         // of VoIPController::ProcessIncomingPacket
@@ -101,6 +102,7 @@ static bool activateCall(const td::td_api::call &call, const std::string &buddyN
 
         return false;
     }
+#endif
 
 #ifdef HAVE_TGCALLS_LITE
     // The peer agreed on tgcalls-lite's version: tgcalls V2 media, not libtgvoip's.
@@ -115,6 +117,16 @@ static bool activateCall(const td::td_api::call &call, const std::string &buddyN
     }
 #endif
 
+#ifdef NoTgvoip
+    // Built without libtgvoip: a peer that did not agree on tgcalls-lite's version cannot be
+    // carried. Current Telegram clients all register it (tgcalls InstanceV2Impl).
+    tgcLog("activateCall: peer did not agree on our tgcalls version; no other engine");
+    if (!buddyName.empty())
+        showMessageTextIm(account, buddyName.c_str(), NULL,
+                          "Discarding call: the other side's Telegram does not support this call protocol",
+                          time(NULL), PURPLE_MESSAGE_SYSTEM);
+    return false;
+#else
     tgvoip::VoIPController *voip = account.getCallData();
     if (!voip)
         return false;
@@ -170,6 +182,7 @@ static bool activateCall(const td::td_api::call &call, const std::string &buddyN
         showMessageTextIm(account, buddyName.c_str(), NULL, message,
                           time(NULL), PURPLE_MESSAGE_SYSTEM);
     }
+#endif // NoTgvoip
 
 #endif
     return true;
@@ -182,12 +195,14 @@ static void deactivateCall(TdAccountData &account)
 #ifdef HAVE_TGCALLS_LITE
     tgcallsLiteStop(account);
 #endif
+#ifndef NoTgvoip
     // Also for a tgcalls-lite call or one that never started: libtgvoip aborts when a
     // VoIPController is deleted without Stop(), and Stop() on an idle one does nothing harmful.
     tgvoip::VoIPController *voip = account.getCallData();
     if (voip)
         voip->Stop();
 #endif
+#endif
 }
 

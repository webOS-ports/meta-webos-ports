diff --git a/test/call-protocol-test.cpp b/test/call-protocol-test.cpp
new file mode 100644
index 0000000..f8c2a3e
--- /dev/null
+++ b/test/call-protocol-test.cpp
@@ -0,0 +1,29 @@
+// Calls no engine can carry. Built without libtgvoip (NoTgvoip), a call whose peer did not agree on
+// tgcalls-lite's version is refused: discarded, with a notice, and not shown as active.
+#include "fixture.h"
+#include "buildopt.h"
+
+class CallProtocolTest: public CommTest {};
+
+#if defined(NoTgvoip) && !defined(NoVoip)
+TEST_F(CallProtocolTest, NoAgreedVersionDiscarded)
+{
+    loginWithOneContact();
+
+    // Ready, but on a version we do not speak (tgcalls' legacy one): nothing can carry it
+    std::vector<std::string> versions{"2.4.4"};
+    tgl.update(make_object<updateCall>(make_object<call>(
+        5, 0, userIds[0], false, false,
+        make_object<callStateReady>(make_object<callProtocol>(true, true, 65, 92, std::move(versions)),
+                                    std::vector<object_ptr<callServer>>(), "", std::string(256, 'k'),
+                                    std::vector<std::string>(), true, false, ""))));
+
+    tgl.verifyRequest(discardCall(5, true, "", 0, false, 0));
+    prpl.verifyEvents(
+        NewConversationEvent(PURPLE_CONV_TYPE_IM, account, purpleUserName(0)),
+        ConversationWriteEvent(purpleUserName(0), purpleUserName(0),
+                               "Discarding call: the other side's Telegram does not support this call protocol",
+                               PURPLE_MESSAGE_SYSTEM, 0)
+    );
+}
+#endif

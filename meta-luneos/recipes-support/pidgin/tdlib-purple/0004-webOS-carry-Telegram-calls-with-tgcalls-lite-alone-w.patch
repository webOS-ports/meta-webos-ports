diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8126e1b..e60afd2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,6 +12,7 @@ include(cmake/tdlib-version.cmake)
 set(NoLottie FALSE CACHE BOOL "Disable animated sticker conversion")
 set(NoTranslations FALSE CACHE BOOL "Disable translation support")
 set(NoVoip FALSE CACHE BOOL "Disable voice call support")
+set(NoTgvoip FALSE CACHE BOOL "Carry calls with tgcalls-lite alone, without libtgvoip")
 set(NoPidgin FALSE CACHE BOOL "Build without Pidgin's headers, so without what only its conversation window can do")
 set(API_ID 94575 CACHE STRING "API id")
 set(API_HASH a3406de8d171bb422bb6ddf3bbd800e2 CACHE STRING "API hash")
@@ -24,13 +25,13 @@ if (NOT NoPkgConfig)
     pkg_check_modules(GModule REQUIRED gmodule-2.0)
     # The types of files pasted, by their content, as file managers tell them
     pkg_check_modules(GIO REQUIRED gio-2.0)
-    if (NOT NoVoip)
+    if (NOT NoVoip AND NOT NoTgvoip)
         pkg_check_modules(tgvoip tgvoip)
         if ("${tgvoip_LIBRARIES}" STREQUAL "")
             message(STATUS "tgvoip library not found, disabling voice call support")
             set(NoVoip TRUE)
         endif ("${tgvoip_LIBRARIES}" STREQUAL "")
-    endif(NOT NoVoip)
+    endif(NOT NoVoip AND NOT NoTgvoip)
     pkg_check_modules(fmt REQUIRED fmt)
     if (NOT NoLottie)
         pkg_check_modules(rlottie REQUIRED rlottie)
@@ -66,6 +67,11 @@ else (IS_ABSOLUTE "${SHARE_INSTALL_PREFIX}")
     set(LOCALE_DIR "${CMAKE_INSTALL_PREFIX}/${SHARE_INSTALL_PREFIX}/locale")
 endif (IS_ABSOLUTE "${SHARE_INSTALL_PREFIX}")
 
+# Without libtgvoip, tgcalls-lite is the only call engine: no calls without it
+if (NoTgvoip AND NOT NoVoip AND "${tgcalls_lite_INCLUDE_DIRS}" STREQUAL "")
+    message(STATUS "NoTgvoip without tgcalls-lite, disabling voice call support")
+    set(NoVoip TRUE)
+endif ()
 configure_file(buildopt.h.in buildopt.h)
 configure_file(config.cpp.in config.cpp)
 
@@ -132,7 +138,7 @@ if (NOT lunaservice_INCLUDE_DIRS STREQUAL "")
 endif (NOT lunaservice_INCLUDE_DIRS STREQUAL "")
 target_link_libraries(telegram-tdlib PRIVATE ${lunaservice_LIBRARIES})
 
-if (NOT NoVoip)
+if (NOT NoVoip AND NOT NoTgvoip)
     target_link_libraries(telegram-tdlib PRIVATE ${tgvoip_LIBRARIES})
     if (tgvoip_NO_DSP)
         # libtgvoip was built with --disable-dsp: EchoCanceller.h gates its webrtc:: members on
@@ -140,10 +146,10 @@ if (NOT NoVoip)
         # webrtc types we didn't build.
         target_compile_definitions(telegram-tdlib PRIVATE TGVOIP_NO_DSP)
     endif (tgvoip_NO_DSP)
-endif (NOT NoVoip)
+endif (NOT NoVoip AND NOT NoTgvoip)
 
 # tgcalls-lite (luneos-synergy-connectors, im/telegram/plugin/tgcalls-lite): calls with the tgcalls
-# V2 protocol current clients speak, next to libtgvoip. Its headers need C++17.
+# V2 protocol current clients speak, next to libtgvoip, or alone with NoTgvoip. Its headers need C++17.
 set(tgcalls_lite_INCLUDE_DIRS "" CACHE STRING "tgcalls-lite headers; empty builds without it")
 set(tgcalls_lite_LIBRARIES "" CACHE STRING "tgcalls-lite library (libtgcalls-lite.a)")
 if (NOT NoVoip AND NOT tgcalls_lite_INCLUDE_DIRS STREQUAL "")

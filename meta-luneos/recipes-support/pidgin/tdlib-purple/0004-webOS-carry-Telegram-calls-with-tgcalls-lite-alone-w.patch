 account-data.h              |  2 +-
 buildopt.h.in               |  2 ++
 call.cpp                    | 15 +++++++++++++++
 test/CMakeLists.txt         |  5 +++--
 test/call-protocol-test.cpp | 29 +++++++++++++++++++++++++++++
 test/test-transceiver.cpp   |  4 ++++

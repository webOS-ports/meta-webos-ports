+#ifndef _WEBOS_RECEIVE_H
+#define _WEBOS_RECEIVE_H
+
+// What the webOS Messaging app is given for a message it has no bubble of its own for, in the
+// forms purple-combined (WhatsApp) gives them. Nothing in here knows about TDLib or libpurple, so
+// that the unit tests can call it as it is.
+
+#include <string>
+#include <vector>
+
+namespace webos {
+
+// A poll, as the app draws one: "poll:" and the base64url (no padding) of
+// {"name":<question>,"options":[<text>,...],"max":<n>}, n being 1 where one answer may be picked
+// and 0 where any number may
+std::string pollToken(const std::string &question, const std::vector<std::string> &options,
+                      bool multipleAnswers);
+
+// A vCard 3.0 for a contact that came without one
+std::string makeVCard(const std::string &firstName, const std::string &lastName,
+                      const std::string &phoneNumber);
+
+// Who a contact card is of, by name, else by number; empty if neither is given
+std::string contactLabel(const std::string &firstName, const std::string &lastName,
+                         const std::string &phoneNumber);
+
+// Writes a vCard into dir (made if missing) as contact_<hash of it>.vcf, so the same card is one
+// file however often it comes. Returns its path, or "" if it could not be written.
+std::string writeVCardFile(const std::string &dir, const std::string &vcard);
+
+// The text the app shows a contact card chip for, which opens the Contacts import:
+// "file://<path>?name=<label, percent-encoded>", the name left off when there is none
+std::string contactCardText(const std::string &path, const std::string &label);
+
+} // namespace webos
+
+#endif

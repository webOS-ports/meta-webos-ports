+// What the webOS Messaging app is given for a poll or a contact card (webos-receive.h)
+#include "webos-receive.h"
+#include "webos-send.h"
+#include <gtest/gtest.h>
+#include <glib.h>
+#include <glib/gstdio.h>
+
+// The JSON in a poll token, as the app's buildPollBlock decodes it
+static std::string pollJson(const std::string &token)
+{
+    if (token.compare(0, 5, "poll:") != 0)
+        return "not a poll token: " + token;
+    std::string b64 = token.substr(5);
+    if (b64.find_first_of("+/=") != std::string::npos)
+        return "not base64url: " + token;
+    for (char &c: b64)
+        c = (c == '-') ? '+' : (c == '_') ? '/' : c;
+    while (b64.size() % 4)
+        b64 += '=';
+    gsize   length;
+    guchar *data = g_base64_decode(b64.c_str(), &length);
+    std::string json(reinterpret_cast<char *>(data), length);
+    g_free(data);
+    return json;
+}
+
+TEST(WebosReceiveTest, PollToken)
+{
+    ASSERT_EQ("{\"name\":\"Lunch?\",\"options\":[\"Pizza\",\"Soup\"],\"max\":1}",
+              pollJson(webos::pollToken("Lunch?", {"Pizza", "Soup"}, false)));
+    ASSERT_EQ("{\"name\":\"Which?\",\"options\":[\"A\",\"B\",\"C\"],\"max\":0}",
+              pollJson(webos::pollToken("Which?", {"A", "B", "C"}, true)));
+    // Escaped as JSON, and UTF-8 as it is
+    ASSERT_EQ("{\"name\":\"Say \\\"hi\\\" \\\\ \\u000a\",\"options\":[\"\xF0\x9F\x8D\x95\",\"\"],\"max\":1}",
+              pollJson(webos::pollToken("Say \"hi\" \\ \n", {"\xF0\x9F\x8D\x95", ""}, false)));
+    ASSERT_EQ("{\"name\":\"\",\"options\":[],\"max\":1}", pollJson(webos::pollToken("", {}, false)));
+    // Bytes that come out as "+" and "/" in base64, and padding there would be
+    std::string token = webos::pollToken("\xFB\xFF?>", {"x"}, false);
+    ASSERT_EQ(std::string::npos, token.find_first_of("+/=", 5)) << token;
+    ASSERT_EQ("{\"name\":\"\xFB\xFF?>\",\"options\":[\"x\"],\"max\":1}", pollJson(token));
+}
+
+TEST(WebosReceiveTest, ContactLabel)
+{
+    ASSERT_EQ("Isaac Newton", webos::contactLabel("Isaac", "Newton", "4412345"));
+    ASSERT_EQ("Isaac", webos::contactLabel("Isaac", "", "4412345"));
+    ASSERT_EQ("Newton", webos::contactLabel("", "Newton", "4412345"));
+    ASSERT_EQ("4412345", webos::contactLabel("", "", "4412345"));
+    ASSERT_EQ("", webos::contactLabel("", "", ""));
+}
+
+TEST(WebosReceiveTest, MakeVCard)
+{
+    ASSERT_EQ("BEGIN:VCARD\r\nVERSION:3.0\r\nN:Newton;Isaac;;;\r\nFN:Isaac Newton\r\n"
+              "TEL;TYPE=CELL:+4412345\r\nEND:VCARD\r\n",
+              webos::makeVCard("Isaac", "Newton", "4412345"));
+    // A number given with its "+" keeps the one; vCard's own characters are escaped
+    ASSERT_EQ("BEGIN:VCARD\r\nVERSION:3.0\r\nN:;A\\,B\\;C\\\\;;;\r\nFN:A\\,B\\;C\\\\\r\n"
+              "TEL;TYPE=CELL:+31 6\r\nEND:VCARD\r\n",
+              webos::makeVCard("A,B;C\\", "", "+31 6"));
+    // No name: the number names it; no number: no TEL
+    ASSERT_EQ("BEGIN:VCARD\r\nVERSION:3.0\r\nN:;;;;\r\nFN:+4412345\r\nTEL;TYPE=CELL:+4412345\r\nEND:VCARD\r\n",
+              webos::makeVCard("", "", "4412345"));
+    ASSERT_EQ("BEGIN:VCARD\r\nVERSION:3.0\r\nN:;Line\\nbreak;;;\r\nFN:Line\\nbreak\r\nEND:VCARD\r\n",
+              webos::makeVCard("Line\r\nbreak", "", ""));
+}
+
+TEST(WebosReceiveTest, WriteVCardFile)
+{
+    gchar *tmp = g_dir_make_tmp("webos-receive-XXXXXX", NULL);
+    ASSERT_NE(nullptr, tmp);
+    std::string dir = std::string(tmp) + "/made/here";
+    std::string card = webos::makeVCard("Isaac", "Newton", "4412345");
+
+    std::string path = webos::writeVCardFile(dir, card);
+    ASSERT_EQ(0u, path.find(dir + "/contact_")) << path;
+    ASSERT_EQ(dir.size() + strlen("/contact_") + 32 + strlen(".vcf"), path.size()) << path;
+    ASSERT_EQ(".vcf", path.substr(path.size() - 4));
+    gchar *written = NULL;
+    gsize  length  = 0;
+    ASSERT_TRUE(g_file_get_contents(path.c_str(), &written, &length, NULL));
+    ASSERT_EQ(card, std::string(written, length));
+    g_free(written);
+
+    // The same card is the same file; another is another
+    ASSERT_EQ(path, webos::writeVCardFile(dir, card));
+    std::string other = webos::writeVCardFile(dir, webos::makeVCard("Galileo", "", ""));
+    ASSERT_NE("", other);
+    ASSERT_NE(path, other);
+
+    // Nothing to write, or nowhere to
+    ASSERT_EQ("", webos::writeVCardFile(dir, ""));
+    ASSERT_EQ("", webos::writeVCardFile("", card));
+    std::string file = std::string(tmp) + "/file";
+    ASSERT_TRUE(g_file_set_contents(file.c_str(), "x", 1, NULL));
+    ASSERT_EQ("", webos::writeVCardFile(file + "/below", card));
+
+    g_unlink(path.c_str());
+    g_unlink(other.c_str());
+    g_unlink(file.c_str());
+    g_rmdir(dir.c_str());
+    g_rmdir((std::string(tmp) + "/made").c_str());
+    g_rmdir(tmp);
+    g_free(tmp);
+}
+
+TEST(WebosReceiveTest, ContactCardText)
+{
+    ASSERT_EQ("file:///media/x/contact_ab.vcf?name=Isaac%20Newton",
+              webos::contactCardText("/media/x/contact_ab.vcf", "Isaac Newton"));
+    ASSERT_EQ("file:///media/x/contact_ab.vcf?name=A%26B%3F%3D%2B%E2%82%AC",
+              webos::contactCardText("/media/x/contact_ab.vcf", "A&B?=+\xE2\x82\xAC"));
+    ASSERT_EQ("file:///media/x/contact_ab.vcf", webos::contactCardText("/media/x/contact_ab.vcf", ""));
+    // Not a path
+    ASSERT_EQ("", webos::contactCardText("relative.vcf", "Isaac"));
+}
+
+TEST(WebosReceiveTest, PollOptionIds)
+{
+    const std::vector<std::string> options = {"Pizza", "Soup", "Pasta"};
+    std::vector<int32_t> ids = {9};
+    // In the poll's order, each once
+    ASSERT_TRUE(webos::pollOptionIds(options, {"Pasta", "Pizza", "Pasta"}, ids));
+    ASSERT_EQ(std::vector<int32_t>({0, 2}), ids);
+    ASSERT_TRUE(webos::pollOptionIds(options, {"Soup"}, ids));
+    ASSERT_EQ(std::vector<int32_t>({1}), ids);
+    ASSERT_TRUE(webos::pollOptionIds(options, {}, ids));
+    ASSERT_EQ(std::vector<int32_t>(), ids);
+
+    // Not an option: nothing chosen at all
+    ids = {9};
+    ASSERT_FALSE(webos::pollOptionIds(options, {"Soup", "Salad"}, ids));
+    ASSERT_FALSE(webos::pollOptionIds(options, {"soup"}, ids));
+    ASSERT_FALSE(webos::pollOptionIds({}, {"Soup"}, ids));
+}

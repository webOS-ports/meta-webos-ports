+bool pollOptionIds(const std::vector<std::string> &options, const std::vector<std::string> &chosen,
+                   std::vector<int32_t> &optionIds)
+{
+    std::vector<bool> picked(options.size(), false);
+    for (const std::string &text: chosen) {
+        auto it = std::find(options.begin(), options.end(), text);
+        if (it == options.end())
+            return false;
+        picked[it - options.begin()] = true;
+    }
+    optionIds.clear();
+    for (size_t i = 0; i < picked.size(); i++)
+        if (picked[i])
+            optionIds.push_back(static_cast<int32_t>(i));
+    return true;
+}

+// webOS: vote in a poll, by its serviceMessageId; optionsJoined is the whole choice, the options'
+// texts "\x1f"-joined, "" to take the vote back. A void signal: every plug-in sees it, for each
+// account, and the Telegram ones take it.
+static void tgprpl_send_poll_vote_cb(PurpleAccount *account, const char * /*peer*/, const char *pollMessageId,
+                                     const char *optionsJoined, void * /*data*/)
+{
+    PurpleTdClient *tdClient = getWebosCommandClient(account);
+    if (!tdClient)
+        return;
+    int64_t chatId, messageId;
+    if (!webos::parseServiceMessageId(pollMessageId, chatId, messageId)) {
+        purple_debug_warning(config::pluginId, "Cannot vote in '%s': not a message id\n",
+                             pollMessageId ? pollMessageId : "");
+        return;
+    }
+    tdClient->votePoll(chatId, messageId, webos::splitMembers(optionsJoined));
+}

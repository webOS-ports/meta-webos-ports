+// The webOS signals the plug-in gives imlibpurpleservice that tests look at: "webos-im-edit"
+// (account, serviceMessageId, text) and "webos-im-delete" (account, serviceMessageId)
+struct WebosSignal {
+    std::string              name;
+    PurpleAccount           *account;
+    std::vector<std::string> args;
+    bool operator==(const WebosSignal &other) const
+    {
+        return (name == other.name) && (account == other.account) && (args == other.args);
+    }
+};
+// Those emitted since the last call, which forgets them
+std::vector<WebosSignal> takeWebosSignals();

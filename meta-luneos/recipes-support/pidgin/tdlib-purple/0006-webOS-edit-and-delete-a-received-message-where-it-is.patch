new file mode 100644
index 0000000..2e4f20f
--- /dev/null
+++ b/webos-receive.cpp
@@ -0,0 +1,119 @@
+#include "webos-receive.h"
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <cstdio>
+
+namespace webos {
+
+static void appendJsonString(std::string &out, const std::string &value)
+{
+    out += '"';
+    for (unsigned char c: value) {
+        if ((c == '"') || (c == '\\')) {
+            out += '\\';
+            out += static_cast<char>(c);
+        } else if (c < 0x20) {
+            char escaped[8];
+            snprintf(escaped, sizeof(escaped), "\\u%04x", c);
+            out += escaped;
+        } else
+            out += static_cast<char>(c);
+    }
+    out += '"';
+}
+
+std::string pollToken(const std::string &question, const std::vector<std::string> &options,
+                      bool multipleAnswers)
+{
+    std::string json = "{\"name\":";
+    appendJsonString(json, question);
+    json += ",\"options\":[";
+    for (size_t i = 0; i < options.size(); i++) {
+        if (i)
+            json += ',';
+        appendJsonString(json, options[i]);
+    }
+    json += "],\"max\":";
+    json += multipleAnswers ? "0" : "1";
+    json += '}';
+
+    gchar      *encoded = g_base64_encode(reinterpret_cast<const guchar *>(json.data()), json.size());
+    std::string token   = "poll:";
+    for (const gchar *c = encoded; *c && (*c != '='); c++)
+        token += (*c == '+') ? '-' : (*c == '/') ? '_' : *c;
+    g_free(encoded);
+    return token;
+}
+
+// A vCard text value: backslash, comma and semicolon are escaped, a line break is written "\n"
+static std::string vCardText(const std::string &value)
+{
+    std::string result;
+    for (char c: value) {
+        if ((c == '\\') || (c == ',') || (c == ';')) {
+            result += '\\';
+            result += c;
+        } else if (c == '\n')
+            result += "\\n";
+        else if (c != '\r')
+            result += c;
+    }
+    return result;
+}
+
+std::string makeVCard(const std::string &firstName, const std::string &lastName,
+                      const std::string &phoneNumber)
+{
+    // TDLib gives the number without its "+"
+    std::string number = phoneNumber;
+    if (!number.empty() && g_ascii_isdigit(number[0]))
+        number = "+" + number;
+    std::string fullName = contactLabel(firstName, lastName, number);
+    std::string card = "BEGIN:VCARD\r\nVERSION:3.0\r\n";
+    card += "N:" + vCardText(lastName) + ";" + vCardText(firstName) + ";;;\r\n";
+    card += "FN:" + vCardText(fullName) + "\r\n";
+    if (!number.empty())
+        card += "TEL;TYPE=CELL:" + vCardText(number) + "\r\n";
+    card += "END:VCARD\r\n";
+    return card;
+}
+
+std::string contactLabel(const std::string &firstName, const std::string &lastName,
+                         const std::string &phoneNumber)
+{
+    std::string name = firstName;
+    if (!lastName.empty())
+        name += (name.empty() ? "" : " ") + lastName;
+    return name.empty() ? phoneNumber : name;
+}
+
+std::string writeVCardFile(const std::string &dir, const std::string &vcard)
+{
+    if (dir.empty() || vcard.empty() || (g_mkdir_with_parents(dir.c_str(), 0755) != 0))
+        return std::string();
+    gchar      *sum  = g_compute_checksum_for_string(G_CHECKSUM_SHA256, vcard.c_str(), vcard.size());
+    std::string name = "contact_" + std::string(sum, 32) + ".vcf";
+    g_free(sum);
+    std::string path = dir + G_DIR_SEPARATOR_S + name;
+    if (!g_file_set_contents(path.c_str(), vcard.data(), vcard.size(), NULL))
+        return std::string();
+    return path;
+}
+
+std::string contactCardText(const std::string &path, const std::string &label)
+{
+    gchar *uri = g_filename_to_uri(path.c_str(), NULL, NULL);
+    if (!uri)
+        return std::string();
+    std::string text = uri;
+    g_free(uri);
+    if (!label.empty()) {
+        gchar *escaped = g_uri_escape_string(label.c_str(), NULL, FALSE);
+        text += "?name=";
+        text += escaped;
+        g_free(escaped);
+    }
+    return text;
+}
+
+} // namespace webos

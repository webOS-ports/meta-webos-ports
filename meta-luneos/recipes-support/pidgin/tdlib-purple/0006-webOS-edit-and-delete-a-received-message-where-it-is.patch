+// webOS: a poll as the Messaging app draws one, a list to vote on (webos-receive.h)
+static void showWebosPoll(const td::td_api::chat &chat, const TgMessageInfo &messageInfo,
+                          const td::td_api::poll &poll, TdAccountData &account)
+{
+    std::vector<std::string> options;
+    for (const auto &option: poll.options_)
+        options.push_back((option && option->text_) ? option->text_->text_ : std::string());
+    std::string token = webos::pollToken(poll.question_ ? poll.question_->text_ : std::string(),
+                                         options, poll.allows_multiple_answers_);
+    showMessageText(account, chat, messageInfo, token.c_str(), NULL);
+}

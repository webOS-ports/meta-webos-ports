+bool PurpleTdClient::votePoll(int64_t tdlibChatId, int64_t messageId,
+                              const std::vector<std::string> &optionTexts)
+{
+    const td::td_api::chat *chat = getCommandChat(tdlibChatId, "vote");
+    if (!chat)
+        return false;
+    ChatId chatId = getId(*chat);
+
+    // The vote is by the options' positions, which only the poll itself has
+    auto request = td::td_api::make_object<td::td_api::getMessage>(tdlibChatId, messageId);
+    m_transceiver.sendQuery(std::move(request),
+        [this, chatId, messageId, optionTexts](uint64_t, TdObjectPtr object) {
+            if (!object || (object->get_id() != td::td_api::message::ID)) {
+                // TRANSLATOR: In-chat error message, argument will be a reason (text)
+                commandResponse(chatId, _("Failed to vote: {}"), std::move(object));
+                return;
+            }
+            const auto &message = static_cast<const td::td_api::message &>(*object);
+            if (!message.content_ || (message.content_->get_id() != td::td_api::messagePoll::ID) ||
+                !static_cast<const td::td_api::messagePoll &>(*message.content_).poll_)
+            {
+                purple_debug_warning(config::pluginId, "Cannot vote: message %" G_GINT64_FORMAT
+                                     " is not a poll\n", messageId);
+                return;
+            }
+            std::vector<std::string> options;
+            for (const auto &option: static_cast<const td::td_api::messagePoll &>(*message.content_).poll_->options_)
+                options.push_back((option && option->text_) ? option->text_->text_ : std::string());
+            std::vector<int32_t> optionIds;
+            if (!webos::pollOptionIds(options, optionTexts, optionIds)) {
+                purple_debug_warning(config::pluginId, "Cannot vote in poll %" G_GINT64_FORMAT
+                                     ": an option is not in it\n", messageId);
+                return;
+            }
+            auto vote = td::td_api::make_object<td::td_api::setPollAnswer>(chatId.value(), messageId,
+                                                                         std::move(optionIds));
+            // The poll's tally comes back as updateMessageContent, which shows nothing new
+            m_transceiver.sendQuery(std::move(vote), [this, chatId](uint64_t, TdObjectPtr result) {
+                // TRANSLATOR: In-chat error message, argument will be a reason (text)
+                commandResponse(chatId, _("Failed to vote: {}"), std::move(result));
+            });
+        });
+    return true;
+}

+// The webOS signals go to imlibpurpleservice; the ones tests look at are kept for them
+// (This file is extern "C" for libpurple; these are the tests' own.)
+extern "C++" {
+static std::vector<WebosSignal> g_webosSignals;
+
+std::vector<WebosSignal> takeWebosSignals()
+{
+    std::vector<WebosSignal> result;
+    result.swap(g_webosSignals);
+    return result;
+}
+}
+
+void purple_signal_emit(void *, const char *signal, ...)
 {
+    unsigned nStrings;
+    if (!strcmp(signal, "webos-im-edit"))
+        nStrings = 2;
+    else if (!strcmp(signal, "webos-im-delete"))
+        nStrings = 1;
+    else
+        return;
+
+    WebosSignal emitted;
+    emitted.name = signal;
+    va_list args;
+    va_start(args, signal);
+    emitted.account = va_arg(args, PurpleAccount *);
+    for (unsigned i = 0; i < nStrings; i++) {
+        const char *arg = va_arg(args, const char *);
+        emitted.args.push_back(arg ? arg : "(null)");
+    }
+    va_end(args);
+    g_webosSignals.push_back(std::move(emitted));
 }
 

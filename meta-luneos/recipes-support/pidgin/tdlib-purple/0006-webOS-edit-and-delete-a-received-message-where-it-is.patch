+// webOS: the transport keeps every message it was given, from this session or before, by the
+// serviceMessageId it came with; "webos-im-edit" (account, serviceMessageId, text) has it change
+// that message's text where it is. Only text is: a caption or a replaced file is still told with a
+// notice. Returns whether the edit was given that way.
+static bool emitWebosEdit(TdAccountData &account, ChatId chatId, MessageId messageId,
+                          const td::td_api::MessageContent &content)
+{
+    if (content.get_id() != td::td_api::messageText::ID)
+        return false;
+    const auto &text = static_cast<const td::td_api::messageText &>(content);
+    std::string id      = webosServiceMessageId(chatId.value(), messageId.value());
+    std::string newText = text.text_ ? getMessageText(*text.text_) : std::string();
+    purple_signal_emit(purple_conversations_get_handle(), "webos-im-edit",
+                       account.purpleAccount, id.c_str(), newText.c_str());
+    return true;
+}

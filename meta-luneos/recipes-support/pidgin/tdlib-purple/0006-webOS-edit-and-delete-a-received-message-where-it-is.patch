+// webOS: a contact card as a .vcf the app offers to import into Contacts, its vCard as it came, or
+// made from the name and number; where it cannot be written, the name and number as text
+static void showWebosContact(const td::td_api::chat &chat, const TgMessageInfo &messageInfo,
+                             const td::td_api::contact &contact, TdAccountData &account)
+{
+    std::string label = webos::contactLabel(contact.first_name_, contact.last_name_, contact.phone_number_);
+    std::string vcard = !contact.vcard_.empty() ? contact.vcard_ :
+                        webos::makeVCard(contact.first_name_, contact.last_name_, contact.phone_number_);
+    std::string path  = webos::writeVCardFile(getContactCardDir(account.purpleAccount), vcard);
+    std::string text;
+    if (!path.empty())
+        text = escapeForDisplay(webos::contactCardText(path, label));
+    if (text.empty()) {
+        std::string who = label;
+        if (!contact.phone_number_.empty() && (label != contact.phone_number_))
+            who += ", " + contact.phone_number_;
+        // TRANSLATOR: In-chat message. Argument is a name and phone number.
+        text = formatMessage(_("Contact: {}"), escapeForDisplay(who));
+    }
+    showMessageText(account, chat, messageInfo, text.c_str(), NULL);
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 20 Oct 2026 16:47:33 +0200
Subject: [PATCH] Let libtgvoip be given without pkg-config

Voice calls are built only if pkg-config finds a "tgvoip" module, and
anything else turns them off. libtgvoip's autotools build (Makefile.am) installs no
.pc file, so a libtgvoip built from its sources - as a distribution or an embedded
build would - is never found, and there is no way to point the build at it:
tgvoip_INCLUDE_DIRS and tgvoip_LIBRARIES are already what the rest of
CMakeLists uses, but pkg_check_modules() overwrites them.

Make both cache variables, and ask pkg-config only when tgvoip_LIBRARIES has
not been given. A static libtgvoip needs its own dependencies listed too,
e.g. -Dtgvoip_LIBRARIES='tgvoip;opus;asound;crypto'.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 CMakeLists.txt | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5d9e125..16895e6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -13,6 +13,8 @@ set(NoLottie FALSE CACHE BOOL "Disable animated sticker conversion")
 set(NoTranslations FALSE CACHE BOOL "Disable translation support")
 set(NoVoip FALSE CACHE BOOL "Disable voice call support")
 set(NoPidgin FALSE CACHE BOOL "Build without Pidgin's headers, so without what only its conversation window can do")
+set(tgvoip_INCLUDE_DIRS "" CACHE STRING "libtgvoip headers, when not found with pkg-config")
+set(tgvoip_LIBRARIES "" CACHE STRING "libtgvoip and what it needs, when not found with pkg-config")
 set(API_ID 94575 CACHE STRING "API id")
 set(API_HASH a3406de8d171bb422bb6ddf3bbd800e2 CACHE STRING "API hash")
 set(STUFF "" CACHE STRING "")
@@ -25,7 +27,10 @@ if (NOT NoPkgConfig)
     # The types of files pasted, by their content, as file managers tell them
     pkg_check_modules(GIO REQUIRED gio-2.0)
     if (NOT NoVoip)
-        pkg_check_modules(tgvoip tgvoip)
+        # libtgvoip does not install a .pc file of its own; one given by hand is used as it is
+        if ("${tgvoip_LIBRARIES}" STREQUAL "")
+            pkg_check_modules(tgvoip tgvoip)
+        endif ("${tgvoip_LIBRARIES}" STREQUAL "")
         if ("${tgvoip_LIBRARIES}" STREQUAL "")
             message(STATUS "tgvoip library not found, disabling voice call support")
             set(NoVoip TRUE)

+TEST(WebosSendTest, GroupTitle)
+{
+    ASSERT_EQ("Physics", webos::groupTitle("Physics"));
+    // Blanks at either end, Unicode's too, go; those inside stay as they are
+    ASSERT_EQ("Natural  Philosophy", webos::groupTitle(" \t\nNatural  Philosophy \xc2\xa0\xe3\x80\x80"));
+    ASSERT_EQ("Optics", webos::groupTitle("\xe3\x80\x80\xc2\xa0 Optics"));
+    ASSERT_EQ("", webos::groupTitle(""));
+    ASSERT_EQ("", webos::groupTitle(" \t\xc2\xa0 "));
+    ASSERT_EQ("", webos::groupTitle(nullptr));
+    // Not UTF-8
+    ASSERT_EQ("", webos::groupTitle("Ph\xffysics"));
+    ASSERT_EQ("", webos::groupTitle("Physics \xe2\x82"));
+
+    // Cut at 128 characters, not bytes, and never inside one
+    std::string exact;
+    for (size_t i = 0; i < webos::GroupTitleMaxLength; i++)
+        exact += "\xc3\xa9"; // é
+    ASSERT_EQ(exact, webos::groupTitle(exact.c_str()));
+    ASSERT_EQ(exact, webos::groupTitle((exact + "\xf0\x9f\x8d\x8e").c_str())); // 🍎
+    std::string ascii(webos::GroupTitleMaxLength - 1, 'a');
+    ASSERT_EQ(ascii + "\xf0\x9f\x8d\x8e", webos::groupTitle((ascii + "\xf0\x9f\x8d\x8e" "b").c_str()));
+    // A blank where it is cut goes too
+    ASSERT_EQ(ascii, webos::groupTitle((ascii + " b").c_str()));
+}
+
+using GroupRenameCallback = gboolean (*)(PurpleAccount *, const char *, const char *, void *);
+
+TEST_F(WebosCommandTest, RenameBasicGroup)
+{
+    login();
+    addBasicGroup();
+    auto rename = reinterpret_cast<GroupRenameCallback>(getConnectedSignal("webos-im-group-rename"));
+    ASSERT_NE(nullptr, rename);
+
+    ASSERT_TRUE(rename(account, groupChatPurpleName.c_str(), " Natural Philosophy ", nullptr));
+    tgl.verifyRequest(setChatTitle(groupChatId, "Natural Philosophy"));
+    tgl.reply(make_object<ok>());
+    prpl.verifyNoEvents();
+
+    // TDLib tells of it as of a rename made elsewhere: the chat is renamed, which renames the
+    // thread, and the message of the change, ours, is a notice in it
+    tgl.update(make_object<updateChatTitle>(groupChatId, "Natural Philosophy"));
+    prpl.verifyEvents(AliasChatEvent(groupChatPurpleName, "Natural Philosophy"));
+    tgl.update(make_object<updateNewMessage>(makeMessage(
+        100, selfId, groupChatId, true, 10001, make_object<messageChatChangeTitle>("Natural Philosophy")
+    )));
+    tgl.verifyRequest(viewMessages(groupChatId, {100}, nullptr, true));
+    prpl.verifyEvents(
+        ServGotJoinedChatEvent(connection, 2, groupChatPurpleName, "Natural Philosophy"),
+        ConversationWriteEvent(groupChatPurpleName, NotificationWho,
+                               selfFirstName + " " + selfLastName + " changed group name to Natural Philosophy",
+                               PURPLE_MESSAGE_SYSTEM, 10001)
+    );
+
+    // Not allowed
+    ASSERT_TRUE(rename(account, groupChatPurpleName.c_str(), "Optics", nullptr));
+    tgl.verifyRequest(setChatTitle(groupChatId, "Optics"));
+    tgl.reply(make_object<error>(400, "Not enough rights to change chat title"));
+    prpl.verifyEvents(
+        ConversationWriteEvent(groupChatPurpleName, NotificationWho,
+                               "Cannot rename group: code 400 (Not enough rights to change chat title)",
+                               PURPLE_MESSAGE_SYSTEM, 0)
+    );
+}
+
+TEST_F(WebosCommandTest, RenameSupergroup)
+{
+    login();
+    addSupergroup();
+    auto rename = reinterpret_cast<GroupRenameCallback>(getConnectedSignal("webos-im-group-rename"));
+    ASSERT_NE(nullptr, rename);
+
+    // Too long: what Telegram keeps
+    std::string longName(webos::GroupTitleMaxLength + 10, 'x');
+    ASSERT_TRUE(rename(account, groupChatPurpleName.c_str(), longName.c_str(), nullptr));
+    tgl.verifyRequest(setChatTitle(groupChatId, std::string(webos::GroupTitleMaxLength, 'x')));
+    tgl.reply(make_object<ok>());
+    prpl.verifyNoEvents();
+}
+
+TEST_F(WebosCommandTest, RenameNotTaken)
+{
+    login();
+    addBasicGroup();
+    auto rename = reinterpret_cast<GroupRenameCallback>(getConnectedSignal("webos-im-group-rename"));
+    ASSERT_NE(nullptr, rename);
+
+    ASSERT_FALSE(rename(otherAccount(), groupChatPurpleName.c_str(), "Optics", nullptr));
+    setProtocol("prpl-jabber");
+    ASSERT_FALSE(rename(account, groupChatPurpleName.c_str(), "Optics", nullptr));
+    setProtocol(config::pluginId);
+    ASSERT_FALSE(rename(nullptr, groupChatPurpleName.c_str(), "Optics", nullptr));
+    // Not a group, or not one known
+    ASSERT_FALSE(rename(account, purpleUserName(0).c_str(), "Optics", nullptr));
+    ASSERT_FALSE(rename(account, "chat7001", "Optics", nullptr));
+    ASSERT_FALSE(rename(account, nullptr, "Optics", nullptr));
+    // No name
+    ASSERT_FALSE(rename(account, groupChatPurpleName.c_str(), "", nullptr));
+    ASSERT_FALSE(rename(account, groupChatPurpleName.c_str(), "  ", nullptr));
+    ASSERT_FALSE(rename(account, groupChatPurpleName.c_str(), nullptr, nullptr));
+    tgl.verifyNoRequests();
+}
+
+// A group we have left
+TEST_F(WebosCommandTest, RenameLeftGroup)
+{
+    login();
+    tgl.update(make_object<updateBasicGroup>(make_object<basicGroup>(
+        groupId, 2, make_object<chatMemberStatusLeft>(), true, 0
+    )));
+    tgl.update(make_object<updateNewChat>(makeChat(
+        groupChatId, make_object<chatTypeBasicGroup>(groupId), "Physics", nullptr, 0, 0, 0
+    )));
+    tgl.update(makeUpdateChatListMain(groupChatId));
+    prpl.discardEvents();
+    tgl.verifyNoRequests();
+    auto rename = reinterpret_cast<GroupRenameCallback>(getConnectedSignal("webos-im-group-rename"));
+    ASSERT_NE(nullptr, rename);
+    ASSERT_FALSE(rename(account, groupChatPurpleName.c_str(), "Optics", nullptr));
+    tgl.verifyNoRequests();
+}

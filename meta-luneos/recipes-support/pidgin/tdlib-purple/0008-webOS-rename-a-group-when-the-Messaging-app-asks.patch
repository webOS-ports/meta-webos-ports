+// Without the blanks, as Unicode has them, at either end
+static std::string trimBlanks(const char *start, const char *end)
+{
+    while (start < end && g_unichar_isspace(g_utf8_get_char(start)))
+        start = g_utf8_next_char(start);
+    while (end > start) {
+        const char *last = g_utf8_prev_char(end);
+        if (!g_unichar_isspace(g_utf8_get_char(last)))
+            break;
+        end = last;
+    }
+    return std::string(start, end);
+}
+
+std::string groupTitle(const char *name)
+{
+    if (!name || !g_utf8_validate(name, -1, nullptr))
+        return std::string();
+    std::string trimmed = trimBlanks(name, name + strlen(name));
+    const char *start   = trimmed.c_str();
+    const char *end     = start;
+    for (size_t count = 0; (*end != '\0') && (count < GroupTitleMaxLength); count++)
+        end = g_utf8_next_char(end);
+    // What is cut may leave a blank at the end
+    return trimBlanks(start, end);
+}

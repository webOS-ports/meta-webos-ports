+bool PurpleTdClient::renameGroup(const char *purpleChatName, const char *name)
+{
+    const td::td_api::chat *chat = getCommandGroup(purpleChatName, "rename group");
+    if (!chat || (!getBasicGroupId(*chat).valid() && !getSupergroupId(*chat).valid()))
+        return false;
+    ChatId chatId = getId(*chat);
+
+    // The name is not logged, the chat's id being enough to go on
+    std::string title = webos::groupTitle(name);
+    if (title.empty()) {
+        purple_debug_warning(config::pluginId, "Cannot rename chat %" G_GINT64_FORMAT ": no name\n",
+                             chatId.value());
+        return false;
+    }
+    // A longer name is cut by groupTitle as TDLib's clean_name would cut it, so that what is sent
+    // is what Telegram keeps
+
+    auto request = td::td_api::make_object<td::td_api::setChatTitle>(chatId.value(), title);
+    m_transceiver.sendQuery(std::move(request), [this, chatId](uint64_t, TdObjectPtr object) {
+        if (object && (object->get_id() == td::td_api::ok::ID))
+            return;
+        purple_debug_warning(config::pluginId, "Failed to rename chat %" G_GINT64_FORMAT "\n", chatId.value());
+        // TRANSLATOR: In-chat error message, argument is a reason (text)
+        commandResponse(chatId, _("Cannot rename group: {}"), std::move(object));
+    });
+    // The new title comes as updateChatTitle, which renames the chat in the buddy list, and as a
+    // message of the change, as one made elsewhere does
+    return true;
+}

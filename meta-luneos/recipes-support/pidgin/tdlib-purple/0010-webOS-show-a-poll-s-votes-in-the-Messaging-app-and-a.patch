+// A poll, TDLib's id 99, with how many chose each option, as TDLib gives them: every count 0 and
+// can_see_results false until we have voted (PollManager::get_poll_object)
+static object_ptr<messagePoll> makePollContent(const std::vector<int32_t> &counts, bool canSeeResults,
+                                               int chosen = -1)
+{
+    auto poll = make_object<td::td_api::poll>();
+    poll->id_       = 99;
+    poll->question_ = makeFormattedText("Lunch?");
+    const char *texts[] = {"Pizza", "Soup", "Pasta"};
+    for (size_t i = 0; i < 3; i++) {
+        auto option          = make_object<pollOption>();
+        option->text_        = makeFormattedText(texts[i]);
+        option->voter_count_ = canSeeResults ? counts[i] : 0;
+        option->is_chosen_   = (int(i) == chosen);
+        poll->options_.push_back(std::move(option));
+    }
+    poll->allows_multiple_answers_ = true;
+    poll->can_see_results_         = canSeeResults;
+    auto content   = make_object<messagePoll>();
+    content->poll_ = std::move(poll);
+    return content;
+}
+
+static std::string pollText(const std::vector<int32_t> *votes)
+{
+    return webos::pollToken("Lunch?", {"Pizza", "Soup", "Pasta"}, true, votes);
+}

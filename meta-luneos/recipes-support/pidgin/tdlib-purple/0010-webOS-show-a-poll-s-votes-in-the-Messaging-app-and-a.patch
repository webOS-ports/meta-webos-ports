+// A poll whose counts, or closing, changed is given again as a whole, where it is: the app takes
+// the rewrite of a poll for no edit. Nothing is given where the text is as it was; for a message
+// not shown in this session, the transport has it from before, without the line of a forward.
+static void rewriteWebosPoll(TdAccountData &account, ChatId chatId, MessageId messageId,
+                             const td::td_api::poll &poll)
+{
+    std::string token = makeWebosPollToken(poll);
+    if (!account.setPollText(chatId, messageId, poll.id_, token)) {
+        purple_debug_misc(config::pluginId, "Poll in message %" G_GINT64_FORMAT " is as it was\n",
+                          messageId.value());
+        return;
+    }
+    purple_debug_misc(config::pluginId, "Poll in message %" G_GINT64_FORMAT " rewritten, %s counts\n",
+                      messageId.value(), poll.can_see_results_ ? "with" : "without");
+    emitWebosEditSignal(account, chatId, messageId, account.getPollTextPrefix(chatId, messageId) + token);
+}

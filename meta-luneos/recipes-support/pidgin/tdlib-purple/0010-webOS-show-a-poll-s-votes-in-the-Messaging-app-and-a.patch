+    std::vector<int32_t> votes = {1, 0, 0};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, serviceMessageId(chatIds[0], 5), pollText(&votes))}),
+              takeWebosSignals());
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+
+    tgl.reply(requestId, makeMessage(1, userIds[0], chatIds[0], false, 10000, makeTextMessage("Hungry?")));
+    prpl.verifyEvents(NewConversationEvent(PURPLE_CONV_TYPE_IM, account, purpleUserName(0)),
+                      ServGotImEvent(connection, purpleUserName(0), pollText(&votes), PURPLE_MESSAGE_RECV, 10001));
+    tgl.verifyRequest(viewMessages(chatIds[0], {5}, nullptr, true));
+    PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_IM,
+                                                                     purpleUserName(0).c_str(), account);
+    ASSERT_NE(nullptr, conv);
+    for (const char *key: {"webos-msg-id", "webos-quoted-id", "webos-quoted-text", "webos-quoted-from"}) {
+        g_free(purple_conversation_get_data(conv, key));
+        purple_conversation_set_data(conv, key, nullptr);
+    }
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+}
+
+// A mention, by username or by name, is shown in bold (webos-mention-test.cpp has the forms)
+static object_ptr<formattedText> makeEntityText(const std::string &text,
+                                                std::vector<object_ptr<textEntity>> entities)
+{
+    return make_object<formattedText>(text, std::move(entities));
+}
+
+static object_ptr<textEntity> entityOf(int32_t offset, int32_t length, object_ptr<TextEntityType> type)
+{
+    return make_object<textEntity>(offset, length, std::move(type));
+}
+
+// As received, and as a reply quotes it
+TEST_F(WebosCommandTest, ReceivedMentionBold)
+{
+    login();
+    std::vector<object_ptr<textEntity>> entities;

diff --git a/test/webos-mention-test.cpp b/test/webos-mention-test.cpp
new file mode 100644
index 0000000..60f4a7b
--- /dev/null
+++ b/test/webos-mention-test.cpp
@@ -0,0 +1,109 @@
+// A mention, by username or by name, is shown in bold, as it is in the text: offsets count UTF-16
+// code units, custom emoji are replaced as before, and entities nest as the formatting does. For
+// the Messaging app only: other front-ends show a mention plain.
+#include "receiving.h"
+#include "purple-info.h"
+#include "libpurple-mock.h"
+#include <gtest/gtest.h>
+
+using td::td_api::formattedText;
+using td::td_api::make_object;
+using td::td_api::object_ptr;
+using td::td_api::textEntity;
+using td::td_api::TextEntityType;
+using td::td_api::textEntityTypeBold;
+using td::td_api::textEntityTypeCustomEmoji;
+using td::td_api::textEntityTypeMention;
+using td::td_api::textEntityTypeMentionName;
+
+static object_ptr<formattedText> makeEntityText(const std::string &text,
+                                                std::vector<object_ptr<textEntity>> entities)
+{
+    return make_object<formattedText>(text, std::move(entities));
+}
+
+static object_ptr<textEntity> entityOf(int32_t offset, int32_t length, object_ptr<TextEntityType> type)
+{
+    return make_object<textEntity>(offset, length, std::move(type));
+}
+
+class WebosMentionTest: public testing::Test {
+protected:
+    void SetUp() override
+    {
+        m_uiName = getUiName();
+        setUiName("Palm Messaging");
+    }
+    void TearDown() override
+    {
+        setUiName(m_uiName);
+    }
+private:
+    const char *m_uiName = nullptr;
+};
+
+TEST_F(WebosMentionTest, Bold)
+{
+    std::vector<object_ptr<textEntity>> entities;
+    // An emoji before it, two UTF-16 code units
+    entities.push_back(entityOf(3, 4, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("\xF0\x9F\x98\x80 <b>@ann</b> hi",
+              getMessageText(*makeEntityText("\xF0\x9F\x98\x80 @ann hi", std::move(entities))));
+
+    // By name, with no "@" added, and escaped inside
+    entities.clear();
+    entities.push_back(entityOf(3, 11, make_object<textEntityTypeMentionName>(100)));
+    ASSERT_EQ("Hi <b>Tom &lt;Jerry&gt;</b>!",
+              getMessageText(*makeEntityText("Hi Tom <Jerry>!", std::move(entities))));
+
+    // Both kinds, out of order, beside other formatting, which is shown too
+    entities.clear();
+    entities.push_back(entityOf(8, 3, make_object<textEntityTypeMentionName>(100)));
+    entities.push_back(entityOf(4, 4, make_object<textEntityTypeBold>()));
+    entities.push_back(entityOf(0, 3, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("<b>@bo</b> <b>and </b><b>Ann</b>",
+              getMessageText(*makeEntityText("@bo and Ann", std::move(entities))));
+
+    // Not as text to edit, which has no mention markup to send back
+    entities.clear();
+    entities.push_back(entityOf(0, 3, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("@bo &lt;3", getMessageText(*makeEntityText("@bo <3", std::move(entities)), nullptr, true));
+
+    // Nothing to bold, or past the end
+    entities.clear();
+    entities.push_back(entityOf(0, 0, make_object<textEntityTypeMention>()));
+    entities.push_back(entityOf(5, 4, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("@bo", getMessageText(*makeEntityText("@bo", std::move(entities))));
+}
+
+TEST_F(WebosMentionTest, NextToCustomEmoji)
+{
+    const int64_t emojiId = 5555;
+    std::map<int64_t, std::string> smileys = {{emojiId, "<:)>"}};
+    std::vector<object_ptr<textEntity>> entities;
+    entities.push_back(entityOf(0, 2, make_object<textEntityTypeCustomEmoji>(emojiId)));
+    entities.push_back(entityOf(2, 4, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("&lt;:)&gt;<b>@bob</b>",
+              getMessageText(*makeEntityText("\xF0\x9F\x98\x80@bob", std::move(entities)), &smileys));
+
+    // Over the custom emoji too: the emoji is shown inside the bold mention
+    entities.clear();
+    entities.push_back(entityOf(0, 6, make_object<textEntityTypeMention>()));
+    entities.push_back(entityOf(0, 2, make_object<textEntityTypeCustomEmoji>(emojiId)));
+    ASSERT_EQ("<b>&lt;:)&gt;@bob</b>",
+              getMessageText(*makeEntityText("\xF0\x9F\x98\x80@bob", std::move(entities)), &smileys));
+    // Without smileys the emoji stays, and the mention is bold
+    entities.clear();
+    entities.push_back(entityOf(0, 2, make_object<textEntityTypeCustomEmoji>(emojiId)));
+    entities.push_back(entityOf(2, 4, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("\xF0\x9F\x98\x80<b>@bob</b>",
+              getMessageText(*makeEntityText("\xF0\x9F\x98\x80@bob", std::move(entities))));
+}
+
+TEST_F(WebosMentionTest, PlainForOtherFrontEnds)
+{
+    setUiName("Pidgin");
+    std::vector<object_ptr<textEntity>> entities;
+    entities.push_back(entityOf(0, 4, make_object<textEntityTypeMention>()));
+    ASSERT_EQ("@ann hi", getMessageText(*makeEntityText("@ann hi", std::move(entities))));
+}

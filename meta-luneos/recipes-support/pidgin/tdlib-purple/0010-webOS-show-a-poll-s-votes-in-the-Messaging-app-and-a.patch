+// positions in the poll
+TEST_F(WebosCommandTest, VotePollInGroup)
+{
+    login();
+    addBasicGroup();
+    auto vote = reinterpret_cast<PollVoteCallback>(getConnectedSignal("webos-im-send-poll-vote"));
+    ASSERT_NE(nullptr, vote);
+    std::string id = serviceMessageId(groupChatId, 5);
+
+    vote(account, groupChatPurpleName.c_str(), id.c_str(), "Pasta", nullptr);
+    tgl.verifyRequest(getMessage(groupChatId, 5));
+    tgl.reply(makeMessage(5, userIds[0], groupChatId, false, 10001, makePollContent({0, 0, 0}, false)));
+    tgl.verifyRequest(setPollAnswer(groupChatId, 5, {2}));
+    tgl.reply(make_object<ok>());
+
+    vote(account, groupChatPurpleName.c_str(), id.c_str(), "Soup\x1fPizza\x1f" "Soup", nullptr);
+    tgl.verifyRequest(getMessage(groupChatId, 5));
+    tgl.reply(makeMessage(5, userIds[0], groupChatId, false, 10001, makePollContent({0, 0, 1}, true, 2)));
+    tgl.verifyRequest(setPollAnswer(groupChatId, 5, {0, 1}));
+    tgl.reply(make_object<ok>());
+    prpl.verifyNoEvents();
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+}
+
+// The counts come with the poll each time it changes, and the poll is rewritten where it is, as
+// it was, with them: no notice of an edit, and nothing where nothing the app shows has changed
+TEST_F(WebosCommandTest, PollCountsRewritten)
+{
+    login();
+    addBasicGroup();
+    tgl.update(make_object<updateNewMessage>(makeMessage(
+        5, userIds[0], groupChatId, false, 10001, makePollContent({0, 0, 0}, false)
+    )));
+    tgl.verifyRequest(viewMessages(groupChatId, {5}, nullptr, true));
+    prpl.verifyEvents(
+        ServGotJoinedChatEvent(connection, 2, groupChatPurpleName, "Physics"),
+        ServGotChatEvent(connection, 2, purpleUserName(0) + "\x1f" + userFirstNames[0] + " " + userLastNames[0],
+                         pollText(nullptr), PURPLE_MESSAGE_RECV, 10001)
+    );
+    PurpleConversation *conv = purple_find_chat(connection, 2);
+    ASSERT_NE(nullptr, conv);
+    g_free(purple_conversation_get_data(conv, "webos-msg-id"));
+    purple_conversation_set_data(conv, "webos-msg-id", nullptr);
+    std::string id = serviceMessageId(groupChatId, 5);
+
+    // Our vote, from here or elsewhere: now the counts can be seen
+    tgl.update(makeUpdateMessageContent(groupChatId, 5, makePollContent({2, 0, 1}, true, 0)));
+    std::vector<int32_t> votes = {2, 0, 1};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, id, pollText(&votes))}), takeWebosSignals());
+    // Being chosen, say, which the app does not show
+    tgl.update(makeUpdateMessageContent(groupChatId, 5, makePollContent({2, 0, 1}, true, 0)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+    // Someone else's vote
+    tgl.update(makeUpdateMessageContent(groupChatId, 5, makePollContent({2, 3, 1}, true, 0)));
+    votes = {2, 3, 1};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, id, pollText(&votes))}), takeWebosSignals());
+    // Closed: shown with the final counts, not as an edit followed by the poll once more
+    auto closed = makePollContent({2, 3, 2}, true, 0);
+    closed->poll_->is_closed_ = true;
+    tgl.update(makeUpdateMessageContent(groupChatId, 5, std::move(closed)));
+    votes = {2, 3, 2};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, id, pollText(&votes))}), takeWebosSignals());
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+
+    // updatePoll, which a bot gets, finds the message by the poll's id
+    auto poll = makePollContent({4, 3, 2}, true, 0);
+    tgl.update(make_object<updatePoll>(std::move(poll->poll_)));
+    votes = {4, 3, 2};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, id, pollText(&votes))}), takeWebosSignals());
+    poll = makePollContent({4, 3, 2}, true, 0);
+    poll->poll_->id_ = 98;
+    tgl.update(make_object<updatePoll>(std::move(poll->poll_)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+
+    // Our vote taken back: the counts cannot be seen any longer, and are not shown as 0
+    tgl.update(makeUpdateMessageContent(groupChatId, 5, makePollContent({0, 0, 0}, false)));
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, id, pollText(nullptr))}), takeWebosSignals());
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+}
+
+// A poll that comes with counts has them from the start; one from an earlier session is rewritten
+// where the transport keeps it
+TEST_F(WebosCommandTest, PollCountsAtOnce)
+{
+    login();
+    tgl.update(make_object<updateNewMessage>(makeMessage(
+        5, userIds[0], chatIds[0], false, 10001, makePollContent({1, 2, 0}, true, 1)
+    )));
+    std::vector<int32_t> votes = {1, 2, 0};
+    prpl.verifyEvents(NewConversationEvent(PURPLE_CONV_TYPE_IM, account, purpleUserName(0)),
+                      ServGotImEvent(connection, purpleUserName(0), pollText(&votes), PURPLE_MESSAGE_RECV, 10001));
+    tgl.verifyRequest(viewMessages(chatIds[0], {5}, nullptr, true));
+    PurpleConversation *conv = purple_find_conversation_with_account(PURPLE_CONV_TYPE_IM,
+                                                                     purpleUserName(0).c_str(), account);
+    ASSERT_NE(nullptr, conv);
+    g_free(purple_conversation_get_data(conv, "webos-msg-id"));
+    purple_conversation_set_data(conv, "webos-msg-id", nullptr);
+    // As it was shown
+    tgl.update(makeUpdateMessageContent(chatIds[0], 5, makePollContent({1, 2, 0}, true, 1)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+
+    tgl.update(makeUpdateMessageContent(chatIds[0], 42, makePollContent({1, 1, 1}, true)));
+    votes = {1, 1, 1};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, serviceMessageId(chatIds[0], 42), pollText(&votes))}),
+              takeWebosSignals());
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+
+    // A forwarded poll keeps the line saying so
+    auto message = makeMessage(6, userIds[0], chatIds[0], false, 10002, makePollContent({0, 0, 0}, false));
+    message->forward_info_ = make_object<messageForwardInfo>(make_object<messageOriginHiddenUser>("Galileo"),
+                                                             10000, nullptr, "");
+    tgl.update(make_object<updateNewMessage>(std::move(message)));
+    const std::string forwarded = "<b>Forwarded from Galileo:</b>\n";
+    prpl.verifyEvents(ServGotImEvent(connection, purpleUserName(0), forwarded + pollText(nullptr),
+                                     PURPLE_MESSAGE_RECV, 10002));
+    tgl.verifyRequest(viewMessages(chatIds[0], {6}, nullptr, true));
+    g_free(purple_conversation_get_data(conv, "webos-msg-id"));
+    purple_conversation_set_data(conv, "webos-msg-id", nullptr);
+    tgl.update(makeUpdateMessageContent(chatIds[0], 6, makePollContent({0, 1, 0}, true, 1)));
+    votes = {0, 1, 0};
+    ASSERT_EQ(std::vector<WebosSignal>({webosEdit(account, serviceMessageId(chatIds[0], 6),
+                                                  forwarded + pollText(&votes))}),
+              takeWebosSignals());
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+}
+
+// A poll still waiting to be shown, for the message it answers, is shown as it is by then
+TEST_F(WebosCommandTest, PollCountsWhileWaiting)
+{
+    login();
+    auto message = makeMessage(5, userIds[0], chatIds[0], false, 10001, makePollContent({0, 0, 0}, false));
+    message->reply_to_ = makeReplyTo(1);

+// As many as the shown messages, the polls among which are fewer
+enum { MAX_POLL_MESSAGES = 10000 };
+
+bool TdAccountData::setPollText(ChatId chatId, MessageId messageId, int64_t pollId, const std::string &text)
+{
+    ShownMessageKey key(chatId, messageId);
+    auto it = m_pollMessages.find(key);
+    if (it == m_pollMessages.end()) {
+        it = m_pollMessages.emplace(key, PollMessage()).first;
+        m_pollMessageOrder.push_back(key);
+        while (m_pollMessageOrder.size() > MAX_POLL_MESSAGES) {
+            m_pollMessages.erase(m_pollMessageOrder.front());
+            m_pollMessageOrder.pop_front();
+        }
+    } else if ((it->second.pollId == pollId) && (it->second.text == text))
+        return false;
+    it->second.pollId = pollId;
+    it->second.text   = text;
+    return true;
+}
+
+std::string TdAccountData::getPollTextPrefix(ChatId chatId, MessageId messageId) const
+{
+    auto it = m_pollMessages.find(ShownMessageKey(chatId, messageId));
+    return (it != m_pollMessages.end()) ? it->second.prefix : std::string();
+}
+
+void TdAccountData::setPollTextPrefix(ChatId chatId, MessageId messageId, const std::string &prefix)
+{
+    auto it = m_pollMessages.find(ShownMessageKey(chatId, messageId));
+    if (it != m_pollMessages.end())
+        it->second.prefix = prefix;
+}
+
+std::vector<std::pair<ChatId, MessageId>> TdAccountData::getPollMessages(int64_t pollId) const
+{
+    std::vector<std::pair<ChatId, MessageId>> result;
+    for (const ShownMessageKey &key: m_pollMessageOrder) {
+        auto it = m_pollMessages.find(key);
+        if ((it != m_pollMessages.end()) && (it->second.pollId == pollId))
+            result.push_back(key);
+    }
+    return result;
+}

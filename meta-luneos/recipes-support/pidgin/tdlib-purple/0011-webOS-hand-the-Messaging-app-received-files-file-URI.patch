+// webOS: a received file as its file:// URI, which the Messaging app shows as a picture, a player or
+// a chip that opens it. imlibpurpleservice keeps no link (IMMessage::initFromCallback drops every
+// tag but b, i, u and br), so a link would leave only its text: the word "photo", or a file name.
+// No thumbnail either, as an imgstore picture would be dropped likewise.
+static std::string makeWebosFileText(const std::string &filePath, const std::string &mediaVariantLinks,
+                                     const char *caption)
+{
+    std::string text = escapeForDisplay(makeFileUri(filePath));
+    if (!mediaVariantLinks.empty())
+        text += "\n" + mediaVariantLinks;
+    if (caption && *caption) {
+        text += "\n";
+        text += caption;
+    }
+    return text;
+}
+
+static void showWebosFile(const td::td_api::chat &chat, const TgMessageInfo &message,
+                          const std::string &filePath, const char *caption, TdAccountData &account)
+{
+    std::string text = makeWebosFileText(filePath, message.mediaVariantLinks, caption);
+    showMessageText(account, chat, message, text.c_str(), NULL);
+}
+
+// webOS: what a message's file is, by the app's download rule; false for a message without one
+static bool getWebosFileKind(const td::td_api::MessageContent &content, webos::FileKind &kind)
+{
+    switch (content.get_id()) {
+    case td::td_api::messagePhoto::ID:
+        kind = webos::FileKind::Photo;
+        return true;
+    case td::td_api::messageSticker::ID:
+        kind = webos::FileKind::Sticker;
+        return true;
+    case td::td_api::messageVoiceNote::ID:
+        kind = webos::FileKind::VoiceNote;
+        return true;
+    case td::td_api::messageAnimation::ID:
+        kind = webos::FileKind::Animation;
+        return true;
+    case td::td_api::messageVideoNote::ID:
+        kind = webos::FileKind::VideoNote;
+        return true;
+    case td::td_api::messageVideo::ID:
+        kind = webos::FileKind::Video;
+        return true;
+    case td::td_api::messageAudio::ID:
+        kind = webos::FileKind::Audio;
+        return true;
+    case td::td_api::messageDocument::ID:
+        kind = webos::FileKind::Document;
+        return true;
+    }
+    return false;
+}
+
+// In bytes, or what TDLib expects it to be, 0 if neither is known. Not cut to 32 bits, as
+// getFileSize does: a video can be larger.
+static int64_t getWebosFileSize(const td::td_api::file &file)
+{
+    int64_t size = file.size_ ? file.size_ : file.expected_size_;
+    return (size > 0) ? size : 0;
+}
+
+// The card of a file that waits for a tap, which the app draws from the first line, and the
+// caption, as markup, below it
+static std::string makeWebosFileOfferText(const std::string &name, int64_t size, webos::FileKind kind,
+                                          webos::FileOfferState state, int64_t got, const char *caption)
+{
+    std::string text = escapeForDisplay(webos::fileOfferLine(name, size, kind, state, got));
+    if (caption && *caption) {
+        text += "\n";
+        text += caption;
+    }
+    return text;
+}
+
+// Whether the message's file waits for a tap, rather than being fetched as it comes; never for a
+// file that is here already
+static bool isWebosFileOffer(const IncomingMessage &fullMessage)
+{
+    webos::FileKind kind;
+    if (!fullMessage.message || !fullMessage.message->content_ ||
+        !getWebosFileKind(*fullMessage.message->content_, kind))
+        return false;
+    FileInfo fileInfo;
+    getFileFromMessage(fullMessage, fileInfo);
+    if (!fileInfo.file || (fileInfo.file->local_ && fileInfo.file->local_->is_downloading_completed_))
+        return false;
+    return !webos::downloadsByItself(kind, getWebosFileSize(*fileInfo.file));
+}
+
+static void showWebosFileOffer(const td::td_api::chat &chat, const IncomingMessage &fullMessage,
+                               const td::td_api::file &file, const char *caption, TdAccountData &account)
+{
+    webos::FileKind kind = webos::FileKind::Document;
+    getWebosFileKind(*fullMessage.message->content_, kind);
+    FileInfo fileInfo;
+    getFileFromMessage(fullMessage, fileInfo);
+    int64_t size = getWebosFileSize(file);
+    purple_debug_misc(config::pluginId, "File of message %" G_GINT64_FORMAT " (%s, %" G_GINT64_FORMAT
+                      " bytes) waits for a tap\n", fullMessage.messageInfo.id.value(),
+                      webos::fileOfferType(kind), size);
+    std::string text = makeWebosFileOfferText(fileInfo.name, size, kind, webos::FileOfferState::Ask, 0, caption);
+    showMessageText(account, chat, fullMessage.messageInfo, text.c_str(), NULL);
+}
+

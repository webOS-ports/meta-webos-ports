+bool downloadsByItself(FileKind kind, int64_t size)
+{
+    switch (kind) {
+    case FileKind::Photo:
+    case FileKind::Sticker:
+    case FileKind::VoiceNote:
+    case FileKind::Animation:
+        return true;
+    case FileKind::Document:
+        return (size > 0) && (size <= AutoDownloadDocumentMaxBytes);
+    case FileKind::VideoNote:
+    case FileKind::Video:
+    case FileKind::Audio:
+        break;
+    }
+    return false;
+}
+
+const char *fileOfferType(FileKind kind)
+{
+    switch (kind) {
+    case FileKind::Video:
+    case FileKind::VideoNote:
+    case FileKind::Animation:
+        return "video";
+    case FileKind::Audio:
+    case FileKind::VoiceNote:
+        return "audio";
+    case FileKind::Photo:
+    case FileKind::Sticker:
+    case FileKind::Document:
+        break;
+    }
+    return "document";
+}
+
+std::string fileOfferLine(const std::string &name, int64_t size, FileKind kind, FileOfferState state,
+                          int64_t got)
+{
+    // Everything but the unreserved characters percent-encoded: no blank, "&", "+" or quote is left
+    // for the app to read wrongly
+    gchar      *escaped = g_uri_escape_string(name.c_str(), NULL, FALSE);
+    std::string line    = "luneos-file:?name=";
+    line += escaped ? escaped : "";
+    g_free(escaped);
+    line += "&size=" + std::to_string(size > 0 ? size : 0);
+    line += "&type=";
+    line += fileOfferType(kind);
+    line += "&state=";
+    switch (state) {
+    case FileOfferState::Ask:
+        line += "ask";
+        break;
+    case FileOfferState::Downloading:
+        line += "downloading";
+        if (got > 0)
+            line += "&got=" + std::to_string(got);
+        break;
+    case FileOfferState::Failed:
+        line += "failed";
+        break;
+    }
+    return line;
+}

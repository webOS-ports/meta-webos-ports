+// The tap: downloadFile from the app, as the signal, finds the message again through TDLib,
+// rewrites the card as downloading, with how much has come every few seconds, and then as the
+// file and the caption; "webos-im-replace", never "webos-im-edit", which would mark it edited
+TEST_F(WebosTapTest, Tap)
+{
+    login();
+    tgl.update(make_object<updateNewMessage>(makeMessage(
+        1, userIds[0], chatIds[0], false, 10001, videoContent(remoteFile(1234, 100000), "clip.mp4", "1<2"))));
+    tgl.verifyRequest(viewMessages(chatIds[0], {1}, nullptr, true));
+    verifyShown(1, 10001, "luneos-file:?name=clip.mp4&size=100000&type=video&state=ask\n1&lt;2", true);
+
+    ASSERT_NE(nullptr, tap());
+    std::string id = serviceMessageId(chatIds[0], 1);
+    ASSERT_TRUE(tap()(account, purpleUserName(0).c_str(), id.c_str(), nullptr));
+    tgl.verifyRequest(getMessage(chatIds[0], 1));
+    tgl.reply(makeMessage(1, userIds[0], chatIds[0], false, 10001,
+                          videoContent(remoteFile(1234, 100000), "clip.mp4", "1<2")));
+    ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 1,
+              "luneos-file:?name=clip.mp4&size=100000&type=video&state=downloading\n1&lt;2")}),
+              takeWebosSignals());
+    uint64_t downloadId = tgl.verifyRequest(downloadFile(1234, 1, 0, 0, true));
+
+    // How much has come: not before 3 s since the card was last rewritten, then at most every 3 s
+    g_tapClock += 2999999;
+    tgl.update(make_object<updateFile>(partFile(1234, 100000, 1000)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+    g_tapClock += 1;
+    tgl.update(make_object<updateFile>(partFile(1234, 100000, 2000)));
+    ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 1,
+              "luneos-file:?name=clip.mp4&size=100000&type=video&state=downloading&got=2000\n1&lt;2")}),
+              takeWebosSignals());
+    g_tapClock += 1000000;
+    tgl.update(make_object<updateFile>(partFile(1234, 100000, 3000)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+    // Another file's progress is not this one's
+    g_tapClock += 5000000;
+    tgl.update(make_object<updateFile>(partFile(999, 100000, 3000)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+
+    tgl.reply(downloadId, fetchedFile(1234, 100000, "/files/videos/clip one.mp4"));
+    ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 1, "file:///files/videos/clip%20one.mp4\n1&lt;2")}),
+              takeWebosSignals());
+    // Done: no more progress
+    g_tapClock += 5000000;
+    tgl.update(make_object<updateFile>(partFile(1234, 100000, 3000)));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+}
+
+// A second tap while the file comes: one card, so one line of progress, and none once the file
+// is complete; each answer to the download gives the file
+TEST_F(WebosTapTest, TapTwice)
+{
+    login();
+    std::string id = serviceMessageId(chatIds[0], 1);
+    uint64_t downloadIds[2];
+    for (uint64_t &downloadId: downloadIds) {
+        ASSERT_TRUE(tap()(account, purpleUserName(0).c_str(), id.c_str(), nullptr));
+        tgl.verifyRequest(getMessage(chatIds[0], 1));
+        tgl.reply(makeMessage(1, userIds[0], chatIds[0], false, 10001,
+                              videoContent(remoteFile(1234, 100000), "clip.mp4", "")));
+        ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 1,
+                  "luneos-file:?name=clip.mp4&size=100000&type=video&state=downloading")}),
+                  takeWebosSignals());
+        downloadId = tgl.verifyRequest(downloadFile(1234, 1, 0, 0, true));
+    }
+
+    g_tapClock += 3000000;
+    tgl.update(make_object<updateFile>(partFile(1234, 100000, 2000)));
+    ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 1,
+              "luneos-file:?name=clip.mp4&size=100000&type=video&state=downloading&got=2000")}),
+              takeWebosSignals());
+    // Complete, before the download is answered: the answer gives the file, not progress
+    g_tapClock += 3000000;
+    tgl.update(make_object<updateFile>(fetchedFile(1234, 100000, "/files/videos/clip.mp4")));
+    ASSERT_EQ(std::vector<WebosSignal>(), takeWebosSignals());
+
+    for (uint64_t downloadId: downloadIds) {
+        tgl.reply(downloadId, fetchedFile(1234, 100000, "/files/videos/clip.mp4"));
+        ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 1, "file:///files/videos/clip.mp4")}),
+                  takeWebosSignals());
+    }
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+}
+
+// The download fails: the card says so, and a later tap tries again

+    login();
+    std::string id = serviceMessageId(chatIds[0], 7);
+    ASSERT_TRUE(tap()(account, purpleUserName(0).c_str(), id.c_str(), nullptr));
+    tgl.verifyRequest(getMessage(chatIds[0], 7));

+// webOS: a file is fetched as it comes, or waits for a tap, by its kind and size; a tap fetches it
+// and rewrites the card where it is, without marking the message edited
+TEST(WebosTapRuleTest, DownloadsByItself)
+{
+    using webos::FileKind;
+    const int64_t limit = webos::AutoDownloadDocumentMaxBytes;
+    ASSERT_EQ(1024 * 1024, limit);
+    for (int64_t size: {int64_t(0), int64_t(1), limit - 1, limit, limit + 1, int64_t(5000000000)}) {
+        for (FileKind kind: {FileKind::Photo, FileKind::Sticker, FileKind::VoiceNote, FileKind::Animation})
+            ASSERT_TRUE(webos::downloadsByItself(kind, size)) << int(kind) << " " << size;
+        for (FileKind kind: {FileKind::Video, FileKind::VideoNote, FileKind::Audio})
+            ASSERT_FALSE(webos::downloadsByItself(kind, size)) << int(kind) << " " << size;
+    }
+    // A document up to 1 MB, and only one of known size
+    ASSERT_FALSE(webos::downloadsByItself(FileKind::Document, 0));
+    ASSERT_FALSE(webos::downloadsByItself(FileKind::Document, -1));
+    ASSERT_TRUE(webos::downloadsByItself(FileKind::Document, 1));
+    ASSERT_TRUE(webos::downloadsByItself(FileKind::Document, limit - 1));
+    ASSERT_TRUE(webos::downloadsByItself(FileKind::Document, limit));
+    ASSERT_FALSE(webos::downloadsByItself(FileKind::Document, limit + 1));
+    ASSERT_FALSE(webos::downloadsByItself(FileKind::Document, 5000000000));
+}

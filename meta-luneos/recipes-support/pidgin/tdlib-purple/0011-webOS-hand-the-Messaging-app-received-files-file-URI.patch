+void TdAccountData::addOfferedDownload(const OfferedDownload &download)
+{
+    removeOfferedDownload(download.chatId, download.messageId);
+    m_offeredDownloads.push_back(download);
+}
+
+std::vector<OfferedDownload *> TdAccountData::findOfferedDownloads(int32_t fileId)
+{
+    std::vector<OfferedDownload *> result;
+    for (OfferedDownload &download: m_offeredDownloads)
+        if (download.fileId == fileId)
+            result.push_back(&download);
+    return result;
+}
+
+void TdAccountData::removeOfferedDownload(ChatId chatId, MessageId messageId)
+{
+    m_offeredDownloads.erase(std::remove_if(m_offeredDownloads.begin(), m_offeredDownloads.end(),
+                                            [chatId, messageId](const OfferedDownload &download) {
+                                                return (download.chatId == chatId) &&
+                                                       (download.messageId == messageId);
+                                            }),
+                             m_offeredDownloads.end());
+}

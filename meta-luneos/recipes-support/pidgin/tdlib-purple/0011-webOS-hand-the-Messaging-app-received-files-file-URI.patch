+// webOS: "webos-im-replace" (account, serviceMessageId, text) has the transport change the stored
+// message's text where it is, as "webos-im-edit" does, but without marking it edited: it is not
+// the sender's edit, but the plug-in's own rewrite of what it gave the app
+static void emitWebosReplaceSignal(TdAccountData &account, ChatId chatId, MessageId messageId,
+                                   const std::string &newText)
+{
+    std::string id = webosServiceMessageId(chatId.value(), messageId.value());
+    purple_signal_emit(purple_conversations_get_handle(), "webos-im-replace",
+                       account.purpleAccount, id.c_str(), newText.c_str());
+}
+
+// How often, at most, the card of a file being fetched is rewritten with how much of it has come
+static constexpr int64_t OfferProgressIntervalUs = 3 * G_USEC_PER_SEC;
+static int64_t (*g_webosOfferClock)() = nullptr;
+
+void setWebosOfferClock(int64_t (*clock)())
+{
+    g_webosOfferClock = clock;
+}
+
+static int64_t getWebosOfferTime()
+{
+    return g_webosOfferClock ? g_webosOfferClock() : g_get_monotonic_time();
+}
+
+static void rewriteOfferedFile(TdAccountData &account, const OfferedDownload &download,
+                               webos::FileOfferState state, int64_t got)
+{
+    std::string text = download.prefix + makeWebosFileOfferText(download.name, download.size, download.kind,
+                                                                state, got, download.caption.c_str());
+    emitWebosReplaceSignal(account, download.chatId, download.messageId, text);
+}
+
+static void offeredFileDownloadResponse(TdAccountData &account, const OfferedDownload &download,
+                                        td::td_api::object_ptr<td::td_api::Object> object)
+{
+    account.removeOfferedDownload(download.chatId, download.messageId);
+    std::string path = getDownloadPath(object);
+    if (path.empty()) {
+        purple_debug_warning(config::pluginId, "File of message %" G_GINT64_FORMAT " (file id %d) not fetched\n",
+                             download.messageId.value(), (int)download.fileId);
+        rewriteOfferedFile(account, download, webos::FileOfferState::Failed, 0);
+        return;
+    }
+    purple_debug_misc(config::pluginId, "File of message %" G_GINT64_FORMAT " (file id %d) fetched\n",
+                      download.messageId.value(), (int)download.fileId);
+    emitWebosReplaceSignal(account, download.chatId, download.messageId,
+                           download.prefix + makeWebosFileText(path, std::string(), download.caption.c_str()));
+}
+
+static void offeredFileMessageResponse(TdAccountData &account, ChatId chatId, MessageId messageId,
+                                       td::td_api::object_ptr<td::td_api::Object> object)
+{
+    const td::td_api::chat *chat = account.getChat(chatId);
+    if (!chat || !object || (object->get_id() != td::td_api::message::ID)) {
+        purple_debug_warning(config::pluginId, "Cannot fetch the file of message %" G_GINT64_FORMAT
+                             ": no such message\n", messageId.value());
+        return;
+    }
+
+    IncomingMessage fullMessage;
+    makeFullMessage(*chat, td::move_tl_object_as<td::td_api::message>(object), fullMessage, account);
+    webos::FileKind kind;
+    FileInfo        fileInfo;
+    getFileFromMessage(fullMessage, fileInfo);
+    if (!fullMessage.message || !fullMessage.message->content_ ||
+        !getWebosFileKind(*fullMessage.message->content_, kind) || !fileInfo.file)
+    {
+        purple_debug_warning(config::pluginId, "Cannot fetch the file of message %" G_GINT64_FORMAT
+                             ": it has none\n", messageId.value());
+        return;
+    }
+    const td::td_api::file &file = *fileInfo.file;
+
+    OfferedDownload download;
+    download.chatId    = chatId;
+    download.messageId = messageId;
+    download.fileId    = file.id_;
+    download.prefix    = getForwardHeader(fullMessage.messageInfo);
+    download.name      = fileInfo.name;
+    download.size      = getWebosFileSize(file);
+    download.kind      = kind;
+    download.caption   = fileInfo.caption;
+
+    if (file.local_ && file.local_->is_downloading_completed_) {
+        purple_debug_misc(config::pluginId, "File of message %" G_GINT64_FORMAT " is here already\n",
+                          messageId.value());
+        emitWebosReplaceSignal(account, chatId, messageId,
+                               download.prefix + makeWebosFileText(file.local_->path_, std::string(),
+                                                                   download.caption.c_str()));
+        return;
+    }
+
+    purple_debug_misc(config::pluginId, "Fetching the file of message %" G_GINT64_FORMAT " (file id %d)\n",
+                      messageId.value(), (int)file.id_);
+    download.shownAt = getWebosOfferTime();
+    rewriteOfferedFile(account, download, webos::FileOfferState::Downloading, 0);
+    account.addOfferedDownload(download);
+
+    auto request = td::td_api::make_object<td::td_api::downloadFile>();
+    request->file_id_     = file.id_;
+    request->priority_    = FILE_DOWNLOAD_PRIORITY;
+    request->offset_      = 0;
+    request->limit_       = 0;
+    request->synchronous_ = true;
+    account.transceiver.sendQuery(std::move(request),
+        [&account, download](uint64_t, td::td_api::object_ptr<td::td_api::Object> object) {
+            offeredFileDownloadResponse(account, download, std::move(object));
+        });
+}
+
+void downloadOfferedFile(TdAccountData &account, ChatId chatId, MessageId messageId)
+{
+    // Found again by its ids, as the transport may have been restarted since the card was given
+    purple_debug_misc(config::pluginId, "File of message %" G_GINT64_FORMAT " asked for\n", messageId.value());
+    auto request = td::td_api::make_object<td::td_api::getMessage>();
+    request->chat_id_    = chatId.value();
+    request->message_id_ = messageId.value();
+    account.transceiver.sendQuery(std::move(request),
+        [&account, chatId, messageId](uint64_t, td::td_api::object_ptr<td::td_api::Object> object) {
+            offeredFileMessageResponse(account, chatId, messageId, std::move(object));
+        });
+}
+
+void updateOfferedFileProgress(TdAccountData &account, const td::td_api::file &file)
+{
+    if (!file.local_ || file.local_->is_downloading_completed_ || (file.local_->downloaded_size_ <= 0))
+        return;
+    int64_t now = getWebosOfferTime();
+    for (OfferedDownload *download: account.findOfferedDownloads(file.id_)) {
+        if (now - download->shownAt < OfferProgressIntervalUs)
+            continue;
+        download->shownAt = now;
+        rewriteOfferedFile(account, *download, webos::FileOfferState::Downloading, file.local_->downloaded_size_);
+    }
+}

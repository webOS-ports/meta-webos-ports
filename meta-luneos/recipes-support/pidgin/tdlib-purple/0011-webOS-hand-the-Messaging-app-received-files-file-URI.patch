+            makeFormattedText(caption));
+    }
+    DownloadFileCallback tap()
+    {
+        return reinterpret_cast<DownloadFileCallback>(getConnectedSignal("webos-im-download-file"));
+    }
+    WebosSignal replace(int64_t chatId, int64_t messageId, const std::string &text)
+    {
+        return WebosSignal{"webos-im-replace", account, {serviceMessageId(chatId, messageId), text}};
+    }
+    // A message shown in the private chat, its text as the transport is given it
+    void verifyShown(int64_t messageId, int32_t date, const std::string &text, bool first = false)
+    {

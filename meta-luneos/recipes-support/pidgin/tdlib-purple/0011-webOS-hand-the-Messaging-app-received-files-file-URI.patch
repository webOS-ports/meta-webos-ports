+static unsigned modeOf(const std::string &path)
+{
+    GStatBuf st;
+    return (g_lstat(path.c_str(), &st) == 0) ? (st.st_mode & 07777) : 01000000;
+}
+
+// A received file the transport (root) keeps privately, readable by the app (another user) once
+// it is handed over: the file for all, the folders up to the root searchable, none listable
+TEST(WebosReceiveTest, ShareWithApps)
+{
+    gchar *tmp = g_dir_make_tmp("webos-share-XXXXXX", NULL);
+    ASSERT_NE(nullptr, tmp);
+    std::string root = std::string(tmp) + "/files";
+    std::string dir  = root + "/+31600000000/photos";
+    ASSERT_EQ(0, g_mkdir_with_parents(dir.c_str(), 0700));
+    ASSERT_EQ(0, g_chmod(root.c_str(), 0700));
+    ASSERT_EQ(0, g_chmod((root + "/+31600000000").c_str(), 0700));
+    ASSERT_EQ(0, g_chmod(dir.c_str(), 0750));
+    std::string photo = dir + "/1_2.jpg";
+    ASSERT_TRUE(g_file_set_contents(photo.c_str(), "x", 1, NULL));
+    ASSERT_EQ(0, g_chmod(photo.c_str(), 0640));
+    std::string other = dir + "/3_4.jpg";
+    ASSERT_TRUE(g_file_set_contents(other.c_str(), "y", 1, NULL));
+    ASSERT_EQ(0, g_chmod(other.c_str(), 0600));
+
+    ASSERT_TRUE(webos::shareWithApps(photo, root));
+    ASSERT_EQ(0644u, modeOf(photo));
+    ASSERT_EQ(0751u, modeOf(dir));
+    ASSERT_EQ(0711u, modeOf(root + "/+31600000000"));
+    ASSERT_EQ(0711u, modeOf(root));
+    ASSERT_EQ(0600u, modeOf(other)) << "only the file handed over";
+    ASSERT_EQ(0700u, modeOf(tmp)) << "nothing above the root";
+    // Again: nothing more to do
+    ASSERT_TRUE(webos::shareWithApps(photo, root));
+    ASSERT_EQ(0644u, modeOf(photo));
+
+    // Outside the root, a link, a folder, a missing file, a way out: left as they are
+    std::string outside = std::string(tmp) + "/elsewhere.jpg";
+    ASSERT_TRUE(g_file_set_contents(outside.c_str(), "z", 1, NULL));
+    ASSERT_EQ(0, g_chmod(outside.c_str(), 0600));
+    ASSERT_FALSE(webos::shareWithApps(outside, root));
+    ASSERT_FALSE(webos::shareWithApps(outside, root + "x"));
+    ASSERT_FALSE(webos::shareWithApps(root + "/../elsewhere.jpg", root));
+    ASSERT_EQ(0600u, modeOf(outside));
+    std::string link = dir + "/link.jpg";
+    ASSERT_EQ(0, symlink(outside.c_str(), link.c_str()));
+    ASSERT_FALSE(webos::shareWithApps(link, root));
+    ASSERT_EQ(0600u, modeOf(outside));
+    ASSERT_FALSE(webos::shareWithApps(dir, root));
+    ASSERT_FALSE(webos::shareWithApps(dir + "/gone.jpg", root));
+    ASSERT_FALSE(webos::shareWithApps(root, root));
+    ASSERT_FALSE(webos::shareWithApps(photo, ""));
+    ASSERT_FALSE(webos::shareWithApps(photo, "files"));
+
+    g_unlink(link.c_str());
+    g_unlink(outside.c_str());
+    g_unlink(other.c_str());
+    g_unlink(photo.c_str());
+    g_rmdir(dir.c_str());
+    g_rmdir((root + "/+31600000000").c_str());
+    g_rmdir(root.c_str());
+    g_rmdir(tmp);
+    g_free(tmp);
+}

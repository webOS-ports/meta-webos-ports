+// Adds bits to the mode of what fd is, if it is of the given type (S_IFREG, S_IFDIR).
+static bool addMode(int fd, mode_t type, mode_t bits)
+{
+    struct stat st;
+    if ((fd < 0) || (fstat(fd, &st) != 0) || ((st.st_mode & S_IFMT) != type))
+        return false;
+    const mode_t mode = st.st_mode & 07777;
+    return ((mode & bits) == bits) || (fchmod(fd, mode | bits) == 0);
+}
+
+bool shareWithApps(const std::string &path, const std::string &root)
+{
+    if (root.empty() || (root[0] != '/') || (path.size() <= root.size() + 1) ||
+        (path.compare(0, root.size(), root) != 0) || (path[root.size()] != '/') ||
+        (path.find("/..") != std::string::npos))
+        return false;
+    // Opened, not named, so that what is changed is what was looked at; O_NOFOLLOW: a link is left
+    int  fd = open(path.c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+    bool ok = addMode(fd, S_IFREG, 0044);
+    if (fd >= 0)
+        close(fd);
+    for (std::string dir = path.substr(0, path.rfind('/')); ok && (dir.size() >= root.size());
+         dir.resize(dir.rfind('/'))) {
+        fd = open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        ok = addMode(fd, S_IFDIR, 0011);
+        if (fd >= 0)
+            close(fd);
+    }
+    return ok;
+}

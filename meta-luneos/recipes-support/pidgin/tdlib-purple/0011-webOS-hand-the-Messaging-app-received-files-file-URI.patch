+TEST(WebosTapRuleTest, OfferLine)
+{
+    using webos::FileKind;
+    using webos::FileOfferState;
+    ASSERT_EQ("luneos-file:?name=report.pdf&size=2000000&type=document&state=ask",
+              webos::fileOfferLine("report.pdf", 2000000, FileKind::Document, FileOfferState::Ask));
+    // Every character but the unreserved ones percent-encoded, UTF-8 by its bytes: a blank, "&",
+    // "+", "=", "?", "#", "%", quotes, markup, a line break
+    ASSERT_EQ("luneos-file:?name=a%20b%26c%2Bd%3De%3Ff%23g%25h%22i%27j%3Ck%3El%0Am%C3%A9-_.~z.mp4"
+              "&size=5000000000&type=video&state=downloading&got=4096",
+              webos::fileOfferLine("a b&c+d=e?f#g%h\"i'j<k>l\nm\xC3\xA9-_.~z.mp4", 5000000000, FileKind::Video,
+                                   FileOfferState::Downloading, 4096));
+    // How much has come only while downloading, and only once something has
+    ASSERT_EQ("luneos-file:?name=&size=0&type=audio&state=downloading",
+              webos::fileOfferLine("", 0, FileKind::Audio, FileOfferState::Downloading, 0));
+    ASSERT_EQ("luneos-file:?name=x&size=10&type=audio&state=failed",
+              webos::fileOfferLine("x", 10, FileKind::Audio, FileOfferState::Failed, 5));
+    ASSERT_EQ("luneos-file:?name=x&size=10&type=video&state=ask",
+              webos::fileOfferLine("x", 10, FileKind::VideoNote, FileOfferState::Ask, 5));
+    // No size below 0
+    ASSERT_EQ("luneos-file:?name=x&size=0&type=document&state=ask",
+              webos::fileOfferLine("x", -5, FileKind::Document, FileOfferState::Ask));
+}

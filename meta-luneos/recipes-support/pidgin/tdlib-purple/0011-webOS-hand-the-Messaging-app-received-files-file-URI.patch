+    if (isWebosUi() && !isStickerAnimated(filePath)) {
+        showWebosFile(chat, message, filePath, caption, account);
+        return;
+    }
     showFileLink(chat, message, makeFileLinkTarget(filePath), caption, fileDescription, preview, account);
 }
 

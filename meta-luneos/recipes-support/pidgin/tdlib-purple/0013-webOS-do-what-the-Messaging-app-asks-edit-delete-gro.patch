+// webOS: the users the transport's mentions name, by record; 0 for one not exactly one known user
+static std::vector<int64_t> resolveMentions(const std::vector<webos::MentionRecord> &mentions,
+                                            TdAccountData &account)
 {
+    std::vector<int64_t> userIds;
+    for (const webos::MentionRecord &mention: mentions) {
+        // The way send_im finds whom a message is for
+        std::vector<const td::td_api::user *> users = getUsersByPurpleName(mention.id.c_str(), account, "mention");
+        userIds.push_back((users.size() == 1) ? users[0]->id_ : 0);
+    }
+    return userIds;
+}
+
+// webOS: a text with the mentions in it, each a link to whom it names. Its "@<name>" stays as it
+// is, as the text a client shows.
+static td::td_api::object_ptr<td::td_api::formattedText>
+makeMentionedText(td::td_api::object_ptr<td::td_api::formattedText> formatted,
+                  const std::vector<webos::MentionRecord> &mentions, const std::vector<int64_t> &mentionUserIds)
+{
+    for (const webos::MentionSpan &span: webos::findMentionSpans(formatted->text_, mentions)) {
+        int64_t userId = mentionUserIds[span.record];
+        if (userId != 0)
+            formatted->entities_.push_back(td::td_api::make_object<td::td_api::textEntity>(
+                span.offset, span.length, td::td_api::make_object<td::td_api::textEntityTypeMentionName>(userId)
+            ));
+    }
+    return formatted;
+}

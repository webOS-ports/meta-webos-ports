+class WebosCommandTest: public CommTest {
+protected:
+    void SetUp() override;
+    void TearDown() override;
+    // Another plug-in's account, which the commands are given for too
+    PurpleAccount *otherAccount();
+    // Our own account, connected, as if it were another plug-in's
+    void setProtocol(const char *protocolId)
+    {
+        free(account->protocol_id);
+        account->protocol_id = strdup(protocolId);
+    }
+    PurpleAccount *m_otherAccount = nullptr;
+    // As loginWithOneContact, but with the contact offline, as webOS shows a user whose status
+    // TDLib gives as userStatusOffline
+    void login();
+    const int64_t     groupId             = 700;
+    const int64_t     groupChatId         = 7000;
+    const std::string groupChatPurpleName = "chat" + std::to_string(groupChatId);
+    // A group we are in, made known after login
+    void addBasicGroup();
+    void addSupergroup();
+    std::string serviceMessageId(int64_t chatId, int64_t messageId)
+    {
+        return std::to_string(chatId) + ":" + std::to_string(messageId);
+    }
+};
+
+void WebosCommandTest::SetUp()
+{
+    CommTest::SetUp();
+    // What these tests check is done for the Messaging app only
+    setUiName("Palm Messaging");
+    // The commands are for every account, and the plug-in takes only its own
+    account->protocol_id = strdup(config::pluginId);
+}
+
+void WebosCommandTest::TearDown()
+{
+    CommTest::TearDown();
+    if (m_otherAccount)
+        purple_account_destroy(m_otherAccount);
+    m_otherAccount = nullptr;
+}
+
+PurpleAccount *WebosCommandTest::otherAccount()
+{

+TEST(WebosSendTest, ServiceMessageId)
+{
+    int64_t chatId = 1, messageId = 2;
+    ASSERT_TRUE(webos::parseServiceMessageId("1000:42", chatId, messageId));
+    ASSERT_EQ(1000, chatId);
+    ASSERT_EQ(42, messageId);
+    ASSERT_TRUE(webos::parseServiceMessageId("-1001234567890:1048576", chatId, messageId));
+    ASSERT_EQ(-1001234567890, chatId);
+    ASSERT_EQ(1048576, messageId);
+
+    chatId = 7; messageId = 8;
+    for (const char *bad: {"", ":", "1000", "1000:", ":42", "1000:42x", "1000:4 2", " 1000:42",
+                           "1000: 42", "+1000:42", "0:42", "1000:0", "a:b",
+                           "99999999999999999999:1"})
+    {
+        ASSERT_FALSE(webos::parseServiceMessageId(bad, chatId, messageId)) << bad;
+        ASSERT_EQ(7, chatId);
+        ASSERT_EQ(8, messageId);
+    }
+    ASSERT_FALSE(webos::parseServiceMessageId(nullptr, chatId, messageId));
+}

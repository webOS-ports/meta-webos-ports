+
+    // One by buddy name, one by display name, one no one known; HTML as send_im has it
+    std::string mentions = purpleUserName(0) + "\x1f" "Gottfried\x1e" +
+                           userFirstNames[1] + " " + userLastNames[1] + "\x1f" "Galileo\x1e"
+                           "id999\x1f" "Nobody";

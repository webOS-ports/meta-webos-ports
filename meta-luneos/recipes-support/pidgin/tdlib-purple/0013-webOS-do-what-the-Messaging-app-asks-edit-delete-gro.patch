+TEST(WebosSendTest, VCard)
+{
+    webos::SendContact contact;
+    // As the app writes one
+    ASSERT_TRUE(webos::parseVCardContact("BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Ada Lovelace\r\n"
+                                         "N:Lovelace;Ada;;;\r\nTEL;TYPE=CELL:+44 20 7946 0000\r\n"
+                                         "TEL;TYPE=HOME:+44 20 7946 0001\r\nEND:VCARD\r\n", contact));
+    ASSERT_EQ("+44 20 7946 0000", contact.phoneNumber);
+    ASSERT_EQ("Ada", contact.firstName);
+    ASSERT_EQ("Lovelace", contact.lastName);
+
+    // FN alone, folded lines, a group, lower case, LF only, escapes
+    ASSERT_TRUE(webos::parseVCardContact("BEGIN:VCARD\nVERSION:3.0\nfn:Smith\\, John\n  Jr.\n"
+                                         "item1.tel;type=\"cell,voice\":555\n 0100\nEND:VCARD", contact));
+    ASSERT_EQ("5550100", contact.phoneNumber);
+    ASSERT_EQ("Smith, John Jr.", contact.firstName);
+    ASSERT_EQ("", contact.lastName);
+
+    // vCard 4.0 URI; a family name only; an escaped semicolon in N
+    ASSERT_TRUE(webos::parseVCardContact("BEGIN:VCARD\r\nVERSION:4.0\r\nN:Ng\\;Wu;;;;\r\n"
+                                         "TEL;VALUE=uri;TYPE=cell:tel:+1-555-0100;ext=12\r\nEND:VCARD", contact));
+    ASSERT_EQ("+1-555-0100", contact.phoneNumber);
+    ASSERT_EQ("Ng;Wu", contact.firstName);
+    ASSERT_EQ("", contact.lastName);
+
+    // A number and no name at all
+    ASSERT_TRUE(webos::parseVCardContact("BEGIN:VCARD\nTEL:112\nEND:VCARD", contact));
+    ASSERT_EQ("112", contact.phoneNumber);
+    ASSERT_EQ("", contact.firstName);
+
+    // No number: unchanged
+    contact.phoneNumber = "kept";
+    for (const char *bad: {"", "BEGIN:VCARD\r\nFN:Ada\r\nEND:VCARD", "BEGIN:VCARD\r\nTEL:\r\nEND:VCARD",
+                           "BEGIN:VCARD\r\nTEL;TYPE=CELL\r\nEND:VCARD", "TELEPHONE:555", "not a card"})
+    {
+        ASSERT_FALSE(webos::parseVCardContact(bad, contact)) << bad;
+        ASSERT_EQ("kept", contact.phoneNumber);
+    }
+}

+bool getEditedText(const char *message, std::string &text, TdAccountData &account)
+{
+    std::vector<MessagePart> parts;
+    parseMessage(message, parts, account);
+    if ((parts.size() != 1) || parts[0].isImage || parts[0].text.empty())
+        return false;
+    text = std::move(parts[0].text);
+    return true;
+}

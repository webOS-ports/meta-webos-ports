+    tgl.verifyRequest(*makeSendMessage(chatIds[0], 0, nullptr, nullptr, nullptr,
+        make_object<inputMessageContact>(make_object<contact>("+0000-1", "Gottfried", "", knownCard, userIds[0]))
+    ));
+
+    // No number: the text
+    char noNumber[] = "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:Ada Lovelace\r\nEND:VCARD\r\n";
+    purple_conversation_set_data(conv, "webos-send-contact", noNumber);
+    ASSERT_EQ(0, pluginInfo().send_im(connection, purpleUserName(0).c_str(), "Ada Lovelace", PURPLE_MESSAGE_SEND));
+    tgl.verifyRequest(*makeSendMessage(chatIds[0], 0, nullptr, nullptr, nullptr, makeText("Ada Lovelace")));
+    purple_conversation_set_data(conv, "webos-send-contact", nullptr);
+}
+
+TEST(WebosSendTest, ParseMentions)
+{
+    auto mentions = webos::parseMentions("id100\x1fGottfried\x1e" "\x1fNobody\x1e" "id101\x1f\x1e" "\x1e"
+                                         "id102\x1fGalileo Galilei");
+    ASSERT_EQ(2u, mentions.size());
+    ASSERT_EQ("id100", mentions[0].id);
+    ASSERT_EQ("Gottfried", mentions[0].name);
+    ASSERT_EQ("id102", mentions[1].id);
+    ASSERT_EQ("Galileo Galilei", mentions[1].name);
+    ASSERT_TRUE(webos::parseMentions(nullptr).empty());
+    ASSERT_TRUE(webos::parseMentions("").empty());
+    ASSERT_TRUE(webos::parseMentions("id100").empty());
+}
+
+TEST(WebosSendTest, Utf16Length)
+{
+    ASSERT_EQ(0u, webos::utf16Length("", 0));
+    ASSERT_EQ(3u, webos::utf16Length("abc", 3));
+    // Two bytes, three bytes: one unit each; four bytes: a surrogate pair
+    ASSERT_EQ(2u, webos::utf16Length("Ж€", strlen("Ж€")));
+    ASSERT_EQ(2u, webos::utf16Length("😀", strlen("😀")));
+    ASSERT_EQ(5u, webos::utf16Length("a😀Ж€", strlen("a😀Ж€")));
+}
+
+static std::vector<std::string> spansOf(const std::string &text, const std::vector<webos::MentionRecord> &mentions)
+{
+    std::vector<std::string> result;
+    for (const webos::MentionSpan &span: webos::findMentionSpans(text, mentions))
+        result.push_back(std::to_string(span.record) + "@" + std::to_string(span.offset) + "+" +
+                         std::to_string(span.length));
+    return result;
+}
+
+TEST(WebosSendTest, MentionSpans)
+{
+    using Spans = std::vector<std::string>;
+    std::vector<webos::MentionRecord> one = {{"id100", "Gottfried"}};
+    ASSERT_EQ(Spans({"0@0+10"}), spansOf("@Gottfried, look", one));
+    ASSERT_EQ(Spans({"0@4+10"}), spansOf("Hi, @Gottfried", one));
+    // Counted in UTF-16: an emoji is two, Cyrillic one, before the mention and in it
+    ASSERT_EQ(Spans({"0@3+10"}), spansOf("😀 @Gottfried", one));
+    ASSERT_EQ(Spans({"0@7+10"}), spansOf("Привет @Gottfried", one));
+    std::vector<webos::MentionRecord> wide = {{"id100", "Готфрид 😀"}};
+    ASSERT_EQ(Spans({"0@2+11"}), spansOf("😀@Готфрид 😀!", wide));
+    // Not there
+    ASSERT_EQ(Spans(), spansOf("Gottfried", one));
+    ASSERT_EQ(Spans(), spansOf("", one));
+
+    // Two, given in the order of the text or not: in the order of the text, each found once
+    std::vector<webos::MentionRecord> two = {{"id100", "Gottfried"}, {"id101", "Galileo"}};
+    ASSERT_EQ(Spans({"0@0+10", "1@15+8"}), spansOf("@Gottfried and @Galileo", two));
+    ASSERT_EQ(Spans({"1@0+8", "0@13+10"}), spansOf("@Galileo and @Gottfried", two));
+
+    // The same name twice, each its own occurrence
+    std::vector<webos::MentionRecord> twice = {{"id100", "Ann"}, {"id101", "Ann"}};
+    ASSERT_EQ(Spans({"0@0+4", "1@9+4"}), spansOf("@Ann and @Ann", twice));
+    // One occurrence for two of them: the first, and none for the other
+    ASSERT_EQ(Spans({"0@0+4"}), spansOf("@Ann", twice));
+
+    // "@Ann" in "@Anna" only where nothing better is there
+    std::vector<webos::MentionRecord> prefix = {{"id100", "Ann"}, {"id101", "Anna"}};
+    ASSERT_EQ(Spans({"1@0+5", "0@10+4"}), spansOf("@Anna and @Ann", prefix));
+    ASSERT_EQ(Spans({"0@0+4"}), spansOf("@Anna", {{"id100", "Ann"}}));
+    ASSERT_EQ(Spans({"0@7+4"}), spansOf("@Ann_x @Ann", {{"id100", "Ann"}}));
+    ASSERT_EQ(Spans({"0@0+4"}), spansOf("@Ann, @Anna", {{"id100", "Ann"}}));
+}
+
+static object_ptr<textEntity> mentionOf(int32_t offset, int32_t length, int64_t userId)
+{
+    return make_object<textEntity>(offset, length, make_object<textEntityTypeMentionName>(userId));
+}
+
+TEST_F(WebosCommandTest, SendMentions)
+{

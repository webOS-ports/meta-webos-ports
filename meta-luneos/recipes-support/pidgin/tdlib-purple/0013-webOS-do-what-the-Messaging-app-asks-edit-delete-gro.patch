+// The webOS message commands (edit, delete, group create/invite/leave) come as gboolean signals
+// that imlibpurpleservice emits for EVERY account, and the first handler to return TRUE takes the
+// command. The client of a Telegram account that is connected, or NULL.
+static PurpleTdClient *getWebosCommandClient(PurpleAccount *account)
+{
+    if (!account || (g_strcmp0(purple_account_get_protocol_id(account), config::pluginId) != 0))
+        return nullptr;
+    return getTdClient(account);
+}
+
+// webOS: edit a sent message. serviceMessageId is "<chatId>:<messageId>", as given to the message
+// when it was shown; text is in the form send_im gets a message in.
+static gboolean tgprpl_send_edit_cb(PurpleAccount *account, const char *chat, const char *serviceMessageId,
+                                    const char *text, void * /*data*/)
+{
+    PurpleTdClient *tdClient = getWebosCommandClient(account);
+    if (!tdClient)
+        return FALSE;
+    int64_t chatId, messageId;
+    if (!webos::parseServiceMessageId(serviceMessageId, chatId, messageId)) {
+        purple_debug_warning(config::pluginId, "Cannot edit message '%s' in %s: not a message id\n",
+                             serviceMessageId ? serviceMessageId : "", chat ? chat : "");
+        return FALSE;
+    }
+    return tdClient->editMessage(chatId, messageId, text) ? TRUE : FALSE;
+}
+
+// webOS: delete a message for everyone, by its serviceMessageId
+static gboolean tgprpl_send_delete_cb(PurpleAccount *account, const char *chat, const char *serviceMessageId,
+                                      void * /*data*/)
+{
+    PurpleTdClient *tdClient = getWebosCommandClient(account);
+    if (!tdClient)
+        return FALSE;
+    int64_t chatId, messageId;
+    if (!webos::parseServiceMessageId(serviceMessageId, chatId, messageId)) {
+        purple_debug_warning(config::pluginId, "Cannot delete message '%s' in %s: not a message id\n",
+                             serviceMessageId ? serviceMessageId : "", chat ? chat : "");
+        return FALSE;
+    }
+    return tdClient->deleteMessage(chatId, messageId) ? TRUE : FALSE;
+}
+
+// webOS: create a basic group with these members, "\x1f"-joined buddy names
+static gboolean tgprpl_group_create_cb(PurpleAccount *account, const char *name, const char *membersJoined,
+                                       void * /*data*/)
+{
+    PurpleTdClient *tdClient = getWebosCommandClient(account);
+    if (!tdClient)
+        return FALSE;
+    return tdClient->createGroupWithMembers(name, webos::splitMembers(membersJoined)) ? TRUE : FALSE;
+}
+
+// webOS: add these members, "\x1f"-joined buddy names, to the group chat of this purple name
+static gboolean tgprpl_group_invite_cb(PurpleAccount *account, const char *chat, const char *membersJoined,
+                                       void * /*data*/)
+{
+    PurpleTdClient *tdClient = getWebosCommandClient(account);
+    if (!tdClient)
+        return FALSE;
+    return tdClient->inviteToGroup(chat, webos::splitMembers(membersJoined)) ? TRUE : FALSE;
+}
+
+// webOS: take these members, "\x1f"-joined buddy names, out of the group chat of this purple name
+static gboolean tgprpl_group_remove_cb(PurpleAccount *account, const char *chat, const char *membersJoined,
+                                       void * /*data*/)

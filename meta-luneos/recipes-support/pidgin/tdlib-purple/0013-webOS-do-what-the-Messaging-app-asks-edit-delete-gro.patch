+++ b/webos-send.h
@@ -0,0 +1,83 @@
+#ifndef _WEBOS_SEND_H
+#define _WEBOS_SEND_H
+
+// What imlibpurpleservice, the webOS Messaging transport, hands the plug-in around an outgoing
+// message or a message command, taken apart. Nothing in here knows about TDLib or libpurple, so
+// that the unit tests can call it as it is.
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace webos {
+
+// Between the fields of a record, and between records
+constexpr char FieldSeparator  = '\x1f';
+constexpr char RecordSeparator = '\x1e';
+
+// A serviceMessageId, as the plug-in gives one to each message it shows: "<chatId>:<messageId>".
+// False unless both are there and neither is 0.
+bool parseServiceMessageId(const char *serviceMessageId, int64_t &chatId, int64_t &messageId);
+
+// The members of a group command, as the transport joins them with FieldSeparator: each one's
+// buddy name, in order, without empty ones
+std::vector<std::string> splitMembers(const char *membersJoined);
+
+// What imlibpurpleservice puts with an outgoing message as conversation data, copied in send_im or
+// chat_send: the transport frees it as soon as they return. Empty where not given.
+struct OutgoingExtras {
+    std::string location;  // "webos-send-location"
+    std::string contact;   // "webos-send-contact"
+    std::string mentions;  // "webos-send-mentions"
+};
+
+// "webos-send-location": "<latitude>\x1f<longitude>\x1f<name>", in degrees, the name optional (the
+// field and its separator may both be missing). False unless both numbers are whole, finite and
+// within range.
+struct SendLocation {
+    double      latitude  = 0;
+    double      longitude = 0;
+    std::string name;
+};
+bool parseSendLocation(const char *location, SendLocation &result);
+
+// "webos-send-contact": a vCard (3.0, as the app writes it; 2.1 and 4.0 read alike as far as this
+// goes), of which the first TEL is the number, and N, else FN, the name. Lines may be folded, and
+// properties grouped ("item1.TEL"). False unless there is a number. The first name is never empty
+// where there is any name: TDLib's contact has the first name to show.
+struct SendContact {
+    std::string phoneNumber;
+    std::string firstName;
+    std::string lastName;
+};
+bool parseVCardContact(const std::string &vcard, SendContact &result);
+
+// A phone number as TDLib writes a user's: its digits alone, without the spaces, dashes, brackets
+// or leading "+" a card may have. Empty if there are no digits.
+std::string phoneDigits(const std::string &phoneNumber);
+
+// "webos-send-mentions": records "<id>\x1f<name>" joined by "\x1e", the id being the buddy name of
+// whom the text names as "@<name>". Records without both are left out.
+struct MentionRecord {
+    std::string id;
+    std::string name;
+};
+std::vector<MentionRecord> parseMentions(const char *mentionsJoined);
+
+// Where in a text each mention's "@<name>" is, in UTF-16 code units as TDLib's text entities count:
+// one span for each record found, in the order of the text, none overlapping another. A mention is
+// looked for after the one before it first, then anywhere; one followed by a letter, digit or '_'
+// ("@Ann" in "@Anna") only where there is no other.
+struct MentionSpan {
+    size_t  record; // index into the records
+    int32_t offset;
+    int32_t length;
+};
+std::vector<MentionSpan> findMentionSpans(const std::string &text, const std::vector<MentionRecord> &mentions);
+
+// The length in UTF-16 code units of so many bytes of UTF-8
+size_t utf16Length(const char *utf8, size_t bytes);
+
+} // namespace webos

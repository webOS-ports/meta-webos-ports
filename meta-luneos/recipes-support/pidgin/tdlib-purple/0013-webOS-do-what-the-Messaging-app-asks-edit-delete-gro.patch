+TEST(WebosSendTest, Location)
+{
+    webos::SendLocation location;
+    ASSERT_TRUE(webos::parseSendLocation("50.4501000\x1f" "30.5234000\x1f" "Maidan", location));
+    ASSERT_EQ(50.4501, location.latitude);
+    ASSERT_EQ(30.5234, location.longitude);
+    ASSERT_EQ("Maidan", location.name);
+
+    // No name, as an empty field or none; a name may hold anything else
+    ASSERT_TRUE(webos::parseSendLocation("-33.8567844\x1f" "151.2152967\x1f", location));
+    ASSERT_EQ(-33.8567844, location.latitude);
+    ASSERT_EQ(151.2152967, location.longitude);
+    ASSERT_EQ("", location.name);
+    ASSERT_TRUE(webos::parseSendLocation("90\x1f-180", location));
+    ASSERT_EQ(90, location.latitude);
+    ASSERT_EQ(-180, location.longitude);
+    ASSERT_EQ("", location.name);
+    ASSERT_TRUE(webos::parseSendLocation("0\x1f" "0\x1f" "Null Island \x1f 📍", location));
+    ASSERT_EQ("Null Island \x1f 📍", location.name);
+
+    // Unchanged on failure
+    location.latitude = 1; location.longitude = 2; location.name = "kept";
+    for (const char *bad: {"", "\x1f", "50.45", "50.45\x1f", "\x1f" "30.52", "50,45\x1f" "30,52",
+                           "50.45x\x1f" "30.52", " 50.45\x1f" "30.52", "50.45\x1f 30.52", "90.1\x1f" "0",
+                           "-90.1\x1f" "0", "0\x1f" "180.5", "nan\x1f" "0", "0\x1f" "inf", "1e999\x1f" "0"})
+    {
+        ASSERT_FALSE(webos::parseSendLocation(bad, location)) << bad;
+        ASSERT_EQ(1, location.latitude);
+        ASSERT_EQ(2, location.longitude);
+        ASSERT_EQ("kept", location.name);
+    }
+    ASSERT_FALSE(webos::parseSendLocation(nullptr, location));
+}
+
+// The app's plain form of a location, which goes if the plug-in cannot send the place itself
+static const char *LocationText = "📍 Maidan https://maps.google.com/?q=50.4501,30.5234";
+
+TEST_F(WebosCommandTest, SendLocation)
+{
+    login();
+    PurpleConversation *conv = purple_conversation_new(PURPLE_CONV_TYPE_IM, account, purpleUserName(0).c_str());
+    prpl.discardEvents();
+
+    // Named: a venue
+    char venueData[] = "50.4501000\x1f" "30.5234000\x1f" "Maidan";
+    purple_conversation_set_data(conv, "webos-send-location", venueData);
+    ASSERT_EQ(0, pluginInfo().send_im(connection, purpleUserName(0).c_str(), LocationText, PURPLE_MESSAGE_SEND));
+    tgl.verifyRequest(*makeSendMessage(chatIds[0], 0, nullptr, nullptr, nullptr,
+        make_object<inputMessageVenue>(make_object<venue>(
+            make_object<location>(50.4501, 30.5234, 0), "Maidan", "", "", "", ""
+        ))
+    ));
+    // Read, not taken: the transport frees it
+    ASSERT_EQ(static_cast<gpointer>(venueData), purple_conversation_get_data(conv, "webos-send-location"));
+
+    // Not named: a location
+    char locationData[] = "50.4501000\x1f" "30.5234000\x1f";
+    purple_conversation_set_data(conv, "webos-send-location", locationData);
+    ASSERT_EQ(0, pluginInfo().send_im(connection, purpleUserName(0).c_str(), LocationText, PURPLE_MESSAGE_SEND));
+    tgl.verifyRequest(*makeSendMessage(chatIds[0], 0, nullptr, nullptr, nullptr,
+        make_object<inputMessageLocation>(make_object<location>(50.4501, 30.5234, 0))
+    ));
+
+    // Not a location: the text
+    char badData[] = "north\x1fwest\x1f";
+    purple_conversation_set_data(conv, "webos-send-location", badData);
+    ASSERT_EQ(0, pluginInfo().send_im(connection, purpleUserName(0).c_str(), LocationText, PURPLE_MESSAGE_SEND));
+    tgl.verifyRequest(*makeSendMessage(chatIds[0], 0, nullptr, nullptr, nullptr, makeText(LocationText)));
+    ASSERT_EQ(static_cast<gpointer>(badData), purple_conversation_get_data(conv, "webos-send-location"));
+
+    // Gone again: the text
+    purple_conversation_set_data(conv, "webos-send-location", nullptr);
+    ASSERT_EQ(0, pluginInfo().send_im(connection, purpleUserName(0).c_str(), LocationText, PURPLE_MESSAGE_SEND));
+    tgl.verifyRequest(*makeSendMessage(chatIds[0], 0, nullptr, nullptr, nullptr, makeText(LocationText)));
+}

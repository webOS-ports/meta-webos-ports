+// webOS: a reply_to for a message, or null
+static td::td_api::object_ptr<td::td_api::InputMessageReplyTo> makeReplyTo(int64_t replyToMsgId)
+{
+    if (replyToMsgId == 0)
+        return nullptr;
+    // Built by field name: TDLib keeps adding fields to inputMessageReplyToMessage
+    auto replyTo = td::td_api::make_object<td::td_api::inputMessageReplyToMessage>();
+    replyTo->message_id_ = replyToMsgId;
+    return replyTo;
+}
+
+// webOS: what the message is in place of its text, if the transport gave one we can send; else
+// null, and the text, which the app writes so it stands for the rest, goes as it would
+static td::td_api::object_ptr<td::td_api::InputMessageContent>
+makeNativeContent(const webos::OutgoingExtras &extras, const TdAccountData &account)
+{
+    if (!extras.location.empty()) {
+        webos::SendLocation location;
+        if (webos::parseSendLocation(extras.location.c_str(), location)) {
+            auto point = td::td_api::make_object<td::td_api::location>();
+            point->latitude_  = location.latitude;
+            point->longitude_ = location.longitude;
+            if (location.name.empty()) {
+                auto content = td::td_api::make_object<td::td_api::inputMessageLocation>();
+                content->location_ = std::move(point);
+                return content;
+            }
+            // A named place: a venue, the name as its title and no address, provider or id
+            auto venue = td::td_api::make_object<td::td_api::venue>();
+            venue->location_ = std::move(point);
+            venue->title_    = location.name;
+            auto content = td::td_api::make_object<td::td_api::inputMessageVenue>();
+            content->venue_ = std::move(venue);
+            return content;
+        }
+        purple_debug_warning(config::pluginId, "Sending the text: not a location: '%s'\n",
+                             extras.location.c_str());
+    }
+
+    if (!extras.contact.empty()) {
+        webos::SendContact contact;
+        if (webos::parseVCardContact(extras.contact, contact)) {
+            auto card = td::td_api::make_object<td::td_api::contact>();
+            card->phone_number_ = contact.phoneNumber;
+            card->first_name_   = contact.firstName;
+            card->last_name_    = contact.lastName;
+            // All of the card goes, for a client that shows more of it
+            card->vcard_        = extras.contact;
+            // Someone on Telegram by this number can be written to from the card. Looked up only
+            // with digits, as a user whose number is not known has an empty one.
+            std::string             digits = webos::phoneDigits(contact.phoneNumber);
+            const td::td_api::user *user   = digits.empty() ? nullptr : account.getUserByPhone(digits.c_str());
+            card->user_id_      = user ? user->id_ : 0;
+            auto content = td::td_api::make_object<td::td_api::inputMessageContact>();
+            content->contact_ = std::move(card);
+            return content;
+        }
+        // Not logged: a contact card is personal
+        purple_debug_warning(config::pluginId, "Sending the text: a contact card without a phone number\n");
+    }
+    return nullptr;
+}

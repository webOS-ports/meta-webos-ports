+// The chat a webOS message command names by its TDLib id, or NULL if it is not known
+const td::td_api::chat *PurpleTdClient::getCommandChat(int64_t tdlibChatId, const char *command)
+{
+    const td::td_api::chat *chat = m_data.getChat(ChatId::fromString(std::to_string(tdlibChatId).c_str()));
+    if (!chat)
+        purple_debug_warning(config::pluginId, "Cannot %s: no chat %" G_GINT64_FORMAT "\n", command,
+                             tdlibChatId);
+    return chat;
+}
+
+bool PurpleTdClient::editMessage(int64_t tdlibChatId, int64_t messageId, const char *message)
+{
+    const td::td_api::chat *chat = getCommandChat(tdlibChatId, "edit message");
+    if (!chat)
+        return false;
+    ChatId      chatId = getId(*chat);
+    std::string text;
+    if (!getEditedText(message, text, m_data)) {
+        purple_debug_warning(config::pluginId, "Cannot edit message %" G_GINT64_FORMAT
+                             ": the new text is not one plain message\n", messageId);
+        return false;
+    }
+
+    // Built by field name, as TDLib keeps adding fields
+    auto content = td::td_api::make_object<td::td_api::inputMessageText>();
+    content->text_ = td::td_api::make_object<td::td_api::formattedText>();
+    content->text_->text_ = std::move(text);
+    auto request = td::td_api::make_object<td::td_api::editMessageText>();
+    request->chat_id_               = chatId.value();
+    request->message_id_            = messageId;
+    request->input_message_content_ = std::move(content);
+    // The edited message comes back as an updateMessageContent, which shows it
+    m_transceiver.sendQuery(std::move(request), [this, chatId](uint64_t, TdObjectPtr object) {
+        // TRANSLATOR: In-chat error message, argument will be a reason (text)
+        commandResponse(chatId, _("Failed to edit message: {}"), std::move(object));
+    });
+    return true;
+}
+
+bool PurpleTdClient::deleteMessage(int64_t tdlibChatId, int64_t messageId)
+{
+    const td::td_api::chat *chat = getCommandChat(tdlibChatId, "delete message");
+    if (!chat)
+        return false;
+    ChatId chatId = getId(*chat);
+
+    // revoke: for everyone. TDLib checks that a message can be deleted for the others only for
+    // bots; for us it deletes the message here and hands the request on to Telegram.
+    auto request = td::td_api::make_object<td::td_api::deleteMessages>();
+    request->chat_id_ = tdlibChatId;
+    request->message_ids_.push_back(messageId);
+    request->revoke_ = true;
+    // The deletion comes back as updateDeleteMessages, which the plug-in already shows
+    m_transceiver.sendQuery(std::move(request), [this, chatId](uint64_t, TdObjectPtr object) {
+        // TRANSLATOR: In-chat error message, argument will be a reason (text)
+        commandResponse(chatId, _("Failed to delete message: {}"), std::move(object));
+    });
+    return true;
+}
+
+bool PurpleTdClient::getCommandUsers(const std::vector<std::string> &memberNames, const char *command,
+                                     std::vector<int64_t> &userIds)
+{
+    userIds.clear();
+    for (const std::string &name: memberNames) {
+        // The way send_im finds whom a message is for; this logs why it found none or many
+        std::vector<const td::td_api::user *> users = getUsersByPurpleName(name.c_str(), m_data, command);
+        if (users.size() != 1)
+            return false;
+        if (std::find(userIds.begin(), userIds.end(), users[0]->id_) == userIds.end())
+            userIds.push_back(users[0]->id_);
+    }
+    return true;
+}
+
+void PurpleTdClient::showFailedToAddMembers(int64_t tdlibChatId, const td::td_api::failedToAddMembers &failed)
+{
+    std::string names;
+    for (const auto &member: failed.failed_to_add_members_) {
+        if (!member)
+            continue;
+        const td::td_api::user *user = m_data.getUser(UserId::fromString(std::to_string(member->user_id_).c_str()));
+        if (!names.empty())
+            names += ", ";
+        names += user ? m_data.getDisplayName(*user) : std::to_string(member->user_id_);
+    }
+    if (names.empty())
+        return;
+    // TRANSLATOR: In-chat error message, argument is a list of names
+    std::string message = formatMessage(_("Could not add to the group: {}"), names);
+    purple_debug_warning(config::pluginId, "%s\n", message.c_str());
+    const td::td_api::chat *chat = m_data.getChat(ChatId::fromString(std::to_string(tdlibChatId).c_str()));
+    if (chat)
+        showChatNotification(m_data, *chat, message.c_str());
+}
+
+bool PurpleTdClient::createGroupWithMembers(const char *title, const std::vector<std::string> &memberNames)
+{
+    if (!title || !*title || memberNames.empty()) {
+        purple_debug_warning(config::pluginId, "Cannot create group: no %s\n",
+                             memberNames.empty() ? "members" : "name");
+        return false;
+    }
+    auto request = td::td_api::make_object<td::td_api::createNewBasicGroupChat>();
+    if (!getCommandUsers(memberNames, "add to new group", request->user_ids_))
+        return false;
+    request->title_ = title;
+
+    // The new chat comes as updateNewChat and its first message, "created the group", which give
+    // it a conversation as any group chat gets one
+    std::string groupTitle = title;
+    m_transceiver.sendQuery(std::move(request), [this, groupTitle](uint64_t, TdObjectPtr object) {
+        if (object && (object->get_id() == td::td_api::createdBasicGroupChat::ID)) {
+            auto &created = static_cast<const td::td_api::createdBasicGroupChat &>(*object);
+            if (created.failed_to_add_members_)
+                showFailedToAddMembers(created.chat_id_, *created.failed_to_add_members_);
+        } else {
+            std::string message = getDisplayedError(object);
+            purple_debug_warning(config::pluginId, "Failed to create group %s: %s\n", groupTitle.c_str(),
+                                 message.c_str());
+            purple_notify_error(purple_account_get_connection(m_account),
+                                // TRANSLATOR: Error dialog, title
+                                _("Failed to create group"), groupTitle.c_str(), message.c_str());
+        }
+    });
+    return true;
+}
+
+const td::td_api::chat *PurpleTdClient::getCommandGroup(const char *purpleChatName, const char *command)
+{
+    ChatId                  chatId = getTdlibChatId(purpleChatName ? purpleChatName : "");
+    const td::td_api::chat *chat   = chatId.valid() ? m_data.getChat(chatId) : nullptr;
+    if (!chat || !m_data.isGroupChatWithMembership(*chat)) {
+        purple_debug_warning(config::pluginId, "Cannot %s: %s is not a group we are a member of\n", command,
+                             purpleChatName ? purpleChatName : "");
+        return nullptr;
+    }
+    return chat;
+}
+
+void PurpleTdClient::addMembersResponse(ChatId chatId, TdObjectPtr object)
+{
+    if (object && (object->get_id() == td::td_api::failedToAddMembers::ID))
+        showFailedToAddMembers(chatId.value(), static_cast<const td::td_api::failedToAddMembers &>(*object));
+    else
+        // TRANSLATOR: In-chat error message, argument is a reason (text)
+        commandResponse(chatId, _("Cannot add user to group: {}"), std::move(object));
+}
+
+bool PurpleTdClient::inviteToGroup(const char *purpleChatName, const std::vector<std::string> &memberNames)
+{
+    const td::td_api::chat *chat = getCommandGroup(purpleChatName, "add to group");
+    if (!chat)
+        return false;
+    std::vector<int64_t> userIds;
+    if (memberNames.empty() || !getCommandUsers(memberNames, "add to group", userIds))
+        return false;
+    ChatId chatId = getId(*chat);
+
+    // TDLib's addChatMembers is for supergroups and channels only; a basic group takes one at a time
+    if (getSupergroupId(*chat).valid()) {
+        auto request = td::td_api::make_object<td::td_api::addChatMembers>();
+        request->chat_id_  = chatId.value();
+        request->user_ids_ = std::move(userIds);
+        m_transceiver.sendQuery(std::move(request), [this, chatId](uint64_t, TdObjectPtr object) {
+            addMembersResponse(chatId, std::move(object));
+        });
+    } else if (getBasicGroupId(*chat).valid()) {
+        for (int64_t userId: userIds) {
+            // As addUserToChat, which libpurple's invite goes to: none of the earlier messages
+            auto request = td::td_api::make_object<td::td_api::addChatMember>();
+            request->chat_id_       = chatId.value();
+            request->user_id_       = userId;
+            request->forward_limit_ = 0;
+            m_transceiver.sendQuery(std::move(request), [this, chatId](uint64_t, TdObjectPtr object) {
+                addMembersResponse(chatId, std::move(object));
+            });
+        }
+    } else
+        return false;
+    // Those added come as updates to the members, and messages of their joining
+    return true;
+}
+
+bool PurpleTdClient::removeFromGroup(const char *purpleChatName, const std::vector<std::string> &memberNames)
+{
+    const td::td_api::chat *chat = getCommandGroup(purpleChatName, "remove from group");
+    if (!chat || (!getBasicGroupId(*chat).valid() && !getSupergroupId(*chat).valid()))
+        return false;
+    ChatId chatId = getId(*chat);
+
+    // The members are named as the chat's member list names them: "id<n>" for a buddy, else the
+    // display name. Neither is logged, the user's id being enough to go on.
+    std::vector<int64_t> userIds;
+    for (size_t i = 0; i < memberNames.size(); i++) {
+        std::vector<const td::td_api::user *> users = getUsersByPurpleName(memberNames[i].c_str(), m_data, nullptr);
+        if (users.size() != 1) {
+            purple_debug_warning(config::pluginId,
+                                 "Cannot remove member %zu of %zu from chat %" G_GINT64_FORMAT ": %s\n",
+                                 i + 1, memberNames.size(), chatId.value(),
+                                 users.empty() ? "no such user" : "more than one user of that name");
+            continue;
+        }
+        int64_t userId = users[0]->id_;
+        // That would be leaving the group, which is a command of its own
+        if (userId == m_data.options.myUserId) {
+            purple_debug_warning(config::pluginId,
+                                 "Not removing ourselves from chat %" G_GINT64_FORMAT "\n", chatId.value());
+            continue;
+        }
+        if (std::find(userIds.begin(), userIds.end(), userId) == userIds.end())
+            userIds.push_back(userId);
+    }
+    if (userIds.empty())
+        return false;
+
+    // As kickUserFromChat: a member set to "left" is taken out of a basic group, and out of a
+    // supergroup by a ban lifted at once, so that they may be added again or come back by a link.
+    // banChatMember would keep them out of a supergroup, and delete all they wrote in it.
+    for (int64_t userId: userIds) {
+        auto request = td::td_api::make_object<td::td_api::setChatMemberStatus>();
+        request->chat_id_   = chatId.value();
+        request->member_id_ = td::td_api::make_object<td::td_api::messageSenderUser>(userId);
+        request->status_    = td::td_api::make_object<td::td_api::chatMemberStatusLeft>();
+        m_transceiver.sendQuery(std::move(request), [this, chatId, userId](uint64_t, TdObjectPtr object) {
+            if (object && (object->get_id() == td::td_api::ok::ID))
+                return;
+            purple_debug_warning(config::pluginId,
+                                 "Failed to remove user %" G_GINT64_FORMAT " from chat %" G_GINT64_FORMAT "\n",
+                                 userId, chatId.value());
+            // TRANSLATOR: In-chat error message, argument is a reason (text)
+            commandResponse(chatId, _("Cannot remove user from group: {}"), std::move(object));
+        });
+    }
+    // Those taken out come as updates to the members, and messages of their leaving
+    return true;
+}
+
+bool PurpleTdClient::leaveGroupChat(const char *purpleChatName)
+{
+    const td::td_api::chat *chat = getCommandGroup(purpleChatName, "leave group");
+    if (!chat)
+        return false;
+    ChatId chatId = getId(*chat);
+
+    // Unlike leaveGroup, behind libpurple's "leave", which deletes the history and takes the chat
+    // off the list too: the app keeps the thread, and the user deletes it there if they want to.
+    // Our leaving comes back as a change of our membership and a message of it.
+    m_transceiver.sendQuery(td::td_api::make_object<td::td_api::leaveChat>(chatId.value()),
+                            [this, chatId](uint64_t, TdObjectPtr object) {
+        // TRANSLATOR: In-chat error message, argument is a reason (text)
+        commandResponse(chatId, _("Failed to leave group: {}"), std::move(object));
+    });
+    return true;
+}

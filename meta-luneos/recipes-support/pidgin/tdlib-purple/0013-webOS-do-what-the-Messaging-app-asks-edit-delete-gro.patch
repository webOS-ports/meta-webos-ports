diff --git a/webos-send.cpp b/webos-send.cpp
new file mode 100644
index 0000000..fe5234f
--- /dev/null
+++ b/webos-send.cpp
@@ -0,0 +1,328 @@
+#include "webos-send.h"
+#include <glib.h>
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstring>
+
+namespace webos {
+
+// A whole decimal number, as TDLib's ids are written, and nothing else
+static bool parseId(const char *start, const char *end, int64_t &value)
+{
+    // g_ascii_strtoll would also take leading blanks and a '+'
+    if ((start == end) || !(g_ascii_isdigit(*start) || (*start == '-')))
+        return false;
+    std::string digits(start, end);
+    char       *past = nullptr;
+    errno = 0;
+    gint64 parsed = g_ascii_strtoll(digits.c_str(), &past, 10);
+    if ((errno != 0) || (past == digits.c_str()) || (*past != '\0') || (parsed == 0))
+        return false;
+    value = parsed;
+    return true;
+}
+
+bool parseServiceMessageId(const char *serviceMessageId, int64_t &chatId, int64_t &messageId)
+{
+    if (!serviceMessageId)
+        return false;
+    const char *colon = strchr(serviceMessageId, ':');
+    if (!colon)
+        return false;
+    int64_t chat, message;
+    if (!parseId(serviceMessageId, colon, chat) || !parseId(colon + 1, colon + strlen(colon), message))
+        return false;
+    chatId    = chat;
+    messageId = message;
+    return true;
+}
+
+std::vector<std::string> splitMembers(const char *membersJoined)
+{
+    std::vector<std::string> members;
+    if (!membersJoined)
+        return members;
+    const char *start = membersJoined;
+    while (true) {
+        const char *end = strchr(start, FieldSeparator);
+        size_t      len = end ? size_t(end - start) : strlen(start);
+        if (len != 0)
+            members.emplace_back(start, len);
+        if (!end)
+            break;
+        start = end + 1;
+    }
+    return members;
+}
+
+// A whole number in C's form, whatever the locale's decimal point
+static bool parseDegrees(const std::string &text, double limit, double &value)
+{
+    if (text.empty() || g_ascii_isspace(text[0]))
+        return false;
+    char *past = nullptr;
+    errno = 0;
+    double parsed = g_ascii_strtod(text.c_str(), &past);
+    if ((errno != 0) || (past == text.c_str()) || (*past != '\0') || !std::isfinite(parsed) ||
+        (parsed < -limit) || (parsed > limit))
+        return false;
+    value = parsed;
+    return true;
+}
+
+bool parseSendLocation(const char *location, SendLocation &result)
+{
+    if (!location)
+        return false;
+    const char *firstSep = strchr(location, FieldSeparator);
+    if (!firstSep)
+        return false;
+    const char *secondSep = strchr(firstSep + 1, FieldSeparator);
+    std::string latitude(location, firstSep);
+    std::string longitude = secondSep ? std::string(firstSep + 1, secondSep) : std::string(firstSep + 1);
+
+    SendLocation parsed;
+    if (!parseDegrees(latitude, 90, parsed.latitude) || !parseDegrees(longitude, 180, parsed.longitude))
+        return false;
+    if (secondSep)
+        parsed.name = secondSep + 1;
+    result = std::move(parsed);
+    return true;
+}
+
+// Lines of a vCard as they were before folding: a line that starts with a blank continues the one
+// before it, without the line break and that blank
+static std::vector<std::string> unfoldLines(const std::string &vcard)
+{
+    std::vector<std::string> lines;
+    size_t start = 0;
+    while (start < vcard.size()) {
+        size_t end = vcard.find('\n', start);
+        if (end == std::string::npos)
+            end = vcard.size();
+        std::string line = vcard.substr(start, end - start);
+        if (!line.empty() && (line.back() == '\r'))
+            line.pop_back();
+        if (!line.empty() && ((line[0] == ' ') || (line[0] == '\t')) && !lines.empty())
+            lines.back() += line.substr(1);
+        else
+            lines.push_back(std::move(line));
+        start = end + 1;
+    }
+    return lines;
+}
+
+static std::string trim(const std::string &s)
+{
+    size_t first = s.find_first_not_of(" \t");
+    if (first == std::string::npos)
+        return std::string();
+    size_t last = s.find_last_not_of(" \t");
+    return s.substr(first, last - first + 1);
+}
+
+// A text value without its backslash escapes; an escaped line break becomes a space, as a name or a
+// number has no use for one
+static std::string unescapeValue(const std::string &value)
+{
+    std::string result;
+    for (size_t i = 0; i < value.size(); i++) {
+        if ((value[i] == '\\') && (i + 1 < value.size())) {
+            char next = value[++i];
+            result += ((next == 'n') || (next == 'N')) ? ' ' : next;
+        } else
+            result += value[i];
+    }
+    return trim(result);
+}
+
+// A structured value split at the semicolons that are not escaped, each part unescaped
+static std::vector<std::string> splitStructured(const std::string &value)
+{
+    std::vector<std::string> parts(1);
+    for (size_t i = 0; i < value.size(); i++) {
+        if ((value[i] == '\\') && (i + 1 < value.size())) {
+            parts.back() += value[i];
+            parts.back() += value[++i];
+        } else if (value[i] == ';')
+            parts.emplace_back();
+        else
+            parts.back() += value[i];
+    }
+    for (std::string &part: parts)
+        part = unescapeValue(part);
+    return parts;
+}
+
+bool parseVCardContact(const std::string &vcard, SendContact &result)
+{
+    std::string phone, formattedName, givenName, familyName;
+    bool        haveN = false;
+
+    for (const std::string &line: unfoldLines(vcard)) {
+        // The name and parameters end at the first colon outside a quoted parameter value
+        size_t colon  = std::string::npos;
+        bool   quoted = false;
+        for (size_t i = 0; i < line.size(); i++) {
+            if (line[i] == '"')
+                quoted = !quoted;
+            else if ((line[i] == ':') && !quoted) {
+                colon = i;
+                break;
+            }
+        }
+        if (colon == std::string::npos)
+            continue;
+        std::string name  = line.substr(0, line.find(';') < colon ? line.find(';') : colon);
+        std::string value = line.substr(colon + 1);
+        size_t      dot   = name.rfind('.');
+        if (dot != std::string::npos)
+            name = name.substr(dot + 1);
+        for (char &c: name)
+            c = g_ascii_toupper(c);
+
+        if ((name == "TEL") && phone.empty()) {
+            // vCard 4.0 may give it as a URI, with parameters of its own after a semicolon
+            std::string number = value;
+            if (g_ascii_strncasecmp(number.c_str(), "tel:", 4) == 0)
+                number = number.substr(4, number.find(';') == std::string::npos ? std::string::npos
+                                                                                 : number.find(';') - 4);
+            phone = unescapeValue(number);
+        } else if ((name == "FN") && formattedName.empty())
+            formattedName = unescapeValue(value);
+        else if ((name == "N") && !haveN) {
+            // Family name; given name; additional names; prefixes; suffixes
+            std::vector<std::string> parts = splitStructured(value);
+            familyName = parts[0];
+            givenName  = (parts.size() > 1) ? parts[1] : std::string();
+            haveN      = true;
+        }
+    }
+
+    if (phone.empty())
+        return false;
+    SendContact contact;
+    contact.phoneNumber = phone;
+    if (!givenName.empty()) {
+        contact.firstName = givenName;
+        contact.lastName  = familyName;
+    } else if (!formattedName.empty())
+        // FN is the whole name as shown, given and family name together
+        contact.firstName = formattedName;
+    else
+        contact.firstName = familyName;
+    result = std::move(contact);
+    return true;
+}
+
+std::string phoneDigits(const std::string &phoneNumber)
+{
+    std::string digits;
+    for (char c: phoneNumber)
+        if (g_ascii_isdigit(c))
+            digits += c;
+    return digits;
+}
+
+std::vector<MentionRecord> parseMentions(const char *mentionsJoined)
+{
+    std::vector<MentionRecord> mentions;
+    if (!mentionsJoined)
+        return mentions;
+    const char *start = mentionsJoined;
+    while (true) {
+        const char *end = strchr(start, RecordSeparator);
+        std::string record = end ? std::string(start, end) : std::string(start);
+        size_t      sep    = record.find(FieldSeparator);
+        if ((sep != std::string::npos) && (sep != 0) && (sep + 1 < record.size())) {
+            MentionRecord mention;
+            mention.id   = record.substr(0, sep);
+            mention.name = record.substr(sep + 1);
+            mentions.push_back(std::move(mention));
+        }
+        if (!end)
+            break;
+        start = end + 1;
+    }
+    return mentions;
+}
+
+size_t utf16Length(const char *utf8, size_t bytes)
+{
+    size_t length = 0;
+    for (size_t i = 0; i < bytes; i++) {
+        unsigned char c = static_cast<unsigned char>(utf8[i]);
+        // A character starts at any byte but a continuation byte, and one of four bytes, outside
+        // the Basic Multilingual Plane, is a surrogate pair
+        if ((c & 0xC0) != 0x80)
+            length += (c >= 0xF0) ? 2 : 1;
+    }
+    return length;
+}
+
+namespace {
+struct ByteSpan {
+    size_t record;
+    size_t start;
+    size_t end;
+};
+}
+
+static bool endsAtWordEnd(const std::string &text, size_t end)
+{
+    if (end >= text.size())
+        return true;
+    char c = text[end];
+    return !(g_ascii_isalnum(c) || (c == '_'));
+}
+
+static bool overlaps(const std::vector<ByteSpan> &spans, size_t start, size_t end)
+{
+    return std::any_of(spans.begin(), spans.end(),
+                       [start, end](const ByteSpan &span) { return (start < span.end) && (span.start < end); });
+}
+
+// The first place from `from` on where the needle is, not overlapping a span found already, and,
+// if asked, ending where a word does
+static size_t findFree(const std::string &text, const std::string &needle, size_t from,
+                       const std::vector<ByteSpan> &spans, bool wordEnd)
+{
+    for (size_t pos = text.find(needle, from); pos != std::string::npos; pos = text.find(needle, pos + 1))
+        if (!overlaps(spans, pos, pos + needle.size()) && (!wordEnd || endsAtWordEnd(text, pos + needle.size())))
+            return pos;
+    return std::string::npos;
+}
+
+std::vector<MentionSpan> findMentionSpans(const std::string &text, const std::vector<MentionRecord> &mentions)
+{
+    std::vector<ByteSpan> spans;
+    size_t                cursor = 0;
+    for (size_t i = 0; i < mentions.size(); i++) {
+        if (mentions[i].name.empty())
+            continue;
+        std::string needle = "@" + mentions[i].name;
+        size_t pos = findFree(text, needle, cursor, spans, true);
+        if (pos == std::string::npos)
+            pos = findFree(text, needle, 0, spans, true);
+        if (pos == std::string::npos)
+            pos = findFree(text, needle, 0, spans, false);
+        if (pos == std::string::npos)
+            continue;
+        spans.push_back(ByteSpan{i, pos, pos + needle.size()});
+        cursor = pos + needle.size();
+    }
+
+    std::sort(spans.begin(), spans.end(), [](const ByteSpan &a, const ByteSpan &b) { return a.start < b.start; });
+    std::vector<MentionSpan> result;
+    for (const ByteSpan &span: spans) {
+        MentionSpan mention;
+        mention.record = span.record;
+        mention.offset = static_cast<int32_t>(utf16Length(text.data(), span.start));
+        mention.length = static_cast<int32_t>(utf16Length(text.data() + span.start, span.end - span.start));
+        result.push_back(mention);
+    }
+    return result;
+}
+
+} // namespace webos

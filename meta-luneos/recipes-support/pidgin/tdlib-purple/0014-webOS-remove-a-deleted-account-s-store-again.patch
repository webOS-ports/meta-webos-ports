From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 17 Nov 2026 19:44:31 +0100
Subject: [PATCH 14/14] webOS: remove a deleted account's store again

A deleted account's TDLib store, its session keys among them, was to be
removed when libpurple's "account-removed" fires. The hook was connected
as the plug-in loads, but purple_core_init loads protocol plug-ins before
purple_accounts_init registers the accounts' signals (core.c, 2.14.14):
the connection was refused ("Something tried to register a callback for
the 'account-removed' signal"), the hook never ran, and an account added
again with the same number was logged in on the old session without a
code being asked for.

It is now connected from an idle callback of high priority, which runs
once purple_core_init has returned and before the main loop does anything
else, a request to delete an account among it. The mock refuses the
signal until it is registered, as libpurple does, and a test sees the
hook connected all the same.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS specific]
---
 tdlib-purple.cpp             | 24 ++++++++++++++++++++++--
 test/libpurple-mock.cpp      | 16 +++++++++++++++-
 test/libpurple-mock.h        |  4 ++++
 test/webos-commands-test.cpp | 20 ++++++++++++++++++++
 4 files changed, 61 insertions(+), 3 deletions(-)

diff --git a/tdlib-purple.cpp b/tdlib-purple.cpp
index 4285399..64afdd1 100644
--- a/tdlib-purple.cpp
+++ b/tdlib-purple.cpp
@@ -1706,8 +1706,15 @@ static void unregisterMessageLinks()
     setViewedHandler(nullptr);
 }
 
+// The idle callback that is to connect the account-removed hook, while it has not run (see tgprpl_load)
+static guint s_accountRemovedSource = 0;
+
 static gboolean tgprpl_unload (PurplePlugin *plugin)
 {
+    if (s_accountRemovedSource) {
+        g_source_remove(s_accountRemovedSource);
+        s_accountRemovedSource = 0;
+    }
     unregisterMessageLinks();
     pidginUiUnload();
     return TRUE;
@@ -1787,6 +1794,16 @@ static void tgprpl_account_removed_cb(PurpleAccount *account, gpointer unused)
     removeDirRecursive(filesDir);
 }
 
+// Run before anything else the main loop has to do, a request to delete an account among it
+static gboolean connectAccountRemoved(gpointer plugin)
+{
+    s_accountRemovedSource = 0;
+    if (!purple_signal_connect(purple_accounts_get_handle(), "account-removed", plugin,
+                               PURPLE_CALLBACK(tgprpl_account_removed_cb), NULL))
+        purple_debug_error(config::pluginId, "account-removed: not connected, a removed account's store will be left\n");
+    return G_SOURCE_REMOVE;
+}
+
 static gboolean tgprpl_load (PurplePlugin *plugin)
 {
     if (!checkTdlibVersion())
@@ -1796,8 +1813,11 @@ static gboolean tgprpl_load (PurplePlugin *plugin)
 
     // Per-account store teardown: hook "account-removed" (emitted by purple_accounts_delete) so a
     // deleted Telegram account's tdlib DB + media cache are not orphaned. Handle is the plugin.
-    purple_signal_connect(purple_accounts_get_handle(), "account-removed", plugin,
-                          PURPLE_CALLBACK(tgprpl_account_removed_cb), NULL);
+    // Not here but once the main loop runs: purple_core_init loads protocol plug-ins before
+    // purple_accounts_init registers the accounts' signals, so a connection made now is refused
+    // and the store outlives its account.
+    if (!s_accountRemovedSource)
+        s_accountRemovedSource = g_idle_add_full(G_PRIORITY_HIGH, connectAccountRemoved, plugin, NULL);
 
     purple_cmd_register("kick", "s", PURPLE_CMD_P_PLUGIN,
                         (PurpleCmdFlag)(PURPLE_CMD_FLAG_CHAT | PURPLE_CMD_FLAG_PRPL_ONLY),
diff --git a/test/libpurple-mock.cpp b/test/libpurple-mock.cpp
index 3fcb2bc..e3204a9 100644
--- a/test/libpurple-mock.cpp
+++ b/test/libpurple-mock.cpp
@@ -1986,11 +1986,15 @@ gboolean purple_conversation_has_focus(PurpleConversation *conv)
 }
 
 static std::map<std::string, PurpleCallback> g_connectedSignals;
+static bool g_accountSignalsRegistered = true;
 
-// Kept, so that a test can call what the plug-in connected as the signal's emitter would
+// Kept, so that a test can call what the plug-in connected as the signal's emitter would. As in
+// libpurple, an account signal before purple_accounts_init has registered it is refused.
 gulong purple_signal_connect(void *instance, const char *signal,
 	void *handle, PurpleCallback func, void *data)
 {
+    if (!g_accountSignalsRegistered && !strcmp(signal, "account-removed"))
+        return 0;
     g_connectedSignals[signal] = func;
     return g_connectedSignals.size();
 }
@@ -2079,6 +2083,16 @@ void purple_conversation_set_name(PurpleConversation *conv, const char *name)
 
 };
 
+extern "C++" void forgetConnectedSignal(const char *signal)
+{
+    g_connectedSignals.erase(signal);
+}
+
+extern "C++" void setAccountSignalsRegistered(bool registered)
+{
+    g_accountSignalsRegistered = registered;
+}
+
 extern "C++" PurpleCallback getConnectedSignal(const char *signal)
 {
     auto it = g_connectedSignals.find(signal);
diff --git a/test/libpurple-mock.h b/test/libpurple-mock.h
index ae82aa8..f430ac9 100644
--- a/test/libpurple-mock.h
+++ b/test/libpurple-mock.h
@@ -35,6 +35,10 @@ void setPresenceIdle(bool idle);
 // What the plug-in connected to a signal, or NULL. Connections stay for the whole run, as the
 // plug-in makes some only once.
 PurpleCallback getConnectedSignal(const char *signal);
+void forgetConnectedSignal(const char *signal);
+// Whether purple_accounts_init has registered the accounts' signals, so that they can be connected
+// to; they are by default, but purple_core_init loads protocol plug-ins before
+void setAccountSignalsRegistered(bool registered);
 
 // The webOS signals the plug-in gives imlibpurpleservice that tests look at: "webos-im-edit"
 // (account, serviceMessageId, text) and "webos-im-delete" (account, serviceMessageId)
diff --git a/test/webos-commands-test.cpp b/test/webos-commands-test.cpp
index 8c1171b..54e5148 100644
--- a/test/webos-commands-test.cpp
+++ b/test/webos-commands-test.cpp
@@ -7,6 +7,7 @@
 #include "webos-receive.h"
 #include "purple-info.h"
 #include "sticker.h"
+#include "tdlib-purple.h"
 #include <cstring>
 
 // Who a notice in a group chat is from, as group-chat-test.cpp has it
@@ -2403,3 +2404,22 @@ TEST_F(WebosTapTest, OtherFrontEndAsked)
     // Nothing is stashed for the transport
     ASSERT_EQ("", takeStashedId(imConversation()));
 }
+
+// libpurple's purple_core_init loads protocol plug-ins before purple_accounts_init registers the
+// accounts' signals: the hook that removes a deleted account's store is connected once it can be
+class AccountRemovedTest: public CommTest {};
+
+TEST_F(AccountRemovedTest, HookConnectedOnceAccountSignalsAreRegistered)
+{
+    PurplePlugin plugin{};
+    purple_init_plugin(&plugin);
+    plugin.info->unload(&plugin);
+    forgetConnectedSignal("account-removed");
+    setAccountSignalsRegistered(false);
+    plugin.info->load(&plugin);
+    setAccountSignalsRegistered(true);
+    EXPECT_EQ(nullptr, getConnectedSignal("account-removed"));
+
+    while (g_main_context_iteration(NULL, FALSE)) {}
+    EXPECT_NE(nullptr, getConnectedSignal("account-removed"));
+}

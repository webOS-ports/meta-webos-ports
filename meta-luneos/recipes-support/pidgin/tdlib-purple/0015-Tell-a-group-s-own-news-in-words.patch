+
+// A group's own news is told in words, not as "Unsupported message type"
+TEST_F(WebosCommandTest, GroupEvents)
+{
+    login();
+    addBasicGroup();
+    const std::string who = userFirstNames[0] + " " + userLastNames[0];
+    const std::string self = selfFirstName + " " + selfLastName;
+    struct Case {
+        object_ptr<MessageContent> content;
+        std::string                notice;
+    };
+    std::vector<Case> cases;
+    cases.push_back({make_object<messageBasicGroupChatCreate>("Physics", std::vector<int64_t>({userIds[0], selfId})),
+                     who + " created Physics"});
+    cases.push_back({make_object<messageChatAddMembers>(std::vector<int64_t>({userIds[1], selfId})),
+                     who + " added Unknown user, " + self});
+    cases.push_back({make_object<messageChatAddMembers>(std::vector<int64_t>({userIds[0]})), who + " joined"});
+    cases.push_back({make_object<messageChatJoinByLink>(), who + " joined by an invite link"});
+    cases.push_back({make_object<messageChatJoinByRequest>(), who + " joined"});
+    cases.push_back({make_object<messageChatDeleteMember>(userIds[0]), who + " left"});
+    cases.push_back({make_object<messageChatDeleteMember>(selfId), who + " removed " + self});
+    cases.push_back({make_object<messagePinMessage>(3), who + " pinned a message"});
+
+    int64_t messageId = 100;
+    bool    joined    = false;
+    for (Case &c: cases) {
+        tgl.update(make_object<updateNewMessage>(makeMessage(messageId, userIds[0], groupChatId, false,
+                                                             10001, std::move(c.content))));
+        tgl.verifyRequest(viewMessages(groupChatId, {messageId}, nullptr, true));
+        if (!joined)
+            prpl.verifyEvents(ServGotJoinedChatEvent(connection, 2, groupChatPurpleName, "Physics"),
+                              ConversationWriteEvent(groupChatPurpleName, NotificationWho, c.notice,
+                                                     PURPLE_MESSAGE_SYSTEM, 10001));
+        else
+            prpl.verifyEvents(ConversationWriteEvent(groupChatPurpleName, NotificationWho, c.notice,
+                                                     PURPLE_MESSAGE_SYSTEM, 10001));
+        joined = true;
+        messageId++;
+    }
+}

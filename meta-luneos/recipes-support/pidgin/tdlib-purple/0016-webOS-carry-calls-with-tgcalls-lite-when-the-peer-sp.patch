+# tgcalls-lite (luneos-synergy-connectors, im/telegram/plugin/tgcalls-lite): calls with the tgcalls
+# V2 protocol current clients speak, next to libtgvoip. Its headers need C++17.
+set(tgcalls_lite_INCLUDE_DIRS "" CACHE STRING "tgcalls-lite headers; empty builds without it")
+set(tgcalls_lite_LIBRARIES "" CACHE STRING "tgcalls-lite library (libtgcalls-lite.a)")
+if (NOT NoVoip AND NOT tgcalls_lite_INCLUDE_DIRS STREQUAL "")
+    pkg_check_modules(tgcalls_lite_deps REQUIRED glib-2.0 nice libsrtp2 openssl json-glib-1.0 opus libpulse-simple)
+    target_compile_definitions(telegram-tdlib PRIVATE HAVE_TGCALLS_LITE)
+    target_include_directories(telegram-tdlib SYSTEM PRIVATE ${tgcalls_lite_INCLUDE_DIRS} ${tgcalls_lite_deps_INCLUDE_DIRS})
+    target_link_libraries(telegram-tdlib PRIVATE ${tgcalls_lite_LIBRARIES} ${tgcalls_lite_deps_LIBRARIES})
+    set_property(TARGET telegram-tdlib PROPERTY CXX_STANDARD 17)
+    message(STATUS "tgcalls-lite: enabled")
+endif ()
+
 if (DEFINED STANDARD_LIBRARIES_EXTRA)
     set (CMAKE_CXX_STANDARD_LIBRARIES "${CMAKE_CXX_STANDARD_LIBRARIES} ${STANDARD_LIBRARIES_EXTRA}")
 endif (DEFINED STANDARD_LIBRARIES_EXTRA)

diff --git a/tgcalls-call.cpp b/tgcalls-call.cpp
new file mode 100644
index 0000000..723ed50
--- /dev/null
+++ b/tgcalls-call.cpp
@@ -0,0 +1,175 @@
+#include "tgcalls-call.h"
+
+#ifdef HAVE_TGCALLS_LITE
+
+#include "call-luna.h"
+#include "config.h"
+#include "transceiver.h"
+
+#include <call_engine.h>
+
+#include <glib.h>
+#include <purple.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace {
+
+constexpr char kVersion[] = "7.0.0";
+constexpr size_t kKeySize = 256;
+constexpr guint kTickMs = 500;
+
+// One running call: the engine and the timer that drives its DTLS retransmissions.
+struct LiteCall {
+    std::unique_ptr<tgcalls_lite::CallEngine> engine;
+    guint tickSource = 0;
+
+    ~LiteCall()
+    {
+        if (tickSource)
+            g_source_remove(tickSource);
+    }
+};
+
+gboolean tick(gpointer data)
+{
+    static_cast<LiteCall *>(data)->engine->tick();
+    return G_SOURCE_CONTINUE;
+}
+
+LiteCall *liteCall(TdAccountData &account)
+{
+    return static_cast<LiteCall *>(account.getCallEngine());
+}
+
+void addServer(std::vector<tgcalls_lite::RtcServer> &list, const std::string &host, int32_t port,
+               const td::td_api::callServerTypeWebrtc &webrtc, bool turn)
+{
+    if (host.empty() || port <= 0 || port > 65535)
+        return;
+    tgcalls_lite::RtcServer server;
+    server.host = host;
+    server.port = (uint16_t)port;
+    server.isTurn = turn;
+    if (turn) {
+        server.login = webrtc.username_;
+        server.password = webrtc.password_;
+    }
+    list.push_back(std::move(server));
+}
+
+// STUN and TURN from callServerTypeWebrtc, both address families, as tdesktop's AppendServer()
+// does. Telegram reflectors (callServerTypeTelegramReflector) speak tgcalls' own ReflectorPort
+// protocol, which tgcalls-lite does not implement.
+std::vector<tgcalls_lite::RtcServer> rtcServers(const td::td_api::callStateReady &state)
+{
+    std::vector<tgcalls_lite::RtcServer> list;
+    for (const auto &server : state.servers_) {
+        if (!server || !server->type_ || server->type_->get_id() != td::td_api::callServerTypeWebrtc::ID)
+            continue;
+        const auto &webrtc = static_cast<const td::td_api::callServerTypeWebrtc &>(*server->type_);
+        if (webrtc.supports_stun_) {
+            addServer(list, server->ip_address_, server->port_, webrtc, false);
+            addServer(list, server->ipv6_address_, server->port_, webrtc, false);
+        }
+        if (webrtc.supports_turn_ && !webrtc.username_.empty() && !webrtc.password_.empty()) {
+            addServer(list, server->ip_address_, server->port_, webrtc, true);
+            addServer(list, server->ipv6_address_, server->port_, webrtc, true);
+        }
+    }
+    return list;
+}
+
+} // namespace
+
+const char *tgcallsLiteVersion()
+{
+    return kVersion;
+}
+
+bool tgcallsLiteEnabled()
+{
+    const char *engine = getenv("LUNEOS_TELEGRAM_CALL_ENGINE");
+    return !(engine && strcmp(engine, "tgvoip") == 0);
+}
+
+bool tgcallsLiteAgreed(const td::td_api::callStateReady &state)
+{
+    if (!state.protocol_)
+        return false;
+    for (const auto &version : state.protocol_->library_versions_)
+        if (version == kVersion)
+            return true;
+    return false;
+}
+
+bool tgcallsLiteStart(const td::td_api::call &call, const td::td_api::callStateReady &state,
+                      TdAccountData &account, TdTransceiver &transceiver)
+{
+    if (liteCall(account))
+        return true;
+    if (state.encryption_key_.size() != kKeySize) {
+        tgcLog("tgcalls-lite: encryption key is %zu bytes, not %zu", state.encryption_key_.size(), kKeySize);
+        return false;
+    }
+
+    auto lite = std::make_shared<LiteCall>();
+    // Voice only for now: there is no video source or sink wired to the engine yet.
+    lite->engine = std::make_unique<tgcalls_lite::CallEngine>(
+        g_main_context_default(), reinterpret_cast<const uint8_t *>(state.encryption_key_.data()),
+        call.is_outgoing_, false);
+    tgcalls_lite::CallEngine &engine = *lite->engine;
+
+    const auto servers = rtcServers(state);
+    const size_t applied = engine.setServers(servers);
+    tgcLog("tgcalls-lite: call %d, outgoing=%d, %zu of %zu STUN/TURN servers applied, p2p=%d",
+           (int)call.id_, (int)call.is_outgoing_, applied, servers.size(), (int)state.allow_p2p_);
+
+    const int32_t callId = call.id_;
+    engine.onOutgoingSignalingData = [callId, &transceiver](const std::vector<uint8_t> &data) {
+        auto request = td::td_api::make_object<td::td_api::sendCallSignalingData>();
+        request->call_id_ = callId;
+        request->data_.assign(reinterpret_cast<const char *>(data.data()), data.size());
+        transceiver.sendQuery(std::move(request), nullptr);
+    };
+    engine.onMediaReady = [callId]() {
+        tgcLog("tgcalls-lite: call %d media connected", (int)callId);
+    };
+
+    lite->tickSource = g_timeout_add(kTickMs, tick, lite.get());
+    account.setCallEngine(lite);
+
+    // audiod routes the voipcall sink and webcall source once it knows a VoIP call is up.
+    callLunaSetCallAudio(true);
+    if (!engine.startAudio("voipcall", "webcall"))
+        tgcLog("tgcalls-lite: call %d has no audio", (int)callId);
+    engine.start();
+
+    // Signalling that arrived before callStateReady.
+    for (const std::string &data : account.takePendingCallSignaling())
+        engine.handleIncomingSignalingData(std::vector<uint8_t>(data.begin(), data.end()));
+    return true;
+}
+
+void tgcallsLiteSignalingData(int32_t callId, const std::string &data, TdAccountData &account)
+{
+    if (!account.hasActiveCall() || account.getActiveCallId() != callId)
+        return;
+    if (LiteCall *lite = liteCall(account))
+        lite->engine->handleIncomingSignalingData(std::vector<uint8_t>(data.begin(), data.end()));
+    else
+        account.addPendingCallSignaling(data);
+}
+
+void tgcallsLiteStop(TdAccountData &account)
+{
+    if (!liteCall(account))
+        return;
+    tgcLog("tgcalls-lite: call %d stopped", (int)account.getActiveCallId());
+    account.setCallEngine(nullptr);
+}
+
+#endif
diff --git a/tgcalls-call.h b/tgcalls-call.h
new file mode 100644
index 0000000..58c4b14
--- /dev/null
+++ b/tgcalls-call.h
@@ -0,0 +1,36 @@
+#ifndef _TGCALLS_CALL_H
+#define _TGCALLS_CALL_H
+
+// Telegram calls through tgcalls-lite: tgcalls V2 with signalling version 7.0.0 (raw encrypted
+// signalling packets relayed by TDLib, ICE through libnice, DTLS-SRTP, Opus). Current clients
+// register that version (tgcalls InstanceV2Impl); libtgvoip carries a call only when the peer
+// agrees on no version at all.
+
+#include "account-data.h"
+#include <string>
+
+#ifdef HAVE_TGCALLS_LITE
+
+// The library version tgcalls-lite speaks, for callProtocol.library_versions.
+const char *tgcallsLiteVersion();
+
+// False when LUNEOS_TELEGRAM_CALL_ENGINE=tgvoip is set, to fall back to libtgvoip for testing.
+bool tgcallsLiteEnabled();
+
+// True if the agreed protocol in callStateReady names tgcallsLiteVersion().
+bool tgcallsLiteAgreed(const td::td_api::callStateReady &state);
+
+// Starts the engine for a call that reached callStateReady. Returns false if it could not start
+// (bad key, engine error); the caller then discards the call.
+bool tgcallsLiteStart(const td::td_api::call &call, const td::td_api::callStateReady &state,
+                      TdAccountData &account, TdTransceiver &transceiver);
+
+// updateNewCallSignalingData for the active call. Kept until the engine starts if it is early.
+void tgcallsLiteSignalingData(int32_t callId, const std::string &data, TdAccountData &account);
+
+// Stops the engine and its audio, if one is running.
+void tgcallsLiteStop(TdAccountData &account);
+
+#endif
+
+#endif

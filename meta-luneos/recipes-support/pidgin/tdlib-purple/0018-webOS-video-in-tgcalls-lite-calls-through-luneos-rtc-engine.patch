diff --git a/test/tgcalls-video-test.cpp b/test/tgcalls-video-test.cpp
new file mode 100644
index 0000000..f2a0d23
--- /dev/null
+++ b/test/tgcalls-video-test.cpp
@@ -0,0 +1,481 @@
+// Host test of tgcalls-video.cpp: the AU bridge over real AF_UNIX SOCK_SEQPACKET sockets standing
+// in for luneos-rtc-engine's, and the session controller against a fake org.webosports.rtcengine.
+// Standalone (no TDLib, no libpurple, no luna-service2):
+//   c++ -std=c++14 -DHAVE_TGCALLS_LITE -o tgcalls-video-test tgcalls-video-test.cpp
+//       ../tgcalls-video.cpp $(pkg-config --cflags --libs glib-2.0 json-glib-1.0) -pthread
+// Run it with a scratch directory for the sockets as the only argument.
+#include "../tgcalls-video.h"
+
+#include <glib.h>
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+using namespace tgvideo;
+
+static int failures;
+#define CHECK(c, ...) do { if (!(c)) { failures++; fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); \
+    fprintf(stderr, __VA_ARGS__); fprintf(stderr, "\n"); } } while (0)
+
+static std::vector<uint8_t> au(uint8_t type, size_t size, uint8_t fill)
+{
+    std::vector<uint8_t> v = {0, 0, 0, 1, (uint8_t)(0x60 | type)};
+    for (size_t i = 0; i < size; i++)
+        v.push_back((uint8_t)(fill + i));
+    return v;
+}
+
+// A listening engine socket.
+struct Server {
+    std::string path;
+    int fd = -1, peer = -1;
+    explicit Server(const std::string &p) : path(p)
+    {
+        unlink(path.c_str());
+        fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+        struct sockaddr_un sa;
+        memset(&sa, 0, sizeof sa);
+        sa.sun_family = AF_UNIX;
+        memcpy(sa.sun_path, path.c_str(), path.size() + 1);
+        if (bind(fd, (struct sockaddr *)&sa, sizeof sa) < 0 || listen(fd, 1) < 0)
+            fprintf(stderr, "server %s: %s\n", path.c_str(), strerror(errno));
+    }
+    ~Server()
+    {
+        if (peer >= 0)
+            close(peer);
+        if (fd >= 0)
+            close(fd);
+        unlink(path.c_str());
+    }
+    bool accept(int timeoutMs = 2000)
+    {
+        struct pollfd p = {fd, POLLIN, 0};
+        if (poll(&p, 1, timeoutMs) <= 0)
+            return false;
+        peer = ::accept(fd, nullptr, nullptr);
+        return peer >= 0;
+    }
+    std::vector<uint8_t> recvOne(int timeoutMs = 2000)
+    {
+        struct pollfd p = {peer, POLLIN, 0};
+        std::vector<uint8_t> buf(2 * 1024 * 1024);
+        if (poll(&p, 1, timeoutMs) <= 0)
+            return {};
+        ssize_t n = recv(peer, buf.data(), buf.size(), 0);
+        buf.resize(n > 0 ? (size_t)n : 0);
+        return buf;
+    }
+    void closePeer()
+    {
+        if (peer >= 0)
+            close(peer);
+        peer = -1;
+    }
+};
+
+static void test_bridge_rx(const std::string &dir)
+{
+    AuBridge b;
+    CHECK(!b.setSockets("", std::string(200, 'x')), "a path longer than sun_path is refused");
+    Server rx(dir + "/rx.sock");
+    CHECK(b.setSockets("", rx.path), "paths set");
+    b.start(nullptr);
+    CHECK(b.running(), "running");
+    CHECK(!b.setSockets("", rx.path), "no new paths while running");
+    CHECK(rx.accept(), "the bridge connected at start");
+
+    const auto p = au(1, 100, 1), idr = au(5, 3000, 2);
+    CHECK(b.receive(p.data(), p.size()), "a P frame before any IDR: held back, keyframe wanted");
+    CHECK(!b.receive(idr.data(), idr.size()), "the IDR goes out");
+    CHECK(rx.recvOne() == idr, "the engine got the IDR whole");
+    CHECK(!b.receive(p.data(), p.size()), "then P");
+    CHECK(rx.recvOne() == p, "the engine got P");
+    CHECK(b.stats().rxSent == 2 && b.stats().rxDropped == 1, "counters");
+
+    // The engine stops reading: once the socket is full, units are dropped without blocking,
+    // and after that only an IDR gets through.
+    const auto big = au(1, 200 * 1024, 3);
+    int sends = 0;
+    bool dropped = false;
+    while (sends < 200 && !dropped) {
+        dropped = b.receive(big.data(), big.size());
+        sends++;
+    }
+    CHECK(dropped, "a full socket drops (after %d units)", sends);
+    while (!rx.recvOne(100).empty()) {
+    }
+    CHECK(b.receive(p.data(), p.size()), "after a drop P is held back");
+    CHECK(!b.receive(idr.data(), idr.size()) && rx.recvOne() == idr, "and the next IDR goes out");
+
+    // The engine goes away: the bridge connects again (not more often than every 200 ms) and
+    // starts again at an IDR.
+    rx.closePeer();
+    bool lost = false;
+    for (int i = 0; i < 5 && !lost; i++)
+        lost = b.receive(p.data(), p.size());
+    CHECK(lost, "a closed socket is noticed");
+    g_usleep(250 * 1000);
+    b.receive(p.data(), p.size());
+    CHECK(rx.accept(), "connected again");
+    CHECK(b.receive(p.data(), p.size()), "P held back after reconnecting");
+    CHECK(!b.receive(idr.data(), idr.size()) && rx.recvOne() == idr, "IDR after reconnecting");
+
+    b.stop();
+    CHECK(!b.running() && !b.receive(idr.data(), idr.size()), "stopped: nothing passed");
+    b.stop();
+
+    // The engine is not listening yet when the bridge starts: it tries again at most every
+    // 200 ms, not on every unit.
+    {
+        AuBridge late;
+        const std::string path = dir + "/late-rx.sock";
+        unlink(path.c_str());
+        CHECK(late.setSockets("", path), "late path");
+        late.start(AuBridge::TxSink());
+        Server srv(path);
+        late.receive(idr.data(), idr.size());
+        CHECK(!srv.accept(50), "no reconnect within 200 ms of the failed try");
+        g_usleep(250 * 1000);
+        late.receive(idr.data(), idr.size());
+        CHECK(srv.accept(), "reconnected after 200 ms");
+        late.stop();
+    }
+}
+
+static void test_bridge_tx(const std::string &dir)
+{
+    Server tx(dir + "/tx.sock");
+    AuBridge b;
+    CHECK(b.setSockets(tx.path, ""), "tx path only");
+    std::vector<std::vector<uint8_t>> got;
+    // std::mutex, not GMutex: ThreadSanitizer sees only the former.
+    std::mutex mx;
+    b.start([&](const uint8_t *p, size_t n) {
+        std::lock_guard<std::mutex> lock(mx);
+        got.emplace_back(p, p + n);
+    });
+    CHECK(tx.accept(), "the TX thread connected");
+    const auto a = au(5, 70000, 1), c = au(1, 10, 2), d = au(1, 500, 3);
+    for (const auto *u : {&a, &c, &d})
+        CHECK(send(tx.peer, u->data(), u->size(), 0) == (ssize_t)u->size(), "sent");
+    for (int i = 0; i < 200; i++) {
+        size_t n;
+        {
+            std::lock_guard<std::mutex> lock(mx);
+            n = got.size();
+        }
+        if (n >= 3)
+            break;
+        g_usleep(10 * 1000);
+    }
+    {
+        std::lock_guard<std::mutex> lock(mx);
+        CHECK(got.size() == 3 && got[0] == a && got[1] == c && got[2] == d, "units in order, whole (%zu)", got.size());
+    }
+    // The engine restarts: the thread connects again.
+    tx.closePeer();
+    CHECK(tx.accept(), "the TX thread connected again");
+    b.stop();
+    CHECK(b.stats().txUnits == 3, "tx counter");
+}
+
+// A fake org.webosports.rtcengine.
+struct FakeRtc {
+    struct Call {
+        std::string method, payload;
+        std::function<void(const std::string &)> reply;
+    };
+    std::vector<Call> calls;
+    bool fail = false;
+    Controller::RtcCall fn()
+    {
+        return [this](const std::string &m, const std::string &p, std::function<void(const std::string &)> r) {
+            if (fail)
+                return false;
+            calls.push_back({m, p, r});
+            return true;
+        };
+    }
+    size_t count(const std::string &m) const
+    {
+        size_t n = 0;
+        for (const auto &c : calls)
+            n += c.method == m;
+        return n;
+    }
+    // Answers the latest call of method.
+    bool reply(const std::string &m, const std::string &payload)
+    {
+        for (size_t i = calls.size(); i-- > 0;) {
+            if (calls[i].method != m)
+                continue;
+            auto r = calls[i].reply;
+            calls[i].reply = nullptr;
+            if (!r)
+                return false;
+            r(payload);
+            return true;
+        }
+        return false;
+    }
+    std::string last(const std::string &m) const
+    {
+        for (size_t i = calls.size(); i-- > 0;)
+            if (calls[i].method == m)
+                return calls[i].payload;
+        return "";
+    }
+};
+
+static const char *kCaps2 = "{\"returnValue\":true,\"cameraCount\":2,\"videoCallCapable\":true}";
+static const char *kStarted = "{\"returnValue\":true,\"txSocket\":\"/nonexistent/tx\",\"rxSocket\":\"/nonexistent/rx\"}";
+
+static bool has(const std::string &s, const char *needle)
+{
+    return s.find(needle) != std::string::npos;
+}
+
+static void test_controller()
+{
+    FakeRtc rtc;
+    std::vector<bool> sending;
+    int changes = 0, keyframes = 0;
+    Controller c(rtc.fn());
+    c.onSendingChanged = [&](bool on) { sending.push_back(on); };
+    c.onChanged = [&]() { changes++; };
+    c.onPeerKeyframeWanted = [&]() { keyframes++; };
+
+    CHECK(has(c.lineFields(), "\"incomingVideoState\":\"unavailable\"") && has(c.lineFields(), "\"outgoingVideo\":false"),
+          "idle line: %s", c.lineFields().c_str());
+    CHECK(c.payloadFields() == ",\"allowVideoCalls\":true,\"videoURI\":\"\"", "idle payload: %s", c.payloadFields().c_str());
+
+    c.setOurCamera(true);
+    CHECK(rtc.calls.empty(), "no session before the call is up");
+    c.setCallActive(true);
+    CHECK(rtc.count("capabilities") == 1, "capabilities asked");
+    CHECK(rtc.reply("capabilities", kCaps2), "caps answered");
+    CHECK(rtc.count("start") == 1, "start asked");
+    const std::string start = rtc.last("start");
+    CHECK(has(start, "\"txEnabled\":true") && has(start, "\"camera\":1") && has(start, "\"width\":640") &&
+          has(start, "\"previewShmPath\":\"/tmp/tg-rtc-preview\"") && has(start, "\"rxSocket\":\"/tmp/tg-rtc-rx.sock\""),
+          "start payload: %s", start.c_str());
+    CHECK(rtc.reply("start", kStarted), "start answered");
+    CHECK(c.running() && c.sending() && c.bridge().running(), "running and sending");
+    CHECK(sending.size() == 1 && sending[0], "the call engine was told to send");
+    CHECK(keyframes == 1, "the peer is asked for an IDR when decoding starts");
+    const std::string pf = c.payloadFields();
+    CHECK(has(pf, "\"videoURI\":\"/tmp/tg-rtc-video\"") && has(pf, "\"videoWidth\":640") &&
+          has(pf, "\"videoPreviewURI\":\"/tmp/tg-rtc-preview\"") && has(pf, "\"videoPreviewMirrored\":true") &&
+          has(pf, "\"videoPreviewOrientation\":1"), "running payload: %s", pf.c_str());
+    CHECK(has(c.lineFields(), "\"outgoingVideo\":true"), "line says we send");
+
+    // Keyframes to our encoder, at most once a second.
+    c.requestKeyframe(10 * G_USEC_PER_SEC);
+    c.requestKeyframe(10 * G_USEC_PER_SEC + 500000);
+    CHECK(rtc.count("requestKeyframe") == 1, "one keyframe request in half a second");
+    c.requestKeyframe(11 * G_USEC_PER_SEC + 100000);
+    CHECK(rtc.count("requestKeyframe") == 2, "the next after a second");
+
+    // The peer's camera: available, then streaming while frames come, then available again.
+    c.setPeerVideo(true);
+    CHECK(has(c.lineFields(), "\"incomingVideo\":true") && has(c.lineFields(), "\"incomingVideoState\":\"available\""),
+          "peer video available: %s", c.lineFields().c_str());
+    c.noteFrame(20 * G_USEC_PER_SEC);
+    const int ch0 = changes;
+    CHECK(c.tick(20 * G_USEC_PER_SEC + 100) && has(c.lineFields(), "\"streaming\""), "streaming");
+    CHECK(!c.tick(21 * G_USEC_PER_SEC), "no change while frames are recent");
+    CHECK(c.tick(22 * G_USEC_PER_SEC + 1) && has(c.lineFields(), "\"available\""), "frames stopped");
+    CHECK(changes == ch0 + 2, "each flip told");
+
+    // Camera off, peer's video not chosen: the session stops.
+    c.setOurCamera(false);
+    CHECK(rtc.count("stop") == 1 && !c.running(), "stopped");
+    CHECK(sending.size() == 2 && !sending[1], "the call engine was told to stop sending");
+    CHECK(c.payloadFields() == ",\"allowVideoCalls\":true,\"videoURI\":\"\"", "no picture now");
+    CHECK(!c.bridge().running(), "bridge stopped");
+
+    // The user chooses to see the peer: a receive-only session.
+    c.setView(true);
+    CHECK(rtc.reply("capabilities", kCaps2), "caps again");
+    const std::string rxOnly = rtc.last("start");
+    CHECK(has(rxOnly, "\"txEnabled\":false") && has(rxOnly, "\"width\":480") && has(rxOnly, "\"previewShmPath\":\"\""),
+          "receive-only start: %s", rxOnly.c_str());
+    CHECK(rtc.reply("start", kStarted) && c.running() && !c.sending(), "running, receive only");
+    CHECK(sending.size() == 2, "sending not announced for receive only");
+    CHECK(!has(c.payloadFields(), "videoPreviewURI"), "no preview without our camera");
+    c.requestKeyframe(40 * G_USEC_PER_SEC);
+    CHECK(rtc.count("requestKeyframe") == 2, "no keyframe request without TX");
+
+    // Camera on while receiving: restarted with TX.
+    const size_t stops = rtc.count("stop");
+    c.setOurCamera(true);
+    CHECK(rtc.count("stop") == stops + 1, "the receive-only session stops");
+    CHECK(rtc.reply("capabilities", kCaps2) && has(rtc.last("start"), "\"txEnabled\":true"), "restarted with TX");
+    CHECK(rtc.reply("start", kStarted) && c.sending(), "sending");
+
+    // The call ends: stopped, and the next call asks to see the peer again.
+    c.setCallActive(false);
+    CHECK(!c.running() && rtc.count("stop") == stops + 2, "call over: stopped");
+    c.setOurCamera(false);
+    c.setCallActive(true);
+    CHECK(!c.running() && rtc.count("capabilities") == 3, "peer video alone does not start without the user");
+}
+
+static void test_controller_failures()
+{
+    // A start reply after the session was closed: what it started is stopped.
+    {
+        FakeRtc rtc;
+        Controller c(rtc.fn());
+        c.setCallActive(true);
+        c.setOurCamera(true);
+        rtc.reply("capabilities", kCaps2);
+        c.setOurCamera(false);
+        CHECK(rtc.count("stop") == 0, "nothing to stop yet");
+        rtc.reply("start", kStarted);
+        CHECK(rtc.count("stop") == 1 && !c.running(), "late start stopped");
+        // A caps reply after the wish went away does nothing.
+        c.setOurCamera(true);
+        c.setOurCamera(false);
+        rtc.reply("capabilities", kCaps2);
+        CHECK(rtc.count("start") == 1, "late caps start nothing");
+    }
+    // "already running": stopped and retried once.
+    {
+        FakeRtc rtc;
+        Controller c(rtc.fn());
+        c.setCallActive(true);
+        c.setOurCamera(true);
+        rtc.reply("capabilities", kCaps2);
+        rtc.reply("start", "{\"returnValue\":false,\"errorText\":\"already running\"}");
+        CHECK(rtc.count("stop") == 1 && rtc.count("capabilities") == 2, "stop and retry");
+        rtc.reply("capabilities", kCaps2);
+        rtc.reply("start", "{\"returnValue\":false,\"errorText\":\"already running\"}");
+        CHECK(rtc.count("stop") == 1 && rtc.count("capabilities") == 2, "only one retry");
+        CHECK(!c.running(), "given up");
+        // A new wish tries again.
+        c.setOurCamera(false);
+        c.setOurCamera(true);
+        CHECK(rtc.count("capabilities") == 3, "new wish, new try");
+    }
+    // Gave up while the user also watches the peer: switching our camera off is a new wish that
+    // keeps the session wanted, and is tried (receive only).
+    {
+        FakeRtc rtc;
+        Controller c(rtc.fn());
+        c.setCallActive(true);
+        c.setPeerVideo(true);
+        c.setView(true);
+        c.setOurCamera(true);
+        for (int i = 0; i < 2; i++) {
+            rtc.reply("capabilities", kCaps2);
+            rtc.reply("start", "{\"returnValue\":false,\"errorText\":\"already running\"}");
+        }
+        const size_t caps = rtc.count("capabilities");
+        CHECK(!c.running(), "given up");
+        c.setOurCamera(false);
+        CHECK(rtc.count("capabilities") == caps + 1, "camera off while watching: tried again");
+        rtc.reply("capabilities", kCaps2);
+        CHECK(has(rtc.last("start"), "\"txEnabled\":false"), "receive only");
+    }
+    // No encoder: the camera cannot be sent; receive only if the user wants to see the peer.
+    {
+        FakeRtc rtc;
+        int changes = 0;
+        Controller c(rtc.fn());
+        c.onChanged = [&]() { changes++; };
+        c.setCallActive(true);
+        c.setOurCamera(true);
+        rtc.reply("capabilities", kCaps2);
+        const int ch0 = changes;
+        rtc.reply("start", "{\"returnValue\":false,\"errorText\":\"tx start failed\"}");
+        CHECK(!c.running() && rtc.count("capabilities") == 1, "camera only: nothing more");
+        CHECK(changes > ch0, "told");
+        c.setPeerVideo(true);
+        c.setView(true);
+        CHECK(rtc.reply("capabilities", kCaps2), "probing for receive only");
+        CHECK(has(rtc.last("start"), "\"txEnabled\":false"), "receive only, the capable reply notwithstanding");
+        rtc.reply("start", kStarted);
+        CHECK(c.running() && !c.sending() && has(c.lineFields(), "\"outgoingVideo\":false"), "showing the peer");
+    }
+    // A device without a usable camera: our camera alone starts nothing.
+    {
+        FakeRtc rtc;
+        Controller c(rtc.fn());
+        c.setCallActive(true);
+        c.setOurCamera(true);
+        rtc.reply("capabilities", "{\"returnValue\":true,\"cameraCount\":0,\"videoCallCapable\":false}");
+        CHECK(rtc.count("start") == 0, "no camera, no session");
+        c.setPeerVideo(true);
+        c.setView(true);
+        rtc.reply("capabilities", "{\"returnValue\":true,\"cameraCount\":0,\"videoCallCapable\":false}");
+        CHECK(has(rtc.last("start"), "\"txEnabled\":false") && has(rtc.last("start"), "\"camera\":0"), "receive only");
+    }
+    // The service cannot be called / says no.
+    {
+        FakeRtc rtc;
+        rtc.fail = true;
+        Controller c(rtc.fn());
+        c.setCallActive(true);
+        c.setOurCamera(true);
+        CHECK(!c.running(), "no service");
+        rtc.fail = false;
+        c.setView(true); // no peer video: no change of wish that matters, but failed is reset
+        CHECK(rtc.count("capabilities") == 1, "tried again on a new wish");
+        rtc.reply("capabilities", "{\"returnValue\":false}");
+        CHECK(rtc.count("start") == 0, "caps failure: no start");
+        rtc.reply("start", kStarted);
+        CHECK(!c.running(), "a stray reply does nothing");
+    }
+    // Unusable socket paths in the start reply.
+    {
+        FakeRtc rtc;
+        Controller c(rtc.fn());
+        c.setCallActive(true);
+        c.setOurCamera(true);
+        rtc.reply("capabilities", kCaps2);
+        rtc.reply("start", ("{\"returnValue\":true,\"txSocket\":\"" + std::string(150, 'a') + "\",\"rxSocket\":\"/x\"}").c_str());
+        CHECK(!c.running() && rtc.count("stop") == 1, "refused and stopped");
+    }
+}
+
+static void test_json()
+{
+    CHECK(jsonBool("{\"a\":true}", "a") && !jsonBool("{\"a\":false}", "a") && !jsonBool("{\"a\":1}", "a"), "bool");
+    CHECK(!jsonBool("not json", "a") && !jsonBool("[true]", "a") && !jsonBool("{}", "a"), "bool fallbacks");
+    CHECK(jsonString("{\"s\":\"x\\\"y\"}", "s") == "x\"y" && jsonString("{\"s\":3}", "s").empty(), "string");
+    CHECK(jsonInt("{\"n\":2}", "n", -1) == 2 && jsonInt("{\"n\":2.0}", "n", -1) == 2 && jsonInt("{\"n\":\"2\"}", "n", -1) == -1 &&
+          jsonInt("{}", "n", 7) == 7, "int");
+    const uint8_t three[] = {0, 0, 1, 0x65};
+    CHECK(auHasIdr(three, 4) && !auHasIdr(three, 3) && !auHasIdr(nullptr, 4), "auHasIdr");
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s <directory for the test sockets>\n", argv[0]);
+        return 2;
+    }
+    const std::string dir = argv[1];
+    test_json();
+    test_bridge_rx(dir);
+    test_bridge_tx(dir);
+    test_controller();
+    test_controller_failures();
+    if (failures) {
+        fprintf(stderr, "%d failure(s)\n", failures);
+        return 1;
+    }
+    fprintf(stderr, "ALL OK -- tgcalls-video\n");
+    return 0;
+}

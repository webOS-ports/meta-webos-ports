+// tiny extractor for a top-level boolean: 1 true, 0 false, -1 absent or not a boolean
+int getBool(const char *json, const char *key)
+{
+    if (!json) return -1;
+    std::string needle = std::string("\"") + key + "\"";
+    const char *k = strstr(json, needle.c_str());
+    if (!k) return -1;
+    const char *c = strchr(k + needle.size(), ':');
+    if (!c) return -1;
+    while (*++c == ' ') ;
+    if (!strncmp(c, "true", 4)) return 1;
+    if (!strncmp(c, "false", 5)) return 0;
+    return -1;
+}

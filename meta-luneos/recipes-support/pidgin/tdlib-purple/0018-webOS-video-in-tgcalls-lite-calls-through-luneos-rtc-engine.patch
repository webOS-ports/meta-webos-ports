+// Largest access unit read from the TX socket: keyframes at 640x480 are tens of KB, at 1280x720
+// hundreds (luneos-rtc-engine docs/API.md). A larger datagram is truncated by recv() and dropped.
+constexpr size_t kTxAuMax = 1024 * 1024;
+// Send buffer asked for on the RX socket: a SOCK_SEQPACKET datagram must fit whole, so this
+// bounds the largest peer keyframe passed on.
+constexpr int kRxSndBuf = 1024 * 1024;
+constexpr int kReconnectIntervalMs = 200;
+constexpr int64_t kKeyframeMinIntervalUs = G_USEC_PER_SEC;
+// The peer's video counts as streaming while a frame came within this.
+constexpr int64_t kStreamingTimeoutUs = 2 * G_USEC_PER_SEC;
+
+// Sizes, as for WhatsApp (glue/call.c of purple-combined): what the engine renders to (and
+// encodes at, with a camera). Receive-only is portrait, as phones send; the engine letterboxes
+// other shapes.
+constexpr int kTxWidth = 640, kTxHeight = 480;
+constexpr int kRxOnlyWidth = 480, kRxOnlyHeight = 640;
+constexpr int kTxBitrate = 1200000;
+constexpr int kPreviewWidth = 320, kPreviewHeight = 240;
+// How far the far side turns our camera's picture clockwise. WhatsApp's receivers needed one
+// quarter turn for sargo's camera held upright; that Telegram's needs the same is a guess until
+// a call shows it.
+constexpr int kTxRotationDegrees = 90;
+
+int connectSeqpacket(const std::string &path)
+{
+    struct sockaddr_un sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sun_family = AF_UNIX;
+    if (path.size() >= sizeof sa.sun_path)
+        return -1;
+    memcpy(sa.sun_path, path.c_str(), path.size() + 1);
+    int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return -1;
+    if (connect(fd, reinterpret_cast<struct sockaddr *>(&sa), sizeof sa) < 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+bool fitsSunPath(const std::string &path)
+{
+    return path.size() < sizeof(sockaddr_un::sun_path);
+}
+
+std::string jsonQuote(const std::string &s)
+{
+    std::string o = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') {
+            o += '\\';
+            o += c;
+        } else if ((unsigned char)c < 0x20) {
+            char buf[8];
+            snprintf(buf, sizeof buf, "\\u%04x", (unsigned)(unsigned char)c);
+            o += buf;
+        } else {
+            o += c;
+        }
+    }
+    return o + "\"";
+}
+
+// The reply's root object, or nullptr; unref the parser.
+JsonObject *parseObject(const std::string &json, JsonParser **parser)
+{
+    *parser = json_parser_new();
+    if (!json_parser_load_from_data(*parser, json.c_str(), (gssize)json.size(), nullptr))
+        return nullptr;
+    JsonNode *root = json_parser_get_root(*parser);
+    return root && JSON_NODE_HOLDS_OBJECT(root) ? json_node_get_object(root) : nullptr;
+}
+
+JsonNode *member(JsonObject *obj, const char *key)
+{
+    return obj && json_object_has_member(obj, key) ? json_object_get_member(obj, key) : nullptr;
+}
+
+} // namespace
+
+bool jsonBool(const std::string &json, const char *key)
+{
+    JsonParser *parser;
+    JsonNode *n = member(parseObject(json, &parser), key);
+    bool v = n && JSON_NODE_HOLDS_VALUE(n) && json_node_get_value_type(n) == G_TYPE_BOOLEAN &&
+             json_node_get_boolean(n);
+    g_object_unref(parser);
+    return v;
+}
+
+std::string jsonString(const std::string &json, const char *key)
+{
+    JsonParser *parser;
+    JsonNode *n = member(parseObject(json, &parser), key);
+    std::string v;
+    if (n && JSON_NODE_HOLDS_VALUE(n) && json_node_get_value_type(n) == G_TYPE_STRING)
+        v = json_node_get_string(n);
+    g_object_unref(parser);
+    return v;
+}
+
+long jsonInt(const std::string &json, const char *key, long fallback)
+{
+    JsonParser *parser;
+    JsonNode *n = member(parseObject(json, &parser), key);
+    long v = fallback;
+    if (n && JSON_NODE_HOLDS_VALUE(n)) {
+        GType t = json_node_get_value_type(n);
+        if (t == G_TYPE_INT64)
+            v = (long)json_node_get_int(n);
+        else if (t == G_TYPE_DOUBLE)
+            v = (long)json_node_get_double(n);
+    }
+    g_object_unref(parser);
+    return v;
+}
+
+bool auHasIdr(const uint8_t *au, size_t len)
+{
+    if (!au)
+        return false;
+    // NAL units follow 00 00 01 (a 4-byte start code ends the same way); the NAL type is the
+    // low five bits of the byte after it.
+    for (size_t i = 0; i + 3 < len; i++) {
+        if (au[i] == 0 && au[i + 1] == 0 && au[i + 2] == 1) {
+            if ((au[i + 3] & 0x1f) == 5)
+                return true;
+            i += 2;
+        }
+    }
+    return false;
+}
+
+// --- AuBridge ---------------------------------------------------------------------------------
+
+bool AuBridge::setSockets(const std::string &txPath, const std::string &rxPath)
+{
+    if (m_running)
+        return false; // the running bridge keeps its paths
+    if (!fitsSunPath(txPath) || !fitsSunPath(rxPath)) {
+        m_txPath.clear();
+        m_rxPath.clear();
+        return false;
+    }
+    m_txPath = txPath;
+    m_rxPath = rxPath;
+    return true;
+}
+
+void AuBridge::start(TxSink sink)
+{
+    if (m_running)
+        return;
+    m_running = true;
+    m_rxWaitIdr = true;
+    m_rxSent = m_rxDropped = 0;
+    m_txUnits = 0;
+    m_rxLastConnectUs = 0;
+    rxConnect();
+    if (!m_txPath.empty() && sink) {
+        m_txStop = false;
+        m_txThread = std::thread(&AuBridge::txMain, this, m_txPath, std::move(sink));
+    }
+}
+
+void AuBridge::stop()
+{
+    if (m_running)
+        fprintf(stderr, "tg-video: bridge stopped (rx sent %llu, dropped %llu, tx %llu)\n", m_rxSent,
+                m_rxDropped, (unsigned long long)m_txUnits);
+    m_running = false;
+    if (m_rxFd >= 0) {
+        close(m_rxFd);
+        m_rxFd = -1;
+    }
+    m_txStop = true;
+    if (m_txThread.joinable())
+        m_txThread.join();
+}
+
+AuBridge::Stats AuBridge::stats() const
+{
+    Stats s;
+    s.rxSent = m_rxSent;
+    s.rxDropped = m_rxDropped;
+    s.txUnits = m_txUnits;
+    return s;
+}
+
+void AuBridge::rxConnect()
+{
+    const int64_t now = g_get_monotonic_time();
+    if (m_rxFd >= 0 || m_rxPath.empty() ||
+        (m_rxLastConnectUs && now - m_rxLastConnectUs < kReconnectIntervalMs * 1000))
+        return;
+    m_rxLastConnectUs = now;
+    int fd = connectSeqpacket(m_rxPath);
+    if (fd < 0)
+        return;
+    int size = kRxSndBuf;
+    // SO_SNDBUFFORCE passes net.core.wmem_max when we may (the service runs as root).
+    if (setsockopt(fd, SOL_SOCKET, SO_SNDBUFFORCE, &size, sizeof size) < 0 &&
+        setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &size, sizeof size) < 0)
+        fprintf(stderr, "tg-video: rx send buffer stays at the default\n");
+    m_rxFd = fd;
+    m_rxWaitIdr = true; // joining mid-stream
+    fprintf(stderr, "tg-video: rx connected\n");
+}
+
+bool AuBridge::receive(const uint8_t *au, size_t len)
+{
+    if (!m_running || !au || len == 0)
+        return false;
+    rxConnect();
+    if (m_rxFd < 0)
+        return false;
+    if (m_rxWaitIdr) {
+        if (!auHasIdr(au, len)) {
+            m_rxDropped++;
+            return true;
+        }
+        m_rxWaitIdr = false;
+    }
+    ssize_t n = send(m_rxFd, au, len, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (n == (ssize_t)len) {
+        m_rxSent++;
+        return false;
+    }
+    int err = n < 0 ? errno : EMSGSIZE;
+    m_rxDropped++;
+    m_rxWaitIdr = true;
+    if (err != EAGAIN && err != EWOULDBLOCK && err != EMSGSIZE && err != ENOBUFS) {
+        // The engine went away (session stopped or restarted): connect again later.
+        close(m_rxFd);
+        m_rxFd = -1;
+    }
+    return true;
+}
+
+void AuBridge::txMain(std::string path, TxSink sink)
+{
+    std::unique_ptr<uint8_t[]> buf(new (std::nothrow) uint8_t[kTxAuMax]);
+    if (!buf)
+        return;
+    int fd = -1;
+    while (!m_txStop) {
+        if (fd < 0) {
+            fd = connectSeqpacket(path);
+            if (fd < 0) {
+                poll(nullptr, 0, kReconnectIntervalMs);
+                continue;
+            }
+            fprintf(stderr, "tg-video: tx connected\n");
+        }
+        struct pollfd p;
+        p.fd = fd;
+        p.events = POLLIN;
+        p.revents = 0;
+        int r = poll(&p, 1, kReconnectIntervalMs);
+        if (r < 0 && errno != EINTR)
+            break;
+        if (r <= 0)
+            continue;
+        ssize_t n = recv(fd, buf.get(), kTxAuMax, MSG_TRUNC);
+        if (n <= 0) {
+            // 0: the engine closed the socket. Connect again; the session may be restarting.
+            close(fd);
+            fd = -1;
+            continue;
+        }
+        if ((size_t)n > kTxAuMax) {
+            fprintf(stderr, "tg-video: tx access unit of %zd bytes dropped\n", n);
+            continue;
+        }
+        m_txUnits++;
+        sink(buf.get(), (size_t)n);
+    }
+    if (fd >= 0)
+        close(fd);
+}
+
+// --- Controller -------------------------------------------------------------------------------
+
+Controller::Controller(RtcCall rtc, EnginePaths paths) : m_rtc(std::move(rtc)), m_paths(std::move(paths)) {}
+
+Controller::~Controller()
+{
+    // No callbacks into a call that is going away.
+    onSendingChanged = nullptr;
+    onChanged = nullptr;
+    onPeerKeyframeWanted = nullptr;
+    close();
+    txSink = nullptr;
+}
+
+int Controller::txRotationDegrees()
+{
+    return kTxRotationDegrees;
+}
+
+bool Controller::wanted() const
+{
+    return m_callActive && (wantTx() || (m_peerVideo && m_view));
+}
+
+bool Controller::wantTx() const
+{
+    return m_ourCamera && m_canSend;
+}
+
+void Controller::changed()
+{
+    if (onChanged)
+        onChanged();
+}
+
+void Controller::setCallActive(bool on)
+{
+    if (on == m_callActive)
+        return;
+    m_callActive = on;
+    if (!on)
+        m_view = false; // a new call asks again
+    reconcile();
+}
+
+void Controller::setOurCamera(bool on)
+{
+    if (on == m_ourCamera)
+        return;
+    m_ourCamera = on;
+    m_failed = false; // a new wish may start what failed before
+    reconcile();
+    changed();
+}
+
+void Controller::setPeerVideo(bool on)
+{
+    if (on == m_peerVideo)
+        return;
+    m_peerVideo = on;
+    if (!on)
+        m_streaming = false;
+    reconcile();
+    changed();
+}
+
+void Controller::setView(bool on)
+{
+    if (on == m_view)
+        return;
+    m_view = on;
+    m_failed = false;
+    reconcile();
+}
+
+void Controller::reconcile()
+{
+    if (!wanted()) {
+        m_failed = false;
+        m_retried = false;
+        close();
+        return;
+    }
+    if (m_state == State::Running && m_tx != wantTx()) {
+        // Camera on or off: the engine takes the TX chain only at start.
+        close();
+    }
+    if (m_state != State::Idle || m_failed)
+        return; // a reply on its way reconciles again
+    m_state = State::Probing;
+    const unsigned gen = m_gen;
+    if (!m_rtc("capabilities", "{}", [this, gen](const std::string &reply) { onCaps(gen, reply); })) {
+        m_state = State::Idle;
+        m_failed = true;
+    }
+}
+
+void Controller::onCaps(unsigned gen, const std::string &reply)
+{
+    if (gen != m_gen || m_state != State::Probing)
+        return;
+    if (!jsonBool(reply, "returnValue")) {
+        fprintf(stderr, "tg-video: engine capabilities failed\n");
+        m_state = State::Idle;
+        m_failed = true;
+        return;
+    }
+    // videoCallCapable honours the device's own policy (deviceinfo_video_call): a device without a
+    // usable camera still shows the peer, it just sends nothing. With two cameras take the front
+    // one: the droid backend passes the index to droidcamsrc as the HAL id, front = 1.
+    // Only ever lowered: a TX start that failed outweighs a later "capable".
+    m_canSend = m_canSend && jsonBool(reply, "videoCallCapable");
+    m_camera = jsonInt(reply, "cameraCount", 0) >= 2 ? 1 : 0;
+    m_state = State::Idle;
+    if (!wanted()) {
+        changed(); // our camera cannot be sent after all
+        return;
+    }
+    startSession(wantTx());
+}
+
+void Controller::startSession(bool tx)
+{
+    m_tx = tx;
+    m_width = tx ? kTxWidth : kRxOnlyWidth;
+    m_height = tx ? kTxHeight : kRxOnlyHeight;
+    char payload[640];
+    snprintf(payload, sizeof payload,
+             "{\"rxSocket\":%s,\"txSocket\":%s,\"rxEnabled\":true,\"txEnabled\":%s,\"shmPath\":%s,"
+             "\"width\":%d,\"height\":%d,\"bitrate\":%d,\"camera\":%d,\"previewShmPath\":%s,"
+             "\"previewWidth\":%d,\"previewHeight\":%d}",
+             jsonQuote(m_paths.rxSocket).c_str(), jsonQuote(m_paths.txSocket).c_str(), tx ? "true" : "false",
+             jsonQuote(m_paths.shm).c_str(), m_width, m_height, kTxBitrate, m_camera,
+             jsonQuote(tx ? m_paths.preview : std::string()).c_str(), kPreviewWidth, kPreviewHeight);
+    m_state = State::Starting;
+    const unsigned gen = m_gen;
+    if (!m_rtc("start", payload, [this, gen](const std::string &reply) { onStart(gen, reply); })) {
+        m_state = State::Idle;
+        m_failed = true;
+    }
+}
+
+void Controller::onStart(unsigned gen, const std::string &reply)
+{
+    const bool ok = jsonBool(reply, "returnValue");
+    if (gen != m_gen || m_state != State::Starting) {
+        // Closed while starting: stop what this start brought up.
+        if (ok)
+            m_rtc("stop", "{}", nullptr);
+        return;
+    }
+    if (!ok) {
+        const std::string err = jsonString(reply, "errorText");
+        m_state = State::Idle;
+        if (!m_retried && err == "already running") {
+            // A session we lost track of (the service restarted during a call): stop it, start ours.
+            fprintf(stderr, "tg-video: engine already running, stopping it and retrying\n");
+            m_retried = true;
+            m_rtc("stop", "{}", nullptr);
+            reconcile();
+            return;
+        }
+        if (m_tx && err == "tx start failed") {
+            // No usable camera or encoder after all: still show the peer.
+            fprintf(stderr, "tg-video: engine cannot send video, receiving only\n");
+            m_canSend = false;
+            changed();
+            reconcile(); // receive only, if the user wants to see the peer
+            return;
+        }
+        fprintf(stderr, "tg-video: engine start failed: %s\n", err.c_str());
+        m_failed = true;
+        return;
+    }
+    std::string rx = jsonString(reply, "rxSocket"), tx = jsonString(reply, "txSocket");
+    if (rx.empty())
+        rx = m_paths.rxSocket;
+    if (tx.empty())
+        tx = m_paths.txSocket;
+    if (!m_bridge.setSockets(m_tx ? tx : std::string(), rx)) {
+        fprintf(stderr, "tg-video: unusable engine socket paths\n");
+        m_rtc("stop", "{}", nullptr);
+        m_state = State::Idle;
+        m_failed = true;
+        return;
+    }
+    m_bridge.start(m_tx ? txSink : AuBridge::TxSink());
+    m_state = State::Running;
+    m_keyframeAsked = false;
+    fprintf(stderr, "tg-video: engine running (%dx%d, tx %s)\n", m_width, m_height, m_tx ? "on" : "off");
+    if (m_tx && onSendingChanged)
+        onSendingChanged(true);
+    // The decoder joins mid-stream: it needs an IDR to start from.
+    if (onPeerKeyframeWanted)
+        onPeerKeyframeWanted();
+    changed();
+    // The wish may have changed while starting.
+    if (!wanted() || m_tx != wantTx())
+        reconcile();
+}
+
+void Controller::close()
+{
+    const State was = m_state;
+    m_gen++;
+    m_state = State::Idle;
+    if (was == State::Idle || was == State::Probing)
+        return;
+    // Starting: onStart sees the old generation and stops what it started.
+    if (was == State::Running) {
+        m_bridge.stop();
+        m_rtc("stop", "{}", nullptr);
+        if (m_tx && onSendingChanged)
+            onSendingChanged(false);
+        fprintf(stderr, "tg-video: engine session closed\n");
+        changed();
+    }
+}
+
+void Controller::requestKeyframe(int64_t nowUs)
+{
+    if (!sending())
+        return;
+    if (m_keyframeAsked && nowUs - m_lastKeyframeUs < kKeyframeMinIntervalUs)
+        return;
+    m_keyframeAsked = true;
+    m_lastKeyframeUs = nowUs;
+    m_rtc("requestKeyframe", "{}", nullptr);
+}
+
+bool Controller::tick(int64_t nowUs)
+{
+    const bool frames = m_peerVideo && m_lastFrameUs && nowUs - m_lastFrameUs < kStreamingTimeoutUs;
+    if (frames == m_streaming)
+        return false;
+    m_streaming = frames;
+    changed();
+    return true;
+}
+
+std::string Controller::lineFields() const
+{
+    const char *ivs = !m_peerVideo ? "unavailable" : m_streaming ? "streaming" : "available";
+    std::string s = ",\"incomingVideo\":";
+    s += m_peerVideo ? "true" : "false";
+    s += ",\"outgoingVideo\":";
+    s += sending() ? "true" : "false";
+    s += ",\"incomingVideoState\":\"";
+    s += ivs;
+    // A WebRTC sender turns its frames upright itself when, as here, the orientation
+    // extension is not negotiated.
+    s += "\",\"incomingVideoOrientation\":0";
+    return s;
+}
+
+std::string Controller::payloadFields() const
+{
+    std::string s = ",\"allowVideoCalls\":true,\"videoURI\":";
+    if (!running())
+        return s + "\"\"";
+    char buf[96];
+    s += jsonQuote(m_paths.shm);
+    snprintf(buf, sizeof buf, ",\"videoWidth\":%d,\"videoHeight\":%d", m_width, m_height);
+    s += buf;
+    if (m_tx) {
+        // Our own picture for the inset: turned like the sent one, mirrored for the front camera
+        // as a mirror shows the user.
+        s += ",\"videoPreviewURI\":" + jsonQuote(m_paths.preview);
+        snprintf(buf, sizeof buf, ",\"videoPreviewWidth\":%d,\"videoPreviewHeight\":%d,\"videoPreviewOrientation\":%d",
+                 kPreviewWidth, kPreviewHeight, kTxRotationDegrees / 90);
+        s += buf;
+        s += ",\"videoPreviewMirrored\":";
+        s += m_camera == 1 ? "true" : "false";
+    }
+    return s;
+}
+
+} // namespace tgvideo
+
+#endif

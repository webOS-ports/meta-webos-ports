+// --- video: org.webosports.rtcengine ------------------------------------------------------------
+namespace {
+using RtcReply = std::function<void(const std::string &)>;
+
+bool rtcReply(LSHandle *, LSMessage *msg, void *ctx)
+{
+    std::unique_ptr<RtcReply> cb(static_cast<RtcReply *>(ctx));
+    const char *payload = LSMessageGetPayload(msg);
+    if (*cb)
+        (*cb)(payload ? payload : "");
+    return true;
+}
+} // namespace
+
+bool callLunaRtcCall(const std::string &method, const std::string &payload, std::function<void(const std::string &reply)> onReply)
+{
+    if (!g_sh) return false;
+    const std::string uri = "luna://org.webosports.rtcengine/" + method;
+    // One reply: the callback object is freed in rtcReply. Replies without a callback are logged.
+    if (!onReply)
+        onReply = [method](const std::string &reply) {
+            tgcLog("rtcengine %s: %s", method.c_str(), reply.c_str());
+        };
+    RtcReply *ctx = new RtcReply(std::move(onReply));
+    LSError err; LSErrorInit(&err);
+    LSMessageToken tok;
+    if (!LSCallOneReply(g_sh, uri.c_str(), payload.c_str(), rtcReply, ctx, &tok, &err)) {
+        purple_debug_warning(config::pluginId, "rtcengine %s: %s\n", method.c_str(), err.message);
+        LSErrorFree(&err);
+        delete ctx;
+        return false;
+    }
+    return true;
+}
+
+void callLunaSetVideo(const std::string &lineFields, const std::string &payloadFields)
+{
+    if (lineFields == g_videoLine && payloadFields == g_videoPayload)
+        return;
+    g_videoLine = lineFields;
+    g_videoPayload = payloadFields;
+    if (!g_sh || g_state.empty()) return;
+    std::string payload = buildPayload();
+    LSError err; LSErrorInit(&err);
+    if (!LSSubscriptionReply(g_sh, SUBKEY, payload.c_str(), &err)) {
+        purple_debug_warning(config::pluginId, "callStateQuery push: %s\n", err.message);
+        LSErrorFree(&err);
+    }
+}

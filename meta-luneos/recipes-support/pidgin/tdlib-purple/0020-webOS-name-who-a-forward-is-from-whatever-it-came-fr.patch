diff --git a/receiving.cpp b/receiving.cpp
index b096e68..8991d14 100644
--- a/receiving.cpp
+++ b/receiving.cpp
@@ -877,13 +877,28 @@ PurpleConversation *getMessageConversation(TdAccountData &account, const td::td_
     return NULL;
 }
 
-// What goes before the text of a forwarded message: the line saying where it is from
+// What goes before the text of a forwarded message: the line saying where it is from, or that it
+// is forwarded, from someone not known.
+//
+// webOS: the Messaging app draws this line as a "Forwarded from" label above the message, which
+// it finds by its exact form at the start of the text (app/src/util/forwarded.js):
+//
+//     <b>Forwarded from NAME:</b>\n        NAME escaped, as the conversation's markup has it
+//     <b>Forwarded:</b>\n                  from someone not known
+//
+// followed by whatever the message is: its text, a file's file:// URI and the caption, the
+// "luneos-file:" line of a file that waits for a tap, a poll. The plug-in is built without
+// translations for webOS (-DNoTranslations=ON), so the words are these. Other front-ends show
+// the line as it is.
 static std::string getForwardHeader(const TgMessageInfo &message)
 {
-    if (message.forwardedFrom.empty())
-        return std::string();
-    // TRANSLATOR: In-chat notification of forward. Argument will be a username. Please preserve the HTML.
-    return formatMessage(_("<b>Forwarded from {}:</b>"), escapeForDisplay(message.forwardedFrom)) + "\n";
+    if (!message.forwardedFrom.empty())
+        // TRANSLATOR: In-chat notification of forward. Argument will be a username. Please preserve the HTML.
+        return formatMessage(_("<b>Forwarded from {}:</b>"), escapeForDisplay(message.forwardedFrom)) + "\n";
+    if (message.forwarded)
+        // TRANSLATOR: In-chat notification of forward, from someone whose name is not known. Please preserve the HTML.
+        return std::string(_("<b>Forwarded:</b>")) + "\n";
+    return std::string();
 }
 
 void showMessageText(TdAccountData &account, const td::td_api::chat &chat, const TgMessageInfo &message,
@@ -2293,8 +2308,10 @@ void makeFullMessage(const td::td_api::chat &chat, td::td_api::object_ptr<td::td
     messageInfo.sentLocally      = (message->sending_state_ != nullptr);
     messageInfo.repliedMessageId = getReplyMessageId(*message);
 
-    if (message->forward_info_)
+    if (message->forward_info_) {
+        messageInfo.forwarded     = true;
         messageInfo.forwardedFrom = getForwardSource(*message->forward_info_, account);
+    }
 
     if (message && message->content_) {
         if (message->content_->get_id() == td::td_api::messagePhoto::ID) {
diff --git a/test/webos-commands-test.cpp b/test/webos-commands-test.cpp
index 5ecd1bd..c1658c2 100644
--- a/test/webos-commands-test.cpp
+++ b/test/webos-commands-test.cpp
@@ -2282,6 +2282,110 @@ TEST_F(WebosTapTest, TapAfterRestart)
     prpl.verifyNoEvents();
 }
 
+// A forward: the line saying who it is from, which the app draws as a label (util/forwarded.js),
+// goes first, in front of the text, a file's URI or the card of a file that waits for a tap, and
+// stays there when the card is rewritten. A channel or group is named by its title, with the
+// signature of who wrote in it, escaped as any name; one not known by the signature alone, or, with none, as forwarded
+// from nobody named, also when its photo comes after the wait.
+TEST_F(WebosTapTest, Forwarded)
+{
+    login();
+    const int64_t channelId = 700, groupId = 701;
+    tgl.update(make_object<updateNewChat>(makeChat(channelId, make_object<chatTypeSupergroup>(70, true),
+                                                   "News <views>", nullptr, 0, 0, 0)));
+    tgl.update(standardUpdateUser(1));
+    tgl.update(make_object<updateNewChat>(makeChat(groupId, make_object<chatTypeSupergroup>(71, false),
+                                                   "Club", nullptr, 0, 0, 0)));
+    prpl.discardEvents();
+    tgl.verifyNoRequests();
+
+    auto forward = [](object_ptr<message> message, object_ptr<MessageOrigin> origin) {
+        message->forward_info_ = make_object<messageForwardInfo>(std::move(origin), 10000, nullptr, "");
+        return message;
+    };
+
+    // Text, from a user: the name as the account has it
+    tgl.update(make_object<updateNewMessage>(forward(
+        makeMessage(1, userIds[0], chatIds[0], false, 10001, makeTextMessage("hi")),
+        make_object<messageOriginUser>(userIds[1]))));
+    tgl.verifyRequest(viewMessages(chatIds[0], {1}, nullptr, true));
+    verifyShown(1, 10001, "<b>Forwarded from " + userFirstNames[1] + " " + userLastNames[1] + ":</b>\nhi", true);
+
+    // A photo that is here, from a channel, signed: the line, then its URI and the caption
+    tgl.update(make_object<updateNewMessage>(forward(
+        makeMessage(2, userIds[0], chatIds[0], false, 10002,
+                    photoContent(downloadedFile(1234, "/files/photos/a b.jpg"), "cap")),
+        make_object<messageOriginChannel>(channelId, 55, "Ann"))));
+    tgl.verifyRequest(viewMessages(chatIds[0], {2}, nullptr, true));
+    verifyShown(2, 10002, "<b>Forwarded from News &lt;views&gt; (Ann):</b>\nfile:///files/photos/a%20b.jpg\ncap");
+
+    // A photo fetched after the wait, from a group's anonymous admin: the notice alone, then the
+    // line with the file
+    tgl.update(make_object<updateNewMessage>(forward(
+        makeMessage(3, userIds[0], chatIds[0], false, 10003, photoContent(remoteOnlyFile(1235), "")),
+        make_object<messageOriginChat>(groupId, ""))));
+    uint64_t downloadId = tgl.verifyRequest(downloadFile(1235, 1, 0, 0, true));
+    tgl.runTimeouts();
+    prpl.verifyEvents(ConversationWriteEvent(purpleUserName(0), purpleUserName(0), sender + ": Downloading photo",
+                                             PURPLE_MESSAGE_SYSTEM, 10003));
+    tgl.verifyRequest(viewMessages(chatIds[0], {3}, nullptr, true));
+    ASSERT_EQ("", takeStashedId(imConversation()));
+    tgl.reply(downloadId, downloadedFile(1235, "/files/photos/b.jpg"));
+    verifyShown(3, 10003, "<b>Forwarded from Club:</b>\nfile:///files/photos/b.jpg");
+
+    // A video that waits for a tap, from a channel not known: the signature names it. The tap
+    // keeps the line in front of the card, and of the file once it is here.
+    tgl.update(make_object<updateNewMessage>(forward(
+        makeMessage(4, userIds[0], chatIds[0], false, 10004, videoContent(remoteFile(1236, 300), "v.mp4", "cap")),
+        make_object<messageOriginChannel>(999, 1, "Bob <b>"))));
+    tgl.verifyRequest(viewMessages(chatIds[0], {4}, nullptr, true));
+    const std::string fromBob = "<b>Forwarded from Bob &lt;b&gt;:</b>\n";
+    verifyShown(4, 10004, fromBob + "luneos-file:?name=v.mp4&size=300&type=video&state=ask\ncap");
+    tgl.verifyNoRequests();
+
+    std::string id = serviceMessageId(chatIds[0], 4);
+    ASSERT_TRUE(tap()(account, purpleUserName(0).c_str(), id.c_str(), nullptr));
+    tgl.verifyRequest(getMessage(chatIds[0], 4));
+    tgl.reply(forward(
+        makeMessage(4, userIds[0], chatIds[0], false, 10004, videoContent(remoteFile(1236, 300), "v.mp4", "cap")),
+        make_object<messageOriginChannel>(999, 1, "Bob <b>")));
+    ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 4,
+              fromBob + "luneos-file:?name=v.mp4&size=300&type=video&state=downloading\ncap")}),
+              takeWebosSignals());
+    downloadId = tgl.verifyRequest(downloadFile(1236, 1, 0, 0, true));
+    tgl.reply(downloadId, fetchedFile(1236, 300, "/files/videos/v.mp4"));
+    ASSERT_EQ(std::vector<WebosSignal>({replace(chatIds[0], 4, fromBob + "file:///files/videos/v.mp4\ncap")}),
+              takeWebosSignals());
+
+    // From a channel not known, signed by nobody: forwarded, from nobody named
+    tgl.update(make_object<updateNewMessage>(forward(
+        makeMessage(5, userIds[0], chatIds[0], false, 10005, makeTextMessage("news")),
+        make_object<messageOriginChannel>(999, 2, ""))));
+    tgl.verifyRequest(viewMessages(chatIds[0], {5}, nullptr, true));
+    verifyShown(5, 10005, "<b>Forwarded:</b>\nnews");
+
+    // ...and so after the wait for its photo
+    tgl.update(make_object<updateNewMessage>(forward(
+        makeMessage(7, userIds[0], chatIds[0], false, 10007, photoContent(remoteOnlyFile(1237), "")),
+        make_object<messageOriginChannel>(999, 3, ""))));
+    downloadId = tgl.verifyRequest(downloadFile(1237, 1, 0, 0, true));
+    tgl.runTimeouts();
+    prpl.verifyEvents(ConversationWriteEvent(purpleUserName(0), purpleUserName(0), sender + ": Downloading photo",
+                                             PURPLE_MESSAGE_SYSTEM, 10007));
+    tgl.verifyRequest(viewMessages(chatIds[0], {7}, nullptr, true));
+    ASSERT_EQ("", takeStashedId(imConversation()));
+    tgl.reply(downloadId, downloadedFile(1237, "/files/photos/c.jpg"));
+    verifyShown(7, 10007, "<b>Forwarded:</b>\nfile:///files/photos/c.jpg");
+
+    // Not forwarded: no line
+    tgl.update(make_object<updateNewMessage>(
+        makeMessage(6, userIds[0], chatIds[0], false, 10006, makeTextMessage("plain"))));
+    tgl.verifyRequest(viewMessages(chatIds[0], {6}, nullptr, true));
+    verifyShown(6, 10006, "plain");
+    tgl.verifyNoRequests();
+    prpl.verifyNoEvents();
+}
+
 // Not a message id, a chat not known, a message TDLib does not have, or one with no file: nothing
 // is rewritten. Another plug-in's account is not ours to take.
 TEST_F(WebosTapTest, UnknownMessage)

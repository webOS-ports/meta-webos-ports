diff --git a/client-utils.cpp b/client-utils.cpp
index 1ad9b70..bdf81a9 100644
--- a/client-utils.cpp
+++ b/client-utils.cpp
@@ -834,6 +834,17 @@ std::string getIncomingGroupchatSenderPurpleName(const td::td_api::chat &chat, c
     return "";
 }
 
+// A chat's title with the signature of who wrote in it, if they signed, as Telegram names it:
+// "News (Ann)". Of a chat not known, the signature alone.
+static std::string getSignedChatName(const td::td_api::chat *chat, const std::string &signature)
+{
+    if (!chat || chat->title_.empty())
+        return signature;
+    if (signature.empty())
+        return chat->title_;
+    return chat->title_ + " (" + signature + ")";
+}
+
 std::string getForwardSource(const td::td_api::messageForwardInfo &forwardInfo,
                              const TdAccountData &account)
 {
@@ -845,10 +856,14 @@ std::string getForwardSource(const td::td_api::messageForwardInfo &forwardInfo,
             return account.getDisplayName(getSenderUserId(static_cast<const td::td_api::messageOriginUser &>(*forwardInfo.origin_)));
         case td::td_api::messageOriginHiddenUser::ID:
             return static_cast<const td::td_api::messageOriginHiddenUser &>(*forwardInfo.origin_).sender_name_;
+        case td::td_api::messageOriginChat::ID: {
+            // Written by a group's anonymous admin, or as the group
+            const auto &origin = static_cast<const td::td_api::messageOriginChat &>(*forwardInfo.origin_);
+            return getSignedChatName(account.getChat(getChatId(origin)), origin.author_signature_);
+        }
         case td::td_api::messageOriginChannel::ID: {
-            const td::td_api::chat *chat = account.getChat(getChatId(static_cast<const td::td_api::messageOriginChannel&>(*forwardInfo.origin_)));
-            if (chat)
-                return chat->title_;
+            const auto &origin = static_cast<const td::td_api::messageOriginChannel &>(*forwardInfo.origin_);
+            return getSignedChatName(account.getChat(getChatId(origin)), origin.author_signature_);
         }
     }
 
diff --git a/identifiers.cpp b/identifiers.cpp

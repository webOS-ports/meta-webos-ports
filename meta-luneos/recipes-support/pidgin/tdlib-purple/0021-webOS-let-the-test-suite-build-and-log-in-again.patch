@@ -1320,6 +1320,12 @@ const char *purple_blist_node_get_string(PurpleBlistNode *node, const char *key)
     return static_cast<const char *>(g_hash_table_lookup(node->settings, key));
 }
 
+// The webOS "muted" and "archived" flags; nothing in the tests reads them back.
+void purple_blist_node_set_bool(PurpleBlistNode *node, const char *key, gboolean value)
+{
+    g_hash_table_insert(node->settings, const_cast<char *>(key), g_strdup(value ? "1" : "0"));
+}
+
 void purple_blist_node_remove_setting(PurpleBlistNode *node, const char *key)
 {
     g_hash_table_remove(node->settings, key);
@@ -1765,6 +1771,29 @@ gulong purple_signal_connect(void *instance, const char *signal,
     return 0;
 }
 
+// The webOS signals (webos-im-outbox-id, webos-im-receipt-hwm, webos-im-send-reaction) go to
+// imlibpurpleservice; nothing listens to them here.
+void purple_signal_emit(void *, const char *, ...)
+{
+}
+
+void *purple_accounts_get_handle()
+{
+    return NULL;
+}
+
+PurpleCore *purple_get_core()
+{
+    return NULL;
+}
+
+// Runs the function once, at once, so what it frees is freed (webos_tg_receipt_emit).
+guint purple_timeout_add(guint, GSourceFunc function, gpointer data)
+{
+    function(data);
+    return 0;
+}

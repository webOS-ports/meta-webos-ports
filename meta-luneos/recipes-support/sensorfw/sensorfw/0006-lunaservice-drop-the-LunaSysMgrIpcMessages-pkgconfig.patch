From 64028432a7af67e45867df8fe5eb3cae5d26032d Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sat, 5 Sep 2026 16:49:39 +0200
Subject: [PATCH] lunaservice: drop the LunaSysMgrIpcMessages pkgconfig
 dependency

lsclient.cpp uses no header from it directly; the include path was only
needed because LunaSysMgrCommon's HostBase.h chain pulls in
SysMgrEvent.h. That header now ships with LunaSysMgrCommon itself, so
its pkgconfig cflags already cover it.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 core/core.pro | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/core/core.pro b/core/core.pro
index 6225e47..d8a98c9 100644
--- a/core/core.pro
+++ b/core/core.pro
@@ -93,7 +93,7 @@ lunaservice {
     HEADERS += lsclient.h
     DEFINES += SENSORFW_LUNA_SERVICE_CLIENT
     PKGCONFIG += Qt$${QT_MAJOR_VERSION}Gui json-c
-    PKGCONFIG += luna-service2 LunaSysMgrCommon LunaSysMgrIpcMessages
+    PKGCONFIG += luna-service2 LunaSysMgrCommon
 }
 
 contains(CONFIG,hybris) {

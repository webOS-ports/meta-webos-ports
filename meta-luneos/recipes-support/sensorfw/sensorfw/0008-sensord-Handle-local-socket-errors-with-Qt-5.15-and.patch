diff --git a/tests/sockethandler/sockethandlertest.cpp b/tests/sockethandler/sockethandlertest.cpp
new file mode 100644
index 0000000..8bd2f19
--- /dev/null
+++ b/tests/sockethandler/sockethandlertest.cpp
@@ -0,0 +1,86 @@
+/**
+   @file sockethandlertest.cpp
+   @brief Automatic tests for SocketHandler
+   <p>

# Speech-Dispatcher for browser_shell.
#
# Chromium's --enable-speech-dispatcher makes it dlopen libspeechd, which
# connects to $XDG_RUNTIME_DIR/speech-dispatcher/speechd.sock and, finding
# nothing there, autospawns a daemon through g_spawn. That spawn closes file
# descriptors Chromium owns, so base::CrashOnFdOwnershipViolation() aborts the
# browser the first time any page touches speechSynthesis - which Cloudflare's
# bot detection does, so it presented as a redirect loop.
#
# Having a daemon already listening on that socket means libspeechd connects
# instead of spawning, and the crash cannot happen.
#
# Runs as wam:compositor because that is what browser_shell runs as, and on
# /tmp/xdg because that is the XDG_RUNTIME_DIR run_browser_shell sets. The
# socket path is given explicitly rather than inherited so the two cannot drift.
[Unit]
Description=Speech-Dispatcher for browser_shell (webOS)
After=surface-manager.service
Requires=surface-manager.service

[Service]
Type=forking
User=wam
Group=compositor
Environment=XDG_RUNTIME_DIR=/tmp/xdg
ExecStartPre=/bin/mkdir -p /tmp/xdg/speech-dispatcher
ExecStart=/usr/bin/speech-dispatcher -d -t 0 -S /tmp/xdg/speech-dispatcher/speechd.sock
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

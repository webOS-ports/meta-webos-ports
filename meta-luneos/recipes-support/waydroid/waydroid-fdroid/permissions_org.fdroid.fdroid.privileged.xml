<?xml version="1.0" encoding="utf-8"?>
<!-- The two privileged permissions the F-Droid Privileged Extension requests
     (its uses-permission list in the f-droid.org index). Android 13 refuses to
     boot a priv-app whose privileged permissions no allowlist grants. -->
<permissions>
    <privapp-permissions package="org.fdroid.fdroid.privileged">
        <permission name="android.permission.DELETE_PACKAGES"/>
        <permission name="android.permission.INSTALL_PACKAGES"/>
    </privapp-permissions>
</permissions>

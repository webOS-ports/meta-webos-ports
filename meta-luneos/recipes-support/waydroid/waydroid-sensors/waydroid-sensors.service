[Unit]
Description=Waydroid sensors daemon
Documentation=https://github.com/waydroid/waydroid-sensors
# The daemon registers android.hardware.sensors@1.0::ISensors on the host side
# of /dev/anbox-hwbinder and answers it from sensorfw, so it has to be up before
# the container looks for the HAL. waydroid-luneos-prepare is what allocates the
# anbox-* binder nodes on a binderfs kernel, so it has to have run first.
After=waydroid-luneos-prepare.service sensorfwd.service
Wants=sensorfwd.service
Before=waydroid-container.service
ConditionPathExists=/dev/anbox-hwbinder
# And nothing to answer until there is a container to answer. The daemon
# registers with the Android servicemanager, which runs *inside* the container,
# so with no container up every transaction comes back "cannot find target
# node" and it retries once a second forever - one kernel log line per second
# for as long as the machine is on. Until waydroid-luneos-prepare learned to
# mount binderfs itself this was hidden on ports with no Halium side: the
# anbox-* nodes never appeared, so the condition above skipped the unit and the
# retry loop was never reached. Same guard waydroid-container.service uses.
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
Type=simple
ExecStart=/usr/bin/waydroid-sensord
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=Waydroid sensors daemon
Documentation=https://github.com/waydroid/waydroid-sensors
# The daemon registers android.hardware.sensors@1.0::ISensors on the host side
# of /dev/anbox-hwbinder and answers it from sensorfw, so it has to be up before
# the container looks for the HAL. waydroid-luneos-prepare is what allocates the
# anbox-* binder nodes on a binderfs kernel, so it has to have run first.
After=waydroid-luneos-prepare.service sensorfwd.service
Wants=sensorfwd.service
Before=waydroid-container.service
ConditionPathExists=/dev/anbox-hwbinder

[Service]
Type=simple
ExecStart=/usr/bin/waydroid-sensord
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

From 6a3364e02ba9b5fd8423083caf1310c58b9e63c9 Mon Sep 17 00:00:00 2001
From: LuneOS <luneos@webos-ports.org>
Date: Wed, 2 Sep 2026 12:57:17 +0200
Subject: [PATCH 1/4] lxc: copy host permissions on non-Treble hosts too

setup_host_perms() returns early unless ro.treble.enabled is true, so on a
Halium host - which is not Treble - none of the vendor permission XML is
copied into the container. Android then advertises hardware it cannot reach.

Measured on mindphone, whose vendor ships
android.hardware.consumerir.xml: without the file the container still
believes it has an IR blaster, and com.android.server.ConsumerIrService
crash-loops looking for a HAL that was never bridged.

The copy list is already conditional on each file existing, so running it
everywhere costs nothing on hosts that have none of them.

Upstream-Status: Pending
---
 tools/helpers/lxc.py | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/tools/helpers/lxc.py b/tools/helpers/lxc.py
index 1b6ff49..b23d388 100644
--- a/tools/helpers/lxc.py
+++ b/tools/helpers/lxc.py
@@ -353,10 +353,6 @@ def setup_host_perms(args):
     if not os.path.exists(tools.config.defaults["host_perms"]):
         os.mkdir(tools.config.defaults["host_perms"])
 
-    treble = tools.helpers.props.host_get(args, "ro.treble.enabled")
-    if treble != "true":
-        return
-
     sku = tools.helpers.props.host_get(args, "ro.boot.product.hardware.sku")
     copy_list = []
     copy_list.extend(

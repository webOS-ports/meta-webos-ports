From 57231d2506697e64028a3d1f2cc3958d21ba9a79 Mon Sep 17 00:00:00 2001
From: LuneOS <luneos@webos-ports.org>
Date: Wed, 2 Sep 2026 12:58:46 +0200
Subject: [PATCH 4/4] user_manager: give every Android app a webOS app

Android was one tile that opened a launcher. This makes each Android
application a webOS application.

Upstream already does the hard part - userUnlocked() enumerates packages
through IPlatform.getAppsInfo(), packageStateChanged() reacts to installs and
removals, and every icon is extracted - it just emits .desktop files, which
webOS has no use for. So this writes one webOS application directory per
launchable package alongside the .desktop file, leaving the same tree usable
on a freedesktop host.

The ids match the windows: hwcomposer sets the Wayland app_id to
"waydroid.<package>", and luna-surfacemanager carries that to
WebOSSurfaceItem::appId, so the card switcher can show an app's own title and
icon and SAM can launch, track and close it.

SAM builds its list once at startup and has no rescan, so the emission tracks
whether the set actually changed and only then restarts sam.service; at boot
the directories are already on disk and nothing is restarted.

system_apps is deliberately not honoured here. Upstream hides those because a
desktop already has a calculator, a clock and a browser; LuneOS mostly does
not, and on the images shipped every launchable package is on that list, so
honouring it would produce an empty launcher.

Upstream-Status: Inappropriate [LuneOS specific]
---
 tools/services/user_manager.py | 126 +++++++++++++++++++++++++++++++++
 1 file changed, 126 insertions(+)

diff --git a/tools/services/user_manager.py b/tools/services/user_manager.py
index 517812f..de51969 100644
--- a/tools/services/user_manager.py
+++ b/tools/services/user_manager.py
@@ -1,6 +1,10 @@
 # Copyright 2021 Erfan Abdi
 # SPDX-License-Identifier: GPL-3.0-or-later
+import json
 import logging
+import os
+import shutil
+import subprocess
 import threading
 import tools.config
 import tools.helpers.net
@@ -91,6 +95,106 @@ def start(args, session, unlocked_cb=None):
             migrated_apps_path.touch()
 
     # Creates, deletes, or updates desktop file
+    # ------------------------------------------------------------ LuneOS apps
+    #
+    # webOS has no .desktop files. It finds applications by scanning the
+    # directories listed in sam-conf.json, each holding an appinfo.json whose
+    # id is the directory name, so an Android app becomes a webOS app by
+    # writing one such directory per package.
+    #
+    # The ids are not free choices. hwcomposer sets the Wayland app_id of a
+    # per-app window to "waydroid.<package>", and luna-surfacemanager carries
+    # that through to WebOSSurfaceItem::appId. Matching the webOS app ids to
+    # those is what lets the card switcher show an app's own title and icon
+    # instead of an anonymous card, and what lets SAM launch, track and close
+    # it.
+    #
+    # SAM builds its application list once, at startup, and offers no rescan -
+    # com.palm.applicationManager/rescan belongs to the legacy manager and does
+    # not reach it. So a set that has actually changed needs sam.service
+    # restarted; at boot the directories are already on disk from the previous
+    # session and nothing needs restarting. Kept behind changed-set tracking so
+    # that stays rare.
+    #
+    # Note this deliberately does not honour system_apps above. Upstream hides
+    # those because a desktop already has a calculator, a clock and a browser;
+    # LuneOS mostly does not, and on the images we ship every launchable package
+    # is on that list - honouring it would produce an empty launcher.
+    #
+    # Everything LuneOS-specific lives in these four functions on purpose: a
+    # rebase onto upstream only has to re-apply the calls to them.
+
+    luneos_apps_dir = os.environ.get(
+        "WAYDROID_LUNEOS_APPS_DIR", "/media/cryptofs/apps/usr/palm/applications")
+
+    def luneosEnabled():
+        return os.path.isdir(os.path.dirname(luneos_apps_dir))
+
+    def luneosAppDir(packageName):
+        return os.path.join(luneos_apps_dir, "waydroid." + packageName)
+
+    def makeLuneosApp(appInfo):
+        """Write one webOS application directory. True if anything changed."""
+        if appInfo is None:
+            return False
+
+        showApp = False
+        for cat in appInfo["categories"]:
+            if cat.strip() == "android.intent.category.LAUNCHER":
+                showApp = True
+                break
+        if not showApp:
+            return removeLuneosApp(appInfo["packageName"])
+
+        packageName = appInfo["packageName"]
+        app_dir = luneosAppDir(packageName)
+        appinfo = {
+            "id": "waydroid." + packageName,
+            "title": appInfo["name"],
+            "version": "1.0.0",
+            "main": "launch.sh",
+            "type": "native",
+            "uiRevision": 2,
+            "vendorurl": "https://waydro.id",
+            "icon": "icon.png",
+        }
+
+        existing = None
+        appinfo_path = os.path.join(app_dir, "appinfo.json")
+        with suppress(OSError, ValueError):
+            with open(appinfo_path) as f:
+                existing = json.load(f)
+        if existing == appinfo and os.path.exists(os.path.join(app_dir, "icon.png")):
+            return False
+
+        os.makedirs(app_dir, exist_ok=True)
+        with open(appinfo_path, "w") as f:
+            json.dump(appinfo, f, indent=4)
+
+        launch_path = os.path.join(app_dir, "launch.sh")
+        with open(launch_path, "w") as f:
+            f.write("#!/bin/sh\nexec /usr/libexec/waydroid-luneos-app {}\n".format(packageName))
+        os.chmod(launch_path, 0o755)
+
+        # Waydroid already extracts every app's icon for the .desktop files.
+        with suppress(OSError):
+            shutil.copyfile(str(waydroid_data_icons_dir / f"{packageName}.png"),
+                            os.path.join(app_dir, "icon.png"))
+        return True
+
+    def removeLuneosApp(packageName):
+        app_dir = luneosAppDir(packageName)
+        if os.path.isdir(app_dir):
+            with suppress(OSError):
+                shutil.rmtree(app_dir)
+            return True
+        return False
+
+    def refreshLuneosApps():
+        logging.info("Android app set changed, restarting SAM to pick it up")
+        with suppress(OSError, subprocess.SubprocessError):
+            subprocess.run(["systemctl", "restart", "sam.service"], timeout=60)
+
     def updateDesktopFile(appInfo):
         if appInfo is None:
             return
@@ -148,6 +252,23 @@ def start(args, session, unlocked_cb=None):
             for existing in apps_dir.glob("waydroid.*.desktop"):
                 if existing.name not in map(lambda appInfo: f"waydroid.{appInfo['packageName']}.desktop", appsList):
                     existing.unlink()
+
+            if luneosEnabled():
+                changed = False
+                wanted = set()
+                for app in appsList:
+                    if makeLuneosApp(app):
+                        changed = True
+                    wanted.add("waydroid." + app["packageName"])
+                # Packages uninstalled while the session was down leave their
+                # directory behind, and a stale tile launches nothing.
+                with suppress(OSError):
+                    for name in os.listdir(luneos_apps_dir):
+                        if name.startswith("waydroid.") and name not in wanted:
+                            if removeLuneosApp(name[len("waydroid."):]):
+                                changed = True
+                if changed:
+                    refreshLuneosApps()
         if unlocked_cb:
             unlocked_cb()
 
@@ -155,11 +276,16 @@ def start(args, session, unlocked_cb=None):
         platformService = IPlatform.get_service(args)
         if platformService:
             desktop_file_path = apps_dir / f"waydroid.{packageName}.desktop"
+            changed = False
             if mode == IUserMonitor.PACKAGE_REMOVED:
                 desktop_file_path.unlink(missing_ok=True)
+                changed = removeLuneosApp(packageName)
             else:
                 appInfo = platformService.getAppInfo(packageName)
                 updateDesktopFile(appInfo)
+                changed = makeLuneosApp(appInfo)
+            if changed and luneosEnabled():
+                refreshLuneosApps()
 
     def service_thread():
         while not stopping:

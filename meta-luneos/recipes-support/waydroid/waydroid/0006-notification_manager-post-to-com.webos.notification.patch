 def start(args, session):
+    # LuneOS has no org.freedesktop.Notifications. Notifications belong to
+    # com.webos.notification, over luna-service2, and it offers several kinds:
+    #
+    #   has actions -> createAlert, the only kind that has buttons, one per
+    #                  Android action
+    #   otherwise   -> createToast, which shows a banner and then collapses
+    #                  into the notification list, which is what an Android
+    #                  notification is expected to do. persistent carries
+    #                  Android's transient flag: a transient one passes and
+    #                  leaves nothing behind.
+    #
+    # createNotification is deliberately not used even though it looks like the
+    # closer match by name and carries the sound and urgency flags. It posts
+    # nothing visible - no banner, and on sargo not even an indicator - so a
+    # notification sent that way arrives and is simply never seen. Measured
+    # both ways on the same device.
+    #
+    # Each kind is closed differently - closeToast, closeAlert - so what was
+    # created is remembered alongside its id.
+    #
+    # Two things do not survive the crossing. Android identifies a notification
+    # by an integer and webOS by a string, so the two are mapped here rather
+    # than leaking either into the other. And image_data is raw pixels while
+    # webOS wants a URI, so the icon Waydroid already extracts for the package
+    # stands in for it.
+    #
+    # A button's onclick is an luna-service2 URI that notificationmgr calls
+    # directly; it cannot re-enter this process, so a button raises the Android
+    # app rather than invoking that specific action, and no listener is called
+    # back. Routing a real action back into Android needs a service on this
+    # side to receive it, which is worth doing separately.
+
+    waydroid_data = session["waydroid_data"]
+    luneos_apps_dir = os.environ.get(
+        "WAYDROID_LUNEOS_APPS_DIR", "/media/cryptofs/apps/usr/palm/applications")
+    # Where the full-UI application itself is installed, which is not the
+    # directory the per-app entries are generated into.
+    webos_apps_dir = os.environ.get("WAYDROID_WEBOS_APPS_DIR", "/usr/palm/applications")
+    # notification id -> (kind, webOS id)
+    posted = {}
+    next_id = [1]
+
+    URGENCY_CRITICAL = 2
+
+    def luna(method, payload):
+        """Call com.webos.notification. Returns the parsed reply, or None."""
+        try:
+            out = subprocess.run(
+                ["luna-send", "-n", "1", "-f",
+                 "luna://com.webos.notification/" + method, json.dumps(payload)],
+                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
+            return json.loads(out.stdout.decode("utf-8"))
+        except (OSError, subprocess.SubprocessError, ValueError) as e:
+            logging.warning("Notification call %s failed: %s", method, e)
+            return None
+
+    def write_png(image_data, path):
+        """Write Android's raw notification icon out as a PNG.
+
+        image_data is a buffer of 8-bit samples - RGB or RGBA, rowstride bytes
+        per row - which is what Android hands over and what webOS cannot take:
+        notificationmgr wants a file. Rather than pull in an image library for
+        one format, this writes the PNG by hand; it is a length, a CRC and a
+        zlib stream per chunk.
+        """
+        channels = 4 if image_data.has_alpha else 3
+        raw = bytearray()
+        data = bytes(image_data.data)
+        for y in range(image_data.height):
+            start = y * image_data.rowstride
+            raw.append(0)  # filter type 0, none
+            raw += data[start:start + image_data.width * channels]
+
+        def chunk(tag, payload):
+            out = struct.pack(">I", len(payload)) + tag + payload
+            return out + struct.pack(">I", binascii.crc32(tag + payload) & 0xffffffff)
+
+        header = struct.pack(">IIBBBBB", image_data.width, image_data.height,
+                             8, 6 if image_data.has_alpha else 2, 0, 0, 0)
+        png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) +
+               chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b""))
+        with open(path, "wb") as f:
+            f.write(png)
 

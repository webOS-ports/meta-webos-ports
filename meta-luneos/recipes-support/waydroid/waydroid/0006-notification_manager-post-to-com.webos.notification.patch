-                8,
-                4 if image_data.has_alpha else 3,
-                dbus.types.Array(image_data.data, signature = "y")
-            ])
-        try:
-            return dbus_proxy.Notify(app_name, replaces_id, app_icon, summary, body, actions_flat, hints, expire_timeout)
-        except dbus.DBusException as e:
-            logging.warning(f"Failed to post notification: {e}")
-            return INotifications.ID_NONE
+        app_id = "waydroid." + package_name
+        launch = {"appId": app_id}
 
-    def closeNotification(notification_id):
-        try:
-            dbus_proxy.CloseNotification(notification_id)
-        except dbus.DBusException as e:
-            logging.warning(f"Failed to close notification: {e}")
+        # Android commonly sends only a summary, so it becomes the message when
+        # there is no body, and the title only when there is one to sit above.
+        # notificationmgr rejects an empty message outright - CA_MSG_EMPTY - and
+        # some notifications carry neither, so fall back to the app's name
+        # rather than posting something that will be thrown away.
+        message = body or summary or app_name or package_name
+        title = summary if body else app_name
+
+        # Only offer an icon that exists. Waydroid extracts one per package,
+        # but not for every source - notifications from the system come from
+        # packages that have none - and notificationmgr silently substitutes
+        # its own generic alert icon for a path it cannot read.
+        icon_path = "{}/icons/{}.png".format(waydroid_data, package_name)
+        icon = "file://" + icon_path if os.path.exists(icon_path) else ""
 
-    def onActivationToken(notification_id, token):
-        pending_tokens[int(notification_id)] = str(token)
+        if replaces_id != INotifications.ID_NONE and replaces_id in posted:
+            close_posted(*posted.pop(replaces_id))
 
-    def onActionInvoked(notification_id, action_id):
-        token = pending_tokens.pop(int(notification_id), "")
-        for listener in listeners:
-            listener.onActionInvoked(int(notification_id), str(action_id), str(token))
+        if transient:
+            kind, method = "toast", "createToast"
+            payload = {
+                "sourceId": app_id,
+                "title": title,
+                "message": message,
+                "onclick": launch,
+                "persistent": False,
+            }
+        elif actions:
+            kind, method = "alert", "createAlert"
+            payload = {
+                "title": title,
+                "message": message,
+                "modal": urgency >= URGENCY_CRITICAL,
+                "buttons": [
+                    {"label": action.label,
+                     "onclick": "luna://com.webos.applicationManager/launch",
+                     "params": {"id": app_id}}
+                    for action in actions
+                ],
+            }
+            if expire_timeout > 0:
+                payload["autoTimeout"] = int(expire_timeout / 1000)
+        else:
+            kind, method = "notification", "createNotification"
+            payload = {
+                "sourceId": app_id,
+                "title": title,
+                "message": message,
+                "onClick": "luna://com.webos.applicationManager/launch",
+                "params": {"id": app_id},
+                "needSoundPlay": not suppress_sound,
+                "forceLcdTurnOn": urgency >= URGENCY_CRITICAL,
+                "isUnDeletable": resident,
+            }
+
+        if icon:
+            payload["iconUrl"] = icon
+
+        reply = luna(method, payload)
+        if not reply or not reply.get("returnValue"):
+            return INotifications.ID_NONE
+        webos_id = reply.get({"toast": "toastId", "alert": "alertId"}.get(kind, "notiId"))
+        if not webos_id:
+            return INotifications.ID_NONE
+
+        notification_id = next_id[0]
+        next_id[0] += 1
+        posted[notification_id] = (kind, webos_id)
+        return notification_id
+
+    def closeNotification(notification_id):
+        entry = posted.pop(int(notification_id), None)
+        if entry:
+            close_posted(*entry)
 
     def service_thread():
         while not stopping:
             INotifications.add_service(args, registerListener, notify, closeNotification)
 

-import dbus
 
 stopping = False
-bus_signals = []
 
 def start(args, session):
+    # LuneOS has no org.freedesktop.Notifications. Notifications belong to
+    # com.webos.notification, over luna-service2, and it offers several kinds
+    # rather than one - so the kind is chosen from what Android said about the
+    # notification instead of flattening everything into a toast:
+    #
+    #   transient        -> createToast, a banner that passes and leaves
+    #                       nothing behind, which is what transient means
+    #   has actions      -> createAlert, the only kind with buttons, one per
+    #                       Android action
+    #   everything else  -> createNotification, which persists in the list and
+    #                       carries the sound and urgency flags
+    #
+    # Each kind is closed differently - closeToast, closeAlert,
+    # removeNotification - so what was created is remembered alongside its id.
+    #
+    # Two things do not survive the crossing. Android identifies a notification
+    # by an integer and webOS by a string, so the two are mapped here rather
+    # than leaking either into the other. And image_data is raw pixels while
+    # webOS wants a URI, so the icon Waydroid already extracts for the package
+    # stands in for it.
+    #
+    # A button's onclick is an luna-service2 URI that notificationmgr calls
+    # directly; it cannot re-enter this process, so a button raises the Android
+    # app rather than invoking that specific action, and no listener is called
+    # back. Routing a real action back into Android needs a service on this
+    # side to receive it, which is worth doing separately.
+
+    waydroid_data = session["waydroid_data"]
+    # notification id -> (kind, webOS id)
+    posted = {}
+    next_id = [1]
+
+    URGENCY_CRITICAL = 2
+
+    def luna(method, payload):
+        """Call com.webos.notification. Returns the parsed reply, or None."""
+        try:
+            out = subprocess.run(
+                ["luna-send", "-n", "1", "-f",
+                 "luna://com.webos.notification/" + method, json.dumps(payload)],
+                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
+            return json.loads(out.stdout.decode("utf-8"))
+        except (OSError, subprocess.SubprocessError, ValueError) as e:
+            logging.warning("Notification call %s failed: %s", method, e)
+            return None
 
     def onListenerDeath(listener):
         listeners.remove(listener)
@@ -20,67 +65,98 @@ def start(args, session):
         listener.addDeathHandler(onListenerDeath)
         listeners.append(listener)
 
+    def close_posted(kind, webos_id):
+        if kind == "toast":
+            luna("closeToast", {"toastId": webos_id})
+        elif kind == "alert":
+            luna("closeAlert", {"alertId": webos_id})
+        else:
+            luna("removeNotification", {"removeNotiId": [webos_id]})
+
     def notify(replaces_id, app_name, package_name, summary, body, actions, image_data, category, suppress_sound, expire_timeout, resident, transient, urgency):

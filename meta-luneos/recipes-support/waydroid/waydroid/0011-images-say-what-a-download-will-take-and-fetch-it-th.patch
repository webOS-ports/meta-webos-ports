+# Copyright 2026 Herman van Hazendonk
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# LuneOS: luna-service2 from Python, and what the image download tells the
+# user while it runs.
+#
+# There are no Python bindings for luna-service2 here, so every call goes
+# through luna-send, the way notification_manager already does. A luna-send
+# client is com.webos.lunasend on the bus, which is allowed to call both
+# com.webos.notification and com.webos.service.downloadmanager.
+import json
+import logging
+import os
+import subprocess
+
+LUNA_SEND = "/usr/bin/luna-send"
+
+# Shared with the LuneOS launcher, which reads it to say how far a download
+# that is already running has got, and to report why one failed.
+STATE_FILE = "/run/waydroid-luneos/download.json"
+
+# The dashboard that shows the download in the notification list, and keeps
+# showing it current; a QML app the LuneOS recipe ships next to Waydroid.
+DASHBOARD = "org.webosports.app.waydroid.download"
+
+
+def available():
+    return os.access(LUNA_SEND, os.X_OK)
+
+
+def call(uri, payload, timeout=10):
+    """ One call through luna-send.
+
+        :returns: the reply as a dict, or None when there was no usable one """
+    if not available():
+        return None
+    try:
+        out = subprocess.run([LUNA_SEND, "-n", "1", uri, json.dumps(payload)],
+                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                             timeout=timeout, check=False)
+        reply = json.loads(out.stdout.decode("utf-8", "replace"))
+    except (OSError, subprocess.SubprocessError, ValueError) as e:
+        logging.debug("luna-send {} failed: {}".format(uri, e))
+        return None
+    return reply if isinstance(reply, dict) else None
+
+
+def megabytes(n):
+    """ Sizes as the user is shown them: decimal, like upstream's progress. """
+    if n >= 10**9:
+        return "{:.1f} GB".format(n / 10**9)
+    return "{} MB".format(max(1, round(n / 10**6)))
+
+
+def write_state(**state):
+    """ Replaces the state file in one step, so a reader never sees half. """
+    if not available():
+        return
+    try:
+        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
+        tmp = STATE_FILE + ".tmp"
+        # The pid lets a reader tell a download that is still going from one
+        # whose process was killed without writing its end.
+        state["pid"] = os.getpid()
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump(state, f)
+        os.replace(tmp, STATE_FILE)
+    except OSError as e:
+        logging.debug("Could not write {}: {}".format(STATE_FILE, e))
+
+
+class DownloadProgress:
+    """ Progress of one batch of image downloads, told to the user.
+
+        The state file gets every update downloadmgr sends - about twenty per
+        file - and the dashboard (DASHBOARD) shows it from there, as one entry
+        in the notification list that stays current until the install is
+        done.
+
+        Without the dashboard there are only toasts, and a toast cannot be
+        updated: the closest thing is closing it and posting the next, and
+        every post pops a banner. So then the toast is replaced at a few
+        milestones instead. """
+
+    MILESTONE = 25
+
+    def __init__(self, total):
+        self.total = total
+        self.done = 0
+        self.toast_id = None
+        self.shown = 0
+        self.dashboard = False
+
+    def _toast(self, message, kind="standard"):
+        self.close()
+        reply = call("luna://com.webos.notification/createToast", {
+            "sourceId": "Waydroid",
+            "title": "Waydroid",
+            "message": message,
+            # "standard" stays in the notification list after its banner, so
+            # it can be found again mid-download; "light" is the banner alone.
+            "type": kind,
+            # Tapping it asks the launcher where things stand, and that
+            # answer is where the download can be stopped.
+            "onclick": {"appId": "Waydroid", "params": {"download": "status"}},
+        })
+        if reply and reply.get("returnValue"):
+            self.toast_id = reply.get("toastId")
+
+    def close(self):
+        if self.toast_id:
+            call("luna://com.webos.notification/closeToast",
+                 {"toastId": self.toast_id})
+            self.toast_id = None
+
+    def start(self):
+        """ Says what is being fetched before any of it arrives: the first
+            update can already be past a milestone, and the size is the one
+            thing the user most needs to see. """
+        write_state(state="downloading", received=0, total=self.total,
+                    percent=0)
+        self.shown = 0
+        reply = call("luna://com.webos.applicationManager/launch",
+                     {"id": DASHBOARD})
+        self.dashboard = bool(reply and reply.get("returnValue"))
+        # With the dashboard in the list a banner is all that is needed to
+        # say it started; without it, this toast is the list entry.
+        self._toast("Downloading Android: {}".format(megabytes(self.total)),
+                    "light" if self.dashboard else "standard")
+        if self.dashboard:
+            # A banner goes by itself; there is nothing to close.
+            self.toast_id = None
+
+    def update(self, received):
+        """ received: bytes of the file being downloaded now """
+        now = min(self.done + received, self.total) if self.total else 0
+        percent = now * 100 // self.total if self.total else 0
+        write_state(state="downloading", received=now, total=self.total,
+                    percent=percent)
+        step = percent // self.MILESTONE * self.MILESTONE
+        if not self.dashboard and self.shown < step < 100:
+            self.shown = step
+            self._toast("Downloading Android: {}% of {}".format(
+                step, megabytes(self.total)))
+
+    def file_done(self, size):
+        self.done += size
+
+    def extracting(self, name):
+        write_state(state="extracting", received=self.done, total=self.total,
+                    percent=min(100, self.done * 100 // max(self.total, 1)),
+                    image=name)
+        if not self.dashboard:
+            self._toast("Installing the Android {} image".format(name))
+
+    def finished(self):
+        self.close()
+        write_state(state="done", received=self.total, total=self.total,
+                    percent=100)
+
+    def failed(self, error):
+        self.close()
+        write_state(state="failed", received=self.done, total=self.total,
+                    error=str(error))

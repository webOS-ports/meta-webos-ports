diff --git a/tools/helpers/http.py b/tools/helpers/http.py
index 9131fb7..a8c4bde 100644
--- a/tools/helpers/http.py
+++ b/tools/helpers/http.py
@@ -1,18 +1,251 @@
 # Copyright 2021 Oliver Smith
 # SPDX-License-Identifier: GPL-3.0-or-later
 import hashlib
+import io
+import json
 import logging
 import os
+import selectors
 import shutil
+import signal
+import subprocess
 import threading
 import urllib.request
+import zipfile
 
+import tools.helpers.luna
 import tools.helpers.run
 import time
 
+# LuneOS: luna-downloadmgr does the transfer when it is there, so a download of
+# the best part of a gigabyte is one the system knows about - it holds a wake
+# lock for it, pauses it when the network goes and resumes it when the network
+# comes back, and reports how far it has got.
+DOWNLOADMGR = "luna://com.webos.service.downloadmanager/"
+# The manager only accepts a targetDir under /media/internal from a caller that
+# is not privileged, which luna-send is not.
+LUNA_DOWNLOAD_DIR = "/media/internal/downloads/waydroid"
+# How long a transfer may go without a byte arriving before it is given up on.
+# It covers a lost network too: downloadmgr pauses then, and resumes on its own
+# if the network is back in time.
+LUNA_STALL_TIMEOUT = 600
+
+
+def use_downloadmgr():
+    if not tools.helpers.luna.available():
+        return False
+    reply = tools.helpers.luna.call(DOWNLOADMGR + "listPending", {})
+    return bool(reply and reply.get("returnValue"))
+
+
+def download_dir(args):
+    """ Where download() puts what it fetches. """
+    if use_downloadmgr():
+        return LUNA_DOWNLOAD_DIR
+    return args.work + "/cache_http"
+
+
+def _cancel_stale_luna_downloads():
+    """ Cancels what an earlier run left behind in LUNA_DOWNLOAD_DIR.
+
+        downloadmgr outlives whoever asked it for a file, and it resumes
+        interrupted downloads by itself when it starts - so an init that was
+        killed part way would otherwise leave a download of hundreds of MB
+        running, or coming back after a reboot, with nobody waiting for it. """
+    reply = tools.helpers.luna.call(DOWNLOADMGR + "getAllHistory",
+                                    {"owner": "com.webos.lunasend"})
+    for item in (reply or {}).get("items", []):
+        if item.get("state") not in ("running", "queued", "interrupted"):
+            continue
+        try:
+            record = json.loads(item.get("recordString") or "{}")
+        except ValueError:
+            continue
+        if record.get("destPath", "").rstrip("/") == LUNA_DOWNLOAD_DIR:
+            logging.info("Cancelling an earlier download of {}".format(
+                record.get("destFile")))
+            tools.helpers.luna.call(DOWNLOADMGR + "cancelDownload",
+                                    {"ticket": item["ticket"]})
+
+
+class DownloadStopped(SystemExit):
+    """ A download stopped by SIGTERM: what stopping the unit that runs init
+        does. Exits 143, as dying of the signal would, which the unit counts
+        as success - stopping it was asked for - and reads as below. """
+
+    def __init__(self):
+        super().__init__(143)
+
+    def __str__(self):
+        return "Download stopped"
+
+
+def _luna_download(url, path, on_progress):
+    """ Fetches url to path through luna-downloadmgr.
+
+        :returns: the path the file was saved at """
+    target_dir, filename = os.path.split(path)
+    os.makedirs(target_dir, exist_ok=True)
+    _cancel_stale_luna_downloads()
+    request = {"target": url, "targetDir": target_dir,
+               "targetFilename": filename,
+               "canHandlePause": True, "autoResume": True,
+               "subscribe": True}
+    proc = subprocess.Popen(
+        [tools.helpers.luna.LUNA_SEND, "-i", DOWNLOADMGR + "download",
+         json.dumps(request)],
+        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+
+    # Stopping the unit that runs this sends SIGTERM, which would otherwise
+    # end Python without running the finally below, and leave downloadmgr
+    # fetching for nobody.
+    def on_term(signum, frame):
+        raise DownloadStopped()
+    old_term = None
+    if threading.current_thread() is threading.main_thread():
+        old_term = signal.signal(signal.SIGTERM, on_term)
+
+    ticket = None
+    finished = False
+    fd = proc.stdout.fileno()
+    sel = selectors.DefaultSelector()
+    sel.register(fd, selectors.EVENT_READ)
+    try:
+        unread = b""
+        received = -1
+        last_byte_at = time.monotonic()
+        while True:
+            idle = time.monotonic() - last_byte_at
+            if idle >= LUNA_STALL_TIMEOUT:
+                raise RuntimeError("Download stalled: nothing arrived for {}"
+                                   " minutes".format(LUNA_STALL_TIMEOUT // 60))
+            # Lines already read come first. Several replies can arrive in
+            # one read - the last update and the completion often do - and
+            # select() only reports what is still in the pipe, so waiting
+            # on it with a reply in hand would wait for good.
+            line, newline, rest = unread.partition(b"\n")
+            if not newline:
+                if not sel.select(LUNA_STALL_TIMEOUT - idle):
+                    continue
+                chunk = os.read(fd, 65536)
+                if not chunk:
+                    raise RuntimeError("luna-downloadmgr stopped answering")
+                unread += chunk
+                continue
+            unread = rest
+            try:
+                reply = json.loads(line.decode("utf-8", "replace"))
+            except ValueError:
+                continue
+            if not isinstance(reply, dict):
+                continue
+            if ticket is None and "ticket" in reply:
+                ticket = reply["ticket"]
+            if reply.get("returnValue") is False:
+                raise RuntimeError("luna-downloadmgr refused the download: {}"
+                                   .format(reply.get("errorText")))
+
+            if "completed" in reply:
+                code = reply.get("completionStatusCode")
+                if reply.get("completed") and code == 200:
+                    finished = True
+                    return reply.get("target") or path
+                if reply.get("interrupted"):
+                    # Paused, usually because the network went. With
+                    # autoResume set the same ticket carries on when it is
+                    # back, and its updates still arrive here.
+                    logging.info("Download paused; waiting for the network")
+                    continue
+                if reply.get("aborted"):
+                    raise RuntimeError("Download cancelled")
+                raise RuntimeError("Download failed: HTTP {}, status {}".format(
+                    reply.get("httpStatus"), code))
+
+            if "e_amountReceived" in reply:
+                # The 64-bit count, as a string. amountReceived is an int32,
+                # which a file over 2 GiB would overflow.
+                try:
+                    n = int(reply["e_amountReceived"])
+                except ValueError:
+                    continue
+                if n != received:
+                    last_byte_at = time.monotonic()
+                received = n
+                if on_progress:
+                    on_progress(n)
+    finally:
+        if old_term is not None:
+            signal.signal(signal.SIGTERM, old_term)
+        if not finished and ticket is not None:
+            tools.helpers.luna.call(DOWNLOADMGR + "cancelDownload",
+                                    {"ticket": ticket})
+        sel.close()
+        proc.stdout.close()
+        if proc.poll() is None:
+            proc.terminate()
+        proc.wait()
+
+
+class _RangeReader(io.RawIOBase):
+    """ A remote file, read in pieces with HTTP Range requests. """
+
+    def __init__(self, url, timeout):
+        self.timeout = timeout
+        head = urllib.request.Request(url, method="HEAD")
+        with urllib.request.urlopen(head, timeout=timeout) as r:
+            # Ask the mirror the redirects ended at, not the redirector.
+            self.url = r.geturl()
+            self.size = int(r.headers["Content-Length"])
+        self.pos = 0
+
+    def readable(self):
+        return True
+
+    def seekable(self):
+        return True
+
+    def tell(self):
+        return self.pos
+
+    def seek(self, offset, whence=io.SEEK_SET):
+        base = {io.SEEK_SET: 0, io.SEEK_CUR: self.pos,
+                io.SEEK_END: self.size}[whence]
+        self.pos = base + offset
+        return self.pos
+
+    def readinto(self, b):
+        n = min(len(b), self.size - self.pos)
+        if n <= 0:
+            return 0
+        req = urllib.request.Request(self.url, headers={
+            "Range": "bytes={}-{}".format(self.pos, self.pos + n - 1)})
+        with urllib.request.urlopen(req, timeout=self.timeout) as r:
+            # A server that ignores Range answers 200 with the whole file.
+            if r.status != 206:
+                raise OSError("server ignored the Range request")
+            data = r.read(n)
+        b[:len(data)] = data
+        self.pos += len(data)
+        return len(data)
+
+
+def unpacked_size(url, timeout=20):
+    """ The total size of what the zip at url unpacks to, or None.
+
+        Read from the zip's central directory, which is at the end of the
+        file, so it costs a few small Range requests rather than the
+        download. Best effort: anything that goes wrong answers None. """
+    try:
+        reader = io.BufferedReader(_RangeReader(url, timeout), 64 * 1024)
+        with zipfile.ZipFile(reader) as z:
+            return sum(i.file_size for i in z.infolist())
+    except Exception as e:
+        logging.debug("Could not read the size inside {}: {}".format(url, e))
+        return None
+
 
 def download(args, url, prefix, cache=True, loglevel=logging.INFO,
-             allow_404=False):
+             allow_404=False, on_progress=None):
     """ Download a file to disk.
 
         :param url: the http(s) address of to the file to download
@@ -26,8 +259,21 @@ def download(args, url, prefix, cache=True, loglevel=logging.INFO,
         :param allow_404: do not raise an exception when the server responds
                           with a 404 Not Found error. Only display a warning on
                           stdout (no matter if loglevel is changed).
+        :param on_progress: called now and then with the bytes received so far
         :returns: path to the downloaded file in the cache or None on 404 """
 
+    if use_downloadmgr():
+        path = LUNA_DOWNLOAD_DIR + "/" + prefix.replace("/", "_")
+        if os.path.exists(path):
+            if cache:
+                return path
+            os.remove(path)
+        logging.log(loglevel, "Downloading {} through luna-downloadmgr"
+                    .format(url))
+        # allow_404 is not honoured here: downloadmgr reports a 404 as a
+        # failed transfer, and nothing that reaches this path passes it.
+        return _luna_download(url, path, on_progress)
+
     # helper functions for progress
     def fromBytesToMB(numBytes, decimalPlaces=2):
         return round(int(numBytes)/1000000, decimalPlaces)
@@ -88,6 +334,8 @@ def download(args, url, prefix, cache=True, loglevel=logging.INFO,
 
             # print progress bar
             print(f"\r[Downloading] {currentSize} MB/{totalSize} MB    {downloadSpeed}(approx.)", end=" ")
+            if on_progress:
+                on_progress(os.path.getsize(destinationPath))
             time.sleep(2)
 
     # Create cache folder

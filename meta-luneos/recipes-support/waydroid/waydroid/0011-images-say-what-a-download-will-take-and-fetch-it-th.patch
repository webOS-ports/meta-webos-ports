+def _device_and_free(path):
+    """ The filesystem path is on, and the bytes free on it. """
+    while not os.path.exists(path):
+        path = os.path.dirname(path)
+    st = os.statvfs(path)
+    return os.stat(path).st_dev, st.f_bavail * st.f_frsize
+
+
+def plan(args):
+    """ What get() would download, and the room that needs, as a dict:
+
+          download   bytes to fetch
+          files      kind, filename, size and unpacked size of each zip;
+                     unpacked is None where it could not be read
+          space      for each filesystem written to: path, needed, free
+
+        Nothing is downloaded. """
+    picks = pending(args)
+    files = []
+    for kind, response in picks:
+        files.append({"kind": kind,
+                      "filename": response['filename'],
+                      "size": int(response.get('size') or 0),
+                      "unpacked": helpers.http.unpacked_size(response['url'])})
+
+    # get() fetches one zip at a time and deletes it once it is unpacked, so
+    # the worst moment is the end of unpacking: every image so far on disk,
+    # next to the zip it came out of. The zips and the images can be on
+    # different filesystems - /media/internal and /var are separate mounts.
+    # An unpacked size that could not be read counts as nothing, which makes
+    # the result a lower bound rather than a guess.
+    download_dir = helpers.http.download_dir(args)
+    zip_dev, zip_free = _device_and_free(download_dir)
+    img_dev, img_free = _device_and_free(args.images_path)
+    path = {zip_dev: download_dir, img_dev: args.images_path}
+    free = {zip_dev: zip_free, img_dev: img_free}
+    needed = {zip_dev: 0, img_dev: 0}
+    images = 0
+    for f in files:
+        images += f["unpacked"] or 0
+        use = {zip_dev: 0, img_dev: 0}
+        use[img_dev] += images
+        use[zip_dev] += f["size"]
+        for dev in use:
+            needed[dev] = max(needed[dev], use[dev])
+
+    return {"download": sum(f["size"] for f in files),
+            "files": files,
+            "space": [{"path": path[dev], "needed": needed[dev],
+                       "free": free[dev]} for dev in needed]}
+
+
 def validate(args, channel, f):
     # Verify that the zip comes from the channel
     cfg = tools.config.load(args)

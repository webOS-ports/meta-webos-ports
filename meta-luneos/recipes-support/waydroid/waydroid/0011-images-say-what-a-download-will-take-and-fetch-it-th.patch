+def write_plan(args):
+    """ waydroid init --plan FILE: what init would download and the room that
+        needs, worked out the way init works it out, with nothing downloaded
+        and nothing configured.
+
+        LuneOS asks before it fetches the best part of a gigabyte, and this is
+        where the size it quotes comes from. """
+    # setup_config saves what it works out. Keep that away from the real
+    # config: its existence is what tells the LuneOS units Waydroid is set up,
+    # so a config with no images behind it would have the container started
+    # at the next boot.
+    args.config = args.plan + ".cfg"
+    with suppress(OSError):
+        os.remove(args.config)
+    try:
+        if not setup_config(args):
+            return False
+        if args.images_path in tools.config.defaults["preinstalled_images_paths"]:
+            plan = {"download": 0, "files": [], "space": []}
+        else:
+            plan = helpers.images.plan(args)
+    finally:
+        with suppress(OSError):
+            os.remove(args.config)
+    tmp = args.plan + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(plan, f)
+    os.replace(tmp, args.plan)
+    return True
+
 def init(args):
+    if getattr(args, "plan", None):
+        return write_plan(args)
+
     if is_initialized(args) and not args.force:
         logging.info("Already initialized")
 

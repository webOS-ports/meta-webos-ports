[Unit]
Description=Waydroid Container
Requires=surface-manager.service
# Nothing to start until "waydroid init" has fetched the images and written a
# config. Without this the unit fails on every boot of a device that has not
# been initialised yet, which is noise at best and, when something is ordered
# after it, a failure that propagates.
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
BusName=id.waydro.Container
EnvironmentFile=/etc/id.waydro.Container/waydroid.env
ExecStartPre=/bin/mkdir -p /tmp/luna-session
ExecStartPre=/bin/ln -sfn /tmp/luna-session /run/luna-session
ExecStart=/usr/bin/waydroid -w container start

[Install]
WantedBy=multi-user.target

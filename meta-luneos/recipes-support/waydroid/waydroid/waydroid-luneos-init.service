[Unit]
Description=Download and install the Android images for Waydroid
# Started on demand by waydroid-luneos-app once the user has agreed to the
# download, and never at boot - hence no [Install] section. A boot-time
# "waydroid init" is what used to fail on a freshly flashed device with no
# network yet, and take the container down with it through the ordering.
#
# It is a unit rather than a child of the launcher so that the download does
# not belong to the card. SAM ends a native app by signalling its process, and
# it does that on every relaunch too, which is what an alert's button or a
# second tap on the icon is - a download run by the launcher itself died with
# it, close to a gigabyte in. "systemctl start" on a oneshot waits for it to
# finish, so a launcher that wants the result still gets it, and a second
# launcher that asks while it runs joins the same job instead of starting
# another.
#
# Stopping it is how the download is cancelled: the SIGTERM reaches "waydroid
# init", which cancels its ticket at luna-downloadmgr before it exits.
Wants=waydroid-luneos-prepare.service
After=waydroid-luneos-prepare.service

[Service]
Type=oneshot
ExecStart=/usr/bin/waydroid init
# About a gigabyte on a slow link takes as long as it takes. Nothing hangs
# here unnoticed: the download gives up by itself after ten minutes in which
# no byte arrived.
TimeoutStartSec=infinity
# Stopping it is a cancel, not a failure: "waydroid init" exits 143 then.
SuccessExitStatus=143

[Unit]
Description=Warm launcher for Waydroid apps
# The session owns the Wayland connection Android composites through; there is
# nothing to launch into before it is up.
After=waydroid-luneos-session.service
BindsTo=waydroid-luneos-session.service
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
Type=simple
# Holds the imports and the binder connection that "waydroid app launch" pays
# for on every invocation - about thirteen seconds of them on a cold sargo.
# Paying that here, once, is the whole point, so start it with the session
# rather than on demand.
ExecStart=/usr/libexec/waydroid-luneos-launchd
RuntimeDirectory=waydroid-luneos
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5

[Install]
# Pulled in by the session rather than by multi-user.target, so it comes back
# whenever the session does. BindsTo above only takes it down with the session;
# without this it stayed down, and the first launch after any session restart
# fell back to the slow waydroid CLI - which a plain reboot reproduces, since
# the session restarts once on the way up.
WantedBy=waydroid-luneos-session.service

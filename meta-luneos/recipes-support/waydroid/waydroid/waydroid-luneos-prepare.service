[Unit]
Description=Prepare host state for the Waydroid container
# Binder nodes and the image bind mount have to exist before the container
# service reads them, and waydroid-init runs "waydroid init", which needs the
# images already in place.
Before=waydroid-init.service waydroid-container.service
# Ordering matters and local-fs.target is not enough. Two of the steps depend
# on mounts the Halium side brings up later: the binder nodes need binderfs,
# and bridging a host GPU HAL needs /vendor, which is a symlink to
# /android/vendor. Run too early and both are silently skipped - the service
# still succeeds, and the failure only shows up as a container that will not
# start. Naming units that may not exist on a given machine is harmless:
# After= on an absent unit is ignored.
After=local-fs.target dev-binderfs.mount android-vendor.mount android.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/waydroid-luneos-prepare
# Best effort: a machine may legitimately have nothing to do here, and a
# failure should surface in the journal rather than block the boot.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target

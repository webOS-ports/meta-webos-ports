[Unit]
Description=Prepare host state for the Waydroid container
# Binder nodes and the image bind mount have to exist before the container
# service reads them, and waydroid-init runs "waydroid init", which needs the
# images already in place.
Before=waydroid-init.service waydroid-container.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/waydroid-luneos-prepare
# Best effort: a machine may legitimately have nothing to do here, and a
# failure should surface in the journal rather than block the boot.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target

[Unit]
Description=Waydroid session for the LuneOS compositor
After=waydroid-container.service surface-manager.service
Requires=waydroid-container.service
# Only meaningful once "waydroid init" has produced a config.
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
Type=simple
# Run the host preparation again before starting the session.
#
# The unit of the same name has to run Before= waydroid-init.service, because
# the container needs its binder nodes and images in place first. But two of
# the things it does - ro.radio.noril and no_background_subsurface - are
# written into waydroid_base.prop, which "waydroid init" is what creates. On a
# first install that file does not exist yet when it runs, so those steps
# no-op and Android comes up with telephony crashing and its content in a
# subsurface until something runs prepare a second time.
#
# Here the config is guaranteed to exist (ConditionPathExists above) and
# make_prop has not read it yet, since that happens inside "waydroid session
# start". Every step in the script is idempotent, so repeating it is cheap.
ExecStartPre=/usr/libexec/waydroid-luneos-prepare
ExecStart=/usr/libexec/waydroid-luneos-session
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

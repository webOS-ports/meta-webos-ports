[Unit]
Description=Release wakeup sources a frozen Waydroid container holds
# Without it the phone never suspends once Android has been frozen with an
# alarm timer pending; see /usr/libexec/waydroid-luneos-thaw.
After=waydroid-container.service
BindsTo=waydroid-container.service
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
Type=simple
ExecStart=/usr/libexec/waydroid-luneos-thaw
Restart=on-failure
RestartSec=5

[Install]
WantedBy=waydroid-container.service

# Waydroid host preparation, mindphone (MT6739, PowerVR Rogue, 32-bit).
#
# No WAYDROID_IMAGES_DIR here. The images used to be bind mounted from userdata
# because the target was /etc/waydroid-extra/images, which lives on the rootfs -
# a 2.4G loop image with a few hundred MB free. Moving the target to
# /var/lib/waydroid/images to keep the OTA channel also moved it off the loop:
# /var is its own mount on the 25.6G userdata partition, so the bytes already
# land where there is room and the bind buys nothing. It cost something, though.
# Nothing creates the source directory, so it only ever existed where one had
# been made by hand, and bind_images treats a missing source as fatal - on a
# freshly flashed image prepare exited 1, and since it is the session's
# ExecStartPre, Waydroid never started at all.

# MTK's libEGL_mtk.so dlopens this out of /vendor/lib/hw, which Waydroid does
# not bind into the container - only /vendor/lib/egl. Without it SurfaceFlinger
# fails eglInitialize and Android never finishes booting.
WAYDROID_HOST_HAL_LIBS="gralloc.rogue.so gralloc.default.so"

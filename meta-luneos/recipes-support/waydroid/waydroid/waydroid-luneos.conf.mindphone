# Waydroid host preparation, mindphone (MT6739, PowerVR Rogue, 32-bit).
#
# The rootfs is a 2.4G loop image with a few hundred MB free, so the ~1.2G of
# Android images cannot live in it. They go on userdata and are bind mounted
# over /var/lib/waydroid/images, which is where Waydroid downloads them - so
# the machine keeps using the OTA channel and can still be updated.
WAYDROID_IMAGES_DIR=/userdata/waydroid-images

# MTK's libEGL_mtk.so dlopens this out of /vendor/lib/hw, which Waydroid does
# not bind into the container - only /vendor/lib/egl. Without it SurfaceFlinger
# fails eglInitialize and Android never finishes booting.
WAYDROID_HOST_HAL_LIBS="gralloc.rogue.so gralloc.default.so"

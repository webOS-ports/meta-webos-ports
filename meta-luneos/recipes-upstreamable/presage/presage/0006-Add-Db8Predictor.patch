+#ifndef PRESAGE_DB8PREDICTOR
+#define PRESAGE_DB8PREDICTOR
+
+#include "predictor.h"
+#include "../core/dispatcher.h"
+
+#include <luna-service2/lunaservice.h>
+
+#include <vector>
+#include <string>
+
+
+/** db8 dictionary predictive predictor.
+ *
+ * Same idea as DictionaryPredictor - prefix-matches tokens out of a
+ * word list - except the word list lives in webOS's db8 rather than a
+ * flat file. A standing db8 subscription keeps an in-memory copy of
+ * the current word list up to date; predict() only ever reads that
+ * copy, so a keystroke never waits on the bus.
+ *
+ * KIND names the db8 kind to read (one record per word, in a "word"
+ * property - the shape org.webosports.app.settings' Text Assist page
+ * already keeps its user dictionary in). PROBABILITY works the same
+ * way DictionaryPredictor's does.
+ */
+class Db8Predictor : public Predictor, public Observer {
+public:
+    Db8Predictor (Configuration*, ContextTracker*, const char*);
+    ~Db8Predictor();
+
+    virtual Prediction predict (const size_t size, const char** filter) const;
+
+    virtual void learn (const std::vector<std::string>& change);
+
+    virtual void update (const Observable* variable);
+
+    void set_kind (const std::string& value);
+    void set_probability (const std::string& value);
+
+private:
+    void connect();
+    void findWords();
+    void handleFindResult(const char* payload);
+
+    static bool findCallback(LSHandle* handle, LSMessage* message, void* ctx);
+
+    std::string LOGGER;
+    std::string KIND;
+    std::string PROBABILITY;
+
+    std::string kind;
+    double probability;
+
+    LSHandle* serviceHandle;
+    std::vector<std::string> words;
+
+    Dispatcher<Db8Predictor> dispatcher;
+};
+
+#endif // PRESAGE_DB8PREDICTOR

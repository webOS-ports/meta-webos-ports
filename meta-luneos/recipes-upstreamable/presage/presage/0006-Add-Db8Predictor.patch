+        <UserDictionaryPredictor>
+            <PREDICTOR>Db8Predictor</PREDICTOR>
+            <LOGGER>ERROR</LOGGER>
+            <KIND>org.webosports.app.settings.dictionary:1</KIND>
+            <PROBABILITY>0.0001</PROBABILITY>
+        </UserDictionaryPredictor>
         <DefaultAbbreviationExpansionPredictor>
             <PREDICTOR>AbbreviationExpansionPredictor</PREDICTOR>
             <LOGGER>ERROR</LOGGER>

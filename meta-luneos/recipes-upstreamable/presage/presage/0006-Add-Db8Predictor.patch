 src/lib/predictors/Makefile.am          |  12 +-
 src/lib/predictors/db8Predictor.cpp     | 292 ++++++++++++++++++++++++
 src/lib/predictors/db8Predictor.h       | 116 ++++++++++
 7 files changed, 478 insertions(+), 2 deletions(-)

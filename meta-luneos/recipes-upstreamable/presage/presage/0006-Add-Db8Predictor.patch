new file mode 100644
index 0000000..79dd202
--- /dev/null
+++ b/src/lib/predictors/db8Predictor.cpp
@@ -0,0 +1,292 @@
+/******************************************************
+ *  Presage, an extensible predictive text entry system
+ *  ---------------------------------------------------
+ *
+ *  Copyright (C) 2026 Herman van Hazendonk <github.com@herrie.org>
+ *
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 2 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License along
+    with this program; if not, write to the Free Software Foundation, Inc.,
+    51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+                                                                             *
+                                                                **********(*)*/
+
+#include "db8Predictor.h"
+
+#include <json-c/json.h>
+
+// LSRegister("org.webosports.presage.dictionary", ...) + LSGmainAttach against
+// the default GMainContext is the same pattern webos-keyboard's own
+// KeyboardSettings class already uses successfully inside this same process
+// (MaliitServer) to subscribe to com.webos.service.systemservice - see
+// src/plugin/keyboardsettings.cpp there. Copied deliberately rather than
+// reinvented, since that is proof the glib/Qt event loop integration this
+// relies on actually delivers subscription callbacks in this process.
+
+Db8Predictor::Db8Predictor (Configuration* config, ContextTracker* ht, const char* name)
+    : Predictor(config,
+	     ht,
+	     name,
+	     "Db8Predictor, db8 dictionary lookup",
+	     "Db8Predictor, a dictionary based predictor that generates a prediction by extracting tokens that start with the current prefix from a webOS db8 kind"
+	     ),
+      serviceHandle (0),
+      pollSource (0),
+      watchToken (LSMESSAGE_TOKEN_INVALID),
+      dispatcher (this)
+{
+    LOGGER      = PREDICTORS + name + ".LOGGER";
+    KIND        = PREDICTORS + name + ".KIND";
+    PROBABILITY = PREDICTORS + name + ".PROBABILITY";
+
+    // build notification dispatch map
+    dispatcher.map (config->find (LOGGER), & Db8Predictor::set_logger);
+    dispatcher.map (config->find (KIND), & Db8Predictor::set_kind);
+    dispatcher.map (config->find (PROBABILITY), & Db8Predictor::set_probability);
+
+    connect();
+}
+
+Db8Predictor::~Db8Predictor()
+{
+    // Stop the timer first: it is the one thing that would still run this
+    // object's code from the main loop once the destructor returns.
+    if (pollSource) {
+        g_source_remove(pollSource);
+        pollSource = 0;
+    }
+
+    if (serviceHandle) {
+        LSError error;
+        LSErrorInit(&error);
+        if (watchToken != LSMESSAGE_TOKEN_INVALID &&
+            !LSCallCancel(serviceHandle, watchToken, &error)) {
+            logger << ERROR << "LSCallCancel failed: " << error.message << endl;
+            LSErrorFree(&error);
+            LSErrorInit(&error);
+        }
+        watchToken = LSMESSAGE_TOKEN_INVALID;
+        // Also drops the one-shot refresh calls still in flight, so their
+        // replies never reach findCallback with this object as context.
+        if (!LSUnregister(serviceHandle, &error)) {
+            logger << ERROR << "LSUnregister failed: " << error.message << endl;
+            LSErrorFree(&error);
+        }
+    }
+}
+
+void Db8Predictor::connect()
+{
+    LSError error;
+    LSErrorInit(&error);
+
+    if (!LSRegister("org.webosports.presage.dictionary", &serviceHandle, &error)) {
+        logger << ERROR << "LSRegister failed: " << error.message << endl;
+        LSErrorFree(&error);
+        serviceHandle = 0;
+        return;
+    }
+
+    // LSGmainAttach only uses the loop to find its context, so the loop
+    // itself can go straight away instead of leaking one per predictor.
+    GMainLoop* loop = g_main_loop_new(g_main_context_default(), FALSE);
+    const bool attached = LSGmainAttach(serviceHandle, loop, &error);
+    g_main_loop_unref(loop);
+    if (!attached) {
+        logger << ERROR << "LSGmainAttach failed: " << error.message << endl;
+        LSErrorFree(&error);
+        return;
+    }
+
+    // The actual freshness mechanism - see the header comment for why this
+    // exists instead of relying on watch alone. Registered exactly once,
+    // for the life of this predictor; pollCallback no-ops until kind is
+    // known.
+    // Removed again in the destructor (see pollSource).
+    pollSource = g_timeout_add_seconds(POLL_INTERVAL_SECONDS, Db8Predictor::pollCallback, this);
+
+    if (!kind.empty())
+        findWordsAndWatch();
+}
+
+void Db8Predictor::set_kind (const std::string& value)
+{
+    kind = value;
+    logger << INFO << "KIND: " << value << endl;
+
+    if (serviceHandle)
+        findWordsAndWatch();
+}
+
+
+void Db8Predictor::set_probability (const std::string& value)
+{
+    probability = Utility::toDouble (value);
+    logger << INFO << "PROBABILITY: " << value << endl;
+}
+
+// Registers ONE long-lived find, with "watch":true alongside "query" (the
+// db8 API's actual live-notification flag - see the header comment). Call
+// this exactly once per kind: the subscription it creates keeps delivering
+// "fired" notifications on its own for as long as it stays open, so it
+// must never be re-registered from inside handleFindResult().
+void Db8Predictor::findWordsAndWatch()
+{
+    LSError error;
+    LSErrorInit(&error);
+
+    std::string payload = "{\"query\":{\"from\":\"" + kind + "\",\"orderBy\":\"word\"},\"watch\":true}";
+
+    // A new kind replaces the watch on the old one rather than adding to it.
+    if (watchToken != LSMESSAGE_TOKEN_INVALID) {
+        if (!LSCallCancel(serviceHandle, watchToken, &error)) {
+            logger << ERROR << "LSCallCancel failed: " << error.message << endl;
+            LSErrorFree(&error);
+            LSErrorInit(&error);
+        }
+        watchToken = LSMESSAGE_TOKEN_INVALID;
+    }
+
+    if (!LSCall(serviceHandle, "luna://com.palm.db/find", payload.c_str(),
+                Db8Predictor::findCallback, this, &watchToken, &error)) {
+        logger << ERROR << "com.palm.db/find failed: " << error.message << endl;
+        LSErrorFree(&error);
+    }
+}
+
+// One-shot refresh, no watch - used to pick up what changed once the
+// standing subscription above reports a fired notification.
+void Db8Predictor::refreshWords()
+{
+    LSError error;
+    LSErrorInit(&error);
+
+    std::string payload = "{\"query\":{\"from\":\"" + kind + "\",\"orderBy\":\"word\"}}";
+
+    if (!LSCall(serviceHandle, "luna://com.palm.db/find", payload.c_str(),
+                Db8Predictor::findCallback, this, NULL, &error)) {
+        logger << ERROR << "com.palm.db/find failed: " << error.message << endl;
+        LSErrorFree(&error);
+    }
+}
+
+bool Db8Predictor::findCallback(LSHandle* handle, LSMessage* message, void* ctx)
+{
+    (void) handle;
+
+    if (!message)
+        return true;
+
+    const char* payload = LSMessageGetPayload(message);
+    if (!payload)
+        return true;
+
+    Db8Predictor* self = static_cast<Db8Predictor*>(ctx);
+    self->handleFindResult(payload);
+
+    return true;
+}
+
+void Db8Predictor::handleFindResult(const char* payload)
+{
+    json_object* root = json_tokener_parse(payload);
+    if (!root) {
+        logger << ERROR << "Could not parse com.palm.db/find reply" << endl;
+        return;
+    }
+
+    json_object* resultsObj = 0;
+    if (json_object_object_get_ex(root, "results", &resultsObj) &&
+        json_object_is_type(resultsObj, json_type_array)) {
+        std::vector<std::string> newWords;
+        const size_t count = json_object_array_length(resultsObj);
+        for (size_t i = 0; i < count; i++) {
+            json_object* entry = json_object_array_get_idx(resultsObj, i);
+            json_object* wordObj = 0;
+            if (entry && json_object_object_get_ex(entry, "word", &wordObj) &&
+                json_object_is_type(wordObj, json_type_string)) {
+                newWords.push_back(json_object_get_string(wordObj));
+            }
+        }
+
+        words = newWords;
+        logger << INFO << "Loaded " << words.size() << " words from " << kind << endl;
+    }
+
+    // The find+watch subscription's later replies carry "fired":true when
+    // the result set changes, and may or may not repeat "results" - fetch
+    // it explicitly with a plain one-shot find rather than relying on
+    // that. This does NOT re-register the watch: the original find+watch
+    // call stays open and keeps delivering future fired notifications by
+    // itself. (Re-registering here was the infinite-loop bug - see the
+    // header comment.)
+    json_object* firedObj = 0;
+    bool fired = json_object_object_get_ex(root, "fired", &firedObj)
+                 && json_object_get_boolean(firedObj);
+
+    json_object_put(root);
+
+    if (fired)
+        refreshWords();
+}
+
+// Fires on a fixed POLL_INTERVAL_SECONDS cadence for the life of this
+// predictor - see the header comment for why this, and not watch alone,
+// is what actually keeps words current. Returns TRUE (via G_SOURCE_CONTINUE)
+// unconditionally so glib keeps calling it; it cannot loop tighter than
+// its own fixed interval, unlike re-arming a watch from its own handler.
+gboolean Db8Predictor::pollCallback(gpointer ctx)
+{
+    Db8Predictor* self = static_cast<Db8Predictor*>(ctx);
+    if (!self->kind.empty())
+        self->refreshWords();
+    return G_SOURCE_CONTINUE;
+}
+
+Prediction Db8Predictor::predict(const size_t max_partial_predictions_size, const char** filter) const
+{
+    Prediction result;
+
+    std::string prefix = contextTracker->getPrefix();
+
+    unsigned int count = 0;
+    for (std::vector<std::string>::const_iterator it = words.begin();
+         it != words.end() && count < max_partial_predictions_size;
+         it++)
+    {
+        const std::string& candidate = *it;
+        if (candidate.find(prefix) == 0) {
+            if (token_satisfies_filter(candidate, prefix, filter)) {
+                result.addSuggestion(Suggestion(candidate, probability));
+                count++;
+            }
+        }
+    }
+
+    return result;
+}
+
+void Db8Predictor::learn(const std::vector<std::string>& change)
+{
+    // Nothing yet asks Presage to learn from what was typed (see
+    // WesternLanguagesPlugin::wordCandidateSelected in webos-keyboard, which
+    // is currently an empty stub) - matches DictionaryPredictor's own
+    // no-op here for the same reason. Words this predictor knows about
+    // come from db8 exclusively, via the subscription above.
+    (void) change;
+}
+
+void Db8Predictor::update (const Observable* var)
+{
+    logger << DEBUG << "About to invoke dispatcher: " << var->get_name () << " - " << var->get_value() << endl;
+    dispatcher.dispatch (var);
+}

diff --git a/configure.ac b/configure.ac
index c933e19..be52a33 100644
--- a/configure.ac
+++ b/configure.ac
@@ -198,6 +198,35 @@ fi
 AM_CONDITIONAL([USE_SQLITE], [test "x$use_sqlite" = "xyes"])
 
 
+dnl =========================================================
+dnl Checks for luna-service2 and json-c, needed by Db8Predictor
+dnl (webOS-ports specific; upstream presage has no notion of
+dnl either). Non-fatal and undetected by default: only the
+dnl webOS target build of this recipe asks for these via
+dnl DEPENDS, and the native variant (used for build-time tools
+dnl like text2ngram) must configure and build fine without them.
+
+have_db8predictor=yes
+
+# luna-service2's own lunaservice.h #includes <glib.h> directly, but its .pc
+# does not expose glib-2.0's cflags to a plain (non-static) pkg-config query -
+# presumably a private Requires there. webos-keyboard never hit this because
+# Qt already pulls glib into its include path some other way; presage has no
+# such path of its own, so it has to ask for glib-2.0 explicitly too.
+PKG_CHECK_MODULES([LUNASERVICE2], [luna-service2 glib-2.0],
+                   [],
+                   [have_db8predictor=no])
+PKG_CHECK_MODULES([JSONC], [json-c],
+                   [],
+                   [have_db8predictor=no])
+
+if test "x$have_db8predictor" = "xyes"
+then
+    AC_DEFINE([USE_DB8PREDICTOR], [1], [Define to 1 if webOS db8 (luna-service2 + json-c) is available for Db8Predictor])
+fi
+AM_CONDITIONAL([USE_DB8PREDICTOR], [test "x$have_db8predictor" = "xyes"])
+
+

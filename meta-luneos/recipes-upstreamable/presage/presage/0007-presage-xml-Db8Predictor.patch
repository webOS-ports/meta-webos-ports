From 8fed9b01e5d62f75c2c301143e8af21716a1f193 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 4 Sep 2026 09:20:26 +0200
Subject: [PATCH 2/2] presage.xml.template: activate UserDictionaryPredictor
 (Db8Predictor)

Wires Db8Predictor (0006-Add-Db8Predictor.patch) into the shipped
config: added to the active PREDICTORS list, and a new predictor
block pointed at org.webosports.app.settings.dictionary:1, the db8
kind org.webosports.app.settings' Text Assist page already keeps its
user dictionary in.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [webOS-ports specific]
---
 resources/profiles/presage.xml.template | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/resources/profiles/presage.xml.template b/resources/profiles/presage.xml.template
index 9b5db66..f4a32db 100644
--- a/resources/profiles/presage.xml.template
+++ b/resources/profiles/presage.xml.template
@@ -5,7 +5,7 @@
         <!-- PREDICTORS
 	     Space separated list of predictors to use to generate predictions
         -->
-        <PREDICTORS>DefaultAbbreviationExpansionPredictor DefaultSmoothedNgramPredictor UserSmoothedNgramPredictor DefaultRecencyPredictor</PREDICTORS>
+        <PREDICTORS>DefaultAbbreviationExpansionPredictor DefaultSmoothedNgramPredictor UserSmoothedNgramPredictor DefaultRecencyPredictor UserDictionaryPredictor</PREDICTORS>
     </PredictorRegistry>
     <ContextTracker>
         <LOGGER>ERROR</LOGGER>
@@ -119,6 +119,19 @@
             <!-- fixed probability assigned to prediction -->
             <PROBABILITY>0.000001</PROBABILITY>
         </DefaultDictionaryPredictor>
+        <!-- webOS-ports: org.webosports.app.settings' Text Assist page keeps
+             its user dictionary in db8, under this kind. A short,
+             user-curated list, so a much higher fixed probability than
+             DefaultDictionaryPredictor's ~100k-word system dictionary above
+             gets - these are words the user explicitly asked for. Falls out
+             of the build entirely (USE_DB8PREDICTOR) wherever
+             luna-service2/json-c are not available, e.g. presage-native. -->
+        <UserDictionaryPredictor>
+            <PREDICTOR>Db8Predictor</PREDICTOR>
+            <LOGGER>ERROR</LOGGER>
+            <KIND>org.webosports.app.settings.dictionary:1</KIND>
+            <PROBABILITY>0.0001</PROBABILITY>
+        </UserDictionaryPredictor>
         <DefaultAbbreviationExpansionPredictor>
             <PREDICTOR>AbbreviationExpansionPredictor</PREDICTOR>
             <LOGGER>ERROR</LOGGER>
-- 

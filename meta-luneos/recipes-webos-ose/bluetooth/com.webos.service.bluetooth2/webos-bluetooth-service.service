[Unit]
Description=meta-webos - "%n"
Requires=ls-hubd.service bluetooth.service
# bluetooth-mesh is deliberately not pulled in here. bluetooth-meshd never
# finishes starting on halium devices - systemd times the start out after 90s
# and Restart=on-failure then retries it forever (a restart counter of 174 was
# observed within hours), which is a permanent hourly CPU and journal drain
# for a feature that never comes up. Keep the ordering so a manually started
# meshd still sorts before us; whoever fixes mesh can restore the Wants.
After=ls-hubd.service bluetooth.service bluetooth-mesh.service

[Service]
Type=simple
EnvironmentFile=-/var/systemd/system/env/webos-bluetooth-service.env
ExecStartPre=/lib/systemd/system/scripts/webos-bluetooth-service.sh
ExecStart=/usr/sbin/webos-bluetooth-service
Restart=on-failure

From 4ad68ec63fdc69cf9f047461685a3c52b83838fa Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sun, 15 Nov 2026 07:56:57 +0100
Subject: [PATCH] DefaultBootSequencer: launch no LG system UI apps on boot

0001 kept LG's com.webos.app.notification and com.webos.app.volume in the
boot apps. LuneOS does not use either: the compositor (luna-next-cardshell)
draws the notifications, the volume popup and the system menu's volume
slider itself, and nothing ever shows those apps' windows. bootd launched
them on every boot all the same: the volume app stayed in WebAppMgr
(about 33 MB PSS on qemux86-64) and logged a schema error from audiod on
each master/getVolume, and the notification app closed itself and was
killed seconds later. LuneOS no longer ships either app.

The list of boot apps is left empty, with the loops that launch it, so
an app can be put back in one place.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [LuneOS specific, applies on top of 0001 and 0003]
---
 src/bootd/sequencer/DefaultBootSequencer.cpp | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/src/bootd/sequencer/DefaultBootSequencer.cpp b/src/bootd/sequencer/DefaultBootSequencer.cpp
index a817844..c1cebbf 100644
--- a/src/bootd/sequencer/DefaultBootSequencer.cpp
+++ b/src/bootd/sequencer/DefaultBootSequencer.cpp
@@ -38,9 +38,10 @@ void DefaultBootSequencer::doBoot()
         "com.palm.systemui"
         */
     };
+    // LG's com.webos.app.notification and com.webos.app.volume were
+    // launched from here; LuneOS does not ship them: the compositor draws the
+    // notifications and the volume popup itself.
     std::vector<std::string> startupAppsOnBoot = {
-        "com.webos.app.notification",
-        "com.webos.app.volume"
         /* these will be started by LunaAppManager !
         "org.webosports.app.phone",
         "com.palm.app.email",
@@ -68,12 +69,12 @@ void DefaultBootSequencer::doBoot()
     proceedDataStoreInitStart();
     ApplicationManager::instance()->listLaunchPoints(&m_bootManager, EventCoreTimeout::EventCoreTimeout_Max);
 
-    // Signal the boot stages before launching the boot apps, not after. Both
-    // apps are web apps, so their launch waits for WebAppMgr to come up and
-    // retries every 5 seconds until it does; with the signals behind them,
+    // Signal the boot stages before launching any boot apps, not after. A
+    // web app's launch waits for WebAppMgr to come up and retries every 5
+    // seconds until it does; with the signals behind such a launch,
     // everything started on minimal/rest-boot-done - notificationmgr among
     // it - waited for that too, half a minute after the UI was up on a slow
-    // device. The apps still launch as soon as WebAppMgr can take them.
+    // device.
     proceedMinimalBootDone();
     proceedRestBootDone();
     proceedBootDone();
-- 

From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Nov 2026 05:25:16 +0100
Subject: [PATCH] cros: build the V8 snapshot toolchain for the build host's CPU

mksnapshot and the other V8 snapshot tools (bytecode_builtins_list_generator
and gen-regexp-special-case among them) run on the build host, but
both v8_snapshot toolchains hardcode current_cpu to x64, or x86 for a 32-bit
target. On an aarch64 build host they are then compiled for x86-64 and the
build stops before compiling anything:

  ninja: error: '.../clang/latest/lib/x86_64-unknown-linux-gnu/libclang_rt.builtins.a',
  needed by 'v8_snapshot_clang_arm64/obj/.../libcpp.a', missing and no known
  rule to make it

and even with that runtime present the tools could not run there. Use
host_cpu for 64-bit targets, and the 32-bit counterpart of the host's
architecture (arm on an arm host, x86 otherwise) for 32-bit targets. On an
x86-64 host the result is unchanged.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
Upstream-Status: Pending
---

diff --git a/src/build/toolchain/cros/BUILD.gn b/src/build/toolchain/cros/BUILD.gn
index 64e96d5..708275c 100644
--- a/src/build/toolchain/cros/BUILD.gn
+++ b/src/build/toolchain/cros/BUILD.gn
@@ -38,10 +38,16 @@ clang_toolchain("host") {
 
 clang_toolchain("v8_snapshot") {
   toolchain_args = {
+    # mksnapshot runs on the build host: build it for the host's CPU, with
+    # the target's pointer width.
     if (target_cpu == "x86" || target_cpu == "arm" || target_cpu == "mipsel") {
-      current_cpu = "x86"
+      if (host_cpu == "arm64" || host_cpu == "arm") {
+        current_cpu = "arm"
+      } else {
+        current_cpu = "x86"
+      }
     } else {
-      current_cpu = "x64"
+      current_cpu = host_cpu
     }
     v8_current_cpu = v8_target_cpu
     current_os = "linux"
@@ -63,10 +69,16 @@ clang_toolchain("v8_snapshot_clang_${target_cpu}") {
   toolchain_args = {
     is_clang = true
     use_custom_libcxx = true
+    # mksnapshot runs on the build host: build it for the host's CPU, with
+    # the target's pointer width.
     if (target_cpu == "x86" || target_cpu == "arm" || target_cpu == "mipsel") {
-      current_cpu = "x86"
+      if (host_cpu == "arm64" || host_cpu == "arm") {
+        current_cpu = "arm"
+      } else {
+        current_cpu = "x86"
+      }
     } else {
-      current_cpu = "x64"
+      current_cpu = host_cpu
     }
     v8_current_cpu = v8_target_cpu
     current_os = "linux"

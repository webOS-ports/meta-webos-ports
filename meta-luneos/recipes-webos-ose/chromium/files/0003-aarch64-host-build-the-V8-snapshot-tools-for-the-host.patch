From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS aarch64 host fixes <luneos@localhost>
Date: Tue, 27 Oct 2026 00:00:00 +0000
Subject: [PATCH] aarch64 host: build the V8 snapshot tools for the host

build/toolchain/cros pins both v8_snapshot toolchains to current_cpu = "x64"
for every 64-bit target. That encodes an x86_64 build host: on an aarch64
host building for arm64, mksnapshot, torque and the other V8 generators come
out as x86_64 binaries the host cannot execute, and building them needs an
x86_64 libc, x86_64 compiler-rt builtins and x86_64 Rust std that an aarch64
host does not have. Build them for the host instead, which is what upstream's
v8/gni/snapshot_toolchain.gni does when host_cpu == v8_target_cpu.

With that, current_cpu == target_cpu holds for the snapshot toolchain too, so
rust.gni's check that stamps OE's vendor (-webos) on target toolchains would
select the target's Rust std for it. Exclude it by name: it builds host tools
with no sysroot and wants the host std (aarch64-unknown-linux-gnu).

An x86_64 host is unaffected: host_cpu is x64 there, so neither branch is
taken. The recipe applies this patch only when BUILD_ARCH is aarch64.

Upstream-Status: Inappropriate [OE/LuneOS specific]
---

diff --git a/src/build/config/rust.gni b/src/build/config/rust.gni
index 3fa7f3d..0c1fe18 100644
--- a/src/build/config/rust.gni
+++ b/src/build/config/rust.gni
@@ -238,7 +238,13 @@ if (is_linux || is_chromeos) {
   #   target "x86_64-webos-linux-gnu"
   # Comparing against target_cpu keeps the native build unchanged, where the
   # target toolchain's current_cpu already equals target_cpu.
+  # On an aarch64 build host building for arm64, the v8 snapshot toolchain is
+  # arm64 too, so current_cpu == target_cpu no longer tells it apart from the
+  # target. It builds host tools without a sysroot, so it must use the host's
+  # Rust std (aarch64-unknown-linux-gnu), not OE's target triple.
   if (!is_host && current_cpu == target_cpu &&
+      current_toolchain !=
+          "//build/toolchain/cros:v8_snapshot_clang_${target_cpu}" &&
       rust_target_triple_vendor_for_target != "") {
     vendor = rust_target_triple_vendor_for_target
   }
diff --git a/src/build/toolchain/cros/BUILD.gn b/src/build/toolchain/cros/BUILD.gn
index 64e96d5..40e534e 100644
--- a/src/build/toolchain/cros/BUILD.gn
+++ b/src/build/toolchain/cros/BUILD.gn
@@ -40,6 +40,13 @@ clang_toolchain("v8_snapshot") {
   toolchain_args = {
     if (target_cpu == "x86" || target_cpu == "arm" || target_cpu == "mipsel") {
       current_cpu = "x86"
+    } else if (host_cpu == "arm64" && target_cpu == "arm64") {
+      # aarch64 build host: mksnapshot and the other V8 build tools run on
+      # the host, so build them for it. "x64" would produce binaries the host
+      # cannot execute (and that need an x86_64 libc and compiler-rt that an
+      # aarch64 host does not have). Same as upstream's snapshot_toolchain.gni,
+      # which uses the host toolchain when host_cpu == v8_target_cpu.
+      current_cpu = "arm64"
     } else {
       current_cpu = "x64"
     }
@@ -65,6 +72,13 @@ clang_toolchain("v8_snapshot_clang_${target_cpu}") {
     use_custom_libcxx = true
     if (target_cpu == "x86" || target_cpu == "arm" || target_cpu == "mipsel") {
       current_cpu = "x86"
+    } else if (host_cpu == "arm64" && target_cpu == "arm64") {
+      # aarch64 build host: mksnapshot and the other V8 build tools run on
+      # the host, so build them for it. "x64" would produce binaries the host
+      # cannot execute (and that need an x86_64 libc and compiler-rt that an
+      # aarch64 host does not have). Same as upstream's snapshot_toolchain.gni,
+      # which uses the host toolchain when host_cpu == v8_target_cpu.
+      current_cpu = "arm64"
     } else {
       current_cpu = "x64"
     }

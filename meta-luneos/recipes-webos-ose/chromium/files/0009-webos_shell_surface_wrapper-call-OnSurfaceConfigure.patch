From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS Porter <luneos@webos-ports.org>
Date: Wed, 9 Sep 2026 14:15:00 -0400
Subject: [PATCH] webos_shell_surface_wrapper: call OnSurfaceConfigureEvent on
 state and client size changes

In Chromium 120 Ozone Wayland, WaylandFrameManager::MaybeProcessPendingFrame
blocks all buffer attachments until WaylandWindow::received_configure_event_
is true. Because wl_webos_shell_surface does not use standard xdg configure
events, received_configure_event_ was never set when running under WebOS shell,
causing all web apps to deadlock and never attach buffers to their Wayland
surfaces.

Notify WaylandWindow via OnSurfaceConfigureEvent() in both StateChanged and
ClientSizeChanged so pending frames can be processed.

Upstream-Status: Inappropriate [LuneOS specific]
---
 src/ui/ozone/platform/wayland/extensions/webos/host/webos_shell_surface_wrapper.cc | 2 ++
 1 file changed, 2 insertions(+)

--- a/src/ui/ozone/platform/wayland/extensions/webos/host/webos_shell_surface_wrapper.cc
+++ b/src/ui/ozone/platform/wayland/extensions/webos/host/webos_shell_surface_wrapper.cc
@@ -258,6 +258,7 @@ void WebosShellSurfaceWrapper::StateChanged(
         ToPlatformWindowState(state));
     shell_surface_wrapper->wayland_window_->HandleActivationChanged(
         ToActivationState(state));
+    shell_surface_wrapper->wayland_window_->OnSurfaceConfigureEvent();
   } else {
     LOG(INFO) << __PRETTY_FUNCTION__ << ": state=" << state
               << ", but no window for this shell";
@@ -291,6 +292,7 @@ void WebosShellSurfaceWrapper::ClientSizeChanged(
   if (shell_surface_wrapper->wayland_window_) {
     VLOG(1) << __PRETTY_FUNCTION__ << ": size=" << width << "," << height;
     shell_surface_wrapper->wayland_window_->SetBoundsInPixels(gfx::Rect(0,0,width,height));
+    shell_surface_wrapper->wayland_window_->OnSurfaceConfigureEvent();
   } else {
     LOG(INFO) << __PRETTY_FUNCTION__ << ": size=" << width << "," << height
               << ", but no window for this shell";

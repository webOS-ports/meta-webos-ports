From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS / webOS Ports <team@webos-ports.org>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: [PATCH] tflite: pass std::abs through lambdas

libc++ no longer offers std::abs as a template, so std::abs<float> cannot be
named and passed as a callable:

  error: no matching function for call to 'EvalImpl'
  note: no overload of 'abs' matching 'std::function<float (float)>'

Wrap the calls in lambdas, which keeps the same semantics without depending on
which abs overloads exist.

Upstream-Status: Pending
---
--- a/src/third_party/tflite/src/tensorflow/lite/kernels/elementwise.cc
+++ b/src/third_party/tflite/src/tensorflow/lite/kernels/elementwise.cc
@@ -293,7 +293,8 @@
   const TfLiteType type = input->type;
   switch (type) {
     case kTfLiteFloat32:
-      return EvalImpl<float>(context, node, std::abs<float>, type);
+      return EvalImpl<float>(
+          context, node, [](float v) { return std::abs(v); }, type);
     case kTfLiteInt8:
       return AbsEvalQuantized<int8_t>(context, node, type);
     case kTfLiteInt16:
@@ -301,7 +302,8 @@
                  ? AbsInt16EvalImpl(context, node, type)
                  : AbsEvalQuantized<int16_t>(context, node, type);
     case kTfLiteInt32:
-      return EvalImpl<int32_t>(context, node, std::abs<int32_t>, type);
+      return EvalImpl<int32_t>(
+          context, node, [](int32_t v) { return std::abs(v); }, type);
     default:
       TF_LITE_KERNEL_LOG(context, "Current data type %s is not supported.",
                          TfLiteTypeGetName(type));

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS / webOS Ports <team@webos-ports.org>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: [PATCH] quiche: call Size(), which is what QuicIntervalDeque provides

  error: no member named 'size' in 'quic::QuicIntervalDeque<T, C>'

Two DCHECKs in the iterator call deque_->size(), but the class only ever
declared Size() (and the surrounding code uses deque_->container_.size()).
The calls could never have compiled if instantiated; clang now diagnoses them
regardless. Size() returns container_.size(), which is what the checks want.

Upstream-Status: Pending
---
--- a/src/net/third_party/quiche/src/quiche/quic/core/quic_interval_deque.h
+++ b/src/net/third_party/quiche/src/quiche/quic/core/quic_interval_deque.h
@@ -198,12 +198,12 @@
     Iterator operator+(difference_type amount) const {
       Iterator copy = *this;
       copy.index_ += amount;
-      QUICHE_DCHECK(copy.index_ < copy.deque_->size());
+      QUICHE_DCHECK(copy.index_ < copy.deque_->Size());
       return copy;
     }
     Iterator& operator+=(difference_type amount) {
       index_ += amount;
-      QUICHE_DCHECK(index_ < deque_->size());
+      QUICHE_DCHECK(index_ < deque_->Size());
       return *this;
     }
     difference_type operator-(const Iterator& rhs) const {

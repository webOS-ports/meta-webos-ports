From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS / webOS Ports <team@webos-ports.org>
Date: Thu, 14 Aug 2026 00:00:00 +0000
Subject: [PATCH] base: fix IDMap::Iterator copy assignment

  error: no member named 'map' in 'base::IDMap::Iterator<ReturnType>'
  error: no member named 'iter' in 'base::IDMap::Iterator<ReturnType>'

The members are map_ and iter_, as the copy constructor three lines above uses
correctly. Nothing copy-assigns an IDMap::Iterator, so the template was never
instantiated and the typo never compiled.

Upstream-Status: Pending
---
--- a/src/base/containers/id_map.h
+++ b/src/base/containers/id_map.h
@@ -178,8 +178,8 @@
     }
 
     const Iterator& operator=(const Iterator& iter) {
-      map_ = iter.map;
-      iter_ = iter.iter;
+      map_ = iter.map_;
+      iter_ = iter.iter_;
       Init();
       return *this;
     }

From 13fe921ea1a9c21226b0187f81b4e37c27b83319 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 4 Sep 2026 09:19:27 +0200
Subject: [PATCH] com.webos.service.ime: add allowed names for the db8-backed
 dictionary predictors

org.webosports.keyboard.dictionary (webos-keyboard's SpellChecker) and
org.webosports.presage.dictionary (presage's new Db8Predictor) both
register their own LS2 identity inside MaliitServer - same reasoning
as org.maliit already does here, a process registering the same
service name twice fails the second call, and both need it to call
out to com.palm.db (database.operation) to read
org.webosports.app.settings' user dictionary kind. Neither needs
anything else org.maliit already has, so kept to the one group
instead of copying org.maliit's whole permission set for two clients
that only ever call db8.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [LuneOS specific]
---
 service/com.webos.service.ime.perm.json    |  6 ++++++
 service/com.webos.service.ime.role.json.in | 10 +++++++++-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/service/com.webos.service.ime.perm.json b/service/com.webos.service.ime.perm.json
index 6e9d399..8797538 100755
--- a/service/com.webos.service.ime.perm.json
+++ b/service/com.webos.service.ime.perm.json
@@ -26,5 +26,11 @@
         "systemsettings.management",
         "systemsettings.query",
         "tts.operation"
+    ],
+    "org.webosports.keyboard.dictionary": [
+        "database.operation"
+    ],
+    "org.webosports.presage.dictionary": [
+        "database.operation"
     ]
 }
diff --git a/service/com.webos.service.ime.role.json.in b/service/com.webos.service.ime.role.json.in
index 82865cb..5285863 100755
--- a/service/com.webos.service.ime.role.json.in
+++ b/service/com.webos.service.ime.role.json.in
@@ -2,7 +2,7 @@
     \"exeName\":\"$$WEBOS_INSTALL_BINS/MaliitServer\",
     \"type\":\"privileged\",
     \"trustLevel\":\"oem\",
-    \"allowedNames\":[\"com.webos.service.ime*\",\"org.maliit\"],
+    \"allowedNames\":[\"com.webos.service.ime*\",\"org.maliit\",\"org.webosports.keyboard.dictionary\",\"org.webosports.presage.dictionary\"],
     \"permissions\":[
         {
             \"service\":\"com.webos.service.ime*\",
@@ -15,6 +15,14 @@
             \"outbound\":[\"com.webos.notification\",\"com.webos.service.tts\",\"com.webos.settingsservice\",\"com.webos.service.config\",
             \"com.webos.service.nlp\",\"com.webos.audio\",\"com.webos.service.applicationmanager\",\"com.webos.service.bluetooth\",
             \"com.webos.service.mrcu\",\"org.maliit\"]
+        },
+        {
+            \"service\":\"org.webosports.keyboard.dictionary\",
+            \"outbound\":[\"com.palm.db\"]
+        },
+        {
+            \"service\":\"org.webosports.presage.dictionary\",
+            \"outbound\":[\"com.palm.db\"]
         }
     ]
 }
-- 

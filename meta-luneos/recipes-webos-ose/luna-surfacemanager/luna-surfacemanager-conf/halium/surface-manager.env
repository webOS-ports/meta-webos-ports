# Halium default. Identical on every Halium device except the touchscreen node
# in WEBOS_COMPOSITOR_EXTRA_OPTIONS, which luneos-device-config's
# 20-surface-manager-env generator substitutes at runtime - exactly one input
# device advertises ID_INPUT_TOUCHSCREEN, so it needs no per-device knowledge.
#
# event1 is a graceful default rather than a placeholder token, so a device
# still gets a working compositor if the generator does not run.
QT_IM_MODULE=Maliit
EGL_PLATFORM=hwcomposer
WEBOS_COMPOSITOR_PLATFORM=hwcomposer
WEBOS_COMPOSITOR_EXTRA_OPTIONS="-plugin evdevtouch:/dev/input/event1 -plugin evdevkeyboard"
QT_ENABLE_HIGHDPI_SCALING=0

# Halium default. Identical on every Halium device except the touchscreen node
# in WEBOS_COMPOSITOR_EXTRA_OPTIONS, which luneos-device-config's
# 20-surface-manager-env generator substitutes at runtime - exactly one input
# device advertises ID_INPUT_TOUCHSCREEN, so it needs no per-device knowledge.
#
# The node below is a placeholder, not a default. event1 happens to be the
# touchscreen on sargo, which is precisely the problem: it would be right often
# enough that the devices where it silently pointed at something else - a
# headset jack, a fingerprint sensor - would be hard to spot. An obviously
# invalid path means a compositor with no touch, which is noticed immediately.
QT_IM_MODULE=Maliit
EGL_PLATFORM=hwcomposer
WEBOS_COMPOSITOR_PLATFORM=hwcomposer
WEBOS_COMPOSITOR_EXTRA_OPTIONS="-plugin evdevtouch:/dev/input/PLACEHOLDER -plugin evdevkeyboard"
QT_ENABLE_HIGHDPI_SCALING=0

From 7a5e29e92b3a1a1f0a1a2b3c4d5e6f7a8b9c0d1e Mon Sep 17 00:00:00 2001
From: Andrew <andrew@luneos.org>
Date: Wed, 9 Sep 2026 08:20:00 -0400
Subject: [PATCH] weboscorecompositor: drive wl_shell configure protocol

Clients using wl_shell (such as Chromium/Ozone in WebAppMgr) bind wl_shell,
request a wl_shell_surface, call set_toplevel(), and wait for a configure
event before producing and attaching render buffers.
Connect wlShellSurfaceCreated and respond to setDefaultToplevel, setMaximized,
and setFullScreen with sendConfigure() so buffers are attached and mapped.
Also propagate title and className to WebOSSurfaceItem.

Signed-off-by: Andrew <andrew@luneos.org>
Upstream-Status: Pending
---
 modules/weboscompositor/weboscorecompositor.cpp | 30 ++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/modules/weboscompositor/weboscorecompositor.cpp b/modules/weboscompositor/weboscorecompositor.cpp
index af42d17..7a5e29e 100644
--- a/modules/weboscompositor/weboscorecompositor.cpp
+++ b/modules/weboscompositor/weboscorecompositor.cpp
@@ -243,6 +243,50 @@ WebOSCoreCompositor::WebOSCoreCompositor(ExtensionFlags extensions, const char *
     });
     connect(this, &QWaylandCompositor::surfaceCreated, this, &WebOSCoreCompositor::surfaceCreated);
 
+    connect(m_wlShell, &QWaylandWlShell::wlShellSurfaceCreated, this, [this](QWaylandWlShellSurface *shellSurface) {
+        qInfo() << "wlShellSurfaceCreated:" << shellSurface << (shellSurface ? shellSurface->surface() : nullptr);
+        if (!shellSurface)
+            return;
+
+        auto sendConfig = [this, shellSurface]() {
+            QSize size = m_outputGeometry.isValid() ? m_outputGeometry.size() : (defaultOutput() ? defaultOutput()->geometry().size() : QSize(1080, 2400));
+            double dpr = 2.4;
+            if (qEnvironmentVariableIsSet("LUNEOS_DPR")) {
+                bool ok = false;
+                double val = qgetenv("LUNEOS_DPR").toDouble(&ok);
+                if (ok && val > 0.1)
+                    dpr = val;
+            } else if (qEnvironmentVariableIsSet("WEBOS_DEVICE_PIXEL_RATIO")) {
+                bool ok = false;
+                double val = qgetenv("WEBOS_DEVICE_PIXEL_RATIO").toDouble(&ok);
+                if (ok && (val > 1.05 || val < 0.95) && val > 0.1)
+                    dpr = val;
+            }
+            if (dpr > 0.1)
+                size = QSize(qRound(size.width() / dpr), qRound(size.height() / dpr));
+            qInfo() << "Sending wl_shell_surface configure size:" << size << "(dpr:" << dpr << ") to" << shellSurface;
+            shellSurface->sendConfigure(size, QWaylandWlShellSurface::NoneEdge);
+        };
+
+        connect(shellSurface, &QWaylandWlShellSurface::setDefaultToplevel, this, sendConfig);
+        connect(shellSurface, &QWaylandWlShellSurface::setMaximized, this, sendConfig);
+        connect(shellSurface, &QWaylandWlShellSurface::setFullScreen, this, [sendConfig](QWaylandWlShellSurface::FullScreenMethod, uint, QWaylandOutput*) {
+            sendConfig();
+        });
+
+        connect(shellSurface, &QWaylandWlShellSurface::titleChanged, this, [shellSurface]() {
+            WebOSSurfaceItem *item = WebOSSurfaceItem::getSurfaceItemFromSurface(shellSurface->surface());
+            if (item && item->title().isEmpty() && !shellSurface->title().isEmpty())
+                item->setTitle(shellSurface->title());
+        });
+
+        connect(shellSurface, &QWaylandWlShellSurface::classNameChanged, this, [shellSurface]() {
+            WebOSSurfaceItem *item = WebOSSurfaceItem::getSurfaceItemFromSurface(shellSurface->surface());
+            if (item && item->appId().isEmpty() && !shellSurface->className().isEmpty())
+                item->setAppId(shellSurface->className());
+        });
+    });
+
 #if QT_VERSION >= QT_VERSION_CHECK(6,0,0)
     const QVector<ShmFormat> supportedWaylandFormats = {
         ShmFormat_ARGB8888,
-- 

From b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0 Mon Sep 17 00:00:00 2001
From: Andrew <andrew@luneos.org>
Date: Wed, 9 Sep 2026 08:20:00 -0400
Subject: [PATCH] product.env.in: skip writeback capture connectors

DRM writeback connectors report status=connected even when disabled,
causing check_drm_connector() to register a phantom second display.
Filter out Writeback connectors so only physical display outputs are counted.

Signed-off-by: Andrew <andrew@luneos.org>
Upstream-Status: Pending
---
 base/startup/product.env.in | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/base/startup/product.env.in b/base/startup/product.env.in
index 75fceb3..d13c030 100755
--- a/base/startup/product.env.in
+++ b/base/startup/product.env.in
@@ -70,6 +70,15 @@ if [ "$WEBOS_COMPOSITOR_DISPLAY_CONFIG" == "x" ] && [ "$WEBOS_COMPOSITOR_PLATFOR
         id=${bn%%-*}
         enabled=$(cat "$1/enabled")
         status=$(cat "$1/status")
+        # A writeback connector is a capture sink, not a display output, and DRM
+        # always reports it as "connected" (here: connected but enabled=disabled).
+        # Counting it gives the compositor a phantom second screen.
+        case "$connector" in
+            Writeback|writeback|WRITEBACK)
+                pmlog info "Skipping writeback connector: $connector$id"
+                return
+                ;;
+        esac
         # Assume available if it reports something other than disconnected
         # because some DRM connector doesn't report its status correctly.
         if [ "$status" == "connected" ]; then
-- 
2.34.1

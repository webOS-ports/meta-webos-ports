+++ b/base/qml/WebOSCompositorBase/qmldir
@@ -15,6 +15,7 @@ KeyController 1.0 controllers/KeyController.qml
 VideoController 1.0 controllers/VideoController.qml
 DebugPatternController 1.0 controllers/DebugPatternController.qml

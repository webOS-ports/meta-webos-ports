#!/bin/sh
# Release the boot logo on Spreadtrum sprdfb panels. Run from surface-manager-daemon.service
# (ExecStartPost) when deviceinfo_fb_kick=1.
#
# sprdfb keeps scanning out its copy of the boot logo until its first real refresh, and only a
# pan refreshes. The SPRD composer HAL never pans: with a client target that is not a framebuffer
# buffer, gralloc copies each frame into framebuffer buffer 0 and assumes the display already
# shows it. sprdfb also swallows the first pan after boot (SPRDFB_FRAMES_TO_SKIP). So pan to 0,0
# twice: the first may be swallowed, the second points the display controller at buffer 0.
#
# Harmless to repeat, so a compositor restart runs it again.
p=${LUNEOS_FB_PAN:-/sys/class/graphics/fb0/pan}
[ -w "$p" ] || exit 0
echo 0,0 > "$p"
echo 0,0 > "$p"

[Unit]
Description=meta-webos - "%n"
DefaultDependencies=no
StartLimitBurst=10
StartLimitIntervalSec=1

[Service]
Type=notify
OOMScoreAdjust=-1000
EnvironmentFile=-/etc/surface-manager.d/surface-manager.env
#FIXME Need to update this path in luna-surfacemanager-conf recipe first
#EnvironmentFile=-/var/systemd/system/env/surface-manager.env
# Tell Android's EGL loader which GLES driver to use, when the adaptation asks
# for it (deviceinfo_hardware_egl -> LUNEOS_ANDROID_EGL, written into the
# EnvironmentFile above by luneos-device-config's 20-surface-manager-env).
#
# It has to happen here rather than in that generator: ro.* properties live in
# the Android container's property service, which does not exist when the
# generators run. ro.* can be set once while still unset, so this is a no-op on
# any device whose vendor already sets it. Leading '-' so a device with no
# container, or one where the property is already set, still starts.
ExecStartPre=-/bin/sh -c '[ -n "$LUNEOS_ANDROID_EGL" ] && exec /usr/bin/setprop ro.hardware.egl "$LUNEOS_ANDROID_EGL"'
ExecStartPre=/bin/mkdir -p ${XDG_RUNTIME_DIR}
ExecStartPre=/bin/chmod 0770 ${XDG_RUNTIME_DIR}
ExecStartPre=/bin/chown nobody:compositor ${XDG_RUNTIME_DIR}
ExecStartPre=-/bin/ln -s ${XDG_RUNTIME_DIR} /var/run/xdg
ExecStart=/usr/bin/surface-manager.sh
ExecStop=/usr/bin/rm -f /tmp/lsm-ready
TimeoutStopSec=5
Restart=on-failure

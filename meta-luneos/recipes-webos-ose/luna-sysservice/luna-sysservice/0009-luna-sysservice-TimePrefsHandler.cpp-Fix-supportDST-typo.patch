From a5be239a19164c11887c4fab98d10e1aeb490436 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sun, 6 Sep 2026 07:51:10 +0200
Subject: [PATCH] luna-sysservice: TimePrefsHandler.cpp: Fix supportDST typo

TZJsonHelper reads and writes "supportDST" while ext-timezones.json,
the stored timeZone preference, legacy webOS and every other parser in
TimePrefsHandler.cpp (scanTimeZoneJson, jsonUtil_ZoneFromJson, the
failsafe zone and setManualTimeZoneInfo) use "supportsDST".

Since cbGetPreferenceValues always routes the timeZone key through the
repacking timeZoneListAsJson(countryCode, locale), every consumer of
getPreferenceValues got "supportDST": 0 for all zones: extract() reads
a key that never exists in the data, so the DST flag is silently zeroed
in the delivered list, in the internal zone table used for NITZ
offset-to-zone mapping, and in the getTimeZoneByLocale and
updateTimeZoneInfo replies. Nothing anywhere consumes "supportDST".

Typo was introduced with the TZJsonHelper refactor in OSE and is still
present upstream. Keep reading the wrong key as a fallback for data
produced by builds that carried the typo.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
Upstream-Status: Pending
---
 Src/TimePrefsHandler.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/Src/TimePrefsHandler.cpp b/Src/TimePrefsHandler.cpp
index 9a9c264..9317390 100644
--- a/Src/TimePrefsHandler.cpp
+++ b/Src/TimePrefsHandler.cpp
@@ -240,7 +240,11 @@ public:
 			timeZoneInfo->country = label.asString();
 		}
 
-		label = root["supportDST"];
+		label = root["supportsDST"];
+		if (!label.isNumber()) {
+			//accept data produced by builds that carried the supportDST typo
+			label = root["supportDST"];
+		}
 		if (label.isNumber()) {
 			timeZoneInfo->dstSupported = label.asNumber<int>();
 		}
@@ -284,7 +288,7 @@ public:
 			timeZoneObj.put("Country", timeZoneInfo->country);
 		}
 
-		timeZoneObj.put("supportDST", timeZoneInfo->dstSupported);
+		timeZoneObj.put("supportsDST", timeZoneInfo->dstSupported);
 		timeZoneObj.put("offsetFromUTC", timeZoneInfo->offsetToUTC);
 
 		if (!timeZoneInfo->name.empty()) {
-- 

From 4273f7207db4dbeea3c529988898095872cd229b Mon Sep 17 00:00:00 2001
From: Herrie <claude.ai@herrie.org>
Date: Mon, 10 Aug 2026 19:08:41 +0200
Subject: [PATCH] Give plugins the character for every printable keysym

processKeyEvent() only filled in the key text for the plain latin letters,
so a plugin had no way to tell a digit or a punctuation key apart from a
function key. Derive the text from the keysym instead, leaving control
characters (Return, Tab, Backspace, Escape, ...) with an empty text so they
stay recognisable as function keys.
Upstream-Status: Pending
---
 .../minputcontextwestonimprotocolconnection.cpp      | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/connection/minputcontextwestonimprotocolconnection.cpp b/connection/minputcontextwestonimprotocolconnection.cpp
index 4355a15..ad58074 100644
--- a/connection/minputcontextwestonimprotocolconnection.cpp
+++ b/connection/minputcontextwestonimprotocolconnection.cpp
@@ -1132,10 +1132,16 @@ void MInputContextWestonIMProtocolConnectionPrivate::processKeyEvent(uint32_t se
     if (isKeypadKey(sym))
         modifiers |= Qt::KeypadModifier;
 
+    // Hand the plugins the character the key actually produces, for every
+    // printable keysym rather than just the plain latin letters. Digits and
+    // punctuation used to arrive with an empty text, which left plugins no way
+    // to tell what was typed. Control characters (Return, Tab, Backspace,
+    // Escape, ...) keep an empty text so they stay recognisable as function
+    // keys.
     QString text("");
-    if ((XKB_KEY_A <= sym && sym <= XKB_KEY_Z) ||
-        (XKB_KEY_a <= sym && sym <= XKB_KEY_z)) {
-        text.append(QChar(sym));
+    const char32_t codepoint = xkb_keysym_to_utf32(sym);
+    if (codepoint >= 0x20 && codepoint != 0x7f) {
+        text = QString::fromUcs4(&codepoint, 1);
     }
 
 #ifdef HAS_LIBIM

STATIC=`luna-send -n 1 -f luna://com.webos.service.config/getConfigs '{ "configNames":["com.webos.service.ime.*"]}' | grep static | grep -oE "(true|false)"; exit 0`

# If Maliit is dynamic, we don't need to run it on startup
if [ "$STATIC" == "false" ] ; then
    stop ; exit 0
fi

if [ -f $MALIIT_CONF_FILELOCK ]
then
    rm -f $MALIIT_CONF_FILETEMP
fi

# server.conf lives in /var/lib and is only written when absent, so devices
# that already booted an older build keep two entries that no longer refer to
# anything installed: the accessory line this script used to seed, which made
# MaliitServer log "Could not find plugin: libstt-plugin.so" every boot, and
# the pluginsettings block for imemanager's libplugin-global.so. Strip both on
# upgrade; neither is written any more.
if [ -f $MALIIT_CONF_FILE ]
then
    sed -i -e '/^plugins\\accessory=libstt-plugin\.so$/d' \
           -e '/^pluginsettings\\libplugin-global\.so\\/d' $MALIIT_CONF_FILE
fi

if ! [ -f $MALIIT_CONF_FILE ]
then
    mkdir -p $MALIIT_CONF_PATH
    touch $MALIIT_CONF_FILE

    echo "[maliit]" >> $MALIIT_CONF_FILE
    # No accessory plugin is seeded: libstt-plugin.so is a webOS OSE artefact
    # that has never been built or shipped here, and naming it only made
    # MaliitServer log "Could not find plugin" on every boot while it scanned
    # for something that does not exist. It came in with the upstart script
    # this file replaced (dropped upstream in f539b70).
    echo "plugins\\hardware=libluneos-keyboard-plugin.so" >> $MALIIT_CONF_FILE
#    echo "onscreen\\enabled= \\" >> $MALIIT_CONF_FILE
#    echo "libplugin-global.so:, \\" >> $MALIIT_CONF_FILE
#    echo "libplugin-chinese.so:chinese, \\" >> $MALIIT_CONF_FILE
#    echo "libplugin-japanese.so:japanese" >> $MALIIT_CONF_FILE
fi

# Get the display count (use 1 if unavailable or invalid)
# Start maliit-server.service instance by the display count
c="$(cat $XDG_RUNTIME_DIR/surface-manager.windowcount 2>/dev/null)"
[ "$c" -eq "$c" 2>/dev/null ] || c=1
for i in $(seq $c) ; do
    if [[ $i == 1 ]]; then
        systemctl start maliit-server@$(($i - 1))
    else
        systemctl start maliit-server@"$(($i - 1)) -no-ls2-service"
    fi
done

if [ -z "$WAYLAND_DISPLAY" ]; then
    WAYLAND_DISPLAY="wayland-0"
fi

# Hold off if the compositor is not up yet, so that a restart does not spin.
#
# This asked netstat for the kernel's list of listening unix sockets, and
# netstat is not in the image - not as a binary, and not as a busybox applet.
# So the pipeline failed, grep read nothing and returned 1, the negation turned
# that into true, and every start concluded the compositor was down and slept
# ten seconds while it was up and serving. The check could not have succeeded on
# any build that did not also install net-tools, and none does.
#
# A Wayland display is a unix socket in XDG_RUNTIME_DIR, so ask the socket
# rather than the table of listeners. Same question, no extra package.
#
# The "$STATIC" == "false" arm that used to sit above this is gone: that case
# already returned at the top of the script, so it could never be reached here.
if ! [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    # Compositor seems down, don't rush.
    exec sleep 10
fi

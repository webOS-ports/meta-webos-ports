[Unit]
Description=meta-webos - "%n", instance %i
# MaliitServer is a Wayland client (QT_QPA_PLATFORM=wayland-egl below) and does
# not tolerate the compositor being absent: it aborts inside the EGL wayland
# platform instead of waiting or failing gracefully, so starting it before
# surface-manager is up is fatal rather than merely early.
#
# Without this ordering it races the compositor from boot, aborts, and is
# restarted until systemd gives up entirely - "Start request repeated too
# quickly", with the restart counter having run to 289 - leaving the device
# without an on-screen keyboard for the rest of the session even though nothing
# is wrong with it. Starting it by hand once the compositor is up works fine,
# which is what made this look like a Maliit fault rather than an ordering one.
#
# webapp-mgr.service already declares the same dependency for the same reason.
Requires=maliit-server.service surface-manager.service
After=maliit-server.service surface-manager.service
BindsTo=maliit-server.service
#
# The same holds for every later restart of the compositor itself, which is
# surface-manager-daemon (surface-manager.service is only the one-shot that
# launches it). MaliitServer keeps its connection to the compositor it started
# with: when surface-manager-daemon restarts, it either aborts and is retried six
# times within two seconds, before the new compositor listens, until systemd gives
# up (HP TouchPad), or it lingers on the dead connection (Galaxy Tab Pro 10.1, SM-T520). Either
# way the new compositor has no input method ("Cannot get inputMethod for
# displayId 0") and no on-screen keyboard appears until the next boot. PartOf
# restarts this instance with the daemon, and After starts it once the daemon has
# signalled readiness, that is, once its Wayland socket is up.
PartOf=surface-manager-daemon.service
After=surface-manager-daemon.service

[Service]
Type=simple
OOMScoreAdjust=0
Environment=QT_QPA_PLATFORM=wayland-egl
Environment="ARGS=%I"
EnvironmentFile=-/var/systemd/system/env/maliit-server.env
ExecStart=/bin/sh -a -c "_INSTANCE=`echo $ARGS | awk '{print $1}'`; _NO_LS2_SERVICE=`echo $ARGS | awk '{print $2}' | tr '/' '-'`; /usr/sbin/MaliitServer -instance $_INSTANCE $_NO_LS2_SERVICE"
Restart=on-failure
# Spread the retries out, so a compositor that takes a few seconds to come back
# does not run the start limit out first.
RestartSec=2

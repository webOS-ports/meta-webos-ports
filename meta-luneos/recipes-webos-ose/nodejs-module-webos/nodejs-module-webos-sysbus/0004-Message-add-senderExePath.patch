From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sat, 17 Oct 2026 13:02:50 +0200
Subject: [PATCH] Message: add senderExePath()

A service that must only take a call from one program (the system shell
answering a question it was asked to put to the user) cannot tell that
program from its bus name alone: a privileged tool whose role allows any
name, such as luna-send, can register the same name.

The hub records each client's executable from its process when it
connects, and luna-service2 hands it to services as
LSMessageGetSenderExePath(). Expose it to JavaScript services next to
senderServiceName(), returning "" when the hub gave none.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending
---
 src/node_ls2_message.cpp | 13 +++++++++++++
 src/node_ls2_message.h   |  2 ++
 2 files changed, 15 insertions(+)

diff --git a/src/node_ls2_message.cpp b/src/node_ls2_message.cpp
index 4e1da6d..63d6906 100644
--- a/src/node_ls2_message.cpp
+++ b/src/node_ls2_message.cpp
@@ -59,6 +59,7 @@ void LS2Message::Initialize (Local<Object> target, v8::Local<v8::Context> contex
     NODE_SET_PROTOTYPE_METHOD(t, "applicationID", ApplicationIDWrapper);
     NODE_SET_PROTOTYPE_METHOD(t, "sender", SenderWrapper);
     NODE_SET_PROTOTYPE_METHOD(t, "senderServiceName", SenderServiceNameWrapper);
+    NODE_SET_PROTOTYPE_METHOD(t, "senderExePath", SenderExePathWrapper);
     NODE_SET_PROTOTYPE_METHOD(t, "uniqueToken", UniqueTokenWrapper);
     NODE_SET_PROTOTYPE_METHOD(t, "kind", KindWrapper);
     NODE_SET_PROTOTYPE_METHOD(t, "category", CategoryWrapper);
@@ -278,6 +279,18 @@ const char* LS2Message::SenderServiceName() const
     return GetString(LSMessageGetSenderServiceName);
 }
 
+void LS2Message::SenderExePathWrapper(const v8::FunctionCallbackInfo<v8::Value>& args)
+{
+    MemberFunctionWrapper<LS2Message, const char*>(&LS2Message::SenderExePath, args);
+}
+
+// The sender's executable, as the hub found it from the sender's process
+// when it connected; a client cannot choose it the way it can a name.
+const char* LS2Message::SenderExePath() const
+{
+    return GetString(LSMessageGetSenderExePath);
+}
+
 void LS2Message::TokenWrapper(const v8::FunctionCallbackInfo<v8::Value>& args)
 {
     MemberFunctionWrapper<LS2Message, LSMessageToken>(&LS2Message::Token, args);
diff --git a/src/node_ls2_message.h b/src/node_ls2_message.h
index dd68f5f..539a45c 100644
--- a/src/node_ls2_message.h
+++ b/src/node_ls2_message.h
@@ -87,6 +87,8 @@ private:
 
 	static void SenderServiceNameWrapper(const v8::FunctionCallbackInfo<v8::Value>& args);
 	const char* SenderServiceName() const;
+	static void SenderExePathWrapper(const v8::FunctionCallbackInfo<v8::Value>& args);
+	const char* SenderExePath() const;
 
 	static void TokenWrapper(const v8::FunctionCallbackInfo<v8::Value>& args);
 	LSMessageToken Token() const;
-- 

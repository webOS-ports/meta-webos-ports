From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS / webOS Ports <team@webos-ports.org>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: [PATCH] CMakeLists.txt: build as C++17, libxml++-5.0 requires it

libxml++-5.0 headers use std::variant, which is C++17:

  libxml++/nodes/node.h:244:8: error: 'variant' in namespace 'std' does not
  name a template type

The component still asked for -std=c++11. It is already built against
libxml++-5.0 here (0001-CMakeLists.txt-switch-to-libxml-5.patch), so the
language standard has to move with it.

Upstream-Status: Pending
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8d279f7..1972fe8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -58,7 +58,7 @@ webos_add_compiler_flags(ALL ${LIBXMLXX_CFLAGS})
 pkg_check_modules(OPENSSL REQUIRED openssl)
 webos_add_compiler_flags(ALL ${OPENSSL_CFLAGS})
 
-webos_add_compiler_flags(ALL -Wall "-std=c++11")
+webos_add_compiler_flags(ALL -Wall "-std=c++17")
 
 webos_add_linker_options(ALL --no-undefined)
 

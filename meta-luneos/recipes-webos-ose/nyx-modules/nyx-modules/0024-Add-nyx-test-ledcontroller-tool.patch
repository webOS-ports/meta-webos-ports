+
+# A program rather than a webos_add_test(): this is driven by hand during
+# bring-up, and nyx-modules.bb packages it as ${bindir}/nyx-test-ledcontroller.
+add_executable(nyx-test-ledcontroller nyx_test_ledcontroller.c)
+target_link_libraries(nyx-test-ledcontroller ${NYXLIB_LDFLAGS} ${GLIB2_LDFLAGS} ${PMLOG_LDFLAGS})
+webos_build_program(NAME nyx-test-ledcontroller)
diff -urN nm.orig/src/led_controller_test/nyx_test_ledcontroller.c nm/src/led_controller_test/nyx_test_ledcontroller.c
--- a/src/led_controller_test/nyx_test_ledcontroller.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/led_controller_test/nyx_test_ledcontroller.c	2026-08-30 21:13:50.120113397 +0200
@@ -0,0 +1,499 @@
+// Copyright (c) 2026 Herman van Hazendonk <github.com@herrie.org>
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+/*
+ * nyx-test-ledcontroller - drive NYX_DEVICE_LED_CONTROLLER from a shell.
+ *
+ * Bring-up tool for the LED controller. Nothing in the running system sets a
+ * colour yet, so without something like this there is no way to tell a module
+ * that ignores the colour parameters from hardware that cannot show one.
+ *
+ * Whether an effect does anything depends on which module claimed the device:
+ * nyx-modules-hybris forwards the core LEDs to the Android lights HAL, while the
+ * native nyx-modules build only implements the backlight and answers
+ * NYX_ERROR_DEVICE_UNAVAILABLE for everything else. That error is reported
+ * rather than swallowed, because on a device with a real LED it is the useful
+ * answer: the module, not the hardware, is what is missing.
+ */
+
+#include <getopt.h>
+#include <libgen.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <nyx/nyx_client.h>
+
+#define UNSET NYX_LED_CONTROLLER_CORE_COLOUR_UNSET
+
+static bool verbose = false;
+
+struct named_colour
+{
+	const char *name;
+	int32_t r, g, b;
+};
+
+static const struct named_colour colours[] =
+{
+	{ "off",     0,    0,    0    },
+	{ "red",     0xff, 0,    0    },
+	{ "green",   0,    0xff, 0    },
+	{ "blue",    0,    0,    0xff },
+	{ "yellow",  0xff, 0xff, 0    },
+	{ "amber",   0xff, 0xbf, 0    },
+	{ "cyan",    0,    0xff, 0xff },
+	{ "magenta", 0xff, 0,    0xff },
+	{ "white",   0xff, 0xff, 0xff },
+};
+
+static const struct
+{
+	const char *name;
+	nyx_led_controller_led_t led;
+} leds[] =
+{
+	{ "left",      NYX_LED_CONTROLLER_LEFT_LED       },
+	{ "center",    NYX_LED_CONTROLLER_CENTER_LED     },
+	{ "right",     NYX_LED_CONTROLLER_RIGHT_LED      },
+	{ "core",      NYX_LED_CONTROLLER_CORE_LEDS      },
+	{ "backlight", NYX_LED_CONTROLLER_BACKLIGHT_LEDS },
+	{ "all",       NYX_LED_CONTROLLER_ALL_LEDS       },
+};
+
+static void usage(const char *argv0)
+{
+	printf(
+	    "Usage: %s [options] <set|pulsate|off|state>\n"
+	    "\n"
+	    "Commands:\n"
+	    "  set       apply LED_SET     (steady)\n"
+	    "  pulsate   apply LED_PULSATE (breathing, or hardware blink where the\n"
+	    "            module maps it to one)\n"
+	    "  off       LED_SET at brightness 0\n"
+	    "  state     query led_controller_get_state and exit\n"
+	    "\n"
+	    "Options:\n"
+	    "  -l, --led <name>        left, center, right, core, backlight, all\n"
+	    "                          (default: center - what the hybris module maps\n"
+	    "                          to the notification LED)\n"
+	    "  -b, --brightness <n>    0-255, default 255. Scales the colour, so a\n"
+	    "                          colour with brightness 0 stays dark.\n"
+	    "  -c, --colour <spec>     #rrggbb, rrggbb, r,g,b, or a name:\n"
+	    "                          off red green blue yellow amber cyan magenta white\n"
+	    "                          Omit to send no colour at all, which is how you\n"
+	    "                          exercise the pre-colour greyscale path.\n"
+	    "      --on <ms>           pulsate on/fade-in time  (default 1000)\n"
+	    "      --off-ms <ms>       pulsate off/fade-out time (default 1000)\n"
+	    "      --lcd <0-100>       backlight LCD percentage    (default: brightness)\n"
+	    "      --keypad <0-100>    backlight keypad percentage (default: -1, leave)\n"
+	    "  -v, --verbose           report every nyx call\n"
+	    "  -h, --help              this text\n"
+	    "\n"
+	    "Examples:\n"
+	    "  %s -c red set                  steady red on the notification LED\n"
+	    "  %s -c green -b 64 set          green at quarter intensity\n"
+	    "  %s -c blue --on 500 --off-ms 2000 pulsate\n"
+	    "  %s off                         turn it off\n"
+	    "  %s -l backlight --lcd 50 set   half display backlight\n"
+	    "  %s -b 200 set                  no colour: legacy greyscale path\n",
+	    argv0, argv0, argv0, argv0, argv0, argv0, argv0);
+}
+
+static bool parse_colour(const char *spec, int32_t *r, int32_t *g, int32_t *b)
+{
+	unsigned int ur, ug, ub;
+	size_t i;
+
+	for (i = 0; i < sizeof(colours) / sizeof(colours[0]); i++)
+	{
+		if (strcasecmp(spec, colours[i].name) == 0)
+		{
+			*r = colours[i].r;
+			*g = colours[i].g;
+			*b = colours[i].b;
+			return true;
+		}
+	}
+
+	if (*spec == '#')
+	{
+		spec++;
+	}
+
+	if (sscanf(spec, "%u,%u,%u", &ur, &ug, &ub) == 3)
+	{
+		if (ur > 255 || ug > 255 || ub > 255)
+		{
+			return false;
+		}
+
+		*r = (int32_t)ur;
+		*g = (int32_t)ug;
+		*b = (int32_t)ub;
+		return true;
+	}
+
+	if (strlen(spec) == 6 && sscanf(spec, "%2x%2x%2x", &ur, &ug, &ub) == 3)
+	{
+		*r = (int32_t)ur;
+		*g = (int32_t)ug;
+		*b = (int32_t)ub;
+		return true;
+	}
+
+	return false;
+}
+
+static const char *led_name(nyx_led_controller_led_t led)
+{
+	size_t i;
+
+	for (i = 0; i < sizeof(leds) / sizeof(leds[0]); i++)
+	{
+		if (leds[i].led == led)
+		{
+			return leds[i].name;
+		}
+	}
+
+	return "?";
+}
+
+/*
+ * Both the native and the hybris backlight paths call this unconditionally, so
+ * it has to be set even though nothing here waits on it. The core LED paths
+ * never call it.
+ */
+static void backlight_done(nyx_device_handle_t handle, nyx_callback_status_t status,
+                           void *ctx)
+{
+	(void)handle;
+	(void)ctx;
+
+	if (verbose)
+	{
+		printf("  backlight callback: status=%d\n", status);
+	}
+}
+
+static bool set_param(nyx_led_controller_core_configuration_handle_t config,
+                      nyx_led_controller_parameter_type_t param, int32_t value,
+                      const char *what)
+{
+	nyx_error_t err = nyx_led_controller_core_configuration_set_param(config, param,
+	                  value);
+
+	if (err != NYX_ERROR_NONE)
+	{
+		fprintf(stderr, "error: could not set %s to %d: nyx error %d\n", what, value,
+		        err);
+		return false;
+	}
+
+	if (verbose)
+	{
+		printf("  set %s = %d\n", what, value);
+	}
+
+	return true;
+}
+
+static int report_state(nyx_device_handle_t device, nyx_led_controller_led_t led)
+{
+	nyx_led_controller_state_t state = NYX_LED_CONTROLLER_STATE_UNKNOWN;
+	nyx_error_t err = nyx_led_controller_get_state(device, led, &state);
+
+	if (err != NYX_ERROR_NONE)
+	{
+		printf("state of %s: unavailable (nyx error %d)\n", led_name(led), err);
+		/*
+		 * Not a failure of the tool. Neither module implements get_state for the
+		 * core LEDs, and the native one implements it only for the backlight.
+		 */
+		return 0;
+	}
+
+	printf("state of %s: %s\n", led_name(led),
+	       state == NYX_LED_CONTROLLER_STATE_ON  ? "on"  :
+	       state == NYX_LED_CONTROLLER_STATE_OFF ? "off" : "unknown");
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	nyx_device_handle_t device = NULL;
+	nyx_led_controller_core_configuration_handle_t config = NULL;
+	nyx_led_controller_effect_t effect;
+	nyx_led_controller_effect_type_t effect_type;
+	nyx_led_controller_led_t led = NYX_LED_CONTROLLER_CENTER_LED;
+	nyx_error_t err;
+	int32_t brightness = 255;
+	int32_t r = UNSET, g = UNSET, b = UNSET;
+	int32_t on_ms = 1000, off_ms = 1000;
+	int32_t lcd = -1, keypad = -1;
+	const char *command;
+	const char *prog;
+	int rc = 1;
+	int opt;
+	size_t i;
+
+	prog = (argc > 0 && argv[0]) ? basename(argv[0]) : "nyx-test-ledcontroller";
+
+	static struct option long_options[] =
+	{
+		{ "led",        required_argument, NULL, 'l' },
+		{ "brightness", required_argument, NULL, 'b' },
+		{ "colour",     required_argument, NULL, 'c' },
+		{ "color",      required_argument, NULL, 'c' },
+		{ "on",         required_argument, NULL, 1   },
+		{ "off-ms",     required_argument, NULL, 2   },
+		{ "lcd",        required_argument, NULL, 3   },
+		{ "keypad",     required_argument, NULL, 4   },
+		{ "verbose",    no_argument,       NULL, 'v' },
+		{ "help",       no_argument,       NULL, 'h' },
+		{ NULL,         0,                 NULL, 0   },
+	};
+
+	while ((opt = getopt_long(argc, argv, "l:b:c:vh", long_options, NULL)) != -1)
+	{
+		switch (opt)
+		{
+			case 'l':
+				led = 0;
+
+				for (i = 0; i < sizeof(leds) / sizeof(leds[0]); i++)
+				{
+					if (strcasecmp(optarg, leds[i].name) == 0)
+					{
+						led = leds[i].led;
+						break;
+					}
+				}
+
+				if (led == 0)
+				{
+					fprintf(stderr, "error: unknown led '%s'\n", optarg);
+					return 1;
+				}
+
+				break;
+
+			case 'b':
+				brightness = atoi(optarg);
+
+				if (brightness < 0 || brightness > 255)
+				{
+					fprintf(stderr, "error: brightness must be 0-255\n");
+					return 1;
+				}
+
+				break;
+
+			case 'c':
+				if (!parse_colour(optarg, &r, &g, &b))
+				{
+					fprintf(stderr, "error: cannot parse colour '%s'\n", optarg);
+					return 1;
+				}
+
+				break;
+
+			case 1:
+				on_ms = atoi(optarg);
+				break;
+
+			case 2:
+				off_ms = atoi(optarg);
+				break;
+
+			case 3:
+				lcd = atoi(optarg);
+				break;
+
+			case 4:
+				keypad = atoi(optarg);
+				break;
+
+			case 'v':
+				verbose = true;
+				break;
+
+			case 'h':
+				usage(prog);
+				return 0;
+
+			default:
+				usage(prog);
+				return 1;
+		}
+	}
+
+	if (optind >= argc)
+	{
+		usage(prog);
+		return 1;
+	}
+
+	command = argv[optind];
+
+	if (strcmp(command, "set") == 0 || strcmp(command, "off") == 0)
+	{
+		effect_type = NYX_LED_CONTROLLER_EFFECT_LED_SET;
+	}
+	else if (strcmp(command, "pulsate") == 0)
+	{
+		effect_type = NYX_LED_CONTROLLER_EFFECT_LED_PULSATE;
+	}
+	else if (strcmp(command, "state") == 0)
+	{
+		effect_type = NYX_LED_CONTROLLER_EFFECT_UNDEFINED;
+	}
+	else
+	{
+		fprintf(stderr, "error: unknown command '%s'\n", command);
+		usage(prog);
+		return 1;
+	}
+
+	if (strcmp(command, "off") == 0)
+	{
+		brightness = 0;
+		r = g = b = UNSET;
+	}
+
+	err = nyx_device_open(NYX_DEVICE_LED_CONTROLLER, "Default", &device);
+
+	if (err != NYX_ERROR_NONE || device == NULL)
+	{
+		fprintf(stderr,
+		        "error: could not open the LED controller (nyx error %d).\n"
+		        "Is a MicroControllerLEDsDefault module installed in the nyx module "
+		        "directory?\n", err);
+		return 1;
+	}
+
+	if (verbose)
+	{
+		printf("opened NYX_DEVICE_LED_CONTROLLER \"Default\"\n");
+	}
+
+	if (effect_type == NYX_LED_CONTROLLER_EFFECT_UNDEFINED)
+	{
+		rc = report_state(device, led);
+		goto out_close;
+	}
+
+	err = nyx_led_controller_core_configuration_create(effect_type, &config);
+
+	if (err != NYX_ERROR_NONE)
+	{
+		fprintf(stderr, "error: could not create the effect configuration: nyx error %d\n",
+		        err);
+		goto out_close;
+	}
+
+	if (!set_param(config, NYX_LED_CONTROLLER_CORE_EFFECT_BRIGHTNESS, brightness,
+	               "brightness"))
+	{
+		goto out_release;
+	}
+
+	if (r != UNSET &&
+	        (!set_param(config, NYX_LED_CONTROLLER_CORE_EFFECT_COLOUR_RED,   r, "colour red") ||
+	         !set_param(config, NYX_LED_CONTROLLER_CORE_EFFECT_COLOUR_GREEN, g, "colour green") ||
+	         !set_param(config, NYX_LED_CONTROLLER_CORE_EFFECT_COLOUR_BLUE,  b, "colour blue")))
+	{
+		goto out_release;
+	}
+
+	if (effect_type == NYX_LED_CONTROLLER_EFFECT_LED_PULSATE &&
+	        (!set_param(config, NYX_LED_CONTROLLER_CORE_EFFECT_FADE_IN,  on_ms,  "fade_in") ||
+	         !set_param(config, NYX_LED_CONTROLLER_CORE_EFFECT_FADE_OUT, off_ms, "fade_out")))
+	{
+		goto out_release;
+	}
+
+	err = nyx_led_controller_core_configuration_finalize(config);
+
+	if (err != NYX_ERROR_NONE)
+	{
+		fprintf(stderr, "error: could not finalize the configuration: nyx error %d\n", err);
+		goto out_release;
+	}
+
+	memset(&effect, 0, sizeof(effect));
+	effect.required.led = led;
+	effect.required.effect = effect_type;
+	effect.core_configuration = config;
+	effect.backlight.brightness_lcd = (lcd >= 0) ? lcd : brightness * 100 / 255;
+	effect.backlight.brightness_keypad = keypad;
+	effect.backlight.callback = backlight_done;
+	effect.backlight.callback_context = NULL;
+
+	printf("%s on %s: brightness %d", command, led_name(led), brightness);
+
+	if (r != UNSET)
+	{
+		printf(", colour %d,%d,%d", r, g, b);
+	}
+	else
+	{
+		printf(", no colour set");
+	}
+
+	if (effect_type == NYX_LED_CONTROLLER_EFFECT_LED_PULSATE)
+	{
+		printf(", on %dms off %dms", on_ms, off_ms);
+	}
+
+	if (led & NYX_LED_CONTROLLER_BACKLIGHT_LEDS)
+	{
+		printf(", lcd %d%% keypad %d", effect.backlight.brightness_lcd, keypad);
+	}
+
+	printf("\n");
+	fflush(stdout);
+
+	err = nyx_led_controller_execute_effect(device, effect);
+
+	if (err == NYX_ERROR_DEVICE_UNAVAILABLE)
+	{
+		fprintf(stderr,
+		        "error: the loaded module does not implement this LED (nyx error %d).\n"
+		        "The native nyx-modules LED module handles only 'backlight'; the core\n"
+		        "LEDs need the nyx-modules-hybris module, chosen per machine by\n"
+		        "NYXMOD_OW_LED in nyx-modules/<machine>.cmake.\n", err);
+		goto out_release;
+	}
+
+	if (err != NYX_ERROR_NONE)
+	{
+		fprintf(stderr, "error: executing the effect failed: nyx error %d\n", err);
+		goto out_release;
+	}
+
+	printf("ok\n");
+	rc = 0;
+
+out_release:
+	nyx_led_controller_core_configuration_release(config);
+out_close:
+	nyx_device_close(device);
+	return rc;
+}

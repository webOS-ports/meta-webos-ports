diff --git a/tests/log_file_shim.c b/tests/log_file_shim.c
new file mode 100644
index 0000000..8261c6f
--- /dev/null
+++ b/tests/log_file_shim.c
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: Apache-2.0
+
+/*
+ * The functions under test are static in main.c and it has its own main(), so
+ * the file is included here rather than linked. The system headers come first:
+ * the defines below must rename the calls in main.c, not their declarations.
+ */
+#include <errno.h>
+#include <grp.h>
+#include <string.h>
+#include <unistd.h>
+#include <stdio.h>
+
+#include "main.h"
+#include <luna-service2/lunaservice.h>
+#include "log_file_shim.h"
+
+static struct group fake_group;
+static char fake_group_name[32];
+static int group_found;
+static int group_err;
+static int setgid_err;
+static int setgid_print;
+static int setgid_calls;
+static gid_t setgid_gid;
+static int reply_calls;
+static char reply_payload[4096];
+
+static struct group *fake_getgrnam(const char *name)
+{
+	snprintf(fake_group_name, sizeof(fake_group_name), "%s", name);
+	if (!group_found)
+	{
+		errno = group_err;
+		return NULL;
+	}
+	return &fake_group;
+}
+
+static int fake_setgid(gid_t gid)
+{
+	setgid_calls++;
+	setgid_gid = gid;
+	if (setgid_print)
+	{
+		fprintf(stderr, "setgid(%u) from main\n", (unsigned)gid);
+	}
+	if (setgid_err)
+	{
+		errno = setgid_err;
+		return -1;
+	}
+	return 0;
+}
+
+static bool fake_subscription_reply(LSHandle *sh, const char *key, const char *payload,
+                                    LSError *lserror)
+{
+	(void)sh;
+	(void)key;
+	(void)lserror;
+	reply_calls++;
+	snprintf(reply_payload, sizeof(reply_payload), "%s", payload);
+	return true;
+}
+
+#define getgrnam fake_getgrnam
+#define setgid fake_setgid
+#define LSSubscriptionReply fake_subscription_reply
+#define main pmlogdaemon_main
+#include "main.c"
+#undef main
+#undef LSSubscriptionReply
+#undef setgid
+#undef getgrnam
+
+void shim_reset(void)
+{
+	memset(&fake_group, 0, sizeof(fake_group));
+	fake_group_name[0] = '\0';
+	group_found = 0;
+	group_err = 0;
+	setgid_err = 0;
+	setgid_print = 0;
+	setgid_calls = 0;
+	setgid_gid = 0;
+	reply_calls = 0;
+	reply_payload[0] = '\0';
+	g_atomic_int_set(&g_haveRotSubscription, 0);
+}
+
+void shim_group_exists(gid_t gid)
+{
+	group_found = 1;
+	fake_group.gr_gid = gid;
+}
+
+void shim_group_lookup_fails(int err)
+{
+	group_found = 0;
+	group_err = err;
+}
+
+void shim_setgid_fails(int err)
+{
+	setgid_err = err;
+}
+
+void shim_print_setgid(void)
+{
+	setgid_print = 1;
+}
+
+int shim_setgid_calls(void)
+{
+	return setgid_calls;
+}
+
+gid_t shim_setgid_gid(void)
+{
+	return setgid_gid;
+}
+
+const char *shim_group_name(void)
+{
+	return fake_group_name;
+}
+
+int shim_reply_calls(void)
+{
+	return reply_calls;
+}
+
+const char *shim_reply_payload(void)
+{
+	return reply_payload;
+}
+
+void shim_use_log_file_group(void)
+{
+	UseLogFileGroup();
+}
+
+int shim_write(const char *path, const char *data, size_t n, int max_size, int rotations)
+{
+	PmLogFile_t file = { "test", path, max_size, rotations };
+
+	return WriteToLogFile(&file, data, n);
+}
+
+int shim_rotate(const char *path, int rotations)
+{
+	PmLogFile_t file = { "test", path, 0, rotations };
+
+	return DoRotateLogFile(&file, false);
+}
+
+int shim_rotate_for_subscriber(const char *path)
+{
+	PmLogFile_t file = { "test", path, 0, 1 };
+
+	/* dev logs are compressed in place, subscribers or not */
+	g_collectDevLogs = false;
+	g_atomic_int_set(&g_haveRotSubscription, 1);
+	return DoRotateLogFile(&file, false);
+}
+
+int shim_start_worker(void)
+{
+	if (!HeavyOperationRoutineConstruct(&heavy_routine))
+	{
+		return 0;
+	}
+	return HeavyOperationRoutineRun(&heavy_routine) ? 1 : 0;
+}
+
+void shim_stop_worker(void)
+{
+	/*
+	 * Join here rather than in WorkerRoutineDestruct(), which calls
+	 * g_thread_unref() after g_thread_join() has dropped the last reference.
+	 */
+	g_main_loop_quit(heavy_routine.routine.loop);
+	g_thread_join(heavy_routine.routine.thrd);
+	heavy_routine.routine.thrd = NULL;
+	HeavyOperationRoutineDestruct(&heavy_routine);
+	memset(&heavy_routine, 0, sizeof(heavy_routine));
+}
+
+int shim_main(int argc, char *argv[])
+{
+	return pmlogdaemon_main(argc, argv);
+}

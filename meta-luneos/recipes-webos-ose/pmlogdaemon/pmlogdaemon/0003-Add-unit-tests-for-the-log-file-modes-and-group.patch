diff --git a/tests/test_log_files.cpp b/tests/test_log_files.cpp
new file mode 100644
index 0000000..278f7b5
--- /dev/null
+++ b/tests/test_log_files.cpp
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: Apache-2.0
+
+// The log files are 0640 group adm: the modes the real code leaves on disk,
+// through the path that creates each file.
+
+#include <gtest/gtest.h>
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <grp.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <zlib.h>
+
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "log_file_shim.h"
+
+namespace {
+
+const char kLine[] = "<14>Oct 31 12:00:00 test: a line of log\n";
+
+mode_t ModeOf(const std::string &path)
+{
+    struct stat st;
+
+    if (lstat(path.c_str(), &st) != 0)
+        return static_cast<mode_t>(-1);
+    return st.st_mode & 07777;
+}
+
+bool Exists(const std::string &path)
+{
+    struct stat st;
+
+    return lstat(path.c_str(), &st) == 0;
+}
+
+std::string ReadGz(const std::string &path)
+{
+    std::string out;
+    char buf[256];
+    int n;
+    gzFile f = gzopen(path.c_str(), "rb");
+
+    if (!f)
+        return out;
+    while ((n = gzread(f, buf, sizeof(buf))) > 0)
+        out.append(buf, static_cast<size_t>(n));
+    gzclose(f);
+    return out;
+}
+
+mode_t CurrentUmask()
+{
+    mode_t m = umask(0);
+
+    umask(m);
+    return m;
+}
+
+// The path in {"filepath":"..."}
+std::string RepliedPath()
+{
+    const std::string payload = shim_reply_payload();
+    const std::string key = "\"filepath\":\"";
+    size_t at = payload.find(key);
+
+    if (at == std::string::npos)
+        return "";
+    at += key.size();
+    return payload.substr(at, payload.find('"', at) - at);
+}
+
+class LogFiles : public ::testing::Test {
+protected:
+    void SetUp() override
+    {
+        const char *base = getenv("TMPDIR");
+        std::string tmpl = std::string(base ? base : "/tmp") + "/pmlog-test-XXXXXX";
+        std::vector<char> buf(tmpl.begin(), tmpl.end());
+
+        buf.push_back('\0');
+        ASSERT_NE(mkdtemp(buf.data()), nullptr) << strerror(errno);
+        m_dir = buf.data();
+        m_log = m_dir + "/messages";
+        m_umask = umask(0);
+        shim_reset();
+    }
+
+    void TearDown() override
+    {
+        umask(m_umask);
+        DIR *d = opendir(m_dir.c_str());
+
+        if (d) {
+            while (struct dirent *e = readdir(d)) {
+                if (strcmp(e->d_name, ".") && strcmp(e->d_name, ".."))
+                    unlink((m_dir + "/" + e->d_name).c_str());
+            }
+            closedir(d);
+        }
+        rmdir(m_dir.c_str());
+    }
+
+    int Write()
+    {
+        return shim_write(m_log.c_str(), kLine, sizeof(kLine) - 1, 1 << 20, 2);
+    }
+
+    std::string m_dir;
+    std::string m_log;
+    mode_t m_umask = 022;
+};
+
+TEST_F(LogFiles, NewLogIs0640EvenWithAnOpenUmask)
+{
+    ASSERT_EQ(Write(), 0);
+    EXPECT_EQ(ModeOf(m_log), 0640u);
+}
+
+TEST_F(LogFiles, UmaskIs0027AfterSetup)
+{
+    shim_group_exists(4);
+    shim_use_log_file_group();
+    EXPECT_EQ(CurrentUmask(), 0027u);
+}
+
+TEST_F(LogFiles, GroupIsAdm)
+{
+    shim_group_exists(4);
+    shim_use_log_file_group();
+    EXPECT_STREQ(shim_group_name(), "adm");
+    EXPECT_EQ(shim_setgid_calls(), 1);
+    EXPECT_EQ(shim_setgid_gid(), 4u);
+}
+
+TEST_F(LogFiles, NoAdmGroupStillGives0640)
+{
+    shim_group_lookup_fails(0);
+    shim_use_log_file_group();
+    EXPECT_EQ(shim_setgid_calls(), 0);
+    EXPECT_EQ(CurrentUmask(), 0027u);
+    ASSERT_EQ(Write(), 0);
+    EXPECT_EQ(ModeOf(m_log), 0640u);
+}
+
+TEST_F(LogFiles, GroupLookupErrorStillGives0640)
+{
+    shim_group_lookup_fails(EIO);
+    shim_use_log_file_group();
+    EXPECT_EQ(shim_setgid_calls(), 0);
+    EXPECT_EQ(CurrentUmask(), 0027u);
+    ASSERT_EQ(Write(), 0);
+    EXPECT_EQ(ModeOf(m_log), 0640u);
+}
+
+TEST_F(LogFiles, SetgidFailureIsNotFatal)
+{
+    shim_group_exists(4);
+    shim_setgid_fails(EPERM);
+    shim_use_log_file_group();
+    EXPECT_EQ(shim_setgid_calls(), 1);
+    EXPECT_EQ(CurrentUmask(), 0027u);
+    ASSERT_EQ(Write(), 0);
+    EXPECT_EQ(ModeOf(m_log), 0640u);
+}
+
+TEST_F(LogFiles, CompressedRotationIs0640)
+{
+    shim_group_exists(4);
+    shim_use_log_file_group();
+    ASSERT_EQ(Write(), 0);
+    ASSERT_EQ(shim_rotate(m_log.c_str(), 2), 1);
+
+    EXPECT_FALSE(Exists(m_log));
+    EXPECT_FALSE(Exists(m_log + ".0"));
+    EXPECT_EQ(ModeOf(m_log + ".0.gz"), 0640u);
+    EXPECT_EQ(ReadGz(m_log + ".0.gz"), std::string(kLine));
+}
+
+TEST_F(LogFiles, OlderRotationsStay0640)
+{
+    shim_group_exists(4);
+    shim_use_log_file_group();
+    ASSERT_EQ(Write(), 0);
+    ASSERT_EQ(shim_rotate(m_log.c_str(), 3), 1);
+    ASSERT_EQ(Write(), 0);
+    ASSERT_EQ(shim_rotate(m_log.c_str(), 3), 1);
+
+    EXPECT_EQ(ModeOf(m_log + ".0.gz"), 0640u);
+    EXPECT_EQ(ModeOf(m_log + ".1.gz"), 0640u);
+}
+
+TEST_F(LogFiles, RotationForASubscriberRestoresTheUmask)
+{
+    ASSERT_EQ(Write(), 0);
+    umask(022); // what the rotation path used to set
+    ASSERT_EQ(shim_rotate_for_subscriber(m_log.c_str()), 1);
+    EXPECT_EQ(CurrentUmask(), 0027u);
+    EXPECT_EQ(shim_reply_calls(), 1);
+}
+
+TEST_F(LogFiles, FileHandedToASubscriberIs0640)
+{
+    ASSERT_EQ(Write(), 0);
+    ASSERT_EQ(shim_rotate_for_subscriber(m_log.c_str()), 1);
+    ASSERT_EQ(shim_reply_calls(), 1);
+
+    const std::string rotated = RepliedPath();
+
+    ASSERT_FALSE(rotated.empty()) << shim_reply_payload();
+    EXPECT_FALSE(Exists(m_log));
+    EXPECT_EQ(ModeOf(rotated), 0640u);
+}
+
+TEST_F(LogFiles, LogRecreatedAfterRotationIs0640)
+{
+    ASSERT_EQ(Write(), 0);
+    ASSERT_EQ(shim_rotate_for_subscriber(m_log.c_str()), 1);
+    ASSERT_EQ(Write(), 0);
+    EXPECT_EQ(ModeOf(m_log), 0640u);
+}
+
+TEST_F(LogFiles, FullLogRotatesOnTheWorkerThreadTo0640)
+{
+    shim_group_exists(4);
+    shim_use_log_file_group();
+    ASSERT_EQ(shim_start_worker(), 1);
+
+    const std::string big(4096, 'x');
+
+    ASSERT_EQ(shim_write(m_log.c_str(), big.c_str(), big.size(), 8192, 2), 0);
+    ASSERT_EQ(shim_write(m_log.c_str(), big.c_str(), big.size(), 8192, 2), 0);
+    ASSERT_EQ(shim_write(m_log.c_str(), kLine, sizeof(kLine) - 1, 8192, 2), 0);
+
+    // the worker removes .0 only once it has compressed it
+    const std::string gz = m_log + ".0.gz";
+
+    for (int i = 0; i < 2000 && (!Exists(gz) || Exists(m_log + ".0")); i++)
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    shim_stop_worker();
+
+    EXPECT_TRUE(Exists(gz));
+    EXPECT_FALSE(Exists(m_log + ".0"));
+    EXPECT_EQ(ModeOf(gz), 0640u);
+    EXPECT_EQ(ModeOf(m_log), 0640u);
+}
+
+TEST(LogFilesMain, DaemonSetsTheGroupAtStart)
+{
+    // An unknown option makes main() exit right after the setup
+    char name[] = "PmLogDaemon";
+    char bad[] = "--no-such-option";
+    char *argv[] = { name, bad, nullptr };
+
+    shim_reset();
+    shim_group_exists(4);
+    shim_print_setgid();
+    EXPECT_EXIT(shim_main(2, argv), ::testing::ExitedWithCode(EXIT_FAILURE),
+                "setgid\\(4\\) from main");
+}
+
+} // namespace

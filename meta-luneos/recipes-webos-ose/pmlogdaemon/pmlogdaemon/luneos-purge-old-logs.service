# See luneos-purge-old-logs. Before systemd-journal-flush.service, so journald
# is still on /run and nothing has /var/log/journal open. /media/internal is
# there by now: the initramfs mounts it, or it is on the root filesystem.
[Unit]
Description=Remove logs left by older images
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-journal-flush.service sysinit.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/var/log/journal /media/internal

[Service]
Type=oneshot
ExecStart=/usr/libexec/luneos-purge-old-logs

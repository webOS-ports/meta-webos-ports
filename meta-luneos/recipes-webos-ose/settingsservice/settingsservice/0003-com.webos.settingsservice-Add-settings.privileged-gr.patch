From af111d72e2f0d15a04c57a8c624e1d99012da391 Mon Sep 17 00:00:00 2001
From: Alan Morford <alan-morford@users.noreply.github.com>
Date: Sun, 27 Sep 2026 10:26:47 +0200
Subject: [PATCH] com.webos.settingsservice: Add settings.privileged group for
 the *Priv methods

getSystemSettings, getSystemSettingValues and setSystemSettings ask the
hub whether the caller may call getSystemSettingsPriv,
getSystemSettingValuesPriv or setSystemSettingsPriv. A caller that may
is served any key; any other caller only gets the keys listed in
settingsservice.allow. No API permission file lists the *Priv methods,
so the hub refuses them for every caller, and without a
settingsservice.allow every such request is answered "Access denied".

Put the *Priv methods in a settings.privileged group at oem trust, so
system services can be granted it in their client permissions.
---
Upstream-Status: Pending

 files/sysbus/com.webos.settingsservice.api.json.in    | 11 +++++++++++
 files/sysbus/com.webos.settingsservice.groups.json.in |  3 ++-
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/files/sysbus/com.webos.settingsservice.api.json.in b/files/sysbus/com.webos.settingsservice.api.json.in
index f705d06..a1158b4 100644
--- a/files/sysbus/com.webos.settingsservice.api.json.in
+++ b/files/sysbus/com.webos.settingsservice.api.json.in
@@ -54,5 +54,16 @@
         "com.webos.service.settings/getSystemSettingFactoryValue",
         "com.webos.service.settings/getSystemSettingValues",
         "com.webos.service.settings/getSystemSettings"
+    ],
+    "settings.privileged": [
+        "com.lge.settingsservice/getSystemSettingValuesPriv",
+        "com.lge.settingsservice/getSystemSettingsPriv",
+        "com.lge.settingsservice/setSystemSettingsPriv",
+        "com.webos.settingsservice/getSystemSettingValuesPriv",
+        "com.webos.settingsservice/getSystemSettingsPriv",
+        "com.webos.settingsservice/setSystemSettingsPriv",
+        "com.webos.service.settings/getSystemSettingValuesPriv",
+        "com.webos.service.settings/getSystemSettingsPriv",
+        "com.webos.service.settings/setSystemSettingsPriv"
     ]
 }
diff --git a/files/sysbus/com.webos.settingsservice.groups.json.in b/files/sysbus/com.webos.settingsservice.groups.json.in
index da6766d..9d57c38 100644
--- a/files/sysbus/com.webos.settingsservice.groups.json.in
+++ b/files/sysbus/com.webos.settingsservice.groups.json.in
@@ -2,6 +2,7 @@
     "allowedNames" : ["com.webos.settingsservice", "com.lge.settingsservice", "com.webos.service.settings"],
     "settings.management" : ["oem"],
     "settings.devutility" : ["oem"],
-    "settings.query" : ["dev"]
+    "settings.query" : ["dev"],
+    "settings.privileged" : ["oem"]
 }
 

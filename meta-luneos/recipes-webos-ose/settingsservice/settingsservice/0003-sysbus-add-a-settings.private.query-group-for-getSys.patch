From 2577b0c8d28690619847ae4e1239e9092f3b91ae Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 30 Oct 2026 18:32:22 +0100
Subject: [PATCH] sysbus: add a settings.private.query group for
 getSystemSettingsPriv

getSystemSettings, getSystemSettingValues and setSystemSettings serve
any key to a caller the hub allows to call luna://com.webos.settingsservice/
getSystemSettingsPriv (and the matching *Priv URIs), and otherwise only
the keys listed in settingsservice.allow. No API permission file lists
the *Priv URIs, so isCallAllowed answers false for every caller and a
system service can only read what the allow file makes public.

Put luna://com.webos.settingsservice/getSystemSettingsPriv in a group of
its own, settings.private.query, at trust level oem. No client has it
until its permission file asks for it, so nothing changes for anyone
else. It covers read access only: setSystemSettingsPriv and
getSystemSettingValuesPriv stay ungrouped. Only the
com.webos.settingsservice name is listed because AccessChecker always
asks about that URI, whichever service name was called.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
Upstream-Status: Pending

 files/sysbus/com.webos.settingsservice.api.json.in    | 3 +++
 files/sysbus/com.webos.settingsservice.groups.json.in | 1 +
 2 files changed, 4 insertions(+)

diff --git a/files/sysbus/com.webos.settingsservice.api.json.in b/files/sysbus/com.webos.settingsservice.api.json.in
index f705d06..b718e80 100644
--- a/files/sysbus/com.webos.settingsservice.api.json.in
+++ b/files/sysbus/com.webos.settingsservice.api.json.in
@@ -38,6 +38,9 @@
         "com.webos.service.settings/internal/getCurrentSubscriptions",
         "com.webos.service.settings/internal/instrument"
     ],
+    "settings.private.query": [
+        "com.webos.settingsservice/getSystemSettingsPriv"
+    ],
     "settings.query": [
         "com.lge.settingsservice/getCurrentSettings",
         "com.lge.settingsservice/getSystemSettingDesc",
diff --git a/files/sysbus/com.webos.settingsservice.groups.json.in b/files/sysbus/com.webos.settingsservice.groups.json.in
index da6766d..9d5a2c2 100644
--- a/files/sysbus/com.webos.settingsservice.groups.json.in
+++ b/files/sysbus/com.webos.settingsservice.groups.json.in
@@ -2,6 +2,7 @@
     "allowedNames" : ["com.webos.settingsservice", "com.lge.settingsservice", "com.webos.service.settings"],
     "settings.management" : ["oem"],
     "settings.devutility" : ["oem"],
+    "settings.private.query" : ["oem"],
     "settings.query" : ["dev"]
 }
 

From 193177b16f3e22ffea88f22aa8bde4226ddf5f4b Mon Sep 17 00:00:00 2001
From: Herrie <Github.com@herrie.org>
Date: Wed, 12 Aug 2026 09:15:49 +0200
Subject: [PATCH] BlinkWebView: null-check the window created for window.open

CreateWindowForWebView() dereferences the WebView returned by
delegate_->CreateWindow() without checking it. WebPageBlink::CreateWindow()
returns the new page's PageView(), which is null when the page could not be
built, so a failed window.open() crashes WebAppMgr instead of just failing.

Return nullptr instead: the engine then reports that no window was created
(window.open() yields null / the navigation is blocked), which the matching
webruntime change handles without dereferencing it.

Signed-off-by: Herrie <Github.com@herrie.org>
---
Upstream-Status: Inappropriate [LuneOS specific]

 src/platform/webengine/blink_web_view.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/platform/webengine/blink_web_view.cc b/src/platform/webengine/blink_web_view.cc
index 722d0aa..15fdc8f 100644
--- a/src/platform/webengine/blink_web_view.cc
+++ b/src/platform/webengine/blink_web_view.cc
@@ -281,6 +281,12 @@ void BlinkWebView::DidResumeDOM() {
     // create a new WebPage using this factory
     WebView *newWebView = delegate_->CreateWindow(newUrl, std::move(dedicatedFactory), height, additional_features);
 
+    // CreateWindow() returns the new page's view, which is null if the page could not be
+    // created. Returning null here tells the engine no window was made (window.open() then
+    // yields null / the navigation is blocked) instead of crashing the browser process.
+    if (!newWebView)
+      return nullptr;
+
     return newWebView->GetWebContents();
   }
 

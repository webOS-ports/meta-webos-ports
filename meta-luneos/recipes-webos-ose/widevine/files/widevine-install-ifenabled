#!/bin/sh
# Run the Widevine CDM installer only if the device owner opted in via the
# First Use "streaming DRM" choice, i.e. the enableWidevineCdm system
# preference is true. Triggered by widevine-install.path (the preference store
# changed) and at each online boot by widevine-install.service. The installer
# itself is idempotent, so running it when the CDM is already present is cheap.
set -eu

p="$(luna-send -n 1 -f luna://com.palm.systemservice/getPreferences \
        '{"keys":["enableWidevineCdm"]}' 2>/dev/null || true)"

case "$p" in
    *'"enableWidevineCdm":true'*|*'"enableWidevineCdm": true'*)
        exec /usr/bin/widevine-install ;;
    *)
        exit 0 ;;
esac

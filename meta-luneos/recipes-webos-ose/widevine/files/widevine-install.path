[Unit]
Description=Watch for the Widevine opt-in and install the CDM
Documentation=https://github.com/webOS-ports/luneos-widevine-bridge

[Path]
# com.palm.systemservice/setPreferences persists here; the First Use tick box
# flips enableWidevineCdm, which modifies this store and fires the installer.
PathModified=/var/luna/preferences/systemprefs.db
Unit=widevine-install.service

[Install]
WantedBy=multi-user.target

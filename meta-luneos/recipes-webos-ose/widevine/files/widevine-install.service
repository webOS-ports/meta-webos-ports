[Unit]
Description=Install Google's Widevine CDM when the owner has opted in
Documentation=https://github.com/webOS-ports/luneos-widevine-bridge
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/widevine-install-ifenabled

[Service]
Type=oneshot
ExecStart=/usr/bin/widevine-install-ifenabled

[Install]
WantedBy=multi-user.target

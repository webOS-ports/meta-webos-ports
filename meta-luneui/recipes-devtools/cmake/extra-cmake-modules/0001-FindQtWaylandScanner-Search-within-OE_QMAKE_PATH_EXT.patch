From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS <webos-ports@googlegroups.com>
Date: Mon, 1 Jan 2024 00:00:00 +0000
Subject: [PATCH] FindQtWaylandScanner: Search within OE_QMAKE_PATH_EXTERNAL_HOST_BINS

qtwaylandscanner lives in the native sysroot under OE, not next to the target
Qt binaries, so add OE's host-bins path to the search hints.

Rebased for extra-cmake-modules 6.28.0: the hint variable was renamed from
qt_binaries_dir to qtwaylandscanner_dir, and upstream now queries
QT_HOST_LIBEXECS rather than QT_HOST_BINS when building against Qt 6.

Upstream-Status: Inappropriate [OE specific]
---
 find-modules/FindQtWaylandScanner.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/find-modules/FindQtWaylandScanner.cmake b/find-modules/FindQtWaylandScanner.cmake
index d3f74fa..547f13f 100644
--- a/find-modules/FindQtWaylandScanner.cmake
+++ b/find-modules/FindQtWaylandScanner.cmake
@@ -97,7 +97,7 @@ else()
 endif()
 
 # Find qtwaylandscanner
-find_program(QtWaylandScanner_EXECUTABLE NAMES qtwaylandscanner HINTS ${qtwaylandscanner_dir})
+find_program(QtWaylandScanner_EXECUTABLE NAMES qtwaylandscanner HINTS ${qtwaylandscanner_dir} ${OE_QMAKE_PATH_EXTERNAL_HOST_BINS})
 
 include(FindPackageHandleStandardArgs)
 find_package_handle_standard_args(QtWaylandScanner
-- 
2.34.1

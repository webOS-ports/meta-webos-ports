From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuneOS / webOS Ports <team@webos-ports.org>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: [PATCH] validation: port add_custom_command off the SOURCE signature

CMake 4 removed the ancient SOURCE/TARGET/OUTPUTS form of
add_custom_command outright:

  CMake Error at src/pbnjson_c/validation/CMakeLists.txt:24
  (add_custom_command):
    The SOURCE signatures of add_custom_command are no longer supported.

This is a removal, not a policy, so CMAKE_POLICY_VERSION_MINIMUM cannot paper
over it. Convert both uses to the OUTPUT form.

Both generated headers and the generated grammar .c are already listed as
sources of the schema_validation library by absolute path, so declaring them
as OUTPUT is enough for CMake to wire up the dependencies; the empty
json_schema_grammar custom target existed only to be the TARGET hook and its
echo becomes the COMMENT. gperf_generate now spells its output with an
explicit ${CMAKE_CURRENT_BINARY_DIR} prefix so it matches what add_library
references, and drops the malformed set_source_files_properties() call - the
OUTPUT declaration is what marks the file GENERATED.

Upstream-Status: Pending
---
 src/pbnjson_c/validation/CMakeLists.txt | 19 ++++++-------------
 1 file changed, 6 insertions(+), 13 deletions(-)

diff --git a/src/pbnjson_c/validation/CMakeLists.txt b/src/pbnjson_c/validation/CMakeLists.txt
index 11f4186..be00f7b 100644
--- a/src/pbnjson_c/validation/CMakeLists.txt
+++ b/src/pbnjson_c/validation/CMakeLists.txt
@@ -17,22 +17,17 @@
 
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fPIC")
 
-add_custom_target(
-	json_schema_grammar echo "Creating json_schema_grammar.c"
-	)
-
 add_custom_command(
-	SOURCE json_schema_grammar.y
+	OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/json_schema_grammar.c
+	       ${CMAKE_CURRENT_BINARY_DIR}/json_schema_grammar.h
 	COMMAND ${CMAKE_CURRENT_SOURCE_DIR}/apply_lemon.sh
 		${LEMON}
 		${CMAKE_CURRENT_BINARY_DIR}
 		${CMAKE_CURRENT_SOURCE_DIR}
 		json_schema_grammar.y
-	TARGET json_schema_grammar
-	OUTPUTS ${CMAKE_CURRENT_BINARY_DIR}/json_schema_grammar.c
-	        ${CMAKE_CURRENT_BINARY_DIR}/json_schema_grammar.h
 	DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/json_schema_grammar.y
 	        ${CMAKE_CURRENT_SOURCE_DIR}/apply_lemon.sh
+	COMMENT "Creating json_schema_grammar.c"
 	)
 
 set(grammar_c ${CMAKE_CURRENT_BINARY_DIR}/json_schema_grammar.c)
@@ -46,13 +41,11 @@ include_directories(
 	)
 
 function(gperf_generate source target)
-	set_source_files_properties(${target} GENERATED)
 	add_custom_command(
-		SOURCE ${source}
-		TARGET ${target}
-		COMMAND ${GPERF} -t ${CMAKE_CURRENT_SOURCE_DIR}/${source} > ${target}
-		OUTPUTS ${target}
+		OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${target}
+		COMMAND ${GPERF} -t ${CMAKE_CURRENT_SOURCE_DIR}/${source} > ${CMAKE_CURRENT_BINARY_DIR}/${target}
 		DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/${source}
+		COMMENT "Generating ${target}"
 		)
 endfunction()
 
